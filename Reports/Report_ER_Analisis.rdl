  <Code>Public Function Relativa(ByVal first As Double, ByVal second As Double) As Double
       Dim resultado as Double
 
       If second = 0 Then
            Return 0
        Else
            resultado = ((first - second)/second)
        End If

        return resultado
    End Function

    Public Function Representa(ByVal first As Double, ByVal second As Double) As Double
       Dim resultado as Double
 
       If second = 0 Then
            Return 0
        Else
            resultado = (first/second)
        End If

        return resultado
    End Function
</Code>
