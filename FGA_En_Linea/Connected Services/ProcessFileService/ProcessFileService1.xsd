<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:tns="http://tempuri.org/" elementFormDefault="qualified" targetNamespace="http://tempuri.org/" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="SaveFile">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="zipPath" nillable="true" type="xs:string" />
        <xs:element minOccurs="0" name="fileName" nillable="true" type="xs:string" />
        <xs:element minOccurs="0" name="idEntidad" nillable="true" type="xs:string" />
        <xs:element minOccurs="0" name="idUsuario" type="xs:int" />
        <xs:element minOccurs="0" name="fechaCarga" type="xs:dateTime" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="SaveFileResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="SaveFileResult" nillable="true" type="xs:string" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="ProcessIndustria">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="xlsPath" nillable="true" type="xs:string" />
        <xs:element minOccurs="0" name="idEncabezado" type="xs:long" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="ProcessIndicador">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="xlsPath" nillable="true" type="xs:string" />
        <xs:element minOccurs="0" name="idEncabezado" type="xs:long" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="ProcessCartera">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" name="xlsPath" nillable="true" type="xs:string" />
        <xs:element minOccurs="0" name="idEncabezado" type="xs:long" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>