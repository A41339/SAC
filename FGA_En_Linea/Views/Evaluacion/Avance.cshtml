@model IEnumerable<Entities.Entities.Procedures.FGA_Consultar_Avance_Result>

@{
    ViewBag.Title = "Avance";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content-header">
    <h1>Avance</h1>
</section>
<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div class="box box-solid box-info">
                <div class="box-body table-responsive">
                    <div class="margin">
                        <div class="streaming-table">
                            <span id="found" class="label label-info"></span>
                            <table id="tbAvance" class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Entidad</th>
                                        @foreach (var detalle in Model)
                                        {
                                            if (detalle.IDENTIDAD == "0")
                                            {
                                                foreach (var categoria in detalle.VALORES.Split(';'))
                                                {
                                                    <td class="text-center">@categoria</td>
                                                }
                                            }
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var detalle in Model)
                                    {
                                        var categorias = detalle.CATEGORIAS.Split(';');
                                        var idCategoria = 0;
                                        if (detalle.IDENTIDAD != "0")
                                        {
                                            <tr>
                                                <td style="text-align: center; background-color: white;">
                                                    @{
                                                        string ruta = Url.Content("~/Content/images/" + @detalle.ENTIDAD + ".jpg");
                                                        <img width="40" height="40" src="@ruta" />
                                                    }
                                                </td>
                                                <td>
                                                    @detalle.ENTIDAD
                                                </td>
                                                @{
                                                    idCategoria = 0;
                                                    foreach (var categoria in detalle.VALORES.Split(';'))
                                                    {
                                                        <td class="text-right">
                                                            <a data-toggle="tooltip" class="cursor" onclick="javascript:desglose(@detalle.IDENTIDAD, @categorias[idCategoria])" data-placement="top" title="Consultar">@categoria</a>
                                                        </td>
                                                        idCategoria += 1;
                                                    }
                                                }
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <br />
                    <br />
                </div>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="modalDesglose" tabindex="-1" role="dialog" aria-labelledby="deleteLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <div class="box-header with-border">
                    <h3 id="titulo" style="padding-bottom: 10px;" class="box-title"></h3>
                </div>
            </div>
            <div id="desglose" class="modal-body">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function desglose(idEntidad, idCategoria) {
        $.ajax({
           url: '@Url.Action("GetDesglose", "Evaluacion")',
            type: 'POST',
            cache: false,
            async: true,
            data: {
                'idEntidad': idEntidad,
                'idCategoria': idCategoria
            },
            success: function (result) {
                $('#desglose').html(result);
                $('#modalDesglose').modal('show');
            },
        });
    }
</script>