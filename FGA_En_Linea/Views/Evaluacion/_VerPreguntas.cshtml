<div class="modern-table-card" style="margin-bottom: 16px; border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; background: #ffffff; box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);">
    <div class="table-responsive" style="padding: 14px 18px;">
        <table id="tbPreguntas" class="table modern-data-table" style="width: 100%; margin-bottom: 0;">
            <thead>
                <tr>
                    <th class="hidden">Id</th>
                    <th style="text-align: left; padding: 10px 14px; font-size: 12px; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: 0.04em;">Enunciado</th>
                    <th style="width: 90px; text-align: center; padding: 10px 14px; font-size: 12px; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: 0.04em;">Acciones</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>


<script type="text/javascript">
    $(document).ready(function () {
        $("#tbPreguntas").dataTable({
            "bRetrieve": true,
            "bProcessing": true,
            "dom": '<"row"<"col-sm-6"l><"col-sm-6"f>>rt<"row"<"col-sm-6"i><"col-sm-6"p>>',
            "sAjaxSource": "@Url.Content("~/Evaluacion/GetPreguntas/")" + $("#idSubCategoria").val(),
            "buttons": [],
            columnDefs: [
                { targets: [0], visible: false },
                { targets: [1], className: "text-left" },
                { targets: [2], width: 90, className: "text-center" }
            ],
            "pageLength": 5,
            "lengthMenu": [[5, 10, 25, -1], [5, 10, 25, "Todos"]],
            "language": {
                "sSearch": "Buscar:",
                "sZeroRecords": "No se encontraron preguntas registradas",
                "sInfo": "Mostrando _START_ a _END_ de _TOTAL_ preguntas",
                "sInfoEmpty": "Mostrando 0 preguntas",
                "oPaginate": {
                    "sPrevious": "Anterior",
                    "sNext": "Siguiente"
                }
            },
            "aoColumns": [ {}, {}, {} ]
        });
    });
</script>