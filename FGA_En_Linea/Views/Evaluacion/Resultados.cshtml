@{
    ViewBag.Title = "Resultados";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content-header">
    <h1>Resultados</h1>
</section>
<section class="content">
    <div class="box box-solid box-info">
        <div class="box-body table-responsive">
            @using (Html.BeginForm("BuscarResultados", "Evaluacion", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmBuscar" }))
            {
                @Html.AntiForgeryToken()
                <div class="margin">
                    <div class="streaming-table">
                        <span id="found" class="label label-info"></span>
                        <table class="table table-condensed table-striped table-bordered">
                            <tr>
                                <td class="mobile">
                                    @Html.Label("Entidad:")
                                </td>
                                <td>
                                    @Html.DropDownList("Entidades", null, new { @id = "IdEntidad", style = "width: 200px;" })
                                </td>
                                <td class="mobile">
                                    @Html.Label("Componente:")
                                </td>
                                <td>
                                    @Html.DropDownList("Categorias", null, new { @id = "Id", style = "width: 400px;" })
                                </td>
                                <td>
                                    <label class="btn btn-facebook">
                                        Generar<input type="submit" name="submit" style="display: none;">
                                    </label>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="row align-content-center">
        <div class="col-xs-12">
            <div class="box box-solid box-info">
                <div class="box-body table-responsive">
                    <div class="margin">
                        <div class="streaming-table">
                            <span id="found" class="label label-info"></span>
                            <table id="tbResultado" class="table table-striped table-bordered" style="width:100% !important">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th><img width="50" height="50" src="@Session["Logo"]" /></th>
                                    </tr>
                                    <tr>
                                        <th class="hidden">Id</th>
                                        <th align="left" width="150px">Subcomponente</th>
                                        <th align="center" width="150px">Fuerte</th>
                                        <th align="center" width="150px">Aceptable</th>
                                        <th align="center" width="150px">Mejorable</th>
                                        <th align="center" width="150px">Débil</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>

                            <div id="summary">
                                <div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <br />
                    <br />
                </div>
            </div>
        </div>
    </div>
</section>

<script type="text/javascript">


    $(document).ready(function () {
        var table = $("#tbResultado").dataTable({
        "bRetrieve": true,
            "bProcessing": true,
            "bPaginate": false,
            "bSort": true,
            "bInfo": false,
        "dom": 'lBfrtip',
        "sAjaxSource": "@Url.Content("~/Evaluacion/GetResultados")",
        "buttons": [
                { extend: 'copyHtml5', exportOptions: { columns: ':visible' } }
            ,{ extend: 'excelHtml5', exportOptions: { columns: ':visible' } }
            ,{ extend: 'pdfHtml5', exportOptions: { columns: ':visible' } }
            ,{ extend: 'print', exportOptions: { columns: ':visible' } }
            ,'colvis'
            ],
            "columnDefs": [
                {
                    className: 'text-center', targets: [2, 3, 4, 5],
                },
                {
                    visible: false,
                    targets: [0]
                },
                {
                    targets: 1,
                    createdCell: function (td, cellData, rowData, row, col) {
                        if (parseInt(cellData, 10) > 0) {
                            $(td).css('background-color', '#336699');
                            $(td).css('color', 'white');
                            $(td).css('width', '100px');
                        }
                    }
                },
                {
                targets: 2,
                createdCell: function (td, cellData, rowData, row, col) {
                    if (parseInt(cellData, 10) > 0) {
                        $(td).css('background-color', '#336699');
                        $(td).css('color', 'white');
                        $(td).css('width', '100px');
                    }
                }
                },
                {
                    targets: 3,
                    createdCell: function (td, cellData, rowData, row, col) {
                        if (parseInt(cellData, 10) > 0) {
                            $(td).css('background-color', 'green');
                            $(td).css('color', 'white');
                            $(td).css('width', '100px');
                        }
                    }
                },
                {
                    targets: 4,
                    createdCell: function (td, cellData, rowData, row, col) {
                        if (parseInt(cellData, 10) > 0) {
                            $(td).css('background-color', '#FFD200');
                            $(td).css('width', '100px');
                        }
                    }
                },
                {
                    targets: 5,
                    createdCell: function (td, cellData, rowData, row, col) {
                        if (parseInt(cellData, 10) > 0) {
                            $(td).css('background-color', 'red');
                            $(td).css('color', 'white');
                            $(td).css('width', '100px');
                        }
                    }
                }
                ],
                "createdRow": function (row, data, dataIndex) {
                    if (data[0] == 1) {
                        $('td', row).css('background-color', '#dddddd');
                        $('td', row).css('color', 'black');
                        $('td', row).css('font-weight', 'bold');
                    }
                },
            "aoColumns": [
                {}, {}, {}, {}, {}, {}]
            });
    });

</script>