@{
    ViewBag.Title = "Resultados";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content-header">
    <h1>Resultados</h1>
</section>
<section class="content">
    @using (Html.BeginForm("BuscarResultados", "Evaluacion", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmBuscar" }))
    {
        @Html.AntiForgeryToken()
        <div class="row">
            <div class="col-xs-12">
                <div class="modern-filter-card">
                    <div class="modern-filter-toolbar">
                        <div class="filter-item">
                            <label for="IdEntidad"><i class="fa fa-university"></i> Entidad:</label>
                            @Html.DropDownList("Entidades", null, new { @id = "IdEntidad", @class = "form-control modern-select", style = "min-width: 220px;" })
                        </div>
                        <div class="filter-item">
                            <label for="Id"><i class="fa fa-th-list"></i> Componente:</label>
                            @Html.DropDownList("Categorias", null, new { @id = "Id", @class = "form-control modern-select", style = "min-width: 320px;" })
                        </div>
                        <div class="filter-item" style="margin-left: auto;">
                            <button type="submit" name="submit" class="btn-modern-filter">
                                <i class="fa fa-search"></i> Generar
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-xs-12">
            <div class="modern-table-card">
                <div class="table-responsive" style="padding: 10px 16px 20px 16px;">
                    <table id="tbResultado" class="table table-bordered modern-data-table eval-results-table" style="width:100% !important">
                        <thead>
                            <tr>
                                <th class="hidden">Id</th>
                                <th style="text-align: left; min-width: 250px;">Subcomponente</th>
                                <th style="text-align: center; width: 140px;"><i class="fa fa-shield text-primary"></i> Fuerte</th>
                                <th style="text-align: center; width: 140px;"><i class="fa fa-check-circle text-success"></i> Aceptable</th>
                                <th style="text-align: center; width: 140px;"><i class="fa fa-exclamation-circle text-warning"></i> Mejorable</th>
                                <th style="text-align: center; width: 140px;"><i class="fa fa-times-circle text-danger"></i> D&eacute;bil</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

<script type="text/javascript">
    $(document).ready(function () {
        var table = $("#tbResultado").dataTable({
            "bRetrieve": true,
            "bProcessing": true,
            "bPaginate": false,
            "bSort": false,
            "bInfo": false,
            "dom": 'lBfrtip',
            "sAjaxSource": "@Url.Content("~/Evaluacion/GetResultados")",
            "buttons": [
                { extend: 'copyHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'excelHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'pdfHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'print', exportOptions: { columns: ':visible' } },
                'colvis'
            ],
            "columnDefs": [
                {
                    visible: false,
                    targets: [0]
                },
                {
                    className: 'text-left font-weight-bold',
                    targets: [1]
                },
                {
                    className: 'text-center',
                    targets: [2, 3, 4, 5]
                },
                {
                    targets: 2, // Fuerte
                    createdCell: function (td, cellData, rowData, row, col) {
                        var val = parseInt(cellData, 10);
                        if (!isNaN(val) && val > 0) {
                            $(td).html('<span class="eval-badge badge-fuerte">' + val + '</span>');
                        } else {
                            $(td).html('<span class="eval-badge badge-empty">-</span>');
                        }
                    }
                },
                {
                    targets: 3, // Aceptable
                    createdCell: function (td, cellData, rowData, row, col) {
                        var val = parseInt(cellData, 10);
                        if (!isNaN(val) && val > 0) {
                            $(td).html('<span class="eval-badge badge-aceptable">' + val + '</span>');
                        } else {
                            $(td).html('<span class="eval-badge badge-empty">-</span>');
                        }
                    }
                },
                {
                    targets: 4, // Mejorable
                    createdCell: function (td, cellData, rowData, row, col) {
                        var val = parseInt(cellData, 10);
                        if (!isNaN(val) && val > 0) {
                            $(td).html('<span class="eval-badge badge-mejorable">' + val + '</span>');
                        } else {
                            $(td).html('<span class="eval-badge badge-empty">-</span>');
                        }
                    }
                },
                {
                    targets: 5, // Debil
                    createdCell: function (td, cellData, rowData, row, col) {
                        var val = parseInt(cellData, 10);
                        if (!isNaN(val) && val > 0) {
                            $(td).html('<span class="eval-badge badge-debil">' + val + '</span>');
                        } else {
                            $(td).html('<span class="eval-badge badge-empty">-</span>');
                        }
                    }
                }
            ],
            "createdRow": function (row, data, dataIndex) {
                if (data[0] == "1" || (data[1] && data[1].toString().indexOf("Total") !== -1)) {
                    $(row).addClass('eval-row-total');
                }
            },
            "aoColumns": [
                {}, {}, {}, {}, {}, {}
            ]
        });
    });
</script>