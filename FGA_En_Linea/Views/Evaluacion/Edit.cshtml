@model Entities.Entities.Evaluacion.EvalCategoria

@{
    ViewBag.Title = "Editar Categoría";
    if (Ajax.IsThisAjaxRequest())
    {
        Layout = null;
    }
}

@Html.StarkAjaxFormSubmiter("frmCompany", "tbCompany", true, "Acción ejecutada con éxito")

@{
    if (!Ajax.IsThisAjaxRequest())
    {
        <section class="content-header">
    <h1>
        <i class="fa fa-edit"></i> Editar Categor&iacute;a
        <small>Actualizaci&oacute;n de criterios y ponderaci&oacute;n de la categor&iacute;a de evaluaci&oacute;n.</small>
    </h1>
</section>
    }
}

@using (Html.BeginForm("Edit", "Evaluacion", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmCompany" }))
{
    @Html.AntiForgeryToken()

    <section class="content">
        <div class="row">
            <div class="col-xs-12">
                <div class="box box-solid box-info">
                    <div role="form">
                        <div class="box-body">
                            @Html.HiddenFor(model => model.Id, new { @class = "" })
                            @Html.HiddenFor(model => model.Ind_Estado, new { @class = "" })

                            <div class="col-lg-12">
                                <div class="col-lg-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Titulo, new { @class = "" })
                                        @Html.EditorFor(model => model.Titulo)
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.ResponsableSugerido, new { @class = "" })
                                        @Html.EditorFor(model => model.ResponsableSugerido)
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-12">
                                <div class="form-group">
                                    <label id="lbl_Descripcion">Descripción</label>
                                    <textarea id="Descripcion" name="Descripcion" class="form-control" style="height: 300px">
                                    @Model.Descripcion.Trim().ToString()
                                    </textarea>
                                </div>
                            </div>
                            <div class="col-lg-12">
                                <div class="col-lg-3">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.PuntosOpcionA, new { @class = "" })
                                        @Html.EditorFor(model => model.PuntosOpcionA)
                                    </div>
                                </div>
                                <div class="col-lg-3">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.PuntosOpcionB, new { @class = "" })
                                        @Html.EditorFor(model => model.PuntosOpcionB)
                                    </div>
                                </div>
                                <div class="col-lg-3">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.PuntosOpcionC, new { @class = "" })
                                        @Html.EditorFor(model => model.PuntosOpcionC)
                                    </div>
                                </div>
                                <div class="col-lg-3">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.PuntosOpcionD, new { @class = "" })
                                        @Html.EditorFor(model => model.PuntosOpcionD)
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-12">
                                <label class="btn btn-default">
                                    Imagen&hellip; <input type="file" name="file" style="display: none;">
                                </label>
                                <img width="200" height="150" src="https://www.ffc.co.cr/img/secciones/categoria/@(String.Format("{0}{1}", Model.Imagen, ".jpg"))"
                                     onerror="this.onerror=null; this.src='https://www.ffc.co.cr/img/secciones/Logo/Logo.jpg'" alt="Categoría" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="box-footer">
                    @Html.StarkInputButtion("Guardar", "submit", "btn btn-primary", "")
                    @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-primary" })
                </div>
            </div>
        </div>
    </section>
}

<script src="~/Content/theme/plugins/bootstrap-wysihtml5/bootstrap3-wysihtml5.all.min.js"></script>
<script>
    $(function () {
        $("#Descripcion").wysihtml5(({
            toolbar: {
                "font-styles": true, // Font styling, e.g. h1, h2, etc.
                "emphasis": true, // Italics, bold, etc.
                "lists": true, // (Un)ordered lists, e.g. Bullets, Numbers.
                "html": false, // Button which allows you to edit the generated HTML.
                "link": true, // Button to insert a link.
                "image": true, // Button to insert an image.
                "color": false, // Button to change color of font
                "blockquote": false, // Blockquote
            }
        }));
    })
</script>