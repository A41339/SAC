@model FGA.Model.Modelo_Evaluacion

@{
    ViewBag.Title = "Evaluaci&oacute;n";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script type="text/javascript" src="~/Content/multiselect/docs/js/prettify.min.js"></script>
<script src="~/Scripts/bootstrap.bundle.min.js"></script>
<script src="~/Scripts/jquery.bootstrap.wizard2.js"></script>

<section class="content-header">
    <h1>
        <i class="fa fa-check-square-o"></i> Cuestionario de Evaluaci&oacute;n
        <small>Evaluaci&oacute;n peri&oacute;dica de gobernanza, gesti&oacute;n de riesgos y control interno.</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="#">Evaluaci&oacute;n</a></li>
        <li class="active">Evaluaci&oacute;n SBR</li>
    </ol>
</section>
<section class="content">
    @Html.Partial("_Menu", Model)
</section>

<section class="content-header">
    <h1>
        <i class="fa fa-check-square-o"></i> Cuestionario de Evaluaci&oacute;n
        <small>Evaluaci&oacute;n peri&oacute;dica de gobernanza, gesti&oacute;n de riesgos y control interno.</small>
    </h1>
</section>
<section class="content">
    <div class="modal fade" id="modal-container" tabindex="-1" role="dialog" aria-labelledby="evalModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" style="border-radius: 14px; overflow: hidden; border: none; box-shadow: 0 12px 36px rgba(0,0,0,0.25);">
                <div id="tblPreguntas">

                </div>
            </div>
        </div>
    </div>
</section>
<div class="modal fade" id="defModal" tabindex="-1" role="dialog" aria-labelledby="defModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" style="border-radius: 14px; overflow: hidden; border: none; box-shadow: 0 12px 36px rgba(0,0,0,0.25);">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="color: #fff; opacity: 0.85; font-size: 24px; text-shadow: none;">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 id="titulo" class="modal-title" style="color: #fff; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                    <i class="fa fa-info-circle" style="color: #86d2dd;"></i> Instrucciones
                </h4>
            </div>
            <div class="modal-body" style="padding: 24px; background: #fff;">
                <div class="text-justify" style="font-size: 14px; line-height: 1.65; color: #334155;" id="definicion">
                    <p>La evaluaci&oacute;n consta de un total de 166 preguntas distribuidas en 4 componentes cualitativos con sus respectivos subcomponentes, cada subcomponente tendr&aacute; una serie de criterios para evaluar.</p>
                    <p>Para iniciar la autoevaluaci&oacute;n se deber&aacute;n designar los responsables de atender cada componente, es posible designar dos responsables que deben haber sido dados de alta previamente como usuarios del SAC.</p>
                    <p>No existe un l&iacute;mite de tiempo para responder. Cada pregunta tendr&aacute; cuatro opciones de respuesta, no existen respuestas buenas o malas, sino que las r&eacute;plicas buscan situar a la entidad en la opci&oacute;n que refleje mejor su realidad adem&aacute;s de contar con la evidencia para respaldar tal afirmaci&oacute;n.</p>
                    <p>Al salir se autoguardar&aacute; la &uacute;ltima pregunta completada, es factible devolverse a alguna pregunta y cambiar la respuesta si as&iacute; lo amerita, sin embargo, no es posible adelantar las preguntas sin antes dar respuesta. Cada subcomponente le indicar&aacute; la cantidad de preguntas y el nivel de avance tanto del subcomponente como del componente.</p>
                    <p>Es posible elaborar la autoevaluaci&oacute;n de todos los componentes en forma simult&aacute;nea, al igual que es viable evaluar varios subcomponentes al mismo tiempo.</p>
                    <p>Una vez completada la autoevaluaci&oacute;n de cada componente se le indicar&aacute; antes de salvar y enviar la autoevaluaci&oacute;n, ya que una vez enviada no se podr&aacute; acceder de nuevo a la misma.</p>
                </div>
            </div>
            <div class="modal-footer" style="background: #f8fafc; border-top: 1px solid #e2e8f0; padding: 12px 24px;">
                <button type="button" class="btn btn-default" data-dismiss="modal" style="border-radius: 6px; font-weight: 500;">
                    <i class="fa fa-times"></i> Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

@section ScriptsOrCss
{
    <link rel="stylesheet" href="~/Content/blog/css/templatemo-misc.css">
    <link rel="stylesheet" href="~/Content/blog/css/templatemo-style.css">
    <link rel="stylesheet" href="~/Content/multiselect/docs/css/prettify.min.css" type="text/css">
    <link rel="stylesheet" href="~/Content/multiselect/dist/css/bootstrap-multiselect.css" type="text/css">
}

<script type="text/javascript">

    function help(titulo) {
        $('#titulo').html(titulo);
        $('#defModal').modal('show');
    }

    $('#modal-container').on('hidden.bs.modal', function () {
        window.location.reload();
    });

    function generarEvaluacion(id) {
        if (!id || id === "0" || id === 0) {
            return;
        }
        $.ajax({
            url: '@Url.Action("ViewEval", "Evaluacion")',
            type: 'POST',
            cache: false,
            async: true,
            data: {
                'id': id
            },
            success: function (result) {
                $('#tblPreguntas').html(result);
                var modalElem = document.getElementById('modal-container');
                if (window.bootstrap && window.bootstrap.Modal) {
                    var bsModal = bootstrap.Modal.getInstance(modalElem) || new bootstrap.Modal(modalElem);
                    bsModal.show();
                } else if (typeof $('#modal-container').modal === 'function') {
                    $('#modal-container').modal('show');
                }
            },
            error: function (xhr, status, error) {
                console.error("Error al cargar la evaluacion:", status, error);
            }
        });
    }

    // Alias para compatibilidad con llamadas existentes
    window.generarevaluacion = generarEvaluacion;
    window.generarEvaluacion = generarEvaluacion;

    $.fn.jqueryBootstrapWizard.labels = {
        btn_back: 'Atr\u00e1s',
        btn_next: 'Siguiente',
        btn_finish: 'Finalizar',
        btn_cancel: 'Cancelar'
    }

    $('#navWizard').jqueryBootstrapWizard({
    });

    if ('@(Model.eval.ToString().ToLower())' == 'true') {
        $('#jqb-btn-next').addClass("hidden");
        $('#jqb-btn-prev').removeClass("hidden");
    }

</script>
