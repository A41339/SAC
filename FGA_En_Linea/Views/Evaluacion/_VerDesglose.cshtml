@model IEnumerable<Entities.Entities.Procedures.FGA_CONSULTAR_AVANCE_X_CATEGORIA_Result>

<div class="box-body table-responsive">
    <div class="margin">
        <div class="streaming-table">
            <span id="found" class="label label-info"></span>
            <table id="tbDesglose" class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <td>Número de pregunta</td>
                        @foreach (var detalle in Model)
                        {
                            if (detalle.IDPREGUNTA.Value.ToString() == "0")
                            {
                                foreach (var categoria in detalle.VALORES.Split(';'))
                                {
                                    <td class="text-center">@categoria</td>
                                }
                            }
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var detalle in Model)
                    {
                        if (detalle.IDPREGUNTA.Value.ToString() != "0")
                        {
                            <tr>
                                <td>@detalle.IDPREGUNTA.Value.ToString()</td>
                                @foreach (var respuesta in detalle.VALORES.Split(';'))
                                {
                                    <td class="text-center">@respuesta</td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    <br />
    <br />
</div>
