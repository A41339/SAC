@model IEnumerable<Entities.Entities.Procedures.FGA_CONSULTAR_AVANCE_X_CATEGORIA_Result>

<div class="table-responsive" style="margin: 0; border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden;">
    <table id="tbDesglose" class="table modern-data-table" style="margin-bottom: 0;">
        <thead>
            <tr>
                <th style="width: 140px; text-align: center;">N&uacute;mero de pregunta</th>
                @foreach (var detalle in Model)
                {
                    if (detalle.IDPREGUNTA.Value.ToString() == "0")
                    {
                        foreach (var categoria in detalle.VALORES.Split(';'))
                        {
                            <th class="text-center">@categoria</th>
                        }
                    }
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var detalle in Model)
            {
                if (detalle.IDPREGUNTA.Value.ToString() != "0")
                {
                    <tr>
                        <td class="text-center" style="vertical-align: middle;">
                            <span class="badge" style="background: #e0f2fe; color: #0284c7; font-weight: 700; font-size: 12px; padding: 5px 12px; border-radius: 12px; border: 1px solid #bae6fd;">
                                # @detalle.IDPREGUNTA.Value.ToString()
                            </span>
                        </td>
                        @foreach (var respuesta in detalle.VALORES.Split(';'))
                        {
                            <td class="text-center" style="vertical-align: middle; font-weight: 500; color: #334155;">
                                @respuesta
                            </td>
                        }
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
