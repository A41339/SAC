@model IEnumerable<FGA.Model.AdminPlanRemediacionViewModel>

@{
    ViewBag.Title = "Administración de Planes de Remediación SBR";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var lista = Model != null ? Model.ToList() : new List<FGA.Model.AdminPlanRemediacionViewModel>();
    int totalEntidades = lista.Count;
    int conPlan = lista.Count(x => x.TienePlan);
    int sinPlan = totalEntidades - conPlan;
}

<section class="content-header">
    <div class="plan-rem-header">
        <div>
            <h1 class="plan-rem-title">
                <i class="fa fa-shield"></i> Planes de Remediaci&oacute;n SBR
                <small class="plan-rem-subtitle">Gesti&oacute;n y carga institucional para entidades supervisadas</small>
            </h1>
        </div>
        <div>
            <a href="@Url.Action("Evaluacion", "Evaluacion")" class="btn btn-default">
                <i class="fa fa-arrow-left"></i> Volver a Evaluaci&oacute;n SBR
            </a>
        </div>
    </div>
    <ol class="breadcrumb plan-rem-breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="@Url.Action("Index", "Modulo", new { id = 9000 })">Administraci&oacute;n</a></li>
        <li><a href="@Url.Action("Evaluacion", "Evaluacion")">Evaluaci&oacute;n SBR</a></li>
        <li class="active">Planes de Remediaci&oacute;n</li>
    </ol>
</section>

<section class="content">

    <!-- Tarjetas de metricas -->
    <div class="row plan-rem-metrics-row">
        <div class="col-md-4 col-sm-6 col-xs-12">
            <div class="stat-metric-card">
                <div class="stat-metric-icon stat-metric-icon-blue">
                    <i class="fa fa-university"></i>
                </div>
                <div>
                    <div class="stat-metric-label">Total Entidades</div>
                    <div class="stat-metric-value">@totalEntidades</div>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-sm-6 col-xs-12">
            <div class="stat-metric-card">
                <div class="stat-metric-icon stat-metric-icon-green">
                    <i class="fa fa-check-circle"></i>
                </div>
                <div>
                    <div class="stat-metric-label">Con Plan Cargado</div>
                    <div class="stat-metric-value-green">@conPlan</div>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-sm-6 col-xs-12">
            <div class="stat-metric-card">
                <div class="stat-metric-icon stat-metric-icon-red">
                    <i class="fa fa-clock-o"></i>
                </div>
                <div>
                    <div class="stat-metric-label">Pendientes de Cargar</div>
                    <div class="stat-metric-value-red">@sinPlan</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Panel principal -->
    <div class="plan-rem-card">
        <!-- Barra de filtros y busqueda -->
        <div class="row plan-rem-filter-row">
            <div class="col-md-6 col-sm-6 col-xs-12 plan-rem-filter-col">
                <div class="input-group">
                    <span class="input-group-addon plan-rem-search-addon"><i class="fa fa-search text-muted"></i></span>
                    <input type="text" id="filtroTexto" class="form-control plan-rem-input" placeholder="Buscar por c&oacute;digo o nombre de entidad..." onkeyup="filtrarTabla()" />
                </div>
            </div>
            <div class="col-md-3 col-sm-3 col-xs-12 plan-rem-filter-col">
                <select id="filtroEstado" class="form-control plan-rem-select" onchange="filtrarTabla()">
                    <option value="todos">Todos los estados</option>
                    <option value="con-plan">Con Plan Cargado</option>
                    <option value="sin-plan">Pendientes (Sin Plan)</option>
                </select>
            </div>
            <div class="col-md-3 col-sm-3 col-xs-12 text-right plan-rem-filter-col">
                <button type="button" class="btn btn-primary plan-rem-btn-upload" onclick="abrirModalCargaRapida()">
                    <i class="fa fa-upload"></i> Cargar Plan PDF
                </button>
            </div>
        </div>

        <!-- Tabla de entidades -->
        <div class="table-responsive">
            <table class="table table-hover table-planes" id="tablaPlanes">
                <thead>
                    <tr>
                        <th>C&oacute;digo</th>
                        <th>Entidad</th>
                        <th>Contacto Registrado</th>
                        <th class="text-center">Estado</th>
                        <th>Archivo / Tama&ntilde;o</th>
                        <th>Fecha de Carga</th>
                        <th>Cargado Por</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (lista.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted table-planes-empty">
                                <i class="fa fa-info-circle fa-2x"></i>
                                No se encontraron entidades activas registradas.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var ent in lista)
                        {
                            <tr class="fila-entidad" data-estado="@(ent.TienePlan ? "con-plan" : "sin-plan")" data-codigo="@ent.IdEntidad.ToLower()" data-nombre="@ent.NombreEntidad.ToLower()">
                                <td><strong class="table-planes-code">@ent.IdEntidad</strong></td>
                                <td>
                                    <div class="table-planes-name">@ent.NombreEntidad</div>
                                    @if (!string.IsNullOrEmpty(ent.Notas))
                                    {
                                        <small class="text-muted table-planes-notes" title="@ent.Notas">
                                            <i class="fa fa-sticky-note-o"></i> @ent.Notas
                                        </small>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(ent.ContactoEntidad))
                                    {
                                        <span class="table-planes-contact" title="@ent.ContactoEntidad">
                                            <i class="fa fa-envelope-o text-primary"></i> @ent.ContactoEntidad
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted table-planes-empty-contact">Sin contacto registrado</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (ent.TienePlan)
                                    {
                                        <span class="badge-con-plan"><i class="fa fa-check"></i> Cargado</span>
                                    }
                                    else
                                    {
                                        <span class="badge-sin-plan"><i class="fa fa-clock-o"></i> Pendiente</span>
                                    }
                                </td>
                                <td>
                                    @if (ent.TienePlan)
                                    {
                                        <div class="table-planes-filename" title="@ent.NombreArchivoOriginal">
                                            <i class="fa fa-file-pdf-o text-danger"></i> @ent.NombreArchivoOriginal
                                        </div>
                                        <small class="text-muted">@ent.TamanioFormato</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">&mdash;</span>
                                    }
                                </td>
                                <td>
                                    @if (ent.FechaCarga.HasValue)
                                    {
                                        <span>@ent.FechaCarga.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">&mdash;</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(ent.UsuarioCarga))
                                    {
                                        <span>@ent.UsuarioCarga</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">&mdash;</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (ent.TienePlan)
                                    {
                                        <div class="btn-group" role="group">
                                            <button type="button" class="btn btn-default btn-action-sm" onclick="verPdfModal('@ent.IdEntidad', '@ent.NombreEntidad.Replace("'", "\\'")')" title="Ver en pantalla">
                                                <i class="fa fa-eye text-primary"></i> Ver
                                            </button>
                                            <a href="@Url.Action("DescargarPlanRemediacion", "Evaluacion", new { idEntidad = ent.IdEntidad })" class="btn btn-default btn-action-sm" title="Descargar PDF">
                                                <i class="fa fa-download text-success"></i>
                                            </a>
                                            <button type="button" class="btn btn-default btn-action-sm" onclick="prepararSubirModal('@ent.IdEntidad', '@ent.NombreEntidad.Replace("'", "\\'")')" title="Reemplazar archivo PDF">
                                                <i class="fa fa-refresh text-warning"></i>
                                            </button>
                                            <button type="button" class="btn btn-default btn-action-sm" onclick="confirmarEliminarPlan('@ent.IdEntidad', '@ent.NombreEntidad.Replace("'", "\\'")')" title="Eliminar plan">
                                                <i class="fa fa-trash text-danger"></i>
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-primary btn-action-sm" onclick="prepararSubirModal('@ent.IdEntidad', '@ent.NombreEntidad.Replace("'", "\\'")')">
                                            <i class="fa fa-upload"></i> Cargar PDF
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

<!-- MODAL PARA CARGAR / REEMPLAZAR PLAN DE REMEDIACION -->
<div class="modal fade" id="modalSubirPlan" tabindex="-1" role="dialog" aria-labelledby="modalSubirPlanLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content modal-plan-content">
            <div class="modal-header modal-plan-header-blue">
                <button type="button" class="close modal-plan-close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title modal-plan-title">
                    <i class="fa fa-file-pdf-o"></i> <span id="modalSubirTitulo">Cargar Plan de Remediaci&oacute;n</span>
                </h4>
            </div>
            <form id="formSubirPlan" onsubmit="enviarGuardarPlan(event)">
                <div class="modal-body modal-plan-body">
                    <div class="form-group">
                        <label class="control-label">Entidad Destino <span class="text-danger">*</span></label>
                        <select id="modalSubirIdEntidad" name="idEntidad" class="form-control" required>
                            <option value="">-- Seleccione una entidad --</option>
                            @foreach (var ent in lista)
                            {
                                <option value="@ent.IdEntidad">[@ent.IdEntidad] @ent.NombreEntidad</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="control-label">Archivo PDF del Plan <span class="text-danger">*</span></label>
                        <div class="dropzone-pdf" onclick="document.getElementById('inputArchivoPdf').click()">
                            <i class="fa fa-cloud-upload fa-3x dropzone-pdf-icon"></i>
                            <div class="dropzone-pdf-title" id="lblNombreArchivo">
                                Haga clic para seleccionar el archivo PDF
                            </div>
                            <div class="dropzone-pdf-hint">
                                Formato soportado: .pdf (Recomendaciones t&eacute;cnicas FFC SUGEF 24-22)
                            </div>
                        </div>
                        <input type="file" id="inputArchivoPdf" name="archivoPlan" accept=".pdf,application/pdf" class="hidden" onchange="archivoPdfSeleccionado(this)" required />
                    </div>

                    <div class="form-group">
                        <label class="control-label">Notas u Observaciones (Opcional)</label>
                        <textarea id="modalSubirNotas" name="notas" class="form-control" rows="3" placeholder="Detalles de la versi&oacute;n, periodo aplicable o recomendaciones generales..."></textarea>
                    </div>

                    <div id="alertSubirPlan" class="alert hidden"></div>
                </div>
                <div class="modal-footer modal-plan-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">
                        Cancelar
                    </button>
                    <button type="submit" id="btnGuardarPlan" class="btn btn-primary modal-plan-btn-submit">
                        <i class="fa fa-check"></i> Guardar y Publicar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL VISOR DE PDF EN PANTALLA (ADMIN) -->
<div class="modal fade" id="modalVisorAdmin" tabindex="-1" role="dialog" aria-labelledby="modalVisorAdminLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-visor-dialog">
        <div class="modal-content modal-plan-content">
            <div class="modal-header modal-plan-header-dark">
                <h4 class="modal-title modal-visor-title">
                    <i class="fa fa-file-pdf-o text-danger"></i>
                    <span id="visorAdminTitulo">Plan de Remediaci&oacute;n</span>
                </h4>
                <div>
                    <a id="btnVisorAdminDescargar" href="#" class="btn btn-sm btn-primary">
                        <i class="fa fa-download"></i> Descargar
                    </a>
                    <button type="button" class="close modal-plan-close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            </div>
            <div class="modal-body modal-visor-iframe-container">
                <iframe id="iframeVisorAdmin" src="about:blank" class="modal-visor-iframe"></iframe>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function filtrarTabla() {
        var texto = ($('#filtroTexto').val() || '').toLowerCase().trim();
        var estado = $('#filtroEstado').val();

        $('#tablaPlanes tbody tr.fila-entidad').each(function () {
            var $fila = $(this);
            var filaEstado = $fila.data('estado');
            var filaCodigo = String($fila.data('codigo') || '');
            var filaNombre = String($fila.data('nombre') || '');

            var coincideTexto = (texto === '' || filaCodigo.indexOf(texto) !== -1 || filaNombre.indexOf(texto) !== -1);
            var coincideEstado = (estado === 'todos' || filaEstado === estado);

            if (coincideTexto && coincideEstado) {
                $fila.show();
            } else {
                $fila.hide();
            }
        });
    }

    function abrirModalCargaRapida() {
        $('#modalSubirTitulo').text('Cargar Plan de Remediación');
        $('#modalSubirIdEntidad').val('').prop('disabled', false);
        $('#modalSubirNotas').val('');
        $('#inputArchivoPdf').val('');
        $('#lblNombreArchivo').html('Haga clic para seleccionar el archivo PDF');
        $('#alertSubirPlan').addClass('hidden').empty();
        $('#modalSubirPlan').modal('show');
    }

    function prepararSubirModal(idEntidad, nombreEntidad) {
        $('#modalSubirTitulo').text('Cargar Plan de Remediación - ' + nombreEntidad);
        $('#modalSubirIdEntidad').val(idEntidad).prop('disabled', true);
        $('#modalSubirNotas').val('');
        $('#inputArchivoPdf').val('');
        $('#lblNombreArchivo').html('Haga clic para seleccionar el archivo PDF');
        $('#alertSubirPlan').addClass('hidden').empty();
        $('#modalSubirPlan').modal('show');
    }

    function archivoPdfSeleccionado(input) {
        if (input.files && input.files[0]) {
            var file = input.files[0];
            if (file.type !== 'application/pdf' && !file.name.toLowerCase().endsWith('.pdf')) {
                alert('El archivo seleccionado debe ser un documento PDF (.pdf).');
                input.value = '';
                $('#lblNombreArchivo').html('Haga clic para seleccionar el archivo PDF');
                return;
            }
            var sizeKb = (file.size / 1024).toFixed(1);
            $('#lblNombreArchivo').html('<i class="fa fa-file-pdf-o text-danger"></i> <strong>' + file.name + '</strong> (' + sizeKb + ' KB)');
        }
    }

    function enviarGuardarPlan(e) {
        e.preventDefault();
        var idEntidad = $('#modalSubirIdEntidad').val();
        if (!idEntidad) {
            alert('Debe seleccionar una entidad.');
            return;
        }

        var fileInput = document.getElementById('inputArchivoPdf');
        if (!fileInput.files || fileInput.files.length === 0) {
            alert('Debe seleccionar el archivo PDF del plan de remediación.');
            return;
        }

        var formData = new FormData();
        formData.append('idEntidad', idEntidad);
        formData.append('archivoPlan', fileInput.files[0]);
        formData.append('notas', $('#modalSubirNotas').val());

        var $btn = $('#btnGuardarPlan');
        var originalText = $btn.html();
        $btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Guardando...');
        $('#alertSubirPlan').addClass('hidden').empty();

        $.ajax({
            url: '@Url.Action("GuardarPlanRemediacion", "Evaluacion")',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function (res) {
                $btn.prop('disabled', false).html(originalText);
                if (res.success) {
                    $('#alertSubirPlan').removeClass('hidden alert-danger').addClass('alert-success')
                        .html('<i class="fa fa-check-circle"></i> ' + res.message);
                    setTimeout(function () {
                        window.location.reload();
                    }, 1200);
                } else {
                    $('#alertSubirPlan').removeClass('hidden alert-success').addClass('alert-danger')
                        .html('<i class="fa fa-exclamation-triangle"></i> ' + res.message);
                }
            },
            error: function () {
                $btn.prop('disabled', false).html(originalText);
                $('#alertSubirPlan').removeClass('hidden alert-success').addClass('alert-danger')
                    .html('<i class="fa fa-exclamation-triangle"></i> Error de comunicación con el servidor.');
            }
        });
    }

    function verPdfModal(idEntidad, nombreEntidad) {
        $('#visorAdminTitulo').html('<i class="fa fa-file-pdf-o text-danger"></i> Plan de Remediación - ' + nombreEntidad);
        var urlVer = '@Url.Action("VerPlanRemediacion", "Evaluacion")?idEntidad=' + encodeURIComponent(idEntidad) + '&t=' + new Date().getTime();
        var urlDescargar = '@Url.Action("DescargarPlanRemediacion", "Evaluacion")?idEntidad=' + encodeURIComponent(idEntidad);
        $('#btnVisorAdminDescargar').attr('href', urlDescargar);
        $('#iframeVisorAdmin').attr('src', urlVer);
        $('#modalVisorAdmin').modal('show');
    }

    $('#modalVisorAdmin').on('hidden.bs.modal', function () {
        $('#iframeVisorAdmin').attr('src', 'about:blank');
    });

    function confirmarEliminarPlan(idEntidad, nombreEntidad) {
        if (!confirm('¿Está seguro de que desea eliminar el Plan de Remediación de ' + nombreEntidad + '? Esta acción no se puede deshacer.')) {
            return;
        }

        $.ajax({
            url: '@Url.Action("EliminarPlanRemediacion", "Evaluacion")',
            type: 'POST',
            data: { idEntidad: idEntidad },
            success: function (res) {
                if (res.success) {
                    alert(res.message);
                    window.location.reload();
                } else {
                    alert('Error: ' + res.message);
                }
            },
            error: function () {
                alert('Ocurrió un error al intentar eliminar el plan.');
            }
        });
    }
</script>
