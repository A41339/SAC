<input id="idCategoria" runat="server" type="hidden" />
<input id="idSubCategoria" runat="server" type="hidden" />

<script type="text/javascript">

    var ControlerNameCompany = "@Url.Content("~/Evaluacion")";

    function verPreguntas(id, title) {
        $("#idSubCategoria").val(id);
        $('#preguntaTitle').text(title);
        $('#modalPreguntas').modal('show');
        refreshGridPreguntas();
    }

    function verSubCategorias(id, title) {
        $("#idCategoria").val(id);
        $('#subCategoriaTitle').text(title);
        $('#modalSubCategorias').modal('show');
        refreshGridSubCategorias();
    }

    function modificarPregunta(id, enunciado, opcionA, opcionB, opcionC, opcionD) {
        $('#modalModificarPregunta').modal('show');
        $('#MPreguntaId').val(id);
        $('#MPreguntaEnunciado').val(enunciado);
        $('#MOpcionA').val(opcionA);
        $('#MOpcionB').val(opcionB);
        $('#MOpcionC').val(opcionC);
        $('#MOpcionD').val(opcionD);
    }

    function modificarSubCategoria(id, enunciado) {
        $('#modalModificarSubCategoria').modal('show');
        $('#MSubCategoriaId').val(id);
        $('#MSubCategoriaEnunciado').val(enunciado);
    }

    function borrarPregunta(id) {
        $.ajax({
           url: '@Url.Action("DeletePregunta", "Evaluacion")',
           type: 'POST',
           cache: false,
           async: true,
           data: { 'id': id },
           success: function (res) {
               if (res.success) {
                   window.mostrarToastExito(res.message);
               } else {
                   window.mostrarToastError(res.message);
               }
               refreshGridPreguntas();
           }
        });
    }

    function borrarSubCategoria(id) {
        $.ajax({
           url: '@Url.Action("DeleteSubCategoria", "Evaluacion")',
           type: 'POST',
           cache: false,
           async: true,
           data: { 'id': id },
           success: function (res) {
               if (res.success) {
                   window.mostrarToastExito(res.message);
               } else {
                   window.mostrarToastError(res.message);
               }
               refreshGridSubCategorias();
           }
        });
    }

    $(document).on('click', '#btn_modificarPregunta', function () {
        $.ajax({
            async: false,
            type: "GET",
            dataType: "json",
            contentType: "application/json",
            url: '@Url.Action("ModificarPregunta", "Evaluacion")',
            data: {
                'IdPregunta': $('#MPreguntaId').val(),
                'Enunciado': $('#MPreguntaEnunciado').val(),
                'OpcionA': $('#MOpcionA').val(),
                'OpcionB': $('#MOpcionB').val(),
                'OpcionC': $('#MOpcionC').val(),
                'OpcionD': $('#MOpcionD').val()
            },
            success: function (res) {
                if (res.success) {
                    window.mostrarToastExito(res.message);
                } else {
                    window.mostrarToastError(res.message);
                }
            }
        });
        $('#MPreguntaId, #MPreguntaEnunciado, #MOpcionA, #MOpcionB, #MOpcionC, #MOpcionD').val('');
        $('#modalModificarPregunta').modal('hide');
        refreshGridPreguntas();
    });

    $(document).on('click', '#btn_modificarSubCategoria', function () {
        $.ajax({
            async: false,
            type: "GET",
            dataType: "json",
            contentType: "application/json",
            url: '@Url.Action("ModificarSubCategoria", "Evaluacion")',
            data: {
                'IdSubCategoria': $('#MSubCategoriaId').val(),
                'Enunciado': $('#MSubCategoriaEnunciado').val()
            },
            success: function (res) {
                if (res.success) {
                    window.mostrarToastExito(res.message);
                } else {
                    window.mostrarToastError(res.message);
                }
            }
        });
        $('#MSubCategoriaId, #MSubCategoriaEnunciado').val('');
        $('#modalModificarSubCategoria').modal('hide');
        refreshGridSubCategorias();
    });

    $(document).on('click', '#btn_agregarPregunta', function () {
        $.ajax({
            async: false,
            type: "GET",
            dataType: "json",
            contentType: "application/json",
            url: '@Url.Action("AgregarPregunta", "Evaluacion")',
            data: {
                'IdSubCategoria': $("#idSubCategoria").val(),
                'Enunciado': $('#EnunciadoPregunta').val(),
                'OpcionA': $('#OpcionA').val(),
                'OpcionB': $('#OpcionB').val(),
                'OpcionC': $('#OpcionC').val(),
                'OpcionD': $('#OpcionD').val()
            },
            success: function (res) {
                if (res.success) {
                    window.mostrarToastExito(res.message);
                } else {
                    window.mostrarToastError(res.message);
                }
            }
        });
        $('#EnunciadoPregunta, #OpcionA, #OpcionB, #OpcionC, #OpcionD').val('');
        refreshGridPreguntas();
    });

    $(document).on('click', '#btn_agregarSubCategoria', function () {
        $.ajax({
            async: false,
            type: "GET",
            dataType: "json",
            contentType: "application/json",
            url: '@Url.Action("AgregarSubCategoria", "Evaluacion")',
            data: {
                'IdCategoria': $('#idCategoria').val(),
                'Enunciado': $('#EnunciadoSubCategoria').val()
            },
            success: function (res) {
                if (res.success) {
                    window.mostrarToastExito(res.message);
                } else {
                    window.mostrarToastError(res.message);
                }
            }
        });
        $('#EnunciadoSubCategoria').val('');
        refreshGridSubCategorias();
    });

    function refreshGridPreguntas() {
        $.ajax({
            url: '@Url.Action("GetGridPreguntas", "Evaluacion")',
            type: 'POST',
            cache: false,
            async: true,
            success: function (result) { $('#tblPreguntas').html(result); }
        });
    }

    function refreshGridSubCategorias() {
        $.ajax({
            url: '@Url.Action("GetGridSubCategorias", "Evaluacion")',
            type: 'POST',
            cache: false,
            async: true,
            success: function (result) { $('#tblSubCategorias').html(result); }
        });
    }

    $(document).ready(function () {
        var oTableEvaluacion = $("#tbEvaluacion").DataTable({
            "bRetrieve": true,
            "bProcessing": true,
            "dom": 'lBfrtip',
            "sAjaxSource": "@Url.Content("~/Evaluacion/GetGrid")",
            "buttons": [
                { extend: 'copyHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'excelHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'pdfHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'print', exportOptions: { columns: ':visible' } },
                'colvis'
            ],
            columnDefs: [
                { targets: [1], visible: false },
                { targets: [3], width: 110 }
            ],
            "pageLength": 10,
            "lengthMenu": [[5, 10, 25, 50, -1], [5, 10, 25, 50, "Todos"]],
            "aoColumns": [
                {
                    "mRender": function (oObj, type, row) {
                        var buttons = '<div class="text-center"><div class="btn-group text-left">';
                        buttons += '<button type="button" class="btn btn-xs btn-default dropdown-toggle" data-toggle="dropdown" style="border-radius:6px; border:1px solid #cbd5e1; font-size:12px; padding:4px 10px; color:#374151;">';
                        buttons += '<i class="fa fa-cog" style="margin-right:4px;"></i> Acci&oacute;n <span class="caret"></span></button>';
                        buttons += '<ul class="dropdown-menu pull-left" role="menu" style="border-radius:8px; box-shadow:0 8px 24px rgba(0,0,0,0.12); border:1px solid #e2e8f0; min-width:140px; padding:4px 0;">';
                        buttons += '<li><a href="javascript:void(0);" class="btn-edit-categoria" data-id="' + row[0] + '" style="padding:7px 14px; font-size:13px; color:#1e293b; display:flex; align-items:center; gap:8px;"><i class="fa fa-edit" style="color:#0284c7; width:16px;"></i> Modificar</a></li>';
                        buttons += '<li><a href="javascript:void(0);" class="btn-delete-categoria" data-id="' + row[0] + '" data-nombre="' + escape(row[2]) + '" style="padding:7px 14px; font-size:13px; color:#ef4444; display:flex; align-items:center; gap:8px;"><i class="fa fa-trash" style="color:#ef4444; width:16px;"></i> Borrar</a></li>';
                        buttons += '</ul></div></div>';
                        return buttons;
                    }
                },
                {}, {}, {}
            ]
        });

        // ── Abrir modal Nueva Categoría ─────────────────────────────
        $('#btnNuevaCategoria').on('click', function () {
            $('#lblModalCategoriaTitulo').text('Nueva Categoría');
            $('#categoriaId').val('0');
            $('#categoriaIndEstado').val('A');
            $('#categoriaTitulo').val('');
            $('#categoriaResponsableSugerido').val('');
            $('#categoriaDescripcion').val('');
            $('#categoriaPuntosA').val('0');
            $('#categoriaPuntosB').val('0');
            $('#categoriaPuntosC').val('0');
            $('#categoriaPuntosD').val('0');
            $('#modalCategoriaError').hide();
            $('#modalCategoria').modal('show');
            setTimeout(function () { $('#categoriaTitulo').focus(); }, 400);
        });

        // ── Abrir modal Editar Categoría ────────────────────────────
        $(document).on('click', '.btn-edit-categoria', function (e) {
            e.preventDefault();
            var id = $(this).closest('.btn-edit-categoria').data('id');
            $('#modalCategoriaError').hide();

            $.getJSON('@Url.Action("GetCategoria", "Evaluacion")', { id: id }, function (res) {
                if (res && res.success && res.categoria) {
                    var c = res.categoria;
                    $('#lblModalCategoriaTitulo').text('Editar Categoría: ' + c.titulo);
                    $('#categoriaId').val(c.id);
                    $('#categoriaIndEstado').val(c.ind_Estado || 'A');
                    $('#categoriaTitulo').val(c.titulo || '');
                    $('#categoriaResponsableSugerido').val(c.responsableSugerido || '');
                    $('#categoriaDescripcion').val(c.descripcion || '');
                    $('#categoriaPuntosA').val(c.puntosOpcionA != null ? c.puntosOpcionA : '0');
                    $('#categoriaPuntosB').val(c.puntosOpcionB != null ? c.puntosOpcionB : '0');
                    $('#categoriaPuntosC').val(c.puntosOpcionC != null ? c.puntosOpcionC : '0');
                    $('#categoriaPuntosD').val(c.puntosOpcionD != null ? c.puntosOpcionD : '0');

                    $('#modalCategoria').modal('show');
                    setTimeout(function () { $('#categoriaTitulo').focus(); }, 400);
                } else {
                    window.mostrarToastError(res.message || 'No se pudo cargar la información de la categoría.');
                }
            }).fail(function () {
                window.mostrarToastError('Error al consultar la categoría en el servidor.');
            });
        });

        // ── Guardar Categoría (Crear / Editar) ─────────────────────
        $('#btnGuardarCategoria').on('click', function () {
            var titulo = $.trim($('#categoriaTitulo').val());

            if (!titulo) {
                $('#modalCategoriaError').text('El título de la categoría es requerido.').show();
                return;
            }

            var $btn = $(this);
            $btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Guardando...');

            var formElement = document.getElementById('formCategoria');
            var formData = new FormData(formElement);

            $.ajax({
                url: '@Url.Action("GuardarCategoria", "Evaluacion")',
                type: 'POST',
                data: formData,
                contentType: false,
                processData: false,
                success: function (res) {
                    $('#starkloader').hide();
                    $btn.prop('disabled', false).html('<i class="fa fa-save"></i> Guardar');
                    if (res && res.success) {
                        $('#modalCategoria').modal('hide');
                        window.mostrarToastExito(res.message);
                        if (oTableEvaluacion && oTableEvaluacion.ajax) {
                            oTableEvaluacion.ajax.reload(null, false);
                        } else {
                            $('#tbEvaluacion').DataTable().ajax.reload(null, false);
                        }
                    } else {
                        $('#modalCategoriaError').text(res.message || 'Error al guardar la categor\u00eda.').show();
                    }
                },
                error: function () {
                    $('#starkloader').hide();
                    $btn.prop('disabled', false).html('<i class="fa fa-save"></i> Guardar');
                    $('#modalCategoriaError').text('Error de conexi\u00f3n con el servidor.').show();
                },
                complete: function () {
                    $('#starkloader').hide();
                }
            });
        });

        // ── Abrir modal Confirmar Eliminación ────────────────────────
        var categoriaToDeleteId = 0;
        $(document).on('click', '.btn-delete-categoria', function (e) {
            e.preventDefault();
            var $btn = $(this).closest('.btn-delete-categoria');
            categoriaToDeleteId = $btn.data('id');
            var rawNombre = $btn.data('nombre');
            var nombre = unescape(rawNombre || "");
            $('#lblEliminarCategoriaNombre').text('"' + nombre + '"');
            $('#modalEliminarCategoria').modal('show');
        });

        // ── Confirmar Eliminación ────────────────────────────────────
        $('#btnConfirmarEliminarCategoria').on('click', function () {
            if (!categoriaToDeleteId) return;

            var $btn = $(this);
            $btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Eliminando...');

            $.ajax({
                url: '@Url.Action("EliminarCategoria", "Evaluacion")',
                type: 'POST',
                data: { id: categoriaToDeleteId },
                success: function (res) {
                    $('#starkloader').hide();
                    $btn.prop('disabled', false).html('<i class="fa fa-trash"></i> S\u00ed, Eliminar');
                    $('#modalEliminarCategoria').modal('hide');
                    if (res && res.success) {
                        window.mostrarToastExito(res.message);
                        if (oTableEvaluacion && oTableEvaluacion.ajax) {
                            oTableEvaluacion.ajax.reload(null, false);
                        } else {
                            $('#tbEvaluacion').DataTable().ajax.reload(null, false);
                        }
                    } else {
                        window.mostrarToastError(res.message || 'No fue posible eliminar la categor\u00eda.');
                    }
                },
                error: function () {
                    $('#starkloader').hide();
                    $btn.prop('disabled', false).html('<i class="fa fa-trash"></i> S\u00ed, Eliminar');
                    $('#modalEliminarCategoria').modal('hide');
                    window.mostrarToastError('Error de comunicaci\u00f3n al intentar eliminar la categor\u00eda.');
                },
                complete: function () {
                    $('#starkloader').hide();
                }
            });
        });
    });

    /* -- Multi-modal z-index handler ------------------------------------------ */
    (function ($, window) {
        'use strict';
        var MultiModal = function (element) { this.$element = $(element); this.modalCount = 0; };
        MultiModal.BASE_ZINDEX = 1040;
        MultiModal.prototype.show = function (target) {
            var that = this, $target = $(target), modalIndex = that.modalCount++;
            $target.css('z-index', MultiModal.BASE_ZINDEX + (modalIndex * 20) + 10);
            window.setTimeout(function () {
                if (modalIndex > 0) $('.modal-backdrop').not(':first').addClass('hidden');
                that.adjustBackdrop();
            });
        };
        MultiModal.prototype.hidden = function () {
            this.modalCount--;
            if (this.modalCount) { this.adjustBackdrop(); $('body').addClass('modal-open'); }
        };
        MultiModal.prototype.adjustBackdrop = function () {
            $('.modal-backdrop:first').css('z-index', MultiModal.BASE_ZINDEX + ((this.modalCount - 1) * 20));
        };
        function Plugin(method, target) {
            return this.each(function () {
                var $this = $(this), data = $this.data('multi-modal-plugin');
                if (!data) $this.data('multi-modal-plugin', (data = new MultiModal(this)));
                if (method) data[method](target);
            });
        }
        $.fn.multiModal = Plugin;
        $.fn.multiModal.Constructor = MultiModal;
        $(document).on('show.bs.modal', function (e) { $(document).multiModal('show', e.target); });
        $(document).on('hidden.bs.modal', function (e) { $(document).multiModal('hidden', e.target); });
    }(jQuery, window));

</script>
