                        <div class="col-md-6" style="margin-bottom: 10px;">
                            <label style="font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 4px; display: block;">
                                <span class="label" style="background: #0284c7; color: #fff; padding: 2px 7px; border-radius: 4px; margin-right: 4px;">A</span> Opci&oacute;n A
                            </label>
                            <textarea id="OpcionA" class="form-control modern-select" rows="2" placeholder="Opci&oacute;n A" name="OpcionA" style="resize: vertical; font-size: 13px;"></textarea>
                        </div>
                        <div class="col-md-6" style="margin-bottom: 10px;">
                            <label style="font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 4px; display: block;">
                                <span class="label" style="background: #059669; color: #fff; padding: 2px 7px; border-radius: 4px; margin-right: 4px;">B</span> Opci&oacute;n B
                            </label>
                            <textarea id="OpcionB" class="form-control modern-select" rows="2" placeholder="Opci&oacute;n B" name="OpcionB" style="resize: vertical; font-size: 13px;"></textarea>
                        </div>
                        <div class="col-md-6" style="margin-bottom: 10px;">
                            <label style="font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 4px; display: block;">
                                <span class="label" style="background: #d97706; color: #fff; padding: 2px 7px; border-radius: 4px; margin-right: 4px;">C</span> Opci&oacute;n C
                            </label>
                            <textarea id="OpcionC" class="form-control modern-select" rows="2" placeholder="Opci&oacute;n C" name="OpcionC" style="resize: vertical; font-size: 13px;"></textarea>
                        </div>
                        <div class="col-md-6" style="margin-bottom: 10px;">
                            <label style="font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 4px; display: block;">
                                <span class="label" style="background: #7c3aed; color: #fff; padding: 2px 7px; border-radius: 4px; margin-right: 4px;">D</span> Opci&oacute;n D
                            </label>
                            <textarea id="OpcionD" class="form-control modern-select" rows="2" placeholder="Opci&oacute;n D" name="OpcionD" style="resize: vertical; font-size: 13px;"></textarea>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="background: #ffffff; border-top: 1px solid #e2e8f0; padding: 12px 22px; display: flex; justify-content: flex-end; align-items: center; gap: 8px;">
                <button type="button" class="btn-modern-filter" id="btn_agregarPregunta" style="padding: 9px 20px; border-radius: 8px; background: linear-gradient(135deg, #059669 0%, #0d7377 100%); margin: 0;">
                    <i class="fa fa-save"></i> Agregar pregunta
                </button>
                <button type="button" class="btn-modern-filter" data-dismiss="modal" style="padding: 9px 20px; margin: 0; border-radius: 8px; background: #64748b;">
                    <i class="fa fa-times"></i> Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Ã¢ÂÂÃ¢ÂÂÃ¢ÂÂÃ¢ÂÂÃ¢ÂÂÃ¢ÂÂÃ¢ÂÂÃ¢ÂÂÃ¢ÂÂÃ¢ÂÂÃ¢ÂÂÃ¢ÂÂÃ¢ÂÂÃ¢ÂÂÃ¢ÂÂÃ¢ÂÂÃ¢ÂÂÃ¢ÂÂÃ¢ÂÂÃ¢ÂÂÃ¢ÂÂÃ¢ÂÂÃ¢ÂÂÃ¢ÂÂÃ¢ÂÂÃ¢ÂÂÃ¢ÂÂÃ¢ÂÂÃ¢ÂÂÃ¢ÂÂÃ¢ÂÂÃ¢ÂÂÃ¢ÂÂÃ¢ÂÂÃ¢ÂÂÃ¢ÂÂÃ¢ÂÂÃ¢ÂÂÃ¢ÂÂ
