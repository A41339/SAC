<div class="modal fade modal-categoria-custom" id="modalCategoria" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" style="max-width: 780px; margin: 30px auto;">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">
                    <i class="fa fa-clipboard"></i>
                    <span id="lblModalCategoriaTitulo">Nueva Categor&iacute;a</span>
                </h4>
                <button type="button" class="close" data-dismiss="modal" style="color: #fff; opacity: 0.85; font-size: 22px; text-shadow: none; margin: 0; padding: 0;">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div id="modalCategoriaError" class="alert alert-danger" style="display:none; border-radius: 8px; font-size: 13px;"></div>
                <form id="formCategoria" enctype="multipart/form-data">
                    <input type="hidden" id="categoriaId" name="Id" value="0" />
                    <input type="hidden" id="categoriaIndEstado" name="Ind_Estado" value="A" />

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group-cat" style="margin-bottom: 14px;">
                                <label for="categoriaTitulo">
                                    <i class="fa fa-tag" style="color: #0284c7; margin-right: 5px;"></i>
                                    T&iacute;tulo *
                                </label>
                                <input type="text" class="form-control" id="categoriaTitulo" name="Titulo" maxlength="200" placeholder="Ej. Gobierno Corporativo" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group-cat" style="margin-bottom: 14px;">
                                <label for="categoriaResponsableSugerido">
                                    <i class="fa fa-user" style="color: #0284c7; margin-right: 5px;"></i>
                                    Responsable Sugerido
                                </label>
                                <input type="text" class="form-control" id="categoriaResponsableSugerido" name="ResponsableSugerido" maxlength="200" placeholder="Ej. Junta Directiva / Auditoría" />
                            </div>
                        </div>
                    </div>

                    <div class="form-group-cat" style="margin-bottom: 16px;">
                        <label for="categoriaDescripcion">
                            <i class="fa fa-align-left" style="color: #0284c7; margin-right: 5px;"></i>
                            Descripci&oacute;n
                        </label>
                        <textarea class="form-control" id="categoriaDescripcion" name="Descripcion" rows="6" placeholder="Descripci&oacute;n detallada de la categor&iacute;a..." style="min-height: 140px; resize: vertical; line-height: 1.5; font-size: 13.5px;"></textarea>
                    </div>

                    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 14px 16px; margin-bottom: 0;">
                        <span style="font-size: 12px; font-weight: 700; color: #1e293b; display: block; margin-bottom: 10px;">
                            <i class="fa fa-sliders" style="color: #0284c7; margin-right: 5px;"></i>
                            Puntos por Opci&oacute;n
                        </span>
                        <div class="row">
                            <div class="col-xs-6 col-md-3">
                                <div class="form-group-cat" style="margin-bottom: 0;">
                                    <label for="categoriaPuntosA">Opci&oacute;n A</label>
                                    <input type="number" class="form-control" id="categoriaPuntosA" name="PuntosOpcionA" value="0" />
                                </div>
                            </div>
                            <div class="col-xs-6 col-md-3">
                                <div class="form-group-cat" style="margin-bottom: 0;">
                                    <label for="categoriaPuntosB">Opci&oacute;n B</label>
                                    <input type="number" class="form-control" id="categoriaPuntosB" name="PuntosOpcionB" value="0" />
                                </div>
                            </div>
                            <div class="col-xs-6 col-md-3">
                                <div class="form-group-cat" style="margin-bottom: 0;">
                                    <label for="categoriaPuntosC">Opci&oacute;n C</label>
                                    <input type="number" class="form-control" id="categoriaPuntosC" name="PuntosOpcionC" value="0" />
                                </div>
                            </div>
                            <div class="col-xs-6 col-md-3">
                                <div class="form-group-cat" style="margin-bottom: 0;">
                                    <label for="categoriaPuntosD">Opci&oacute;n D</label>
                                    <input type="number" class="form-control" id="categoriaPuntosD" name="PuntosOpcionD" value="0" />
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer" style="background: #ffffff; border-top: 1px solid #e2e8f0; padding: 12px 22px; display: flex; justify-content: flex-end; align-items: center; gap: 8px;">
                <button type="button" class="btn-modern-filter" id="btnGuardarCategoria" style="padding: 9px 20px; border-radius: 8px; margin: 0;">
                    <i class="fa fa-save"></i> Guardar
                </button>
                <button type="button" class="btn-modern-filter" data-dismiss="modal" style="padding: 9px 20px; margin: 0; border-radius: 8px; background: #64748b;">
                    <i class="fa fa-times"></i> Cancelar
                </button>
            </div>
        </div>
    </div>
</div>

