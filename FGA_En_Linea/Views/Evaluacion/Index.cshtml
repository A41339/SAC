@{
    ViewBag.Title = "Categorías";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content-header">
    <h1>
        <i class="fa fa-clipboard" style="color: #0284c7; margin-right: 8px;"></i>
        Mantenimiento de Evaluaciones
    </h1>
</section>

<section class="content">
    <div class="row">
        <div class="col-xs-12">

            <!-- Barra de acciones -->
            <div class="modern-table-card" style="margin-bottom: 20px;">
                <div style="padding: 14px 20px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
                    <div>
                        <h4 style="margin: 0; font-size: 15px; font-weight: 700; color: #143750;">
                            <i class="fa fa-list-alt" style="color: #0284c7; margin-right: 7px;"></i>
                            Categorías de evaluación
                        </h4>
                        <p style="margin: 3px 0 0 0; font-size: 12px; color: #64748b;">Administre las categorías, subcomponentes y preguntas del proceso de autoevaluación</p>
                    </div>
                    <a href="~/Evaluacion/Create" class="btn-modern-filter" style="text-decoration: none; padding: 9px 20px; border-radius: 8px; font-size: 13px;">
                        <i class="fa fa-plus-circle"></i> Crear categoría
                    </a>
                </div>
            </div>

            <!-- Tabla principal -->
            <div class="modern-table-card">
                <div class="table-responsive" style="padding: 16px 20px;">
                    <span id="found" class="label label-info"></span>
                    <table id="tbEvaluacion" class="table modern-data-table" style="width: 100%;">
                        <thead>
                            <tr>
                                <th style="width: 120px;">Acción</th>
                                <th class="hidden">Código</th>
                                <th>Título</th>
                                <th style="width: 110px; text-align: center;">Opciones</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                    <div id="summary"><div></div></div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════
     MODAL: Preguntas de subcomponente
═══════════════════════════════════════ -->
<div class="modal fade" id="modalPreguntas" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" style="max-width: 880px; width: 92%; margin: 30px auto;">
        <div class="modal-content" style="border-radius: 14px; overflow: hidden; border: none; box-shadow: 0 12px 36px rgba(0,0,0,0.2);">
            <div class="modal-header" style="background: linear-gradient(135deg, #143750 0%, #0d7377 100%); padding: 18px 22px; display: flex; align-items: center; justify-content: space-between;">
                <h4 class="modal-title" style="margin: 0; color: #ffffff; font-size: 16px; font-weight: 700; display: flex; align-items: center; gap: 8px;">
                    <i class="fa fa-question-circle" style="font-size: 18px;"></i>
                    <span id="preguntaTitle"></span>
                </h4>
                <button type="button" class="close" data-dismiss="modal" style="color: #fff; opacity: 0.85; font-size: 22px; text-shadow: none; margin: 0; padding: 0;">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body" style="padding: 22px 24px; background: #f8fafc;">

                <!-- Tabla de preguntas cargada via AJAX -->
                <div id="tblPreguntas" style="margin-bottom: 20px;"></div>

                <!-- Formulario para agregar pregunta -->
                <div class="modern-table-card" style="padding: 18px 20px; margin-bottom: 0;">
                    <h5 style="font-size: 13px; font-weight: 700; color: #143750; margin: 0 0 14px 0;">
                        <i class="fa fa-plus-circle" style="color: #0284c7; margin-right: 6px;"></i>
                        Nueva pregunta
                    </h5>
                    <div class="form-group" style="margin-bottom: 12px;">
                        <label style="font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 4px; display: block;">Enunciado</label>
                        <textarea id="EnunciadoPregunta" class="form-control modern-select" rows="3" placeholder="Escriba aquí el enunciado de la pregunta..." name="EnunciadoPregunta" style="resize: vertical; font-size: 13px;"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6" style="margin-bottom: 10px;">
                            <label style="font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 4px; display: block;">
                                <span class="label" style="background: #0284c7; color: #fff; padding: 2px 7px; border-radius: 4px; margin-right: 4px;">A</span> Opción A
                            </label>
                            <textarea id="OpcionA" class="form-control modern-select" rows="2" placeholder="Opción A" name="OpcionA" style="resize: vertical; font-size: 13px;"></textarea>
                        </div>
                        <div class="col-md-6" style="margin-bottom: 10px;">
                            <label style="font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 4px; display: block;">
                                <span class="label" style="background: #059669; color: #fff; padding: 2px 7px; border-radius: 4px; margin-right: 4px;">B</span> Opción B
                            </label>
                            <textarea id="OpcionB" class="form-control modern-select" rows="2" placeholder="Opción B" name="OpcionB" style="resize: vertical; font-size: 13px;"></textarea>
                        </div>
                        <div class="col-md-6" style="margin-bottom: 10px;">
                            <label style="font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 4px; display: block;">
                                <span class="label" style="background: #d97706; color: #fff; padding: 2px 7px; border-radius: 4px; margin-right: 4px;">C</span> Opción C
                            </label>
                            <textarea id="OpcionC" class="form-control modern-select" rows="2" placeholder="Opción C" name="OpcionC" style="resize: vertical; font-size: 13px;"></textarea>
                        </div>
                        <div class="col-md-6" style="margin-bottom: 10px;">
                            <label style="font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 4px; display: block;">
                                <span class="label" style="background: #7c3aed; color: #fff; padding: 2px 7px; border-radius: 4px; margin-right: 4px;">D</span> Opción D
                            </label>
                            <textarea id="OpcionD" class="form-control modern-select" rows="2" placeholder="Opción D" name="OpcionD" style="resize: vertical; font-size: 13px;"></textarea>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="background: #ffffff; border-top: 1px solid #e2e8f0; padding: 14px 22px; display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" class="btn-modern-filter" id="btn_agregarPregunta" style="padding: 9px 22px; border-radius: 8px; background: linear-gradient(135deg, #059669 0%, #0d7377 100%);">
                    <i class="fa fa-save"></i> Agregar pregunta
                </button>
                <button type="button" class="btn-modern-filter" data-dismiss="modal" style="padding: 9px 22px; border-radius: 8px; background: #64748b;">
                    <i class="fa fa-times"></i> Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════
     MODAL: Subcomponentes de categoría
═══════════════════════════════════════ -->
<div class="modal fade" id="modalSubCategorias" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" style="max-width: 820px; width: 92%; margin: 30px auto;">
        <div class="modal-content" style="border-radius: 14px; overflow: hidden; border: none; box-shadow: 0 12px 36px rgba(0,0,0,0.2);">
            <div class="modal-header" style="background: linear-gradient(135deg, #143750 0%, #0d7377 100%); padding: 18px 22px; display: flex; align-items: center; justify-content: space-between;">
                <h4 class="modal-title" style="margin: 0; color: #ffffff; font-size: 16px; font-weight: 700; display: flex; align-items: center; gap: 8px;">
                    <i class="fa fa-sitemap" style="font-size: 18px;"></i>
                    <span id="subCategoriaTitle"></span>
                </h4>
                <button type="button" class="close" data-dismiss="modal" style="color: #fff; opacity: 0.85; font-size: 22px; text-shadow: none; margin: 0; padding: 0;">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body" style="padding: 22px 24px; background: #f8fafc;">
                <!-- Tabla de componentes cargada via AJAX -->
                <div id="tblSubCategorias" style="margin-bottom: 16px;"></div>

                <!-- Formulario inline para nuevo componente -->
                <div class="modern-table-card" style="padding: 16px 20px; margin-bottom: 0; border: 1px solid #e2e8f0; border-radius: 10px; background: #ffffff;">
                    <h5 style="font-size: 13px; font-weight: 700; color: #143750; margin: 0 0 10px 0;">
                        <i class="fa fa-plus-circle" style="color: #0284c7; margin-right: 6px;"></i>
                        Agregar nuevo componente
                    </h5>
                    <div style="display: flex; gap: 10px; align-items: center;">
                        <input type="text" id="EnunciadoSubCategoria" class="form-control modern-select" placeholder="Ej: Gobierno Corporativo – Composición" name="EnunciadoSubCategoria" style="font-size: 13px; flex: 1; height: 38px;" />
                        <button type="button" class="btn-modern-filter" id="btn_agregarSubCategoria" style="padding: 0 20px; height: 38px; border-radius: 8px; background: linear-gradient(135deg, #059669 0%, #0d7377 100%); flex-shrink: 0;">
                            <i class="fa fa-plus"></i> Agregar
                        </button>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="background: #ffffff; border-top: 1px solid #e2e8f0; padding: 14px 22px; display: flex; justify-content: flex-end;">
                <button type="button" class="btn-modern-filter" data-dismiss="modal" style="padding: 9px 24px; border-radius: 8px; background: #64748b;">
                    <i class="fa fa-times"></i> Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════
     MODAL: Modificar pregunta
═══════════════════════════════════════ -->
<div class="modal fade" id="modalModificarPregunta" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" style="border-radius: 14px; overflow: hidden; border: none; box-shadow: 0 12px 36px rgba(0,0,0,0.2);">
            <div class="modal-header" style="background: linear-gradient(135deg, #1e40af 0%, #143750 100%); padding: 18px 22px; display: flex; align-items: center; justify-content: space-between;">
                <h4 class="modal-title" id="lbl_tituloModificar" style="margin: 0; color: #ffffff; font-size: 16px; font-weight: 700; display: flex; align-items: center; gap: 8px;">
                    <i class="fa fa-edit"></i> Modificar pregunta
                </h4>
                <button type="button" class="close" data-dismiss="modal" style="color: #fff; opacity: 0.85; font-size: 22px; text-shadow: none; margin: 0; padding: 0;">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body" style="padding: 22px 24px; background: #f8fafc;">
                <input id="MPreguntaId" name="MPreguntaId" class="hidden" />
                <div class="modern-table-card" style="padding: 18px 20px;">
                    <div class="form-group" style="margin-bottom: 14px;">
                        <label style="font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 4px; display: block;">Enunciado</label>
                        <textarea id="MPreguntaEnunciado" class="form-control modern-select" rows="4" placeholder="Enunciado de la pregunta" name="MEnunciado" style="resize: vertical; font-size: 13px;"></textarea>
                    </div>
                    <div class="form-group" style="margin-bottom: 10px;">
                        <label style="font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 4px; display: block;">
                            <span class="label" style="background: #0284c7; color: #fff; padding: 2px 7px; border-radius: 4px; margin-right: 4px;">A</span>
                        </label>
                        <textarea id="MOpcionA" class="form-control modern-select" rows="3" placeholder="Opción A" name="MOpcionA" style="resize: vertical; font-size: 13px;"></textarea>
                    </div>
                    <div class="form-group" style="margin-bottom: 10px;">
                        <label style="font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 4px; display: block;">
                            <span class="label" style="background: #059669; color: #fff; padding: 2px 7px; border-radius: 4px; margin-right: 4px;">B</span>
                        </label>
                        <textarea id="MOpcionB" class="form-control modern-select" rows="3" placeholder="Opción B" name="MOpcionB" style="resize: vertical; font-size: 13px;"></textarea>
                    </div>
                    <div class="form-group" style="margin-bottom: 10px;">
                        <label style="font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 4px; display: block;">
                            <span class="label" style="background: #d97706; color: #fff; padding: 2px 7px; border-radius: 4px; margin-right: 4px;">C</span>
                        </label>
                        <textarea id="MOpcionC" class="form-control modern-select" rows="3" placeholder="Opción C" name="MOpcionC" style="resize: vertical; font-size: 13px;"></textarea>
                    </div>
                    <div class="form-group" style="margin-bottom: 0;">
                        <label style="font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 4px; display: block;">
                            <span class="label" style="background: #7c3aed; color: #fff; padding: 2px 7px; border-radius: 4px; margin-right: 4px;">D</span>
                        </label>
                        <textarea id="MOpcionD" class="form-control modern-select" rows="3" placeholder="Opción D" name="MOpcionD" style="resize: vertical; font-size: 13px;"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="background: #ffffff; border-top: 1px solid #e2e8f0; padding: 14px 22px; display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" class="btn-modern-filter" id="btn_modificarPregunta" style="padding: 9px 22px; border-radius: 8px;">
                    <i class="fa fa-check"></i> Guardar cambios
                </button>
                <button type="button" class="btn-modern-filter" data-dismiss="modal" style="padding: 9px 22px; border-radius: 8px; background: #64748b;">
                    <i class="fa fa-times"></i> Cancelar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════
     MODAL: Modificar subcomponente
═══════════════════════════════════════ -->
<div class="modal fade" id="modalModificarSubCategoria" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" style="border-radius: 14px; overflow: hidden; border: none; box-shadow: 0 12px 36px rgba(0,0,0,0.2);">
            <div class="modal-header" style="background: linear-gradient(135deg, #1e40af 0%, #143750 100%); padding: 18px 22px; display: flex; align-items: center; justify-content: space-between;">
                <h4 class="modal-title" id="lbl_tituloMod" style="margin: 0; color: #ffffff; font-size: 16px; font-weight: 700; display: flex; align-items: center; gap: 8px;">
                    <i class="fa fa-edit"></i> Modificar componente
                </h4>
                <button type="button" class="close" data-dismiss="modal" style="color: #fff; opacity: 0.85; font-size: 22px; text-shadow: none; margin: 0; padding: 0;">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body" style="padding: 22px 24px; background: #f8fafc;">
                <input id="MSubCategoriaId" name="MSubCategoriaId" class="hidden" />
                <div class="modern-table-card" style="padding: 18px 20px;">
                    <div class="form-group" style="margin-bottom: 0;">
                        <label style="font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 6px; display: block;">
                            <i class="fa fa-tag" style="color: #0284c7; margin-right: 5px;"></i>
                            Nombre del componente
                        </label>
                        <input type="text" id="MSubCategoriaEnunciado" class="form-control modern-select" placeholder="Nombre del subcomponente" name="MSubCategoriaEnunciado" style="font-size: 13px;" />
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="background: #ffffff; border-top: 1px solid #e2e8f0; padding: 14px 22px; display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" class="btn-modern-filter" id="btn_modificarSubCategoria" style="padding: 9px 22px; border-radius: 8px;">
                    <i class="fa fa-check"></i> Guardar cambios
                </button>
                <button type="button" class="btn-modern-filter" data-dismiss="modal" style="padding: 9px 22px; border-radius: 8px; background: #64748b;">
                    <i class="fa fa-times"></i> Cancelar
                </button>
            </div>
        </div>
    </div>
</div>

<input id="idCategoria" runat="server" type="hidden" />
<input id="idSubCategoria" runat="server" type="hidden" />

<script type="text/javascript">

    var ControlerNameCompany = "@Url.Content("~/Evaluacion")";

    function verPreguntas(id, title) {
        $("#idSubCategoria").val(id);
        $('#preguntaTitle').text(title);
        $('#modalPreguntas').modal('show');
        refreshGridPreguntas();
    }

    function verSubCategorias(id, title) {
        $("#idCategoria").val(id);
        $('#subCategoriaTitle').text(title);
        $('#modalSubCategorias').modal('show');
        refreshGridSubCategorias();
    }

    function modificarPregunta(id, enunciado, opcionA, opcionB, opcionC, opcionD) {
        $('#modalModificarPregunta').modal('show');
        $('#MPreguntaId').val(id);
        $('#MPreguntaEnunciado').val(enunciado);
        $('#MOpcionA').val(opcionA);
        $('#MOpcionB').val(opcionB);
        $('#MOpcionC').val(opcionC);
        $('#MOpcionD').val(opcionD);
    }

    function modificarSubCategoria(id, enunciado) {
        $('#modalModificarSubCategoria').modal('show');
        $('#MSubCategoriaId').val(id);
        $('#MSubCategoriaEnunciado').val(enunciado);
    }

    function borrarPregunta(id) {
        $.ajax({
           url: '@Url.Action("DeletePregunta", "Evaluacion")',
           type: 'POST',
           cache: false,
           async: true,
           data: { 'id': id }
        });
        refreshGridPreguntas();
    }

    function borrarSubCategoria(id) {
        $.ajax({
           url: '@Url.Action("DeleteSubCategoria", "Evaluacion")',
           type: 'POST',
           cache: false,
           async: true,
           data: { 'id': id }
        });
        refreshGridSubCategorias();
    }

    $(document).on('click', '#btn_modificarPregunta', function () {
        $.ajax({
            async: false,
            type: "GET",
            dataType: "json",
            contentType: "application/json",
            url: '@Url.Action("ModificarPregunta", "Evaluacion")',
            data: {
                'IdPregunta': $('#MPreguntaId').val(),
                'Enunciado': $('#MPreguntaEnunciado').val(),
                'OpcionA': $('#MOpcionA').val(),
                'OpcionB': $('#MOpcionB').val(),
                'OpcionC': $('#MOpcionC').val(),
                'OpcionD': $('#MOpcionD').val()
            }
        });
        $('#MPreguntaId, #MPreguntaEnunciado, #MOpcionA, #MOpcionB, #MOpcionC, #MOpcionD').val('');
        $('#modalModificarPregunta').modal('hide');
        refreshGridPreguntas();
    });

    $(document).on('click', '#btn_modificarSubCategoria', function () {
        $.ajax({
            async: false,
            type: "GET",
            dataType: "json",
            contentType: "application/json",
            url: '@Url.Action("ModificarSubCategoria", "Evaluacion")',
            data: {
                'IdSubCategoria': $('#MSubCategoriaId').val(),
                'Enunciado': $('#MSubCategoriaEnunciado').val()
            }
        });
        $('#MSubCategoriaId, #MSubCategoriaEnunciado').val('');
        $('#modalModificarSubCategoria').modal('hide');
        refreshGridSubCategorias();
    });

    $(document).on('click', '#btn_agregarPregunta', function () {
        $.ajax({
            async: false,
            type: "GET",
            dataType: "json",
            contentType: "application/json",
            url: '@Url.Action("AgregarPregunta", "Evaluacion")',
            data: {
                'IdSubCategoria': $("#idSubCategoria").val(),
                'Enunciado': $('#EnunciadoPregunta').val(),
                'OpcionA': $('#OpcionA').val(),
                'OpcionB': $('#OpcionB').val(),
                'OpcionC': $('#OpcionC').val(),
                'OpcionD': $('#OpcionD').val()
            }
        });
        $('#EnunciadoPregunta, #OpcionA, #OpcionB, #OpcionC, #OpcionD').val('');
        refreshGridPreguntas();
    });

    $(document).on('click', '#btn_agregarSubCategoria', function () {
        $.ajax({
            async: false,
            type: "GET",
            dataType: "json",
            contentType: "application/json",
            url: '@Url.Action("AgregarSubCategoria", "Evaluacion")',
            data: {
                'IdCategoria': $('#idCategoria').val(),
                'Enunciado': $('#EnunciadoSubCategoria').val()
            }
        });
        $('#EnunciadoSubCategoria').val('');
        refreshGridSubCategorias();
    });

    function refreshGridPreguntas() {
        $.ajax({
            url: '@Url.Action("GetGridPreguntas", "Evaluacion")',
            type: 'POST',
            cache: false,
            async: true,
            success: function (result) { $('#tblPreguntas').html(result); }
        });
    }

    function refreshGridSubCategorias() {
        $.ajax({
            url: '@Url.Action("GetGridSubCategorias", "Evaluacion")',
            type: 'POST',
            cache: false,
            async: true,
            success: function (result) { $('#tblSubCategorias').html(result); }
        });
    }

    $(document).ready(function () {
        $("#tbEvaluacion").dataTable({
            "bRetrieve": true,
            "bProcessing": true,
            "dom": 'lBfrtip',
            "sAjaxSource": "@Url.Content("~/Evaluacion/GetGrid")",
            "buttons": [
                { extend: 'copyHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'excelHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'pdfHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'print', exportOptions: { columns: ':visible' } },
                'colvis'
            ],
            columnDefs: [
                { targets: [1], visible: false },
                { targets: [3], width: 110 }
            ],
            "pageLength": 10,
            "lengthMenu": [[5, 10, 25, 50, -1], [5, 10, 25, 50, "Todos"]],
            "aoColumns": [
                {
                    "mRender": function (oObj, type, row) {
                        return '<div class="text-center">'
                            + '<div class="btn-group">'
                            + '<button type="button" class="btn btn-xs btn-default dropdown-toggle" data-toggle="dropdown" style="border-radius:6px; border:1px solid #cbd5e1; font-size:12px; padding:4px 10px; color:#374151;">'
                            + '<i class="fa fa-cog" style="margin-right:4px;"></i> Acción <span class="caret"></span>'
                            + '</button>'
                            + '<ul class="dropdown-menu pull-left" role="menu" style="border-radius:10px; box-shadow:0 8px 24px rgba(0,0,0,0.12); border:1px solid #e2e8f0; min-width:160px; padding:6px 0;">'
                            + '<li><a href="' + ControlerNameCompany + '/Edit/' + row[0] + '" style="padding:8px 16px; font-size:13px; color:#1e293b; display:flex; align-items:center; gap:8px;"><i class="fa fa-edit" style="color:#0284c7;"></i> Modificar</a></li>'
                            + '<li><a href="' + ControlerNameCompany + '/Delete/' + row[0] + '" style="padding:8px 16px; font-size:13px; color:#ef4444; display:flex; align-items:center; gap:8px;"><i class="fa fa-trash"></i> Eliminar</a></li>'
