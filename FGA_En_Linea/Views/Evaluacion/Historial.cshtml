@{
    ViewBag.Title = "Historial de Evaluaci&oacute;n";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="https://cdn.datatables.net/rowgroup/1.1.2/js/dataTables.rowGroup.min.js"></script>

<section class="content-header">
    <h1 class="modern-page-title">
        <i class="fa fa-history" style="color: #0284c7;"></i>
        Historial de Evaluaci&oacute;n
        <small>Registro cronol&oacute;gico y detalle de respuestas por entidad</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="#">Evaluaci&oacute;n</a></li>
        <li class="active">Historial</li>
    </ol>
</section>
<section class="content">
    @using (Html.BeginForm("Buscar", "Evaluacion", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmBuscar" }))
    {
        @Html.AntiForgeryToken()
        <div class="row">
            <div class="col-xs-12">
                <div class="modern-filter-card">
                    <div class="modern-filter-toolbar">
                        <div class="filter-item">
                            <label for="IdEntidad"><i class="fa fa-university"></i> Entidad:</label>
                            @Html.DropDownList("Entidades", null, new { @id = "IdEntidad", @class = "form-control modern-select", style = "min-width: 250px;" })
                        </div>
                        <div class="filter-item" style="margin-left: auto;">
                            <button type="submit" name="submit" class="btn-modern-filter">
                                <i class="fa fa-search"></i> Generar
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-xs-12">
            <div class="modern-table-card">
                <div class="table-responsive" style="padding: 10px 16px 20px 16px;">
                    <div class="streaming-table">
                        <span id="found" class="label label-info"></span>
                        <table id="tbHistorial" class="table table-striped table-bordered modern-data-table" style="width: 100%;">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Usuario</th>
                                    <th>Componente</th>
                                    <th>Subcomponente</th>
                                    <th>Pregunta</th>
                                    <th>Opci&oacute;n seleccionada</th>
                                    <th>Detalle respuesta</th>
                                    <th>Aceptable</th>
                                    <th>Fuerte</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>

                        <div id="summary">
                            <div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    #tbHistorial thead th {
        text-transform: none !important;
        font-size: 13px !important;
        font-weight: 600 !important;
        letter-spacing: normal !important;
        color: #143750 !important;
        vertical-align: middle !important;
    }
</style>

<script type="text/javascript">

    var ControlerNameCompany = "@Url.Content("~/Evaluacion")";

    $(document).ready(function () {
        $("#tbHistorial").dataTable({
        "bRetrieve": true,
        "bProcessing": true,
        "dom": 'lBfrtip',
        "sAjaxSource": "@Url.Content("~/Evaluacion/GetHistorial")",
        "buttons": [
                { extend: 'copyHtml5', exportOptions: { columns: ':visible' } }
            ,{ extend: 'excelHtml5', exportOptions: { columns: ':visible' } }
            ,{ extend: 'pdfHtml5', exportOptions: { columns: ':visible' } }
            ,{ extend: 'print', exportOptions: { columns: ':visible' } }
            ,'colvis'
            ],
        "pageLength": 10,
        "order": [[2, 'asc']] ,
	rowGroup: {
       	 dataSrc: 2
   	},
        "lengthMenu": [[5,10, 25, 50, -1], [5,10, 25, 50, "Todos"]],
        "aoColumns": [
            {}, {}, {}, {}, {}, {}, {}, {}, {}]
        });
    });

</script>