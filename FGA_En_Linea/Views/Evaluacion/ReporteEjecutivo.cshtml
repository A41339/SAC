@model List<Entities.Entities.Procedures.FGA_Consultar_Historial_X_Categoria_Result>

@{
    Layout = null;
    string nombreEntidad = ViewBag.NombreEntidad != null ? ViewBag.NombreEntidad.ToString() : "Entidad";
    string idEntidad = ViewBag.IdEntidad != null ? ViewBag.IdEntidad.ToString() : "";
    string fechaReporte = ViewBag.FechaReporte != null ? ViewBag.FechaReporte.ToString() : DateTime.Now.ToString("dd/MM/yyyy HH:mm");
    int totalPreguntas = Model != null ? Model.Count : 0;
    int totalFuertes = Model != null ? Model.Count(m => !string.IsNullOrEmpty(m.OPCIONSELECCIONADA) && m.OPCIONSELECCIONADA.Trim().Equals("D", StringComparison.OrdinalIgnoreCase)) : 0;
    int totalAceptables = Model != null ? Model.Count(m => !string.IsNullOrEmpty(m.OPCIONSELECCIONADA) && m.OPCIONSELECCIONADA.Trim().Equals("C", StringComparison.OrdinalIgnoreCase)) : 0;
    int totalMejorables = Model != null ? Model.Count(m => !string.IsNullOrEmpty(m.OPCIONSELECCIONADA) && m.OPCIONSELECCIONADA.Trim().Equals("B", StringComparison.OrdinalIgnoreCase)) : 0;
    int totalDebiles = Model != null ? Model.Count(m => !string.IsNullOrEmpty(m.OPCIONSELECCIONADA) && m.OPCIONSELECCIONADA.Trim().Equals("A", StringComparison.OrdinalIgnoreCase)) : 0;
    var agrupadoComponentes = Model != null ? Model.GroupBy(m => m.NOMCATEGORIA).ToList() : null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=0.9, maximum-scale=1" />
    <title>Reporte Ejecutivo de Evaluaci&oacute;n - @nombreEntidad</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" />
    <link rel="stylesheet" href="@Url.Content("~/Content/evaluacion_reporte.css")" />
</head>
<body>

    <div class="toolbar-screen no-print">
        <div class="toolbar-title">
            <i class="fa fa-file-text-o" style="color: #86d2dd; font-size: 18px;"></i>
            <span>Reporte Ejecutivo de Evaluaci&oacute;n &mdash; @nombreEntidad</span>
        </div>
        <div class="toolbar-actions">
            <button type="button" onclick="window.print()" class="btn-action btn-print">
                <i class="fa fa-print"></i> Imprimir
            </button>
            <button type="button" onclick="window.close()" class="btn-action btn-close">
                <i class="fa fa-times"></i> Cerrar
            </button>
        </div>
    </div>

    <div class="report-page">

        <div class="report-header">
            <div class="logo-box">
                <img src="@Url.Content("~/Content/images/FFC.jpg")" alt="FFC" onerror="this.style.display='none'" />
                <div class="logo-text-group">
                    <span class="logo-main-text">FFC</span>
                    <span class="logo-sub-text">Sistema de An&aacute;lisis Cooperativo</span>
                </div>
            </div>
            <div class="entity-logo-box">
                @{
                    string rutaLogoEntidad = Url.Content("~/Content/images/" + nombreEntidad + ".jpg");
                }
                <img src="@rutaLogoEntidad" alt="@nombreEntidad" onerror="this.style.display='none'" />
            </div>
        </div>

        <div class="report-title-section">
            <h1 class="report-title">Informe Ejecutivo de Autoevaluaci&oacute;n</h1>
            <p class="report-subtitle">Supervisi&oacute;n Basada en Riesgo &middot; Reglamento SUGEF 24-22</p>
        </div>

        <div class="summary-card">
            <div class="summary-item">
                <span class="summary-label">Entidad Evaluada</span>
                <span class="summary-value">@nombreEntidad</span>
            </div>
            <div class="summary-item">
                <span class="summary-label">C&oacute;digo de Entidad</span>
                <span class="summary-value">@(string.IsNullOrEmpty(idEntidad) ? "SF" : idEntidad)</span>
            </div>
            <div class="summary-item">
                <span class="summary-label">Fecha y Hora de Emisi&oacute;n</span>
                <span class="summary-value">@fechaReporte</span>
            </div>
            <div class="summary-item">
                <span class="summary-label">Total Preguntas</span>
                <span class="summary-value">@totalPreguntas evaluadas</span>
            </div>
            <div class="summary-item">
                <span class="summary-label">Calificaciones Fuertes (D)</span>
                <span class="badge-metric badge-fuerte">
                    <i class="fa fa-shield"></i> @totalFuertes Fuertes
                </span>
            </div>
            <div class="summary-item">
                <span class="summary-label">Calificaciones Aceptables (C)</span>
                <span class="badge-metric badge-aceptable">
                    <i class="fa fa-check-circle"></i> @totalAceptables Aceptables
                </span>
            </div>
            <div class="summary-item">
                <span class="summary-label">Calificaciones Mejorables (B)</span>
                <span class="badge-metric badge-mejorable">
                    <i class="fa fa-exclamation-circle"></i> @totalMejorables Mejorables
                </span>
            </div>
            <div class="summary-item">
                <span class="summary-label">Calificaciones D&eacute;biles (A)</span>
                <span class="badge-metric badge-debil">
                    <i class="fa fa-times-circle"></i> @totalDebiles D&eacute;biles
                </span>
            </div>
        </div>

        @if (agrupadoComponentes == null || !agrupadoComponentes.Any())
        {
            <div style="text-align: center; padding: 40px; color: #64748b; background: #f8fafc; border-radius: 8px; border: 1px dashed #cbd5e1;">
                <i class="fa fa-info-circle" style="font-size: 32px; color: #0284c7; margin-bottom: 10px;"></i>
                <h3 style="margin: 0 0 6px 0; color: #1e293b;">No se encontraron registros de evaluaci&oacute;n</h3>
                <p style="margin: 0; font-size: 13px;">No hay preguntas ni respuestas registradas para la entidad seleccionada en el sistema.</p>
            </div>
        }
        else
        {
            int numPregunta = 1;
            foreach (var comp in agrupadoComponentes)
            {
                var subcomponentes = comp.GroupBy(s => s.NOMSUBCATEGORIA).ToList();
                int compFuertes = comp.Count(m => !string.IsNullOrEmpty(m.OPCIONSELECCIONADA) && m.OPCIONSELECCIONADA.Trim().Equals("D", StringComparison.OrdinalIgnoreCase));
                int compAceptables = comp.Count(m => !string.IsNullOrEmpty(m.OPCIONSELECCIONADA) && m.OPCIONSELECCIONADA.Trim().Equals("C", StringComparison.OrdinalIgnoreCase));
                int compMejorables = comp.Count(m => !string.IsNullOrEmpty(m.OPCIONSELECCIONADA) && m.OPCIONSELECCIONADA.Trim().Equals("B", StringComparison.OrdinalIgnoreCase));
                int compDebiles = comp.Count(m => !string.IsNullOrEmpty(m.OPCIONSELECCIONADA) && m.OPCIONSELECCIONADA.Trim().Equals("A", StringComparison.OrdinalIgnoreCase));

                <div class="component-block">
                    <div class="component-header">
                        <h2 class="component-title">
                            <i class="fa fa-folder-open-o"></i>
                            Componente: @comp.Key
                        </h2>
                        <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
                            <span class="component-count">@comp.Count() preguntas</span>
                            @if (compFuertes > 0)
                            {
                                <span class="component-count" style="background: rgba(3,105,161,0.3);"><i class="fa fa-shield"></i> @compFuertes Fuertes</span>
                            }
                            @if (compAceptables > 0)
                            {
                                <span class="component-count" style="background: rgba(4,120,87,0.3);"><i class="fa fa-check-circle"></i> @compAceptables Aceptables</span>
                            }
                            @if (compMejorables > 0)
                            {
                                <span class="component-count" style="background: rgba(180,83,9,0.3);"><i class="fa fa-exclamation-circle"></i> @compMejorables Mejorables</span>
                            }
                            @if (compDebiles > 0)
                            {
                                <span class="component-count" style="background: rgba(185,28,28,0.3);"><i class="fa fa-times-circle"></i> @compDebiles D&eacute;biles</span>
                            }
                        </div>
                    </div>

                    @foreach (var sub in subcomponentes)
                    {
                        <div class="subcomponent-block">
                            <div class="subcomponent-header">
                                <i class="fa fa-angle-right" style="color: #0284c7; font-size: 16px; font-weight: 700;"></i>
                                <h3 class="subcomponent-title">Subcomponente: @sub.Key</h3>
                            </div>

                            @foreach (var preg in sub)
                            {
                                string opSel = (preg.OPCIONSELECCIONADA ?? "").Trim().ToUpper();
                                string borderCol = "#0284c7";
                                if (opSel == "C") { borderCol = "#10b981"; }
                                else if (opSel == "B") { borderCol = "#f59e0b"; }
                                else if (opSel == "A") { borderCol = "#ef4444"; }

                                <div class="question-card" style="border-left-color: @borderCol;">
                                    <div class="question-meta">
                                        <span class="question-id">
                                            <i class="fa fa-question-circle" style="color: #0284c7;"></i>
                                            Pregunta #@(numPregunta++) &middot; (Ref: @(preg.IDPREGUNTA.HasValue ? preg.IDPREGUNTA.Value.ToString() : "N/A"))
                                        </span>
                                        <span>
                                            <i class="fa fa-user" style="margin-right: 4px;"></i>@(string.IsNullOrEmpty(preg.NOMUSUARIO) ? "Entidad" : preg.NOMUSUARIO)
                                            &middot;
                                            <i class="fa fa-calendar" style="margin-left: 6px; margin-right: 4px;"></i>@(preg.FECHA.HasValue ? preg.FECHA.Value.ToString("dd/MM/yyyy HH:mm") : "-")
                                        </span>
                                    </div>

                                    <div class="question-text">
                                        @preg.PREGUNTA
                                    </div>

                                    <div class="answer-box">
                                        <div class="answer-option-badge">
                                            @(string.IsNullOrEmpty(preg.OPCIONSELECCIONADA) ? "-" : preg.OPCIONSELECCIONADA.Trim())
                                        </div>
                                        <div class="answer-content">
                                            <div class="answer-label">Respuesta dada por la entidad:</div>
                                            <div class="answer-text">
                                                @(string.IsNullOrEmpty(preg.DETALLERESPUESTA) ? "(Sin respuesta registrada)" : preg.DETALLERESPUESTA.Trim())
                                            </div>
                                        </div>
                                        <div class="answer-qualification">
                                            @if (opSel == "D")
                                            {
                                                <span class="badge-metric badge-fuerte">
                                                    <i class="fa fa-shield"></i> Fuerte
                                                </span>
                                            }
                                            else if (opSel == "C")
                                            {
                                                <span class="badge-metric badge-aceptable">
                                                    <i class="fa fa-check-circle"></i> Aceptable
                                                </span>
                                            }
                                            else if (opSel == "B")
                                            {
                                                <span class="badge-metric badge-mejorable">
                                                    <i class="fa fa-exclamation-circle"></i> Mejorable
                                                </span>
                                            }
                                            else if (opSel == "A")
                                            {
                                                <span class="badge-metric badge-debil">
                                                    <i class="fa fa-times-circle"></i> D&eacute;bil
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }

        <div class="report-signatures">
            <div class="signatures-grid">
                <div class="signature-line-box">
                    <div class="signature-line"></div>
                    <div class="signature-name">Responsable de Autoevaluaci&oacute;n</div>
                    <div class="signature-role">@nombreEntidad</div>
                </div>
                <div class="signature-line-box">
                    <div class="signature-line"></div>
                    <div class="signature-name">Supervisor / Analista Asignado</div>
                    <div class="signature-role">Fondo de Garant&iacute;as y Confianza (FFC)</div>
                </div>
            </div>
            <div class="report-disclaimer">
                Documento de car&aacute;cter confidencial generado electr&oacute;nicamente a trav&eacute;s del Sistema de An&aacute;lisis Cooperativo (FFC).
                <br />
                Cumplimiento con las disposiciones t&eacute;cnicas de la Superintendencia General de Entidades Financieras (SUGEF).
            </div>
        </div>

    </div>
 
    <script type="text/javascript">
        try {
            if (window.self !== window.top) {
                document.body.classList.add('in-iframe');
            }
        } catch (e) { }
    </script>
</body>
</html>
