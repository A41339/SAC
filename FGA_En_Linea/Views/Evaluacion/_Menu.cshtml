<script type="text/javascript">
    function abrirPlanRemediacion() {
        var $btn = $('#btnAbrirPlanRemediacion');
        var originalHtml = $btn.length ? $btn.html() : '';
        if ($btn.length) {
            $btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Verificando...');
        }

        $.ajax({
            url: '@Url.Action("VerificarPlanRemediacion", "Evaluacion")',
            type: 'GET',
            cache: false,
            success: function (res) {
                if ($btn.length) {
                    $btn.prop('disabled', false).html(originalHtml);
                }
                if (res.existe) {
                    $('#visorPlanNombreEntidad').text(res.nombreEntidad || '');
                    $('#visorPlanArchivo').text(res.nombreArchivo || 'Plan_Remediacion.pdf');
                    $('#visorPlanFecha').text(res.fechaCarga || '');
                    $('#visorPlanUsuario').text(res.usuarioCarga || 'FFC');
                    $('#visorPlanTamanio').text(res.tamanio || '');

                    if (res.notas && res.notas.trim() !== '') {
                        $('#visorPlanNotas').text(res.notas);
                        $('#visorPlanNotasCont').removeClass('hidden');
                    } else {
                        $('#visorPlanNotasCont').addClass('hidden');
                    }

                    var urlConCacheBuster = res.urlVer + (res.urlVer.indexOf('?') === -1 ? '?' : '&') + 't=' + new Date().getTime();
                    $('#btnVisorDescargarPdf').attr('href', res.urlDescargar);
                    $('#btnVisorNuevaPestana').attr('href', urlConCacheBuster);
                    $('#iframePlanRemediacion').attr('src', urlConCacheBuster);

                    $('#modalVisorPlanRemediacion').modal('show');
                } else {
                    window._planRemediacionIdEntidad = res.idEntidad || '';
                    var nomEnt = (res.nombreEntidad && res.nombreEntidad.trim() !== '') ? res.nombreEntidad.trim() : 'su entidad';
                    $('#solicitarPlanNombreEntidad').text(nomEnt);
                    $('#solicitarPlanTagEntidad').text(nomEnt);

                    var ffcEmails = (res.correoFFC && res.correoFFC.trim() !== '') ? res.correoFFC.trim() : 'csalazar@ffc.co.cr; vzumbado@ffc.co.cr';
                    $('#solicitarPlanCorreoFFC').text(ffcEmails);

                    var entEmails = (res.contactoEntidad && res.contactoEntidad.trim() !== '') ? res.contactoEntidad.trim() : 'No registrado en el sistema';
                    $('#solicitarPlanContactos').text(entEmails);

                    var usrText = '';
                    if (res.usuarioActual && res.usuarioActual.trim() !== '') {
                        usrText = res.usuarioActual.trim();
                    }
                    if (res.correoUsuarioActual && res.correoUsuarioActual.trim() !== '') {
                        usrText = usrText ? (usrText + ' (' + res.correoUsuarioActual.trim() + ')') : res.correoUsuarioActual.trim();
                    }
                    if (!usrText) {
                        usrText = 'Usuario en sesión';
                    }
                    $('#solicitarPlanUsuario').text(usrText);

                    $('#txtMensajeSolicitudPlan').val('');
                    $('#alertSolicitarPlan').addClass('hidden').empty();
                    $('#btnEnviarSolicitudPlan').prop('disabled', false).html('<i class="fa fa-envelope"></i> Solicitar Plan de Remediaci&oacute;n al FFC');

                    $('#modalSolicitarPlan').modal('show');
                }
            },
            error: function () {
                if ($btn.length) {
                    $btn.prop('disabled', false).html(originalHtml);
                }
                alert('No fue posible consultar el estado del Plan de Remediación. Por favor intente nuevamente.');
            }
        });
    }

    $('#modalVisorPlanRemediacion').on('hidden.bs.modal', function () {
        $('#iframePlanRemediacion').attr('src', 'about:blank');
    });

    function enviarSolicitudPlanRemediacion() {
        var $btn = $('#btnEnviarSolicitudPlan');
        var mensaje = $('#txtMensajeSolicitudPlan').val();

        $btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Enviando solicitud...');
        $('#alertSolicitarPlan').addClass('hidden').empty();

        $.ajax({
            url: '@Url.Action("SolicitarPlanRemediacion", "Evaluacion")',
            type: 'POST',
            data: { idEntidad: window._planRemediacionIdEntidad || '', mensaje: mensaje },
            success: function (res) {
                if (res.success) {
                    $('#alertSolicitarPlan').removeClass('alert-danger').addClass('alert-success')
                        .html('<i class="fa fa-check-circle"></i> ' + res.message).show();
                    $btn.html('<i class="fa fa-check"></i> Solicitud Enviada');
                    setTimeout(function () {
                        $('#modalSolicitarPlan').modal('hide');
                    }, 2500);
                } else {
                    $btn.prop('disabled', false).html('<i class="fa fa-envelope"></i> Solicitar Plan de Remediaci&oacute;n al FFC');
                    $('#alertSolicitarPlan').removeClass('alert-success').addClass('alert-danger')
                        .html('<i class="fa fa-exclamation-triangle"></i> ' + res.message).show();
                }
            },
            error: function () {
                $btn.prop('disabled', false).html('<i class="fa fa-envelope"></i> Solicitar Plan de Remediaci&oacute;n al FFC');
                $('#alertSolicitarPlan').removeClass('alert-success').addClass('alert-danger')
                    .html('<i class="fa fa-exclamation-triangle"></i> Error al comunicarse con el servidor.').show();
            }
        });
    }
</script>
