@model FGA.Model.Modelo_Evaluacion

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="justify-content-center">
    <div id="navWizard" style="height:100%">
        <ul id="navWizardSteps" class="nav nav-tabs" role="tablist">
            <li class="nav-item">
                <a class="nav-link @(Model.eval.ToString().ToLower() == "true" ? "" : "active")" id="paso1-tab" data-toggle="tab" href="#paso1" role="tab" aria-controls="paso1" aria-selected="true"></a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="paso2-tab" data-toggle="tab" href="#paso2" role="tab" aria-controls="paso2" aria-selected="false"></a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="paso3-tab" data-toggle="tab" href="#paso3" role="tab" aria-controls="paso3" aria-selected="false"></a>
            </li>
            @if (Env.GetUserInfo("roleid") == "10" || Session["IsFGA"].ToString() == "1")
            {
                <li class="nav-item">
                    <a class="nav-link" id="paso4-tab" data-toggle="tab" href="#paso4" role="tab" aria-controls="paso4" aria-selected="false"></a>
                </li>
            }
            <li class="nav-item">
                <a class="nav-link @(Model.eval.ToString().ToLower() == "true" ? "active" : "")" id="paso5-tab" data-toggle="tab" href="#paso5" role="tab" aria-controls="paso5" aria-selected="false"></a>
            </li>
        </ul>
        <div class="tab-content align-middle" id="myTabContent" style="padding-top: 15px;">
            <!-- PASO 1: INTRODUCCI&Oacute;N -->
            <div class="tab-pane @(Model.eval.ToString().ToLower() == "true" ? "" : "active")" id="paso1" role="tabpanel" aria-labelledby="paso1-tab">
                <div class="eval-hero-card">
                    <div class="eval-hero-header">
                        <span class="eval-hero-badge">
                            <i class="fa fa-shield"></i> Normativa SUGEF 24-22
                        </span>
                        <h2 class="eval-hero-title">
                            Autoevaluaci&oacute;n de Supervisi&oacute;n Basada en Riesgos (SBR)
                        </h2>
                        <p class="eval-hero-subtitle">
                            M&oacute;dulo de diagn&oacute;stico integral y fortalecimiento para entidades afiliadas a FFC
                        </p>
                    </div>

                    <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 24px; margin-bottom: 24px;">
                        <p style="font-size: 15px; line-height: 1.75; color: #334155; margin-bottom: 14px; text-align: justify;">
                            FFC ha realizado esta autoevaluaci&oacute;n con el prop&oacute;sito de colaborar con las entidades afiliadas en la identificaci&oacute;n de las brechas existentes en los riesgos a evaluar por el Supervisor. La misma no constituye una evaluaci&oacute;n donde hay calificaciones buenas o malas, por tal motivo es muy importante que, al momento de realizarla, la elecci&oacute;n de cada respuesta se apegue a la realidad de la Cooperativa.
                        </p>
                        <p style="font-size: 15px; line-height: 1.75; color: #334155; margin-bottom: 14px; text-align: justify;">
                            Si al contestar cada criterio usted elige la mejor respuesta, pero no la que se ajusta a su entidad, no se lograr&aacute; el objetivo de este ejercicio, que es brindarle a la Cooperativa una herramienta de ayuda.
                        </p>
                        <p style="font-size: 15px; line-height: 1.75; color: #334155; margin: 0; text-align: justify;">
                            La autoevaluaci&oacute;n es completamente confidencial y los resultados nos permitir&aacute;n elaborar un diagn&oacute;stico para enfocar los esfuerzos en atender las &aacute;reas m&aacute;s d&eacute;biles de la entidad.
                        </p>
                    </div>

                    <div style="display: flex; align-items: center; justify-content: center; gap: 14px; margin-bottom: 24px; flex-wrap: wrap;">
                        <button type="button" class="btn btn-primary" onclick="javascript:back(1)" style="font-weight: 700; font-size: 14px; padding: 10px 24px; border-radius: 8px; background: linear-gradient(135deg, #1e40af 0%, #1d4ed8 100%); border: none; box-shadow: 0 4px 12px rgba(30, 64, 175, 0.25); display: inline-flex; align-items: center; gap: 8px;">
                            <i class="fa fa-pencil-square-o"></i> Autoevaluaci&oacute;n
                        </button>
                        <button type="button" id="btnAbrirPlanRemediacion" class="btn btn-default btn-eval-plan-remediacion" onclick="abrirPlanRemediacion()">
                            <i class="fa fa-file-pdf-o text-danger"></i> Plan de remediaci&oacute;n
                        </button>
                    </div>

                    <div class="eval-feature-grid">
                        <div class="eval-feature-card">
                            <div class="eval-feature-icon icon-blue">
                                <i class="fa fa-balance-scale"></i>
                            </div>
                            <h4 class="eval-feature-title">Marco Regulatorio</h4>
                            <p class="eval-feature-desc">Alineado a las directrices de SUGEF 24-22 con criterios cualitativos y cuantitativos de supervisi&oacute;n.</p>
                        </div>
                        <div class="eval-feature-card">
                            <div class="eval-feature-icon icon-teal">
                                <i class="fa fa-tasks"></i>
                            </div>
                            <h4 class="eval-feature-title">Autodiagn&oacute;stico</h4>
                            <p class="eval-feature-desc">Evaluaci&oacute;n progresiva por componentes y subcomponentes con guardado autom&aacute;tico continuo.</p>
                        </div>
                        <div class="eval-feature-card" onclick="abrirPlanRemediacion()" style="cursor: pointer;" title="Consultar Plan de Remediaci&oacute;n FFC">
                            <div class="eval-feature-icon icon-amber">
                                <i class="fa fa-file-pdf-o"></i>
                            </div>
                            <h4 class="eval-feature-title" style="display: flex; align-items: center; justify-content: center; gap: 6px;">
                                Plan de Remediaci&oacute;n <i class="fa fa-external-link" style="font-size: 11px; color: #b45309;"></i>
                            </h4>
                            <p class="eval-feature-desc">Recomendaciones y plan elaborado por el FFC para fortalecer indicadores y mitigar riesgos.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PASO 2: DESCARGO -->
            <div class="tab-pane" id="paso2" role="tabpanel" aria-labelledby="paso2-tab">
                <div class="eval-disclaimer-card">
                    <div class="eval-disclaimer-header">
                        <div class="eval-disclaimer-icon">
                            <i class="fa fa-balance-scale"></i>
                        </div>
                        <div>
                            <h3 style="color: #143750; font-weight: 700; font-size: 22px; margin: 0 0 6px 0;">
                                Descargo de Responsabilidad y Confidencialidad
                            </h3>
                            <p style="color: #64748b; font-size: 14px; margin: 0;">
                                Compromiso de veracidad y principios rectores de la autoevaluaci&oacute;n SBR
                            </p>
                        </div>
                    </div>

                    <div class="eval-disclaimer-point" style="border-left-color: #0284c7;">
                        <i class="fa fa-info-circle" style="color: #0284c7; font-size: 20px; margin-top: 2px;"></i>
                        <p>
                            FFC ha realizado esta autoevaluaci&oacute;n con el prop&oacute;sito de colaborar con las entidades afiliadas en la <strong>identificaci&oacute;n de las brechas existentes</strong> en los riesgos a evaluar por el Supervisor. La misma no constituye una evaluaci&oacute;n punitiva donde haya calificaciones buenas o malas, sino una herramienta t&eacute;cnica de acompa&ntilde;amiento.
                        </p>
                    </div>

                    <div class="eval-disclaimer-point" style="border-left-color: #f59e0b;">
                        <i class="fa fa-exclamation-triangle" style="color: #f59e0b; font-size: 20px; margin-top: 2px;"></i>
                        <p>
                            Al contestar cada criterio, es imperativo que la elecci&oacute;n de cada respuesta <strong>se apegue estrictamente a la realidad demostrable de la Cooperativa</strong>. Si se selecciona la mejor respuesta te&oacute;rica en lugar de la realidad operativa con evidencia de respaldo, no se lograr&aacute; el beneficio de diagn&oacute;stico preventivo de este ejercicio.
                        </p>
                    </div>

                    <div class="eval-disclaimer-point" style="border-left-color: #10b981;">
                        <i class="fa fa-lock" style="color: #10b981; font-size: 20px; margin-top: 2px;"></i>
                        <p>
                            <strong>Confidencialidad Garantizada:</strong> La informaci&oacute;n ingresada en la autoevaluaci&oacute;n es completamente confidencial. Los resultados permitir&aacute;n estructurar un diagn&oacute;stico t&eacute;cnico para enfocar los esfuerzos y asesor&iacute;a en atender las &aacute;reas de mayor sensibilidad de la entidad.
                        </p>
                    </div>
                </div>
            </div>

            <!-- PASO 3: INSTRUCCIONES & VIDEO -->
            <div class="tab-pane" id="paso3" role="tabpanel" aria-labelledby="paso3-tab">
                <div class="eval-instructions-container">
                    <div class="row">
                        <div class="col-xs-12 text-center" style="margin-bottom: 24px;">
                            <span class="eval-hero-badge">
                                <i class="fa fa-book"></i> Gu&iacute;a Operativa
                            </span>
                            <h2 style="color: #143750; font-weight: 700; font-size: 24px; margin: 6px 0 0 0;">
                                Instrucciones para la Autoevaluaci&oacute;n
                            </h2>
                        </div>
                    </div>
                    <div class="row" style="display: flex; flex-wrap: wrap; align-items: center; justify-content: center;">
                        <div id="videohelp" class="col-md-7 col-xs-12 hidden" style="padding-right: 24px;">
                            <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 24px;">
                                <h4 style="color: #143750; font-weight: 700; margin-top: 0;">Pautas Metodol&oacute;gicas:</h4>
                                <ul style="padding-left: 20px; color: #475569; font-size: 14px; line-height: 1.7;">
                                    <li>La evaluaci&oacute;n consta de <strong>165 preguntas</strong> distribuidas en 4 componentes cualitativos y subcomponentes, m&aacute;s un componente de Nivel y Calidad del Capital Base.</li>
                                    <li>Se deben <strong>designar 2 responsables</strong> por componente, dados de alta previamente como usuarios de la herramienta SAC.</li>
                                    <li><strong>Sin l&iacute;mite de tiempo:</strong> cada pregunta tiene cuatro opciones de respuesta orientadas a reflejar la realidad con evidencia verificable.</li>
                                    <li><strong>Autoguardado:</strong> al salir se guardar&aacute; la &uacute;ltima pregunta completada. Puede devolverse a revisar respuestas anteriores.</li>
                                    <li>Completado cada componente, se le solicitar&aacute; confirmaci&oacute;n antes de salvar y enviar en forma definitiva.</li>
                                </ul>
                            </div>
                        </div>
                        <div id="video" class="col-md-12 col-xs-12 text-center">
                            <div class="eval-video-frame">
                                <video controls="controls" id="evalSpeaker" style="width: 480px; max-width: 100%; height: auto; max-height: 520px;">
                                    <source src="~/Content/Video/eval11.mp4" type="video/mp4" />
                                    <p>Tu navegador no soporta la reproducci&oacute;n de video HTML5.</p>
                                </video>
                            </div>
                            <div style="margin-top: 14px;">
                                <a id="showHelp" style="font-size: 15px; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; padding: 8px 18px; border-radius: 20px; background: #e0f2fe; color: #0284c7; font-weight: 600; text-decoration: none;"
                                   onclick="javascript:showHelp(); help('Instrucciones para realizar la autoevaluaci&oacute;n');">
                                    <i class="fa fa-info-circle"></i> Ver texto de instrucciones
                                </a>
                                <a id="hideHelp" class="hidden" style="font-size: 15px; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; padding: 8px 18px; border-radius: 20px; background: #f1f5f9; color: #64748b; font-weight: 600; text-decoration: none;"
                                   onclick="javascript:hideHelp();">
                                    <i class="fa fa-chevron-left"></i> Ocultar panel
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PASO 4: DESIGNACI&Oacute;N DE RESPONSABLES -->
            @if (Env.GetUserInfo("roleid") == "10" || Session["IsFGA"].ToString() == "1")
            {
                <div class="tab-pane" id="paso4" role="tabpanel" aria-labelledby="paso4-tab">
                    <div class="modern-table-card">
                        <div class="modern-table-header">
                            <div>
                                <h3 class="modern-table-title">
                                    <i class="fa fa-users" style="color: #0284c7; margin-right: 6px;"></i> Designaci&oacute;n de Responsables por Criterio
                                </h3>
                                <p class="modern-table-subtitle">Asignaci&oacute;n de roles para el diligenciamiento de la autoevaluaci&oacute;n</p>
                            </div>
                            @if (Session["Logo"] != null && !string.IsNullOrEmpty(Session["Logo"].ToString()))
                            {
                                <div>
                                    <img height="44" src="@Session["Logo"]" style="object-fit: contain; max-width: 140px;" />
                                </div>
                            }
                        </div>

                        <div class="table-responsive" style="padding: 16px 20px;">
                            @if (Model != null)
                            {
                                var activo = "";
                                var cantidad = 0;
                                <table class="table modern-data-table">
                                    <thead>
                                        <tr>
                                            <th style="min-width: 240px;">Criterio a evaluar</th>
                                            <th style="min-width: 200px;">Responsable sugerido</th>
                                            <th style="min-width: 240px;">Primer Responsable</th>
                                            <th style="min-width: 240px;">Segundo Responsable</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var eval in Model.listaCategorias)
                                        {
                                            <tr>
                                                <td style="vertical-align: middle; font-weight: 600; color: #1e293b;">
                                                    @eval.Titulo
                                                </td>
                                                <td style="vertical-align: middle; color: #64748b; font-size: 13px;">
                                                    <i class="fa fa-user-circle-o" style="color: #0284c7; margin-right: 4px;"></i> @eval.ResponsableSugerido
                                                </td>
                                                <td style="vertical-align: middle;">
                                                    <select id="IdResponsable1" class="form-control modern-select" style="width: 100%;" name="IdResponsable1" onchange="javascript:Responsable(this.value, 0, @eval.Id)">
                                                        <option value="0" selected>-- Seleccione --</option>
                                                        @foreach (var detalle in Model.listaUsuarios)
                                                        {
                                                            activo = "";
                                                            foreach (var resp in Model.listaResponsables)
                                                            {
                                                                if (resp.IdCategoria_Id == eval.Id && resp.IdUsuario_Id1 == detalle.Id)
                                                                {
                                                                    cantidad += 1;
                                                                    activo = "selected";
                                                                }
                                                            }
                                                            <option @(string.IsNullOrEmpty(activo) ? "" : "selected") value="@detalle.Id">@detalle.Nombre</option>
                                                        }
                                                    </select>
                                                </td>
                                                <td style="vertical-align: middle;">
                                                    <select id="IdResponsable2" class="form-control modern-select" style="width: 100%;" name="IdResponsable2" onchange="javascript:Responsable(0, this.value, @eval.Id)">
                                                        <option value="0" selected>-- Seleccione --</option>
                                                        @foreach (var detalle in Model.listaUsuarios)
                                                        {
                                                            activo = "";
                                                            foreach (var resp in Model.listaResponsables)
                                                            {
                                                                if (resp.IdCategoria_Id == eval.Id && resp.IdUsuario_Id2 == detalle.Id)
                                                                {
                                                                    cantidad += 1;
                                                                    activo = "selected";
                                                                }
                                                            }
                                                            <option @(string.IsNullOrEmpty(activo) ? "" : "selected") value="@detalle.Id">@detalle.Nombre</option>
                                                        }
                                                    </select>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                <input type="hidden" id="cant_responsables" value="@cantidad" />
                            }

                            <div style="margin-top: 20px; padding: 14px 20px; border-radius: 10px; background: #fffbeb; border: 1px solid #fde68a; display: flex; align-items: center; gap: 12px;">
                                <i class="fa fa-bell" style="color: #d97706; font-size: 18px;"></i>
                                <span style="color: #92400e; font-size: 13px; font-weight: 500;">
                                    Si el colaborador encargado de completar el componente no est&aacute; presente en la lista desplegable, deber&aacute; solicitarle al usuario maestro que proceda a registrarlo en la herramienta SAC.
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- PASO 5: AUTOEVALUACI&Oacute;N -->
            <div class="tab-pane @(Model.eval.ToString().ToLower() == "true" ? "active" : "")" id="paso5" role="tabpanel" aria-labelledby="paso5-tab">
                


                <div class="eval-section-title-wrap">
                    <div class="eval-section-title">
                        <span class="eval-section-title-bar"></span>
                        <h3>Seleccione la opci&oacute;n que desea consultar</h3>
                    </div>
                    <div class="dropdown">
                        <button class="eval-fab-btn dropdown-toggle" type="button" id="dropdownMenuLink" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" title="Men&uacute; de Navegaci&oacute;n">
                            <i class="fa fa-bars"></i>
                        </button>
                        <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuLink" style="border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.15); border: 1px solid #e2e8f0; min-width: 220px; padding: 8px;">
                            <a class="dropdown-item" href="javascript:back(0)" style="display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 8px; color: #1e293b; font-weight: 500;">
                                <i class="fa fa-home" style="color: #0284c7; font-size: 16px;"></i> Inicio
                            </a>
                            <a class="dropdown-item" href="javascript:back(1)" style="display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 8px; color: #1e293b; font-weight: 500;">
                                <i class="fa fa-balance-scale" style="color: #0284c7; font-size: 16px;"></i> Descargo
                            </a>
                            <a class="dropdown-item" href="javascript:back(2)" style="display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 8px; color: #1e293b; font-weight: 500;">
                                <i class="fa fa-info-circle" style="color: #0284c7; font-size: 16px;"></i> Instrucciones
                            </a>
                            @if (Env.GetUserInfo("roleid") == "10" || Session["IsFGA"].ToString() == "1")
                            {
                                <a class="dropdown-item" href="javascript:back(3)" style="display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 8px; color: #1e293b; font-weight: 500;">
                                    <i class="fa fa-users" style="color: #0284c7; font-size: 16px;"></i> Responsables
                                </a>
                                <a class="dropdown-item" href="javascript:back(4)" style="display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 8px; color: #1e293b; font-weight: 500;">
                                    <i class="fa fa-file-text-o" style="color: #0284c7; font-size: 16px;"></i> Evaluaci&oacute;n
                                </a>
                            }
                            else
                            {
                                <a class="dropdown-item" href="javascript:back(3)" style="display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 8px; color: #1e293b; font-weight: 500;">
                                    <i class="fa fa-file-text-o" style="color: #0284c7; font-size: 16px;"></i> Evaluaci&oacute;n
                                </a>
                            }
                        </div>
                    </div>
                </div>

                @if (Model != null && Model.listaCategorias.Count > 0)
                {
                    <div class="eval-cards-grid">
                        @foreach (var eval in Model.listaCategorias)
                        {
                            var permiso = 0;
                            if (Session["IsFGA"].ToString() == "1")
                            {
                                permiso = 1;
                            }
                            else
                            {
                                foreach (var miEval in Model.misCategorias)
                                {
                                    if (miEval.Id == eval.Id)
                                    {
                                        permiso = 1;
                                    }
                                }
                            }

                            // Obtener icono y colores segun el componente
                            string tituloLower = (eval.Titulo ?? "").ToLowerInvariant();
                            string cardIcon = "fa fa-university";
                            string cardBg = "#e0f2fe";
                            string cardColor = "#0284c7";

                            if (tituloLower.Contains("gobierno"))
                            {
                                cardIcon = "fa fa-university";
                                cardBg = "#e0f2fe";
                                cardColor = "#0284c7";
                            }
                            else if (tituloLower.Contains("riesgo"))
                            {
                                cardIcon = "fa fa-shield";
                                cardBg = "#e0f2fe";
                                cardColor = "#0284c7";
                            }
                            else if (tituloLower.Contains("econ") || tituloLower.Contains("financier"))
                            {
                                cardIcon = "fa fa-line-chart";
                                cardBg = "#ffedd5";
                                cardColor = "#ea580c";
                            }
                            else if (tituloLower.Contains("legal") || tituloLower.Contains("regulator"))
                            {
                                cardIcon = "fa fa-balance-scale";
                                cardBg = "#ffedd5";
                                cardColor = "#ea580c";
                            }
                            else if (tituloLower.Contains("capital") || tituloLower.Contains("suficiencia"))
                            {
                                cardIcon = "fa fa-database";
                                cardBg = "#e0f2fe";
                                cardColor = "#0284c7";
                            }

                            string cardDesc = eval.Descripcion ?? "";

                            // Calculo del porcentaje inicial promedio del componente
                            int subCatCount = eval.SubCategorias != null ? eval.SubCategorias.Count : 0;
                            decimal avanceTotal = 0;
                            if (subCatCount > 0 && Model.evaluaciones != null)
                            {
                                foreach (var sub in eval.SubCategorias)
                                {
                                    avanceTotal += FGA.Utility.Utilitarios.GetSubCategoriaPorcentaje(sub.Id, Model.evaluaciones);
                                }
                            }
                            decimal avancePromedio = subCatCount > 0 ? Math.Round(avanceTotal / subCatCount, 0) : 0;

                            <div class="eval-consult-card" style="@(permiso == 0 ? "opacity: 0.82;" : "")">
                                <div>
                                    <div class="eval-consult-header">
                                        <div class="eval-icon-circle-box" style="background-color: @cardBg; color: @cardColor;">
                                            <i class="@cardIcon" style="font-size: 22px;"></i>
                                        </div>
                                        <h4 class="eval-consult-title">
                                            @eval.Titulo
                                        </h4>
                                        <div class="eval-consult-chevron" onclick="javascript:focusSubcomp('@("C" + eval.Id)')" title="Abrir subcomponente">
                                            <i class="fa fa-chevron-right"></i>
                                        </div>
                                    </div>
                                    <div class="eval-consult-desc">
                                        @Html.Raw(cardDesc)
                                    </div>
                                </div>

                                <div class="eval-consult-footer">
                                    <div class="eval-field-row">
                                        <label class="eval-field-label">Subcomponente:</label>
                                        <select class="eval-field-select" id="@("C" + eval.Id)" onchange="javascript:calcularPorcentaje('@("C" + eval.Id)')" name="subCategoria">
                                            <option value="0">@(permiso == 0 ? "No autorizado como responsable" : "--Seleccione--")</option>
                                            @if (permiso != 0 && eval.SubCategorias.Count > 0)
                                            {
                                                foreach (var item in eval.SubCategorias)
                                                {
                                                    string detail = FGA.Utility.Utilitarios.GetSubCategoriaPorcentaje(item.Id, Model.evaluaciones) == 100 
                                                        ? " (Completado)" 
                                                        : " (Pendiente)";
                                                    <option value="@item.Id">
                                                        @(item.Enunciado + detail)
                                                    </option>
                                                }
                                            }
                                        </select>
                                    </div>

                                    <div class="eval-field-row">
                                        <label class="eval-field-label">Avance:</label>
                                        <span id="@("porc_avance_C" + eval.Id)" class="eval-avance-val-highlight">
                                            @(avancePromedio)%
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <input type="hidden" value="0" id="S0" />
                            if (eval.SubCategorias != null)
                            {
                                foreach (var item in eval.SubCategorias)
                                {
                                    <input type="hidden" value="@(FGA.Utility.Utilitarios.GetPorcentaje(item.Id, Model.evaluaciones))" id="@("S" + item.Id.ToString())" />
                                }
                            }
                        }
                    </div>
                }
            </div>

        </div>
    </div>
</div>
<div id="leyenda"></div>

<script type="text/javascript">

    function back(id) {
        $($('#navWizardSteps li > a')[id]).tab('show');
    }

    function focusSubcomp(selectId) { var el = document.getElementById(selectId); if (el) { el.focus(); if (el.selectedIndex > 0) { calcularPorcentaje(selectId); } } }

    function calcularPorcentaje(id) {
        var subCategoria = $('#' + id).val();
        if (!subCategoria || subCategoria === "0" || subCategoria === 0) {
            return;
        }
        var porcentajeAvance = $('#S' + subCategoria).val() || '0%';
        var lbl = document.getElementById('porc_avance_' + id) || document.getElementById('porc_avance');
        if (lbl) {
            lbl.innerHTML = porcentajeAvance;
        }
        var numAvance = parseFloat(porcentajeAvance) || 0;
        $('#bar_' + id).css('width', numAvance + '%');
        generarEvaluacion(subCategoria);
    }

    $('#subCategoria').on('change', function () {
        var val = $(this).val();
        if (val && val !== "0") {
            generarEvaluacion(val);
        }
    });

    function showHelp() {
        $('#showHelp').addClass("hidden");
        $('#hideHelp').removeClass("hidden");

        $('#videohelp').removeClass("hidden");
        $('#video').removeClass("col-12 col-md-12 col-xl-12");
        $('#video').addClass("col-5 col-md-5 col-xl-5");
    }

    function hideHelp() {
        $('#showHelp').removeClass("hidden");
        $('#hideHelp').addClass("hidden");

        $('#videohelp').addClass("hidden");
        $('#video').removeClass("col-5 col-md-5 col-xl-5");
        $('#video').addClass("col-12 col-md-12 col-xl-12");
    }

    function Responsable(IdUsuario1, IdUsuario2, IdCategoria) {
         $.ajax({
            url: '@Url.Action("AsignarResponsable", "Evaluacion")',
            type: 'POST',
            cache: false,
            async: true,
            data: {
                'idUsuario1': IdUsuario1,
                'idUsuario2': IdUsuario2,
                'idCategoria': IdCategoria,
            },
            success: function (data) {
               if (data == 1)
                   $('#jqb-btn-next').removeClass("hidden");
            }
         });
    }

    let vid = document.getElementById("evalSpeaker");
    if (vid) {
        vid.onended = function () {
            $('#jqb-btn-next').removeClass("hidden");
        };
    }

</script>
