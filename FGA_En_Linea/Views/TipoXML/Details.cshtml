@model FGA.Models.TipoXML

@{
    ViewBag.Title = "Consultar un Tipo de XML";
    if (Ajax.IsThisAjaxRequest())
    {
        Layout = null;
    }
}
<section class="content-header">
    <h1>
        <i class="fa fa-info-circle"></i> Consultar Tipo de XML
        <small>Estructura, campos requeridos y formato del tipo de archivo XML.</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="@Url.Action("Index", "Modulo", new { modulo = "TipoXML/Details" })" class="breadcrumb-parent-pill"><i class="fa fa-wrench" style="margin-right: 4px;"></i> Mantenimientos</a></li>
        <li class="active">Consultar Tipo XML</li>
    </ol>
</section>
<section class="content">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        <div class="col-xs-12">
            <div class="box box-solid box-info">
                <div class="box-header">
                    <h3 class="box-title">Detalles</h3>
                </div><!-- /.box-header -->
                <div class="box-body table-responsive">
                    <div class="widget-sec">
                        <div class="streaming-table">
                            <table class="table table-striped table-bordered">
                                <tr>
                                    <td>Id</td>
                                    <td>@Html.DisplayFor(model => model.Id)</td>
                                </tr>
                                <tr>
                                    <td>Nombre</td>
                                    <td>@Html.Raw(Model.Nombre)</td>
                                </tr>
                                @*<tr>
                                    <td>D&iacute;a M&aacute;ximo</td>
                                    <td>@Html.DisplayFor(model => model.DiaMaximo)</td>
                                </tr>
                                <tr>
                                    <td>Prioridad</td>
                                    <td>@Html.DisplayFor(model => model.Prioridad)</td>
                                </tr>*@
                            </table>
                            <div class="box-footer">                                 
                                @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-primary" })
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>



