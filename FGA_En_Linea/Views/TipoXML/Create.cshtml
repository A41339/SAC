@model FGA.Models.TipoXML

@{
    ViewBag.Title = "Crear";
    if (Ajax.IsThisAjaxRequest())
    {
        Layout = null;
    }
}

@Html.StarkAjaxFormSubmiter("frmTipoXML", "tbTipoXML", true, "Acci&oacute;n ejecutada con &eacute;xito")

@{
    if (!Ajax.IsThisAjaxRequest())
    {
        <section class="content-header">
    <h1>
        <i class="fa fa-plus-circle"></i> Creaci&oacute;n de Tipo de XML
        <small>Configuraci&oacute;n de nuevo tipo de archivo XML para la validaci&oacute;n de cargas.</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="@Url.Action("Index", "Modulo", new { modulo = "TipoXML/Create" })" class="breadcrumb-parent-pill"><i class="fa fa-wrench" style="margin-right: 4px;"></i> Mantenimientos</a></li>
        <li class="active">Crear Tipo XML</li>
    </ol>
</section>
    }
}

@using (Html.BeginForm("Create", "TipoXML", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmTipoXML" }))
{
    @Html.AntiForgeryToken()
    <!-- Main content -->
    <section class="content">
        <!-- Small boxes(Stat box) -->
        <div class="row">
            <div class="col-xs-12">
                <div class="box box-solid box-info">
                    <div role="form">
                        <div class="box-body">
                            <div class="form-group">
                                @Html.LabelFor(model => model.Id, new { @class = "" })
                                @Html.EditorFor(model => model.Id)
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.Nombre, new { @class = "" })
                                @Html.EditorFor(model => model.Nombre)
                            </div>
                            <div class="box-footer">
                                @Html.StarkInputButtion("Guardar", "submit", "btn btn-primary", "")
                                @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-primary" })
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

}


