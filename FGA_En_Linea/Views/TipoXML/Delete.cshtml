@model FGA.Models.TipoXML

@{
    ViewBag.Title = "Est&aacute; seguro de eliminar el tipo de XML?";
    if (Ajax.IsThisAjaxRequest())
    {
        Layout = null;
    }
}

@Html.StarkAjaxFormSubmiter("frmTipoXML", "tbTipoXML", true, "Acci&oacute;n ejecutada con &eacute;xito")

@{
    if (!Ajax.IsThisAjaxRequest())
    {
        <section class="content-header">
    <h1>
        <i class="fa fa-trash"></i> Eliminar Tipo de XML
        <small>Confirmaci&oacute;n de eliminaci&oacute;n de configuraci&oacute;n de archivo XML.</small>
    </h1>
</section>
    }
}

<section class="content">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        <div class="col-xs-12">

            <div class="box box-solid box-info">
                <div class="box-header">
                    <h3 class="box-title">Detalles</h3>
                </div><!-- /.box-header -->
                <div class="box-body table-responsive">

                    <div class="widget-sec">
                        <div class="streaming-table">
                            <table class="table table-striped table-bordered">
                                <tr>
                                    <td>Id</td>
                                    <td>@Html.DisplayFor(model => model.Id)</td>
                                </tr>
                                <tr>
                                    <td>Nombre</td>
                                    <td>@Html.Raw(Model.Nombre)</td>
                                </tr>
                                @*<tr>
                                    <td>D&iacute;a M&aacute;ximo</td>
                                    <td>@Html.DisplayFor(model => model.DiaMaximo)</td>
                                </tr>

                                <tr>
                                    <td>Prioridad</td>
                                    <td>@Html.DisplayFor(model => model.Prioridad)</td>
                                </tr>*@
                            </table>
                            <div class="box-footer">

                                @using (Html.BeginForm("Delete", "TipoXML", FormMethod.Post, new { id = "frmTipoXML" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.StarkInputButtion("Borrar", "submit", "btn btn-danger", "")
                                    @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-primary" })
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>



