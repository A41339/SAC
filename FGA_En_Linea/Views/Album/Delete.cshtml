@model FGA.Models.Album

@{
    ViewBag.Title = "Está seguro de eliminar el Álbum?";
    if (Ajax.IsThisAjaxRequest())
    {
        Layout = null;
    }
}

@Html.StarkAjaxFormSubmiter("frmAlbum", "tbAlbum", true, "Acción ejecutada con éxito")

@{
    if (!Ajax.IsThisAjaxRequest())
    {
        <section class="content-header">
    <h1>
        <i class="fa fa-trash"></i> Eliminar Galer&iacute;a
        <small>Confirmaci&oacute;n de eliminaci&oacute;n del &aacute;lbum multimedia.</small>
    </h1>
</section>
    }
}

<section class="content">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        <div class="col-xs-12">

            <div class="box box-solid box-info">
                <div class="box-header">
                    <h3 class="box-title">Detalles</h3>
                </div><!-- /.box-header -->
                <div class="box-body table-responsive">

                    <div class="widget-sec">
                        <div class="streaming-table">
                            <table class="table table-striped table-bordered">
                                <tr>
                                    <td>Id</td>
                                    <td>@Html.DisplayFor(model => model.Id)</td>
                                </tr>
                                <tr>
                                    <td>Fecha</td>
                                    <td>@Html.DisplayFor(model => model.Fecha)</td>
                                </tr>
                                <tr>
                                    <td>Título</td>
                                    <td>@Html.Raw(Model.Titulo)</td>
                                </tr>
                                <tr>
                                    <td>Autor</td>
                                    <td>@Html.Raw(Model.Autor)</td>
                                </tr>
                            </table>
                            <div class="box-footer">

                                @using (Html.BeginForm("Delete", "Album", FormMethod.Post, new { id = "frmAlbum" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.StarkInputButtion("Borrar", "submit", "btn btn-danger", "")
                                    @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-primary" })
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>



