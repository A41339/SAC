@{
    ViewBag.Title = "Albúm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content-header">
    <h1>
        <i class="fa fa-camera-retro"></i> Galer&iacute;a de Fotos
        <small>Gesti&oacute;n y administraci&oacute;n de &aacute;lbumes multimedia institucionales.</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="#">Administraci&oacute;n</a></li>
        <li class="active">Galer&iacute;a de Fotos</li>
    </ol>
</section>

<section class="content">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        <div class="col-xs-12">
            <div class="box box-solid box-info">

                <div class="box-body">
                    <!-- Split button -->
                    <div class="margin">
                        <div class="btn-group">
                            <a href="~/Album/Create" class="btn btn-dropbox">Crear un Álbum</a>
                        </div>
                    </div>
                    <!-- flat split buttons -->
                </div><!-- /.box-body -->
            </div>
            <div class="box box-solid box-info">
                <div class="box-body table-responsive">
                    <div class="margin">
                        <div class="streaming-table">
                            <span id="found" class="label label-info"></span>
                            <table id="tbAlbum" class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th>Acción</th>
                                        <th> Fecha  </th>
                                        <th> Autor  </th>
                                        <th> Titulo  </th>
                                        <th> Tipo  </th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                            <div id="summary">
                                <div>
                                </div>
                            </div>
                            <br />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script type="text/javascript">

        $(document).ready(function () {
            var oTableCompany = "";
            var ControlerNameCompany = "@Url.Content("~/Album")";
            // debugger;
            oTableCompany = $("#tbAlbum").dataTable({
            "bRetrieve": true,
            "bProcessing": true,
            "dom": 'lBfrtip',
            "sAjaxSource": "@Url.Content("~/Album/GetGrid")",
            "buttons": [
                 { extend: 'copyHtml5', exportOptions: { columns: ':visible' } }
                ,{ extend: 'excelHtml5', exportOptions: { columns: ':visible' } }
                ,{ extend: 'pdfHtml5', exportOptions: { columns: ':visible' } }
                ,{ extend: 'print', exportOptions: { columns: ':visible' } }
                ,'colvis'
            ], columnDefs: [{   visible: false }],
            "pageLength": 10,
            "lengthMenu": [[5,10, 25, 50, -1], [5,10, 25, 50, "Todos"]],
                "aoColumns": [

                {
                                 "mRender": function (oObj, type, row) {

                    var buttons = '<div class="text-center"> <div class="btn-group text-left"> <button type="button" class="btn btn-xs btn-default dropdown-toggle" data-toggle="dropdown" style="border-radius:6px; border:1px solid #cbd5e1; font-size:12px; padding:4px 10px; color:#374151;"><i class="fa fa-cog" style="margin-right:4px;"></i> Acción <span class="caret"></span></button>';
                    buttons += '<ul class="dropdown-menu pull-left" role="menu">';
                                     buttons += '<li><a href="' + ControlerNameCompany + "/Edit/" + row[0] + '"><i class="fa fa-edit"></i>Modificar</a></li>';
                                     buttons += '<li><a href="' + ControlerNameCompany + "/Details/" + row[0] + '"><i class="fa fa-edit"></i>Consultar</a></li>';
                                     buttons += '<li><a href="' + ControlerNameCompany + "/Delete/" + row[0] + '"><i class="fa fa-edit"></i>Borrar</a></li>';
                    buttons += '</ul>';
                    buttons += '</div></div>';
                    return buttons;
                }
                    }, {}, {}, {}, {}]
        });
     });
</script>
