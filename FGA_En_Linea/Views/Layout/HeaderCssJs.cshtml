
<script>
        $(document).ready(function () {
            @{
                if (TempData["success"]!=null)
                {
                     @:if (window.mostrarToastExito) { window.mostrarToastExito("@Html.Raw(HttpUtility.JavaScriptStringEncode(TempData["success"].ToString()))"); } else { $.sticky("<br/> @TempData["success"]", { stickyClass: 'success' }); }
                }
                if (TempData["error"]!=null)
                {
                     @:if (window.mostrarToastError) { window.mostrarToastError("@Html.Raw(HttpUtility.JavaScriptStringEncode(TempData["error"].ToString()))"); } else { $.sticky("<br/> @TempData["error"]", { stickyClass: 'error' }); }
                }
            }
            function StarkL() {  $("#starkloader").show(); }
        });
         jQuery.ajaxSetup({
            beforeSend: function () {
                $('#starkloader').show();
            },
            complete: function () {
                $('#starkloader').hide();
            },
            error: function () {
                $('#starkloader').hide();
            },
            success: function () { }
        });
</script>

