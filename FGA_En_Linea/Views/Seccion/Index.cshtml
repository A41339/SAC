@{
    ViewBag.Title = "Secciones del Portal";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content-header">
    <div class="sec-header-banner">
        <div>
            <h1 class="sec-header-title">
                <i class="fa fa-sitemap" style="color: #0284c7;"></i>
                Secciones del Portal
            </h1>
            <p class="sec-header-subtitle">
                Estructura, contenidos y configuraciÃ³n de las secciones pÃºblicas institucionales
            </p>
        </div>
    </div>

    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="@Url.Action("Index", "Modulo", new { id = 9200 })" class="breadcrumb-parent-pill" title="Volver a GestiÃ³n Operativa"><i class="fa fa-cogs" style="margin-right: 4px;"></i> Gesti&oacute;n Operativa</a></li>
        <li class="active">Secciones</li>
    </ol>
</section>

<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div class="modern-table-card">
                <table id="tbSeccion" class="table table-striped table-bordered modern-data-table" style="width: 100%;">
                    <thead>
                        <tr>
                            <th style="width: 110px; text-align: center;">AcciÃ³n</th>
                            <th style="width: 15%; text-align: center;">CÃ³digo</th>
                            <th>Nombre de la SecciÃ³n</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<!-- ======================================================================= -->
<!-- MODAL CONFIGURAR SECCIÃ“N                                                -->
<!-- ======================================================================= -->
<div class="modal fade modal-sec-custom" id="modalSeccion" tabindex="-1" role="dialog" aria-labelledby="lblModalSecTitulo" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="lblModalSecTitulo">
                    <i class="fa fa-pencil" style="color: #0284c7; margin-right: 8px;"></i>
                    Configurar SecciÃ³n: <span id="lblTituloSecNombre" style="color: #0284c7;"></span>
                </h4>
            </div>
            <form id="frmSeccionModal" autocomplete="off" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" id="secId" value="" />

                <div class="modal-body">
                    <div id="modalSecError" class="alert alert-danger" style="display: none; border-radius: 8px;"></div>

                    <div class="form-group form-group-custom">
                        <label for="secNombre">Nombre de la SecciÃ³n <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="secNombre" maxlength="150" required />
                    </div>

                    <div class="row" style="margin-top: 14px;">
                        <div class="col-sm-6">
                            <div class="form-group form-group-custom">
                                <label for="secDetalle1">Detalle / Campo 1</label>
                                <textarea class="form-control" id="secDetalle1" rows="3"></textarea>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group form-group-custom">
                                <label for="secDetalle2">Detalle / Campo 2</label>
                                <textarea class="form-control" id="secDetalle2" rows="3"></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="row" style="margin-top: 14px;">
                        <div class="col-sm-6">
                            <div class="form-group form-group-custom">
                                <label for="secDetalle3">Detalle / Campo 3</label>
                                <textarea class="form-control" id="secDetalle3" rows="3"></textarea>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group form-group-custom">
                                <label for="secDetalle4">Detalle / Campo 4</label>
                                <textarea class="form-control" id="secDetalle4" rows="3"></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="form-group form-group-custom" style="margin-top: 16px;">
                        <label for="secFile">Actualizar Imagen de la SecciÃ³n</label>
                        <input type="file" class="form-control" id="secFile" accept="image/jpeg,image/png" />
                        <small class="text-muted">Formatos admitidos: JPG, PNG. La imagen reemplazarÃ¡ la versiÃ³n activa en el portal.</small>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal" style="border-radius: 8px; padding: 8px 18px;">
                        Cancelar
                    </button>
                    <button type="submit" id="btnGuardarSeccion" class="btn btn-primary" style="background: #0284c7; border-color: #0284c7; border-radius: 8px; padding: 8px 22px; font-weight: 600;">
                        <i class="fa fa-check" style="margin-right: 4px;"></i> Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ======================================================================= -->
<!-- MODAL CONSULTAR DETALLE SECCIÃ“N                                         -->
<!-- ======================================================================= -->
<div class="modal fade modal-sec-custom" id="modalDetalleSeccion" tabindex="-1" role="dialog" aria-labelledby="lblModalDetalleTitulo">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="lblModalDetalleTitulo">
                    <i class="fa fa-info-circle" style="color: #0284c7; margin-right: 8px;"></i>
                    Detalle de la SecciÃ³n
                </h4>
            </div>
            <div class="modal-body">
                <table class="table table-bordered table-striped" style="margin-bottom: 0;">
                    <tbody>
                        <tr>
                            <th style="width: 25%; color: #475569;">ID</th>
                            <td><span id="detSecId" class="code-badge"></span></td>
                        </tr>
                        <tr>
                            <th style="color: #475569;">Nombre</th>
                            <td id="detSecNombre" style="font-weight: 600;"></td>
                        </tr>
                        <tr>
                            <th style="color: #475569;">Campo 1</th>
                            <td id="detSecDetalle1" style="white-space: pre-wrap; font-size: 13px;"></td>
                        </tr>
                        <tr>
                            <th style="color: #475569;">Campo 2</th>
                            <td id="detSecDetalle2" style="white-space: pre-wrap; font-size: 13px;"></td>
                        </tr>
                        <tr>
                            <th style="color: #475569;">Campo 3</th>
                            <td id="detSecDetalle3" style="white-space: pre-wrap; font-size: 13px;"></td>
                        </tr>
                        <tr>
                            <th style="color: #475569;">Campo 4</th>
                            <td id="detSecDetalle4" style="white-space: pre-wrap; font-size: 13px;"></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal" style="border-radius: 8px; padding: 8px 20px;">
                    Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        // ---------------------------------------------------------------------
        // INICIALIZAR DATATABLE
        // ---------------------------------------------------------------------
        var oTableSeccion = $("#tbSeccion").DataTable({
            "bRetrieve": true,
            "bProcessing": true,
            "dom": 'lBfrtip',
            "sAjaxSource": "@Url.Content("~/Seccion/GetGrid")",
            "buttons": [
                { extend: 'copyHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'excelHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'pdfHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'print', exportOptions: { columns: ':visible' } },
                'colvis'
            ],
            "pageLength": 25,
            "lengthMenu": [[5, 10, 25, 50, -1], [5, 10, 25, 50, "Todos"]],
            "order": [[1, "asc"]],
            "aoColumns": [
                {
                    "sClass": "text-center",
                    "bSortable": false,
                    "mRender": function (data, type, row) {
                        var id = row[0];
                        var buttons = '<div class="text-center"><div class="btn-group text-left">' +
                            '<button type="button" class="btn btn-xs btn-default dropdown-toggle" data-toggle="dropdown" ' +
                            'style="border-radius:6px; border:1px solid #cbd5e1; font-size:12px; padding:4px 10px; color:#374151;">' +
                            '<i class="fa fa-cog" style="margin-right:4px;"></i> AcciÃ³n <span class="caret"></span></button>' +
                            '<ul class="dropdown-menu pull-left" role="menu">' +
                            '<li><a href="javascript:void(0)" class="btn-edit-sec" data-id="' + id + '"><i class="fa fa-pencil text-primary"></i> Modificar</a></li>' +
                            '<li><a href="javascript:void(0)" class="btn-detail-sec" data-id="' + id + '"><i class="fa fa-info-circle text-info"></i> Consultar</a></li>' +
                            '</ul>' +
                            '</div></div>';
                        return buttons;
                    }
                },
                {
                    "sClass": "text-center",
                    "mRender": function (data) {
                        return '<span class="code-badge">' + (data || '') + '</span>';
                    }
                },
                {
                    "mRender": function (data) {
                        return '<strong style="color: #0f172a; font-size: 13.5px;"><i class="fa fa-cube text-primary" style="margin-right: 6px;"></i>' + (data || '') + '</strong>';
                    }
                }
            ],
            "language": {
                "sProcessing": "Procesando...",
                "sLengthMenu": "Mostrar _MENU_ registros",
                "sZeroRecords": "No se encontraron resultados",
                "sEmptyTable": "NingÃºn dato disponible en esta tabla",
                "sInfo": "Mostrando registros del _START_ al _END_ de un total de _TOTAL_ registros",
                "sInfoEmpty": "Mostrando registros del 0 al 0 de un total de 0 registros",
                "sInfoFiltered": "(filtrado de un total de _MAX_ registros)",
                "sSearch": "Buscar:",
                "oPaginate": {
                    "sFirst": "Primero",
                    "sLast": "Ãšltimo",
                    "sNext": "Siguiente",
                    "sPrevious": "Anterior"
                }
            }
        });

        // ---------------------------------------------------------------------
        // ABRIR MODAL EDITAR SECCIÃ“N
        // ---------------------------------------------------------------------
        $(document).on('click', '.btn-edit-sec', function () {
            var secId = $(this).data('id');
            $('#secId').val(secId);
            $('#secFile').val('');
            $('#modalSecError').hide();

            $.ajax({
                url: '@Url.Action("GetSeccion", "Seccion")',
                type: 'GET',
                data: { id: secId },
                success: function (res) {
                    if (res.success) {
                        var d = res.data;
                        $('#lblTituloSecNombre').text(d.Nombre);
                        $('#secNombre').val(d.Nombre);
                        $('#secDetalle1').val(d.Detalle1);
                        $('#secDetalle2').val(d.Detalle2);
                        $('#secDetalle3').val(d.Detalle3);
                        $('#secDetalle4').val(d.Detalle4);

                        $('#modalSeccion').modal('show');
                        setTimeout(function () { $('#secNombre').focus(); }, 400);
                    } else {
                        window.mostrarToastError(res.message);
                    }
                },
                error: function () {
                    window.mostrarToastError('Error de comunicaciÃ³n al consultar la secciÃ³n.');
                }
            });
        });

        // ---------------------------------------------------------------------
        // ABRIR MODAL CONSULTAR DETALLE
        // ---------------------------------------------------------------------
        $(document).on('click', '.btn-detail-sec', function () {
            var secId = $(this).data('id');
            $.ajax({
                url: '@Url.Action("GetDetalleSeccion", "Seccion")',
                type: 'GET',
                data: { id: secId },
                success: function (res) {
                    if (res.success) {
                        var d = res.data;
                        $('#detSecId').text(d.Id);
                        $('#detSecNombre').text(d.Nombre);
                        $('#detSecDetalle1').text(d.Detalle1);
                        $('#detSecDetalle2').text(d.Detalle2);
                        $('#detSecDetalle3').text(d.Detalle3);
                        $('#detSecDetalle4').text(d.Detalle4);

                        $('#modalDetalleSeccion').modal('show');
                    } else {
                        window.mostrarToastError(res.message);
                    }
                },
                error: function () {
                    window.mostrarToastError('Error de comunicaciÃ³n al consultar el detalle.');
                }
            });
        });

        // ---------------------------------------------------------------------
        // GUARDAR SECCIÃ“N (MULTIPART FORMDATA)
        // ---------------------------------------------------------------------
        $('#frmSeccionModal').on('submit', function (e) {
            e.preventDefault();
            var $btn = $('#btnGuardarSeccion');
            $btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Guardando...');
            $('#modalSecError').hide();

            var formData = new FormData();
            var token = $('input[name="__RequestVerificationToken"]', '#frmSeccionModal').val();
            formData.append('__RequestVerificationToken', token);
            formData.append('id', $('#secId').val());
            formData.append('nombre', $('#secNombre').val());
            formData.append('detalle1', $('#secDetalle1').val());
            formData.append('detalle2', $('#secDetalle2').val());
            formData.append('detalle3', $('#secDetalle3').val());
            formData.append('detalle4', $('#secDetalle4').val());

            var fileInput = document.getElementById('secFile');
            if (fileInput.files.length > 0) {
                formData.append('file', fileInput.files[0]);
            }

            $.ajax({
                url: '@Url.Action("GuardarSeccion", "Seccion")',
                type: 'POST',
                data: formData,
                contentType: false,
                processData: false,
                success: function (res) {
                    $btn.prop('disabled', false).html('<i class="fa fa-check" style="margin-right: 4px;"></i> Guardar');
                    if (res.success) {
                        $('#modalSeccion').modal('hide');
                        oTableSeccion.ajax.reload(null, false);
                        window.mostrarToastExito(res.message);
                    } else {
                        $('#modalSecError').text(res.message).fadeIn();
                    }
                },
                error: function () {
                    $btn.prop('disabled', false).html('<i class="fa fa-check" style="margin-right: 4px;"></i> Guardar');
                    $('#modalSecError').text('Error interno de comunicaciÃ³n al procesar la solicitud.').fadeIn();
                }
            });
        });
    });

    // -------------------------------------------------------------------------
    // SISTEMA DE NOTIFICACIONES TOAST (SI NO EXISTE YA GLOBALMENTE)
    // -------------------------------------------------------------------------
    if (!window.mostrarToastExito) {
        window.mostrarToastExito = function (mensaje) {
            if (typeof toastr !== 'undefined') {
                toastr.success(mensaje, 'Ã‰xito');
            } else if ($.notify) {
                $.notify({ message: mensaje }, { type: 'success', delay: 3500 });
            } else {
                alert(mensaje);
            }
        };
    }

    if (!window.mostrarToastError) {
        window.mostrarToastError = function (mensaje) {
            if (typeof toastr !== 'undefined') {
                toastr.error(mensaje, 'Error');
            } else if ($.notify) {
                $.notify({ message: mensaje }, { type: 'danger', delay: 4500 });
            } else {
                alert(mensaje);
            }
        };
    }
</script>
