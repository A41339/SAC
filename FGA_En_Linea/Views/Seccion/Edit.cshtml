@model FGA.Models.Seccion

@{
    ViewBag.Title = "Editar una secci&oacute;n";
    if (Ajax.IsThisAjaxRequest())
    {
        Layout = null;
    }
}

@Html.StarkAjaxFormSubmiter("frmSeccion", "tbSeccion", true, "Acci&oacute;n ejecutada con &eacute;xito")

@{
    if (!Ajax.IsThisAjaxRequest())
    {
                <section class="content-header">
            <h1>
                <i class="fa fa-th-list"></i> Secci&oacute;n: @Model.Nombre
                <small>Edici&oacute;n y configuraci&oacute;n de atributos y estructura de la secci&oacute;n.</small>
            </h1>
            <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="@Url.Action("Index", "Modulo", new { modulo = "Seccion/Edit" })" class="breadcrumb-parent-pill"><i class="fa fa-wrench" style="margin-right: 4px;"></i> Mantenimientos</a></li>
        <li class="active">Editar Secci&oacute;n</li>
    </ol>
</section>
    }
}

@using (Html.BeginForm("Edit", "Seccion", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmSeccion" }))
{
    @Html.AntiForgeryToken()

