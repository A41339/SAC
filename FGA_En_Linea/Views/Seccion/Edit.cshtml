                                else if (Model.Id == (int)FGA.Utility.Utilitarios.enum_secciones.afiliados)
                                {
                                    <img width="300" height="250" src="https://www.ffc.co.cr/img/secciones/afiliados/img.jpg" alt="" />
                                }
                                else if (Model.Id == (int)FGA.Utility.Utilitarios.enum_secciones.parametros)
                                {
                                    <img width="120" height="80" src="https://www.ffc.co.cr/img/secciones/Logo/Logo.jpg" alt="" />
                                }
                                else if (Model.Id == (int)FGA.Utility.Utilitarios.enum_secciones.unase)
                                {
                                    <img width="120" height="80" src="https://www.ffc.co.cr/img/secciones/Unase/img.jpg" alt="" />
                                }
                                else if (Model.Id == (int)FGA.Utility.Utilitarios.enum_secciones.popUp)
                                {
                                    <img width="120" height="80" src="https://www.ffc.co.cr/img/secciones/popUp/img.jpg" alt="" />
                                }*@
