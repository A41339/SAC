@if (!Ajax.IsThisAjaxRequest())
{
    <section class="content-header">
        <h1>
            <i class="fa fa-info-circle"></i> Detalle de Solicitud de Cambio #@Model.solicitud.Id
            <small>Consulta y revisi&oacute;n del flujo de aprobaci&oacute;n y par&aacute;metros del cambio solicitado.</small>
        </h1>
    </section>
}
@model FGA.Models.SolicitudView

@{
    ViewBag.Title = "Editar";
    if (Ajax.IsThisAjaxRequest())
    {
        Layout = null;
    }
}

@Html.StarkAjaxFormSubmiter("frmSolicitud", "tbSolicitud", true, "Acci&oacute;n ejecutada con &eacute;xito")
@using (Html.BeginForm("Edit", "SolicitudCambio", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmSolicitud" }))
{
    @Html.Partial("_VerDetalle", Model)
}

<script>

    function download() {
        var path = "/SolicitudCambio/Download/?id=" + @Model.solicitud.Id;
        window.location.href = path;
        }

        $(function ()
        {
            $("#wizard").steps({
                headerTag: "h2",
                bodyTag: "section",
                transitionEffect: "slideLeft",
                enableAllSteps: true
            });
        });

</script>
