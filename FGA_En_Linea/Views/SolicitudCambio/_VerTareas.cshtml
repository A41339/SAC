@model IEnumerable<FGA.Models.Tarea>


<div class="form-group" style="padding-top: 10px !important;">
    <div class="col-lg-1 col-md-1 col-sm-1 col-xs-12 form-validate">
        <p><label class="control-label">Inicio</label></p>
    </div>
    <div class="col-lg-5 col-md-6 col-sm-6 col-xs-12 form-validate">
        <input name="Periodo1" class="date" id="Periodo1" style="margin-right: 5px; width: calc(100% - 50px);" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo1"].ToString()).ToShortDateString()" />
    </div>
    <div class="col-lg-1 col-md-1 col-sm-1 col-xs-12 form-validate">
        <p><label class="control-label">Fin</label></p>
    </div>
    <div class="col-lg-5 col-md-5 col-sm-5 col-xs-12 form-validate">
        <input name="Periodo2" class="date" id="Periodo2" style="margin-right: 5px; width: calc(100% - 50px);" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo2"].ToString()).ToShortDateString()" />
    </div>
</div>
<br /> <br />
<div class="form-group">
    <div class="col-lg-12  col-xs-12 form-validate">
        <input type="text" id="task_detail" class="form-control add_task_todo" placeholder="Cree una tarea nueva" name="task-insert">
    </div>
</div>
<br /> <br />
<div class="form-group">
    <div class="col-lg-12  col-xs-12 form-validate">
        <div class="streaming-table">
            <table class="table table-condensed table-striped table-bordered">
                @if (Model != null)
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <span class="task-title-sp">@item.Detalle</span>
                            </td>
                            <td>
                                <button class="btn btn-danger btn-xs" onclick="javascript:deleteTask(@item.Id)"><i class="fa fa-trash"></i></button>
                            </td>
                        </tr>

                    }
                }
            </table>
        </div>
    </div>
</div>


