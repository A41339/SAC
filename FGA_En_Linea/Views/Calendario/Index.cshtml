@{
    ViewBag.Title = "Calendario de Cargas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content-header">
    <div class="cal-header-banner">
        <div>
            <h1 class="cal-header-title">
                <i class="fa fa-calendar" style="color: #0284c7;"></i>
                Mantenimiento de Calendario
            </h1>
            <p class="cal-header-subtitle">
                GestiÃ³n de fechas lÃ­mite y cronogramas de entrega y carga periÃ³dica de archivos
            </p>
        </div>
        <div>
            <button type="button" id="btnNuevoCalendario" class="btn-create-cal">
                <i class="fa fa-plus-circle"></i> Crear Calendario
            </button>
        </div>
    </div>

    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="@Url.Action("Index", "Modulo", new { id = 9200 })" class="breadcrumb-parent-pill" title="Volver a GestiÃ³n Operativa"><i class="fa fa-cogs" style="margin-right: 4px;"></i> Gesti&oacute;n Operativa</a></li>
        <li class="active">Calendario</li>
    </ol>
</section>

<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div class="modern-table-card">
                <table id="tbCalendar" class="table table-striped table-bordered modern-data-table" style="width: 100%;">
                    <thead>
                        <tr>
                            <th style="width: 110px; text-align: center;">AcciÃ³n</th>
                            <th style="width: 25%;">PerÃ­odo</th>
                            <th style="width: 25%; text-align: center;">DÃ­a NotificaciÃ³n</th>
                            <th style="width: 25%; text-align: center;">DÃ­a LÃ­mite Carga</th>
                            <th style="width: 14%; text-align: center;">Enviado</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<!-- ======================================================================= -->
<!-- MODAL CREAR / EDITAR CALENDARIO                                         -->
<!-- ======================================================================= -->
<div class="modal fade modal-cal-custom" id="modalCalendario" tabindex="-1" role="dialog" aria-labelledby="lblModalCalTitulo" data-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="lblModalCalTitulo">
                    <i class="fa fa-plus-circle" style="color: #0284c7; margin-right: 8px;"></i>
                    <span id="lblTituloCalTexto">Nuevo Registro de Calendario</span>
                </h4>
            </div>
            <form id="frmCalendarioModal" autocomplete="off">
                @Html.AntiForgeryToken()
                <input type="hidden" id="calEsNuevo" value="true" />
                <input type="hidden" id="calId" value="" />

                <div class="modal-body">
                    <div id="modalCalError" class="alert alert-danger" style="display: none; border-radius: 8px;"></div>

                    <div class="form-group form-group-custom">
                        <label for="calPeriodo">Fecha de PerÃ­odo <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" id="calPeriodo" required />
                        <small class="text-muted">Fecha del mes correspondiente a la informaciÃ³n a recolectar.</small>
                    </div>

                    <div class="row" style="margin-top: 14px;">
                        <div class="col-sm-6">
                            <div class="form-group form-group-custom">
                                <label for="calDiaNotificacion">DÃ­a de NotificaciÃ³n <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="calDiaNotificacion" min="1" max="31" placeholder="Ej: 5" required />
                                <small class="text-muted">DÃ­a del mes para emitir el aviso.</small>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group form-group-custom">
                                <label for="calDiaLimite">DÃ­a LÃ­mite de Carga <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="calDiaLimite" min="1" max="31" placeholder="Ej: 10" required />
                                <small class="text-muted">Ãšltimo dÃ­a hÃ¡bil para la entrega.</small>
                            </div>
                        </div>
                    </div>

                    <div class="form-group form-group-custom" style="margin-top: 16px;">
                        <label class="custom-switch-label">
                            <input type="checkbox" id="calEnviado" />
                            <span>NotificaciÃ³n Enviada &mdash; <small class="text-muted">Indica si ya se notificÃ³ a las entidades</small></span>
                        </label>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal" style="border-radius: 8px; padding: 8px 18px;">
                        Cancelar
                    </button>
                    <button type="submit" id="btnGuardarCal" class="btn btn-primary" style="background: #0284c7; border-color: #0284c7; border-radius: 8px; padding: 8px 22px; font-weight: 600;">
                        <i class="fa fa-check" style="margin-right: 4px;"></i> Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ======================================================================= -->
<!-- MODAL CONSULTAR DETALLE CALENDARIO                                      -->
<!-- ======================================================================= -->
<div class="modal fade modal-cal-custom" id="modalDetalleCalendario" tabindex="-1" role="dialog" aria-labelledby="lblModalDetalleTitulo">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="lblModalDetalleTitulo">
                    <i class="fa fa-info-circle" style="color: #0284c7; margin-right: 8px;"></i>
                    Detalle del Calendario
                </h4>
            </div>
            <div class="modal-body">
                <table class="table table-bordered table-striped" style="margin-bottom: 0;">
                    <tbody>
                        <tr>
                            <th style="width: 40%; color: #475569;">ID</th>
                            <td id="detCalId" style="font-family: monospace; font-weight: 700; color: #0284c7;"></td>
                        </tr>
                        <tr>
                            <th style="color: #475569;">PerÃ­odo</th>
                            <td id="detCalPeriodo" style="font-weight: 600;"></td>
                        </tr>
                        <tr>
                            <th style="color: #475569;">DÃ­a de NotificaciÃ³n</th>
                            <td id="detCalDiaNotificacion"></td>
                        </tr>
                        <tr>
                            <th style="color: #475569;">DÃ­a LÃ­mite para Carga</th>
                            <td id="detCalDiaLimite"></td>
                        </tr>
                        <tr>
                            <th style="color: #475569;">NotificaciÃ³n Enviada</th>
                            <td id="detCalEnviado"></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal" style="border-radius: 8px; padding: 8px 20px;">
                    Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ======================================================================= -->
<!-- MODAL CONFIRMAR ELIMINACIÃ“N                                             -->
<!-- ======================================================================= -->
<div class="modal fade modal-cal-custom" id="modalDeleteCalendario" tabindex="-1" role="dialog" aria-labelledby="lblModalDeleteTitulo">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header" style="background: #fef2f2; border-bottom: 1px solid #fee2e2;">
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="lblModalDeleteTitulo" style="color: #991b1b;">
                    <i class="fa fa-exclamation-triangle" style="margin-right: 8px;"></i>
                    Eliminar Calendario
                </h4>
            </div>
            <div class="modal-body" style="padding: 20px;">
                <input type="hidden" id="deleteCalId" value="" />
                <p style="margin: 0; font-size: 14px; color: #334155;">
                    Â¿EstÃ¡ seguro de que desea eliminar el registro de calendario del perÃ­odo <strong id="deleteCalPeriodo" style="color: #0f172a;"></strong>?
                </p>
                <p style="margin: 8px 0 0 0; font-size: 12.5px; color: #64748b;">
                    Esta acciÃ³n no se puede deshacer.
                </p>
            </div>
            <div class="modal-footer" style="padding: 12px 20px;">
                <button type="button" class="btn btn-default" data-dismiss="modal" style="border-radius: 8px; padding: 7px 16px;">
                    Cancelar
                </button>
                <button type="button" id="btnConfirmarEliminarCal" class="btn btn-danger" style="background: #ef4444; border-color: #ef4444; border-radius: 8px; padding: 7px 18px; font-weight: 600;">
                    <i class="fa fa-trash" style="margin-right: 4px;"></i> Eliminar
                </button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        // ---------------------------------------------------------------------
        // INICIALIZAR DATATABLE
        // ---------------------------------------------------------------------
        var oTableCal = $("#tbCalendar").DataTable({
            "bRetrieve": true,
            "bProcessing": true,
            "dom": 'lBfrtip',
            "sAjaxSource": "@Url.Content("~/Calendario/GetGrid")",
            "buttons": [
                { extend: 'copyHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'excelHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'pdfHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'print', exportOptions: { columns: ':visible' } },
                'colvis'
            ],
            "pageLength": 10,
            "lengthMenu": [[5, 10, 25, 50, -1], [5, 10, 25, 50, "Todos"]],
            "order": [[1, "desc"]],
            "aoColumns": [
                {
                    "sClass": "text-center",
                    "bSortable": false,
                    "mRender": function (data, type, row) {
                        var id = row[0];
                        var periodo = (row[1] || '').replace(/"/g, '&quot;');
                        var buttons = '<div class="text-center"><div class="btn-group text-left">' +
                            '<button type="button" class="btn btn-xs btn-default dropdown-toggle" data-toggle="dropdown" ' +
                            'style="border-radius:6px; border:1px solid #cbd5e1; font-size:12px; padding:4px 10px; color:#374151;">' +
                            '<i class="fa fa-cog" style="margin-right:4px;"></i> AcciÃ³n <span class="caret"></span></button>' +
                            '<ul class="dropdown-menu pull-left" role="menu">' +
                            '<li><a href="javascript:void(0)" class="btn-edit-cal" data-id="' + id + '"><i class="fa fa-pencil text-primary"></i> Modificar</a></li>' +
                            '<li><a href="javascript:void(0)" class="btn-detail-cal" data-id="' + id + '"><i class="fa fa-info-circle text-info"></i> Consultar</a></li>' +
                            '<li class="divider"></li>' +
                            '<li><a href="javascript:void(0)" class="btn-delete-cal" data-id="' + id + '" data-periodo="' + periodo + '"><i class="fa fa-trash text-danger"></i> Eliminar</a></li>' +
                            '</ul>' +
                            '</div></div>';
                        return buttons;
                    }
                },
                {
                    "mRender": function (data) {
                        return '<strong style="color: #0f172a; font-size: 13.5px;"><i class="fa fa-calendar-check-o text-info" style="margin-right: 6px;"></i>' + (data || '') + '</strong>';
                    }
                },
                {
                    "sClass": "text-center",
                    "mRender": function (data) {
                        return '<span class="day-badge">' + (data || '0') + ' de cada mes</span>';
                    }
                },
                {
                    "sClass": "text-center",
                    "mRender": function (data) {
                        return '<span class="day-badge" style="color: #b45309; background: #fef3c7; border-color: #fde68a;">' + (data || '0') + ' de cada mes</span>';
                    }
                },
                {
                    "sClass": "text-center",
                    "mRender": function (data) {
                        var isYes = ('' + data).toLowerCase().indexOf('s') !== -1;
                        return '<span class="badge-pill-tag ' + (isYes ? 'yes' : 'no') + '">' +
                            '<i class="fa ' + (isYes ? 'fa-check' : 'fa-times') + '"></i> ' + (isYes ? 'SÃ­' : 'No') + '</span>';
                    }
                }
            ],
            "language": {
                "sProcessing": "Procesando...",
                "sLengthMenu": "Mostrar _MENU_ registros",
                "sZeroRecords": "No se encontraron resultados",
                "sEmptyTable": "NingÃºn dato disponible en esta tabla",
                "sInfo": "Mostrando registros del _START_ al _END_ de un total de _TOTAL_ registros",
                "sInfoEmpty": "Mostrando registros del 0 al 0 de un total de 0 registros",
                "sInfoFiltered": "(filtrado de un total de _MAX_ registros)",
                "sSearch": "Buscar:",
                "oPaginate": {
                    "sFirst": "Primero",
                    "sLast": "Ãšltimo",
                    "sNext": "Siguiente",
                    "sPrevious": "Anterior"
                }
            }
        });

        // ---------------------------------------------------------------------
        // ABRIR MODAL CREAR
        // ---------------------------------------------------------------------
        $('#btnNuevoCalendario').on('click', function () {
            $('#lblTituloCalTexto').text('Nuevo Registro de Calendario');
            $('#lblModalCalTitulo i').attr('class', 'fa fa-plus-circle');
            $('#calEsNuevo').val('true');
            $('#calId').val('');
            $('#calPeriodo').val('');
            $('#calDiaNotificacion').val('5');
            $('#calDiaLimite').val('10');
            $('#calEnviado').prop('checked', false);
            $('#modalCalError').hide();
            $('#modalCalendario').modal('show');
            setTimeout(function () { $('#calPeriodo').focus(); }, 400);
        });

        // ---------------------------------------------------------------------
        // ABRIR MODAL EDITAR
        // ---------------------------------------------------------------------
        $(document).on('click', '.btn-edit-cal', function () {
            var calId = $(this).data('id');
            $('#lblTituloCalTexto').text('Modificar Calendario');
            $('#lblModalCalTitulo i').attr('class', 'fa fa-pencil');
            $('#calEsNuevo').val('false');
            $('#calId').val(calId);
            $('#modalCalError').hide();

            $.ajax({
                url: '@Url.Action("GetCalendario", "Calendario")',
                type: 'GET',
                data: { id: calId },
                success: function (res) {
                    if (res.success) {
                        var d = res.data;
                        $('#calPeriodo').val(d.Periodo);
                        $('#calDiaNotificacion').val(d.DiaNotificacion);
                        $('#calDiaLimite').val(d.DiaLimite);
                        $('#calEnviado').prop('checked', d.Enviado);
                        $('#modalCalendario').modal('show');
                    } else {
                        window.mostrarToastError(res.message);
                    }
                },
                error: function () {
                    window.mostrarToastError('Error de comunicaciÃ³n al consultar el calendario.');
                }
            });
        });

        // ---------------------------------------------------------------------
        // ABRIR MODAL CONSULTAR DETALLE
        // ---------------------------------------------------------------------
        $(document).on('click', '.btn-detail-cal', function () {
            var calId = $(this).data('id');
            $.ajax({
                url: '@Url.Action("GetDetalleCalendario", "Calendario")',
                type: 'GET',
                data: { id: calId },
                success: function (res) {
                    if (res.success) {
                        var d = res.data;
                        $('#detCalId').text(d.Id);
                        $('#detCalPeriodo').text(d.Periodo);
                        $('#detCalDiaNotificacion').text(d.DiaNotificacion + ' de cada mes');
                        $('#detCalDiaLimite').text(d.DiaLimite + ' de cada mes');
                        var isYes = d.Enviado === 'SÃ­';
                        $('#detCalEnviado').html(
                            '<span class="badge-pill-tag ' + (isYes ? 'yes' : 'no') + '">' +
                            '<i class="fa ' + (isYes ? 'fa-check' : 'fa-times') + '"></i> ' + d.Enviado + '</span>'
                        );
                        $('#modalDetalleCalendario').modal('show');
                    } else {
                        window.mostrarToastError(res.message);
                    }
                },
                error: function () {
                    window.mostrarToastError('Error de comunicaciÃ³n al consultar el detalle.');
                }
            });
        });

        // ---------------------------------------------------------------------
        // GUARDAR CALENDARIO (CREAR O EDITAR)
        // ---------------------------------------------------------------------
        $('#frmCalendarioModal').on('submit', function (e) {
            e.preventDefault();
            var $btn = $('#btnGuardarCal');
            $btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Guardando...');
            $('#modalCalError').hide();

            var token = $('input[name="__RequestVerificationToken"]', '#frmCalendarioModal').val();
            var data = {
                __RequestVerificationToken: token,
                esNuevo: $('#calEsNuevo').val(),
                id: $('#calId').val(),
                periodo: $('#calPeriodo').val(),
                diaNotificacion: $('#calDiaNotificacion').val(),
                diaLimite: $('#calDiaLimite').val(),
                enviado: $('#calEnviado').is(':checked')
            };

            $.ajax({
                url: '@Url.Action("GuardarCalendario", "Calendario")',
                type: 'POST',
                data: data,
                success: function (res) {
                    $btn.prop('disabled', false).html('<i class="fa fa-check" style="margin-right: 4px;"></i> Guardar');
                    if (res.success) {
                        $('#modalCalendario').modal('hide');
                        oTableCal.ajax.reload(null, false);
                        window.mostrarToastExito(res.message);
                    } else {
                        $('#modalCalError').text(res.message).fadeIn();
                    }
                },
                error: function () {
                    $btn.prop('disabled', false).html('<i class="fa fa-check" style="margin-right: 4px;"></i> Guardar');
                    $('#modalCalError').text('Error interno de comunicaciÃ³n al procesar la solicitud.').fadeIn();
                }
            });
        });

        // ---------------------------------------------------------------------
        // ABRIR MODAL ELIMINAR
        // ---------------------------------------------------------------------
        $(document).on('click', '.btn-delete-cal', function () {
            var id = $(this).data('id');
            var periodo = $(this).data('periodo');
            $('#deleteCalId').val(id);
            $('#deleteCalPeriodo').text(periodo);
            $('#modalDeleteCalendario').modal('show');
        });

        // ---------------------------------------------------------------------
        // CONFIRMAR ELIMINACIÃ“N
        // ---------------------------------------------------------------------
        $('#btnConfirmarEliminarCal').on('click', function () {
            var id = $('#deleteCalId').val();
            var $btn = $(this);
            $btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Eliminando...');

            var token = $('input[name="__RequestVerificationToken"]', '#frmCalendarioModal').val();

            $.ajax({
                url: '@Url.Action("EliminarCalendario", "Calendario")',
                type: 'POST',
                data: {
                    __RequestVerificationToken: token,
                    id: id
                },
                success: function (res) {
                    $btn.prop('disabled', false).html('<i class="fa fa-trash" style="margin-right: 4px;"></i> Eliminar');
                    $('#modalDeleteCalendario').modal('hide');
                    if (res.success) {
                        oTableCal.ajax.reload(null, false);
                        window.mostrarToastExito(res.message);
                    } else {
                        window.mostrarToastError(res.message);
                    }
                },
                error: function () {
                    $btn.prop('disabled', false).html('<i class="fa fa-trash" style="margin-right: 4px;"></i> Eliminar');
                    $('#modalDeleteCalendario').modal('hide');
                    window.mostrarToastError('Error de comunicaciÃ³n al eliminar el calendario.');
                }
            });
        });
    });

    // -------------------------------------------------------------------------
    // SISTEMA DE NOTIFICACIONES TOAST (SI NO EXISTE YA GLOBALMENTE)
    // -------------------------------------------------------------------------
    if (!window.mostrarToastExito) {
        window.mostrarToastExito = function (mensaje) {
            if (typeof toastr !== 'undefined') {
                toastr.success(mensaje, 'Ã‰xito');
            } else if ($.notify) {
                $.notify({ message: mensaje }, { type: 'success', delay: 3500 });
            } else {
                alert(mensaje);
            }
        };
    }

    if (!window.mostrarToastError) {
        window.mostrarToastError = function (mensaje) {
            if (typeof toastr !== 'undefined') {
                toastr.error(mensaje, 'Error');
            } else if ($.notify) {
                $.notify({ message: mensaje }, { type: 'danger', delay: 4500 });
            } else {
                alert(mensaje);
            }
        };
    }
</script>
