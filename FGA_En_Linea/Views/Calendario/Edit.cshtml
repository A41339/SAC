@model FGA.Models.Calendario

@{
    ViewBag.Title = "Editar Calendario";
    if (Ajax.IsThisAjaxRequest())
    {
        Layout = null;
    }
}

@Html.StarkAjaxFormSubmiter("frmCalendar", "tbCalendar", true, "AcciÃ³n ejecutada con Ã©xito")
 
@{
    if (!Ajax.IsThisAjaxRequest())
    {
        <section class="content-header">
    <h1>
        <i class="fa fa-edit"></i> Editar Calendario
        <small>Modificaci&oacute;n de fechas y descripci&oacute;n del registro de calendario.</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="@Url.Action("Index", "Modulo", new { modulo = "Calendario/Edit" })" class="breadcrumb-parent-pill"><i class="fa fa-wrench" style="margin-right: 4px;"></i> Mantenimientos</a></li>
        <li class="active">Editar Calendario</li>
    </ol>
</section>
    }
}

@using (Html.BeginForm("Edit", "Calendario", FormMethod.Post, new { enctype = "multipart/form-data",id = "frmCalendar"  }))
{
    @Html.AntiForgeryToken()

<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div class="box box-solid box-info">
                <div role="form">
                    <div class="box-body">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Periodo, new { @class = "" })
                            <input name="Periodo" id="Periodo" style="width: 100px" class="datecontrol" value="@Model.Periodo.ToShortDateString()" />
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.DiaNotificacion)
                            @Html.EditorFor(model => model.DiaNotificacion, new { @class = "form-control" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.DiaLimite)
                            @Html.EditorFor(model => model.DiaLimite, new { @class = "form-control" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.Enviado, new { @class = "checkbox" })
                            @Html.EditorFor(model => model.Enviado, new { htmlAttributes = new { @class = "js-switch" } })
                        </div>
                    </div>
                    </div>
                    <div class="box-footer">
                        @Html.StarkInputButtion("Guardar", "submit", "btn btn-primary", "")
                        @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-primary" })
                    </div>
                </div>
            </div>
        </div>
</section>

}