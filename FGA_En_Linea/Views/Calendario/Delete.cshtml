@model FGA.Models.Calendario

@{
    ViewBag.Title = "Está seguro de eliminar el calendario?";
    if (Ajax.IsThisAjaxRequest())
    {
        Layout = null;
    }
}

@Html.StarkAjaxFormSubmiter("frmCalendar", "tbCalendar", true, "Acción ejecutada con éxito")

@{
    if (!Ajax.IsThisAjaxRequest())
    {
        <section class="content-header">
    <h1>
        <i class="fa fa-trash"></i> Eliminar Calendario
        <small>Confirmaci&oacute;n de remoci&oacute;n de fecha del calendario institucional.</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="#">Administraci&oacute;n</a></li>
        <li class="active">Eliminar Calendario</li>
    </ol>
</section>
    }
}

<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div class="box box-solid box-info">
                <div class="box-header">
                    <h3 class="box-title">Detalles</h3>
                </div>
                <div class="box-body table-responsive">
                    <div class="widget-sec">
                        <div class="streaming-table">
                            <table class="table table-striped table-bordered">
                                <tr class="hidden">
                                    <td>@Html.LabelFor(model => model.Id, new { @class = "" })</td>
                                    <td>@Html.DisplayFor(model => model.Id)</td>
                                </tr>
                                <tr>
                                    <td>@Html.LabelFor(model => model.Periodo, new { @class = "" })</td>
                                    <td>@Html.DisplayFor(model => model.Periodo)</td>
                                </tr>
                                <tr>
                                    <td>@Html.LabelFor(model => model.DiaNotificacion, new { @class = "" })</td>
                                    <td>@Html.DisplayFor(model => model.DiaNotificacion)</td>
                                </tr>
                                <tr>
                                    <td>@Html.LabelFor(model => model.DiaLimite, new { @class = "" })</td>
                                    <td>@Html.DisplayFor(model => model.DiaLimite)</td>
                                </tr>
                            </table>
                            <div class="box-footer">
                                @using (Html.BeginForm("Delete", "Calendario", FormMethod.Post, new { id = "frmCalendar" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.StarkInputButtion("Borrar", "submit", "btn btn-danger", "")
                                    @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-primary" })
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>



