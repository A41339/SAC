@{
    ViewBag.Title = "Facturaci&oacute;n de Contribuciones";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content-header">
    <h1 class="modern-page-title">
        <i class="fa fa-calculator" style="color: #0284c7;"></i>
        <span id="TituloContribuciones">Facturaci&oacute;n de Contribuciones</span>
        <small id="SubtituloContribuciones">Generaci&oacute;n y consulta de reportes de facturaci&oacute;n FGD BCCR y FEE-FFC</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="@Url.Action("Index", "Modulo", new { modulo = "Facturacion/Index" })" class="breadcrumb-parent-pill"><i class="fa fa-file-text-o" style="margin-right: 4px;"></i> Facturaci&oacute;n</a></li>
        <li class="active" id="BreadcrumbContribuciones">Contribuciones</li>
    </ol>
</section>

<section class="content">
    @using (Html.BeginForm("Buscar", "Facturacion", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmInforme" }))
    {
        @Html.AntiForgeryToken()

        <div class="row">
            <div class="col-xs-12">
                <div class="modern-filter-card">
                    <div class="modern-filter-toolbar">
                        <div class="filter-item">
                            <label for="IdEntidad"><i class="fa fa-university"></i> Entidad:</label>
                            @Html.DropDownList("Entidades", null, new { @id = "IdEntidad", @class = "form-control modern-select", style = "min-width: 220px;" })
                        </div>
                        <div class="filter-item">
                            <label for="Anio"><i class="fa fa-calendar-check-o"></i> A&ntilde;o:</label>
                            @{
                                int anioActual = DateTime.Now.Year;
                                List<SelectListItem> anios = new List<SelectListItem>();

                                for (int i = anioActual - 3; i <= anioActual; i++)
                                {
                                    bool isSelected = (i == anioActual);

                                    anios.Add(new SelectListItem { Value = i.ToString(), Text = i.ToString(), Selected = isSelected });
                                }
                            }
                            @Html.DropDownList("Anio", anios, new { @id = "Anio", @class = "form-control modern-select", style = "min-width: 120px;" })
                        </div>
                        <div class="filter-item">
                            <label for="Trimestre"><i class="fa fa-clock-o"></i> Trimestre:</label>
                            @{
                                List<SelectListItem> trimestres = new List<SelectListItem> {
                                    new SelectListItem { Value = "1", Text = "I Trimestre" },
                                    new SelectListItem { Value = "2", Text = "II Trimestre" },
                                    new SelectListItem { Value = "3", Text = "III Trimestre" },
                                    new SelectListItem { Value = "4", Text = "IV Trimestre" }
                                };
                            }
                            @Html.DropDownList("Trimestre", trimestres, new { @id = "Trimestre", @class = "form-control modern-select", style = "min-width: 150px;" })
                        </div>
                        <div class="filter-item" style="margin-left: auto;">
                            <button type="submit" id="btn_buscar" class="btn-modern-filter">
                                <i class="fa fa-search"></i> Generar
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        if (Session["TipoReporte"] != null || Session["TipoReporte2"] != null)
        {
            <div class="nav-tabs-custom" style="border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03); border: 1px solid #e2e8f0; overflow: hidden; background: #ffffff; margin-top: 20px;">
                <ul class="nav nav-tabs">
                    <li class="active"><a href="#tab_1" data-toggle="tab"><i class="fa fa-shield" style="margin-right: 6px; color: #0284c7;"></i> FGD (BCCR)</a></li>
                    <li><a href="#tab_2" data-toggle="tab"><i class="fa fa-university" style="margin-right: 6px; color: #0284c7;"></i> FEE-FFC</a></li>
                </ul>
                <div class="tab-content">
                    <div class="tab-pane active" id="tab_1">
                        <div class="row">
                            <div class="col-xs-12">
                                @if (Session["TipoReporte"] != null)
                                {
                                    <div class="modern-table-card" style="padding: 16px;">
                                        <iframe src="~/Reportes/ReportView.aspx" width="100%" height="1200" style="border:none; border-radius: 8px; width: 100%;"></iframe>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane" id="tab_2">
                        <div class="row">
                            <div class="col-xs-12">
                                @if (Session["TipoReporte2"] != null)
                                {
                                    <div class="modern-table-card" style="padding: 16px;">
                                        <iframe src="~/Reportes/ReportView2.aspx" width="100%" height="1200" style="border:none; border-radius: 8px; width: 100%;"></iframe>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</section>

<script type="text/javascript">
    $(document).ready(function () {
        function actualizarEncabezado(tabId) {
            if (tabId === '#tab_2') {
                $('#TituloContribuciones').html('Facturaci&oacute;n - FEE-FFC');
                $('#SubtituloContribuciones').text('C\u00E1lculo y detalle de facturaci\u00F3n de contribuciones FEE-FFC');
                $('#BreadcrumbContribuciones').text('FEE-FFC');
            } else if (tabId === '#tab_1') {
                $('#TituloContribuciones').html('Facturaci&oacute;n - FGD BCCR');
                $('#SubtituloContribuciones').text('C\u00E1lculo y detalle de facturaci\u00F3n de contribuciones FGD BCCR');
                $('#BreadcrumbContribuciones').text('FGD BCCR');
            }
        }

        // Al hacer clic en las pestanas
        $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
            var tabId = $(e.target).attr('href');
            actualizarEncabezado(tabId);
        });

        // Asegurar que el titulo se actualice al cargar la pagina si ya hay tab activo
        var activeTab = $('.nav-tabs .active a').attr('href');
        if (activeTab) {
            actualizarEncabezado(activeTab);
        }
    });
</script>
