@{
    ViewBag.Title = "Composición de cartera";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<section class="content-header">
    <h1>
        Informaci&oacute;n de la cartera de la nueva normativa. C&aacute;lculos 14-21
    </h1>
</section>

<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div class="modern-filter-card">
                <div class="modern-filter-toolbar">
                    <div class="filter-item">
                        <label for="IdEntidad"><i class="fa fa-university"></i> Entidad:</label>
                        @Html.DropDownList("Entidades", null, new { @id = "IdEntidad", @class = "form-control modern-select", style = "min-width: 250px;" })
                    </div>
                    <div class="filter-item">
                        <label for="Grafico"><i class="fa fa-bar-chart"></i> Gr&aacute;fico:</label>
                        @Html.DropDownList("Grafico", null, new { @id = "Grafico", @class = "form-control modern-select", style = "min-width: 250px;" })
                    </div>
                    <div class="filter-item">
                        <label for="PeriodoI" id="lbl_fecInicial"><i class="fa fa-calendar"></i> Inicial:</label>
                        <div class="modern-input-wrapper" id="txt_fecInicial">
                            <input name="PeriodoI" id="PeriodoI" class="datecontrol form-control modern-date-input" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo1"].ToString()).ToString("MM/yyyy")" style="min-width: 130px;" />
                        </div>
                    </div>
                    <div class="filter-item">
                        <label for="PeriodoF"><i class="fa fa-calendar"></i> Final:</label>
                        <div class="modern-input-wrapper">
                            <input name="PeriodoF" id="PeriodoF" class="datecontrol form-control modern-date-input" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo2"].ToString()).ToString("MM/yyyy")" style="min-width: 130px;" />
                        </div>
                    </div>
                    <div class="filter-item" style="margin-left: auto;">
                        <button type="button" id="btn_buscar" class="btn-modern-filter">
                            <i class="fa fa-search"></i> Generar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-xs-12">
            <div id="grafica">
            </div>
        </div>
    </div>
</section>

<script type="text/javascript">

    $("#Grafico").change(function () {
        if ($("#Grafico").val() != 10) {
            $("#txt_fecInicial").removeClass("hidden");
            $("#lbl_fecInicial").removeClass("hidden");
        }       
        else {
            $("#txt_fecInicial").addClass("hidden");
            $("#lbl_fecInicial").addClass("hidden");
        }       
    });

    function refreshGraph() {
         $.ajax({
            url: '@Url.Action("GraficaDetalle", "Cartera14_21")',
            type: 'POST',
            cache: false,
            async: false,
            data: {
                 'Entidades': $('#IdEntidad').val(),
                 'Grafico': $('#Grafico').val(),
                 'PeriodoI': $('#PeriodoI').val(),
                 'PeriodoF': $('#PeriodoF').val()                
            },
             success: function (result) {
                 $('#grafica').html(result);
                 $("#entidad").text($("#Grafico :selected").text());
                 $("#pEntidad").text($("#Grafico :selected").text());
            }
         });
    }

    $(document).on('click', '#btn_buscar', function () {
        refreshGraph();
    });

    function formatMillion() {
        $("#entidad").text($("#Grafico :selected").text());
        $("#pEntidad").text($("#Grafico :selected").text());
        return this.value;
    }

    function formatPercent() {
        return this.value + " %";
    }

</script>