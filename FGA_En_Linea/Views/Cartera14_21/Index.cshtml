@{
    ViewBag.Title = "Riesgo de Crédito";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<section class="content-header" style="padding: 10px 20px 6px 20px;">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
        <div>
            <h1 class="modern-page-title" style="margin: 0; font-size: 18px; font-weight: 700; color: #143750; display: flex; align-items: center; gap: 8px;">
                <i class="fa fa-shield" style="color: #0284c7;"></i>
                Riesgo de Cr&eacute;dito
            </h1>
            <p style="margin: 2px 0 0 0; font-size: 12px; color: #64748b;">
                Composici&oacute;n de mora, morosidad agrupada y an&aacute;lisis de riesgo seg&uacute;n normativa 14-21
            </p>
        </div>
    </div>
    <ol class="breadcrumb" style="top: 8px;">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="@Url.Action("Index", "Modulo", new { modulo = "Cartera de Crédito" })" class="breadcrumb-parent-pill" title="Volver al menú de Cartera de Crédito"><i class="fa fa-pie-chart" style="margin-right: 4px;"></i> Cartera de Cr&eacute;dito</a></li>
        <li class="active">Riesgo de Cr&eacute;dito</li>
    </ol>
</section>

<section class="content" style="padding: 0 20px 14px 20px;">
    <div class="row">
        <div class="col-xs-12">
            <div class="modern-filter-card" style="margin-bottom: 12px; padding: 14px 20px;">
                <div class="modern-filter-toolbar">
                    <div class="filter-item">
                        <label for="IdEntidad"><i class="fa fa-university"></i> Entidad:</label>
                        @Html.DropDownList("Entidades", null, new { @id = "IdEntidad", @class = "form-control modern-select", style = "min-width: 250px;" })
                    </div>
                    <div class="filter-item">
                        <label for="Grafico"><i class="fa fa-bar-chart"></i> Gr&aacute;fico:</label>
                        @Html.DropDownList("Grafico", null, new { @id = "Grafico", @class = "form-control modern-select", style = "min-width: 250px;" })
                    </div>
                    <div class="filter-item" id="cont_fecInicial">
                        <label for="PeriodoI" id="lbl_fecInicial"><i class="fa fa-calendar"></i> Inicial:</label>
                        <div class="modern-input-wrapper" id="txt_fecInicial">
                            <input name="PeriodoI" id="PeriodoI" class="datecontrol form-control modern-date-input" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo1"].ToString()).ToString("MM/yyyy")" style="min-width: 130px;" />
                        </div>
                    </div>
                    <div class="filter-item">
                        <label for="PeriodoF"><i class="fa fa-calendar"></i> Final:</label>
                        <div class="modern-input-wrapper">
                            <input name="PeriodoF" id="PeriodoF" class="datecontrol form-control modern-date-input" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo2"].ToString()).ToString("MM/yyyy")" style="min-width: 130px;" />
                        </div>
                    </div>
                    <div class="filter-item" style="margin-left: auto;">
                        <button type="button" id="btn_buscar" class="btn-modern-filter">
                            <i class="fa fa-search"></i> Generar Reporte
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-xs-12">
            <div id="grafica" style="width: 100%; max-width: 100%; overflow: hidden;">
            </div>
        </div>
    </div>

    <!-- Nota Informativa al pie de página -->
    <div class="row">
        <div class="col-xs-12">
            <div class="modern-info-card" style="margin-top: 8px; margin-bottom: 12px; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 8px; padding: 8px 14px; display: flex; align-items: center; gap: 10px;">
                <div style="width: 24px; height: 24px; border-radius: 50%; background: #2563eb; color: #ffffff; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-weight: 700; font-size: 12px;">
                    i
                </div>
                <div style="font-size: 12px; color: #1e3a8a;">
                    <strong>Nota:</strong> Toda la información se presenta en millones de colones y corresponde al período de referencia seleccionado.
                </div>
            </div>
        </div>
    </div>
</section>

<script type="text/javascript">

    function togglePeriodoInicial() {
        if ($("#Grafico").val() != 10) {
            $("#cont_fecInicial").removeClass("hidden").show();
        } else {
            $("#cont_fecInicial").addClass("hidden").hide();
        }
    }

    $(document).ready(function () {
        togglePeriodoInicial();
        refreshGraph();
    });

    $("#Grafico").change(function () {
        togglePeriodoInicial();
        refreshGraph();
    });

    $("#IdEntidad").change(function () {
        refreshGraph();
    });

    function refreshGraph() {
         $('#grafica').html('<div style="text-align: center; padding: 40px 0; color: #64748b;"><i class="fa fa-spinner fa-spin fa-2x"></i><p style="margin-top: 10px; font-size: 13px;">Cargando gráfico...</p></div>');
         $.ajax({
            url: '@Url.Action("GraficaDetalle", "Cartera14_21")',
            type: 'POST',
            cache: false,
            data: {
                 'Entidades': $('#IdEntidad').val(),
                 'Grafico': $('#Grafico').val(),
                 'PeriodoI': $('#PeriodoI').val(),
                 'PeriodoF': $('#PeriodoF').val()                
            },
             success: function (result) {
                 $('#grafica').html(result);
                 var entText = $("#IdEntidad :selected").text() || '';
                 var grafText = $("#Grafico :selected").text() || '';
                 $("#entidad").text(grafText);
                 $("#pEntidad").text(grafText);
                 if (entText) {
                     $("#pSubEntidad").text(entText);
                 }
                 setTimeout(function () {
                     if (typeof Highcharts !== 'undefined' && Highcharts.charts) {
                         Highcharts.charts.forEach(function (c) {
                             if (c && c.renderTo && $(c.renderTo).closest('#grafica').length) {
                                 try { c.reflow(); } catch (e) {}
                             }
                         });
                     }
                 }, 60);
            },
            error: function () {
                $('#grafica').html('<div class="alert alert-danger" style="margin: 20px;">Ocurrió un error al cargar el gráfico.</div>');
            }
         });
    }

    $(document).on('click', '#btn_buscar', function () {
        refreshGraph();
    });

    $(window).on('resize', function () {
        if (typeof Highcharts !== 'undefined' && Highcharts.charts) {
            Highcharts.charts.forEach(function (c) {
                if (c && c.renderTo && $(c.renderTo).closest('#grafica').length) {
                    try { c.reflow(); } catch (e) {}
                }
            });
        }
    });

    function formatMillion() {
        if ($("#Grafico").length && $("#Grafico :selected").length) {
            var entText = $("#IdEntidad :selected").text() || '';
            var grafText = $("#Grafico :selected").text() + " en millones";
            $("#entidad").text(grafText);
            $("#pEntidad").text(grafText);
            if (entText) {
                $("#pSubEntidad").text(entText);
            }
        }
        if (typeof Highcharts !== 'undefined' && Highcharts.numberFormat) {
            var decimals = (this.value % 1 !== 0) ? 2 : 0;
            return Highcharts.numberFormat(this.value, decimals, '.', ',');
        }
        return this.value;
    }

    function formatPercent() {
        if (typeof Highcharts !== 'undefined' && Highcharts.numberFormat) {
            var decimals = (this.value % 1 !== 0) ? 2 : 0;
            return Highcharts.numberFormat(this.value, decimals, '.', ',') + ' %';
        }
        return this.value + " %";
    }

</script>