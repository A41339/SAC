                        }
                    }
                },
                spacingLeft: 45,
                spacingRight: 30
            },
            plotOptions: {
                column: {
                    depth: 35,
                    edgeColor: 'rgba(15, 23, 42, 0.28)',
                    edgeWidth: 1.4,
                    groupZPadding: 10,
                    pointPadding: 0.12,
                    groupPadding: 0.14,
                    maxPointWidth: 48
                },
                bar: {
                    depth: 32,
                    edgeColor: 'rgba(15, 23, 42, 0.28)',
                    edgeWidth: 1.4,
