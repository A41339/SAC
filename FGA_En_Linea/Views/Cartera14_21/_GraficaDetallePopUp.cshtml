            <div id="histograma3DControllerModal" style="display: none; align-items: center; justify-content: space-between; padding: 8px 18px; background: #f8fafc; border-bottom: 1px solid #e2e8f0; gap: 10px; flex-wrap: wrap;">
                <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                    <button type="button" class="btn btn-sm btn-default btn-orbit-3d" onclick="window.toggleAutoRotar3D()" style="height: 28px; padding: 0 11px; font-size: 11.5px; font-weight: 600; border-radius: 6px; border: 1px solid #cbd5e1; background: #ffffff; color: #475569; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 1px 2px rgba(0,0,0,0.03); transition: all 0.2s ease;">
