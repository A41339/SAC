                        <button type="button" class="btn-preset-3d active" onclick="window.setPresetAngulo3D(48, 0, 225, this)" style="height: 24px; padding: 0 10px; font-size: 11px; font-weight: 700; border: none; background: #e0f2fe; color: #0369a1; cursor: pointer; border-radius: 4px; transition: all 0.15s ease;" title="Vista frontal aérea calibrada sin oclusiones">Aérea 48°</button>
                        <button type="button" class="btn-preset-3d" onclick="window.setPresetAngulo3D(75, 0, 230, this)" style="height: 24px; padding: 0 10px; font-size: 11px; font-weight: 600; border: none; background: transparent; color: #475569; cursor: pointer; border-radius: 4px; transition: all 0.15s ease;" title="Vista cenital vertical directa sin solapamiento">Cenital</button>
