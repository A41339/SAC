                <div id="modalHighchartsContainer" style="width: 100%; min-height: 600px; box-sizing: border-box;">
                    @(Model.pDetalle)
                </div>
                <div id="echartsContainerModalCartera" style="display: none; width: 100%; height: 600px; box-sizing: border-box; border-radius: 8px; overflow: hidden; background: #ffffff;"></div>
            </div>
            <div class="modal-footer" style="padding: 8px 18px; background: #f8fafc; border-top: 1px solid #e2e8f0; text-align: right;">
