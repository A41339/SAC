<script type="text/javascript">
    function mPopUp() {
        var entText = $("#IdEntidad :selected").text() || '';
        var grafText = $("#Grafico :selected").text() || '';
        if (grafText) {
            $("#pEntidad").text(grafText);
        }
        if (entText) {
            $("#pSubEntidad").text(entText);
        }
        $('#mPopUp').modal('show');
    }

    // Estado inicial: RESPETA LA VERSIÓN ORIGINAL (2D Plano, Columnas)
    window.tipoGraficoActual = 'column';
    window.cartera3DActivo = false;

    window.echartsAutoRotate = false;
    window.echartsModoMora = 'completo'; // 'completo' | 'vencida'
    window.echarts3DAlpha = 20;
    window.echarts3DBeta = 36;
    window.coloresPlano2D = ['#0071AD', '#475569', '#0d9488', '#ea580c', '#0284c7', '#6366f1', '#1e3a8a', '#d97706', '#059669', '#64748b'];

    // Mapeo de paleta institucional y sobria para tramos de riesgo / morosidad
    window.obtenerColorInstitucional = function (name, idx) {
        var n = (name || '').toLowerCase();
        if (n.indexOf('al d') > -1 || n.indexOf('vigente') > -1) {
            return '#1b3866'; // Azul Marino Institucional FGA
        } else if (n.indexOf('1 a 30') > -1 || n.indexOf('1-30') > -1 || (n.indexOf('30') > -1 && n.indexOf('60') === -1)) {
            return '#0284c7'; // Azul Océano Institucional
        } else if (n.indexOf('31 a 60') > -1 || n.indexOf('31-60') > -1 || (n.indexOf('60') > -1 && n.indexOf('90') === -1)) {
            return '#d97706'; // Ámbar Institucional (Alerta)
        } else if (n.indexOf('61 a 90') > -1 || n.indexOf('61-90') > -1) {
            return '#ea580c'; // Naranja Terracota (Riesgo alto)
        } else if (n.indexOf('90') > -1 || n.indexOf('mayor') > -1 || n.indexOf('vencid') > -1) {
            return '#b91c1c'; // Rojo Ejecutivo (Mora crítica)
        }
        var paleta = ['#1b3866', '#0284c7', '#d97706', '#ea580c', '#b91c1c', '#475569', '#0d9488', '#2F5597'];
        return paleta[idx % paleta.length];
    };

    window.guardarConfiguracionOriginal = function (chart) {
        if (!chart || chart._fgaOriginalConfig) return;
        try {
            var savedSeries = [];
            if (chart.series && chart.series.length > 0) {
                chart.series.forEach(function (s, idx) {
                    var rawData = [];
                    if (s.options && s.options.data) {
                        rawData = JSON.parse(JSON.stringify(s.options.data));
                    } else if (s.data) {
                        rawData = s.data.map(function (pt) {
                            if (typeof pt === 'number') return pt;
                            if (pt && typeof pt.y === 'number') return pt.y;
                            if (Array.isArray(pt)) return pt[1];
                            return pt;
                        });
                    }
                    var yAxisIdx = 0;
                    if (s.yAxis) {
                        if (typeof s.yAxis.options.index === 'number') yAxisIdx = s.yAxis.options.index;
                        else if (s.yAxis.options.id === 'Concentracion') yAxisIdx = 0;
                        else if (chart.yAxis && chart.yAxis.indexOf(s.yAxis) >= 0) yAxisIdx = chart.yAxis.indexOf(s.yAxis);
                    }
                    var sColor = s.color || window.coloresPlano2D[idx % window.coloresPlano2D.length];
                    savedSeries.push({
                        name: s.name,
                        origType: (s.type === 'line' || s.type === 'spline') ? 'line' : 'column',
                        color: sColor,
                        data: rawData,
                        yAxis: yAxisIdx,
                        stack: (s.options && s.options.stack) ? s.options.stack : null,
                        dashStyle: (s.options && s.options.dashStyle) ? s.options.dashStyle : null,
                        zIndex: (s.options && s.options.zIndex !== undefined) ? s.options.zIndex : idx
                    });
                });
            }

            var savedCats = [];
            if (chart.xAxis && chart.xAxis[0] && chart.xAxis[0].categories) {
                savedCats = chart.xAxis[0].categories.slice();
            }

            chart._fgaOriginalConfig = {
                series: savedSeries,
                categories: savedCats,
                title: (chart.title && chart.title.textStr) ? chart.title.textStr : '',
                subTitle: (chart.subtitle && chart.subtitle.textStr) ? chart.subtitle.textStr : ''
            };
        } catch (err) {
            console.warn('Error al guardar configuración original:', err);
        }
    };

    // Renderizado de la Matriz 3D Multi-período con Apache ECharts GL (WebGL)
    window.renderEChartsMatrix3D = function (domId, chartSource) {
        if (typeof echarts === 'undefined') {
            console.warn('ECharts no está disponible');
            return null;
        }

        var dom = document.getElementById(domId);
        if (!dom) return null;

        var chartOrig = chartSource;
        if (!chartOrig || !chartOrig._fgaOriginalConfig) {
            if (typeof Highcharts !== 'undefined' && Highcharts.charts) {
                for (var i = 0; i < Highcharts.charts.length; i++) {
                    var ch = Highcharts.charts[i];
                    if (ch && ch._fgaOriginalConfig && ch._fgaOriginalConfig.categories && ch._fgaOriginalConfig.categories.length > 0) {
                        chartOrig = ch;
                        break;
                    }
                }
            }
        }
        if (!chartOrig || !chartOrig._fgaOriginalConfig) return null;

        var orig = chartOrig._fgaOriginalConfig;
        var cats = (orig.categories || []).slice();
        var colSeries = orig.series.filter(function (s) { return s.origType === 'column'; });
        if (colSeries.length === 0) colSeries = orig.series;

        // Filtrado por modo: Vista Completa vs Enfoque Cartera Vencida
        var seriesToRender = colSeries;
        if (window.echartsModoMora === 'vencida') {
            var vencidas = colSeries.filter(function (s) {
                var n = (s.name || '').toLowerCase();
                return !(n.indexOf('al d') > -1 || n.indexOf('vigente') > -1);
            });
            if (vencidas.length > 0) {
                seriesToRender = vencidas;
            }
        }

        var tramoNames = seriesToRender.map(function (s) { return s.name; });

        // Totales periódicos para porcentaje
        var periodTotals = [];
        cats.forEach(function (cat, xIdx) {
            var tot = 0;
            colSeries.forEach(function (s) {
                var v = 0;
                if (s.data && s.data.length > xIdx) {
                    var pt = s.data[xIdx];
                    if (typeof pt === 'number') v = pt;
                    else if (pt && typeof pt.y === 'number') v = pt.y;
                    else if (Array.isArray(pt) && typeof pt[1] === 'number') v = pt[1];
                }
                tot += Math.max(0, v || 0);
            });
            periodTotals[xIdx] = tot;
        });

        // Construir datos en formato [xIdx, yIdx, zVal]
        var data3D = [];
        seriesToRender.forEach(function (s, yIdx) {
            var col = window.obtenerColorInstitucional(s.name, yIdx);
            cats.forEach(function (cat, xIdx) {
                var v = 0;
                if (s.data && s.data.length > xIdx) {
                    var pt = s.data[xIdx];
                    if (typeof pt === 'number') v = pt;
                    else if (pt && typeof pt.y === 'number') v = pt.y;
                    else if (Array.isArray(pt) && typeof pt[1] === 'number') v = pt[1];
                }
                v = Math.max(0, parseFloat(v) || 0);
                var pTot = periodTotals[xIdx] || 0;
                var pct = pTot > 0 ? ((v / pTot) * 100) : 0;

                data3D.push({
                    name: cat + ' - ' + s.name,
                    value: [xIdx, yIdx, v],
                    tramo: s.name,
                    mes: cat,
                    pct: pct,
                    itemStyle: {
                        color: col,
                        opacity: 0.96
                    }
                });
            });
        });

        var myChart = echarts.getInstanceByDom(dom);
        if (!myChart) {
            myChart = echarts.init(dom);
        }

        var numCats = Math.max(1, cats.length);
        var numTramos = Math.max(1, tramoNames.length);

        // Dimensiones ampliadas para abarcar prácticamente todo el ancho del contenedor sin verse encogido
        var dynamicBoxWidth = Math.max(280, Math.min(390, numCats * 26));
        var dynamicBoxDepth = Math.max(85, Math.min(130, numTramos * 22));
        var dynamicBoxHeight = 65;

        // Ancho de barras proporcional
        var barWidth = Math.max(9, Math.min(22, (dynamicBoxWidth * 0.76) / numCats));
        var barDepth = Math.max(9, Math.min(22, (dynamicBoxDepth * 0.70) / numTramos));

        var option = {
            backgroundColor: '#ffffff',
            title: {
                text: (orig.title ? orig.title : 'Distribución de Riesgo de Cartera') + (window.echartsModoMora === 'vencida' ? ' (Enfoque Mora Vencida)' : ''),
                subtext: 'Perspectiva 3D interactiva por período',
                left: 'center',
