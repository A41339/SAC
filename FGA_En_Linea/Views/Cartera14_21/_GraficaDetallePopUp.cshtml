                        if (isPct) {
                            if (pctVal < 0.1 && pctVal > 0) return '<0.1%';
                            return pctVal.toFixed(1) + '%';
                        }

                        // Formateo para valores numéricos o saldo
                        if (valReal >= 1000000) {
                            var enMillones = (valReal / 1000000);
                            return enMillones.toLocaleString('es-CR', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + 'M';
                        } else if (valReal >= 1000) {
                            return Math.round(valReal).toLocaleString('es-CR');
                        } else if (valReal % 1 !== 0) {
                            return valReal.toLocaleString('es-CR', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
                        } else {
                            return Math.round(valReal).toString();
                        }
                    },
                    color: '#0f172a',
                    fontSize: 10,
                    fontWeight: '700',
                    fontFamily: chartFontFamily,
                    backgroundColor: 'rgba(255, 255, 255, 0.92)',
                    borderColor: '#cbd5e1',
                    borderWidth: 1,
                    borderRadius: 3,
                    padding: [2, 4],
                    textStyle: {
                        color: '#0f172a',
                        fontSize: 10,
                        fontWeight: '700',
                        fontFamily: chartFontFamily,
                        backgroundColor: 'rgba(255, 255, 255, 0.92)',
                        borderColor: '#cbd5e1',
                        borderWidth: 1,
                        borderRadius: 3,
                        padding: [2, 4]
                    }
                },
                emphasis: {
                    label: {
                        show: true,
                        formatter: function (params) {
                            var d = params.data;
                            if (!d) return ' ';
                            var valReal = (typeof d.realVal !== 'undefined') ? d.realVal : (d.value ? d.value[2] : 0);
                            var pctVal = (typeof d.pct !== 'undefined') ? d.pct : 0;
                            var isPct = d.isPercent || (Math.abs(valReal - pctVal) < 0.05 && valReal <= 100);

                            if (isPct) {
                                return pctVal.toFixed(2) + '%';
                            }

                            var valFormatted = (typeof Highcharts !== 'undefined' && Highcharts.numberFormat)
                                ? Highcharts.numberFormat(valReal, 2, '.', ',')
                                : valReal.toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                            var pctFormatted = (typeof Highcharts !== 'undefined' && Highcharts.numberFormat)
                                ? Highcharts.numberFormat(pctVal, 2, '.', ',')
                                : pctVal.toFixed(2);

                            return valFormatted + ' (' + pctFormatted + '%)';
                        },
                        color: '#1e3a8a',
                        fontSize: 11,
                        fontWeight: '700',
