    window.aplicarTipoAGrafico = function (chart, tipo) {
        if (!chart) return;
        tipo = tipo || window.tipoGraficoActual || 'column';
        window.tipoGraficoActual = tipo;

        window.guardarConfiguracionOriginal(chart);
        var orig = chart._fgaOriginalConfig;
        if (!orig || !orig.series || orig.series.length === 0) return;

        var is3D = (tipo === 'matrix3d');
        var isModal = false;
        try {
            var elem = (chart.renderTo ? (typeof chart.renderTo === 'string' ? document.getElementById(chart.renderTo.replace(/^#/, '')) : chart.renderTo) : null);
            if (elem && $(elem).closest('#mPopUp').length) isModal = true;
        } catch (e) {}

        if (is3D) {
            // MODO MATRIZ 3D MULTI-PERÍODO (WEBGL ECHARTS)
            $('#container').hide();
            $('#echartsContainerCartera').show();
            $('#modalHighchartsContainer').hide();
            $('#echartsContainerModalCartera').show();

            $('#histograma3DControllerCartera, #histograma3DControllerComposicion').css('display', 'flex');
            $('#histograma3DControllerModal').css('display', 'flex');

            setTimeout(function () {
                window.renderEChartsMatrix3D('echartsContainerCartera', chart);
                if (isModal || $('#mPopUp').hasClass('in')) {
                    window.renderEChartsMatrix3D('echartsContainerModalCartera', chart);
                }
            }, 60);

            return;
        }

        // RETORNO A MODO 2D (HIGHCHARTS TRADICIONAL)
        $('#container').show();
        $('#echartsContainerCartera').hide();
        $('#modalHighchartsContainer').show();
        $('#echartsContainerModalCartera').hide();

        $('#histograma3DControllerCartera, #histograma3DControllerComposicion').hide();
        $('#histograma3DControllerModal').hide();

        if (window.echartsAutoRotate) {
            window.toggleAutoRotar3D();
        }

        // Limpiar series de Highcharts para reconstruir
        while (chart.series.length > 0) {
            chart.series[0].remove(false);
        }

        if (tipo === 'spline') {
            // MODO LÍNEAS (TENDENCIA)
            chart.update({
                chart: {
                    type: 'spline',
                    inverted: false,
                    options3d: { enabled: false }
                },
                plotOptions: {
                    series: {
                        stacking: null
                    },
                    spline: {
                        stacking: null,
                        lineWidth: 4.5,
                        marker: {
                            enabled: true,
                            radius: 5.5,
                            symbol: 'circle',
                            lineWidth: 2.2,
                            lineColor: '#ffffff'
                        }
                    }
                },
                xAxis: {
                    categories: orig.categories.slice()
                },
                tooltip: {
                    shared: true,
                    useHTML: false,
                    formatter: null
                }
            }, false);

            chart.setTitle(
                orig.title ? { text: orig.title } : { text: '' },
                {
                    useHTML: false,
                    align: 'center',
                    verticalAlign: null,
                    y: null,
                    text: orig.subTitle || ''
                },
                false
            );

            orig.series.forEach(function (s, idx) {
                var isOrigLine = (s.origType === 'line');
                chart.addSeries({
                    name: s.name,
                    type: 'spline',
                    stacking: null,
                    color: s.color,
                    yAxis: s.yAxis,
                    data: JSON.parse(JSON.stringify(s.data)),
                    lineWidth: isOrigLine ? 5.5 : 4,
                    dashStyle: 'Solid',
                    zIndex: isOrigLine ? 15 : (10 - idx),
                    marker: {
                        enabled: true,
                        radius: isOrigLine ? 6.5 : 5.5,
                        symbol: 'circle',
                        lineWidth: 2.2,
                        lineColor: '#ffffff'
                    },
                    shadow: {
                        color: 'rgba(0, 0, 0, 0.22)',
                        offsetX: 1,
                        offsetY: 3,
                        width: 5,
                        opacity: 0.20
                    }
                }, false);
            });

        } else if (tipo === 'area') {
            // MODO ÁREAS APILADAS
            chart.update({
                chart: {
                    type: 'area',
                    inverted: false,
                    options3d: { enabled: false }
                },
                plotOptions: {
                    areaspline: {
                        stacking: 'normal',
                        fillOpacity: 0.38,
                        lineWidth: 2.5,
                        marker: { enabled: true, radius: 4 }
                    }
                },
                xAxis: {
                    categories: orig.categories.slice()
                },
                tooltip: {
                    shared: true,
                    useHTML: false,
                    formatter: null
                }
            }, false);

            chart.setTitle(
                orig.title ? { text: orig.title } : { text: '' },
                {
                    useHTML: false,
                    align: 'center',
                    verticalAlign: null,
                    y: null,
                    text: orig.subTitle || ''
                },
                false
            );

            orig.series.forEach(function (s, idx) {
                var isOrigLine = (s.origType === 'line');
                if (isOrigLine) {
                    chart.addSeries({
                        name: s.name,
                        type: 'spline',
                        stacking: null,
                        color: s.color,
                        yAxis: s.yAxis,
                        data: JSON.parse(JSON.stringify(s.data)),
                        lineWidth: 5.5,
                        zIndex: 15,
                        marker: {
                            enabled: true,
                            radius: 6.5,
                            symbol: 'circle',
                            lineWidth: 2.5,
                            lineColor: '#ffffff'
                        }
                    }, false);
                } else {
                    chart.addSeries({
                        name: s.name,
                        type: 'areaspline',
                        stacking: 'normal',
                        color: s.color,
                        fillOpacity: 0.38,
                        lineWidth: 2.5,
                        yAxis: s.yAxis,
                        data: JSON.parse(JSON.stringify(s.data)),
                        zIndex: idx,
                        marker: { enabled: true, radius: 4 }
                    }, false);
                }
            });

        } else {
            // VERSIÓN ORIGINAL: COLUMNAS APILADAS PLANAS + LÍNEA EN 2D
            chart.update({
                chart: {
                    type: 'column',
                    inverted: false,
                    options3d: { enabled: false }
                },
                plotOptions: {
                    column: {
                        stacking: 'normal',
                        depth: 0,
                        borderWidth: 0,
                        pointPadding: 0.08,
                        groupPadding: 0.10,
                        maxPointWidth: 44
                    }
                },
                xAxis: {
                    categories: orig.categories.slice()
                },
                tooltip: {
                    shared: true,
                    useHTML: false,
                    formatter: null
                }
            }, false);

            chart.setTitle(
                orig.title ? { text: orig.title } : { text: '' },
                {
                    useHTML: false,
                    align: 'center',
                    verticalAlign: null,
                    y: null,
                    text: orig.subTitle || ''
                },
                false
            );

            orig.series.forEach(function (s, idx) {
                var isOrigLine = (s.origType === 'line');
                if (isOrigLine) {
                    chart.addSeries({
                        name: s.name,
                        type: 'line',
                        color: s.color,
                        yAxis: s.yAxis,
                        data: JSON.parse(JSON.stringify(s.data)),
                        lineWidth: 5,
                        zIndex: 15,
                        linecap: 'round',
                        linejoin: 'round',
                        shadow: { color: 'rgba(0, 0, 0, 0.28)', offsetX: 1, offsetY: 4, width: 6, opacity: 0.25 },
                        marker: { enabled: true, radius: 6, symbol: 'circle', lineWidth: 2.5, lineColor: '#ffffff' }
                    }, false);
                } else {
                    chart.addSeries({
                        name: s.name,
                        type: 'column',
                        stacking: 'normal',
                        color: s.color,
                        yAxis: s.yAxis,
                        data: JSON.parse(JSON.stringify(s.data)),
                        zIndex: idx
                    }, false);
                }
            });
        }

        chart.redraw();

        try {
            var containerElem = document.getElementById('container');
            var w = containerElem ? $(containerElem).width() : null;
            if (!w || w < 200) {
                var pW = $('#grafica').width() || $(chart.container).closest('.modern-table-card').width();
                if (pW && pW > 200) w = Math.floor(pW) - 30;
            }
            if (w && w > 200) {
                chart.setSize(w, isModal ? null : 420, false);
            }
            chart.reflow();
        } catch (e) {}
    };

