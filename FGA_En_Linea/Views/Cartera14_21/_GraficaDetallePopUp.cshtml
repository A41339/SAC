                                        window.guardarConfiguracionOriginal(c);
                                        if (window.tipoGraficoActual && window.tipoGraficoActual !== 'column') {
                                            window.aplicarTipoAGrafico(c, window.tipoGraficoActual);
                                        } else if (typeof window.aplicarEstilo3DCartera === 'function') {
                                            window.aplicarEstilo3DCartera(c, window.cartera3DActivo);
                                        }
                                        window.habilitarRotacionInteractiva3D(c);
                                        c.reflow();
                                    } catch (e) {}
                                    break;
                                }
                            }
                        }
                        $('#selTipoGraficoCartera, #selTipoGraficoComposicion, #selTipoGraficoModal').val(window.tipoGraficoActual || 'column');
                        var hintMain = document.getElementById('lbl3DRotateHint') || document.getElementById('lbl3DRotateHintComposicion');
                        if (hintMain) hintMain.style.display = window.cartera3DActivo ? 'inline-flex' : 'none';
                    }
                    sincronizarGraficoPantalla();
                    setTimeout(sincronizarGraficoPantalla, 60);
                    setTimeout(sincronizarGraficoPantalla, 180);
                    setTimeout(sincronizarGraficoPantalla, 350);
                })();
            </script>
