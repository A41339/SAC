            orig.series.forEach(function (s, idx) {
                var isOrigLine = (s.origType === 'line');
                if (isOrigLine) {
                    chart.addSeries({
                        name: s.name,
                        type: 'line',
                        color: s.color,
                        yAxis: s.yAxis,
                        data: JSON.parse(JSON.stringify(s.data)),
                        lineWidth: 5,
                        zIndex: 15,
                        linecap: 'round',
                        linejoin: 'round',
                        shadow: { color: 'rgba(0, 0, 0, 0.28)', offsetX: 1, offsetY: 4, width: 6, opacity: 0.25 },
                        marker: { enabled: true, radius: 6, symbol: 'circle', lineWidth: 2.5, lineColor: '#ffffff' }
                    }, false);
                } else {
                    chart.addSeries({
                        name: s.name,
                        type: 'column',
                        stacking: 'normal',
                        color: s.color,
                        yAxis: s.yAxis,
                        data: JSON.parse(JSON.stringify(s.data)),
                        zIndex: idx
                    }, false);
                }
            });
        }

        chart.redraw();

        try {
            var targetContainer = isModal ? document.getElementById('modalHighchartsContainer') : document.getElementById('container');
            var targetH = isModal ? 600 : 440;
            var w = targetContainer ? $(targetContainer).width() : null;
            if (!w || w < 200) {
                if (isModal) {
                    var mBody = $('#mPopUp .modal-body');
                    w = (mBody.length && mBody.width() > 200) ? Math.floor(mBody.width()) : null;
                } else {
                    var pW = $('#grafica').width() || $(chart.container).closest('.modern-table-card').width();
                    if (pW && pW > 200) w = Math.floor(pW) - 10;
                }
            }
            if (!w || w < 200) {
                if (isModal) {
                    var mDialog = $('#mPopUp .modal-dialog');
                    w = (mDialog.length && mDialog.width() > 200) ? Math.floor(mDialog.width()) - 20 : null;
                }
            }
            if (w && w > 200) {
                chart.setSize(w, targetH, false);
            }
            if (isModal && chart.container) {
                $(chart.container).css({ 'width': '100%', 'height': targetH + 'px' });
            }
            chart.reflow();

            setTimeout(function () {
                try {
                    var cElem = isModal ? document.getElementById('modalHighchartsContainer') : document.getElementById('container');
                    var curW = cElem ? $(cElem).width() : 0;
                    if (isModal && (!curW || curW < 300)) {
                        var mb = $('#mPopUp .modal-body');
                        if (mb.length && mb.width() > 300) curW = Math.floor(mb.width());
                    }
                    if (curW && curW > 200) {
                        chart.setSize(curW, targetH, false);
                    }
                    if (isModal && chart.container) {
                        $(chart.container).css({ 'width': '100%', 'height': targetH + 'px' });
                    }
                    chart.reflow();
                } catch (ex) {}
            }, 80);
        } catch (e) {}
    };

    window.cambiarTipoGrafico = function (tipo) {
        window.tipoGraficoActual = tipo;
        window.cartera3DActivo = (tipo === 'matrix3d');

        // Sincronizar selectores
        $('#selTipoGraficoCartera, #selTipoGraficoComposicion, #selTipoGraficoModal').val(tipo);

        // Actualizar botones de 3D
        window.actualizarEstiloBotones3D(window.cartera3DActivo);

        if (typeof Highcharts !== 'undefined' && Highcharts.charts) {
            Highcharts.charts.forEach(function (c) {
                if (c) {
                    window.aplicarTipoAGrafico(c, tipo);
                }
            });
        }

        if (tipo !== 'matrix3d' && $('#mPopUp').hasClass('in')) {
            $('#modalHighchartsContainer').show();
            $('#echartsContainerModalCartera').hide();
            setTimeout(function () {
                if (typeof Highcharts !== 'undefined' && Highcharts.charts) {
                    Highcharts.charts.forEach(function (c) {
                        if (c && c.container && ($(c.container).closest('#mPopUp').length || $(c.container).closest('#modalHighchartsContainer').length)) {
                            var mW = $('#modalHighchartsContainer').width() || ($('#mPopUp .modal-body').width() - 36);
                            if (mW && mW > 200) {
                                c.setSize(mW, 600, false);
                            }
                            $(c.container).css({ 'width': '100%', 'height': '600px' });
                            c.reflow();
                        }
                    });
                }
            }, 100);
        }

        if ($('#mPopUp').hasClass('in') && typeof window.actualizarKpiModalCartera === 'function') {
            window.actualizarKpiModalCartera();
        }
    };

    window.actualizarEstiloBotones3D = function (is3D) {
        var btnMain = document.getElementById('btnToggle3DCartera') || document.getElementById('btnToggle3DComposicion');
        var btnModal = document.getElementById('btnToggle3DModal');
        var lblMain = document.getElementById('lblToggle3D') || document.getElementById('lblToggle3DComposicion');
        var lblModal = document.getElementById('lblToggle3DModal');

        var activeStyle = "height: 28px; padding: 0 11px; font-size: 11.5px; font-weight: 600; border-radius: 6px; display: inline-flex; align-items: center; gap: 6px; border: 1px solid #bae6fd; background: #f0f9ff; color: #0369a1; cursor: pointer; transition: all 0.2s ease; box-shadow: 0 1px 2px rgba(0,0,0,0.04);";
        var inactiveStyle = "height: 28px; padding: 0 11px; font-size: 11.5px; font-weight: 600; border-radius: 6px; display: inline-flex; align-items: center; gap: 6px; border: 1px solid #cbd5e1; background: #f1f5f9; color: #475569; cursor: pointer; transition: all 0.2s ease; box-shadow: 0 1px 2px rgba(0,0,0,0.04);";

        var modalActiveStyle = "height: 28px; padding: 0 11px; font-size: 11.5px; font-weight: 600; border-radius: 6px; display: inline-flex; align-items: center; gap: 6px; border: 1px solid rgba(255,255,255,0.4); background: rgba(255,255,255,0.22); color: #ffffff; cursor: pointer; transition: all 0.2s ease;";
        var modalInactiveStyle = "height: 28px; padding: 0 11px; font-size: 11.5px; font-weight: 600; border-radius: 6px; display: inline-flex; align-items: center; gap: 6px; border: 1px solid rgba(255,255,255,0.2); background: rgba(0,0,0,0.15); color: rgba(255,255,255,0.75); cursor: pointer; transition: all 0.2s ease;";

        if (btnMain) {
            btnMain.setAttribute('style', is3D ? activeStyle : inactiveStyle);
            if (lblMain) lblMain.innerText = is3D ? 'Vista 3D: ON' : 'Vista 3D';
        }
        if (btnModal) {
            btnModal.setAttribute('style', is3D ? modalActiveStyle : modalInactiveStyle);
            if (lblModal) lblModal.innerText = is3D ? 'Vista 3D: ON' : 'Vista 3D';
        }
    };

    window.toggle3DCartera = function (btn) {
        window.cartera3DActivo = !window.cartera3DActivo;
        var is3D = window.cartera3DActivo;
        var nuevoTipo = is3D ? 'matrix3d' : 'column';
        window.cambiarTipoGrafico(nuevoTipo);
    };

    window.aplicarEstilo3DCartera = function (chart, activo) {
        if (typeof activo === 'boolean') {
            window.cartera3DActivo = activo;
        }
        window.cambiarTipoGrafico(window.cartera3DActivo ? 'matrix3d' : 'column');
    };

    $('#mPopUp').on('shown.bs.modal', function () {
        if (window.tipoGraficoActual === 'matrix3d') {
            $('#modalHighchartsContainer').hide();
            $('#echartsContainerModalCartera').show();
            setTimeout(function () {
                window.renderEChartsMatrix3D('echartsContainerModalCartera');
                window.actualizarKpiModalCartera();
            }, 80);
            return;
        }

        if (typeof Highcharts !== 'undefined') {
            Highcharts.charts.forEach(function (chart) {
                if (!chart) return;
                var elem = (typeof getHighchartsRenderElement === 'function') ? getHighchartsRenderElement(chart) : (chart.renderTo ? (typeof chart.renderTo === 'string' ? document.getElementById(chart.renderTo.replace(/^#/, '')) : chart.renderTo) : null);
                if ((elem && $(elem).closest('#mPopUp').length) || (chart.container && ($(chart.container).closest('#mPopUp').length || $(chart.container).closest('#modalHighchartsContainer').length))) {
                    window.guardarConfiguracionOriginal(chart);
                    window.aplicarTipoAGrafico(chart, window.tipoGraficoActual, true);
                    
                    var mW = $('#modalHighchartsContainer').width() || $('#mPopUp .modal-body').width();
                    if (mW && mW > 200) {
                        chart.setSize(mW, 600, false);
                    }
                    if (chart.container) {
                        $(chart.container).css({ 'width': '100%', 'height': '600px' });
                    }
                    chart.reflow();
                }
            });

            setTimeout(function () {
                if (typeof Highcharts !== 'undefined' && Highcharts.charts) {
                    Highcharts.charts.forEach(function (chart) {
                        if (!chart) return;
                        var elem = (typeof getHighchartsRenderElement === 'function') ? getHighchartsRenderElement(chart) : (chart.renderTo ? (typeof chart.renderTo === 'string' ? document.getElementById(chart.renderTo.replace(/^#/, '')) : chart.renderTo) : null);
                        if ((elem && $(elem).closest('#mPopUp').length) || (chart.container && ($(chart.container).closest('#mPopUp').length || $(chart.container).closest('#modalHighchartsContainer').length))) {
                            var curW = $('#modalHighchartsContainer').width() || $('#mPopUp .modal-body').width();
                            if (curW && curW > 200) {
                                chart.setSize(curW, 600, false);
                            }
                            chart.reflow();
                        }
                    });
                }
                window.actualizarKpiModalCartera();
            }, 120);
        }
    });

    window.actualizarKpiModalCartera = function () {
        try {
            var chartOrig = null;
            if (typeof Highcharts !== 'undefined' && Highcharts.charts) {
                for (var i = 0; i < Highcharts.charts.length; i++) {
                    var c = Highcharts.charts[i];
                    if (c && c._fgaOriginalConfig && c._fgaOriginalConfig.categories && c._fgaOriginalConfig.categories.length > 0) {
                        chartOrig = c;
                        break;
                    }
                }
            }
            if (!chartOrig || !chartOrig._fgaOriginalConfig) return;
            var orig = chartOrig._fgaOriginalConfig;
            var cats = orig.categories || [];
            var colSeries = orig.series.filter(function (s) { return s.origType === 'column'; });
            if (colSeries.length === 0) colSeries = orig.series;

            var formatNum = function (n) {
                return (typeof n === 'number') ? n.toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : n;
            };

            if (window.tipoGraficoActual === 'matrix3d') {
                var lastIdx = (cats.length > 0) ? (cats.length - 1) : 0;
                var lastMonthName = cats[lastIdx] || 'Corte';

                var totMes = 0;
                var vigVal = 0;
                var vencVal = 0;
                var moraCritVal = 0;

                colSeries.forEach(function (s) {
                    var v = 0;
                    if (s.data && s.data.length > lastIdx) {
                        var pt = s.data[lastIdx];
                        if (typeof pt === 'number') v = pt;
                        else if (pt && typeof pt.y === 'number') v = pt.y;
                        else if (Array.isArray(pt) && typeof pt[1] === 'number') v = pt[1];
                    }
                    v = Math.max(0, parseFloat(v) || 0);
                    totMes += v;

                    var n = (s.name || '').toLowerCase();
                    if (n.indexOf('al d') > -1 || n.indexOf('vigente') > -1) {
                        vigVal += v;
                    } else {
                        vencVal += v;
                        if (n.indexOf('90') > -1 || n.indexOf('mayor') > -1 || n.indexOf('crit') > -1) {
                            moraCritVal += v;
                        }
                    }
                });

                var pctVenc = totMes > 0 ? ((vencVal / totMes) * 100) : 0;
                var pctVig = totMes > 0 ? ((vigVal / totMes) * 100) : 0;
                var pctCrit = totMes > 0 ? ((moraCritVal / totMes) * 100) : 0;

                $('#cartera1421ModalKpiStrip').html(
                    '<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 7px 14px;">' +
                    '    <div>' +
                    '        <span style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 600; display: block; line-height: 1.2;">Último Período</span>' +
                    '        <span style="font-size: 14.5px; font-weight: 700; color: #1e3a8a;">' + lastMonthName + '</span>' +
                    '    </div>' +
                    '    <div style="border-left: 1px solid #cbd5e1; padding-left: 14px;">' +
                    '        <span style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 600; display: block; line-height: 1.2;">Saldo Total Cartera</span>' +
                    '        <span style="font-size: 14.5px; font-weight: 700; color: #0f172a;">' + formatNum(totMes) + '</span>' +
                    '    </div>' +
                    '    <div style="border-left: 1px solid #cbd5e1; padding-left: 14px;">' +
                    '        <span style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 600; display: block; line-height: 1.2;">Vigente / Al Día</span>' +
                    '        <span class="badge" style="background-color: #dbeafe; color: #1e40af; font-size: 11.5px; font-weight: 700; padding: 3px 8px; border-radius: 6px;">' +
                    '            ' + formatNum(pctVig) + '% (' + formatNum(vigVal) + ')' +
                    '        </span>' +
                    '    </div>' +
                    '    <div style="border-left: 1px solid #cbd5e1; padding-left: 14px;">' +
                    '        <span style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 600; display: block; line-height: 1.2;">Cartera Vencida (>0 d)</span>' +
                    '        <span class="badge" style="background-color: #ffedd5; color: #c2410c; font-size: 11.5px; font-weight: 700; padding: 3px 8px; border-radius: 6px;">' +
                    '            ' + formatNum(pctVenc) + '% (' + formatNum(vencVal) + ')' +
                    '        </span>' +
                    '    </div>' +
                    '    <div style="border-left: 1px solid #cbd5e1; padding-left: 14px;">' +
                    '        <span style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 600; display: block; line-height: 1.2;">Mora Crítica (>90 d)</span>' +
                    '        <span class="badge" style="background-color: #fee2e2; color: #991b1b; font-size: 11.5px; font-weight: 700; padding: 3px 8px; border-radius: 6px;">' +
                    '            ' + formatNum(pctCrit) + '% (' + formatNum(moraCritVal) + ')' +
                    '        </span>' +
                    '    </div>' +
                    '</div>'
                );
                return;
            }

            function renderCarteraKpi(selectedIdx) {
                var modalCharts = Highcharts.charts.filter(function (c) {
                    var elem = (typeof getHighchartsRenderElement === 'function') ? getHighchartsRenderElement(c) : (c && typeof c.renderTo === 'string' ? document.getElementById(c.renderTo.replace(/^#/, '')) : (c ? c.renderTo : null));
                    return c && elem && $(elem).closest('#mPopUp').length && c.series && c.series.length > 0;
                });
                var chart = (modalCharts.length > 0) ? modalCharts[0] : chartOrig;
                if (!chart || !chart.series || chart.series.length === 0) return;

                var seriesIdx = 0;
                if (typeof selectedIdx === 'number' && selectedIdx >= 0 && selectedIdx < chart.series.length) {
                    seriesIdx = selectedIdx;
                } else {
                    for (var k = 0; k < chart.series.length; k++) {
                        if (chart.series[k].type === 'spline' || chart.series[k].type === 'line') {
                            seriesIdx = k;
                            break;
                        }
                    }
                }

                var s = chart.series[seriesIdx];
                if (!s || !s.data || s.data.length === 0) return;

                var rawData = s.data.map(function (pt) {
                    if (!pt) return 0;
                    if (typeof pt.y === 'number') return pt.y;
                    if (Array.isArray(pt) && typeof pt[1] === 'number') return pt[1];
                    return parseFloat(pt.y) || 0;
                });

                if (rawData.length === 0) return;

                var p1Label = cats && cats.length > 0 ? cats[0] : 'Inicial';
                var p2Label = cats && cats.length > 0 ? cats[cats.length - 1] : 'Final';
                var v1 = rawData[0];
                var v2 = rawData[rawData.length - 1];
                var diff = v2 - v1;
                var sum = rawData.reduce(function (a, b) { return a + b; }, 0);
                var avg = sum / rawData.length;
                var minVal = Math.min.apply(null, rawData);
                var maxVal = Math.max.apply(null, rawData);

                var sName = s.name || '';
                var yLabelsFormatter = (s.yAxis && s.yAxis.options && s.yAxis.options.labels && s.yAxis.options.labels.formatter) ? s.yAxis.options.labels.formatter.toString() : '';
                var isPct = (sName.indexOf('%') > -1) ||
                            (s.yAxis && s.yAxis.options && s.yAxis.options.title && s.yAxis.options.title.text && (s.yAxis.options.title.text.indexOf('Porcent') > -1 || s.yAxis.options.title.text.indexOf('Concentrac') > -1)) ||
                            (yLabelsFormatter.indexOf('formatPercent') > -1 || yLabelsFormatter.indexOf('%') > -1);
                var suf = isPct ? '%' : '';

                var isPos = diff >= 0;
                var badgeBg = isPos ? 'background-color: #dbeafe; color: #1e40af;' : 'background-color: #ffedd5; color: #c2410c;';
                var sign = isPos ? '+' : '';

                var diffFormatted = sign + formatNum(diff) + (isPct ? ' p.p.' : suf);

                var selectorHtml = '';
                if (chart.series.length > 1) {
                    selectorHtml =
                        '<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; flex-wrap: wrap; gap: 8px;">' +
                        '    <div style="font-size: 12.5px; font-weight: 700; color: #1e3a8a; display: flex; align-items: center; gap: 6px;">' +
                        '        <i class="fa fa-sliders" style="color: #2F5597;"></i> Indicadores de la serie:' +
                        '    </div>' +
                        '    <div>' +
                        '        <select id="cartera1421ModalSeriesSelect" class="form-control" style="height: 28px; font-size: 12px; font-weight: 600; padding: 2px 8px; border-radius: 6px; border: 1px solid #cbd5e1; color: #1e3a8a; background: #ffffff; min-width: 240px;">';

                    for (var idx = 0; idx < chart.series.length; idx++) {
                        var ser = chart.series[idx];
                        var isSelected = (idx === seriesIdx) ? ' selected' : '';
                        selectorHtml += '<option value="' + idx + '"' + isSelected + '>● ' + (ser.name || ('Serie ' + (idx + 1))) + '</option>';
                    }

                    selectorHtml +=
                        '        </select>' +
                        '    </div>' +
                        '</div>';
                }

                var stripHtml = selectorHtml +
                    '<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 7px 14px;">' +
                    '    <div>' +
                    '        <span style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 600; display: block; line-height: 1.2;">Período Inicial (' + p1Label + ')</span>' +
                    '        <span style="font-size: 14.5px; font-weight: 700; color: #1e3a8a;">' + formatNum(v1) + suf + '</span>' +
                    '    </div>' +
                    '    <div style="border-left: 1px solid #cbd5e1; padding-left: 14px;">' +
                    '        <span style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 600; display: block; line-height: 1.2;">Período Final (' + p2Label + ')</span>' +
                    '        <span style="font-size: 14.5px; font-weight: 700; color: #0f172a;">' + formatNum(v2) + suf + '</span>' +
                    '    </div>' +
                    '    <div style="border-left: 1px solid #cbd5e1; padding-left: 14px;">' +
                    '        <span style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 600; display: block; line-height: 1.2;">Variación</span>' +
                    '        <span class="badge" style="' + badgeBg + ' font-size: 11.5px; font-weight: 700; padding: 3px 8px; border-radius: 6px;">' +
                    '            ' + diffFormatted +
                    '        </span>' +
                    '    </div>' +
                    '    <div style="border-left: 1px solid #cbd5e1; padding-left: 14px;">' +
                    '        <span style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 600; display: block; line-height: 1.2;">Promedio</span>' +
                    '        <span style="font-size: 14.5px; font-weight: 700; color: #334155;">' + formatNum(avg) + suf + '</span>' +
                    '    </div>' +
                    '    <div style="border-left: 1px solid #cbd5e1; padding-left: 14px;">' +
                    '        <span style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 600; display: block; line-height: 1.2;">Mín / Máx</span>' +
                    '        <span style="font-size: 13px; font-weight: 600; color: #475569;">' +
                    '            ' + formatNum(minVal) + suf + ' / ' + formatNum(maxVal) + suf +
                    '        </span>' +
                    '    </div>' +
                    '</div>';

                $('#cartera1421ModalKpiStrip').html(stripHtml);

                $('#cartera1421ModalSeriesSelect').off('change').on('change', function () {
                    var newIdx = parseInt($(this).val(), 10);
                    renderCarteraKpi(newIdx);
                });
            }

            renderCarteraKpi();
            if (chartOrig && typeof chartOrig.reflow === 'function') {
                chartOrig.reflow();
            }
        } catch (e) {
            console.error(e);
        }
    };

    function formatMillion() {
        if (typeof Highcharts !== 'undefined' && Highcharts.numberFormat) {
            var decimals = (this.value % 1 !== 0) ? 2 : 0;
            return Highcharts.numberFormat(this.value, decimals, '.', ',');
        }
        return this.value;
    }

    function formatPercent() {
        if (typeof Highcharts !== 'undefined' && Highcharts.numberFormat) {
            var decimals = (this.value % 1 !== 0) ? 2 : 0;
            return Highcharts.numberFormat(this.value, decimals, '.', ',') + ' %';
        }
        return this.value + " %";
    }

    $(function () {
        function asegurarAnchoCompleto() {
            var containerElem = document.getElementById('container');
            var targetWidth = containerElem ? $(containerElem).width() : null;
            if (!targetWidth || targetWidth < 200) {
                var gW = $('#grafica').width() || $('#grafica').closest('.col-xs-12').width() || 1100;
                targetWidth = Math.floor(gW) - 30;
            }
            $('#grafica #container, #grafica div[id$="_container"], #grafica .highcharts-container').css({
                'width': '100%',
                'max-width': '100%',
                'overflow': 'visible'
            });
            if (typeof Highcharts !== 'undefined' && Highcharts.charts) {
                Highcharts.charts.forEach(function (c) {
                    if (!c) return;
                    var elem = (typeof c.renderTo === 'string') ? document.getElementById(c.renderTo.replace(/^#/, '')) : c.renderTo;
                    if (elem && $(elem).closest('#container').length) {
                        try {
                            if (targetWidth && targetWidth > 200) {
                                c.setSize(targetWidth, 420, false);
                            }
                            window.guardarConfiguracionOriginal(c);
                            if (window.tipoGraficoActual && window.tipoGraficoActual !== 'column') {
                                if (typeof window.aplicarTipoAGrafico === 'function') {
                                    window.aplicarTipoAGrafico(c, window.tipoGraficoActual);
                                }
                            }
                            c.reflow();
                        } catch (e) {}
                    }
                });
            }
            $('#selTipoGraficoCartera, #selTipoGraficoComposicion, #selTipoGraficoModal').val(window.tipoGraficoActual || 'column');
            window.actualizarEstiloBotones3D(window.cartera3DActivo);
        }
        setTimeout(asegurarAnchoCompleto, 60);

        $(window).on('resize', function () {
            if (window.tipoGraficoActual === 'matrix3d' && typeof echarts !== 'undefined') {
                var c1 = echarts.getInstanceByDom(document.getElementById('echartsContainerCartera'));
                if (c1) c1.resize();
                var c2 = echarts.getInstanceByDom(document.getElementById('echartsContainerModalCartera'));
                if (c2) c2.resize();
            }
        });
    });
</script>