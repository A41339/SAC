            <span style="font-size: 11px; font-weight: 600; color: #64748b;">Arrastrar para rotar &bull; Rueda para zoom</span>
        </div>
    </div>

    <div style="padding: 10px 14px 6px 14px; width: 100%; box-sizing: border-box; overflow: visible;">
        <div id="container" style="width: 100%; min-width: 100%; box-sizing: border-box; overflow: visible;">
            @(Model.detalle)
        </div>
        <div id="echartsContainerCartera" style="display: none; width: 100%; height: 580px; box-sizing: border-box; border-radius: 6px; overflow: hidden; background: #ffffff;"></div>
    </div>
</div>

