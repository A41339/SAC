                        if (typeof Highcharts !== 'undefined' && Highcharts.charts) {
                            for (var i = Highcharts.charts.length - 1; i >= 0; i--) {
                                var c = Highcharts.charts[i];
                                if (!c) continue;
                                var renderElem = (typeof c.renderTo === 'string') ? document.getElementById(c.renderTo.replace(/^#/, '')) : c.renderTo;
                                if (renderElem && $(renderElem).closest('#container').length > 0) {
                                    try {
