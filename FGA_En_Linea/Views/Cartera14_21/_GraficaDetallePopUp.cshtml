@model FGA.Model.Grafico

<div class="content">
    <div class="row">
        <div class="col-md-12">
            <div class="box box-warning direct-chat direct-chat-primary">
                <div class="box-header with-border">
                    <img width="50" height="50" src="@Session["Logo"]" />
                    <h3 id="entidad" style="padding-bottom: 10px;" class="box-title"></h3>
                    <a class="text-right" data-toggle="tooltip" data-placement="top" href="javascript:mPopUp()"><i class="btn btn-xs btn-info icon fa fa-line-chart"></i></a>
                </div>
                <div class="row">
                    <div class="col-xs-12">
                        <div class="box box-solid">
                            <div class="box-body table-responsive">
                                <div id="container" style="width: 100%;">
                                    @(Model.detalle)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="mPopUp" tabindex="-1" role="dialog" aria-labelledby="deleteLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <div class="box-header with-border">
                    <img width="50" height="50" src="@Session["Logo"]" />
                    <h3 id="pEntidad" style="padding-bottom: 10px;" class="box-title"></h3>
                </div>
            </div>
            <div class="modal-body">
                 @(Model.pDetalle)
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function mPopUp() {
        $('#mPopUp').modal('show');
    }
    function formatMillion() {
        return this.value;
    }
    function formatPercent() {
        return this.value + " %";
    }
</script>