            tooltip: {
                show: true,
                formatter: function (params) {
                    var d = params.data;
                    if (!d) return '';
                    var valFormatted = (typeof Highcharts !== 'undefined' && Highcharts.numberFormat) ? Highcharts.numberFormat(d.value[2], 2, '.', ',') : d.value[2].toFixed(2);
                    var pctFormatted = (typeof Highcharts !== 'undefined' && Highcharts.numberFormat) ? Highcharts.numberFormat(d.pct, 2, '.', ',') : d.pct.toFixed(2);
                    return '<div style="padding: 6px 10px; font-family: -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif;">' +
                           '  <div style="font-size: 11px; font-weight: 700; color: #64748b; text-transform: uppercase;">Período: ' + d.mes + '</div>' +
                           '  <div style="font-size: 13.5px; font-weight: 800; color: #1e3a8a; margin: 2px 0;">' + d.tramo + '</div>' +
                           '  <div style="font-size: 12px; color: #0f172a;">Saldo: <b>' + valFormatted + '</b></div>' +
                           '  <div style="font-size: 12px; color: #0284c7; font-weight: 700; margin-top: 2px;">Concentración: <b>' + pctFormatted + '%</b></div>' +
                           '</div>';
                }
            },
            xAxis3D: {
                type: 'category',
                name: 'Período',
                data: cats,
                nameTextStyle: { color: '#1e3a8a', fontSize: 12, fontWeight: 'bold' },
                axisLabel: {
                    interval: 0,
                    textStyle: { color: '#334155', fontSize: 10.5, fontWeight: '600' }
                },
                axisLine: { lineStyle: { color: '#cbd5e1' } },
                splitLine: { show: true, lineStyle: { color: '#f1f5f9' } }
            },
            yAxis3D: {
                type: 'category',
                name: 'Tramo',
                data: tramoNames,
                nameTextStyle: { color: '#1e3a8a', fontSize: 12, fontWeight: 'bold' },
                axisLabel: {
                    interval: 0,
                    textStyle: { color: '#334155', fontSize: 10.5, fontWeight: '600' }
                },
                axisLine: { lineStyle: { color: '#cbd5e1' } },
                splitLine: { show: true, lineStyle: { color: '#f1f5f9' } }
            },
            zAxis3D: {
                type: 'value',
                name: 'Saldo',
                nameTextStyle: { color: '#1e3a8a', fontSize: 12, fontWeight: 'bold' },
                axisLabel: {
                    textStyle: { color: '#475569', fontSize: 10 }
                },
                axisLine: { lineStyle: { color: '#cbd5e1' } },
                splitLine: { show: true, lineStyle: { color: '#f1f5f9' } }
            },
            grid3D: {
                boxWidth: dynamicBoxWidth,
                boxDepth: dynamicBoxDepth,
                boxHeight: dynamicBoxHeight,
                top: -15,
                bottom: 10,
                axisPointer: {
                    show: true,
                    lineStyle: { color: '#0284c7', width: 1.5 }
                },
                viewControl: {
                    alpha: window.echarts3DAlpha || 20,
                    beta: window.echarts3DBeta || 36,
                    distance: 155, // Distancia reducida para que las barras llenen el ancho del lienzo
                    minDistance: 60,
                    maxDistance: 450,
                    autoRotate: !!window.echartsAutoRotate,
                    autoRotateSpeed: 10,
                    rotateSensitivity: 1.2,
                    zoomSensitivity: 1.2,
                    panSensitivity: 1.0,
                    damping: 0.8
                },
                light: {
                    main: {
                        intensity: 1.35,
                        shadow: true,
                        shadowQuality: 'high',
                        alpha: 45,
                        beta: -30
                    },
                    ambient: {
                        intensity: 0.70 // Iluminación ambiental limpia y brillante sobre fondo blanco
                    }
                },
                environment: '#ffffff',
                postEffect: {
                    enable: false // Desactivado para garantizar fondo 100% blanco puro sin viñetas oscuras
                }
            },
            series: [{
                type: 'bar3D',
                data: data3D,
                shading: 'realistic',
                realisticMaterial: {
                    roughness: 0.32,
                    metalness: 0.12
                },
                barSize: [barWidth, barDepth],
                bevelSize: 0.35,
                bevelSegments: 3,
                emphasis: {
