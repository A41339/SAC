<script type="text/javascript">
    function mPopUp() {
        var entText = $("#IdEntidad :selected").text() || '';
        var grafText = $("#Grafico :selected").text() || '';
        if (grafText) {
            $("#pEntidad").text(grafText);
        }
        if (entText) {
            $("#pSubEntidad").text(entText);
        }
        $('#mPopUp').modal('show');
    }

    // Estado inicial: RESPETA LA VERSIÓN ORIGINAL (2D Plano, Columnas)
    window.tipoGraficoActual = 'column';
    window.cartera3DActivo = false;

    window.echartsAutoRotate = false;
    window.echartsModoMora = 'completo'; // 'completo' | 'vencida'
    window.tramosOcultos3D = {};
    window.echarts3DAlpha = 48;
    window.echarts3DBeta = 0;
    window.echarts3DDistance = 225;
    window.coloresPlano2D = ['#2F5597', '#0284c7', '#959595', '#ea580c', '#565656', '#6DB5CB', '#143750', '#f59e0b', '#0071AD', '#B7D8DF'];
    window.paletaInstitucionalFGA = ['#2F5597', '#0284c7', '#959595', '#ea580c', '#565656', '#6DB5CB', '#143750', '#f59e0b', '#0071AD', '#B7D8DF'];

    // Mapeo riguroso de colores institucionales FGA / FFC
    window.obtenerColorInstitucional = function (name, idx, sColor) {
        if (sColor && typeof sColor === 'string' && (sColor.charAt(0) === '#' || sColor.indexOf('rgb') === 0)) {
            return sColor;
        }
        var n = (name || '').toLowerCase();
        if (n.indexOf('al d') > -1 || n.indexOf('vigente') > -1) {
            return '#2F5597'; // Azul Corporativo FFC
        } else if (n.indexOf('1 a 30') > -1 || n.indexOf('1-30') > -1 || n.indexOf('hasta30') > -1) {
            return '#0284c7'; // Azul Claro FFC
        } else if (n.indexOf('31 a 60') > -1 || n.indexOf('31-60') > -1 || n.indexOf('hasta60') > -1) {
            return '#959595'; // Gris Auxiliar FFC
        } else if (n.indexOf('61 a 90') > -1 || n.indexOf('61-90') > -1 || n.indexOf('hasta90') > -1) {
            return '#ea580c'; // Naranja Institucional FFC
        } else if (n.indexOf('90') > -1 || n.indexOf('mayor') > -1 || n.indexOf('vencid') > -1) {
            return '#565656'; // Gris Principal FFC
        } else if (n.indexOf('judicial') > -1) {
            return '#143750'; // Azul Oscuro FFC
        }
        return window.paletaInstitucionalFGA[idx % window.paletaInstitucionalFGA.length];
    };

    window.guardarConfiguracionOriginal = function (chart) {
        if (!chart || chart._fgaOriginalConfig) return;
        try {
            var savedSeries = [];
            if (chart.series && chart.series.length > 0) {
                chart.series.forEach(function (s, idx) {
                    var rawData = [];
                    if (s.options && s.options.data) {
                        rawData = JSON.parse(JSON.stringify(s.options.data));
                    } else if (s.data) {
                        rawData = s.data.map(function (pt) {
                            if (typeof pt === 'number') return pt;
                            if (pt && typeof pt.y === 'number') return pt.y;
                            if (Array.isArray(pt)) return pt[1];
                            return pt;
                        });
                    }
                    var yAxisIdx = 0;
                    if (s.yAxis) {
                        if (typeof s.yAxis.options.index === 'number') yAxisIdx = s.yAxis.options.index;
                        else if (s.yAxis.options.id === 'Concentracion') yAxisIdx = 0;
                        else if (chart.yAxis && chart.yAxis.indexOf(s.yAxis) >= 0) yAxisIdx = chart.yAxis.indexOf(s.yAxis);
                    }
                    var sColor = s.color || window.coloresPlano2D[idx % window.coloresPlano2D.length];
                    savedSeries.push({
                        name: s.name,
                        origType: (s.type === 'line' || s.type === 'spline') ? 'line' : 'column',
                        color: sColor,
                        data: rawData,
                        yAxis: yAxisIdx,
                        stack: (s.options && s.options.stack) ? s.options.stack : null,
                        dashStyle: (s.options && s.options.dashStyle) ? s.options.dashStyle : null,
                        zIndex: (s.options && s.options.zIndex !== undefined) ? s.options.zIndex : idx
                    });
                });
            }

            var savedCats = [];
            if (chart.xAxis && chart.xAxis[0] && chart.xAxis[0].categories) {
                savedCats = chart.xAxis[0].categories.slice();
            }

            var isPercentChart = false;
            try {
                if (chart.options && chart.options.plotOptions && chart.options.plotOptions.column && chart.options.plotOptions.column.stacking === 'percent') {
                    isPercentChart = true;
                } else if (chart.options && chart.options.plotOptions && chart.options.plotOptions.series && chart.options.plotOptions.series.stacking === 'percent') {
                    isPercentChart = true;
                } else if (chart.yAxis && chart.yAxis[0] && chart.yAxis[0].options && chart.yAxis[0].options.labels && chart.yAxis[0].options.labels.format && chart.yAxis[0].options.labels.format.indexOf('%') > -1) {
                    isPercentChart = true;
                } else if (chart.title && chart.title.textStr && (chart.title.textStr.indexOf('Concentrac') > -1 || chart.title.textStr.indexOf('Porcent') > -1 || chart.title.textStr.indexOf('%') > -1)) {
                    isPercentChart = true;
                }
            } catch (e) {}

            chart._fgaOriginalConfig = {
                series: savedSeries,
                categories: savedCats,
                title: (chart.title && chart.title.textStr) ? chart.title.textStr : '',
                subTitle: (chart.subtitle && chart.subtitle.textStr) ? chart.subtitle.textStr : '',
                isPercent: isPercentChart
            };
        } catch (err) {
            console.warn('Error al guardar configuración original:', err);
        }
    };

    // Renderizado de la Matriz 3D Multi-período con Apache ECharts GL (WebGL)
    window.renderEChartsMatrix3D = function (domId, chartSource) {
        if (typeof echarts === 'undefined') {
            console.warn('ECharts aún no está disponible, reintentando carga...');
            setTimeout(function () {
                window.renderEChartsMatrix3D(domId, chartSource);
            }, 120);
            return null;
        }

        var dom = document.getElementById(domId);
        if (!dom) return null;

        var chartOrig = chartSource;
        if (!chartOrig || !chartOrig._fgaOriginalConfig) {
            if (typeof Highcharts !== 'undefined' && Highcharts.charts) {
                for (var i = 0; i < Highcharts.charts.length; i++) {
                    var ch = Highcharts.charts[i];
                    if (ch && ch._fgaOriginalConfig && ch._fgaOriginalConfig.categories && ch._fgaOriginalConfig.categories.length > 0) {
                        chartOrig = ch;
                        break;
                    }
                }
            }
        }
        if (!chartOrig || !chartOrig._fgaOriginalConfig) return null;

        var orig = chartOrig._fgaOriginalConfig;
        var cats = (orig.categories || []).slice();
        var colSeries = orig.series.filter(function (s) { return s.origType === 'column'; });
        if (colSeries.length === 0) colSeries = orig.series;

        // Filtrado por modo: Vista Completa vs Enfoque Cartera Vencida (Quita barras 'Al Día')
        var seriesToRender = colSeries;

        // Ordenar tramos de menor a mayor altura promedio (efecto anfiteatro/estadio)
        // para que las barras más pequeñas queden en la fila frontal (Y=0) y las más altas al fondo,
        // garantizando visibilidad total de todas las barras sin oclusiones.
        seriesToRender = seriesToRender.slice().sort(function (a, b) {
            var sumA = (a.data || []).reduce(function (acc, val) {
                var num = (typeof val === 'number') ? val : (val && typeof val.y === 'number' ? val.y : (Array.isArray(val) ? val[1] : 0));
                return acc + (parseFloat(num) || 0);
            }, 0);
            var sumB = (b.data || []).reduce(function (acc, val) {
                var num = (typeof val === 'number') ? val : (val && typeof val.y === 'number' ? val.y : (Array.isArray(val) ? val[1] : 0));
                return acc + (parseFloat(num) || 0);
            }, 0);
            return sumA - sumB;
        });

        var tramoNames = seriesToRender.map(function (s) { return s.name; });

        // Totales periódicos para porcentaje
        var periodTotals = [];
        cats.forEach(function (cat, xIdx) {
            var tot = 0;
            colSeries.forEach(function (s) {
                var v = 0;
                if (s.data && s.data.length > xIdx) {
                    var pt = s.data[xIdx];
                    if (typeof pt === 'number') v = pt;
                    else if (pt && typeof pt.y === 'number') v = pt.y;
                    else if (Array.isArray(pt) && typeof pt[1] === 'number') v = pt[1];
                }
                tot += Math.max(0, v || 0);
            });
            periodTotals[xIdx] = tot;
        });

        // 1. Calcular el valor máximo global entre los tramos a graficar
        var maxVal = 0;
        seriesToRender.forEach(function (s) {
            (s.data || []).forEach(function (pt) {
                var num = (typeof pt === 'number') ? pt : (pt && typeof pt.y === 'number' ? pt.y : (Array.isArray(pt) ? pt[1] : 0));
                var val = Math.max(0, parseFloat(num) || 0);
                if (val > maxVal) maxVal = val;
            });
        });
        if (maxVal <= 0) maxVal = 1;

        // Umbral sutil de altura mínima visible para barras con saldo > 0 sin crear muros que tapen filas traseras
        var minFloor = maxVal * 0.025;

        // 2. Construir datos en formato [xIdx, yIdx, zVal] respetando colores institucionales
        var data3D = [];
        seriesToRender.forEach(function (s, yIdx) {
            var col = window.obtenerColorInstitucional(s.name, yIdx, s.color);
            cats.forEach(function (cat, xIdx) {
                var v = 0;
                if (s.data && s.data.length > xIdx) {
                    var pt = s.data[xIdx];
                    if (typeof pt === 'number') v = pt;
                    else if (pt && typeof pt.y === 'number') v = pt.y;
                    else if (Array.isArray(pt) && typeof pt[1] === 'number') v = pt[1];
                }
                v = Math.max(0, parseFloat(v) || 0);
                var pTot = periodTotals[xIdx] || 0;
                var pct = pTot > 0 ? ((v / pTot) * 100) : 0;

                // Solo graficar tramos con valor real > 0 para eliminar cubos fantasma en el suelo que desvíen el cursor
                if (v > 0) {
                    var zRender = (v < minFloor) ? (minFloor + ((v / minFloor) * (minFloor * 0.35))) : v;
                    var esSoloPorcentaje = (orig.isPercent || (Math.abs(v - pct) < 0.05 && v <= 100));
                    data3D.push({
                        name: cat + ' - ' + s.name,
                        value: [xIdx, yIdx, zRender],
                        realVal: v,
                        tramo: s.name,
                        mes: cat,
                        pct: pct,
                        isPercent: esSoloPorcentaje,
                        itemStyle: {
