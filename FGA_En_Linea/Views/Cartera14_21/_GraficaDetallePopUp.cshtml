                    categories: orig.categories.slice()
                },
                tooltip: {
                    shared: true,
                    useHTML: true,
                    outside: true,
                    formatter: function () {
                        return window.formatGlobalChartTooltip ? window.formatGlobalChartTooltip(this) : null;
                    },
                    backgroundColor: 'transparent',
                    borderColor: 'transparent',
                    shadow: false,
                    padding: 0
                }
            }, false);

            chart.setTitle(
                orig.title ? { text: orig.title } : { text: '' },
                {
                    useHTML: false,
                    align: 'center',
                    verticalAlign: null,
                    y: null,
                    text: orig.subTitle || ''
                },
                false
            );

            orig.series.forEach(function (s, idx) {
                var isOrigLine = (s.origType === 'line');
                if (isOrigLine) {
                    chart.addSeries({
                        name: s.name,
                        type: 'spline',
                        stacking: null,
                        color: s.color,
                        yAxis: s.yAxis,
                        data: JSON.parse(JSON.stringify(s.data)),
                        lineWidth: 5.5,
