@model FGA.Models.Usuario
@{
    ViewBag.Title = "Borrar Usuario";
    if (Ajax.IsThisAjaxRequest())
    {
        Layout = null;
    }
}

@Html.StarkAjaxFormSubmiter("frmUser", "tbUser", true, "Acci&oacute;n realizada con &eacute;xito")
@{
    if (!Ajax.IsThisAjaxRequest())
    {
        <section class="content-header">
    <h1>
        <i class="fa fa-user-times"></i> Eliminar Usuario
        <small>Confirmaci&oacute;n de eliminaci&oacute;n o revocaci&oacute;n de acceso al usuario.</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="#">Seguridad</a></li>
        <li class="active">Eliminar Usuario</li>
    </ol>
</section>
    }
}

<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div class="box box-solid box-info">
                <div class="box-header">
                    <h3 class="box-title">Detalle del usuario</h3>
                </div><!-- /.box-header -->
                <div class="box-body table-responsive">                  
                    <div class="widget-sec">
                        <div class="streaming-table">
                            <table class="table table-striped table-bordered">
                                <tr>
                                    <td>Identificaci&oacute;n</td>
                                    <td>@Html.DisplayFor(model => model.Identificacion)</td>
                                </tr>
                                <tr>
                                    <td>Nombre</td>
                                    <td>@Html.DisplayFor(model => model.Nombre)</td>
                                </tr>
                                <tr>
                                    <td>Tel&eacute;fono</td>
                                    <td>@Html.DisplayFor(model => model.Telefono)</td>
                                </tr>
                                <tr>
                                    <td>Puesto</td>
                                    <td>@Html.DisplayFor(model => model.Puesto)</td>
                                </tr>
                                <tr>
                                    <td>Correo electr&oacute;nico</td>
                                    <td>@Html.DisplayFor(model => model.Correo, new { htmlAttributes = new { @style = "width: 100%;" } })</td>
                                </tr>
                                <tr>
                                    <td>Entidad</td>
                                    <td>@Html.DisplayFor(model => model.Entidad_Usuario.Nombre)</td>
                                </tr>
                                <tr>
                                    <td>Estado</td>
                                    <td>@Html.DisplayFor(model => model.Estado_Usuario.Nombre)</td>
                                </tr>
                                <tr>
                                    <td>Perfil</td>
                                    <td>@Html.DisplayFor(model => model.Role_Usuario.Nombre)</td>
                                </tr>
                                <tr>
                                    <td>G&eacute;nero</td>
                                    <td>@Html.DisplayFor(model => model.Sexo_Usuario.Nombre)</td>
                                </tr>
                            </table>
                            <div class="box-footer">
                                @using (Html.BeginForm("Delete", "Usuario", FormMethod.Post, new {  id = "frmUser" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.StarkInputButtion("Borrar","submit","btn btn-danger","")
                                    @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-primary" })
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>