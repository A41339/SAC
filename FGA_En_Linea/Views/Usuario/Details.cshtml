@model FGA.Models.Usuario

@{
    ViewBag.Title = "Consultar";
    if (Ajax.IsThisAjaxRequest())
    {
        Layout = null;
    }
}
<section class="content-header">
    <h1>
        <i class="fa fa-id-card-o"></i> Consultar Usuario
        <small>Informaci&oacute;n detallada, rol asignado y entidad del usuario.</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="#">Seguridad</a></li>
        <li class="active">Consultar Usuario</li>
    </ol>
</section>
<section class="content">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        <div class="col-xs-12">

            <div class="box box-solid box-info">
                <div class="box-header">
                    <h3 class="box-title">Detalles del Usuario</h3>
                </div><!-- /.box-header -->
                <div class="box-body table-responsive">
                    <div class="widget-sec">
                        <div class="streaming-table">
                            <table class="table table-striped table-bordered">
                                <tr>
                                    <td>Identificacion</td>
                                    <td>@Html.DisplayFor(model => model.Identificacion)</td>
                                </tr>
                                <tr>
                                    <td>Nombre</td>
                                    <td>@Html.DisplayFor(model => model.Nombre)</td>
                                </tr>
                                <tr>
                                    <td>Tel&eacute;fono</td>

                                    <td>@Html.DisplayFor(model => model.Telefono, new { htmlAttributes = new { @style = "width: 100%;" } })</td>
                                </tr>
                                <tr>
                                    <td>Puesto</td>

                                    <td>@Html.DisplayFor(model => model.Puesto, new { htmlAttributes = new { @style = "width: 100%;" } })</td>
                                </tr>
                                <tr>
                                    <td>Entidad</td>
                                    <td>@Html.DisplayFor(model => model.Entidad_Usuario.Nombre)</td>
                                </tr>
                                <tr>
                                    <td>Estado</td>
                                    <td>@Html.DisplayFor(model => model.Estado_Usuario.Nombre)</td>
                                </tr>
                                <tr>
                                    <td>Perfil</td>
                                    <td>@Html.DisplayFor(model => model.Role_Usuario.Nombre)</td>
                                </tr>
                                <tr>
                                    <td>G&eacute;nero</td>
                                    <td>@Html.DisplayFor(model => model.Sexo_Usuario.Nombre)</td>
                                </tr>
                            </table>
                            <div class="box-footer">
                                @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-primary" })
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>



