@{
    ViewBag.Title = "Usuarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content-header">
    <h1 class="modern-page-title">
        <i class="fa fa-users" style="color: #0284c7;"></i>
        Administraci&oacute;n de Usuarios
        <small>Gesti&oacute;n de usuarios, roles y accesos al sistema</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="@Url.Action("Index", "Modulo", new { id = 9000 })" class="breadcrumb-parent-pill" title="Volver al menú de Mantenimientos"><i class="fa fa-wrench" style="margin-right: 4px;"></i> Mantenimientos</a></li>
        <li class="active">Usuarios</li>
    </ol>
</section>

<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div style="margin-bottom: 16px;">
                <a href="@Url.Action("Create", "Usuario")" class="btn-modern-filter" style="display: inline-flex; align-items: center; gap: 8px; text-decoration: none; padding: 9px 20px;">
                    <i class="fa fa-user-plus"></i> Crear un Usuario
                </a>
            </div>
            <div class="modern-table-card">
                <span id="found" class="label label-info"></span>
                <table id="tbUser" class="table table-striped table-bordered modern-data-table" style="width: 100%;">
                    <thead>
                        <tr>
                            <th>Acci&oacute;n</th>
                            <th>Nombre</th>
                            <th>Identificaci&oacute;n</th>
                            <th>Email</th>
                            <th>Estado</th>
                            <th>Perfil</th>
                            <th>Entidad</th>
                            <th>G&eacute;nero</th>
                            <th>Tel&eacute;fono</th>
                            <th>Puesto</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
                <div id="summary">
                    <div></div>
                </div>
            </div>
        </div>
    </div>
</section>

<script type="text/javascript">

        $(document).ready(function () {
            var oTableUser = "";
            var ControlerNameUser = "@Url.Content("~/Usuario")";
            // debugger;
            oTableUser = $("#tbUser").dataTable({
            "bRetrieve": true,
            "bProcessing": true,
            "dom": 'lBfrtip',
            "sAjaxSource": "@Url.Content("~/Usuario/GetGrid")",
            "buttons": [
                 { extend: 'copyHtml5', exportOptions: { columns: ':visible' } }
                ,{ extend: 'excelHtml5', exportOptions: { columns: ':visible' } }
                ,{ extend: 'pdfHtml5', exportOptions: { columns: ':visible' } }
                ,{ extend: 'print', exportOptions: { columns: ':visible' } }
                ,'colvis'
            ], columnDefs: [{   visible: false }],
            "pageLength": 10,
            "lengthMenu": [[5,10, 25, 50, -1], [5,10, 25, 50, "Todos"]],
                "aoColumns": [
                {
                    "mRender": function (oObj, type, row) {
                        var buttons = '<div class="text-center"> <div class="btn-group text-left"> <button type="button" class="btn btn-xs btn-default dropdown-toggle" data-toggle="dropdown" style="border-radius:6px; border:1px solid #cbd5e1; font-size:12px; padding:4px 10px; color:#374151;"><i class="fa fa-cog" style="margin-right:4px;"></i> Acci&oacute;n <span class="caret"></span></button>';
                        buttons += '<ul class="dropdown-menu pull-left" role="menu">';
                        buttons += '<li><a href="' + ControlerNameUser + "/Edit/" + row[0] + '"><i class="fa fa-edit"></i>Modificar</a></li>';
                        buttons += '<li><a href="' + ControlerNameUser + "/Details/" + row[0] + '"><i class="fa fa-search"></i>Consultar</a></li>';
                        buttons += '<li><a href="' + ControlerNameUser + "/Delete/" + row[0] + '"><i class="fa fa-remove"></i>Borrar</a></li>';
                        buttons += '</ul>';
                        buttons += '</div></div>';
                        return buttons;
                    }
                } ,{},{},{},{},{},{},{},{},{}
        ]

        });

        });
</script>

