@model FGA.Models.Usuario

@{
    ViewBag.Title = "Cambiar contrase\u00f1a";
    if (Ajax.IsThisAjaxRequest())
    {
        Layout = null;
    }
}
<section class="content-header">
    <h1 class="modern-page-title">
        <i class="fa fa-lock" style="color: #0284c7;"></i>
        Seguridad de la Cuenta
        <small>Cambio y actualizaci&oacute;n de contrase&ntilde;a de acceso al sistema</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="@Url.Action("Index", "Modulo", new { id = 8000 })"><i class="fa fa-user-secret"></i> Control de Accesos</a></li>
        <li class="active">Cambiar Contrase&ntilde;a</li>
    </ol>
</section>

@using (Html.BeginForm("ChangePassword", "Usuario", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmUser" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.Id)
    <input type="hidden" name="validPassword" id="validPassword" value="N" />

    <section class="content">
        <div class="row">
            <!-- Columna Izquierda: Tarjeta de Perfil de Usuario -->
            <div class="col-xs-12 col-md-5">
                <div class="modern-profile-card">
                    <div class="modern-card-header">
                        <h3><i class="fa fa-user-circle"></i> Perfil de Usuario</h3>
                    </div>
                    <div class="modern-card-body">
                        <div class="user-profile-hero">
                            <div class="user-avatar-circle">
                                <i class="fa fa-user"></i>
                            </div>
                            <div class="user-name">
                                @(Model != null && !string.IsNullOrEmpty(Model.Nombre) ? Model.Nombre : "Usuario")
                            </div>
                            <div class="user-role-badge">
                                <i class="fa fa-shield"></i>
                                @(Model != null && Model.Role_Usuario != null ? Model.Role_Usuario.Nombre : "Usuario")
                            </div>
                        </div>

                        <div class="profile-details-list">
                            <div class="profile-detail-row">
                                <span class="profile-detail-label"><i class="fa fa-id-card-o"></i> Identificaci&oacute;n</span>
                                <span class="profile-detail-value">@(Model != null ? Model.Identificacion : "-")</span>
                            </div>
                            <div class="profile-detail-row">
                                <span class="profile-detail-label"><i class="fa fa-envelope-o"></i> Correo electr&oacute;nico</span>
                                <span class="profile-detail-value">@(Model != null ? Model.Correo : "-")</span>
                            </div>
                            <div class="profile-detail-row">
                                <span class="profile-detail-label"><i class="fa fa-phone"></i> Tel&eacute;fono</span>
                                <span class="profile-detail-value">@(Model != null ? Model.Telefono : "-")</span>
                            </div>
                            <div class="profile-detail-row">
                                <span class="profile-detail-label"><i class="fa fa-briefcase"></i> Puesto</span>
                                <span class="profile-detail-value">@(Model != null ? Model.Puesto : "-")</span>
                            </div>
                            <div class="profile-detail-row">
                                <span class="profile-detail-label"><i class="fa fa-building-o"></i> Entidad</span>
                                <span class="profile-detail-value">@(Model != null && Model.Entidad_Usuario != null ? Model.Entidad_Usuario.Nombre : "-")</span>
                            </div>
                            <div class="profile-detail-row">
                                <span class="profile-detail-label"><i class="fa fa-check-circle-o"></i> Estado</span>
                                <span class="profile-detail-value">
                                    <span class="file-status-badge status-success">
                                        <i class="fa fa-check-circle"></i> @(Model != null && Model.Estado_Usuario != null ? Model.Estado_Usuario.Nombre : "Activo")
                                    </span>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Columna Derecha: Tarjeta de Cambio de Contrase&ntilde;a -->
            <div class="col-xs-12 col-md-7">
                <div class="modern-password-card">
                    <div class="modern-card-header">
                        <h3><i class="fa fa-lock"></i> Actualizar Contrase&ntilde;a</h3>
                    </div>
                    <div class="modern-card-body">
                        <!-- Mensajes del Servidor -->
                        @if (!string.IsNullOrEmpty(ViewBag.Mensaje))
                        {
                            <div class="alert alert-danger" style="border-radius: 8px; display: flex; align-items: center; gap: 10px; margin-bottom: 20px;">
                                <i class="fa fa-exclamation-triangle" style="font-size: 18px;"></i>
                                <span>@ViewBag.Mensaje</span>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(ViewBag.Exito))
                        {
                            <div class="alert alert-success" style="border-radius: 8px; display: flex; align-items: center; gap: 10px; margin-bottom: 20px;">
                                <i class="fa fa-check-circle" style="font-size: 18px;"></i>
                                <span>@ViewBag.Exito</span>
                            </div>
                        }

                        <!-- Contrase&ntilde;a Actual -->
                        <div class="modern-field-group">
                            <label for="contrasenaActual">
                                <i class="fa fa-lock"></i> Contrase&ntilde;a actual
                            </label>
                            <div class="modern-password-input-group">
                                @Html.Password("contrasenaActual", null, new { @id = "contrasenaActual", @class = "form-control", placeholder = "Ingrese su contrase\u00f1a actual" })
                                <button type="button" class="password-toggle-btn" data-target="contrasenaActual" title="Mostrar/Ocultar contrase&ntilde;a">
                                    <i class="fa fa-eye"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Nueva Contrase&ntilde;a -->
                        <div class="modern-field-group">
                            <label for="contrasenaNueva">
                                <i class="fa fa-key"></i> Nueva contrase&ntilde;a
                            </label>
                            <div class="modern-password-input-group">
                                @Html.Password("contrasenaNueva", null, new { @id = "contrasenaNueva", @class = "form-control", placeholder = "Defina su nueva contrase\u00f1a" })
                                <button type="button" class="password-toggle-btn" data-target="contrasenaNueva" title="Mostrar/Ocultar contrase&ntilde;a">
                                    <i class="fa fa-eye"></i>
                                </button>
                            </div>

                            <!-- Caja de Requisitos de Contrase&ntilde;a en Tiempo Real -->
                            <div class="password-requirements-card">
                                <div class="requirements-title">
                                    <i class="fa fa-shield"></i> La contrase&ntilde;a debe cumplir los siguientes requisitos:
                                </div>
                                <div class="password-requirements-grid">
                                    <div id="length" class="password-requirement-item invalid">
                                        <i class="fa fa-circle-o"></i> <span>M&iacute;nimo <strong>8 caracteres</strong></span>
                                    </div>
                                    <div id="letter" class="password-requirement-item invalid">
                                        <i class="fa fa-circle-o"></i> <span>Al menos <strong>una letra</strong></span>
                                    </div>
                                    <div id="capital" class="password-requirement-item invalid">
                                        <i class="fa fa-circle-o"></i> <span>Al menos <strong>una may&uacute;scula</strong></span>
                                    </div>
                                    <div id="number" class="password-requirement-item invalid">
                                        <i class="fa fa-circle-o"></i> <span>Al menos <strong>un n&uacute;mero</strong></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Confirmar Contrase&ntilde;a -->
                        <div class="modern-field-group">
                            <label for="contrasenaConfirma">
                                <i class="fa fa-shield"></i> Confirmar nueva contrase&ntilde;a
                            </label>
                            <div class="modern-password-input-group">
                                @Html.Password("contrasenaConfirma", null, new { @id = "contrasenaConfirma", @class = "form-control", placeholder = "Confirme su nueva contrase\u00f1a" })
                                <button type="button" class="password-toggle-btn" data-target="contrasenaConfirma" title="Mostrar/Ocultar contrase&ntilde;a">
                                    <i class="fa fa-eye"></i>
                                </button>
                            </div>
                            <div id="passwordMatchMsg" class="password-match-feedback" style="display: none;"></div>
                        </div>

                        <!-- Boton de Envio -->
                        <div style="margin-top: 26px;">
                            <button type="submit" id="btnSubmitPassword" class="btn-modern-submit-password">
                                <i class="fa fa-check-circle"></i> Actualizar contrase&ntilde;a
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

<script type="text/javascript">
    $(document).ready(function () {
        // Toggle ver/ocultar contrase&ntilde;a
        $('.password-toggle-btn').on('click', function () {
            var targetId = $(this).data('target');
            var $input = $('#' + targetId);
            var $icon = $(this).find('i');

            if ($input.attr('type') === 'password') {
                $input.attr('type', 'text');
                $icon.removeClass('fa-eye').addClass('fa-eye-slash');
            } else {
                $input.attr('type', 'password');
                $icon.removeClass('fa-eye-slash').addClass('fa-eye');
            }
        });

        // Validaci&oacute;n dinamica de la nueva contrase&ntilde;a
        $('#contrasenaNueva').on('input keyup', function () {
            var pswd = $(this).val();
            var reglas = 0;

            function updateRule(elementId, isValid) {
                var $el = $('#' + elementId);
                var $icon = $el.find('i');
                if (isValid) {
                    $el.removeClass('invalid').addClass('valid');
                    $icon.removeClass('fa-circle-o fa-times-circle').addClass('fa-check-circle');
                    reglas += 1;
                } else {
                    $el.removeClass('valid').addClass('invalid');
                    $icon.removeClass('fa-check-circle').addClass('fa-circle-o');
                }
            }

            updateRule('length', pswd.length >= 8);
            updateRule('letter', /[a-zA-Z]/.test(pswd));
            updateRule('capital', /[A-Z]/.test(pswd));
            updateRule('number', /\d/.test(pswd));

            if (reglas === 4) {
                $('#validPassword').val('S');
            } else {
                $('#validPassword').val('N');
            }

            checkMatch();
        });

        // Verificacion de coincidencia
        function checkMatch() {
            var nueva = $('#contrasenaNueva').val();
            var confirma = $('#contrasenaConfirma').val();
            var $msg = $('#passwordMatchMsg');

            if (confirma.length === 0) {
                $msg.hide();
                return;
            }

            $msg.show();
            if (nueva.length > 0 && nueva === confirma) {
                $msg.removeClass('mismatch').addClass('match')
                    .html('<i class="fa fa-check-circle"></i> Las contrase&ntilde;as coinciden');
            } else {
                $msg.removeClass('match').addClass('mismatch')
                    .html('<i class="fa fa-times-circle"></i> Las contrase&ntilde;as no coinciden');
            }
        }

        $('#contrasenaConfirma').on('input keyup', checkMatch);
    });
</script>