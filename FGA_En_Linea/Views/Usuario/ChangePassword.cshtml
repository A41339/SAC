@model FGA.Models.Usuario

@{
    ViewBag.Title = "Cambiar contraseña";
    if (Ajax.IsThisAjaxRequest())
    {
        Layout = null;
    }
}
<section class="content-header">
    <h1>
        Cambiar contraseña
    </h1>
</section>

@*@Html.StarkAjaxFormSubmiter("frmUser", "tbUser", true, "Acción realizada con éxito")*@

@using (Html.BeginForm("ChangePassword", "Usuario", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmUser" }))
{
    @Html.AntiForgeryToken()

    <section class="content">
        <div class="row">
            <div class="col-xs-12">
                <div class="box box-solid box-info">
                    <div class="box-body table-responsive">
                        <div class="widget-sec">
                            <div class="streaming-table">
                                <table class="table table-striped table-bordered">
                                    <tr class="hidden">
                                        <td>
                                            @Html.LabelFor(model => model.Id, new { @class = "" })
                                            @Html.EditorFor(model => model.Id)
                                            @Html.Hidden("validPassword", "N", new { @id = "validPassword" })
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Identificación</td>
                                        <td>@Html.DisplayFor(model => model.Identificacion, new { @class = "" })</td>
                                    </tr>
                                    <tr>
                                        <td>Nombre</td>
                                        <td>@Html.DisplayFor(model => model.Nombre, new { @class = "" })</td>
                                    </tr>
                                    <tr>
                                        <td>Teléfono</td>
                                        <td>@Html.DisplayFor(model => model.Telefono, new { @class = "" })</td>
                                    </tr>
                                    <tr>
                                        <td>Puesto</td>
                                        <td>@Html.DisplayFor(model => model.Puesto, new { @class = "" })</td>
                                    </tr>
                                    <tr>
                                        <td>Correo electrónico</td>
                                        <td>@Html.DisplayFor(model => model.Correo, new { @class = "" })</td>
                                    </tr>
                                    <tr>
                                        <td>Entidad</td>
                                        <td>@Html.DisplayFor(model => model.Entidad_Usuario.Nombre, new { @class = "" })</td>
                                    </tr>
                                    <tr>
                                        <td>Estado</td>
                                        <td>@Html.DisplayFor(model => model.Estado_Usuario.Nombre, new { @class = "" })</td>
                                    </tr>
                                    <tr>
                                        <td>Perfil</td>
                                        <td>@Html.DisplayFor(model => model.Role_Usuario.Nombre, new { @class = "" })</td>
                                    </tr>
                                    <tr>
                                        <td>Contraseña actual</td>
                                        <td>
                                            @Html.Password("contrasenaActual", null, new { @id = "contrasenaActual", @class = "form-control" })
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Nueva contraseña</td>
                                        <td>
                                            <span>@Html.Password("contrasenaNueva", null, new { @id = "contrasenaNueva", @class = "form-control" })</span>
                                            <div id="pswd_info">
                                                <h4>La contraseña debe cumplir lo siguiente:</h4>
                                                <ul>
                                                    <li id="letter" class="invalid">Al menos <strong>una letra</strong></li>
                                                    <li id="capital" class="invalid">Al menos <strong>una mayúscula</strong></li>
                                                    <li id="number" class="invalid">Al menos <strong>un número</strong></li>
                                                    <li id="length" class="invalid">Al menos <strong>8 caracteres</strong></li>
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Confirmar contraseña</td>
                                        <td>
                                            @Html.Password("contrasenaConfirma", null, new { @id = "contrasenaConfirma", @class = "form-control" })
                                        </td>
                                    </tr>
                                </table>

                                <div id="btn_guardar" class="box-footer">
                                    <!-- Botón submit dentro del formulario -->
                                    <button type="submit" class="btn btn-primary">
                                        Cambiar contraseña
                                    </button>
                                </div>

                                <!-- Verificación del mensaje de error -->
                                @if (!string.IsNullOrEmpty(ViewBag.Mensaje))
                                {
                                    <div class="alert alert-danger mt-3">
                                        @ViewBag.Mensaje
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(ViewBag.Exito))
                                {
                                    <div class="alert alert-success mt-3">
                                        @ViewBag.Exito
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

<script type="text/javascript">

    $('#contrasenaNueva').keyup(function () {

        var pswd = $(this).val();
        var reglas = 0;

        if (pswd.length < 8) {
            $('#length').removeClass('valid').addClass('invalid');
        }
        else {
            $('#length').removeClass('invalid').addClass('valid');
            reglas += 1;
        }
        if (pswd.match(/[A-z]/)) {
            $('#letter').removeClass('invalid').addClass('valid');
            reglas += 1;
        }
        else {
            $('#letter').removeClass('valid').addClass('invalid');
        }
        if (pswd.match(/[A-Z]/)) {
            $('#capital').removeClass('invalid').addClass('valid');
            reglas += 1;
        }
        else {
            $('#capital').removeClass('valid').addClass('invalid');
        }
        if (pswd.match(/\d/)) {
            $('#number').removeClass('invalid').addClass('valid');
            reglas += 1;
        }
        else {
            $('#number').removeClass('valid').addClass('invalid');
        }

        if (reglas == 4)
            $('#validPassword').val('S');
        else
            $('#validPassword').val('N');
    
    }).focus(function () {
        $('#pswd_info').show();
    }).blur(function () {
        $('#pswd_info').hide();
    });

</script>