@model IEnumerable<Entities.Entities.Procedures.FGA_Consultar_Sessiones_Result>

<div id="dialog"></div>
<table id="tbRole" class="table table-striped table-bordered" style="width: 100%;">
    <thead>
        <tr>
            <th style="width: 70px; text-align: center;"></th>
            <th style="width: 20%; text-align: center;"> Entidad </th>
            <th class="mobile" style="width: 10%; text-align: center;">Periodo</th>
            <th style="width: 14%; text-align: center;"> Usuario carga </th>
            <th style="width: 16%; text-align: center;"> Usuario administrador </th>
            <th class="mobile" style="width: 14%; text-align: center;"> Usuario maestro </th>
            <th class="mobile" style="width: 14%; text-align: center;"> Usuario director </th>
            <th class="mobile" style="width: 12%; text-align: center;"> Total de ingresos </th>
        </tr>
    </thead>
    <tbody style="font-size: 12px;">
        @if (Model != null)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td style="text-align: center; background-color: white;">
                        @Html.HiddenFor(modelItem => item.IDENTIDAD)
                        @{
                            string ruta = Url.Content("~/Content/images/" + @item.NOMBRE + ".jpg");
                            <img width="40" height="40" src="@ruta" />
                        }
                    </td>
                    <td style="text-align: center;">
                        <label>@Html.DisplayFor(modelItem => item.NOMBRE)</label>
                    </td>
                    <td class="mobile" style="text-align: center;">
                        <label>@FGA.Utility.Utilitarios.toUpperFirstLetter(FGA.Utility.Utilitarios.ConvertirAFecha(Session["Fecha"].ToString()).ToString("MMMM-yy"))</label>
                    </td>
                    <td style="text-align: center;">
                        <label>@(item.Usuario_Carga == 0 ? "" : item.Usuario_Carga.Value.ToString())</label>
                    </td>
                    <td style="text-align: center;">
                        <label>@(item.Usuario_Administrador == 0 ? "" : item.Usuario_Administrador.Value.ToString())</label>
                    </td>
                    <td style="text-align: center;">
                        <label>@(item.Usuario_Maestro == 0 ? "" : item.Usuario_Maestro.Value.ToString())</label>
                    </td>
                    <td style="text-align: center;">
                        <label>@(item.Usuario_Director == 0 ? "" : item.Usuario_Director.Value.ToString())</label>
                    </td>
                    <td style="text-align: center;">
                        <label>@item.Total_Ingresos</label>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>