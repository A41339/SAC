@model IEnumerable<Entities.Entities.Procedures.FGA_Consultar_Sessiones_Result>

@{
    ViewBag.Title = "Sesiones";
}

<section class="content">

    @using (Html.BeginForm("Buscar", "Seguridad", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmMatriz" }))
    {
        @Html.AntiForgeryToken()
        <div class="row">
            <div class="col-xs-12">
                <div class="streaming-table">
                    <div class="box box-primary">
                        <div class="box-body">
                            <span id="found" class="label label-info"></span>
                            <table class="table table-condensed table-striped table-bordered" style="padding-left: 10px;">
                                <tr>
                                    <td>
                                        @Html.Label("Fecha:")
                                        <input name="Fecha" id="Fecha" style="width: 100px" class="datecontrol" value="@Session["Fecha"]" />
                                    </td>
                                    <td>
                                        <label class="btn btn-facebook">
                                            Generar<input type="submit" name="submit" style="display: none;">
                                        </label>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-xs-12">
            <div class="box box-solid box-info">
                <div class="box-body table-responsive">
                    <div class="margin">
                        <div class="streaming-table">
                            <span id="found" class="label label-info"></span>
                            <br />
                            <div id="files">
                                @Html.Partial("DetailSession", Model)
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script type="text/javascript">

    function loadPartialView() {
        $.ajax({
            url: '@Url.Action("GetPartial", "Seguridad")',
            type: 'POST',
            cache: false,
            async: true,
            success: function (result) {
                $('#files').html(result);
            }
        });
    }

    function refreshPartial() {
        setTimeout(function () {
            loadPartialView();
            refreshPartial();
        }, 10000);
    }

    refreshPartial();

</script>
