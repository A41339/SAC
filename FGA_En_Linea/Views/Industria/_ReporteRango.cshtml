<div class="nav-tabs-custom" style="border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03); border: 1px solid #e2e8f0; overflow: hidden; background: #ffffff;">
    <ul class="nav nav-tabs" style="border-bottom: 2px solid #e2e8f0; margin-bottom: 20px;">
        <li class="active"><a href="#tab_1" data-toggle="tab" style="font-weight: 700; font-size: 13px; color: #143750; border-radius: 8px 8px 0 0; padding: 10px 18px;"><i class="fa fa-calendar" style="color: #0284c7; margin-right: 6px;"></i> Periodo: @FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo1"].ToString()).ToShortDateString()</a></li>
        <li><a href="#tab_2" data-toggle="tab" style="font-weight: 700; font-size: 13px; color: #143750; border-radius: 8px 8px 0 0; padding: 10px 18px;"><i class="fa fa-calendar-check-o" style="color: #059669; margin-right: 6px;"></i> Periodo @FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo2"].ToString()).ToShortDateString()</a></li>
    </ul>
    <div class="tab-content">
        <div class="tab-pane active" id="tab_1">
            <div class="row">

                @if (Session["TipoReporte"] != null)
                {
                    <iframe src="~/Reportes/ReportView.aspx" width="1500" height="1500" style="border:none"></iframe>
                }
            </div>
        </div>
        <div class="tab-pane" id="tab_2">
            <div class="row">
                <div class="tab-content">
                    @if (Session["TipoReporte2"] != null)
                    {
                        <iframe src="~/Reportes/ReportView2.aspx" width="1500" height="1500" style="border:none"></iframe>
                    }
                </div>
            </div>
        </div>
    </div>
</div>