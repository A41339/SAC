@{
    ViewBag.Title = "Balance del Sistema Financiero";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content-header" style="padding: 24px 20px 14px 20px;">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
        <div>
            <h1 style="margin: 0; font-size: 21px; font-weight: 700; color: #143750; display: flex; align-items: center; gap: 10px;">
                <i class="fa fa-university" style="color: #0284c7;"></i>
                Balance del Sistema Financiero
            </h1>
            <p style="margin: 6px 0 0 0; font-size: 13px; color: #64748b;">
                Descarga y consulta comparativa de balances agregados del sector financiero.
            </p>
        </div>
    </div>
</section>

<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div class="modern-filter-card" style="margin-bottom: 22px;">
                <div class="modern-filter-toolbar">
                    <div class="filter-item">
                        <label for="Periodo1"><i class="fa fa-calendar"></i> Primer Per&iacute;odo:</label>
                        <div class="modern-input-wrapper">
                            <input name="Periodo1" id="Periodo1" class="datecontrol form-control modern-date-input" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo1"].ToString()).ToShortDateString()" style="min-width: 140px; height: 38px;" />
                        </div>
                    </div>
                    <div class="filter-item">
                        <label for="Periodo2"><i class="fa fa-calendar-o"></i> Segundo Per&iacute;odo:</label>
                        <div class="modern-input-wrapper">
                            <input name="Periodo2" id="Periodo2" class="datecontrol form-control modern-date-input" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo2"].ToString()).ToShortDateString()" style="min-width: 140px; height: 38px;" />
                        </div>
                    </div>
                    <div class="filter-item" style="margin-left: auto;">
                        <a id="download" href="javascript:download();" class="btn-modern-filter" style="height: 38px; padding: 0 24px; display: inline-flex; align-items: center; gap: 8px;">
                            <i class="fa fa-file-text-o"></i> Generar informe
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="reportes"></div>
</section>

<script type="text/javascript">
    function getApplicationPath() {
        var path = location.pathname;
        var index = path.indexOf("/Industria");
        if (index > -1)
            return path.substr(0, index + 1);
        if (path.charAt(path.length - 1) != '/')
            path += '/';
        return path;
    }
    function download() {
        var path = getApplicationPath() + "Industria/GetBalance_SF/?periodoI=" + $('#Periodo1').val() + "&periodoF=" + $('#Periodo2').val() ;
        window.location.href = path;
          loadPartialView();
    }

    function loadPartialView() {
        $.ajax({
            url: '@Url.Action("GetPartial", "Industria")',
            type: 'POST',
            cache: false,
            async: true,
            success: function (result) {
                $('#reportes').html(result);
            }
        });
    }

</script>