@{
    ViewBag.Title = "Cartera por Industria";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section ScriptsOrCss
{
    <link rel="stylesheet" href="~/Content/multiselect/docs/css/prettify.min.css" type="text/css">
    <script type="text/javascript" src="~/Content/multiselect/docs/js/prettify.min.js"></script>
    <link rel="stylesheet" href="~/Content/multiselect/dist/css/bootstrap-multiselect.css" type="text/css">
    <script type="text/javascript" src="~/Content/multiselect/dist/js/bootstrap-multiselect.js"></script>
}

<section class="content-header" style="padding: 24px 20px 14px 20px;">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
        <div>
            <h1 style="margin: 0; font-size: 21px; font-weight: 700; color: #143750; display: flex; align-items: center; gap: 10px;">
                <i class="fa fa-industry" style="color: #0284c7;"></i>
                Cartera por Industria
            </h1>
            <p style="margin: 6px 0 0 0; font-size: 13px; color: #64748b;">
                An&aacute;lisis comparativo y gr&aacute;ficos de cartera por sector industrial y per&iacute;odo.
            </p>
        </div>
    </div>
</section>

<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div class="modern-filter-card" style="margin-bottom: 22px;">
                <div class="modern-filter-toolbar">
                    <div class="filter-item">
                        <label for="IdSector"><i class="fa fa-industry"></i> Sector:</label>
                        @Html.DropDownList("Sectores", null, new { @id = "IdSector", @class = "form-control modern-select", style = "min-width: 220px; height: 38px; font-size: 13px;" })
                    </div>
                    <div class="filter-item">
                        <label for="Grafico"><i class="fa fa-bar-chart"></i> Gr&aacute;fico:</label>
                        @Html.DropDownList("Grafico", null, new { @id = "Grafico", @class = "form-control modern-select", style = "min-width: 240px; height: 38px; font-size: 13px;" })
                    </div>
                    <div class="filter-item">
                        <label for="PeriodoI"><i class="fa fa-calendar"></i> Per&iacute;odo:</label>
                        <div class="modern-input-wrapper">
                            <input name="PeriodoI" id="PeriodoI" class="datecontrol form-control modern-date-input" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo1"].ToString()).ToString("MM/yyyy")" style="min-width: 130px; height: 38px;" />
                        </div>
                    </div>
                    <div class="filter-item" style="margin-left: auto;">
                        <button type="button" id="btn_buscar" class="btn-modern-filter" style="height: 38px; padding: 0 24px;">
                            <i class="fa fa-search"></i> Generar informe
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-xs-12">
            <div id="grafica" class="modern-table-card" style="border: 1px solid #e2e8f0; border-radius: 12px; background: #ffffff; box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05); overflow: hidden; padding: 20px; margin-bottom: 24px;">
            </div>
        </div>
    </div>
</section>

<script type="text/javascript">

    $("#IdSector").change(function () {
        $.ajax({
            data: {
                'Sector': $('#IdSector').val()
            },
            type: 'POST',
            cache: false,
            dataType: 'json',
            url: '@Url.Action("GetGraphOptions", "Industria")',
            success: function (result) {                
                $("#Grafico").empty();
                $.each(result, function (i, item) {
                    $("#Grafico").append('<option value="' + item.Value + '">' + item.Text + '</option>');
                });
            }
        });
        event.preventDefault(event);
    });

    function refreshGraph() {
         $.ajax({
            url: '@Url.Action("GraficaDetalle", "Industria")',
            type: 'POST',
            cache: false,
            async: false,
            data: {
                'Sector': $('#IdSector').val(),
                 'Grafico': $('#Grafico').val(),
                 'PeriodoI': $('#PeriodoI').val()
            },
             success: function (result) {
                 $('#grafica').html(result);
                 $("#sector").text($("#Grafico :selected").text() + ': ' + $("#IdSector :selected").text());
            }
         });
    }

    $(document).on('click', '#btn_buscar', function () {
        refreshGraph();
    });

    function formatMillion() {
        $("#sector").text($("#Grafico :selected").text() + ': ' + $("#IdSector :selected").text());
        return this.value;
    }

    function formatPercent() {
        return this.value + " %";
    }

</script>