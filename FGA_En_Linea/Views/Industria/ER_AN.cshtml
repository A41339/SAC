@model FGA.Model.Modelo_SF

@{
    ViewBag.Title = "An&aacute;lisis del Estado de Resultados";
}

<section class="content-header" style="padding: 24px 20px 14px 20px;">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
        <div>
            <h1 style="margin: 0; font-size: 21px; font-weight: 700; color: #143750; display: flex; align-items: center; gap: 10px;">
                <i class="fa fa-bar-chart" style="color: #0284c7;"></i>
                An&aacute;lisis del Estado de Resultados
            </h1>
            <p style="margin: 6px 0 0 0; font-size: 13px; color: #64748b;">
                An&aacute;lisis comparativo, estructura de ingresos y composici&oacute;n de gastos en el sector.
            </p>
        </div>
    </div>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="#">Informaci&oacute;n Financiera</a></li>
        <li class="active">An&aacute;lisis Estado de Resultados</li>
    </ol>
</section>

<section class="content">
    @using (Html.BeginForm("ER_AN", "Industria", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmInforme" }))
    {
        <div class="row">
            <div class="col-xs-12">
                <div class="modern-filter-card" style="margin-bottom: 22px;">
                    <div class="modern-filter-toolbar">
                        <div class="filter-item">
                            <label for="Periodo1"><i class="fa fa-calendar"></i> Per&iacute;odo:</label>
                            <div class="modern-input-wrapper">
                                <input name="Periodo1" id="Periodo1" class="datecontrol form-control modern-date-input" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo1"].ToString()).ToShortDateString()" style="min-width: 140px; height: 38px;" />
                            </div>
                        </div>
                        <div class="filter-item" style="margin-left: auto;">
                            <button type="submit" id="btn_buscar" class="btn-modern-filter" style="height: 38px; padding: 0 24px;">
                                <i class="fa fa-search"></i> Generar informe
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="modern-table-card" style="border: 1px solid #e2e8f0; border-radius: 12px; background: #ffffff; box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05); overflow: hidden; padding: 22px; margin-bottom: 24px;">
        <div class="nav-tabs-custom" style="box-shadow: none; margin-bottom: 0;">
            <ul class="nav nav-tabs" style="border-bottom: 2px solid #e2e8f0; margin-bottom: 20px;">
                <li class="active">
                    <a href="#tab_1" data-toggle="tab" style="font-weight: 700; font-size: 13px; color: #143750; border-radius: 8px 8px 0 0; padding: 10px 18px;">
                        <i class="fa fa-file-text-o" style="color: #0284c7; margin-right: 6px;"></i> An&aacute;lisis del Estado de Resultados
                    </a>
                </li>
                <li>
                    <a href="#tab_2" data-toggle="tab" style="font-weight: 700; font-size: 13px; color: #143750; border-radius: 8px 8px 0 0; padding: 10px 18px;">
                        <i class="fa fa-arrow-up" style="color: #059669; margin-right: 6px;"></i> Ingresos
                    </a>
                </li>
                <li>
                    <a href="#tab_3" data-toggle="tab" style="font-weight: 700; font-size: 13px; color: #143750; border-radius: 8px 8px 0 0; padding: 10px 18px;">
                        <i class="fa fa-arrow-down" style="color: #dc2626; margin-right: 6px;"></i> Gastos
                    </a>
                </li>
            </ul>
            <div class="tab-content" style="padding: 0;">
                <div class="tab-pane active" id="tab_1">
                    @if (Session["TipoReporte"] != null)
                    {
                        <div class="table-responsive" style="border-radius: 8px; overflow: hidden; border: 1px solid #e2e8f0;">
                            <iframe src="~/Reportes/ReportView.aspx" width="100%" height="900" style="border:none; display: block; min-height: 800px;"></iframe>
                        </div>
                    }
                </div>
                <div class="tab-pane" id="tab_2">
                    <div class="row">
                        <div class="col-md-7">
                            <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 18px; padding-bottom: 14px; border-bottom: 1px solid #f1f5f9;">
                                @if (Session["Logo"] != null)
                                {
                                    <img width="44" height="44" src="@Session["Logo"]" style="border-radius: 8px; background: #ffffff; padding: 3px; border: 1px solid #e2e8f0; object-fit: contain;" />
                                }
                                <div>
                                    <h4 style="margin: 0; font-size: 16px; font-weight: 700; color: #143750;">Estructura de Ingresos</h4>
                                    <p style="margin: 2px 0 0 0; font-size: 12px; color: #64748b;">Ingresos por grupo financiero del sistema</p>
                                </div>
                            </div>
                            <span id="found" class="label label-info"></span>
                            <div class="table-responsive" style="margin-bottom: 20px;">
                                <table id="tbIngreso" class="table modern-data-table" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th> Per&iacute;odo </th>
                                            <th> Bancos comerciales del estado </th>
                                            <th> Bancos creados por leyes especiales </th>
                                            <th> Bancos privados y cooperativos </th>
                                            <th> Empresas financieras no bancarias </th>
                                            <th> Otras entidades financieras </th>
                                            <th> Organizaciones cooperativas </th>
                                            <th> Entidades autorizadas nacional vivienda </th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                        <div class="col-md-5">
                            @(Model.gIngresos)
                        </div>
                    </div>
                </div>
                <div class="tab-pane" id="tab_3">
                    <div class="row">
                        <div class="col-md-12">
                            <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 18px; padding-bottom: 14px; border-bottom: 1px solid #f1f5f9;">
                                @if (Session["Logo"] != null)
                                {
                                    <img width="44" height="44" src="@Session["Logo"]" style="border-radius: 8px; background: #ffffff; padding: 3px; border: 1px solid #e2e8f0; object-fit: contain;" />
                                }
                                <div>
                                    <h4 style="margin: 0; font-size: 16px; font-weight: 700; color: #143750;">Composici&oacute;n de Gastos</h4>
                                    <p style="margin: 2px 0 0 0; font-size: 12px; color: #64748b;">Gastos agregados por grupos institucionales</p>
                                </div>
                            </div>
                            <span id="found" class="label label-info"></span>
                            <div class="table-responsive" style="margin-bottom: 20px;">
                                <table id="tbGasto" class="table modern-data-table" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th> Cuenta </th>
                                            <th> Bancos comerciales del estado </th>
                                            <th> Bancos creados por leyes especiales </th>
                                            <th> Bancos privados y cooperativos </th>
                                            <th> Empresas financieras no bancarias </th>
                                            <th> Otras entidades financieras </th>
                                            <th> Organizaciones cooperativas </th>
                                            <th> Entidades autorizadas nacional vivienda </th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                        <div class="col-md-12" style="margin-top: 20px;">
                            @(Model.gGastos)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script type="text/javascript">

    function refreshPage() {
        $.ajax({
            url: '@Url.Action("LoadER_AN", "Industria")',
                type: 'POST',
                cache: false,
                async: false,
                data: {
                    'Periodo': $('#Periodo1').val()
                },
            success: function (result) {
                $('#detail').html(result);
            }
        });
    }

      $(document).on('click', '#btn_buscar', function () {
         refreshPage();
      });

    function formatMillion() {
        return this.value;
    }

    function formatPercent() {
        return this.value + ' %';
    }

    $(document).ready(function () {
        $("#tbIngreso").dataTable({
            "bRetrieve": true,
            "bProcessing": true,
            "dom": 'lBfrtip',
            "sAjaxSource": "@Url.Content("~/Industria/GetGridIngreso")",
            "buttons": [
                { extend: 'copyHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'excelHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'csvHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'print', exportOptions: { columns: ':visible' } },
                'colvis'
            ],
            "columnDefs": [
                { "targets": 0, "className": 'text-left font-weight-bold' },
                { "targets": [1, 2, 3, 4, 5, 6, 7], "className": 'text-right', "width": '120px' }
            ],
            "pageLength": -1,
            "order": [[ 0, "asc" ]],
            "lengthMenu": [[5, 15, 25, 50, -1], [5, 15, 25, 50, "Todos"]],
            "autoWidth": false
        });

        $("#tbGasto").dataTable({
            "bRetrieve": true,
            "bProcessing": true,
            "dom": 'lBfrtip',
            "sAjaxSource": "@Url.Content("~/Industria/GetGridGasto")",
            "buttons": [
                { extend: 'copyHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'excelHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'csvHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'print', exportOptions: { columns: ':visible' } },
                'colvis'
            ],
            "columnDefs": [
                { "targets": 0, "className": 'text-left font-weight-bold' },
                { "targets": [1, 2, 3, 4, 5, 6, 7], "className": 'text-right', "width": '120px' }
            ],
            "pageLength": -1,
            "order": [[ 0, "asc" ]],
            "lengthMenu": [[5, 15, 25, 50, -1], [5, 15, 25, 50, "Todos"]],
            "autoWidth": false
        });

        $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
            $.fn.dataTable.tables({ visible: true, api: true }).columns.adjust();
        });
    });
</script>
