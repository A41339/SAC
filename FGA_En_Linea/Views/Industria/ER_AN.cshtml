@model FGA.Model.Modelo_SF

@{
    ViewBag.Title = "Análisis del estado de resultados";
}

<section class="content">
    <section class="content-header">
        <h1>
            Análisis del estado de resultados
        </h1>
    </section>
    @using (Html.BeginForm("ER_AN", "Industria", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmInforme" }))
    {
        <div class="box box-solid box-info">
            <div class="box-body table-responsive">
                <div class="margin">
                    <div class="streaming-table">
                        <span id="found" class="label label-info"></span>
                        <table class="table table-condensed table-striped table-bordered">
                            <tr>
                                <td class="mobile">
                                    @Html.Label("Periodo:")
                                </td>
                                <td nowrap="nowrap">
                                    <input name="Periodo1" id="Periodo1" class="datecontrol" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo1"].ToString()).ToShortDateString()" />
                                </td>
                                <td>
                                    <label>
                                        <button type="submit" id="btn_buscar" class="btn btn-primary">Generar</button>
                                    </label>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }


    <div class="nav-tabs-custom">
        <ul class="nav nav-tabs">
            <li class="active"><a href="#tab_1" data-toggle="tab">Análisis del estado de resultados</a></li>
            <li><a href="#tab_2" data-toggle="tab">Ingresos</a></li>
            <li><a href="#tab_3" data-toggle="tab">Gastos</a></li>
        </ul>
        <div class="tab-content">
            <div class="tab-pane active" id="tab_1">
                <div class="row">

                    @if (Session["TipoReporte"] != null)
                    {
                        <iframe src="~/Reportes/ReportView.aspx" width="1500" height="1500" style="border:none"></iframe>
                    }
                </div>
            </div>
            <div class="tab-pane" id="tab_2">
                <div class="row">
                    <div class="col-sm-12">
                        <section class="content">
                            <div class="row">
                                <div class="col-md-7">
                                    <div class="streaming-table">
                                        <span id="found" class="label label-info"></span>
                                        <table id="tbIngreso" class="table table-striped table-bordered" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th> @Html.Label("Periodo")  </th>
                                                    <th> @Html.Label("Bancos comerciales del estado")  </th>
                                                    <th> @Html.Label("Bancos creados por leyes especiales") </th>
                                                    <th> @Html.Label("Bancos privados y cooperativos") </th>
                                                    <th> @Html.Label("Empresas financieras no bancarias") </th>
                                                    <th> @Html.Label("Otras entidades financieras") </th>
                                                    <th> @Html.Label("Organizaciones cooperativas") </th>
                                                    <th> @Html.Label("Entidades autorizadas nacional vivienda") </th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                                <div class="col-sm-5">
                                    @(Model.gIngresos)
                                </div>
                            </div>
                        </section>
                    </div>
                </div>
            </div>
            <br />
            <div class="tab-pane" id="tab_3">
                <div class="row">
                    <div class="col-sm-12">
                        <section class="content">
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="streaming-table">
                                        <span id="found" class="label label-info"></span>
                                        <table id="tbGasto" class="table table-striped table-bordered" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th><img width="50" height="50" src="@Session["Logo"]" /></th>
                                                </tr>
                                                <tr>
                                                    <th> @Html.Label("")  </th>
                                                    <th> @Html.Label("Bancos comerciales del estado")  </th>
                                                    <th> @Html.Label("Bancos creados por leyes especiales") </th>
                                                    <th> @Html.Label("Bancos privados y cooperativos") </th>
                                                    <th> @Html.Label("Empresas financieras no bancarias") </th>
                                                    <th> @Html.Label("Otras entidades financieras") </th>
                                                    <th> @Html.Label("Organizaciones cooperativas") </th>
                                                    <th> @Html.Label("Entidades autorizadas nacional vivienda") </th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                                <br />
                                <div class="col-sm-12">
                                    @(Model.gGastos)
                                </div>
                            </div>
                        </section>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script type="text/javascript">

    function refreshPage() {
        $.ajax({
            url: '@Url.Action("LoadER_AN", "Industria")',
                type: 'POST',
                cache: false,
                async: false,
                data: {
                    'Periodo': $('#Periodo1').val()
                },
            success: function (result) {
                $('#detail').html(result);
            }
        });
    }

      $(document).on('click', '#btn_buscar', function () {
         refreshPage();
      });

    function formatMillion() {
        return this.value;
    }

    function formatPercent() {
        return this.value + ' %';
    }

        $(document).ready(function () {
        var oTableRole = "";
        var ControlerNameRole = "@Url.Content("~/Industria")";
        // debugger;
        oTableRole = $("#tbIngreso").dataTable({
            "bRetrieve": true,
            "bProcessing": true,
            "dom": 'lBfrtip',
            "sAjaxSource": "@Url.Content("~/Industria/GetGridIngreso")",
            "buttons": [
                    { extend: 'copyHtml5', exportOptions: { columns: ':visible' } }
                ,{ extend: 'excelHtml5', exportOptions: { columns: ':visible' } }
                ,{ extend: 'csvHtml5', exportOptions: { columns: ':visible' } }
                ,{ extend: 'print', exportOptions: { columns: ':visible' } }
                ,'colvis'
            ],
            columnDefs: [
                {
                    className: 'text-right', targets: [2, 3],
                    width: '150px', targets: [2, 3]},
            ],
            "pageLength": -1,
                "order": [[ 0, "asc" ]],
            "lengthMenu": [[5,15, 25, 50, -1], [5,15, 25, 50, "Todos"]],
                "aoColumns": [
                        {}, {}, {}, {}, {}, {}, {}, {}
            ]
        });

        oTableRole = $("#tbGasto").dataTable({
            "bRetrieve": true,
            "bProcessing": true,
            "dom": 'lBfrtip',
            "sAjaxSource": "@Url.Content("~/Industria/GetGridGasto")",
            "buttons": [
                    { extend: 'copyHtml5', exportOptions: { columns: ':visible' } }
                ,{ extend: 'excelHtml5', exportOptions: { columns: ':visible' } }
                ,{ extend: 'csvHtml5', exportOptions: { columns: ':visible' } }
                ,{ extend: 'print', exportOptions: { columns: ':visible' } }
                ,'colvis'
            ],
            columnDefs: [
                {
                    className: 'text-right', targets: [2, 3],
                    width: '150px', targets: [2, 3]},
            ],
            "pageLength": -1,
                "order": [[ 0, "asc" ]],
            "lengthMenu": [[5,15, 25, 50, -1], [5,15, 25, 50, "Todos"]],
                "aoColumns": [
                    {}, {}, {}, {}, {}, {}, {}, {}
                ]
        });
    });
</script>
