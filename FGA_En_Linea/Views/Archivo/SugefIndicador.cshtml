@model IEnumerable<Entities.Entities.Procedures.FGA_Consultar_ArchivosCargados_Result>

@{
    ViewBag.Title = "Indicadores Sugef";
    if (Ajax.IsThisAjaxRequest())
    {
        Layout = null;
    }
}

<script src="~/Scripts/jquery-form.js"></script>
@if (!Ajax.IsThisAjaxRequest())
{
    <section class="content-header">
        <h1>
            <i class="fa fa-line-chart"></i> SUGEF - Indicadores
            <small>Carga y validaci&oacute;n de indicadores y razones financieras SUGEF.</small>
        </h1>
        <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="#">Carga de Datos</a></li>
        <li class="active">Indicadores SUGEF</li>
    </ol>
</section>
}
<section class="content contenedor">

    @using (Html.BeginForm("SugefIndicador", "Archivo", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmFile" }))
    {
        @Html.AntiForgeryToken()
        <div class="modern-upload-card">
            <div class="modern-upload-header">
                <div class="modern-upload-title-box">
                    <div class="upload-icon-circle">
                        <i class="fa fa-file-excel-o"></i>
                    </div>
                    <div>
                        <h4 class="modern-upload-title">Carga de Archivo SUGEF - Indicador</h4>
                        <p class="modern-upload-subtitle">Seleccione el archivo Excel (.xls, .xlsx) correspondiente</p>
                    </div>
                </div>
            </div>

            <div class="modern-upload-body">
                <div class="modern-upload-controls">
                    <label class="btn-modern-browse" for="xlsFileInput">
                        <i class="fa fa-folder-open"></i>
                        <span>Examinar&hellip;</span>
                        <input type="file" name="xlsFile" id="xlsFileInput" accept=".xls,.xlsx" style="display: none;">
                    </label>

                    <div class="modern-file-pill" id="filePill">
                        <i class="fa fa-file-excel-o file-pill-icon"></i>
                        <span class="file-pill-name">Ning&uacute;n archivo seleccionado</span>
                    </div>

                    <button type="submit" class="btn-modern-upload" id="btnUploadSubmit" disabled>
                        <i class="fa fa-cloud-upload"></i>
                        <span>Cargar</span>
                    </button>
                </div>

                <div class="modern-upload-progress" id="uploadProgressWrapper" style="display: none;">
                    <div class="progress-info">
                        <span class="progress-label"><i class="fa fa-spinner fa-spin"></i> Subiendo archivo al servidor...</span>
                        <span class="percent">0%</span>
                    </div>
                    <div class="progress modern-progress-track">
                        <div class="progress-bar modern-progress-bar" role="progressbar" style="width: 0%;"></div>
                    </div>
                </div>

                <div id="status" class="modern-upload-status"></div>
            </div>
        </div>
    }
    
    <div id="files">
        @Html.Partial("FileSugefIndicador", Model)
    </div>
</section>

<script>
    (function () {
        var bar = $('.progress-bar');
        var percent = $('.percent');
        var status = $('#status');
        var fileInput = $('#xlsFileInput');
        var filePill = $('#filePill');
        var fileNameSpan = $('#filePill .file-pill-name');
        var submitBtn = $('#btnUploadSubmit');
        var progressWrapper = $('#uploadProgressWrapper');

        fileInput.on('change', function () {
            var fullPath = $(this).val();
            var fileName = fullPath.split('\\').pop().split('/').pop();
            if (fileName && fileName.trim() !== '') {
                fileNameSpan.text(fileName);
                filePill.addClass('has-file');
                submitBtn.prop('disabled', false);
            } else {
                fileNameSpan.html('Ning&uacute;n archivo seleccionado');
                filePill.removeClass('has-file');
                submitBtn.prop('disabled', true);
            }
        });

        $('form').ajaxForm({
            beforeSend: function () {
                status.empty();
                var percentVal = '0%';
                bar.width(percentVal);
                percent.html(percentVal);
                progressWrapper.slideDown(200);
                submitBtn.prop('disabled', true);
            },
            uploadProgress: function (event, position, total, percentComplete) {
                var percentVal = percentComplete + '%';
                bar.width(percentVal);
                percent.html(percentVal);
            },
            success: function () {
                var percentVal = '100%';
                bar.width(percentVal);
                percent.html(percentVal);
            },
            complete: function (xhr) {
                if (xhr.responseText == '') {
                    status.html('<div class="alert alert-success" style="margin-top: 14px; padding: 10px 16px; border-radius: 8px; font-weight: 500;"><i class="fa fa-check-circle" style="margin-right: 6px;"></i> Archivo procesado exitosamente.</div>');
                    loadPartialView();

                    setTimeout(function () {
                        progressWrapper.slideUp(300);
                        fileInput.val('');
                        fileNameSpan.html('Ning&uacute;n archivo seleccionado');
                        filePill.removeClass('has-file');
                        submitBtn.prop('disabled', true);
                    }, 2500);
                } else {
                    progressWrapper.slideUp(300);
                    submitBtn.prop('disabled', false);
                    status.html('<div class="alert alert-danger" style="margin-top: 14px; padding: 10px 16px; border-radius: 8px; font-weight: 500;"><i class="fa fa-exclamation-circle" style="margin-right: 6px;"></i> ' + xhr.responseText + '</div>');
                }
            }
        });
    })();

    function loadPartialView() {
        $.ajax({
            url: '@Url.Action("GetSUGEFIndicador", "Archivo")',
            type: 'POST',
            cache: false,
            async: true,
            success: function (result) {
                $('#files').html(result);
            }
        });
    }

    function refreshPartial() {
        setTimeout(function () {
            loadPartialView();
            refreshPartial();
        }, 10000);
    }

    refreshPartial();

</script>
