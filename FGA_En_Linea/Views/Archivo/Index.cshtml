@model IEnumerable<Entities.Entities.Procedures.FGA_Consultar_ArchivosCargados_Result>

@{
    ViewBag.Title = "Carga de Archivos";
    if (Ajax.IsThisAjaxRequest())
    {
        Layout = null;
    }
}

<style>
    .modal-body svg {
        width: 50px;
        height: 50px;
    }
</style>

<script src="~/Scripts/jquery-form.js"></script>
@if (!Ajax.IsThisAjaxRequest())
{
    <section class="content-header">
        <h1>
            <i class="fa fa-cloud-upload"></i> Carga de Archivos XML
            <small>Carga, procesamiento y validaci&oacute;n de estados financieros en formato XML.</small>
        </h1>
    </section>
}
<section class="content contenedor">

    @using (Html.BeginForm("Index", "Archivo", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmFile" }))
    {
        @Html.AntiForgeryToken()
        <div class="modern-upload-card">
            <div class="modern-upload-header">
                <div class="modern-upload-title-box">
                    <div class="upload-icon-circle">
                        <i class="fa fa-cloud-upload"></i>
                    </div>
                    <div>
                        <h4 class="modern-upload-title">Carga de Archivos XML</h4>
                        <p class="modern-upload-subtitle">Seleccione el archivo XML correspondiente al periodo activo</p>
                    </div>
                </div>
                <div>
                    <a href="javascript:void(0)" class="btn-help-circle" onclick="document.getElementById('light').style.display='block';document.getElementById('fade').style.display='block'" title="Ver lista de archivos XML requeridos">
                        <i class="fa fa-question"></i>
                    </a>
                </div>
            </div>

            <div class="modern-upload-body">
                <div class="modern-upload-controls">
                    <label class="btn-modern-browse" for="xmlFileInput">
                        <i class="fa fa-folder-open"></i>
                        <span>Examinar&hellip;</span>
                        <input type="file" name="file" id="xmlFileInput" accept=".xml" style="display: none;">
                    </label>

                    <div class="modern-file-pill" id="filePill">
                        <i class="fa fa-file-code-o file-pill-icon"></i>
                        <span class="file-pill-name">Ning&uacute;n archivo seleccionado</span>
                    </div>

                    <button type="submit" class="btn-modern-upload" id="btnUploadSubmit" disabled>
                        <i class="fa fa-cloud-upload"></i>
                        <span>Cargar</span>
                    </button>
                </div>

                <div class="modern-upload-progress" id="uploadProgressWrapper" style="display: none;">
                    <div class="progress-info">
                        <span class="progress-label"><i class="fa fa-spinner fa-spin"></i> Subiendo archivo al servidor...</span>
                        <span class="percent">0%</span>
                    </div>
                    <div class="progress modern-progress-track">
                        <div class="progress-bar modern-progress-bar" role="progressbar" style="width: 0%;"></div>
                    </div>
                </div>

                <div id="status" class="modern-upload-status"></div>
            </div>
        </div>
    }

    <div id="files">
        @Html.Partial("File", Model)
    </div>
    <div id="fade" class="overlay" onclick="document.getElementById('light').style.display='none';document.getElementById('fade').style.display='none'"></div>
    <div id="light">
        <div class="content">
            <div class="header">
                <h4 class="modal-title" id="h_titulo">Archivos XML que deben cargarse</h4>
            </div>
            <div>
                <br />
                <ul>
                    @foreach (FGA.Models.TipoXML xml in ViewBag.TiposXML)
                    {
                        <li>
                            @xml.Nombre
                        </li>
                    }
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" onclick="document.getElementById('light').style.display = 'none'; document.getElementById('fade').style.display = 'none';" class="btn btn-facebook" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</section>
<div class="modal fade" id="error_tic" tabindex="-1" aria-labelledby="errorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center p-lg-4">
                <svg version="1.1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 130.2 130.2" style="width:100px; height:100px">
                    <circle class="path circle" fill="none" stroke="#db3646" stroke-width="6" stroke-miterlimit="10" cx="65.1" cy="65.1" r="62.1" />
                    <line class="path line" fill="none" stroke="#db3646" stroke-width="6" stroke-linecap="round" stroke-miterlimit="10" x1="34.4" y1="37.9" x2="95.8" y2="92.3" />
                    <line class="path line" fill="none" stroke="#db3646" stroke-width="6" stroke-linecap="round" stroke-miterlimit="10" x1="95.8" y1="38" x2="34.4" y2="92.2" />
                </svg>
                <h4 id="txt_error" class="text-danger mt-3"></h4>
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger" data-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="success_tic" tabindex="-1" aria-labelledby="successModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center p-lg-4">
                <svg version="1.1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 130.2 130.2" style="width:100px; height:100px">
                    <circle class="path circle" fill="none" stroke="#198754" stroke-width="6" stroke-miterlimit="10" cx="65.1" cy="65.1" r="62.1" />
                    <polyline class="path check" fill="none" stroke="#198754" stroke-width="6" stroke-linecap="round" stroke-miterlimit="10" points="100.2,40.2 51.5,88.8 29.8,67.5 " />
                </svg>
                <h4 style="margin-top:5px;">La carga ha sido aceptada, se iniciará con la carga de los archivos</h4>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm mt-3 btn-success" data-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var bar = $('.progress-bar');
        var percent = $('.percent');
        var status = $('#status');
        var fileInput = $('#xmlFileInput');
        var filePill = $('#filePill');
        var fileNameSpan = $('#filePill .file-pill-name');
        var submitBtn = $('#btnUploadSubmit');
        var progressWrapper = $('#uploadProgressWrapper');

        fileInput.on('change', function () {
            var fullPath = $(this).val();
            var fileName = fullPath.split('\\').pop().split('/').pop();
            if (fileName && fileName.trim() !== '') {
                fileNameSpan.text(fileName);
                filePill.addClass('has-file');
                submitBtn.prop('disabled', false);
            } else {
                fileNameSpan.html('Ning&uacute;n archivo seleccionado');
                filePill.removeClass('has-file');
                submitBtn.prop('disabled', true);
            }
        });

        $('form').ajaxForm({
            beforeSend: function () {
                status.empty();
                var percentVal = '0%';
                bar.width(percentVal);
                percent.html(percentVal);
                progressWrapper.slideDown(200);
                submitBtn.prop('disabled', true);
            },
            uploadProgress: function (event, position, total, percentComplete) {
                var percentVal = percentComplete + '%';
                bar.width(percentVal);
                percent.html(percentVal);
            },
            complete: function (xhr) {
                if (xhr.responseText === '') {
                    $('#success_tic').modal('show');
                    status.html('<div class="alert alert-success" style="margin-top: 14px; padding: 10px 16px; border-radius: 8px; font-weight: 500;"><i class="fa fa-check-circle" style="margin-right: 6px;"></i> La carga ha sido aceptada, se iniciar&aacute; con el procesamiento de los archivos.</div>');
                    loadPartialView();

                    var percentVal = '100%';
                    bar.width(percentVal);
                    percent.html(percentVal);

                    setTimeout(function () {
                        progressWrapper.slideUp(300);
                        fileInput.val('');
                        fileNameSpan.html('Ning&uacute;n archivo seleccionado');
                        filePill.removeClass('has-file');
                        submitBtn.prop('disabled', true);
                    }, 2500);
                }
                else {
                    var percentVal = '0%';
                    bar.width(percentVal);
                    percent.html(percentVal);
                    progressWrapper.slideUp(300);
                    submitBtn.prop('disabled', false);

                    $('#txt_error').html(xhr.responseText);
                    $('#error_tic').modal('show');
                    status.html('<div class="alert alert-danger" style="margin-top: 14px; padding: 10px 16px; border-radius: 8px; font-weight: 500;"><i class="fa fa-exclamation-circle" style="margin-right: 6px;"></i> ' + xhr.responseText + '</div>');
                }
            }
        });
    })();

    function loadPartialView() {
        $.ajax({
            url: '@Url.Action("GetPartial", "Archivo")',
            type: 'POST',
            cache: false,
            async: true,
            success: function (result) {
                $('#files').html(result);
            }
        });
    }

    function refreshPartial() {
        setTimeout(function () {
            loadPartialView();
            refreshPartial();
        }, 10000);
    }

    refreshPartial();

</script>
