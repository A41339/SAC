@model IEnumerable<Entities.Entities.Procedures.FGA_Consultar_ArchivosCargados_Result>

<style>
    #tbFiles th:nth-child(n+2),
    #tbFiles td:nth-child(n+2) {
        text-align: center !important;
    }
</style>

<div class="row" style="margin-top: 18px;">
    <div class="col-xs-12">
        <div class="modern-table-card">
            <!-- Header de la tarjeta -->
            <div style="padding: 16px 22px; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; background: #ffffff;">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <div style="width: 36px; height: 36px; border-radius: 8px; background: #e0f2fe; display: flex; align-items: center; justify-content: center; color: #0284c7;">
                        <i class="fa fa-calendar-check-o" style="font-size: 16px;"></i>
                    </div>
                    <div>
                        <h4 style="margin: 0; font-size: 15px; font-weight: 700; color: #0f172a;">
                            Registro de Archivos Cargados
                        </h4>
                        <p style="margin: 2px 0 0 0; font-size: 12px; color: #64748b;">
                            Per&iacute;odo contable: <strong style="color: #0284c7;">@Session["PeriodoCarga"].ToString().Replace("_", " ")</strong>
                        </p>
                    </div>
                </div>
                <span id="found" class="label label-info" style="font-size: 11px; padding: 5px 10px; border-radius: 9999px;"></span>
            </div>

            <!-- Cuerpo con la tabla -->
            <div class="table-responsive" style="padding: 0;">
                <table id="tbFiles" class="table" style="width: 100%; margin-bottom: 0;">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 2px solid #e2e8f0;">
                            <th style="padding: 12px 16px; font-size: 12px; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: .03em;">Archivo XML</th>
                            <th style="padding: 12px 16px; font-size: 12px; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: .03em; text-align: center;" class="mobile">Per&iacute;odo</th>
                            <th style="padding: 12px 16px; font-size: 12px; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: .03em; text-align: center;">Estado</th>
                            <th style="padding: 12px 16px; font-size: 12px; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: .03em; text-align: center;" class="mobile">Usuario Responsable</th>
                            <th style="padding: 12px 16px; font-size: 12px; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: .03em; text-align: center;" class="mobile">Fecha de Carga</th>
                            <th style="padding: 12px 16px; font-size: 12px; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: .03em; text-align: center;" class="mobile">Registros</th>
                            <th style="padding: 12px 16px; font-size: 12px; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: .03em; text-align: center;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody style="font-size: 13px;">
                        @if (Model != null)
                        {
                            foreach (var item in Model)
                            {
                                <tr style="border-bottom: 1px solid #f1f5f9; transition: background 0.15s ease;">
                                    <td style="padding: 12px 16px; vertical-align: middle;">
                                        @Html.HiddenFor(modelItem => item.ID_ENCABEZADO)
                                        <div style="display: flex; align-items: center; gap: 8px;">
                                            <i class="fa fa-file-code-o" style="color: #0284c7; font-size: 15px;"></i>
                                            <span style="font-weight: 600; color: #1e293b;">@Html.DisplayFor(modelItem => item.NOMBRE_XML)</span>
                                        </div>
                                    </td>
                                    <td class="mobile" style="padding: 12px 16px; text-align: center; vertical-align: middle; color: #64748b;">
                                        @Html.DisplayFor(modelItem => item.PERIODO)
                                    </td>
                                    <td style="padding: 12px 16px; text-align: center; vertical-align: middle;">
                                        @if (item.XML_ID == FGA.Utility.Utilitarios.archivoCargado)
                                        {
                                            <span class="file-status-badge status-processing"><i class="fa fa-refresh fa-spin"></i> Procesando</span>
                                        }
                                        else if (item.XML_ID == FGA.Utility.Utilitarios.archivoAceptado)
                                        {
                                            <span class="file-status-badge status-success"><i class="fa fa-check-circle"></i> Aceptado</span>
                                        }
                                        else if (item.XML_ID == FGA.Utility.Utilitarios.archivoPendiente)
                                        {
                                            <span class="file-status-badge status-pending"><i class="fa fa-clock-o"></i> Pendiente</span>
                                        }
                                        else
                                        {
                                            <span class="file-status-badge status-error"><i class="fa fa-times-circle"></i> Con Errores</span>
                                        }
                                    </td>
                                    <td class="mobile" style="padding: 12px 16px; text-align: center; vertical-align: middle; color: #475569; font-weight: 500;">
                                        @Html.DisplayFor(modelItem => item.USUARIO)
                                    </td>
                                    <td class="mobile" style="padding: 12px 16px; text-align: center; vertical-align: middle; color: #64748b;">
                                        @if (item.XML_ID == FGA.Utility.Utilitarios.archivoPendiente)
                                        {
                                            <span style="color: #94a3b8; font-style: italic;">Pendiente</span>
                                        }
                                        else
                                        {
                                            @Html.DisplayFor(modelItem => item.FECHACARGA)
                                        }
                                    </td>
                                    <td class="mobile" style="padding: 12px 16px; text-align: center; vertical-align: middle; font-weight: 600; color: #334155;">
                                        @if (item.XML_ID == FGA.Utility.Utilitarios.archivoAceptado && item.CANTIDAD == 0)
                                        {
                                            <span style="color: #94a3b8; font-weight: 400;">No Aplica</span>
                                        }
                                        else
                                        {
                                            @Html.DisplayFor(modelItem => item.CANTIDAD)
                                        }
                                    </td>
                                    <td style="padding: 12px 16px; text-align: center; vertical-align: middle;">
                                        @if (item.XML_ID == FGA.Utility.Utilitarios.archivoErrores)
                                        {
                                            <a href="@Url.Action("Details", "Archivo", new { id = item.ID_ENCABEZADO })" class="btn btn-xs btn-danger" style="border-radius: 6px; padding: 5px 12px; font-weight: 600; display: inline-flex; align-items: center; gap: 5px; box-shadow: 0 2px 4px rgba(225, 29, 72, 0.2);">
                                                <i class="fa fa-exclamation-triangle"></i> Ver Errores
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>