@model FGA.Model.Modelo_PMatriz

@{
    ViewBag.Title = "Supuestos de Proyecci&oacute;n de Mora";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content-header">
    <h1>
        Supuestos de Proyecci&oacute;n de Mora
    </h1>
</section>

<section class="content">
    <div>
        <div class="nav-tabs-custom">
            <ul class="nav nav-tabs">
                <li class="@(Model.Buscar ? "" : "active")"><a href="#tab_1" data-toggle="tab">Supuestos</a></li>
                <li @(Model.Buscar ? "class=active" : "class=hidden")><a href="#tab_2" data-toggle="tab">Proyecci&oacute;n</a></li>
            </ul>
            <div class="tab-content">
                <div class="tab-pane @(Model.Buscar ? "" : "active")" id="tab_1">

                    @using (Html.BeginForm("Buscar", "ProyeccionMatriz", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmMatriz" }))
                    {
                        @Html.AntiForgeryToken()
                        <div class="row">
                            <div class="col-xs-12">
                                <div class="modern-filter-card">
                                    <div class="modern-filter-toolbar">
                                        <div class="filter-item">
                                            <label for="IdEntidad"><i class="fa fa-university"></i> Entidad:</label>
                                            @Html.DropDownList("Entidades", null, new { @id = "IdEntidad", @class = "form-control modern-select", style = "min-width: 200px;" })
                                        </div>
                                        <div class="filter-item">
                                            <label for="cmb_tipoTasa"><i class="fa fa-line-chart"></i> Crecimiento:</label>
                                            <div style="display: inline-flex; align-items: center; gap: 6px;">
                                                <select name="cmb_tipoTasa" id="cmb_tipoTasa" class="form-control modern-select" style="min-width: 170px">
                                                    <option id="1" value="0" @(Session["TipoTasa"].ToString() == "0" ? "selected" : "")>Crecimiento sugerido</option>
                                                    <option id="2" value="1" @(Session["TipoTasa"].ToString() == "1" ? "selected" : "")>Espec&iacute;fica mensual</option>
                                                    <option id="3" value="12" @(Session["TipoTasa"].ToString() == "12" ? "selected" : "")>Espec&iacute;fica anual</option>
                                                </select>
                                                <a class="text-right" data-toggle="tooltip" data-placement="top" title="Ayuda"
                                                   href="javascript:help('Tasa', 'Puede elegir entre las siguientes tres opciones: <br/><br/> a) Crecimiento sugerido: est&aacute; dado de acuerdo con los per&iacute;odos hist&oacute;ricos y el c&aacute;lculo interno de FGA. No podr&aacute; ser modificado. <br/><br/> b) Tasa especifica se puede incluir de forma manual ya sea una tasa anual o mensual, debe escoger en la seguilla de al lado el tipo mensual o anual.<br/><br/> c) Tasa por estacionalidad: se incluye en forma manual una tasa de crecimiento para cada mes proyectado')"><i class="btn btn-xs btn-default icon fa fa-question"></i></a>
                                            </div>
                                        </div>
                                        <div class="filter-item">
                                            <label for="Tasa"><i class="fa fa-percent"></i> Tasa:</label>
                                            <input name="Tasa" type="text" @(Session["TipoTasa"].ToString() == "0" ? "readonly=\"readonly\"" : "") id="Tasa" class="form-control" value="@(Model is null ? "0": Model.TasaCrecimiento.ToString())" style="min-width: 90px; height: 38px;" />
                                        </div>
                                        <div class="filter-item">
                                            <label for="PeriodoActual"><i class="fa fa-calendar"></i> Periodo actual:</label>
                                            <div class="modern-input-wrapper">
                                                <input name="PeriodoActual" id="PeriodoActual" class="datecontrol form-control modern-date-input" value="@Session["PeriodoActual"]" style="min-width: 130px;" />
                                            </div>
                                        </div>
                                        <div class="filter-item">
                                            <label for="PeriodoEstimar"><i class="fa fa-calendar-plus-o"></i> Meses a proyectar:</label>
                                            <div style="display: inline-flex; align-items: center; gap: 6px;">
                                                <input name="PeriodoEstimar" type="number" id="PeriodoEstimar" class="form-control" value="@Session["PeriodoEstimar"]" style="min-width: 90px; height: 38px;" />
                                                <a class="text-right" data-toggle="tooltip" data-placement="top" title="Ayuda"
                                                   href="javascript:help('Meses por proyectar', 'En este cuadro se elige la cantidad de meses a proyectar de la cartera de cr&eacute;dito, tomando como base el &uacute;ltimo mes cargado')"><i class="btn btn-xs btn-default icon fa fa-question"></i></a>
                                            </div>
                                        </div>
                                        <div class="filter-item">
                                            <label for="PeriodoCrecimiento"><i class="fa fa-history"></i> Periodos hist.:</label>
                                            <div style="display: inline-flex; align-items: center; gap: 6px;">
                                                <input name="PeriodoCrecimiento" type="number" id="PeriodoCrecimiento" class="form-control" value="@Session["PeriodoCrecimiento"]" style="min-width: 90px; height: 38px;" />
                                                <a class="text-right" data-toggle="tooltip" data-placement="top" title="Ayuda"
                                                   href="javascript:help('Periodos hist&oacute;ricos', 'El n&uacute;mero a elegir ser&aacute; la cantidad de meses hist&oacute;ricos que se tomar&aacute;n como base para la proyecci&oacute;n de la cartera de cr&eacute;dito, considerar que el m&iacute;nimo son 12 meses')"><i class="btn btn-xs btn-default icon fa fa-question"></i></a>
                                            </div>
                                        </div>
                                        <div class="filter-item">
                                            <label for="PeriodoI"><i class="fa fa-calendar"></i> Periodo inicial:</label>
                                            <div style="display: inline-flex; align-items: center; gap: 6px;">
                                                <div class="modern-input-wrapper">
                                                    <input name="PeriodoI" id="PeriodoI" class="datecontrol form-control modern-date-input" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["PeriodoI"].ToString()).ToString("MM/yyyy")" style="min-width: 130px;" />
                                                </div>
                                                <a class="text-right" data-toggle="tooltip" data-placement="top" title="Ayuda"
                                                   href="javascript:help('Periodo inicial', 'El m&iacute;nimo de meses hist&oacute;ricos que se deben de tomar son 12 meses')"><i class="btn btn-xs btn-default icon fa fa-question"></i></a>
                                            </div>
                                        </div>
                                        <div class="filter-item">
                                            <label for="PeriodoF"><i class="fa fa-calendar"></i> Periodo final:</label>
                                            <div style="display: inline-flex; align-items: center; gap: 6px;">
                                                <div class="modern-input-wrapper">
                                                    <input name="PeriodoF" id="PeriodoF" class="datecontrol form-control modern-date-input" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["PeriodoF"].ToString()).ToString("MM/yyyy")" style="min-width: 130px;" />
                                                </div>
                                                <a class="text-right" data-toggle="tooltip" data-placement="top" title="Ayuda"
                                                   href="javascript:help('Periodo final', 'El mes id&oacute;neo a escoger es el &uacute;ltimo per&iacute;odo cargado')"><i class="btn btn-xs btn-default icon fa fa-question"></i></a>
                                            </div>
                                        </div>
                                        <div class="filter-item" style="margin-left: auto;">
                                            <button type="submit" name="submit" class="btn-modern-filter">
                                                <i class="fa fa-search"></i> Generar proyecciones mora
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="tab-pane @(Model.Buscar ? "active" : "")" id="tab_2">

                    @if (Model.Buscar)
                    {
                        <div class="modern-table-card">
                            <div class="row">
                                <div class="margin">
                                    <br />
                                    <div class="col-md-12">
                                        <table id="tbRangos" class="table table-striped table-bordered" style="width:100%; height: 350px">
                                            <thead>
                                                <tr>
                                                    <th colspan="7">
                                                        <img width="50" height="50" src="@Session["Logo"]" />
                                                    </th>
                                                </tr>
                                                <tr>
                                                    <th>Periodo</th>
                                                    <th>Al d&iacute;a</th>
                                                    <th>1-30 d&iacute;as</th>
                                                    <th>31-60 d&iacute;as</th>
                                                    <th>61-90 d&iacute;as</th>
                                                    <th>91-180 d&iacute;as</th>
                                                    <th>M&aacute;s de 180 d&iacute;as</th>
                                                    <th>Cobro Judicial</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                        <div id="summary">
                                            <div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-7">
                                        <div class="modern-table-card">
                                            <div class="box-header with-border">
                                                <img width="50" height="50" src="@Session["Logo"]" />
                                                <h4 class="box-title">Mora Estimada</h4>
                                            </div>
                                            <div class="box-body">
                                                @(Model.MoraEstimada)
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-5">
                                        <br /> <br /><br /> <br />
                                        <table id="tbDMora" class="table table-striped table-bordered" style="width:100%;">
                                            <thead>
                                                <tr>
                                                    <th colspan="8">
                                                        <img width="50" height="50" src="@Session["Logo"]" />
                                                    </th>
                                                </tr>
                                                <tr>
                                                    <th>Periodo</th>
                                                    <th>Cartera vencida a m&aacute;s de un d&iacute;a</th>
                                                    <th>Cartera vencida a m&aacute;s de 30 d&iacute;as</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                        <div id="summary">
                                            <div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <table id="tbDetalle" class="table table-striped table-bordered" style="width:100%; height: 350px">
                                            <thead>
                                                <tr>
                                                    <th colspan="6">
                                                        <img width="50" height="50" src="@Session["Logo"]" />
                                                    </th>
                                                </tr>
                                                <tr>
                                                    <th>Periodo</th>
                                                    <th>Cartera total</th>
                                                    <th>En mora</th>
                                                    <th>Estimaci&oacute;n nivel de mora</th>
                                                    <th>Mora / Cartera total</th>
                                                    <th>Estimaci&oacute;n mora</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                        <div id="summary">
                                            <div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <table id="tbMora" class="table table-striped table-bordered" style="width:100%; height: 350px">
                                            <thead>
                                                <tr>
                                                    <th colspan="8">
                                                        <img width="50" height="50" src="@Session["Logo"]" />
                                                        <h4 class="box-title">Proyecci&oacute;n de Mora</h4>
                                                    </th>
                                                </tr>
                                                <tr>
                                                    <th>Periodo</th>
                                                    <th>Al d&iacute;a</th>
                                                    <th>1-30 d&iacute;as</th>
                                                    <th>31-60 d&iacute;as</th>
                                                    <th>61-90 d&iacute;as</th>
                                                    <th>91-180 d&iacute;as</th>
                                                    <th>M&aacute;s de 180 d&iacute;as</th>
                                                    <th>Cobro Judicial</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                        <div id="summary">
                                            <div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-12">
                                        <div class="modern-table-card">
                                            <div class="box-header with-border">
                                                <img width="50" height="50" src="@Session["Logo"]" />
                                                <h3 class="box-title">Distribuci&oacute;n de la Mora</h3>
                                            </div>
                                            <div class="box-body">
                                                @(Model.DistribucionMora)
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <br />
                                <br />
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="defModal" tabindex="-1" role="dialog" aria-labelledby="deleteLabel" aria-hidden="true">
    <div class="modal-dialog ">
        <div class="modal-content">

            <div class="modal-header">
                <div class="box-header with-border">
                    <h3 id="titulo" style="padding-bottom: 10px;" class="box-title"></h3>
                </div>
            </div>
            <div class="modal-body">
                <p class="text-justify" style="font-size: 14px" id="definicion">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">

    function help(titulo, detalle) {
        $('#titulo').html(titulo);
        $('#definicion').html(detalle);
        $('#defModal').modal('show');
    }


    $(document).ready(function () {

        validarOpcion();

        $("#cmb_tipoTasa").change(
            function () {
				if ($("#cmb_tipoTasa").val() == 0) {
					$("#Tasa").attr('readonly', true);
					$("#Tasa").css("background-color", "#eee");
				}
				else {
					$("#Tasa").attr('readonly', false);
					$("#Tasa").css("background-color", "#fff");
				}

				$("#Tasa").focus();
			}
        );

   	    function validarOpcion() {
			if ($("#cmb_tipoTasa").val() == 0) {
				$("#Tasa").attr('readonly', true);
				$("#Tasa").css("background-color", "#eee");
			}
			else {
				$("#Tasa").attr('readonly', false);
				$("#Tasa").css("background-color", "#fff");
			}

            $("#Tasa").focus();
		}


        $('#Tasa').on('keypress', function (event) {
            var regex = new RegExp("^[a-zA-Z0-9,]+$");
            var key = String.fromCharCode(!event.charCode ? event.which : event.charCode);
            if (!regex.test(key)) {
                event.preventDefault();
                return false;
            }
        });

        var ControlerNameRole = "@Url.Content("~/ProyeccionMatriz")";

        $("#tbRangos").dataTable({
            "bRetrieve": true,
            "ordering": false,
            "bProcessing": true,
            "bPaginate": false,
            "bFilter": false,
            "bInfo": false,
            "dom": 'lBfrtip',
            "sAjaxSource": "@Url.Content("~/ProyeccionMatriz/GetGrid")",
            columnDefs: [
                {
                className: 'text-right', targets: [0, 1, 2, 3, 4, 5, 6, 7],
                },
            ],
            "buttons": [
                 { extend: 'copyHtml5', exportOptions: { columns: ':visible' } }
                ,{ extend: 'excelHtml5', exportOptions: { columns: ':visible' } }
                ,{ extend: 'csvHtml5', exportOptions: { columns: ':visible' } }
                ,{ extend: 'print', exportOptions: { columns: ':visible' } }
                ,'colvis'
                ],
                "aoColumns": [
                    {}, {}, {}, {}, {}, {}, {}, {}
            ]
        });

        $("#tbDetalle").dataTable({
            "bRetrieve": true,
            "ordering": false,
            "bProcessing": true,
            "bPaginate": false,
            "bFilter": false,
            "bInfo": false,
            "dom": 'lBfrtip',
            "sAjaxSource": "@Url.Content("~/ProyeccionMatriz/GetGridDetalle")",
            columnDefs: [
                {
                    className: 'text-right', targets: [0, 1, 2, 3, 4, 5],
                },
            ],
            "buttons": [
                 { extend: 'copyHtml5', exportOptions: { columns: ':visible' } }
                ,{ extend: 'excelHtml5', exportOptions: { columns: ':visible' } }
                ,{ extend: 'csvHtml5', exportOptions: { columns: ':visible' } }
                ,{ extend: 'print', exportOptions: { columns: ':visible' } }
                ,'colvis'
                ],
                "aoColumns": [
                    {}, {}, {}, {}, {}, {}
            ]
        });

         $("#tbMora").dataTable({
             "bRetrieve": true,
             "ordering": false,
            "bProcessing": true,
            "bPaginate": false,
            "bFilter": false,
            "bInfo": false,
            "dom": 'lBfrtip',
             "sAjaxSource": "@Url.Content("~/ProyeccionMatriz/GetGridMora")",
             columnDefs: [
                 {
                     className: 'text-right', targets: [0, 1, 2, 3, 4, 5, 6, 7],
                 },
             ],
            "buttons": [
                 { extend: 'copyHtml5', exportOptions: { columns: ':visible' } }
                ,{ extend: 'excelHtml5', exportOptions: { columns: ':visible' } }
                ,{ extend: 'csvHtml5', exportOptions: { columns: ':visible' } }
                ,{ extend: 'print', exportOptions: { columns: ':visible' } }
                ,'colvis'
                ],
                "aoColumns": [
                    {}, {}, {}, {}, {}, {}, {}, {}
             ],

         });

         $("#tbDMora").dataTable({
             "bRetrieve": true,
             "ordering": false,
            "bProcessing": true,
            "bPaginate": false,
            "bFilter": false,
            "bInfo": false,
            "dom": 'lBfrtip',
             "sAjaxSource": "@Url.Content("~/ProyeccionMatriz/GetGridDMora")",
             columnDefs: [
                 {
                     className: 'text-right', targets: [0, 1, 2],
                 },
             ],
            "buttons": [
                 { extend: 'copyHtml5', exportOptions: { columns: ':visible' } }
                ,{ extend: 'excelHtml5', exportOptions: { columns: ':visible' } }
                ,{ extend: 'csvHtml5', exportOptions: { columns: ':visible' } }
                ,{ extend: 'print', exportOptions: { columns: ':visible' } }
                ,'colvis'
                ],
                "aoColumns": [
                    {}, {}, {}
             ],
        });
      });

    function formatMillion() {
        return this.value;
    }

    function formatPercent() {
        return this.value + ' %';
    }

</script>





