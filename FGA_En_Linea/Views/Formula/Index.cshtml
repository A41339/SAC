<script type="text/javascript">
    $(document).ready(function () {
        // ---------------------------------------------------------------------
        // INICIALIZAR DATATABLE
        // ---------------------------------------------------------------------
        var oTableFormula = $("#tbFormula").DataTable({
            "bRetrieve": true,
            "bProcessing": true,
            "dom": 'lBfrtip',
            "sAjaxSource": "@Url.Content("~/Formula/GetGrid")",
            "buttons": [
                { extend: 'copyHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'excelHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'pdfHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'print', exportOptions: { columns: ':visible' } },
                'colvis'
            ],
            "pageLength": 10,
            "lengthMenu": [[5, 10, 25, 50, -1], [5, 10, 25, 50, "Todos"]],
            "order": [[1, "asc"]],
            "aoColumns": [
                {
                    "sClass": "text-center",
                    "bSortable": false,
                    "mRender": function (data, type, row) {
                        var id = row[0];
                        var nombre = (row[1] || '').replace(/"/g, '&quot;');
                        var buttons = '<div class="text-center"><div class="btn-group text-left">' +
                            '<button type="button" class="btn btn-xs btn-default dropdown-toggle" data-toggle="dropdown" ' +
                            'style="border-radius:6px; border:1px solid #cbd5e1; font-size:12px; padding:4px 10px; color:#374151;">' +
                            '<i class="fa fa-cog" style="margin-right:4px;"></i> AcciÃ³n <span class="caret"></span></button>' +
                            '<ul class="dropdown-menu pull-left" role="menu">' +
                            '<li><a href="javascript:void(0)" class="btn-edit-formula" data-id="' + id + '"><i class="fa fa-pencil text-primary"></i> Modificar</a></li>' +
                            '<li><a href="javascript:void(0)" class="btn-detail-formula" data-id="' + id + '"><i class="fa fa-info-circle text-info"></i> Consultar</a></li>' +
                            '<li class="divider"></li>' +
                            '<li><a href="javascript:void(0)" class="btn-delete-formula" data-id="' + id + '" data-nombre="' + nombre + '"><i class="fa fa-trash text-danger"></i> Eliminar</a></li>' +
                            '</ul>' +
                            '</div></div>';
                        return buttons;
                    }
                },
                {
                    "mRender": function (data) {
                        return '<strong style="color: #0f172a; font-size: 13.5px;">' + (data || '') + '</strong>';
                    }
                },
                {
                    "mRender": function (data) {
                        return '<span class="formula-code-badge">' + (data || '') + '</span>';
                    }
                },
                {
                    "sClass": "text-center",
                    "mRender": function (data) {
                        var isYes = ('' + data).toLowerCase().indexOf('s') !== -1;
                        return '<span class="badge-pill-tag ' + (isYes ? 'yes' : 'no') + '">' +
                            '<i class="fa ' + (isYes ? 'fa-check' : 'fa-times') + '"></i> ' + (isYes ? 'SÃ­' : 'No') + '</span>';
                    }
                }
            ],
            "language": {
                "sProcessing": "Procesando...",
                "sLengthMenu": "Mostrar _MENU_ registros",
                "sZeroRecords": "No se encontraron resultados",
                "sEmptyTable": "NingÃºn dato disponible en esta tabla",
                "sInfo": "Mostrando registros del _START_ al _END_ de un total de _TOTAL_ registros",
                "sInfoEmpty": "Mostrando registros del 0 al 0 de un total de 0 registros",
                "sInfoFiltered": "(filtrado de un total de _MAX_ registros)",
                "sSearch": "Buscar:",
                "oPaginate": {
                    "sFirst": "Primero",
                    "sLast": "Ãšltimo",
                    "sNext": "Siguiente",
                    "sPrevious": "Anterior"
                }
            }
        });

        // ---------------------------------------------------------------------
        // BOTÃ“N GUÃA DE SINTAXIS
        // ---------------------------------------------------------------------
        $('#btnGuiaSintaxis, #lnkVerSintaxisModal').on('click', function () {
            $('#modalGuiaSintaxis').modal('show');
        });

        // ---------------------------------------------------------------------
        // BOTONES DE TOKENS RÃPIDOS
        // ---------------------------------------------------------------------
        $('.token-btn').on('click', function () {
            var token = $(this).data('token');
            var $input = $('#formulaExpresion');
            var val = $input.val();
            $input.val(val + token).focus();
        });

        // ---------------------------------------------------------------------
        // ABRIR MODAL CREAR NUEVA FÃ“RMULA
        // ---------------------------------------------------------------------
        $('#btnNuevaFormula').on('click', function () {
            $('#lblTituloFormulaTexto').text('Nueva FÃ³rmula');
            $('#lblModalFormulaTitulo i').attr('class', 'fa fa-plus-circle');
            $('#formulaEsNuevo').val('true');
            $('#formulaId').val('');
            $('#formulaNombre').val('');
            $('#formulaExpresion').val('');
            $('#formulaIndPorcentaje').prop('checked', false);
            $('#modalFormulaError').hide();
            $('#modalFormula').modal('show');
            setTimeout(function () { $('#formulaNombre').focus(); }, 400);
        });

        // ---------------------------------------------------------------------
        // ABRIR MODAL EDITAR FÃ“RMULA
        // ---------------------------------------------------------------------
        $(document).on('click', '.btn-edit-formula', function () {
            var formulaId = $(this).data('id');
            $('#lblTituloFormulaTexto').text('Modificar FÃ³rmula');
            $('#lblModalFormulaTitulo i').attr('class', 'fa fa-pencil');
            $('#formulaEsNuevo').val('false');
            $('#formulaId').val(formulaId);
            $('#modalFormulaError').hide();

            $.ajax({
                url: '@Url.Action("GetFormula", "Formula")',
                type: 'GET',
                data: { id: formulaId },
                success: function (res) {
                    if (res.success) {
                        var d = res.data;
                        $('#formulaNombre').val(d.Nombre);
                        $('#formulaExpresion').val(d.Formula);
                        $('#formulaIndPorcentaje').prop('checked', d.Ind_Porcentaje);
                        $('#modalFormula').modal('show');
                        setTimeout(function () { $('#formulaNombre').focus(); }, 400);
                    } else {
                        window.mostrarToastError(res.message);
                    }
                },
                error: function () {
                    window.mostrarToastError('Error de comunicaciÃ³n al consultar la fÃ³rmula.');
                }
            });
        });

        // ---------------------------------------------------------------------
        // ABRIR MODAL CONSULTAR DETALLE
        // ---------------------------------------------------------------------
        $(document).on('click', '.btn-detail-formula', function () {
            var formulaId = $(this).data('id');
            $.ajax({
                url: '@Url.Action("GetDetalleFormula", "Formula")',
                type: 'GET',
                data: { id: formulaId },
                success: function (res) {
                    if (res.success) {
                        var d = res.data;
                        $('#detFormulaId').text(d.Id);
                        $('#detFormulaNombre').text(d.Nombre);
                        $('#detFormulaExpresion').text(d.Formula);
                        var isYes = d.Ind_Porcentaje === 'SÃ­';
                        $('#detFormulaPorcentual').html(
                            '<span class="badge-pill-tag ' + (isYes ? 'yes' : 'no') + '">' +
                            '<i class="fa ' + (isYes ? 'fa-check' : 'fa-times') + '"></i> ' + d.Ind_Porcentaje + '</span>'
                        );
                        $('#modalDetalleFormula').modal('show');
                    } else {
                        window.mostrarToastError(res.message);
                    }
                },
                error: function () {
                    window.mostrarToastError('Error de comunicaciÃ³n al consultar el detalle.');
                }
            });
        });

        // ---------------------------------------------------------------------
        // GUARDAR FÃ“RMULA (CREAR O EDITAR)
        // ---------------------------------------------------------------------
        $('#frmFormulaModal').on('submit', function (e) {
            e.preventDefault();
            var $btn = $('#btnGuardarFormula');
            $btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Guardando...');
            $('#modalFormulaError').hide();

            var token = $('input[name="__RequestVerificationToken"]', '#frmFormulaModal').val();
            var data = {
                __RequestVerificationToken: token,
                esNuevo: $('#formulaEsNuevo').val(),
                id: $('#formulaId').val(),
                nombre: $('#formulaNombre').val(),
                formula: $('#formulaExpresion').val(),
                indPorcentaje: $('#formulaIndPorcentaje').is(':checked')
            };

            $.ajax({
                url: '@Url.Action("GuardarFormula", "Formula")',
                type: 'POST',
                data: data,
                success: function (res) {
                    $btn.prop('disabled', false).html('<i class="fa fa-check" style="margin-right: 4px;"></i> Guardar');
                    if (res.success) {
                        $('#modalFormula').modal('hide');
                        oTableFormula.ajax.reload(null, false);
                        window.mostrarToastExito(res.message);
                    } else {
                        $('#modalFormulaError').text(res.message).fadeIn();
                    }
                },
                error: function () {
                    $btn.prop('disabled', false).html('<i class="fa fa-check" style="margin-right: 4px;"></i> Guardar');
                    $('#modalFormulaError').text('Error interno de comunicaciÃ³n al procesar la solicitud.').fadeIn();
                }
            });
        });

        // ---------------------------------------------------------------------
        // ABRIR MODAL ELIMINAR
        // ---------------------------------------------------------------------
        $(document).on('click', '.btn-delete-formula', function () {
            var id = $(this).data('id');
            var nombre = $(this).data('nombre');
            $('#deleteFormulaId').val(id);
            $('#deleteFormulaNombre').text(nombre);
            $('#modalDeleteFormula').modal('show');
        });

        // ---------------------------------------------------------------------
        // CONFIRMAR ELIMINACIÃ“N
        // ---------------------------------------------------------------------
        $('#btnConfirmarEliminarFormula').on('click', function () {
            var id = $('#deleteFormulaId').val();
            var $btn = $(this);
            $btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Eliminando...');

            var token = $('input[name="__RequestVerificationToken"]', '#frmFormulaModal').val();

            $.ajax({
                url: '@Url.Action("EliminarFormula", "Formula")',
                type: 'POST',
                data: {
                    __RequestVerificationToken: token,
                    id: id
                },
                success: function (res) {
                    $btn.prop('disabled', false).html('<i class="fa fa-trash" style="margin-right: 4px;"></i> Eliminar');
                    $('#modalDeleteFormula').modal('hide');
                    if (res.success) {
                        oTableFormula.ajax.reload(null, false);
                        window.mostrarToastExito(res.message);
                    } else {
                        window.mostrarToastError(res.message);
                    }
                },
                error: function () {
                    $btn.prop('disabled', false).html('<i class="fa fa-trash" style="margin-right: 4px;"></i> Eliminar');
                    $('#modalDeleteFormula').modal('hide');
                    window.mostrarToastError('Error de comunicaciÃ³n al eliminar la fÃ³rmula.');
                }
            });
        });
    });

    // -------------------------------------------------------------------------
    // SISTEMA DE NOTIFICACIONES TOAST (SI NO EXISTE YA GLOBALMENTE)
    // -------------------------------------------------------------------------
    if (!window.mostrarToastExito) {
        window.mostrarToastExito = function (mensaje) {
            if (typeof toastr !== 'undefined') {
                toastr.success(mensaje, 'Ã‰xito');
            } else if ($.notify) {
                $.notify({ message: mensaje }, { type: 'success', delay: 3500 });
            } else {
                alert(mensaje);
            }
        };
    }

    if (!window.mostrarToastError) {
        window.mostrarToastError = function (mensaje) {
            if (typeof toastr !== 'undefined') {
                toastr.error(mensaje, 'Error');
            } else if ($.notify) {
                $.notify({ message: mensaje }, { type: 'danger', delay: 4500 });
            } else {
                alert(mensaje);
            }
        };
    }
</script>
