@model FGA.Models.Formulas

@{
    ViewBag.Title = "Est&aacute; seguro de eliminar la f&oacute;rmula?";
    if (Ajax.IsThisAjaxRequest())
    {
        Layout = null;
    }
}

@Html.StarkAjaxFormSubmiter("frmFormula", "tbFormula", true, "Acci&oacute;n ejecutada con &eacute;xito")

@{
    if (!Ajax.IsThisAjaxRequest())
    {
        <section class="content-header">
    <h1>
        <i class="fa fa-trash"></i> Eliminar F&oacute;rmula
        <small>Confirmaci&oacute;n para remover la f&oacute;rmula del cat&aacute;logo de c&aacute;lculos.</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="@Url.Action("Index", "Modulo", new { modulo = "Formula/Delete" })" class="breadcrumb-parent-pill"><i class="fa fa-wrench" style="margin-right: 4px;"></i> Mantenimientos</a></li>
        <li class="active">Eliminar F&oacute;rmula</li>
    </ol>
</section>
    }
}

<section class="content">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        <div class="col-xs-12">

            <div class="box box-solid box-info">
                <div class="box-header">
                    <h3 class="box-title">Detalles</h3>
                </div><!-- /.box-header -->
                <div class="box-body table-responsive">

                    <div class="widget-sec">
                        <div class="streaming-table">
                            <table class="table table-striped table-bordered">
                                <tr>
                                    <td></td>
                                    <td>@Html.DisplayFor(model => model.Id)</td>
                                </tr>
                                <tr>
                                    <td>Nombre</td>
                                    <td>@Html.Raw(Model.Nombre)</td>
                                </tr>
                                <tr>
                                    <td>F&oacute;rmula</td>
                                    <td>@Html.Raw(Model.Formula)</td>
                                </tr>
                                <tr>
                                    <td>Porcentual/td>
                                    <td>@Html.DisplayFor(model => model.Ind_Porcentaje)</td>
                                </tr>
                            </table>
                            <div class="box-footer">

                                @using (Html.BeginForm("Delete", "Formula", FormMethod.Post, new { id = "frmFormula" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.StarkInputButtion("Borrar", "submit", "btn btn-danger", "")
                                    @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-primary" })
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>



