@{
    ViewBag.Title = "Dashboard";
}

@section ScriptsOrCss
{
 
    <script src="https://cdn.amcharts.com/lib/4/core.js"></script>
    <script src="https://cdn.amcharts.com/lib/4/charts.js"></script>
    <script src="https://cdn.amcharts.com/lib/4/themes/animated.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.62/pdfmake.js"></script>
    <link href="~/Content/box.css" rel="stylesheet" />
}

<section class="content-header">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
        <div>
            <h1>
                <i class="fa fa-tachometer"></i> Centro de Mando Ejecutivo FFC
                <small>Monitoreo din&aacute;mico de suficiencia patrimonial, eficiencia operativa y mora en tiempo real.</small>
            </h1>
        </div>
        <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
            <span class="system-health-chip"><span class="health-pulse-dot"></span><i class="fa fa-shield"></i> Estatus Sist&eacute;mico: <strong>Saludable & Regulado (SUGEF)</strong></span>
            <span class="live-date-chip"><i class="fa fa-calendar"></i> @DateTime.Now.ToString("dd MMMM, yyyy")</span>
        </div>
    </div>
</section>

<section class="content">

    <div class="modern-filter-card">
        <div class="modern-filter-toolbar">
            <div class="filter-item">
                <label for="IdEntidad"><i class="fa fa-university"></i> Entidad:</label>
                @Html.DropDownList("Entidades", null, new { @id = "IdEntidad", @class = "form-control modern-select", style = "min-width: 200px;" })
            </div>
            <div class="filter-item">
                <label id="Periodo1L" for="Periodo1"><i class="fa fa-calendar"></i> Periodo Inicial:</label>
                <div class="modern-input-wrapper">
                    <input name="Periodo1" id="Periodo1" class="datecontrol form-control modern-date-input" style="min-width: 130px;" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo1"].ToString()).ToString("MM/yyyy")" />
                </div>
            </div>
            <div class="filter-item">
                <label id="Periodo2L" for="Periodo2"><i class="fa fa-calendar"></i> Periodo Final:</label>
                <div class="modern-input-wrapper">
                    <input name="Periodo2" id="Periodo2" class="datecontrol form-control modern-date-input" style="min-width: 130px;" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo2"].ToString()).ToString("MM/yyyy")" />
                </div>
            </div>

            <!-- Botones de Selección Rápida de Períodos -->
            <div class="filter-item">
                <label><i class="fa fa-clock-o"></i> Acceso R&aacute;pido:</label>
                <div class="quick-period-group" style="display: flex; align-items: center; gap: 5px;">
                    <button type="button" class="btn-quick-period" onclick="setQuickPeriod('month')" title="&Uacute;ltimo Mes">Mes</button>
                    <button type="button" class="btn-quick-period" onclick="setQuickPeriod('quarter')" title="Trimestre Actual">Trimestre</button>
                    <button type="button" class="btn-quick-period" onclick="setQuickPeriod('ytd')" title="A&ntilde;o a la Fecha">YTD</button>
                    <button type="button" class="btn-quick-period" onclick="setQuickPeriod('year')" title="&Uacute;ltimos 12 Meses">12 Meses</button>
                </div>
            </div>

            <div class="filter-item">
                <button type="button" class="btn-modern-generate" onclick="javascript:getContent()">
                    <i class="fa fa-download"></i> Generar Reporte
                </button>
            </div>

            <!-- Interruptor para Activar/Desactivar Animaciones en Gráficos -->
            <div class="filter-item" style="margin-left: auto; align-self: flex-end; padding-bottom: 6px;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span class="anim-toggle-label" style="font-size: 12.5px; font-weight: 600; color: #475569; display: flex; align-items: center; gap: 6px; cursor: pointer;" onclick="toggleChartAnimations()">
                        <i class="fa fa-magic" style="color: #2F5597;"></i> Animaciones
                    </span>
                    <div class="modern-switch active" id="toggleAnimSwitch" onclick="toggleChartAnimations()" title="Activar o desactivar animaciones en los gráficos" role="button" tabindex="0">
                        <div class="switch-knob"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div>
        <div id="contenido">
        </div>
    </div>
</section>

<div class="modal fade" id="graphModal" tabindex="-1" role="dialog" aria-labelledby="graphModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" style="max-width: 900px; width: 92%; margin: 30px auto;">
        <div class="modal-content" style="border-radius: 14px; overflow: hidden; border: none; box-shadow: 0 16px 40px rgba(0,0,0,0.25);">
            <div id="grafica"></div>
            <div class="modal-footer" style="background: #f8fafc; border-top: 1px solid #e2e8f0; padding: 12px 20px; display: flex; justify-content: flex-end;">
                <button type="button" class="btn btn-default" data-dismiss="modal" style="padding: 8px 22px; border-radius: 8px; font-weight: 600;">
                    <i class="fa fa-times"></i> Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

<script>

    function help(titulo, detalle) {
        $('#titulo').html(titulo);
        $('#definicion').html(detalle);
        $('#defModal').modal('show');
    }

    function formatMillion() {
        return this.value;
    }

    function formatPercent() {
        return this.value + " %";
    }

    function setQuickPeriod(type) {
        function pad(n) { return n < 10 ? '0' + n : '' + n; }

        var p2Val = $('#Periodo2').val();
        var endMonth, endYear;

        if (p2Val && p2Val.indexOf('/') !== -1) {
            var parts = p2Val.split('/');
            endMonth = parseInt(parts[0], 10);
            endYear = parseInt(parts[1], 10);
        }

        if (!endMonth || isNaN(endMonth) || !endYear || isNaN(endYear)) {
            var now = new Date();
            var endDate = new Date(now.getFullYear(), now.getMonth() - 1, 1);
            endYear = endDate.getFullYear();
            endMonth = endDate.getMonth() + 1;
            $('#Periodo2').val(pad(endMonth) + '/' + endYear);
        }

        var p1 = '';

        if (type === 'month') {
            var startM = endMonth - 1;
            var startY = endYear;
            if (startM <= 0) { startM += 12; startY--; }
            p1 = pad(startM) + '/' + startY;
        } else if (type === 'quarter') {
            var startM = endMonth - 3;
            var startY = endYear;
            if (startM <= 0) { startM += 12; startY--; }
            p1 = pad(startM) + '/' + startY;
        } else if (type === 'ytd') {
            p1 = '01/' + endYear;
        } else if (type === 'year') {
            p1 = pad(endMonth) + '/' + (endYear - 1);
        }

        $('#Periodo1').val(p1);
        getContent();
    }

    var meses = new Array("Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre");

    function getPDF() {
        var divContent1 = $("#dashboard").html();
        divContent1 = divContent1.replace("hidden", "");

        var printWindow = window.open('', '', 'height=500, width=1500');
        printWindow.document.write('<html><head>');
        printWindow.document.write('<link rel="stylesheet" href="http://www.ffc.co.cr/FFC/Content/theme/dist/css/AdminLTE.min.css" type="text/css" />');
        printWindow.document.write('<link rel="stylesheet" href="http://www.ffc.co.cr/FFC/Content/theme/dist/css/skins/_all-skins.min.css" type="text/css" />');
        printWindow.document.write('<link rel="stylesheet" href="http://www.ffc.co.cr/FFC/Content/Site.css" type="text/css" />');
        printWindow.document.write('<link rel="stylesheet" href="http://www.ffc.co.cr/FFC/Content/theme/bower_components/bootstrap/dist/css/bootstrap.min.css"><html>');

        printWindow.document.write('</head><body>');
        printWindow.document.write(divContent1);
        printWindow.document.write('</body></html>');
        printWindow.print();
        printWindow.close();

    }

        function getGraph(id) {
        if (id === 'S1') {
            if (typeof mSuficiencia === 'function') {
                mSuficiencia();
            } else {
                $('#mSuficiencia').modal('show');
            }
            return;
        }

        $('#grafica').html('<div style="display:flex; justify-content:center; align-items:center; min-height:350px;"><div style="text-align:center;"><i class="fa fa-spinner fa-spin fa-3x fa-fw" style="color:#2F5597;"></i><p style="margin-top:12px; color:#64748b; font-weight:600;">Cargando gr&aacute;fico detallado...</p></div></div>');
        $('#graphModal').modal('show');

        $.ajax({
            url: '@Url.Action("GraficaDetalle", "Indicadores")',
            type: 'POST',
            cache: false,
            async: true,
            data: {
                'Entidades': $('#IdEntidad').val(),
                'PeriodoI':  $('#Periodo1').val(),
                'PeriodoF':  $('#Periodo2').val(),
                'cmb_indicadores': id,
                'cmb_estilo': 0
            },
            success: function (result) {
                $('#grafica').html(result);
                if (typeof Highcharts !== 'undefined' && Highcharts.charts) {
                    setTimeout(function () {
                        Highcharts.charts.forEach(function (c) {
                            if (c) {
                                try { c.reflow(); } catch (e) {}
                            }
                        });
                    }, 120);
                }
            },
            error: function (xhr, status, error) {
                $('#grafica').html('<div class="alert alert-danger" style="margin:24px; border-radius:8px;"><i class="fa fa-exclamation-triangle"></i> No fue posible cargar el gr&aacute;fico seleccionado. Intente nuevamente.</div>');
            }
        });
    }

    $(document).on('shown.bs.modal', '.modal', function () {
        if (typeof Highcharts !== 'undefined' && Highcharts.charts) {
            Highcharts.charts.forEach(function (c) {
                if (c) {
                    try { c.reflow(); } catch (e) {}
                }
            });
        }
    });

    function getSkeletonLoaderHtml() {
        return '<div class="skeleton-wrapper">' +
            '<div class="skeleton-grid">' +
                '<div class="skeleton-card"><div class="shimmer-line short"></div><div class="shimmer-line big"></div><div class="shimmer-box"></div></div>' +
                '<div class="skeleton-card"><div class="shimmer-line short"></div><div class="shimmer-line big"></div><div class="shimmer-box"></div></div>' +
                '<div class="skeleton-card"><div class="shimmer-line short"></div><div class="shimmer-line big"></div><div class="shimmer-box"></div></div>' +
            '</div>' +
            '<div class="skeleton-grid" style="margin-top: 20px;">' +
                '<div class="skeleton-card" style="height: 160px;"><div class="shimmer-line medium"></div><div class="shimmer-box" style="height: 100px;"></div></div>' +
                '<div class="skeleton-card" style="height: 160px;"><div class="shimmer-line medium"></div><div class="shimmer-box" style="height: 100px;"></div></div>' +
                '<div class="skeleton-card" style="height: 160px;"><div class="shimmer-line medium"></div><div class="shimmer-box" style="height: 100px;"></div></div>' +
            '</div>' +
        '</div>';
    }

    function getContent() {
        $('#contenido').html(getSkeletonLoaderHtml());
        setTimeout(function () {
            $.ajax({
                url: '@Url.Action("GetContent", "Home")',
                type: 'POST',
                cache: false,
                async: true,
                data: {
                    'IdEntidad': $('#IdEntidad').val(),
                    'Periodo1':  $('#Periodo1').val(),
                    'Periodo2':  $('#Periodo2').val()
                },
                success: function (data) {
                    $('#contenido').html(data);
                    var from = $("#Periodo2").val().split("/");
                    if (from.length >= 2) {
                        var mIdx = parseInt(from[0], 10) - 1;
                        var yr = from[1];
                        if (meses[mIdx]) {
                            $('#lbl_encabezado').html("Infograma. " + meses[mIdx] + ", " + yr + "<br/>" + $('#IdEntidad option:selected').text());
                        }
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Error al cargar el dashboard:", error, xhr.responseText);
                    $('#contenido').html(
                        '<div class="alert alert-danger" style="margin: 20px; border-radius: 12px; background: #fee2e2; border: 1px solid #fecaca; color: #991b1b; padding: 20px;">' +
                            '<h4 style="margin-top:0; font-weight:700;"><i class="fa fa-exclamation-triangle"></i> Error al Cargar los Datos del Dashboard</h4>' +
                            '<p style="margin-bottom:0;">No se pudo procesar la solicitud para el per&iacute;odo seleccionado. Verifique las fechas e intente de nuevo.</p>' +
                        '</div>'
                    );
                }
            });
        }, 150);
    }

    // ==========================================
    // Control de Animaciones en Gráficos Highcharts
    // ==========================================
    function getChartAnimationPreference() {
        var pref = localStorage.getItem('fga_charts_animation');
        if (pref === null) {
            try { localStorage.setItem('fga_charts_animation', 'true'); } catch (e) {}
            return true;
        }
        return pref === 'true';
    }

    function applyHighchartsAnimationSettings(enabled) {
        if (typeof Highcharts === 'undefined') return;
        Highcharts.setOptions({
            chart: {
                animation: enabled ? { duration: 1200, easing: 'easeOutCubic' } : false
            },
            plotOptions: {
                series: {
                    animation: enabled ? { duration: 1200 } : false
                },
                areaspline: {
                    animation: enabled ? { duration: 1200 } : false
                },
                line: {
                    animation: enabled ? { duration: 1200 } : false
                },
                column: {
                    animation: enabled ? { duration: 1000 } : false
                }
            }
        });
    }

    function updateAnimationSwitchUI(enabled) {
        var sw = $('#toggleAnimSwitch');
        if (enabled) {
            sw.addClass('active');
        } else {
            sw.removeClass('active');
        }
    }

    function toggleChartAnimations() {
        var current = getChartAnimationPreference();
        var next = !current;
        localStorage.setItem('fga_charts_animation', next ? 'true' : 'false');
        updateAnimationSwitchUI(next);
        applyHighchartsAnimationSettings(next);

        // Si ya hay gráficos Highcharts renderizados, actualizarlos en tiempo real
        if (typeof Highcharts !== 'undefined' && Highcharts.charts) {
            Highcharts.charts.forEach(function (chart) {
                if (chart && chart.series) {
                    chart.update({
                        chart: {
                            animation: next ? { duration: 1000, easing: 'easeOutCubic' } : false
                        },
                        plotOptions: {
                            series: {
                                animation: next ? { duration: 1000 } : false
                            }
                        }
                    }, false);

                    if (next) {
                        chart.series.forEach(function (s) {
                            if (s.animate) {
                                s.animate(true);
                                s.animate(false);
                            }
                        });
                    }
                    chart.redraw(next ? { duration: 800 } : false);
                }
            });
        }
    }

    // Inicializar configuración global de animación previa a la creación de los gráficos
    var initialAnimPref = getChartAnimationPreference();
    applyHighchartsAnimationSettings(initialAnimPref);

    getContent();

    $(document).ready(function () {
        updateAnimationSwitchUI(initialAnimPref);

        if(@(Env.GetUserInfo("roleid") == FGA.Utility.Utilitarios.roleGerencial.ToString())) {
            $('.highcharts-button').css("display", "none");
        }
    });

</script>


