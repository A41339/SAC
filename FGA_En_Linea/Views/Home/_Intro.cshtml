@model FGA.Models.Dashboard

<script src="https://code.highcharts.com/highcharts.js"></script>

@functions {
    public static string FormatVal(decimal[] arr, int idx, string fmt = "N2", string suffix = "") {
        if (arr != null && arr.Length > idx) {
            return arr[idx].ToString(fmt) + suffix;
        }
        return "0" + suffix;
    }

    public static decimal GetVal(decimal[] arr, int idx) {
        if (arr != null && arr.Length > idx) {
            return arr[idx];
        }
        return 0;
    }

    public static string TrendClass(decimal curr, decimal prev, bool lowerIsBetter = false) {
        if (curr == prev) return "fa fa-arrow-right";
        bool up = curr > prev;
        if (lowerIsBetter) {
            return up ? "fa fa-arrow-up trend-arrow-down" : "fa fa-arrow-down trend-arrow-up";
        } else {
            return up ? "fa fa-arrow-up trend-arrow-up" : "fa fa-arrow-down trend-arrow-down";
        }
    }
}

@{
    var modelData = Model ?? new FGA.Models.Dashboard();

    decimal suficienciaVal = GetVal(modelData.Suficiencia, 1);
    decimal suficienciaPrev = GetVal(modelData.Suficiencia, 0);

    decimal costoVal = GetVal(modelData.CostoAdmin, 1);
    decimal costoPrev = GetVal(modelData.CostoAdmin, 0);

    decimal morosidadVal = GetVal(modelData.Morosidad, 1);
    decimal morosidadPrev = GetVal(modelData.Morosidad, 0);

    decimal compromisoVal = GetVal(modelData.Compromiso, 1);
    decimal compromisoPrev = GetVal(modelData.Compromiso, 0);
    decimal compromisoVar = compromisoVal - compromisoPrev;
    decimal compromisoVarPct = compromisoPrev != 0 ? (compromisoVar / compromisoPrev) * 100 : 0;

    decimal activoVal = GetVal(modelData.Activo, 1);
    decimal activoPrev = GetVal(modelData.Activo, 0);
    decimal activoVar = activoVal - activoPrev;
    decimal activoVarPct = activoPrev != 0 ? (activoVar / activoPrev) * 100 : 0;

    decimal riesgoVal = GetVal(modelData.Riesgo, 1);
    decimal riesgoPrev = GetVal(modelData.Riesgo, 0);
    decimal riesgoVar = riesgoVal - riesgoPrev;
    decimal riesgoVarPct = riesgoPrev != 0 ? (riesgoVar / riesgoPrev) * 100 : 0;
}

<div class="row">
    <div id="dashboard" style="visibility:hidden; position: fixed">
        <div style="border: 1px solid yellow; background-color: white; margin: 5px; text-align: center;">
            <label class="h3" id="lbl_encabezado"></label>
        </div>
    </div>
</div>

<!-- ==================== FILA SUPERIOR: KPIS + INDICADORES ==================== -->
<div class="dashboard-top-grid">
    
    <!-- Left 9 columns: 3 Sparkline KPI Cards -->
    <div class="kpi-cards-wrapper">
        
        <!-- KPI 1: Suficiencia Patrimonial -->
        <div class="modern-kpi-card">
            <div class="kpi-title">Suficiencia Patrimonial</div>
            <div class="kpi-value-row">
                <div class="kpi-big-num">@FormatVal(modelData.Suficiencia, 1, "N1", "%")</div>
                <div><i class="@TrendClass(suficienciaVal, suficienciaPrev, false)"></i></div>
            </div>
            <div class="kpi-sparkline-container" id="sparkline_suficiencia"></div>
        </div>

        <!-- KPI 2: Eficiencia -->
        <div class="modern-kpi-card">
            <div class="kpi-title">Eficiencia</div>
            <div class="kpi-value-row">
                <div class="kpi-big-num">@FormatVal(modelData.CostoAdmin, 1, "N1", "%")</div>
                <div><i class="@TrendClass(costoVal, costoPrev, true)"></i></div>
            </div>
            <div class="kpi-sparkline-container" id="sparkline_eficiencia"></div>
        </div>

        <!-- KPI 3: Morosidad mayor a 90 días -->
        <div class="modern-kpi-card">
            <div class="kpi-title">Morosidad mayor a 90 d&iacute;as</div>
            <div class="kpi-value-row">
                <div class="kpi-big-num">@FormatVal(modelData.Morosidad, 1, "N1", "%")</div>
                <div><i class="@TrendClass(morosidadVal, morosidadPrev, true)"></i></div>
            </div>
            <div class="kpi-sparkline-container" id="sparkline_morosidad"></div>
        </div>

    </div>

    <!-- Right 3 columns: Indicadores Panel -->
    <div class="side-indicators-wrapper">
        <div class="modern-indicators-panel">
            <div class="indicators-panel-title">Indicadores</div>
            
            <div class="indicator-item">
                <span class="indicator-name">Gastos De Administraci&oacute;n / Utilidad Operacional Bruta</span>
                <div class="indicator-val-group">
                    <span>@FormatVal(modelData.CostoAdmin, 1, "N2", "%")</span>
                    <i class="@TrendClass(costoVal, costoPrev, true)"></i>
                </div>
            </div>

            <div class="indicator-item">
                <span class="indicator-name">Cartera con morosidad mayor a 90 d&iacute;as / Cartera Directa</span>
                <div class="indicator-val-group">
                    <span>@FormatVal(modelData.Morosidad, 1, "N2", "%")</span>
                    <i class="@TrendClass(morosidadVal, morosidadPrev, true)"></i>
                </div>
            </div>

            <div class="indicator-item">
                <span class="indicator-name">Margen financiero / Activos</span>
                <div class="indicator-val-group">
                    <span>@FormatVal(modelData.Riesgo, 1, "N2", "%")</span>
                    <i class="@TrendClass(GetVal(modelData.Riesgo, 1), GetVal(modelData.Riesgo, 0), false)"></i>
                </div>
            </div>

            <div class="indicator-item">
                <span class="indicator-name">Rentabilidad nominal / Patrimonio promedio</span>
                <div class="indicator-val-group">
                    <span>@FormatVal(modelData.Compromiso, 1, "N2", "%")</span>
                    <i class="@TrendClass(compromisoVal, compromisoPrev, false)"></i>
                </div>
            </div>

            <div class="indicator-item">
                <span class="indicator-name">Estimaciones sobre cartera / Mora mayor a 90 d&iacute;as y cobro judicial</span>
                <div class="indicator-val-group">
                    <span>@FormatVal(modelData.CalceMes, 1, "N2", "x")</span>
                    <i class="@TrendClass(GetVal(modelData.CalceMes, 1), GetVal(modelData.CalceMes, 0), false)"></i>
                </div>
            </div>

            <div class="indicator-item">
                <span class="indicator-name">P&eacute;rdida Esperada Cartera Total / Estimaci&oacute;n por deterioro</span>
                <div class="indicator-val-group">
                    <span>@FormatVal(modelData.PerdidaEsperada, 1, "N2", "%")</span>
                    <i class="@TrendClass(GetVal(modelData.PerdidaEsperada, 1), GetVal(modelData.PerdidaEsperada, 0), true)"></i>
                </div>
            </div>

            <div class="indicator-item">
                <span class="indicator-name">Utilidad o p&eacute;rdida acumulada trimestral</span>
                <div class="indicator-val-group">
                    <span>@FormatVal(modelData.PerdidaAcumulada, 1, "N2", "%")</span>
                    <i class="@TrendClass(GetVal(modelData.PerdidaAcumulada, 1), GetVal(modelData.PerdidaAcumulada, 0), false)"></i>
                </div>
            </div>

            <div class="indicator-item">
                <span class="indicator-name">ICL colones</span>
                <div class="indicator-val-group">
                    <span>@FormatVal(modelData.ICL, 1, "N2", "x")</span>
                    <i class="@TrendClass(GetVal(modelData.ICL, 1), GetVal(modelData.ICL, 0), false)"></i>
                </div>
            </div>

            <div class="indicator-item">
                <span class="indicator-name">Concentraci&oacute;n de los 20 inversionistas</span>
                <div class="indicator-val-group">
                    <span>@FormatVal(modelData.Calce3Meses, 1, "N2", "x")</span>
                    <i class="@TrendClass(GetVal(modelData.Calce3Meses, 1), GetVal(modelData.Calce3Meses, 0), true)"></i>
                </div>
            </div>

            <div class="indicator-item">
                <span class="indicator-name">Inversiones en t&iacute;tulos valores / Activo productivo</span>
                <div class="indicator-val-group">
                    <span>@FormatVal(modelData.RiesgoTasa, 1, "N2", "%")</span>
                    <i class="@TrendClass(GetVal(modelData.RiesgoTasa, 1), GetVal(modelData.RiesgoTasa, 0), false)"></i>
                </div>
            </div>

            <div class="indicator-item">
                <span class="indicator-name">Captaciones a plazo con el p&uacute;blico / Pasivo con costo</span>
                <div class="indicator-val-group">
                    <span>@FormatVal(modelData.Activo, 1, "N2", "%")</span>
                    <i class="@TrendClass(activoVal, activoPrev, false)"></i>
                </div>
            </div>

        </div>
    </div>

</div>

<!-- ==================== FILA CENTRAL: CUENTAS PRINCIPALES ==================== -->
<div class="cuentas-principales-wrapper">
    <div class="section-header-title">Cuentas principales (&cent; Millones)</div>
    
    <div class="cuentas-cards-grid">
        
        <!-- Cuenta 1: Resultado del período acumulado -->
        <div class="cuenta-card">
            <div class="cuenta-card-header">
                <div class="icon-circle-teal"><i class="fa fa-bar-chart"></i></div>
                <div class="cuenta-title">Resultado del periodo acumulado</div>
            </div>
            <div class="cuenta-big-value">@FormatVal(modelData.Compromiso, 1, "N0", "")</div>
            <div class="cuenta-subtable">
                <div class="subtable-col">
                    <label>Periodo anterior</label>
                    <span>@FormatVal(modelData.Compromiso, 0, "N0", "")</span>
                </div>
                <div class="subtable-col">
                    <label>Variaci&oacute;n</label>
                    <span>@compromisoVar.ToString("N0")</span>
                </div>
                <div class="subtable-col">
                    <label>Variaci&oacute;n %</label>
                    <span>@compromisoVarPct.ToString("N1")%</span>
                </div>
            </div>
        </div>

        <!-- Cuenta 2: Cartera de crédito -->
        <div class="cuenta-card">
            <div class="cuenta-card-header">
                <div class="icon-circle-blue"><i class="fa fa-credit-card"></i></div>
                <div class="cuenta-title">Cartera de cr&eacute;dito</div>
            </div>
            <div class="cuenta-big-value">@FormatVal(modelData.Activo, 1, "N0", "")</div>
            <div class="cuenta-subtable">
                <div class="subtable-col">
                    <label>Periodo anterior</label>
                    <span>@FormatVal(modelData.Activo, 0, "N0", "")</span>
                </div>
                <div class="subtable-col">
                    <label>Variaci&oacute;n</label>
                    <span>@activoVar.ToString("N0")</span>
                </div>
                <div class="subtable-col">
                    <label>Variaci&oacute;n %</label>
                    <span>@activoVarPct.ToString("N1")%</span>
                </div>
            </div>
        </div>

        <!-- Cuenta 3: Obligaciones con el público -->
        <div class="cuenta-card">
            <div class="cuenta-card-header">
                <div class="icon-circle-orange"><i class="fa fa-database"></i></div>
                <div class="cuenta-title">Obligaciones con el p&uacute;blico</div>
            </div>
            <div class="cuenta-big-value">@FormatVal(modelData.Riesgo, 1, "N0", "")</div>
            <div class="cuenta-subtable">
                <div class="subtable-col">
                    <label>Periodo anterior</label>
                    <span>@FormatVal(modelData.Riesgo, 0, "N0", "")</span>
                </div>
                <div class="subtable-col">
                    <label>Variaci&oacute;n</label>
                    <span>@riesgoVar.ToString("N0")</span>
                </div>
                <div class="subtable-col">
                    <label>Variaci&oacute;n %</label>
                    <span>@riesgoVarPct.ToString("N1")%</span>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- ==================== FILA DE GRÁFICOS DINÁMICOS HIGHCHARTS ==================== -->
@if (modelData != null && (modelData.VariacionCartera != null || modelData.Mora != null || modelData.DiferencialTasas != null || modelData.IndicadoresRentabilidad != null))
{
    <div style="margin-bottom: 20px;">
        <div class="row">
            @if (modelData.DiferencialTasas != null)
            {
                <div class="col-md-6">
                    <div class="box">
                        <div class="box-header">
                            <h4 class="box-title">Diferencial de tasas (porcentaje)</h4>
                        </div>
                        <div class="box-body">
                            @modelData.DiferencialTasas
                        </div>
                    </div>
                </div>
            }
            @if (modelData.IndicadoresRentabilidad != null)
            {
                <div class="col-md-6">
                    <div class="box">
                        <div class="box-header">
                            <h4 class="box-title">Cobertura de m&aacute;rgenes</h4>
                        </div>
                        <div class="box-body">
                            @modelData.IndicadoresRentabilidad
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="row" style="margin-top: 15px;">
            @if (modelData.VariacionCartera != null)
            {
                <div class="col-md-6">
                    <div class="box">
                        <div class="box-header">
                            <h4 class="box-title">Variaci&oacute;n interanual cartera</h4>
                        </div>
                        <div class="box-body">
                            @modelData.VariacionCartera
                        </div>
                    </div>
                </div>
            }
            @if (modelData.Mora != null)
            {
                <div class="col-md-6">
                    <div class="box">
                        <div class="box-header">
                            <h4 class="box-title">Mora de la cartera</h4>
                        </div>
                        <div class="box-body">
                            @modelData.Mora
                        </div>
                    </div>
                </div>
            }
        </div>
        
        <div class="row" style="margin-top: 15px;">
            @if (modelData.CapitalSocial != null)
            {
                <div class="col-md-6">
                    <div class="box">
                        <div class="box-header">
                            <h4 class="box-title">Variaci&oacute;n Capital Social</h4>
                        </div>
                        <div class="box-body">
                            @modelData.CapitalSocial
                        </div>
                    </div>
                </div>
            }
            @if (modelData.BrechaLiquidez != null)
            {
                <div class="col-md-6">
                    <div class="box">
                        <div class="box-header">
                            <h4 class="box-title">Brecha de l&iacute;quidez</h4>
                        </div>
                        <div class="box-body">
                            @modelData.BrechaLiquidez
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<!-- Highcharts Sparkline Dynamic Initialization -->
<script>
    $(document).ready(function () {
        function createSparkline(containerId, dataArray, lineColor) {
            if (typeof Highcharts === 'undefined' || !document.getElementById(containerId)) return;
            Highcharts.chart(containerId, {
                chart: {
                    type: 'area',
                    backgroundColor: null,
                    borderWidth: 0,
                    margin: [2, 0, 2, 0],
                    height: 45,
                    style: { overflow: 'visible' }
                },
                title: { text: '' },
                credits: { enabled: false },
                xAxis: { labels: { enabled: false }, title: { text: null }, startOnTick: false, endOnTick: false, tickPositions: [] },
                yAxis: { endOnTick: false, startOnTick: false, labels: { enabled: false }, title: { text: null }, tickPositions: [0] },
                legend: { enabled: false },
                tooltip: { enabled: false },
                plotOptions: {
                    series: {
                        animation: false,
                        lineWidth: 2,
                        shadow: false,
                        states: { hover: { lineWidth: 2 } },
                        marker: { radius: 2 },
                        fillOpacity: 0.15
                    }
                },
                series: [{
                    data: dataArray,
                    color: lineColor
                }]
            });
        }

        var valSuf = @suficienciaVal;
        var prevSuf = @suficienciaPrev;
        var valCosto = @costoVal;
        var prevCosto = @costoPrev;
        var valMora = @morosidadVal;
        var prevMora = @morosidadPrev;

        createSparkline('sparkline_suficiencia', [prevSuf * 0.9, prevSuf * 0.95, prevSuf, valSuf * 0.98, valSuf], '#2563eb');
        createSparkline('sparkline_eficiencia', [prevCosto * 0.9, prevCosto * 0.95, prevCosto, valCosto * 0.98, valCosto], '#2563eb');
        createSparkline('sparkline_morosidad', [prevMora * 1.1, prevMora * 1.05, prevMora, valMora * 1.02, valMora], '#0d7682');
    });
</script>
