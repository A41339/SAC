<script>

    function mCapitalSocial() {
        $('#mCapitalSocial').modal('show');
    }
    function mVariacionCartera() {
        $('#mVariacionCartera').modal('show');
    }
    function mDiferencialTasas() {
        $('#mDiferencialTasas').modal('show');
    }
    function mMora() {
        $('#mMora').modal('show');
    }
    function mBrechaLiquidez() {
        $('#mBrechaLiquidez').modal('show');
    }
    function mRentabilidad() {
        $('#mRentabilidad').modal('show');
    }
    function mSuficiencia() {
        $('#mSuficiencia').modal('show');
    }
    $(document).ready(function () {

        am4core.useTheme(am4themes_animated);
        var chartMin = 0.5
        var chartMax = 4.5;
        var data = {
            scoreMorosidad: parseFloat(@Model.Morosidad[0].ToString("N2").Replace(",",".")).toString(),
            scoreCompromiso: parseFloat(@Model.Compromiso[0].ToString("N2").Replace(",",".")).toString(),
            scoreActivo: parseFloat(@Model.Activo[0].ToString("N2").Replace(",",".")).toString(),
            scoreCosto: parseFloat(@Model.CostoAdmin[0].ToString("N2").Replace(",",".")).toString(),
            scoreICL: parseFloat(@Model.ICL[0].ToString("N2").Replace(",",".")).toString(),
            scorePerdidaAcumulada: parseFloat(@Model.PerdidaAcumulada[0].ToString("N2").Replace(",",".")).toString(),
            scorePerdidaEsperada: parseFloat(@Model.PerdidaEsperada[0].ToString("N2").Replace(",",".")).toString(),
            scoreRiesgoCambiario: parseFloat(@Model.RiesgoCambiario[0].ToString("N2").Replace(",",".")).toString(),
            gradingData: [
                {
                    title: "Normal",
                    color: "#0f9747",
                    lowScore: 0.5,
                    highScore: 1.5
                },
                {
                    title: "Nivel 1",
                    color: "#bdecb6",
                    lowScore: 1.501,
                    highScore: 2.5
                },
                {
                    title: "Nivel 2",
                    color: "#F9C74F",
                    lowScore: 2.501,
                    highScore: 3.5
                },
                {
                    title: "Nivel 3",
                    color: "#EE1F25",
                    lowScore: 3.501,
                    highScore: 4.5
                }
            ]
        };

        function lookUpGrade(lookupScore, grades) {
            for (var i = 0; i < grades.length; i++) {
                if (grades[i].lowScore < lookupScore && grades[i].highScore >= lookupScore)
                    return grades[i];
            }
            return 1;
        }

        function createChartPrint(id, score, texto, veces, btn, name) {
            var chart = am4core.create(id, am4charts.GaugeChart, am4charts.XYChart3D);
            chart.hiddenState.properties.opacity = 0;
            chart.fontSize = 12;
            chart.innerRadius = am4core.percent(90);
            chart.resizable = true;

            var axis = createAxis(chart);
            var grade = lookUpGrade(score, data.gradingData);
            var label = createLabel(chart, grade, veces);
            createHand(chart, axis, score, label, texto);

            $(btn).on('click', function (e) {
                chart.exporting.filePrefix = name;
                chart.exporting.export("jpg");
            });

            return chart;
        }

        function createAxis(chart) {
            var axis = chart.xAxes.push(new am4charts.ValueAxis());
            axis.min = chartMin;
            axis.max = chartMax;
            axis.strictMinMax = true;
            axis.renderer.labels.template.disabled = true;
            axis.renderer.ticks.template.disabled = true;
            axis.renderer.grid.template.disabled = true;
            axis.renderer.grid.template.opacity = 0.5;

            for (let grading of data.gradingData) {
                var range = axis.axisRanges.create();
                range.axisFill.fill = am4core.color(grading.color);
                range.axisFill.fillOpacity = 1;
                range.axisFill.zIndex = -1;
                range.value = grading.lowScore > chartMin ? grading.lowScore : chartMin;
                range.endValue = grading.highScore < chartMax ? grading.highScore : chartMax;
                range.grid.strokeOpacity = 0;
                range.stroke = am4core.color(grading.color).lighten(-0.1);
                range.label.inside = false;
                range.label.text = grading.title.toUpperCase();
                range.label.inside = false;
                range.label.location = 0.5;
                range.label.inside = false;
                range.label.radius = am4core.percent(10);
                range.label.paddingBottom = -5; // ~half font size
                range.label.fontSize = "0.8em";
            }
            return axis;
        }

        function createLabel(chart, grade, veces) {
            var label = chart.radarContainer.createChild(am4core.Label);
            label.isMeasured = false;
            label.fontSize = "20px";
            label.x = am4core.percent(50);
            label.paddingBottom = 15;
            label.horizontalCenter = "middle";
            label.verticalCenter = "bottom";
            label.fill = am4core.color(grade.color);

            if (veces) {
                var label2 = chart.radarContainer.createChild(am4core.Label);
                label2.isMeasured = false;
                label2.fontSize = "15px";
                label2.horizontalCenter = "middle";
                label2.verticalCenter = "bottom";
                label2.text = "veces";
            }
            return label;
        }

        function createChart(id, score, texto, veces, btn, name) {
            var chart = am4core.create(id, am4charts.GaugeChart, am4charts.XYChart3D);
            chart.hiddenState.properties.opacity = 0;
            chart.fontSize = 12;
            chart.innerRadius = am4core.percent(90);
            chart.resizable = true;

            var axis = createAxis(chart);
            var grade = lookUpGrade(score, data.gradingData);
            var label = createLabel(chart, grade, veces);
            createHand(chart, axis, score, label, texto);

            $(btn).on('click', function (e) {
                chart.exporting.filePrefix = name;
                chart.exporting.export("jpg");
            });

            return chart;
        }

        function createChartPrint(id, score, texto, veces, btn, name) {
            var chart = am4core.create(id, am4charts.GaugeChart, am4charts.XYChart3D);
            chart.hiddenState.properties.opacity = 0;
            chart.fontSize = 9;
            chart.innerRadius = am4core.percent(90);
            chart.resizable = true;

            var axis = createAxisPrint(chart);
            var grade = lookUpGrade(score, data.gradingData);
            var label = createLabelPrint(chart, grade, veces);
            createHand(chart, axis, score, label, texto);

            $(btn).on('click', function (e) {
                chart.exporting.filePrefix = name;
                chart.exporting.export("jpg");
            });

            return chart;
        }

        function createAxisPrint(chart) {
            var axis = chart.xAxes.push(new am4charts.ValueAxis());
            axis.min = chartMin;
            axis.max = chartMax;
            axis.strictMinMax = true;
            axis.renderer.labels.template.disabled = true;
            axis.renderer.ticks.template.disabled = true;
            axis.renderer.grid.template.disabled = true;
            axis.renderer.grid.template.opacity = 0.5;

            for (let grading of data.gradingData) {
                var range = axis.axisRanges.create();
                range.axisFill.fill = am4core.color(grading.color);
                range.axisFill.fillOpacity = 1;
                range.axisFill.zIndex = -1;
                range.value = grading.lowScore > chartMin ? grading.lowScore : chartMin;
                range.endValue = grading.highScore < chartMax ? grading.highScore : chartMax;
                range.grid.strokeOpacity = 0;
                range.stroke = am4core.color(grading.color).lighten(-0.1);
                range.label.inside = false;
                range.label.text = grading.title.toUpperCase();
                range.label.inside = false;
                range.label.location = 0.5;
                range.label.inside = false;
                range.label.radius = am4core.percent(10);
                range.label.paddingBottom = -5; // ~half font size
                range.label.fontSize = "0.8em";
            }
            return axis;
        }

        function createLabelPrint(chart, grade, veces) {
            var label = chart.radarContainer.createChild(am4core.Label);
            label.isMeasured = false;
            label.fontSize = "12px";
            label.x = am4core.percent(50);
            label.paddingBottom = 15;
            label.horizontalCenter = "middle";
            label.verticalCenter = "bottom";
            label.fill = am4core.color(grade.color);

            if (veces) {
                var label2 = chart.radarContainer.createChild(am4core.Label);
                label2.isMeasured = false;
                label2.fontSize = "10px";
                label2.horizontalCenter = "middle";
                label2.verticalCenter = "bottom";
                label2.text = "veces";
            }
            return label;
        }

        function createHand(chart, axis, score, label, text) {
            var hand = chart.hands.push(new am4charts.ClockHand());
            hand.axis = axis;
            hand.innerRadius = am4core.percent(55);
            hand.startWidth = 8;
            hand.pin.disabled = true;
            hand.value = score;
            hand.fill = am4core.color("#444");
            hand.stroke = am4core.color("#000");

            hand.events.on("positionchanged", function () {
                label.text = text;
                var result = lookUpGrade(score, data.gradingData);
                label.fill = am4core.color(result.color);
            });

            hand.showValue(parseFloat(score), 1, am4core.ease.cubicOut);
            return hand;
        }

        /*MOROSIDAD*/
        var chartMorosidad = createChart("chart_morosidad", data.scoreMorosidad, parseFloat(@Model.Morosidad[1].ToString("N2").Replace(",",".")).toString() + '%', false, $('#btn_morosidad'), 'Morosidad_Mayor_90');
        var pChartMorosidad = createChartPrint("pChart_morosidad", data.scoreMorosidad, parseFloat(@Model.Morosidad[1].ToString("N2").Replace(",",".")).toString() + '%', false, $('#btn_morosidad'), 'Morosidad_Mayor_90');

        /*COMPROMISO*/
        var chartCompromiso = createChart("chart_compromiso", data.scoreCompromiso, parseFloat(@Model.Compromiso[1].ToString("N2").Replace(",",".")).toString() + '%', false, $('#btn_compromiso'), 'Compromiso_Patrimonial');
        var pChartCompromiso = createChartPrint("pChart_compromiso", data.scoreCompromiso, parseFloat(@Model.Compromiso[1].ToString("N2").Replace(",",".")).toString() + '%', false, $('#btn_compromiso'), 'Compromiso_Patrimonial');

        /*ACTIVO*/
        var chartActivo = createChart("chart_activo", data.scoreActivo, parseFloat(@Model.Activo[1].ToString("N2").Replace(",",".")).toString(), true, $('#btn_activo'), 'Act_Prod_Entre_Pasivo');
        var pChartActivo = createChartPrint("pChart_activo", data.scoreActivo, parseFloat(@Model.Activo[1].ToString("N2").Replace(",",".")).toString(), true, $('#btn_activo'), 'Act_Prod_Entre_Pasivo');

        /*COSTO*/
        var chartCosto = createChart("chart_costo", data.scoreCosto, parseFloat(@Model.CostoAdmin[1].ToString("N2").Replace(",",".")).toString() + '%', false, $('#btn_gasto'), 'Gasto_Entre_Utilidad');
        var pChartCosto = createChartPrint("pChart_costo", data.scoreCosto, parseFloat(@Model.CostoAdmin[1].ToString("N2").Replace(",",".")).toString() + '%', false, $('#btn_gasto'), 'Gasto_Entre_Utilidad');

        /*SUFICIENCIA*/
        var chartICL = createChart("chart_ICL", data.scoreICL, parseFloat(@Model.ICL[1].ToString("N2").Replace(",",".")).toString(), true, $('#btn_ICL'), 'ICL');
        var pChartICL = createChartPrint("pChart_ICL", data.scoreICL, parseFloat(@Model.ICL[1].ToString("N2").Replace(",",".")).toString(), true, $('#btn_ICL'), 'ICL');

        @*/*Pérdida esperada cartera total / cartera total*/
        var chartPerdidaEsperada = createChart("chart_perdidaEsperada", data.scorePerdidaEsperada, parseFloat(@Model.PerdidaEsperada[1].ToString("N2").Replace(",",".")).toString(), true, $('#btn_perdidaEsperada'), 'Perdida_Esperada');
        var pChartPerdidaEsperada = createChartPrint("pChart_perdidaEsperada", data.scorePerdidaEsperada, parseFloat(@Model.PerdidaEsperada[1].ToString("N2").Replace(",",".")).toString(), true, $('#btn_perdidaEsperada'), 'Perdida_Esperada');*@

        /*Utilidad o Pérdida Acumulada Trimestral*/
        var chartPerdidaAcumulada = createChart("chart_perdidaAcumulada", data.scorePerdidaAcumulada, parseFloat(@Model.PerdidaAcumulada[1].ToString("N2").Replace(",",".")).toString() + '%', false, $('#btn_perdidaAcumulada'), 'Perdida_Acumulada');
        var pChartPerdidaAcumulada = createChartPrint("pChart_perdidaAcumulada", data.scorePerdidaAcumulada, parseFloat(@Model.PerdidaAcumulada[1].ToString("N2").Replace(",",".")).toString() + '%', false, $('#btn_perdidaAcumulada'), 'Perdida_Acumulada');
        function createGauge(containerId, value, text, vTitle) {
            if (Highcharts.charts) {
                Highcharts.charts.forEach(function (chart) {
                    if (chart && chart.renderTo.id === containerId) {
                        chart.destroy();
                    }
                });
            }

            const chart = Highcharts.chart(containerId, {
                chart: {
                    type: 'scatter',
                    height: 120,
                    margin: [45, 10, 45, 10],
                    backgroundColor: null
                },
                exporting: { enabled: false },
                legend: { navigation: { enabled: false } },
                title: {
                    text: vTitle,
                    align: 'center',
                    style: {
                        color: '#2c3e50',
                        fontSize: '16px',
                        fontWeight: 'bold',
                        fontFamily: 'Arial, sans-serif',
                        textShadow: '1px 1px #ccc'
                    }
                },
                credits: { enabled: false },
                accessibility: { enabled: false },
                navigation: { keyboardNavigation: { enabled: false } },
                xAxis: {
                    min: 0.5,
                    max: 4.5,
                    tickPositions: [1, 2, 3, 4],
                    lineWidth: 0,
                    tickWidth: 0,
                    labels: {
                        enabled: true,
                        formatter: function () {
                            if (this.value === 1) return 'N1';
                            if (this.value === 2) return 'N2 y N3';
                            if (this.value === 3) return 'IRG1 y IRG2';
                            if (this.value === 4) return 'IRG3';
                            return '';
                        },
                        style: {
                            fontWeight: 'bold',
                            color: '#2c3e50',
                            fontSize: '12px'
                        }
                    },
                    plotBands: [
                        { from: 0.5, to: 1.5, color: '#0f9747' },
                        { from: 1.5, to: 2.5, color: '#bdecb6' },
                        { from: 2.5, to: 3.5, color: '#F9C74F' },
                        { from: 3.5, to: 4.5, color: '#EE1F25' }
                    ]
                },
                yAxis: {
                    min: 0,
                    max: 1,
                    visible: false
                },
                tooltip: { enabled: false },
                series: [{
                    name: null,
                    showInLegend: false,
                    data: [{
                        x: 0.5, // inicio a la izquierda
                        y: 0.3,
                        customLabel: '0.0',
                        dataLabels: {
                            enabled: true,
                            useHTML: true,
                            formatter: function () {
                                return `<div style="background:#2c3e50; color:#fff; padding:4px 20px; border-radius:8px; font-weight:bold; font-size:14px; box-shadow:0 2px 5px rgba(0,0,0,0.3);">${this.point.customLabel}%</div>`;
                            },
                            align: 'center',
                            verticalAlign: 'top',
                            y: -10
                        }
                    }],
                    marker: {
                        symbol: 'url(https://www.ffc.co.cr/ffc/arrow.png)',
                        width: 20,
                        height: 20
                    }
                }]
            });

            const point = chart.series[0].points[0];
            let currentX = 0.5;
            let currentLabel = 0;
            const steps = 100;
            const incrementX = (value - 0.5) / steps;
            const targetLabel = Number(text);
            const incrementLabel = targetLabel / steps;
            const intervalTime = 30; // ms, para animación más suave y lenta

            const interval = setInterval(() => {
                currentX += incrementX;
                currentLabel += incrementLabel;

                if (currentX >= value) currentX = value;
                if (currentLabel >= targetLabel) currentLabel = targetLabel;

                point.update({ x: currentX, customLabel: currentLabel.toFixed(1) }, true, false);

                if (currentX === value && currentLabel === targetLabel) {
                    clearInterval(interval);
                }
            }, intervalTime);
        }

        const gauges = [
            { text: @Html.Raw(Json.Encode(Model.Suficiencia[1])), value: @Html.Raw(Json.Encode(Model.Suficiencia[0])), title: "Suficiencia" },
            { text: @Html.Raw(Json.Encode(Model.CN1[1])), value: @Html.Raw(Json.Encode(Model.CN1[0])), title: "CN1" },
            { text: @Html.Raw(Json.Encode(Model.CNN1[1])), value: @Html.Raw(Json.Encode(Model.CNN1[0])), title: "CNN1" },
            { text: @Html.Raw(Json.Encode(Model.Apalancamiento[1])), value: @Html.Raw(Json.Encode(Model.Apalancamiento[0])), title: "Apalancamiento" }
        ];

        const wrapper = document.getElementById('wrapper');
        wrapper.style.height = '600px';
        wrapper.style.display = 'flex';
        wrapper.style.flexDirection = 'column';
        wrapper.style.justifyContent = 'space-between';

        gauges.forEach((gauge, index) => {
            const div = document.createElement('div');
            div.id = 'gauge-' + (index + 1);
            div.style.width = '90%';
            div.style.minWidth = '180px';
            div.style.margin = '0 auto 25px';
            wrapper.appendChild(div);

            createGauge(div.id, gauge.value, gauge.text, gauge.title);
        });
    });

</script>

