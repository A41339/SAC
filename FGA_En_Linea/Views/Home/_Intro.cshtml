                    <div class="cuenta-card-header">
                        <div class="icon-circle-orange"><i class="fa fa-database"></i></div>
                        <div class="cuenta-title">Obligaciones con el p&uacute;blico</div>
                        <span class="kpi-expand-btn" onclick="event.stopPropagation(); getGraph('B210');" style="margin-left:auto; color:#94a3b8;" title="Ampliar gr&aacute;fico"><i class="fa fa-line-chart"></i></span>
                    </div>
                    <div class="cuenta-value-row">
                        <div class="cuenta-big-value">@FormatVal(modelData.ObligacionesPublico, 1, "N0", "")</div>
                        @MiniBars(obligPrev, obligVal, "#ea580c", 4)
                    </div>
                    <div class="cuenta-subtable">
                        <div class="subtable-col">
                            <label>Per&iacute;odo anterior</label>
                            <span>@FormatVal(modelData.ObligacionesPublico, 0, "N0", "")</span>
                        </div>
                        <div class="subtable-col @(obligVar > 0 ? "val-positive" : (obligVar < 0 ? "val-negative" : ""))">
                            <label>Variaci&oacute;n</label>
                            <span>@obligVar.ToString("N0")</span>
                        </div>
                        <div class="subtable-col badge-cell @(obligVarPct > 0 ? "positive" : (obligVarPct < 0 ? "negative" : ""))">
                            <label>Variaci&oacute;n %</label>
                            <span>@obligVarPct.ToString("N2")%</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- ==================== TABLA PÉRDIDAS ESPERADAS ==================== -->
        <div class="perdida-esperada-card" style="background: #ffffff; border-radius: 12px; border: 1px solid #e2e8f0; padding: 16px 20px; box-shadow: var(--card-shadow, 0 4px 12px rgba(0,0,0,0.03));">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="display: inline-block; width: 6px; height: 18px; background: #0284c7; border-radius: 2px;"></span>
