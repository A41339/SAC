<!-- Highcharts Sparkline & Funciones de Modal JavaScript -->
<script>
    function mCapitalSocial() { $('#mCapitalSocial').modal('show'); }
    function mVariacionCartera() { $('#mVariacionCartera').modal('show'); }
    function mDiferencialTasas() { $('#mDiferencialTasas').modal('show'); }
    function mMora() { $('#mMora').modal('show'); }
    function mBrechaLiquidez() { $('#mBrechaLiquidez').modal('show'); }
    function mRentabilidad() { $('#mRentabilidad').modal('show'); }
    function mSuficiencia() { $('#mSuficiencia').modal('show'); }

    $(document).ready(function () {
        function createSparkline(containerId, dataPoints, lineColor) {
            if (typeof Highcharts === 'undefined' || !document.getElementById(containerId)) return;
            Highcharts.chart(containerId, {
                chart: {
                    type: 'areaspline',
                    backgroundColor: null,
                    borderWidth: 0,
                    margin: [4, 0, 0, 0],
                    height: 65,
                    style: { overflow: 'visible' }
                },
                title: { text: '' },
                credits: { enabled: false },
                xAxis: {
                    categories: ['Periodo Inicial', 'Periodo Final'],
                    visible: false,
                    labels: { enabled: false },
                    title: { text: null },
                    startOnTick: false,
                    endOnTick: false
                },
                yAxis: {
                    visible: false,
                    endOnTick: false,
                    startOnTick: false,
                    labels: { enabled: false },
                    title: { text: null }
                },
                legend: { enabled: false },
                tooltip: {
                    enabled: true,
                    backgroundColor: '#143750',
                    borderColor: '#88D1E2',
                    borderWidth: 1,
                    borderRadius: 8,
                    shadow: true,
                    style: { color: '#ffffff', fontSize: '11px', fontWeight: 'bold' },
                    headerFormat: '<span style="font-size:10px; color:#cbd5e1;">{point.key}</span><br/>',
                    pointFormat: '<span style="color:#88D1E2;">●</span> <b>{point.y:.1f}%</b>'
                },
                plotOptions: {
                    areaspline: {
                        animation: {
                            duration: 950
                        },
                        lineWidth: 2.5,
                        shadow: false,
                        states: { hover: { lineWidth: 3 } },
                        marker: {
                            enabled: true,
                            radius: 3,
                            states: { hover: { enabled: true, radius: 5 } }
                        },
                        fillColor: {
                            linearGradient: { x1: 0, y1: 0, x2: 0, y2: 1 },
                            stops: [
                                [0, Highcharts.color(lineColor).setOpacity(0.35).get('rgba')],
                                [1, Highcharts.color(lineColor).setOpacity(0.02).get('rgba')]
                            ]
                        }
                    }
                },
                series: [{
                    name: 'Indicador',
                    data: dataPoints,
                    color: lineColor
                }]
            });
        }

        var valSuf = @suficienciaVal.ToString(inv);
        var prevSuf = @suficienciaPrev.ToString(inv);
        var valCosto = @costoVal.ToString(inv);
        var prevCosto = @costoPrev.ToString(inv);
        var valMora = @morosidadVal.ToString(inv);
        var prevMora = @morosidadPrev.ToString(inv);

        createSparkline('sparkline_suficiencia', [prevSuf, valSuf], '#2563eb');
        createSparkline('sparkline_eficiencia', [prevCosto, valCosto], '#2563eb');
        createSparkline('sparkline_morosidad', [prevMora, valMora], '#0d7682');
    });
</script>
