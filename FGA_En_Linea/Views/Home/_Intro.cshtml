                    <img width="38" height="38" src="@Session["Logo"]" style="border-radius: 6px; background: #ffffff; padding: 2px;" />
                    <h3 class="modal-title" style="margin: 0; color: #ffffff !important; font-size: 16px; font-weight: 600;">Nivel y Calidad del Capital &mdash; Suficiencia, CN1, CCN1 y Apalancamiento</h3>
