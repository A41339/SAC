<!-- Highcharts Sparkline & Funciones de Modal JavaScript -->
<script>
    function mCapitalSocial() { $('#mCapitalSocial').modal('show'); }
    function mVariacionCartera() { $('#mVariacionCartera').modal('show'); }
    function mDiferencialTasas() { $('#mDiferencialTasas').modal('show'); }
    function mMora() { $('#mMora').modal('show'); }
    function mBrechaLiquidez() { $('#mBrechaLiquidez').modal('show'); }
    function mRentabilidad() { $('#mRentabilidad').modal('show'); }
    function mSuficiencia() { $('#mSuficiencia').modal('show'); }

    $(document).ready(function () {
        var animPref = (typeof getChartAnimationPreference === 'function') ? getChartAnimationPreference() : (localStorage.getItem('fga_charts_animation') !== 'false');

                function createSparkline(containerId, dataPoints, lineColor, clickCallback) {
            if (typeof Highcharts === 'undefined' || !document.getElementById(containerId)) return;

            var p0 = parseFloat(dataPoints[0]) || 0;
            var p1 = parseFloat(dataPoints[1]) || 0;
            var minVal = Math.min(p0, p1);
            var maxVal = Math.max(p0, p1);
            var diff = Math.abs(maxVal - minVal);

            var padding = diff > 0 ? (diff * 0.45) : (minVal !== 0 ? Math.abs(minVal) * 0.08 : 1);
            if (padding < 0.05) padding = 0.05;

            var yMin = minVal - padding;
            var yMax = maxVal + padding;

            Highcharts.chart(containerId, {
                chart: {
                    type: 'areaspline',
                    backgroundColor: null,
                    borderWidth: 0,
                    margin: [4, 4, 4, 4],
                    height: 55,
                    style: { overflow: 'visible', cursor: 'pointer' },
                    animation: animPref ? { duration: 1100, easing: 'easeOutCubic' } : false,
                    events: {
                        click: function () {
                            if (typeof clickCallback === 'function') {
                                clickCallback();
                            }
                        }
                    }
                },
                title: { text: '' },
                credits: { enabled: false },
                exporting: { enabled: false },
                xAxis: {
                    categories: ['Periodo Inicial', 'Periodo Final'],
                    visible: false,
                    labels: { enabled: false },
                    title: { text: null },
                    startOnTick: false,
                    endOnTick: false
                },
                yAxis: {
                    visible: false,
                    endOnTick: false,
                    startOnTick: false,
                    min: yMin,
                    max: yMax,
                    labels: { enabled: false },
                    title: { text: null }
                },
                legend: { enabled: false },
                tooltip: {
                    enabled: true,
                    outside: true,
                    backgroundColor: '#143750',
                    borderColor: '#88D1E2',
                    borderWidth: 1,
                    borderRadius: 8,
                    shadow: true,
                    style: { color: '#ffffff', fontSize: '11px', fontWeight: 'bold' },
                    headerFormat: '<span style="font-size:10px; color:#cbd5e1;">{point.key}</span><br/>',
                    pointFormat: '<span style="color:#88D1E2;">&#9679;</span> <b>{point.y:.2f}%</b>'
                },
                plotOptions: {
                    series: {
                        cursor: 'pointer',
                        events: {
                            click: function () {
                                if (typeof clickCallback === 'function') {
                                    clickCallback();
                                }
                            }
                        }
                    },
                    areaspline: {
                        threshold: yMin,
                        animation: animPref ? { duration: 1100 } : false,
                        lineWidth: 3,
                        shadow: false,
                        states: { hover: { lineWidth: 4 } },
                        marker: {
                            enabled: true,
                            radius: 4,
                            states: { hover: { enabled: true, radius: 6 } }
                        },
                        fillColor: {
                            linearGradient: { x1: 0, y1: 0, x2: 0, y2: 1 },
                            stops: [
                                [0, Highcharts.color(lineColor).setOpacity(0.38).get('rgba')],
                                [1, Highcharts.color(lineColor).setOpacity(0.04).get('rgba')]
                            ]
                        }
                    }
                },
                series: [{
                    name: 'Indicador',
                    data: [p0, p1],
                    color: lineColor
                }]
            });
        }

        var valSuf = @suficienciaVal.ToString(inv);
        var prevSuf = @suficienciaPrev.ToString(inv);
        var valCosto = @costoVal.ToString(inv);
        var prevCosto = @costoPrev.ToString(inv);
        var valMora = @morosidadVal.ToString(inv);
        var prevMora = @morosidadPrev.ToString(inv);

        if (animPref) {
            setTimeout(function () { createSparkline('sparkline_suficiencia', [prevSuf, valSuf], '#2F5597', mSuficiencia); }, 60);
            setTimeout(function () { createSparkline('sparkline_eficiencia', [prevCosto, valCosto], '#3d6cb9', function () { getGraph('C118'); }); }, 200);
            setTimeout(function () { createSparkline('sparkline_morosidad', [prevMora, valMora], '#2F5597', function () { getGraph('C22'); }); }, 340);
        } else {
            createSparkline('sparkline_suficiencia', [prevSuf, valSuf], '#2F5597', mSuficiencia);
            createSparkline('sparkline_eficiencia', [prevCosto, valCosto], '#3d6cb9', function () { getGraph('C118'); });
            createSparkline('sparkline_morosidad', [prevMora, valMora], '#2F5597', function () { getGraph('C22'); });
        }

        // Delegacion de clic directo sobre el contenedor del grafico y todos sus elementos
        $('#sparkline_suficiencia').on('click', function (e) {
            e.stopPropagation();
            mSuficiencia();
        });
        $('#sparkline_eficiencia').on('click', function (e) {
            e.stopPropagation();
            getGraph('C118');
        });
        $('#sparkline_morosidad').on('click', function (e) {
            e.stopPropagation();
            getGraph('C22');
        });

        $('#mSuficiencia').on('shown.bs.modal', function () {
            if (typeof Highcharts !== 'undefined' && Highcharts.charts) {
                setTimeout(function () {
                    Highcharts.charts.forEach(function (c) {
                        if (c) {
                            try { c.reflow(); } catch (e) {}
                        }
                    });
                }, 100);
            }
        });
    });
</script>