                <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="color: #ffffff !important; opacity: 0.9;"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                @modelData.pIndicadoresRentabilidad
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="mSuficiencia" tabindex="-1" role="dialog" aria-labelledby="mSuficienciaLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-chart-xl" style="max-width: 1300px; width: 95%; margin: 25px auto;">
        <div class="modal-content" style="border-radius: 14px; overflow: hidden; border: none; box-shadow: 0 16px 40px rgba(0,0,0,0.25);">
            <div class="modal-header" style="background: linear-gradient(135deg, #2F5597 0%, #1e3a8a 100%); padding: 14px 20px; display: flex; align-items: center; justify-content: space-between;">
