@model FGA.Models.Dashboard

<script src="https://code.highcharts.com/highcharts.js"></script>

<style>
    .modern-kpi-card {
        height: auto !important;
        min-height: 205px !important;
        padding: 16px 16px 14px 16px !important;
        box-sizing: border-box !important;
    }
    .kpi-target-bar-wrapper {
        margin-top: 8px !important;
        padding-top: 8px !important;
        border-top: 1px dashed #e2e8f0 !important;
    }
    .kpi-sparkline-container {
        height: 55px !important;
        overflow: visible !important;
        pointer-events: none !important;
    }
    .kpi-sparkline-container .highcharts-container,
    .kpi-sparkline-container svg {
        overflow: visible !important;
        pointer-events: none !important;
    }
    .clickable-kpi-card {
        cursor: pointer;
        user-select: none;
    }
    .clickable-kpi-card .kpi-expand-btn {
        transition: color 0.2s ease, transform 0.2s ease;
    }
    .clickable-kpi-card:hover .kpi-expand-btn {
        color: #0d7377 !important;
        transform: scale(1.22);
    }
    .highcharts-tooltip-container {
        z-index: 999999 !important;
        pointer-events: none !important;
    }

    /* Animación de alerta pulsante para valores e indicadores en rojo */
    @@keyframes alertGlowPulse {
        0%, 100% {
            border-color: #fca5a5;
            box-shadow: 0 0 0 1px rgba(239, 68, 68, 0.35), 0 1px 3px rgba(239, 68, 68, 0.15);
        }
        50% {
            border-color: #ef4444;
            box-shadow: 0 0 0 3.5px rgba(239, 68, 68, 0.35), 0 0 14px rgba(239, 68, 68, 0.7), inset 0 0 4px rgba(239, 68, 68, 0.2);
        }
    }

    .indicator-var-pill.negative,
    span.indicator-var-pill.negative {
        background-color: #fef2f2 !important;
        color: #dc2626 !important;
        border: 1px solid #fca5a5 !important;
        animation: alertGlowPulse 1.8s infinite ease-in-out !important;
        will-change: box-shadow, border-color;
    }

    .kpi-trend-pill.negative,
    span.kpi-trend-pill.negative {
        background-color: #fee2e2 !important;
        color: #b91c1c !important;
        border: 1px solid #fca5a5 !important;
        animation: alertGlowPulse 1.8s infinite ease-in-out !important;
        will-change: box-shadow, border-color;
    }

    .semaphore-badge.status-danger,
    .semaphore-badge.danger,
    .semaphore-badge.alert {
        background-color: #fee2e2 !important;
        color: #b91c1c !important;
        border: 1px solid #fca5a5 !important;
        animation: alertGlowPulse 1.8s infinite ease-in-out !important;
        will-change: box-shadow, border-color;
    }

    .subtable-col.badge-cell.negative,
    div.subtable-col.badge-cell.negative {
        background-color: #fee2e2 !important;
        border-color: #fca5a5 !important;
        animation: alertGlowPulse 1.8s infinite ease-in-out !important;
        will-change: box-shadow, border-color;
    }

    .subtable-col.val-negative {
        background-color: #fff5f5 !important;
        border-color: #fca5a5 !important;
        animation: alertGlowPulse 1.8s infinite ease-in-out !important;
        will-change: box-shadow, border-color;
    }
</style>

@functions {
    public string FormatVal(decimal[] arr, int idx, string fmt, string suffix) {
        if (arr != null && arr.Length > idx) {
            return arr[idx].ToString(fmt) + suffix;
        }
        return "0" + suffix;
    }

    public decimal GetVal(decimal[] arr, int idx) {
        if (arr != null && arr.Length > idx) {
            return arr[idx];
        }
        return 0;
    }

    public string TrendClass(decimal curr, decimal prev, bool lowerIsBetter = false) {
        if (curr == prev) return "fa fa-minus";
        return curr > prev ? "fa fa-arrow-up trend-arrow-up" : "fa fa-arrow-down trend-arrow-down";
    }

    public HtmlString TrendPill(decimal curr, decimal prev, bool lowerIsBetter = false) {
        if (prev == 0 && curr == 0) {
            return new HtmlString("<span class=\"kpi-trend-pill neutral\">0.00% <i class=\"fa fa-minus\"></i></span>");
        }
        decimal diff = curr - prev;
        string sign = diff > 0 ? "+" : "";
        string arrow = diff > 0 ? "<i class=\"fa fa-caret-up\"></i>" : (diff < 0 ? "<i class=\"fa fa-caret-down\"></i>" : "<i class=\"fa fa-minus\"></i>");
        string pillClass = diff > 0 ? "positive" : (diff < 0 ? "negative" : "neutral");
        if (lowerIsBetter) {
            pillClass = diff > 0 ? "negative" : (diff < 0 ? "positive" : "neutral");
        }
        return new HtmlString(string.Format("<span class=\"kpi-trend-pill {0}\">{1}{2:N2}% {3}</span>", pillClass, sign, diff, arrow));
    }

    public HtmlString IndicatorTrendBadge(decimal curr, decimal prev, string fmt = "N2", string suffix = "%", bool lowerIsBetter = false) {
        if (prev == 0 && curr == 0) {
            return new HtmlString("<span class=\"indicator-var-pill neutral\">0.00" + suffix + " <i class=\"fa fa-minus\"></i></span>");
        }
        decimal diff = curr - prev;
        string sign = diff > 0 ? "+" : "";
        string arrow = diff > 0 ? "<i class=\"fa fa-caret-up\"></i>" : (diff < 0 ? "<i class=\"fa fa-caret-down\"></i>" : "<i class=\"fa fa-minus\"></i>");
        string pillClass = diff > 0 ? "positive" : (diff < 0 ? "negative" : "neutral");
        if (lowerIsBetter) {
            pillClass = diff > 0 ? "negative" : (diff < 0 ? "positive" : "neutral");
        }
        return new HtmlString(string.Format("<span class=\"indicator-var-pill {0}\" title=\"Inicial: {1:" + fmt + "}{2} &rarr; Final: {3:" + fmt + "}{2}\">{4}{5:" + fmt + "}{2} {6}</span>", 
            pillClass, prev, suffix, curr, sign, diff, arrow));
    }

    public HtmlString SemaphoreBadge(string kpiType, decimal value) {
        string statusClass = "normal";
        string labelText = "&Oacute;ptimo";
        string icon = "fa-check-circle";

        if (kpiType == "suficiencia") {
            if (value < 8m) { statusClass = "status-danger danger"; labelText = "Alerta <8%"; icon = "fa-exclamation-triangle"; }
            else if (value < 10m) { statusClass = "warning"; labelText = "Precauci&oacute;n <10%"; icon = "fa-exclamation-circle"; }
            else { statusClass = "normal"; labelText = "SUGEF OK"; icon = "fa-check-circle"; }
        } else if (kpiType == "compromiso") {
            if (value > 20m) { statusClass = "status-danger danger"; labelText = "Alerta >20%"; icon = "fa-exclamation-triangle"; }
            else if (value > 10m) { statusClass = "warning"; labelText = "Precauci&oacute;n >10%"; icon = "fa-exclamation-circle"; }
            else if (value <= 0m) { statusClass = "normal"; labelText = "Sin Compromiso \u22640%"; icon = "fa-check-circle"; }
            else { statusClass = "normal"; labelText = "SUGEF OK \u226410%"; icon = "fa-check-circle"; }
        } else if (kpiType == "eficiencia") {
            if (value > 60m) { statusClass = "status-danger danger"; labelText = "Alerta >60%"; icon = "fa-exclamation-triangle"; }
            else if (value > 50m) { statusClass = "warning"; labelText = "Precauci&oacute;n >50%"; icon = "fa-exclamation-circle"; }
            else { statusClass = "normal"; labelText = "&Oacute;ptimo"; icon = "fa-check-circle"; }
        } else if (kpiType == "morosidad") {
            if (value > 5m) { statusClass = "status-danger danger"; labelText = "Alerta >5%"; icon = "fa-exclamation-triangle"; }
            else if (value > 3m) { statusClass = "warning"; labelText = "Precauci&oacute;n >3%"; icon = "fa-exclamation-circle"; }
            else { statusClass = "normal"; labelText = "En rango"; icon = "fa-check-circle"; }
        }

        return new HtmlString(string.Format("<span class=\"semaphore-badge {0}\"><i class=\"fa {1}\"></i> {2}</span>", statusClass, icon, labelText));
    }
}

@{
    var modelData = Model ?? new FGA.Models.Dashboard();
    var inv = System.Globalization.CultureInfo.InvariantCulture;

    decimal suficienciaVal = GetVal(modelData.Suficiencia, 1);
    decimal suficienciaPrev = GetVal(modelData.Suficiencia, 0);
    int sufPct = (int)Math.Min(100, Math.Max(12, suficienciaVal > 0 ? (suficienciaVal / 15m) * 100m : 12m));

    decimal compromisoVal = GetVal(modelData.Compromiso, 1);
    decimal compromisoPrev = GetVal(modelData.Compromiso, 0);
    decimal compromisoVar = compromisoVal - compromisoPrev;
    decimal compromisoVarPct = compromisoPrev != 0 ? (compromisoVar / compromisoPrev) * 100 : 0;
    int compPct = (int)Math.Min(100, Math.Max(12, compromisoVal > 0 ? (compromisoVal / 20m) * 100m : 12m));

    decimal costoVal = GetVal(modelData.CostoAdmin, 1);
    decimal costoPrev = GetVal(modelData.CostoAdmin, 0);
    int efPct = (int)Math.Min(100, Math.Max(12, costoVal > 0 ? (costoVal / 70m) * 100m : 12m));

    decimal morosidadVal = GetVal(modelData.Morosidad, 1);
    decimal morosidadPrev = GetVal(modelData.Morosidad, 0);
    int morPct = (int)Math.Min(100, Math.Max(12, morosidadVal > 0 ? (morosidadVal / 6m) * 100m : 12m));

    decimal activoVal = GetVal(modelData.Activo, 1);
    decimal activoPrev = GetVal(modelData.Activo, 0);
    decimal activoVar = activoVal - activoPrev;
    decimal activoVarPct = activoPrev != 0 ? (activoVar / activoPrev) * 100 : 0;

    decimal riesgoVal = GetVal(modelData.Riesgo, 1);
    decimal riesgoPrev = GetVal(modelData.Riesgo, 0);
    decimal riesgoVar = riesgoVal - riesgoPrev;
    decimal riesgoVarPct = riesgoPrev != 0 ? (riesgoVar / riesgoPrev) * 100 : 0;

    decimal resultadoVal = GetVal(modelData.ResultadoPeriodo, 1);
    decimal resultadoPrev = GetVal(modelData.ResultadoPeriodo, 0);
    decimal resultadoVar = resultadoVal - resultadoPrev;
    decimal resultadoVarPct = resultadoPrev != 0 ? (resultadoVar / Math.Abs(resultadoPrev)) * 100 : 0;

    decimal carteraVal = GetVal(modelData.CarteraCredito, 1);
    decimal carteraPrev = GetVal(modelData.CarteraCredito, 0);
    decimal carteraVar = carteraVal - carteraPrev;
    decimal carteraVarPct = carteraPrev != 0 ? (carteraVar / Math.Abs(carteraPrev)) * 100 : 0;

    decimal obligVal = GetVal(modelData.ObligacionesPublico, 1);
    decimal obligPrev = GetVal(modelData.ObligacionesPublico, 0);
    decimal obligVar = obligVal - obligPrev;
    decimal obligVarPct = obligPrev != 0 ? (obligVar / Math.Abs(obligPrev)) * 100 : 0;
}

<div class="row">
    <div id="dashboard" style="visibility:hidden; position: fixed">
        <div style="border: 1px solid yellow; background-color: white; margin: 5px; text-align: center;">
            <label class="h3" id="lbl_encabezado"></label>
        </div>
    </div>
</div>

<!-- ==================== FILA SUPERIOR: KPIS + CUENTAS + INDICADORES ==================== -->
<div class="dashboard-top-grid">
    
    <!-- Left 9 columns: 3 Sparkline KPI Cards + Cuentas Principales -->
    <div style="grid-column: span 9; display: flex; flex-direction: column; justify-content: flex-start; gap: 20px;">
        
        <!-- 3 Sparkline KPI Cards -->
        <div class="kpi-cards-wrapper">
            
            <!-- KPI 1: Suficiencia Patrimonial -->
            <div class="modern-kpi-card clickable-kpi-card" onclick="getGraph('S1')" title="Ampliar gr&aacute;fica detallada" role="button" tabindex="0">
                <div class="kpi-title">
                    <span>Suficiencia Patrimonial</span>
                    @SemaphoreBadge("suficiencia", suficienciaVal)
                    <span class="kpi-expand-btn" style="margin-left:auto; color:#94a3b8;" title="Ampliar gr&aacute;fica"><i class="fa fa-line-chart"></i></span>
                </div>
                <div class="kpi-value-row">
                    <div class="kpi-big-num">@FormatVal(modelData.Suficiencia, 1, "N2", "%")</div>
                    @TrendPill(suficienciaVal, suficienciaPrev, false)
                </div>
                <div class="kpi-sparkline-container" id="sparkline_suficiencia"></div>
                <div class="kpi-target-bar-wrapper">
                    <div class="target-bar-info">
                        <span>Meta SUGEF: 10.00%</span>
                        <span>@(suficienciaVal >= 10m ? "Superada (+" + (suficienciaVal - 10m).ToString("N2") + "%)" : "Alerta")</span>
                    </div>
                    <div class="target-bar-track">
                        <div class="target-bar-fill @(suficienciaVal >= 10m ? "success" : "warning")" style="width: @(sufPct)%;"></div>
                    </div>
                </div>
            </div>

            <!-- KPI 2: Compromiso Patrimonial -->
            <div class="modern-kpi-card clickable-kpi-card" onclick="getGraph('C3')" title="Ampliar gr&aacute;fica detallada" role="button" tabindex="0">
                <div class="kpi-title">
                    <span>Compromiso Patrimonial</span>
                    @SemaphoreBadge("compromiso", compromisoVal)
                    <span class="kpi-expand-btn" style="margin-left:auto; color:#94a3b8;" title="Ampliar gr&aacute;fica"><i class="fa fa-line-chart"></i></span>
                </div>
                <div class="kpi-value-row">
                    <div class="kpi-big-num">@FormatVal(modelData.Compromiso, 1, "N2", "%")</div>
                    @TrendPill(compromisoVal, compromisoPrev, true)
                </div>
                <div class="kpi-sparkline-container" id="sparkline_compromiso"></div>
                <div class="kpi-target-bar-wrapper">
                    <div class="target-bar-info">
                        <span>Meta SUGEF: &le; 0.00%</span>
                        <span>@Html.Raw(compromisoVal <= 0m ? "Sin Compromiso (" + compromisoVal.ToString("N2") + "%)" : (compromisoVal <= 10m ? "Tolerable (&le;10%)" : (compromisoVal <= 20m ? "Bajo Observaci&oacute;n" : "Alerta &gt;20%")))</span>
                    </div>
                    <div class="target-bar-track">
                        <div class="target-bar-fill @(compromisoVal <= 10m ? "success" : (compromisoVal <= 20m ? "warning" : "danger"))" style="width: @(compPct)%;"></div>
                    </div>
                </div>
            </div>

            <!-- KPI 3: Morosidad mayor a 90 d&iacute;as -->
            <div class="modern-kpi-card clickable-kpi-card" onclick="getGraph('C22')" title="Ampliar gr&aacute;fica detallada" role="button" tabindex="0">
                <div class="kpi-title">
                    <span>Morosidad mayor a 90 d&iacute;as</span>
                    @SemaphoreBadge("morosidad", morosidadVal)
                    <span class="kpi-expand-btn" style="margin-left:auto; color:#94a3b8;" title="Ampliar gr&aacute;fica"><i class="fa fa-line-chart"></i></span>
                </div>
                <div class="kpi-value-row">
                    <div class="kpi-big-num">@FormatVal(modelData.Morosidad, 1, "N2", "%")</div>
                    @TrendPill(morosidadVal, morosidadPrev, true)
                </div>
                <div class="kpi-sparkline-container" id="sparkline_morosidad"></div>
                <div class="kpi-target-bar-wrapper">
                    <div class="target-bar-info">
                        <span>Umbral Regulativo: 3.00%</span>
                        <span>@(morosidadVal <= 3m ? "Controlado" : "+" + (morosidadVal - 3m).ToString("N2") + "% excedido")</span>
                    </div>
                    <div class="target-bar-track">
                        <div class="target-bar-fill @(morosidadVal <= 3m ? "success" : (morosidadVal <= 5m ? "warning" : "danger"))" style="width: @(morPct)%;"></div>
                    </div>
                </div>
            </div>

        </div>

        <!-- Cuentas Principales -->
        <div class="cuentas-principales-wrapper" style="margin-bottom: 0;">
            <div class="section-header-title">Cuentas principales (&#8353; Millones)</div>
            
            <div class="cuentas-cards-grid">
                
                <!-- Cuenta 1: Resultado del período acumulado -->
                <div class="cuenta-card">
                    <div class="cuenta-card-header">
                        <div class="icon-circle-teal"><i class="fa fa-bar-chart"></i></div>
                        <div class="cuenta-title">Resultado del periodo acumulado</div>
                    </div>
                    <div class="cuenta-big-value">@FormatVal(modelData.ResultadoPeriodo, 1, "N0", "")</div>
                    <div class="cuenta-subtable">
                        <div class="subtable-col">
                            <label>Periodo anterior</label>
                            <span>@FormatVal(modelData.ResultadoPeriodo, 0, "N0", "")</span>
                        </div>
                        <div class="subtable-col @(resultadoVar > 0 ? "val-positive" : (resultadoVar < 0 ? "val-negative" : ""))">
                            <label>Variaci&oacute;n</label>
                            <span>@resultadoVar.ToString("N0")</span>
                        </div>
                        <div class="subtable-col badge-cell @(resultadoVarPct > 0 ? "positive" : (resultadoVarPct < 0 ? "negative" : ""))">
                            <label>Variaci&oacute;n %</label>
                            <span>@resultadoVarPct.ToString("N2")%</span>
                        </div>
                    </div>
                </div>

                <!-- Cuenta 2: Cartera de crédito -->
                <div class="cuenta-card">
                    <div class="cuenta-card-header">
                        <div class="icon-circle-blue"><i class="fa fa-credit-card"></i></div>
                        <div class="cuenta-title">Cartera de cr&eacute;dito</div>
                    </div>
                    <div class="cuenta-big-value">@FormatVal(modelData.CarteraCredito, 1, "N0", "")</div>
                    <div class="cuenta-subtable">
                        <div class="subtable-col">
                            <label>Periodo anterior</label>
                            <span>@FormatVal(modelData.CarteraCredito, 0, "N0", "")</span>
                        </div>
                        <div class="subtable-col @(carteraVar > 0 ? "val-positive" : (carteraVar < 0 ? "val-negative" : ""))">
                            <label>Variaci&oacute;n</label>
                            <span>@carteraVar.ToString("N0")</span>
                        </div>
                        <div class="subtable-col badge-cell @(carteraVarPct > 0 ? "positive" : (carteraVarPct < 0 ? "negative" : ""))">
                            <label>Variaci&oacute;n %</label>
                            <span>@carteraVarPct.ToString("N2")%</span>
                        </div>
                    </div>
                </div>

                <!-- Cuenta 3: Obligaciones con el público -->
                <div class="cuenta-card">
                    <div class="cuenta-card-header">
                        <div class="icon-circle-orange"><i class="fa fa-database"></i></div>
                        <div class="cuenta-title">Obligaciones con el p&uacute;blico</div>
                    </div>
                    <div class="cuenta-big-value">@FormatVal(modelData.ObligacionesPublico, 1, "N0", "")</div>
                    <div class="cuenta-subtable">
                        <div class="subtable-col">
                            <label>Periodo anterior</label>
                            <span>@FormatVal(modelData.ObligacionesPublico, 0, "N0", "")</span>
                        </div>
                        <div class="subtable-col @(obligVar > 0 ? "val-positive" : (obligVar < 0 ? "val-negative" : ""))">
                            <label>Variaci&oacute;n</label>
                            <span>@obligVar.ToString("N0")</span>
                        </div>
                        <div class="subtable-col badge-cell @(obligVarPct > 0 ? "positive" : (obligVarPct < 0 ? "negative" : ""))">
                            <label>Variaci&oacute;n %</label>
                            <span>@obligVarPct.ToString("N2")%</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>

    </div>

    <!-- Right 3 columns: Indicadores Panel -->
    <div class="side-indicators-wrapper">
        <div class="modern-indicators-panel">
            <div class="indicators-panel-title">Indicadores</div>
            
            <div class="indicator-item">
                <span class="indicator-name">Gastos De Administraci&oacute;n / Utilidad Operacional Bruta</span>
                <div class="indicator-val-group">
                    <span class="indicator-main-val">@FormatVal(modelData.CostoAdmin, 1, "N2", "%")</span>
                    @IndicatorTrendBadge(costoVal, costoPrev, "N2", "%", true)
                </div>
            </div>

            <div class="indicator-item">
                <span class="indicator-name">Cartera con morosidad mayor a 90 d&iacute;as / Cartera Directa</span>
                <div class="indicator-val-group">
                    <span class="indicator-main-val">@FormatVal(modelData.Morosidad, 1, "N2", "%")</span>
                    @IndicatorTrendBadge(morosidadVal, morosidadPrev, "N2", "%", true)
                </div>
            </div>

            <div class="indicator-item">
                <span class="indicator-name">Riesgo por tasas de inter&eacute;s colones</span>
                <div class="indicator-val-group">
                    <span class="indicator-main-val">@FormatVal(modelData.Riesgo, 1, "N2", "%")</span>
                    @IndicatorTrendBadge(riesgoVal, riesgoPrev, "N2", "%", true)
                </div>
            </div>

            <div class="indicator-item">
                <span class="indicator-name">Rentabilidad nominal / Patrimonio promedio</span>
                <div class="indicator-val-group">
                    <span class="indicator-main-val">@FormatVal(modelData.Rentabilidad, 1, "N2", "%")</span>
                    @IndicatorTrendBadge(GetVal(modelData.Rentabilidad, 1), GetVal(modelData.Rentabilidad, 0), "N2", "%", false)
                </div>
            </div>

            <div class="indicator-item">
                <span class="indicator-name">Estimaciones sobre cartera / Mora mayor a 90 d&iacute;as y cobro judicial</span>
                <div class="indicator-val-group">
                    <span class="indicator-main-val">@FormatVal(modelData.EstimacionesMora, 1, "N2", "%")</span>
                    @IndicatorTrendBadge(GetVal(modelData.EstimacionesMora, 1), GetVal(modelData.EstimacionesMora, 0), "N2", "%", false)
                </div>
            </div>

            <div class="indicator-item">
                <span class="indicator-name">P&eacute;rdida Esperada Cartera Total / Cartera Total</span>
                <div class="indicator-val-group">
                    <span class="indicator-main-val">@FormatVal(modelData.PerdidaEsperada, 1, "N2", "%")</span>
                    @IndicatorTrendBadge(GetVal(modelData.PerdidaEsperada, 1), GetVal(modelData.PerdidaEsperada, 0), "N2", "%", true)
                </div>
            </div>

            <div class="indicator-item">
                <span class="indicator-name">Utilidad Acumulada / Patrimonio Promedio Trimestral</span>
                <div class="indicator-val-group">
                    <span class="indicator-main-val">@FormatVal(modelData.PerdidaAcumulada, 1, "N2", "%")</span>
                    @IndicatorTrendBadge(GetVal(modelData.PerdidaAcumulada, 1), GetVal(modelData.PerdidaAcumulada, 0), "N2", "%", false)
                </div>
            </div>

            <div class="indicator-item">
                <span class="indicator-name">ICL colones</span>
                <div class="indicator-val-group">
                    <span class="indicator-main-val">@FormatVal(modelData.ICL, 1, "N2", "%")</span>
                    @IndicatorTrendBadge(GetVal(modelData.ICL, 1), GetVal(modelData.ICL, 0), "N2", "%", false)
                </div>
            </div>

            <div class="indicator-item">
                <span class="indicator-name">I-H de los 100 deudores m&aacute;s representativos</span>
                <div class="indicator-val-group">
                    <span class="indicator-main-val">@FormatVal(modelData.Deudores100, 1, "N2", "")</span>
                    @IndicatorTrendBadge(GetVal(modelData.Deudores100, 1), GetVal(modelData.Deudores100, 0), "N2", "", true)
                </div>
            </div>

            <div class="indicator-item">
                <span class="indicator-name">Inversiones en t&iacute;tulos valores / Activo productivo</span>
