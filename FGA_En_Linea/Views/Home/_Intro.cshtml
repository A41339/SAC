<div id="detail" class="row">
    <div class="col-sm-12">
        <div class="grid-container">
            <div class="box span-3rows">
                <div class="box">
                    <div class="box-header">
                        <h4 class="box-title">Nivel y Calidad del Capital</h4>
                        <div class="text-right">
                            <a class="text-right" data-toggle="tooltip" data-placement="top" title="Nivel y Calidad del Capital" href="javascript:mSuficiencia()"><i class="btn btn-xs btn-info icon fa fa-line-chart"></i></a>
                          
                        </div>
                    </div>
                    <div class="">
                        <div class="row flip-boxes">
                            <div class="text-center">
                                <div class="flip-box">
                                    <div class="front">
                                        <div class="text-center">
                                            <div>
                                                <div class="">
                                                    <div id="wrapper" style="display: flex; justify-content: space-around; flex-wrap: wrap;"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="back">
                                        <br />
                                        <h4 style="color: #2c3e50;
                                              font-size: 16px;
                                              font-weight: bold;
                                              font-family: Arial, sans-serif;
                                              text-shadow: 1px 1px #ccc;">
                                            Suficiencia
                                        </h4>
                                        <div class='my-legend'>
                                            <div style="display: flex; justify-content: center;">
                                                <div class='legend-scale'>
                                                    <ul class='legend-labels'>
                                                        <li><span style='background: #0f9747;'></span> @((!Model.prudencial ? "> 14" : "> 16"))</li>
                                                        <li><span style='background: #bdecb6;'></span> @((!Model.prudencial ? "14 > x >= 10" : "16 > x >= 12"))</li>
                                                        <li><span style='background: #fdae19;'></span> @((!Model.prudencial ? "10 > x >= 8" : "12 > x >= 9"))</li>
                                                        <li><span style='background: #ee1f25;'></span> @((!Model.prudencial ? "< 8" : "< 9"))</li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- CN1 -->
                                        <br /><br />
                                        <h4 style="color: #2c3e50;
                                          font-size: 16px;
                                          font-weight: bold;
                                          font-family: Arial, sans-serif;
                                          text-shadow: 1px 1px #ccc;">
                                            CN1
                                        </h4>
                                        <div class='my-legend'>
                                            <div style="display: flex; justify-content: center;">
                                                <div class='legend-scale'>
                                                    <ul class='legend-labels'>
                                                        <li><span style='background: #0f9747;'></span> @((!Model.prudencial ? "> 10" : "> 12.5"))</li>
                                                        <li><span style='background: #bdecb6;'></span> @((!Model.prudencial ? "10 > x >= 8" : "12.5 > x >= 10"))</li>
                                                        <li><span style='background: #fdae19;'></span> @((!Model.prudencial ? "7 > x >= 6" : "10 > x >= 7"))</li>
                                                        <li><span style='background: #ee1f25;'></span> @((!Model.prudencial ? "< 6" : "< 7"))</li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- CNN1 -->
                                        <br /><br />
                                        <h4 style="color: #2c3e50;
                                          font-size: 16px;
                                          font-weight: bold;
                                          font-family: Arial, sans-serif;
                                          text-shadow: 1px 1px #ccc;">
                                            CNN1
                                        </h4>
                                        <div class='my-legend'>
                                            <div style="display: flex; justify-content: center;">
                                                <div class='legend-scale'>
                                                    <ul class='legend-labels'>
                                                        <li><span style='background: #0f9747;'></span> @((!Model.prudencial ? "> 7.5" : "> 11"))</li>
                                                        <li><span style='background: #bdecb6;'></span> @((!Model.prudencial ? "7.5 > x >= 6.5" : "11 > x >= 8.5"))</li>
                                                        <li><span style='background: #fdae19;'></span> @((!Model.prudencial ? "6.5 > x >= 4.5" : "8.5 > x >= 6.5"))</li>                                                        
                                                        <li><span style='background: #ee1f25;'></span> @((!Model.prudencial ? "< 4.5" : "< 6.5"))</li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- APALANCAMIENTO -->
                                        <br /><br />
                                        <h4 style="color: #2c3e50;
                                          font-size: 16px;
                                          font-weight: bold;
                                          font-family: Arial, sans-serif;
                                          text-shadow: 1px 1px #ccc;">
                                            Apalancamiento
                                        </h4>
                                        <div class='my-legend'>
                                            <div style="display: flex; justify-content: center;">
                                                <div class='legend-scale'>
                                                    <ul class='legend-labels'>
                                                        <li><span style='background: #0f9747;'></span> @((!Model.prudencial ? "> 6" : "> 8"))</li>
                                                        <li><span style='background: #bdecb6;'></span> @((!Model.prudencial ? "6 > x >= 5" : "8 > x >= 7"))</li>
                                                        <li><span style='background: #fdae19;'></span> @((!Model.prudencial ? "5 > x >= 3" : "7 > x >= 4"))</li>
                                                        <li><span style='background: #ee1f25;'></span> @((!Model.prudencial ? "< 3" : "< 4"))</li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="box">
                <div class="box-header">
                    <h4 class="box-title">Compromiso patrimonial</h4>
                    <div class="text-right">
                        <a class="text-right" data-toggle="tooltip" data-placement="top" title="Comportamiento histórico" href="javascript:getGraph('C3')"><i class="btn btn-xs btn-info icon fa fa-line-chart"></i></a>
                        <a class="text-right" data-toggle="tooltip" data-placement="top" id="btn_compromiso" title="Imprimir"><i class="btn btn-xs btn-danger icon fa fa-save"></i></a>
                        <a class="text-right" data-toggle="tooltip" data-placement="top" title="Definición"
