@model  FGA.Models.Dashboard

<script src="https://code.highcharts.com/highcharts.js"></script>

<div class="row">
    <div id="dashboard" style="visibility:hidden; position: fixed">
        <div style="border: 1px solid yellow; background-color: white; margin: 5px; text-align: center;">
            <label class="h3" id="lbl_encabezado"></label>
        </div>
    </div>
</div>

<!-- ==================== FILA SUPERIOR: KPIS + INDICADORES ==================== -->
<div class="dashboard-top-grid">
    
    <!-- Left 9 columns: 3 Sparkline KPI Cards -->
    <div class="kpi-cards-wrapper">
        
        <!-- KPI 1: Suficiencia Patrimonial -->
        <div class="modern-kpi-card">
            <div class="kpi-title">Suficiencia Patrimonial</div>
            <div class="kpi-value-row">
                <div class="kpi-big-num">19.9%</div>
                <div class="trend-arrow-up"><i class="fa fa-arrow-up"></i></div>
            </div>
            <div class="kpi-sparkline-container" id="sparkline_suficiencia"></div>
        </div>

        <!-- KPI 2: Eficiencia -->
        <div class="modern-kpi-card">
            <div class="kpi-title">Eficiencia</div>
            <div class="kpi-value-row">
                <div class="kpi-big-num">50.2%</div>
                <div class="trend-arrow-up"><i class="fa fa-arrow-up"></i></div>
            </div>
            <div class="kpi-sparkline-container" id="sparkline_eficiencia"></div>
        </div>

        <!-- KPI 3: Morosidad mayor a 90 días -->
        <div class="modern-kpi-card">
            <div class="kpi-title">Morosidad mayor a 90 días</div>
            <div class="kpi-value-row">
                <div class="kpi-big-num">1.88%</div>
                <div class="trend-arrow-down"><i class="fa fa-arrow-down"></i></div>
            </div>
            <div class="kpi-sparkline-container" id="sparkline_morosidad"></div>
        </div>

    </div>

    <!-- Right 3 columns: Indicadores Panel -->
    <div class="side-indicators-wrapper">
        <div class="modern-indicators-panel">
            <div class="indicators-panel-title">Indicadores</div>
            
            <div class="indicator-item">
                <span class="indicator-name">Gastos De Administración / Utilidad Operacional Bruta</span>
                <div class="indicator-val-group">
                    <span>76.75</span>
                    <i class="fa fa-arrow-up trend-arrow-up"></i>
                </div>
            </div>

            <div class="indicator-item">
                <span class="indicator-name">Cartera con morosidad mayor a 90 días / Cartera Directa</span>
                <div class="indicator-val-group">
                    <span>1.60%</span>
                    <i class="fa fa-arrow-down trend-arrow-down"></i>
                </div>
            </div>

            <div class="indicator-item">
                <span class="indicator-name">Margen financiero / Activos</span>
                <div class="indicator-val-group">
                    <span>1.66%</span>
                    <i class="fa fa-arrow-up trend-arrow-up"></i>
                </div>
            </div>

            <div class="indicator-item">
                <span class="indicator-name">Rentabilidad nominal / Patrimonio promedio</span>
                <div class="indicator-val-group">
                    <span>8.40%</span>
                    <i class="fa fa-arrow-up trend-arrow-up"></i>
                </div>
            </div>

            <div class="indicator-item">
                <span class="indicator-name">Estimaciones sobre cartera de créditos / Cartera con mora mayor a 90 días y cobro judicial</span>
                <div class="indicator-val-group">
                    <span>1.78x</span>
                    <i class="fa fa-arrow-right" style="color:#eab308"></i>
                </div>
            </div>

            <div class="indicator-item">
                <span class="indicator-name">Pérdida Esperada Cartera Total / Estimación por deterioro de cartera</span>
                <div class="indicator-val-group">
                    <span>1.70%</span>
                    <i class="fa fa-arrow-down trend-arrow-down"></i>
                </div>
            </div>

            <div class="indicator-item">
                <span class="indicator-name">Utilidad o pérdida acumulada trimestral</span>
                <div class="indicator-val-group">
                    <span>1.70%</span>
                    <i class="fa fa-arrow-up trend-arrow-up"></i>
                </div>
            </div>

            <div class="indicator-item">
                <span class="indicator-name">ICL colones</span>
                <div class="indicator-val-group">
                    <span>9.41x</span>
                    <i class="fa fa-arrow-up trend-arrow-up"></i>
                </div>
            </div>

            <div class="indicator-item">
                <span class="indicator-name">Concentración de los 20 inversionistas</span>
                <div class="indicator-val-group">
                    <span>1.25x</span>
                    <i class="fa fa-arrow-right" style="color:#eab308"></i>
                </div>
            </div>

            <div class="indicator-item">
                <span class="indicator-name">Inversiones en títulos valores / Activo productivo</span>
                <div class="indicator-val-group">
                    <span>12.3%</span>
                    <i class="fa fa-arrow-up trend-arrow-up"></i>
                </div>
            </div>

            <div class="indicator-item">
                <span class="indicator-name">Captaciones a plazo con el público / Pasivo con costo</span>
                <div class="indicator-val-group">
                    <span>78.6%</span>
                    <i class="fa fa-arrow-down trend-arrow-down"></i>
                </div>
            </div>

        </div>
    </div>

</div>

<!-- ==================== FILA CENTRAL: CUENTAS PRINCIPALES ==================== -->
<div class="cuentas-principales-wrapper">
    <div class="section-header-title">Cuentas principales (₡ Millones)</div>
    
    <div class="cuentas-cards-grid">
        
        <!-- Cuenta 1: Resultado del período acumulado -->
        <div class="cuenta-card">
            <div class="cuenta-card-header">
                <div class="icon-circle-teal"><i class="fa fa-bar-chart"></i></div>
                <div class="cuenta-title">Resultado del período acumulado</div>
            </div>
            <div class="cuenta-big-value">2,100</div>
            <div class="cuenta-subtable">
                <div class="subtable-col">
                    <label>Período anterior</label>
                    <span>1,250</span>
                </div>
                <div class="subtable-col">
                    <label>Variación</label>
                    <span>850</span>
                </div>
                <div class="subtable-col">
                    <label>Variación %</label>
                    <span>68.0%</span>
                </div>
            </div>
        </div>

        <!-- Cuenta 2: Cartera de crédito -->
        <div class="cuenta-card">
            <div class="cuenta-card-header">
                <div class="icon-circle-blue"><i class="fa fa-credit-card"></i></div>
                <div class="cuenta-title">Cartera de crédito</div>
            </div>
            <div class="cuenta-big-value">466,980</div>
            <div class="cuenta-subtable">
                <div class="subtable-col">
                    <label>Período anterior</label>
                    <span>450,280</span>
                </div>
                <div class="subtable-col">
                    <label>Variación</label>
                    <span>16,700</span>
                </div>
                <div class="subtable-col">
                    <label>Variación %</label>
                    <span>3.7%</span>
                </div>
            </div>
        </div>

        <!-- Cuenta 3: Obligaciones con el público -->
        <div class="cuenta-card">
            <div class="cuenta-card-header">
                <div class="icon-circle-orange"><i class="fa fa-database"></i></div>
                <div class="cuenta-title">Obligaciones con el público</div>
            </div>
            <div class="cuenta-big-value">412,300</div>
            <div class="cuenta-subtable">
                <div class="subtable-col">
                    <label>Período anterior</label>
                    <span>380,150</span>
                </div>
                <div class="subtable-col">
                    <label>Variación</label>
                    <span>32,150</span>
                </div>
                <div class="subtable-col">
                    <label>Variación %</label>
                    <span>8.5%</span>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- ==================== FILA INFERIOR: CALIDAD DE LA CARTERA ==================== -->
<div class="cartera-table-container">
    <div class="section-header-title">Calidad de la Cartera</div>
    
    <table class="modern-table">
        <thead>
            <tr>
                <th>Rango de días</th>
                <th>Saldo (₡ MM)</th>
                <th>Participación</th>
                <th>Variación mensual</th>
                <th>Variación interanual</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Al día</td>
                <td>450,280</td>
                <td>96.58%</td>
                <td>1.2%</td>
                <td>4.3%</td>
            </tr>
            <tr>
                <td>1 - 30 días</td>
                <td>5,200</td>
                <td>1.12%</td>
                <td>-0.3%</td>
                <td>12.5%</td>
            </tr>
            <tr>
                <td>31 - 60 días</td>
                <td>3,950</td>
                <td>0.85%</td>
                <td>0.1%</td>
                <td>18.7%</td>
            </tr>
            <tr>
                <td>61 - 90 días</td>
                <td>2,800</td>
                <td>0.60%</td>
                <td>0.2%</td>
                <td>25.4%</td>
            </tr>
            <tr>
                <td>91 - 180 días</td>
                <td>1,250</td>
                <td>0.27%</td>
                <td>0.1%</td>
                <td>20.6%</td>
            </tr>
            <tr>
                <td>Más de 180 días</td>
                <td>1,000</td>
                <td>0.21%</td>
                <td>-0.1%</td>
                <td>15.8%</td>
            </tr>
            <tr>
                <td>Cobro Judicial</td>
                <td>1,700</td>
                <td>0.36%</td>
                <td>0.0%</td>
                <td>22.1%</td>
            </tr>
            <tr class="total-row">
                <td>Total Cartera</td>
                <td>466,980</td>
                <td>100.00%</td>
                <td>0.8%</td>
                <td>14.3%</td>
            </tr>
        </tbody>
    </table>
</div>

<!-- Highcharts Sparkline Initialization -->
<script>
    $(document).ready(function () {
        function createSparkline(containerId, dataArray, lineColor) {
            Highcharts.chart(containerId, {
                chart: {
                    type: 'area',
                    backgroundColor: null,
                    borderWidth: 0,
                    margin: [2, 0, 2, 0],
                    height: 45,
                    style: { overflow: 'visible' }
                },
                title: { text: '' },
                credits: { enabled: false },
                xAxis: { labels: { enabled: false }, title: { text: null }, startOnTick: false, endOnTick: false, tickPositions: [] },
                yAxis: { endOnTick: false, startOnTick: false, labels: { enabled: false }, title: { text: null }, tickPositions: [0] },
                legend: { enabled: false },
                tooltip: { enabled: false },
                plotOptions: {
                    series: {
                        animation: false,
                        lineWidth: 2,
                        shadow: false,
                        states: { hover: { lineWidth: 2 } },
                        marker: { radius: 2 },
                        fillOpacity: 0.15
                    }
                },
                series: [{
                    data: dataArray,
                    color: lineColor
                }]
            });
        }

        createSparkline('sparkline_suficiencia', [16.2, 17.5, 16.8, 18.2, 17.1, 19.9], '#2563eb');
        createSparkline('sparkline_eficiencia', [45.1, 46.8, 44.2, 48.0, 47.3, 50.2], '#2563eb');
        createSparkline('sparkline_morosidad', [2.4, 2.1, 2.3, 1.9, 2.0, 1.88], '#0d7682');
    });
</script>
