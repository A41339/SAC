@model IEnumerable<FGA.Models.FileModel>
@{
    ViewBag.Title = "Descarga de archivos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content-header">
    <h1>
        <i class="fa fa-folder-open" style="color: #0284c7; margin-right: 8px;"></i>
        Descarga de archivos
    </h1>
</section>

<section class="content">
    <div id="listpane">
        @Html.Partial("FileList", Model)
    </div>
</section>
