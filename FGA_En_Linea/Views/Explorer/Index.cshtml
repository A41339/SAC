@model IEnumerable<FGA.Models.FileModel>
@{
    ViewBag.Title = "Hist\u00f3rico de Cargas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content-header">
    <h1 class="modern-page-title">
        <i class="fa fa-history" style="color: #0284c7;"></i>
        Hist&oacute;rico de Cargas
        <small>Explorador y descarga de archivos del sistema</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="@Url.Action("Index", "Modulo", new { id = 7000 })" class="breadcrumb-parent-pill" title="Volver a Carga de Datos"><i class="fa fa-database" style="margin-right: 4px;"></i> Carga de Datos</a></li>
        <li class="active">Hist&oacute;rico de Cargas</li>
    </ol>
</section>

<section class="content">
    <div id="listpane">
        @Html.Partial("FileList", Model)
    </div>
</section>
