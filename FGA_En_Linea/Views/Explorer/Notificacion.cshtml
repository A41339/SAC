@{
    ViewBag.Title = "Notificaciones";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content-header" style="padding: 24px 20px 14px 20px;">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
        <div>
            <h1 style="margin: 0; font-size: 21px; font-weight: 700; color: #143750; display: flex; align-items: center; gap: 10px;">
                <i class="fa fa-bell-o" style="color: #0284c7;"></i>
                Envío de Notificaciones
            </h1>
            <p style="margin: 6px 0 0 0; font-size: 13px; color: #64748b;">
                Redacte y transmita comunicados generales a los usuarios del sistema.
            </p>
        </div>
    </div>
</section>

<section class="content">   
    <div class="row">
        <div class="col-xs-12">
            <div class="modern-table-card" style="border: 1px solid #e2e8f0; border-radius: 12px; background: #ffffff; box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05); overflow: hidden; margin-bottom: 24px;">
                
                <!-- Encabezado de la tarjeta -->
                <div style="padding: 18px 24px; background: #f8fafc; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; gap: 14px;">
                    <div style="width: 42px; height: 42px; border-radius: 10px; background: linear-gradient(135deg, #143750 0%, #0d7377 100%); color: #ffffff; display: flex; align-items: center; justify-content: center; font-size: 18px; box-shadow: 0 4px 12px rgba(20, 55, 80, 0.25); flex-shrink: 0;">
                        <i class="fa fa-paper-plane"></i>
                    </div>
                    <div>
                        <h3 style="margin: 0; font-size: 15px; font-weight: 700; color: #143750;">Incluya los datos de la notificación</h3>
                        <p style="margin: 3px 0 0 0; font-size: 12px; color: #64748b;">Complete el asunto y el mensaje que desea transmitir.</p>
                    </div>
                </div>

                <!-- Formulario -->
                <div style="padding: 24px;">
                    <div class="form-group" style="margin-bottom: 20px;">
                        <label for="lbl_asunto" style="font-size: 12px; font-weight: 600; color: #475569; margin-bottom: 6px; display: flex; align-items: center; gap: 6px;">
                            <i class="fa fa-tag" style="color: #0284c7;"></i> Asunto del Mensaje
                        </label>
                        <input class="form-control modern-select" id="lbl_asunto" placeholder="Ingrese el asunto de la notificación..." style="width: 100%; height: 38px; font-size: 13px;">
                    </div>

                    <div class="form-group" style="margin-bottom: 0;">
                        <label for="compose-textarea" style="font-size: 12px; font-weight: 600; color: #475569; margin-bottom: 6px; display: flex; align-items: center; gap: 6px;">
                            <i class="fa fa-align-left" style="color: #0284c7;"></i> Contenido del Mensaje
                        </label>
                        @Html.TextArea("compose-textarea", "", new { @id = "compose-textarea", @class = "form-control", @style = "height: 280px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 13px;" })
                    </div>
                </div>

                <!-- Pie con botón de envío -->
                <div style="padding: 16px 24px; background: #f8fafc; border-top: 1px solid #e2e8f0; display: flex; justify-content: flex-end;">
                    <button type="button" onclick="javascript:EnviarNotificacion();" class="btn-modern-filter" style="padding: 10px 28px; font-size: 14px; border-radius: 8px; font-weight: 600; height: 42px;">
                        <i class="fa fa-paper-plane" style="margin-right: 8px;"></i> Enviar Notificación
                    </button>
                </div>

            </div>
        </div>
    </div>
</section>

<!-- Modal Error -->
<div id="modalError" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sm" style="max-width: 440px; margin: 80px auto;">
        <div class="modal-content" style="border-radius: 14px; overflow: hidden; border: none; box-shadow: 0 12px 36px rgba(0,0,0,0.25);">
            <div class="modal-body" style="padding: 30px 24px 20px; text-align: center; background: #ffffff;">
                <div style="width: 56px; height: 56px; border-radius: 50%; background: #fee2e2; color: #ef4444; display: inline-flex; align-items: center; justify-content: center; font-size: 26px; margin-bottom: 16px;">
                    <i class="fa fa-exclamation-triangle"></i>
                </div>
                <h4 style="margin: 0 0 8px 0; font-size: 16px; font-weight: 700; color: #1e293b;">Error al enviar</h4>
                <p id="lbl_mensajeError" style="font-size: 13px; color: #64748b; margin: 0; line-height: 1.5;">Ha ocurrido un error.</p>
            </div>
            <div class="modal-footer" style="background: #f8fafc; border-top: 1px solid #f1f5f9; padding: 12px 20px; display: flex; justify-content: center;">
                <button type="button" class="btn-modern-filter" data-dismiss="modal" style="width: 100%; border-radius: 8px; background: #ef4444; border-color: #ef4444; box-shadow: none;">
                    Aceptar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Éxito -->
<div id="modalSuccess" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sm" style="max-width: 440px; margin: 80px auto;">
        <div class="modal-content" style="border-radius: 14px; overflow: hidden; border: none; box-shadow: 0 12px 36px rgba(0,0,0,0.25);">
            <div class="modal-body" style="padding: 30px 24px 20px; text-align: center; background: #ffffff;">
                <div style="width: 56px; height: 56px; border-radius: 50%; background: #dcfce7; color: #16a34a; display: inline-flex; align-items: center; justify-content: center; font-size: 28px; margin-bottom: 16px;">
                    <i class="fa fa-check"></i>
                </div>
                <h4 style="margin: 0 0 8px 0; font-size: 16px; font-weight: 700; color: #1e293b;">¡Notificación Enviada!</h4>
                <p id="lbl_mensajeExito" style="font-size: 13px; color: #64748b; margin: 0; line-height: 1.5;"></p>
            </div>
            <div class="modal-footer" style="background: #f8fafc; border-top: 1px solid #f1f5f9; padding: 12px 20px; display: flex; justify-content: center;">
                <button type="button" class="btn-modern-filter" data-dismiss="modal" style="width: 100%; border-radius: 8px; background: linear-gradient(135deg, #059669 0%, #0d7377 100%);">
                    Aceptar
                </button>
            </div>
        </div>
    </div>
</div>

@section ScriptsOrCss
{
    <script src="~/Content/theme/plugins/bootstrap-wysihtml5/bootstrap3-wysihtml5.all.min.js"></script>
}

<script type="text/javascript">
    $("#compose-textarea").wysihtml5();
      
    function EnviarNotificacion() {
        var destinatarios = '';
        var asunto = $('#lbl_asunto').val();
        var texto = $('#compose-textarea').val();
        var idEntidad = '';
  
        $.ajax({
            url: '@Url.Action("EnviarNotificacion", "Explorer")',
            type: 'POST',
            cache: false,
            async: false,
            data: {
                'idEntidad': idEntidad,
                'asunto': asunto,
                'texto': texto,
                'destinatarios': destinatarios
            },
            success: function (data) {
                var result = data.resultado.exito;
                if (result == false) {
                    $("#lbl_mensajeError").html(data.resultado.mensaje);
                    $("#modalError").modal('show');
                }
                else {
                    $("#lbl_mensajeExito").html(data.resultado.mensaje);
                    $("#modalSuccess").modal('show');
                }
            },
            error: function (data) {
                $("#modalError").modal('show');
            }
        });
    }
</script>