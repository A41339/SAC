@{
    ViewBag.Title = "Notificaciones";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<section class="content-header">
    <h1>
        Notificaciones
    </h1>
</section>
<section class="content">   
    <div style="max-width: 920px; margin: 0 auto;">
        <div class="box box-solid box-info" style="border-radius: 14px; box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05), 0 2px 6px -1px rgba(0, 0, 0, 0.03); border: 1px solid #e2e8f0; overflow: hidden; background: #ffffff;">
            
            <!-- Header Ejecutivo -->
            <div style="padding: 20px 24px; background: #f8fafc; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; gap: 14px;">
                <div style="width: 44px; height: 44px; border-radius: 12px; background: #2563eb; color: #ffffff; display: flex; align-items: center; justify-content: center; font-size: 20px; box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3); flex-shrink: 0;">
                    <i class="fa fa-paper-plane"></i>
                </div>
                <div>
                    <h3 style="margin: 0; font-size: 16px; font-weight: 700; color: #0f172a;">Incluya los datos de la notificación</h3>
                    <p style="margin: 2px 0 0 0; font-size: 13px; color: #64748b;">Complete el asunto y el mensaje que desea transmitir.</p>
                </div>
            </div>

            <!-- Cuerpo del Formulario -->
            <div class="box-body" style="padding: 24px;">
                <div class="form-group" style="margin-bottom: 20px;">
                    <label style="font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 8px; display: flex; align-items: center; gap: 6px;">
                        <i class="fa fa-tag" style="color: #2563eb;"></i> Asunto del Mensaje
                    </label>
                    <input class="form-control" id="lbl_asunto" placeholder="Ingrese el asunto de la notificación..." style="border-radius: 8px; border: 1px solid #cbd5e1; padding: 10px 14px; font-size: 14px; background-color: #f8fafc; transition: all 0.2s ease;">
                </div>
                <div class="form-group" style="margin-bottom: 0;">
                    <label style="font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 8px; display: flex; align-items: center; gap: 6px;">
                        <i class="fa fa-align-left" style="color: #2563eb;"></i> Contenido del Mensaje
                    </label>
                    @Html.TextArea("compose-textarea", "", new { @id = "compose-textarea", @class = "form-control", @style = "height: 260px; border-radius: 8px; border: 1px solid #cbd5e1;" })
                </div>
            </div>

            <!-- Footer con Botón Enviar -->
            <div class="box-footer" style="padding: 16px 24px; background: #f8fafc; border-top: 1px solid #e2e8f0; text-align: right;">
                <button type="button" onclick="javascript:EnviarNotificacion();" class="btn btn-primary" style="background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); border: none; padding: 10px 24px; border-radius: 8px; font-weight: 600; font-size: 14px; box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3); display: inline-flex; align-items: center; gap: 8px; cursor: pointer;">
                    <i class="fa fa-paper-plane"></i> Enviar Notificación
                </button>
            </div>
        </div>
    </div>
</section>

<!-- Modal Error -->
<div id="modalError" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 420px; margin: 80px auto;">
        <div class="modal-content" style="border-radius: 16px; border: none; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1), 0 10px 10px -5px rgba(0,0,0,0.04); overflow: hidden;">
            <div class="modal-body text-center" style="padding: 32px 24px;">
                <div style="width: 56px; height: 56px; border-radius: 50%; background: #fee2e2; color: #dc2626; display: flex; align-items: center; justify-content: center; font-size: 26px; margin: 0 auto 16px auto;">
                    <i class="fa fa-exclamation-triangle"></i>
                </div>
                <h4 style="font-weight: 700; color: #0f172a; margin-bottom: 8px;">Error al enviar</h4>
                <p id="lbl_mensajeError" style="color: #64748b; font-size: 14px; margin-bottom: 24px;">Ha ocurrido un error.</p>
                <button class="btn btn-danger btn-block" data-dismiss="modal" style="border-radius: 8px; font-weight: 600; padding: 10px;">Aceptar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Éxito -->
<div id="modalSuccess" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 420px; margin: 80px auto;">
        <div class="modal-content" style="border-radius: 16px; border: none; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1), 0 10px 10px -5px rgba(0,0,0,0.04); overflow: hidden;">
            <div class="modal-body text-center" style="padding: 32px 24px;">
                <div style="width: 56px; height: 56px; border-radius: 50%; background: #dcfce7; color: #16a34a; display: flex; align-items: center; justify-content: center; font-size: 26px; margin: 0 auto 16px auto;">
                    <i class="fa fa-check-circle"></i>
                </div>
                <h4 style="font-weight: 700; color: #0f172a; margin-bottom: 8px;">¡Notificación Enviada!</h4>
                <p id="lbl_mensajeExito" style="color: #64748b; font-size: 14px; margin-bottom: 24px;"></p>
                <button class="btn btn-success btn-block" data-dismiss="modal" style="border-radius: 8px; font-weight: 600; padding: 10px;">Aceptar</button>
            </div>
        </div>
    </div>
</div>

@section ScriptsOrCss
{
    <script src="~/Content/theme/plugins/bootstrap-wysihtml5/bootstrap3-wysihtml5.all.min.js"></script>
}

<script type="text/javascript">

    $("#compose-textarea").wysihtml5();
      
    function EnviarNotificacion() {

        var destinatarios = '';
        var asunto = $('#lbl_asunto').val();
        var texto = $('#compose-textarea').val();
        var idEntidad = '';
  
        $.ajax({
            url: '@Url.Action("EnviarNotificacion", "Explorer")',
            type: 'POST',
            cache: false,
            async: false,
            data: {
                'idEntidad': idEntidad,
                'asunto': asunto,
                'texto': texto,
                'destinatarios': destinatarios
            },
            success: function (data) {
                var result = data.resultado.exito;
                if (result == false) {
                    $("#lbl_mensajeError").html(data.resultado.mensaje);
                    $("#modalError").modal('show');
                }
                else {
                    $("#lbl_mensajeExito").html(data.resultado.mensaje);
                    $("#modalSuccess").modal('show');
                    $('#confirmModal').modal('hide');
                }
            },
            error: function (data) {
                $("#modalError").modal('show');
            }
        });
    }
    
</script>