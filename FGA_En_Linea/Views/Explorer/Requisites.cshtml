@model IEnumerable<FGA.Models.FileModel>

@{
    ViewBag.Title = "Requisitos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content-header">
    <h1>
        Cargar otro archivo
    </h1>
</section>
<section class="content">

    <div id="dropzone">
        @using (Html.BeginForm("UploadFiles", "Explorer", FormMethod.Post, new { enctype = "multipart/form-data", id = "my-awesome-dropzone", @class = "dropzone" }))
        {
            <div class="fallback">
                <input name="file" type="file" multiple />
            </div>
        }
    </div>

    <div id="listpane">
        @Html.Partial("FileList", Model)
    </div>
</section>

@section ScriptsOrCss
{
    <link href="~/Content/dropzone-master/dist/dropzone.css" rel="stylesheet" />
    <script src="~/Content/dropzone-master/dist/dropzone.js"></script>
    <script type="text/javascript">
        Dropzone.options.myAwesomeDropzone = {
            paramName: "files", // The name that will be used to transfer the file
            maxFilesize: 1024,
            timeout: 18000000,
            init: function () {
                this.on("complete", function (data) {
                    //var res = eval('(' + data.xhr.responseText + ')');
                    $('#listpane').html(data.xhr.response);
                });
            }
        };

        $("div#myId").dropzone({ url: "/Explorer/UploadFiles" });

    </script>
}


