@{
    ViewBag.Title = "Nuevo informe";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content-header" style="padding: 24px 20px 14px 20px;">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
        <div>
            <h1 style="margin: 0; font-size: 21px; font-weight: 700; color: #143750; display: flex; align-items: center; gap: 10px;">
                <i class="fa fa-cloud-upload" style="color: #0284c7;"></i>
                Carga y Envío de Informes
            </h1>
            <p style="margin: 6px 0 0 0; font-size: 13px; color: #64748b;">
                Seleccione la entidad, el período y el tipo de informe para adjuntar y notificar a los destinatarios.
            </p>
        </div>
    </div>
</section>

<section class="content">
    <div id="dropzone">

        <!-- 1. Tarjeta de Configuración y Filtros -->
        <div class="modern-table-card" style="margin-bottom: 22px; padding: 22px 24px; border: 1px solid #e2e8f0; border-radius: 12px; background: #ffffff; box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);">
            
            <h4 style="margin: 0 0 16px 0; font-size: 14px; font-weight: 700; color: #143750; display: flex; align-items: center; gap: 7px;">
                <i class="fa fa-sliders" style="color: #0284c7;"></i>
                Parámetros del informe
            </h4>

            <div class="row">
                <div class="col-md-3 col-sm-6" style="margin-bottom: 14px;">
                    <label for="IdEntidad" style="font-size: 12px; font-weight: 600; color: #475569; margin-bottom: 5px; display: flex; align-items: center; gap: 6px;">
                        <i class="fa fa-building-o" style="color: #0284c7;"></i> Entidad
                    </label>
                    @Html.DropDownList("Entidades", null, new { @id = "IdEntidad", @class = "form-control modern-select", @style = "width: 100%; height: 38px; font-size: 13px;" })
                </div>

                <div class="col-md-3 col-sm-6" style="margin-bottom: 14px;">
                    <label for="Mes" style="font-size: 12px; font-weight: 600; color: #475569; margin-bottom: 5px; display: flex; align-items: center; gap: 6px;">
                        <i class="fa fa-calendar" style="color: #0284c7;"></i> Mes
                    </label>
                    @Html.DropDownList("Mes", Enumerable.Range(1, 12).Select(i => new SelectListItem
                    {
                        Value = i.ToString(),
                        Text = System.Globalization.CultureInfo.CurrentUICulture.DateTimeFormat.GetMonthName(i).ToUpper(),
                        Selected = (DateTime.Now.Month - 1 == i ? true : false)
                    }), new { @id = "Mes", @class = "form-control modern-select", @style = "width: 100%; height: 38px; font-size: 13px;" })
                </div>

                <div class="col-md-3 col-sm-6" style="margin-bottom: 14px;">
                    <label for="Anno" style="font-size: 12px; font-weight: 600; color: #475569; margin-bottom: 5px; display: flex; align-items: center; gap: 6px;">
                        <i class="fa fa-calendar-o" style="color: #0284c7;"></i> Año
                    </label>
                    @Html.DropDownList("Anno", Enumerable.Range(2018, DateTime.Now.Year - 2018 + 3).
                                               Select(i => new SelectListItem { Value = i.ToString(), Text = i.ToString(), Selected = (i == DateTime.Now.Year ? true : false) }),
                                               new { @id = "Anno", @class = "form-control modern-select", @style = "width: 100%; height: 38px; font-size: 13px;" })
                </div>

                <div class="col-md-3 col-sm-6" style="margin-bottom: 14px;">
                    <label for="TipoInforme" style="font-size: 12px; font-weight: 600; color: #475569; margin-bottom: 5px; display: flex; align-items: center; gap: 6px;">
                        <i class="fa fa-file-text-o" style="color: #0284c7;"></i> Tipo de Informe
                    </label>
                    @Html.DropDownList("TipoInforme", null, new { @id = "TipoInforme", @class = "form-control modern-select", @style = "width: 100%; height: 38px; font-size: 13px;" })
                </div>
            </div>

            <!-- Sección de destinatarios -->
            <div style="margin-top: 10px; padding-top: 16px; border-top: 1px solid #f1f5f9;">
                <div class="row">
                    <div class="col-md-7 col-sm-12" style="margin-bottom: 12px;">
                        <label style="font-size: 12px; font-weight: 600; color: #475569; margin-bottom: 6px; display: flex; align-items: center; gap: 6px;">
                            <i class="fa fa-users" style="color: #0284c7;"></i> Destinatarios configurados:
                        </label>
                        <div id="divDest"></div>
                    </div>
                    <div class="col-md-5 col-sm-12">
                        <label for="txt_destinatario" style="font-size: 12px; font-weight: 600; color: #475569; margin-bottom: 6px; display: flex; align-items: center; gap: 6px;">
                            <i class="fa fa-user-plus" style="color: #0284c7;"></i> Añadir otro destinatario:
                        </label>
                        <div style="display: flex; gap: 8px; align-items: center;">
                            <input id="txt_destinatario" class="form-control modern-select" style="flex: 1; height: 38px; font-size: 13px;" placeholder="ejemplo@entidad.fi.cr" />
                            <button type="button" onclick="AddDest();" title="Agregar correo" class="btn-modern-filter" style="height: 38px; padding: 0 16px; border-radius: 8px; flex-shrink: 0; background: linear-gradient(135deg, #059669 0%, #0d7377 100%);">
                                <i class="fa fa-plus"></i> Añadir
                            </button>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- 2. Área de carga Dropzone -->
        <div class="modern-table-card" style="margin-bottom: 20px; padding: 22px 24px; border: 1px solid #e2e8f0; border-radius: 12px; background: #ffffff; box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);">
            <h4 style="margin: 0 0 14px 0; font-size: 14px; font-weight: 700; color: #143750; display: flex; align-items: center; gap: 7px;">
                <i class="fa fa-paperclip" style="color: #0284c7;"></i>
                Adjuntar archivo del informe
            </h4>

            @using (Html.BeginForm("UploadInforme", "Explorer", FormMethod.Post, new { enctype = "multipart/form-data", id = "my-awesome-dropzone", @class = "dropzone", style = "border-radius: 12px; border: 2px dashed #94a3b8; background: #f8fafc; min-height: 180px; display: flex; align-items: center; justify-content: center; transition: all 0.2s ease;" }))
            {
                <div class="fallback">
                    <input name="file" id="file" type="file" multiple />
                </div>
            }
        </div>

        <!-- 3. Botón de acción principal -->
        <div style="display: flex; justify-content: flex-end; margin-bottom: 30px;">
            <button type="button" name="submit" id="btn_guardar" class="btn-modern-filter" style="padding: 11px 32px; font-size: 14px; border-radius: 8px; font-weight: 700; height: 44px; box-shadow: 0 4px 14px rgba(56, 124, 147, 0.4);">
                <i class="fa fa-paper-plane" style="margin-right: 8px;"></i> Cargar y Enviar informe
            </button>
        </div>

    </div>
</section>

<!-- ═══════════════════════════════════════
     MODAL: Confirmación de envío
═══════════════════════════════════════ -->
<div class="modal fade" id="confirmModal" tabindex="-1" role="dialog" aria-labelledby="confirmLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" style="max-width: 860px; width: 92%; margin: 30px auto;">
        <div class="modal-content" style="border-radius: 14px; overflow: hidden; border: none; box-shadow: 0 12px 36px rgba(0,0,0,0.2);">
            
            <div class="modal-header" style="background: linear-gradient(135deg, #143750 0%, #0d7377 100%); padding: 18px 22px; display: flex; align-items: center; justify-content: space-between;">
                <h4 class="modal-title" style="margin: 0; color: #ffffff; font-size: 16px; font-weight: 700; display: flex; align-items: center; gap: 8px;">
                    <i class="fa fa-envelope-o" style="font-size: 18px;"></i>
                    Confirmación de carga y envío del informe
                </h4>
                <button type="button" class="close" data-dismiss="modal" style="color: #fff; opacity: 0.85; font-size: 22px; text-shadow: none; margin: 0; padding: 0;">
                    <span>&times;</span>
                </button>
            </div>

            <div class="modal-body" style="padding: 22px 24px; background: #f8fafc;">
                
                <div class="modern-table-card" style="padding: 18px 20px; border: 1px solid #e2e8f0; border-radius: 10px; background: #ffffff; margin-bottom: 16px;">
                    <div class="form-group" style="margin-bottom: 12px;">
                        <label style="font-size: 12px; font-weight: 600; color: #475569; margin-bottom: 4px; display: block;">
                            <i class="fa fa-envelope" style="color: #0284c7; margin-right: 5px;"></i> Para:
                        </label>
                        <input class="form-control modern-select" id="lbl_para" placeholder="Destinatarios" style="font-size: 13px; height: 38px;">
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6" style="margin-bottom: 12px;">
                            <label style="font-size: 12px; font-weight: 600; color: #475569; margin-bottom: 4px; display: block;">
                                <i class="fa fa-tag" style="color: #0284c7; margin-right: 5px;"></i> Asunto:
                            </label>
                            <input class="form-control modern-select" id="lbl_asunto" placeholder="Asunto" style="font-size: 13px; height: 38px;">
                        </div>
                        <div class="col-md-6" style="margin-bottom: 12px;">
                            <label style="font-size: 12px; font-weight: 600; color: #475569; margin-bottom: 4px; display: block;">
                                <i class="fa fa-building-o" style="color: #0284c7; margin-right: 5px;"></i> Cooperativa / Entidad:
                            </label>
                            <input class="form-control modern-select" id="lbl_cooperativa" placeholder="Cooperativa" style="font-size: 13px; height: 38px;">
                        </div>
                    </div>

                    <div class="form-group" style="margin-bottom: 0;">
                        <label style="font-size: 12px; font-weight: 600; color: #475569; margin-bottom: 6px; display: block;">
                            <i class="fa fa-align-left" style="color: #0284c7; margin-right: 5px;"></i> Mensaje del correo:
                        </label>
                        <div id="txt_mail"></div>
                    </div>
                </div>

                <!-- Archivo adjunto -->
                <div id="adjunto"></div>

            </div>

            <div class="modal-footer" style="background: #ffffff; border-top: 1px solid #e2e8f0; padding: 14px 22px; display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" onclick="DescartarInforme();" class="btn-modern-filter" style="padding: 9px 20px; border-radius: 8px; background: #fee2e2; color: #ef4444; border-color: #fecaca; box-shadow: none;">
                    <i class="fa fa-trash"></i> Descartar
                </button>
                <button type="button" onclick="ModificarInforme();" class="btn-modern-filter" style="padding: 9px 20px; border-radius: 8px; background: #64748b; box-shadow: none;">
                    <i class="fa fa-edit"></i> Modificar
                </button>
                <button type="button" onclick="GuardarInforme();" class="btn-modern-filter" style="padding: 9px 24px; border-radius: 8px; background: linear-gradient(135deg, #059669 0%, #0d7377 100%);">
                    <i class="fa fa-paper-plane"></i> Enviar informe
                </button>
            </div>

        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════
     MODAL: Error
═══════════════════════════════════════ -->
<div id="modalError" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sm" style="max-width: 440px; margin: 60px auto;">
        <div class="modal-content" style="border-radius: 14px; overflow: hidden; border: none; box-shadow: 0 12px 36px rgba(0,0,0,0.25);">
            <div class="modal-body" style="padding: 30px 24px 20px; text-align: center; background: #ffffff;">
                <div style="width: 60px; height: 60px; border-radius: 50%; background: #fee2e2; color: #ef4444; display: inline-flex; align-items: center; justify-content: center; font-size: 26px; margin-bottom: 16px;">
                    <i class="fa fa-exclamation-triangle"></i>
                </div>
                <h4 style="margin: 0 0 8px 0; font-size: 16px; font-weight: 700; color: #1e293b;">Ocurrió un error</h4>
                <p id="lbl_mensajeError" style="font-size: 13px; color: #64748b; margin: 0; line-height: 1.5;"></p>
            </div>
            <div class="modal-footer" style="background: #f8fafc; border-top: 1px solid #f1f5f9; padding: 12px 20px; display: flex; justify-content: center;">
                <button type="button" class="btn-modern-filter" data-dismiss="modal" style="width: 100%; border-radius: 8px; background: #ef4444; border-color: #ef4444; box-shadow: none;">
                    Aceptar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════
     MODAL: Éxito
═══════════════════════════════════════ -->
<div id="modalSuccess" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sm" style="max-width: 440px; margin: 60px auto;">
        <div class="modal-content" style="border-radius: 14px; overflow: hidden; border: none; box-shadow: 0 12px 36px rgba(0,0,0,0.25);">
            <div class="modal-body" style="padding: 30px 24px 20px; text-align: center; background: #ffffff;">
                <div style="width: 60px; height: 60px; border-radius: 50%; background: #dcfce7; color: #16a34a; display: inline-flex; align-items: center; justify-content: center; font-size: 28px; margin-bottom: 16px;">
                    <i class="fa fa-check"></i>
                </div>
                <h4 style="margin: 0 0 8px 0; font-size: 16px; font-weight: 700; color: #1e293b;">¡Operación exitosa!</h4>
                <p id="lbl_mensajeExito" style="font-size: 13px; color: #64748b; margin: 0; line-height: 1.5;"></p>
            </div>
            <div class="modal-footer" style="background: #f8fafc; border-top: 1px solid #f1f5f9; padding: 12px 20px; display: flex; justify-content: center;">
                <button type="button" class="btn-modern-filter" data-dismiss="modal" style="width: 100%; border-radius: 8px; background: linear-gradient(135deg, #059669 0%, #0d7377 100%);">
                    Aceptar
                </button>
            </div>
        </div>
    </div>
</div>

@section ScriptsOrCss
{
    <link href="~/Content/dropzone-master/dist/dropzone.css" rel="stylesheet" />
    <script src="~/Content/dropzone-master/dist/dropzone.js"></script>
    <script src="~/Content/theme/plugins/bootstrap-wysihtml5/bootstrap3-wysihtml5.all.min.js"></script>
}

<script type="text/javascript">
    Dropzone.options.myAwesomeDropzone = {
        paramName: "files",
        maxFilesize: 1024,
        maxFiles: 1,
        timeout: 18000000,
        acceptedFiles: "application/pdf",
        dictDefaultMessage: '<i class="fa fa-cloud-upload" style="font-size: 44px; color: #0284c7; display: block; margin-bottom: 12px;"></i><span style="font-size: 15px; font-weight: 600; color: #1e293b; display: block; margin-bottom: 4px;">Arrastre aquí el informe en PDF o haga clic para seleccionar</span><span style="font-size: 12px; color: #64748b;">(Solo se permite 1 archivo en formato PDF, máx. 1024 MB)</span>',
        init: function () {
            this.on("complete", function (data) {
                $('#adjunto').html(data.xhr.response);
            });
        }
    };

    $("#IdEntidad").change(function () {
        ActualizarDestinatarios();
    });

    $("#TipoInforme").change(function () {
        ActualizarTexto();
    });

    $("#btn_guardar").click(function () {
        var correos = '';
        var informe = $('#TipoInforme').find('option:selected').text().toLowerCase();
        var entidad = $('#IdEntidad').find('option:selected').text();
        var mes = $('#Mes').find('option:selected').text();
        var anno =  $('#Anno').find('option:selected').text();
        $('#Destinatarios option').each(function () {
            correos += $(this).text() + ";";
        });
        $('#lbl_para').val(correos);
        $('#lbl_asunto').val('Informe ' + informe + '. Periodo: ' + mes + '/' + anno);
        $('#lbl_cooperativa').val(entidad);
        $('#lbl_tipoInforme').val(informe);
        $('#confirmModal').modal('show');
    });

    function GuardarInforme() {
        var destinatarios = $('#lbl_para').val();
        var texto = $('#compose-textarea').val();
        var idEntidad = $('#IdEntidad').val();
        var idInforme = $('#TipoInforme').val();
        var mes = $('#Mes').val();
        var anno = $('#Anno').val();

        $.ajax({
            url: '@Url.Action("GuardarInforme", "Explorer")',
            type: 'POST',
            cache: false,
            async: false,
            data: {
                'idEntidad': idEntidad,
                'idInforme': idInforme,
                'mes': mes,
                'anno': anno,
                'texto': texto,
                'destinatarios': destinatarios
            },
            success: function (data) {
                var result = data.resultado.exito;
                if (result == false) {
                    $("#lbl_mensajeError").html(data.resultado.mensaje);
                    $("#modalError").modal('show');
                }
                else {
                    $("#lbl_mensajeExito").html(data.resultado.mensaje);
                    if ($('.dropzone')[0] && $('.dropzone')[0].dropzone) {
                        $('.dropzone')[0].dropzone.removeAllFiles();
                    }
                    $("#modalSuccess").modal('show');
                    $('#confirmModal').modal('hide');
                }
            },
            error: function (data) {
                $("#modalError").modal('show');
            }
        });
    }

    function DescartarInforme() {
        if ($('.dropzone')[0] && $('.dropzone')[0].dropzone) {
            $('.dropzone')[0].dropzone.removeAllFiles();
        }
        $('#confirmModal').modal('hide');
    }

    function ModificarInforme() {
        $('#confirmModal').modal('hide');
    }

    function ActualizarDestinatarios() {
        $.ajax({
            url: '@Url.Action("GetFrom", "Explorer")',
            type: 'POST',
            cache: false,
            async: false,
            data: {
                'IdEntidad': $('#IdEntidad').val(),
            },
            success: function (result) {
                $("#divDest").html(result);
            }
        });
    }

    function ActualizarTexto() {
        $.ajax({
            url: '@Url.Action("GetTxtMail", "Explorer")',
            type: 'POST',
            cache: false,
            async: false,
            data: {
                'IdInforme': $('#TipoInforme').val(),
            },
            success: function (result) {
                $("#txt_mail").html(result);
            }
        });
    }

    function AddDest() {
        var correo = $('#txt_destinatario').val().trim();
        if (correo.length > 0) {
            $("#Destinatarios").append(new Option(correo, correo));
            $('#txt_destinatario').val('');
        }
    }

    function DelDest() {
        $('#Destinatarios').find('option:selected').remove();
    }

    ActualizarDestinatarios();
    ActualizarTexto();
</script>