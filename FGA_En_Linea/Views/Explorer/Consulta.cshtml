@{
    ViewBag.Title = "Informes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content-header">
    <h1>
        Consulta de informes
    </h1>
</section>
<section class="content">
    @using (Html.BeginForm("BuscarInformes", "Explorer", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmInformes" }))
    {
        @Html.AntiForgeryToken()
        <div class="row">
            <div class="col-xs-12">
                <div class="box box-solid box-info">
                    <div class="box-body table-responsive">
                        <div class="margin">
                            <div class="streaming-table">
                                <table class="table table-condensed table-striped table-bordered">                                 
                                    <tr>
                                        <td class="mobile">
                                            @Html.Label("Entidad:")
                                        </td>
                                        <td>
                                            @Html.DropDownList("Entidades", null, new { @id = "IdEntidad", @style = "width:200px" })
                                        </td>
                                        <td class="mobile">
                                            @Html.Label("Periodo:")
                                        </td>
                                        <td>
                                            @Html.DropDownList("Periodos", null, new { @id = "Periodos", @style = "width:200px" })
                                        </td>
                                        <td>
                                            <label class="btn btn-facebook">
                                                Generar<input type="submit" name="submit" id="btn_consultar" style="display: none;">
                                            </label>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-xs-12">
            <div class="box box-solid box-info">
                <div class="box-body table-responsive">
                    <div class="margin">
                        <div class="streaming-table">
                            <span id="found" class="label label-info"></span>
                            <table id="tbInforme" class="table table-striped table-bordered" style="width:100%">
                                <thead>
                                    <tr>
                                        <th><img width="50" height="50" src="@Session["Logo"]" /></th>
                                    </tr>
                                    <tr>
                                        <th> Informe  </th>
                                        <th> Periodo  </th>
                                        <th> Descarga  </th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                            <div id="summary">
                                <div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div> 

</section>

<script type="text/javascript">

    $(document).ready(function () {
        var ControlerNameCompany = "@Url.Content("~/Explorer")";
        oTableCompany = $("#tbInforme").dataTable({
        "bRetrieve": true,
        "bProcessing": true,
        "dom": 'lBfrtip',
            "sAjaxSource": "@Url.Content("~/Explorer/GetInformes")",
            "buttons": [], columnDefs: [{   visible: false }],
            "aoColumns": [{}, {}, {}, {}],
            "bSort": false, // Deshabilitar el ordenamiento automático
            "bFilter": false,  // Desactivar el cuadro de búsqueda
            "bLengthChange": false  // Desactivar la selección de cantidad de registros por página
        });
    });

    function deleteFile(idFile) {
            $.ajax({
            url: '@Url.Action("DeleteFile", "Explorer")',
            type: 'POST',
            cache: false,
            async: false,
            data: {
                'Id': idFile
            },
                success: function (result) {
                    var table = $('#tbInforme').DataTable();
                table.ajax.reload();
            }
        });
    }

</script>