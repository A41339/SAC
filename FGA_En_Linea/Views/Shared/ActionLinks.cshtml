@model string

@{
    bool upperEnabled = Model == System.Configuration.ConfigurationManager.AppSettings["RutaUploads"] ? false : true;
    List<string> list = ViewData["CheckedList"] as List<string>;
    string jList = "";
    if (list != null && list.Count > 0)
    {
        System.Web.Script.Serialization.JavaScriptSerializer serializer = new System.Web.Script.Serialization.JavaScriptSerializer();
        jList = serializer.Serialize(list);
        jList = jList.Replace("\"", "$");
    }
}

<div style="display: flex; align-items: center; gap: 10px; padding: 12px 0 8px 0; flex-wrap: wrap;">

    @if (upperEnabled && bool.Parse(Session["FullAccess"].ToString()) == true)
    {
        <button type="button" onclick="goTop();"
                class="btn-modern-filter"
                style="padding: 7px 16px; border-radius: 8px; font-size: 12px; height: 34px; background: linear-gradient(135deg, #475569 0%, #334155 100%); box-shadow: 0 2px 8px rgba(71,85,105,0.3);">
            <i class="fa fa-home"></i> Inicio
        </button>

        <button type="button" onclick='goUpper("@Model");'
                class="btn-modern-filter"
                style="padding: 7px 16px; border-radius: 8px; font-size: 12px; height: 34px; background: linear-gradient(135deg, #475569 0%, #334155 100%); box-shadow: 0 2px 8px rgba(71,85,105,0.3);">
            <i class="fa fa-arrow-up"></i> Nivel superior
        </button>
    }

    <button type="button" onclick="download();"
            class="btn-modern-filter"
            style="padding: 7px 18px; border-radius: 8px; font-size: 12px; height: 34px;">
        <i class="fa fa-download"></i> Descargar selecci&oacute;n
    </button>

    @if (list != null && list.Count > 0)
    {
        <span style="font-size: 12px; color: #64748b; display: flex; align-items: center; gap: 5px;">
            <i class="fa fa-check-square" style="color: #0284c7;"></i>
            @list.Count elemento(s) seleccionado(s)
        </span>
    }
</div>

<script type="text/javascript">
    function goUpper(path) {
        $.ajax({
            type: "POST",
            url: getApplicationPath() + "Explorer/GoUpper",
            data: { path: path },
            cache: false,
            dataType: "html",
            success: function (data) {
                $('#listpane').html(data);
            }
        });
    }

    function goTop() {
        $.ajax({
            type: "POST",
            url: getApplicationPath() + "Explorer/GoTop",
            data: {},
            cache: false,
            dataType: "html",
            success: function (data) {
                $('#listpane').html(data);
            }
        });
    }

    function download() {
        var list = '@jList';
        var path = getApplicationPath() + "Explorer/Download/?jlist=" + list;
        window.location.href = path;
    }
</script>
