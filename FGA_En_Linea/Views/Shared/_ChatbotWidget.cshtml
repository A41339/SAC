@* ==========================================================================
   WIDGET FLOTANTE: ASISTENTE VIRTUAL INTELIGENTE (COPILOT SAC / FFC)
   Renderizado condicional controlado por Env.IsChatbotEnabled()
   Soporta contextualización dinámica por pantalla e interactividad con chips
   ========================================================================== *@
@{
    string nombreEntidad = FGA.Env.GetUserInfo("entidad");
    string nombreUsuario = FGA.Env.GetUserInfo("name");
}

<style>
    /* Estilos críticos e independientes de caché para el Hero KPI Card y badges del Chatbot */
    .sac-kpi-hero-card {
        background: linear-gradient(135deg, #ffffff 0%, #f0f7ff 100%) !important;
        border: 1px solid #bae6fd !important;
        border-left: 4px solid #0071AD !important;
        border-radius: 10px !important;
        padding: 10px 14px 9px 14px !important;
        margin-bottom: 10px !important;
        box-shadow: 0 2px 6px rgba(0, 113, 173, 0.08) !important;
        display: block !important;
    }
    .sac-kpi-hero-top {
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        width: 100% !important;
        gap: 8px !important;
        margin-bottom: 4px !important;
    }
    .sac-kpi-hero-badge {
        font-size: 11px !important;
        font-weight: 700 !important;
        text-transform: uppercase !important;
        letter-spacing: 0.5px !important;
        color: #0284c7 !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 5px !important;
    }
    .sac-kpi-hero-badge i {
        font-size: 11px !important;
        color: #0071AD !important;
    }
    .sac-kpi-hero-period {
        font-size: 10.5px !important;
        font-weight: 700 !important;
        color: #475569 !important;
        background: #e2e8f0 !important;
        padding: 2px 8px !important;
        border-radius: 6px !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 4px !important;
        margin-left: auto !important;
        white-space: nowrap !important;
    }
    .sac-kpi-hero-value {
        font-size: 22px !important;
        font-weight: 800 !important;
        color: #004b75 !important;
        line-height: 1.2 !important;
        margin: 3px 0 2px 0 !important;
        letter-spacing: -0.3px !important;
        display: block !important;
    }
    .sac-kpi-hero-desc {
        font-size: 10.5px !important;
        color: #0369a1 !important;
        font-weight: 600 !important;
        display: flex !important;
        align-items: center !important;
        gap: 4px !important;
        opacity: 0.9 !important;
    }

    /* Modo Expandido del Asistente Virtual (Drawer amplio para tablas y balances) */
    .sac-chatbot-window.sac-window-expanded {
        width: 650px !important;
        height: 720px !important;
        max-width: calc(100vw - 32px) !important;
        max-height: calc(100vh - 100px) !important;
        transition: width 0.25s cubic-bezier(0.16, 1, 0.3, 1), height 0.25s cubic-bezier(0.16, 1, 0.3, 1) !important;
    }

    /* Botón y barra de acciones para copiar respuesta */
    .sac-bubble-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 6px;
        margin-top: 8px;
        padding-top: 6px;
        border-top: 1px dashed rgba(0, 113, 173, 0.18);
    }
    .sac-btn-copy-bubble {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        color: #475569;
        font-size: 11px;
        font-weight: 600;
        padding: 3px 8px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: all 0.2s ease;
        box-shadow: 0 1px 2px rgba(0,0,0,0.04);
    }
    .sac-btn-copy-bubble:hover {
        background: #f1f5f9;
        border-color: #94a3b8;
        color: #0f172a;
    }
    .sac-btn-copy-bubble.copied {
        background: #ecfdf5 !important;
        border-color: #10b981 !important;
        color: #047857 !important;
    }

    /* Tablas Markdown con Estilo Corporativo FFC */
    .sac-table-responsive {
        width: 100%;
        overflow-x: auto;
        margin: 10px 0;
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        background: #ffffff;
        box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    }
    .sac-chatbot-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 11.5px;
        line-height: 1.4;
        text-align: left;
    }
    .sac-chatbot-table th {
        background: #0071AD;
        color: #ffffff;
        font-weight: 700;
        padding: 8px 10px;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        font-size: 10.5px;
        border-bottom: 2px solid #005a8c;
        white-space: nowrap;
    }
    .sac-chatbot-table td {
        padding: 6px 10px;
        border-bottom: 1px solid #e2e8f0;
        color: #1e293b;
    }
    .sac-chatbot-table tbody tr:nth-child(even) {
        background: #f8fafc;
    }
    .sac-chatbot-table tbody tr:hover {
        background: #f0f7ff;
    }
    .sac-chatbot-table td.num-cell,
    .sac-chatbot-table th.num-cell {
        text-align: right;
        font-family: "Consolas", "Segoe UI Mono", monospace;
        font-weight: 600;
    }
</style>

<!-- Botón Flotante Disparador (Launcher) -->
<div id="sacChatbotLauncher" class="sac-chatbot-launcher" title="Asistente SAC">
    <div class="sac-launcher-inner">
        <svg class="sac-launcher-robot-icon" viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="10" rx="3"></rect>
            <circle cx="12" cy="5" r="2"></circle>
            <path d="M12 7v4"></path>
            <line x1="8" y1="15" x2="8.01" y2="15" stroke-width="3"></line>
            <line x1="16" y1="15" x2="16.01" y2="15" stroke-width="3"></line>
            <line x1="9" y1="18" x2="15" y2="18"></line>
            <path d="M1 15h2"></path>
            <path d="M21 15h2"></path>
        </svg>
    </div>
</div>

<!-- Ventana de Diálogo Flotante (Chat Window) -->
<div id="sacChatbotWindow" class="sac-chatbot-window" style="display: none;">
    <!-- Cabecera Corporativa FFC -->
    <div class="sac-chatbot-header">
        <div class="sac-chatbot-header-info">
            <div class="sac-chatbot-avatar">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="10" rx="3"></rect>
                    <circle cx="12" cy="5" r="2"></circle>
                    <path d="M12 7v4"></path>
                    <line x1="8" y1="15" x2="8.01" y2="15" stroke-width="3"></line>
                    <line x1="16" y1="15" x2="16.01" y2="15" stroke-width="3"></line>
                    <line x1="9" y1="18" x2="15" y2="18"></line>
                </svg>
            </div>
            <div class="sac-chatbot-titles">
                <span class="sac-chatbot-title">Asistente SAC</span>
                <span class="sac-chatbot-subtitle">
                    <span class="sac-status-dot"></span>
                    @(string.IsNullOrWhiteSpace(nombreEntidad) ? "Asistente FFC" : nombreEntidad)
                </span>
            </div>
        </div>
        <div class="sac-chatbot-header-actions">
            <button type="button" id="btnSacChatbotExpandir" class="sac-btn-header" title="Expandir / Restaurar tamaño">
                <i class="fa fa-expand"></i>
            </button>
            <button type="button" id="btnSacChatbotMinimizar" class="sac-btn-header" title="Minimizar">
                <i class="fa fa-minus"></i>
            </button>
            <button type="button" id="btnSacChatbotCerrar" class="sac-btn-header" title="Cerrar">
                <i class="fa fa-times"></i>
            </button>
        </div>
    </div>

    <!-- Área de Mensajes -->
    <div id="sacChatbotMessages" class="sac-chatbot-messages">
        <!-- Mensaje de Bienvenida Inicial con Contexto Dinámico -->
        <div class="sac-msg sac-msg-bot">
            <div class="sac-msg-avatar">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="10" rx="3"></rect>
                    <circle cx="12" cy="5" r="2"></circle>
                    <path d="M12 7v4"></path>
                    <line x1="8" y1="15" x2="8.01" y2="15" stroke-width="3"></line>
                    <line x1="16" y1="15" x2="16.01" y2="15" stroke-width="3"></line>
                </svg>
            </div>
            <div class="sac-msg-bubble">
                <div id="sacScreenContextBadge" class="sac-screen-context-badge">
                    <i class="fa fa-compass"></i> <span>Detectando contexto...</span>
                </div>
                <p>¡Hola <strong>@(string.IsNullOrWhiteSpace(nombreUsuario) ? "" : nombreUsuario)</strong>! 👋 Soy tu <strong>Asistente SAC</strong>.</p>
                <p>Tengo acceso al contexto oficial de <strong>@(string.IsNullOrWhiteSpace(nombreEntidad) ? "tu entidad" : nombreEntidad)</strong>.</p>
                
                <div class="sac-quick-prompts">
                    <span class="sac-quick-title"><i class="fa fa-bolt"></i> Consultas recomendadas para esta pantalla:</span>
                    <div id="sacWelcomeChipsList" style="display: flex; flex-direction: column; gap: 6px; margin-top: 4px;"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Indicador Animado de 'Escribiendo...' -->
    <div id="sacChatbotTyping" class="sac-chatbot-typing" style="display: none;">
        <div class="sac-typing-dots">
            <span></span><span></span><span></span>
        </div>
        <span class="sac-typing-text">Analizando datos de la entidad...</span>
    </div>

    <!-- Formulario / Caja de Entrada con Barra de Chips Persistente -->
    <div class="sac-chatbot-footer">
        <!-- Barra de Sugerencias Rápidas Contextuales (Scroll Horizontal) -->
        <div id="sacQuickChipsBar" class="sac-quick-chips-bar">
            <!-- Se carga dinámicamente según la pantalla activa -->
        </div>

        <form id="sacChatbotForm" class="sac-chatbot-form" onsubmit="return false;">
            <div class="sac-input-wrapper">
                <input type="text" id="sacChatbotInput" class="sac-chatbot-input" placeholder="Pregunta sobre indicadores, alertas o SBR..." autocomplete="off" />
                <button type="button" id="btnSacChatbotEnviar" class="sac-btn-enviar" title="Enviar consulta">
                    <i class="fa fa-paper-plane"></i>
                </button>
            </div>
            <div class="sac-chatbot-disclaimer">
                <span><i class="fa fa-lock"></i> Datos confidenciales de la entidad activa. Respaldado por FFC.</span>
            </div>
        </form>
    </div>
</div>

<!-- Script del Asistente Virtual -->
<script type="text/javascript">
    (function () {
        var $launcher = $('#sacChatbotLauncher');
        var $window = $('#sacChatbotWindow');
        var $messages = $('#sacChatbotMessages');
        var $input = $('#sacChatbotInput');
        var $btnEnviar = $('#btnSacChatbotEnviar');
        var $typing = $('#sacChatbotTyping');
        var $chipsBar = $('#sacQuickChipsBar');
        var $welcomeChipsList = $('#sacWelcomeChipsList');
        var $badge = $('#sacScreenContextBadge');
        var historial = [];

        // 1. Detección Inteligente del Módulo / Pantalla Activa en el SAC
        function detectarPantallaActual() {
            var path = (window.location.pathname || '').toLowerCase();

            // Estructura de Fondeo
            if (path.indexOf('estructurafondeo') !== -1 || path.indexOf('fondeo') !== -1) {
                return {
                    id: 'fondeo',
                    nombre: 'Estructura de Fondeo',
                    icono: 'fa-university',
                    chips: [
                        { icono: '👥', label: 'Top 20 Inversionistas', pregunta: '¿Cuál es el saldo y concentración de los 20 mayores inversionistas?' },
                        { icono: '👥', label: 'Top 10 Inversionistas', pregunta: '¿Cuál es la concentración de los 10 mayores inversionistas?' },
                        { icono: '⏳', label: 'Disponibilidades / Vista', pregunta: '¿Cuál es el ratio de disponibilidades sobre captaciones a la vista?' },
                        { icono: '⚠️', label: 'Riesgo Concentración', pregunta: '¿Cuáles son las recomendaciones para mitigar la concentración de pasivos?' }
                    ]
                };
            }

            // Cartera de Crédito / SUGEF 14-21 / Créditos
            if (path.indexOf('cartera') !== -1 || path.indexOf('credito') !== -1) {
                return {
                    id: 'cartera',
                    nombre: 'Cartera de Crédito',
                    icono: 'fa-line-chart',
                    chips: [
                        { icono: '📉', label: 'Morosidad > 90 días', pregunta: '¿Cuál es el índice de morosidad mayor a 90 días y su tendencia?' },
                        { icono: '💳', label: 'Saldo de Cartera', pregunta: '¿Cuál es el saldo total de la cartera de crédito y su evolución?' },
                        { icono: '🎯', label: 'Pérdida Esperada', pregunta: '¿Cuál es el nivel de pérdida esperada de la cartera de crédito?' },
                        { icono: '📑', label: 'Cartera Vencida > 30 días', pregunta: '¿Cuál es el índice de cartera vencida mayor de 30 días?' }
                    ]
                };
            }

            // Evaluación SBR / CAMEL
            if (path.indexOf('evaluacion') !== -1 || path.indexOf('camel') !== -1 || path.indexOf('sbr') !== -1) {
                return {
                    id: 'evaluacion',
                    nombre: 'Evaluación SBR / CAMEL',
                    icono: 'fa-shield',
                    chips: [
                        { icono: '🛡️', label: 'Metodología SBR', pregunta: '¿En qué consiste la Supervisión Basada en Riesgos y cuáles son sus etapas?' },
                        { icono: '📝', label: 'Plan de Remediación', pregunta: '¿Qué requisitos y plazos aplican para el Plan de Remediación institucional?' },
                        { icono: '🏛️', label: 'Calificación CAMEL', pregunta: '¿Cuáles son los 5 componentes CAMEL y qué evalúa cada uno?' },
                        { icono: '📋', label: 'Autoevaluación Riesgos', pregunta: '¿Cómo registrar y documentar la autoevaluación institucional de riesgos?' }
                    ]
                };
            }

            // Bandeja de Alertas
            if (path.indexOf('alerta') !== -1) {
                return {
                    id: 'alertas',
                    nombre: 'Bandeja de Alertas',
                    icono: 'fa-bell',
                    chips: [
                        { icono: '🔔', label: 'Mis Alertas Activas', pregunta: '¿Cuáles alertas financieras o de umbrales se encuentran activadas?' },
                        { icono: '🚦', label: 'Semáforos de Criticidad', pregunta: '¿Cómo se definen los rangos de criticidad verde, amarillo y rojo en el SAC?' },
                        { icono: '📐', label: 'Cuentas con Desviación', pregunta: '¿Cuáles cuentas contables presentan las mayores variaciones en el último corte?' }
                    ]
                };
            }

            // Indicadores Financieros / Margen
            if (path.indexOf('indicador') !== -1 || path.indexOf('margen') !== -1 || path.indexOf('formula') !== -1) {
                return {
                    id: 'indicadores',
                    nombre: 'Indicadores y Margen',
                    icono: 'fa-pie-chart',
                    chips: [
                        { icono: '⚡', label: 'Eficiencia Operativa', pregunta: '¿Cuál es el indicador de eficiencia operativa (costo administrativo)?' },
                        { icono: '📈', label: 'Margen Financiero', pregunta: '¿Cuál es el margen financiero sobre activos de la entidad?' },
                        { icono: '🏛️', label: 'Apalancamiento SUGEF', pregunta: '¿Cuál es el ratio de apalancamiento SUGEF 3-06?' },
                        { icono: '📊', label: 'Suficiencia Patrimonial', pregunta: '¿Cómo cerró mi suficiencia patrimonial y qué significa?' }
                    ]
                };
            }

            // Tablero Principal (Dashboard) o Fallback General
            return {
                id: 'dashboard',
                nombre: 'Tablero Principal',
                icono: 'fa-tachometer',
                chips: [
                    { icono: '📊', label: 'Suficiencia Patrimonial', pregunta: '¿Cómo cerró mi suficiencia patrimonial y cuál es su tendencia?' },
                    { icono: '🏦', label: 'Obligaciones con público', pregunta: '¿Cuál es el saldo de obligaciones con el público de los últimos 2 meses?' },
                    { icono: '💳', label: 'Cartera de Crédito', pregunta: '¿Cuál es el saldo de cartera de crédito y morosidad?' },
                    { icono: '📈', label: 'Margen y Resultado', pregunta: '¿Cuál es el margen financiero y resultado neto acumulado del periodo?' },
                    { icono: '🔄', label: 'Últimos 3 meses', pregunta: 'Muestra la evolución de los principales indicadores en los últimos 3 meses' }
                ]
            };
        }

        // 2. Inicializar Chips Contextuales y Badge de Pantalla
        var contextoActual = detectarPantallaActual();

        function renderizarContexto() {
            // Actualizar badge en mensaje inicial
            if ($badge.length) {
                $badge.html('<i class="fa ' + contextoActual.icono + '"></i> Módulo activo: <strong>' + contextoActual.nombre + '</strong>');
            }

            // Actualizar lista en el mensaje de bienvenida
            if ($welcomeChipsList.length) {
                $welcomeChipsList.empty();
                $.each(contextoActual.chips, function (i, c) {
                    var $btn = $('<button type="button" class="sac-quick-btn" data-pregunta="' + c.pregunta + '">' +
                        c.icono + ' ' + c.label +
                        '</button>');
                    $welcomeChipsList.append($btn);
                });
            }

            // Actualizar barra horizontal de chips persistente encima del input
            if ($chipsBar.length) {
                $chipsBar.empty();
                $.each(contextoActual.chips, function (i, c) {
                    var $chip = $('<button type="button" class="sac-quick-chip" data-pregunta="' + c.pregunta + '">' +
                        c.icono + ' ' + c.label +
                        '</button>');
                    $chipsBar.append($chip);
                });

                // Si no es el Dashboard, agregar un chip de acceso rápido a los 11 indicadores
                if (contextoActual.id !== 'dashboard') {
                    $chipsBar.append('<button type="button" class="sac-quick-chip" data-pregunta="¿Cómo cerró mi suficiencia patrimonial y qué significa?">📊 Suficiencia</button>');
                    $chipsBar.append('<button type="button" class="sac-quick-chip" data-pregunta="¿Cuál es el saldo de obligaciones con el público de los últimos 2 meses?">🏦 Obligaciones</button>');
                }
            }
        }

        renderizarContexto();

        // 3. Abrir / Cerrar ventana
        $launcher.on('click', function () {
            $window.fadeToggle(200, function () {
                if ($window.is(':visible')) {
                    $input.focus();
                    scrollAbajo();
                }
            });
        });

        $('#btnSacChatbotCerrar, #btnSacChatbotMinimizar').on('click', function () {
            $window.fadeOut(200);
        });

        // 3.1 Control de Expansión / Modo Maximizado del Asistente
        var $btnExpandir = $('#btnSacChatbotExpandir');
        $btnExpandir.on('click', function () {
            var isExpanded = $window.toggleClass('sac-window-expanded').hasClass('sac-window-expanded');
            $btnExpandir.find('i').toggleClass('fa-expand', !isExpanded).toggleClass('fa-compress', isExpanded);
            $btnExpandir.attr('title', isExpanded ? 'Restaurar tamaño normal' : 'Expandir panel');
            try {
                localStorage.setItem('sac_chatbot_expanded', isExpanded ? '1' : '0');
            } catch (err) { }
        });

        // Restaurar tamaño preferido si el usuario lo tenía expandido
        try {
            if (localStorage.getItem('sac_chatbot_expanded') === '1') {
                $window.addClass('sac-window-expanded');
                $btnExpandir.find('i').removeClass('fa-expand').addClass('fa-compress');
                $btnExpandir.attr('title', 'Restaurar tamaño normal');
            }
        } catch (err) { }

        // 3.2 Copiar respuesta del asistente al portapapeles
        $(document).on('click', '.sac-btn-copy-bubble', function (e) {
            e.preventDefault();
            var $btn = $(this);
            var $bubble = $btn.closest('.sac-msg-bubble');
            var $clone = $bubble.clone();
            $clone.find('.sac-bubble-actions, .sac-followup-container').remove();
            var textoACopiar = $clone.text().replace(/\n\s*\n/g, '\n').trim();

            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(textoACopiar).then(mostrarFeedbackCopiado, fallbackCopiar);
            } else {
                fallbackCopiar();
            }

            function fallbackCopiar() {
                var $temp = $('<textarea>').css({ position: 'fixed', left: '-9999px', top: '0' }).val(textoACopiar);
                $('body').append($temp);
                $temp.select();
                try {
                    document.execCommand('copy');
                    mostrarFeedbackCopiado();
                } catch (ex) {
                    if (window.mostrarToast) window.mostrarToast('No se pudo copiar automáticamente', 'warning');
                }
                $temp.remove();
            }

            function mostrarFeedbackCopiado() {
                $btn.addClass('copied').html('<i class="fa fa-check"></i> <span>¡Copiado!</span>');
                setTimeout(function () {
                    $btn.removeClass('copied').html('<i class="fa fa-clone"></i> <span>Copiar</span>');
                }, 2000);
            }
        });

        // 4. Enviar al pulsar Enter o el botón Enviar
        $input.on('keypress', function (e) {
            if (e.which === 13) {
                e.preventDefault();
                enviarPregunta();
            }
        });

        $btnEnviar.on('click', function () {
            enviarPregunta();
        });

        // 5. Clic en chips de preguntas rápidas (bienvenida, barra horizontal y botones de seguimiento)
        $(document).on('click', '.sac-quick-btn, .sac-quick-chip, .sac-followup-btn, .sac-followup-chip', function () {
            var pregunta = $(this).attr('data-pregunta') || $(this).text().trim();
            $input.val(pregunta);
            enviarPregunta();
        });

        // 6. Envío de consulta con enriquecimiento de contexto
        function enviarPregunta() {
            var texto = $input.val().trim();
            if (!texto) return;

            // Renderizar mensaje del usuario
            agregarMensaje('usuario', texto);
            $input.val('');

            // Mostrar animación de pensando
            $typing.fadeIn(150);
            scrollAbajo();

            // Detectar selector de fecha/periodo (#Periodo2, #Periodo, #PeriodoF, etc.)
            var periodoActivo = '';
            var $p = $('#Periodo2, input[name="Periodo2"], #Periodo, input[name="Periodo"], #PeriodoF, input[name="PeriodoF"]').first();
            if ($p.length && $p.val()) {
                periodoActivo = $p.val().trim();
            }

            // Detectar selector de entidad (#IdEntidad, select[name="IdEntidad"], select[name="Entidades"], etc.)
            var entidadActiva = '';
            var $e = $('#IdEntidad, select[name="IdEntidad"], select[name="Entidades"]').first();
            if ($e.length && $e.val()) {
                entidadActiva = $e.val().trim();
            }

            // Información de pantalla para el modelo
            var pantallaInfo = contextoActual.nombre + ' (' + (window.location.pathname || '') + ')';

            // Petición AJAX al controlador ChatbotController
            $.ajax({
                url: '@Url.Action("Preguntar", "Chatbot")',
                type: 'POST',
                data: {
                    mensaje: texto,
                    historial: historial.slice(-6).join('\n'),
                    periodoContexto: periodoActivo,
                    entidadContexto: entidadActiva,
                    pantallaContexto: pantallaInfo
                },
                dataType: 'json',
                success: function (res) {
                    $typing.hide();
                    if (res && res.success) {
                        agregarMensaje('bot', res.respuesta);
                        historial.push('Usuario: ' + texto);
                        historial.push('Asistente SAC: ' + res.respuesta);
                    } else {
                        var err = (res && res.respuesta) ? res.respuesta : 'No fue posible obtener una respuesta en este momento.';
                        agregarMensaje('bot', err);
                    }
                },
                error: function () {
                    $typing.hide();
                    agregarMensaje('bot', 'Hubo un error de conexión con el servidor del Asistente. Por favor intenta de nuevo.');
                }
            });
        }

        // 7. Renderizado de Mensajes y Opciones Interactivas
        function agregarMensaje(tipo, contenido) {
            var esBot = tipo === 'bot';
            var sugerencias = [];

            // Si es respuesta del bot, extraer sugerencias dinámicas de seguimiento [Sugerencia: ...]
            if (esBot && contenido) {
                contenido = contenido.replace(/\[(?:Sugerencia|Opción|Opcion)\s*:\s*([^\]]+)\]/gi, function (match, sug) {
                    var s = (sug || '').trim();
                    if (s) {
                        sugerencias.push(s);
                    }
                    return ''; // Quitar del texto para renderizado limpio
                });
                contenido = contenido.trim(); // Limpiar espacios y saltos de línea sobrantes
            }

            var htmlFormatted = esBot ? formatearMarkdown(contenido) : $('<div>').text(contenido).html().replace(/\n/g, '<br/>');

            // Generar contenedor de opciones sugeridas interactivas si existen
            var htmlSugerencias = '';
            if (sugerencias.length > 0) {
                htmlSugerencias += '<div class="sac-followup-container">' +
                    '<span class="sac-followup-title"><i class="fa fa-lightbulb-o"></i> Sugerencias:</span>' +
                    '<div class="sac-followup-chips">';
                $.each(sugerencias, function (i, s) {
                    htmlSugerencias += '<button type="button" class="sac-followup-btn sac-followup-chip" data-pregunta="' + s.replace(/"/g, '&quot;') + '">' +
                        '<span>' + s + '</span> <i class="fa fa-arrow-circle-right"></i>' +
                        '</button>';
                });
                htmlSugerencias += '</div></div>';
            }

            var copyActionBar = esBot ? ('<div class="sac-bubble-actions">' +
                '<button type="button" class="sac-btn-copy-bubble" title="Copiar análisis al portapapeles">' +
                '<i class="fa fa-clone"></i> <span>Copiar</span>' +
                '</button>' +
                '</div>') : '';

            var botAvatarSvg = '<div class="sac-msg-avatar"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="3"></rect><circle cx="12" cy="5" r="2"></circle><path d="M12 7v4"></path><line x1="8" y1="15" x2="8.01" y2="15" stroke-width="3"></line><line x1="16" y1="15" x2="16.01" y2="15" stroke-width="3"></line></svg></div>';

            var $msg = $('<div class="sac-msg ' + (esBot ? 'sac-msg-bot' : 'sac-msg-user') + '">' +
                (esBot ? botAvatarSvg : '') +
                '<div class="sac-msg-bubble">' + htmlFormatted + htmlSugerencias + copyActionBar + '</div>' +
                (!esBot ? '<div class="sac-msg-avatar user-av"><i class="fa fa-user"></i></div>' : '') +
                '</div>');

            $messages.append($msg);

            if (esBot) {
                // Desplazamiento exacto para que el usuario lea la respuesta desde su primera línea
                setTimeout(function () {
                    if ($msg && $msg.length && $messages.length) {
                        var container = $messages[0];
                        var msgElem = $msg[0];
                        var rectMsg = msgElem.getBoundingClientRect();
                        var rectContainer = container.getBoundingClientRect();
                        var relativeTop = rectMsg.top - rectContainer.top;
                        var targetScroll = container.scrollTop + relativeTop - 10;
                        $messages.animate({ scrollTop: Math.max(0, targetScroll) }, 260);
                    }
                }, 50);
            } else {
                scrollAbajo();
            }
        }

        function scrollAbajo() {
            $messages.scrollTop($messages[0].scrollHeight);
        }

        function formatearMarkdown(txt) {
            if (!txt) return '';
            txt = txt.trim();

            // 1. Procesamiento previo de tablas Markdown (| Encabezado 1 | Encabezado 2 | ... )
            var placeholderMap = {};
            var phIndex = 0;
            if (txt.indexOf('|') !== -1) {
                txt = txt.replace(/(?:^|\n)(\|[^\n]+\|\r?\n\|(?:\s*:?---*:?\s*\|)+\r?\n(?:\|[^\n]+\|\r?\n?)+)/g, function (match, tablaRaw) {
                    var lineasT = tablaRaw.trim().split(/\r?\n/);
                    if (lineasT.length < 3) return match;

                    var headerCols = lineasT[0].split('|').map(function (c) { return c.trim(); }).filter(function (c, i, a) { return i > 0 && i < a.length - 1; });
                    var alignCols = lineasT[1].split('|').map(function (c) { return c.trim(); }).filter(function (c, i, a) { return i > 0 && i < a.length - 1; });

                    var alignments = alignCols.map(function (a) {
                        if (/^:.*:$/.test(a)) return 'center';
                        if (/.*:$/.test(a)) return 'right';
                        return 'left';
                    });

                    var htmlTabla = '<div class="sac-table-responsive"><table class="sac-chatbot-table"><thead><tr>';
                    for (var h = 0; h < headerCols.length; h++) {
                        var alignClass = alignments[h] === 'right' ? ' class="num-cell"' : '';
                        htmlTabla += '<th' + alignClass + '>' + $('<div>').text(headerCols[h]).html() + '</th>';
                    }
                    htmlTabla += '</tr></thead><tbody>';

                    for (var r = 2; r < lineasT.length; r++) {
                        var rowLine = lineasT[r].trim();
                        if (!rowLine || rowLine.indexOf('|') === -1) continue;
                        var cells = rowLine.split('|').map(function (c) { return c.trim(); }).filter(function (c, i, a) { return i > 0 && i < a.length - 1; });
                        htmlTabla += '<tr>';
                        for (var c = 0; c < headerCols.length; c++) {
                            var cellVal = cells[c] || '';
                            var isNumeric = alignments[c] === 'right' || /(?:₡|%|\b\d+[\.,]\d+\b)/.test(cellVal);
                            var cellClass = isNumeric ? ' class="num-cell"' : '';
                            var safeVal = $('<div>').text(cellVal).html()
                                .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                                .replace(/\*(.*?)\*/g, '<em>$1</em>');
                            htmlTabla += '<td' + cellClass + '>' + safeVal + '</td>';
                        }
                        htmlTabla += '</tr>';
                    }
                    htmlTabla += '</tbody></table></div>';

                    var phKey = '___SAC_TABLE_PH_' + (phIndex++) + '___';
                    placeholderMap[phKey] = htmlTabla;
                    return '\n\n' + phKey + '\n\n';
                });
            }

            var lines = txt.split(/\r?\n/);
            var htmlParts = [];

            for (var i = 0; i < lines.length; i++) {
                var rawLine = lines[i].trim();
                if (!rawLine) continue;

                // Si es un placeholder de tabla procesada, inyectar el HTML directamente
                if (placeholderMap[rawLine]) {
                    htmlParts.push(placeholderMap[rawLine]);
                    continue;
                }

                // Escapar HTML para evitar XSS
                var lineSafe = $('<div>').text(rawLine).html();

                // Negritas: **texto**
                lineSafe = lineSafe.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');

                // Cursivas: *texto*
                lineSafe = lineSafe.replace(/\*(.*?)\*/g, '<em>$1</em>');

                // Detectar si la línea es un encabezado o título de sección (ej. **Resumen ejecutivo:** o **Análisis:**)
                var esTituloSeccion = /^(\*{2}|<strong>)?\s*(Resumen ejecutivo|An[aá]lisis|Comportamiento|Bandeja de alertas|Estructura de|Detalle|Normativa)[\:\s]*(\*{2}|<\/strong>)?[\:\s]*$/i.test(rawLine)
                                   || /^(\*{2}|<strong>)?\s*(Resumen ejecutivo|An[aá]lisis|Comportamiento|Bandeja de alertas|Estructura de|Detalle|Normativa)[\:\s]*(\*{2}|<\/strong>)?[\:\s]*$/i.test(lineSafe);

                // Detectar si es la línea de apertura del indicador ("Tu **Suficiencia...** cerró en..." o "El saldo de...")
                var esHeroKPI = (i === 0 && (rawLine.indexOf('cerró en') >= 0 || rawLine.indexOf('cerro en') >= 0 || rawLine.indexOf('al corte de') >= 0 || rawLine.indexOf('al corte del') >= 0));

                // Detectar viñetas: empieza con •, -, *, o número.
                var esVineta = /^([•\-\*]|\d+\.)\s+(.+)$/.test(rawLine);

                if (esHeroKPI) {
                    // Opción 1: Hero Stat Card destacada con cifra protagónica
                    var cleanText = rawLine.replace(/[\*\_]/g, '');
                    var valorMatch = cleanText.match(/(?:₡\s*[\d\.\,]+\s*[MBKmbk]?|[\d\.\,]+\s*\%)/i);
                    var periodoMatch = cleanText.match(/\b(0[1-9]|1[0-2])\/\d{4}\b/);
                    var valorStr = valorMatch ? valorMatch[0].trim() : '';
                    var periodoStr = periodoMatch ? periodoMatch[0].trim() : '';

                    var nombreIndicador = '';
                    var allBolds = rawLine.match(/\*\*(.*?)\*\*/g);
                    if (allBolds && allBolds.length > 0) {
                        var candidate = allBolds[0].replace(/\*\*/g, '').trim();
                        if (candidate !== valorStr && candidate !== periodoStr) {
                            nombreIndicador = candidate;
                        }
                    }
                    if (!nombreIndicador) {
                        var mPre = cleanText.match(/(?:Tu|El saldo de la|El saldo del|El saldo de|El ratio de|El|La)\s+(.*?)\s+cerr[oó]/i);
                        if (mPre && mPre[1]) {
                            nombreIndicador = mPre[1].trim();
                        }
                    }

                    if (valorStr) {
                        var badgeTitle = nombreIndicador ? nombreIndicador : 'Indicador Financiero';
                        var iconHeader = 'fa-line-chart';
                        if (/cartera|cr[eé]dito/i.test(badgeTitle)) iconHeader = 'fa-credit-card';
                        else if (/suficiencia|patrimoni/i.test(badgeTitle)) iconHeader = 'fa-shield';
                        else if (/morosidad|mora/i.test(badgeTitle)) iconHeader = 'fa-exclamation-triangle';
                        else if (/obligaci|p[uú]blico/i.test(badgeTitle)) iconHeader = 'fa-university';
                        else if (/capital/i.test(badgeTitle)) iconHeader = 'fa-pie-chart';
                        else if (/resultado|excedente/i.test(badgeTitle)) iconHeader = 'fa-money';
                        else if (/eficiencia|costo/i.test(badgeTitle)) iconHeader = 'fa-tachometer';
                        else if (/activo/i.test(badgeTitle)) iconHeader = 'fa-cubes';
                        else if (/apalancamiento/i.test(badgeTitle)) iconHeader = 'fa-balance-scale';

                        var heroCard = 
                            '<div class="sac-kpi-hero-card" style="background: linear-gradient(135deg, #ffffff 0%, #f0f7ff 100%) !important; border: 1px solid #bae6fd !important; border-left: 4px solid #0071AD !important; border-radius: 10px !important; padding: 10px 14px 9px 14px !important; margin-bottom: 10px !important; box-shadow: 0 2px 6px rgba(0, 113, 173, 0.08) !important; display: block !important;">' +
                                '<div class="sac-kpi-hero-top" style="display: flex !important; align-items: center !important; justify-content: space-between !important; width: 100% !important; gap: 8px !important; margin-bottom: 4px !important;">' +
                                    '<span class="sac-kpi-hero-badge" style="font-size: 11px !important; font-weight: 700 !important; text-transform: uppercase !important; letter-spacing: 0.5px !important; color: #0284c7 !important; display: inline-flex !important; align-items: center !important; gap: 5px !important;"><i class="fa ' + iconHeader + '" style="color: #0071AD !important;"></i> ' + $('<div>').text(badgeTitle.toUpperCase()).html() + '</span>' +
                                    (periodoStr ? '<span class="sac-kpi-hero-period" style="font-size: 10.5px !important; font-weight: 700 !important; color: #475569 !important; background: #e2e8f0 !important; padding: 2px 8px !important; border-radius: 6px !important; display: inline-flex !important; align-items: center !important; gap: 4px !important; margin-left: auto !important; white-space: nowrap !important;"><i class="fa fa-calendar-o"></i> ' + $('<div>').text(periodoStr).html() + '</span>' : '') +
                                '</div>' +
                                '<div class="sac-kpi-hero-value" style="font-size: 22px !important; font-weight: 800 !important; color: #004b75 !important; line-height: 1.2 !important; margin: 3px 0 2px 0 !important; letter-spacing: -0.3px !important; display: block !important;">' + $('<div>').text(valorStr).html() + '</div>' +
                                '<div class="sac-kpi-hero-desc" style="font-size: 10.5px !important; color: #0369a1 !important; font-weight: 600 !important; display: flex !important; align-items: center !important; gap: 4px !important; opacity: 0.9 !important;"><i class="fa fa-check-circle"></i> Saldo al corte del período</div>' +
                            '</div>';
                        htmlParts.push(heroCard);
                    } else {
                        htmlParts.push('<div class="sac-kpi-hero"><i class="fa fa-info-circle sac-kpi-hero-icon"></i><div class="sac-kpi-hero-text">' + lineSafe + '</div></div>');
                    }
                } else if (esTituloSeccion) {
                    var tituloLimpio = rawLine.replace(/[\*\_]/g, '').replace(/[\:]+$/, '').trim();
                    htmlParts.push('<div class="sac-section-heading"><i class="fa fa-bar-chart"></i> ' + $('<div>').text(tituloLimpio).html() + '</div>');
                } else if (esVineta) {
                    var matchVineta = rawLine.match(/^([•\-\*]|\d+\.)\s+(.+)$/);
                    var textoVineta = matchVineta ? matchVineta[2] : rawLine;
                    
                    var vinetaSafe = $('<div>').text(textoVineta).html()
                        .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                        .replace(/\*(.*?)\*/g, '<em>$1</em>');

                    // Icono contextual dinámico
                    var iconFa = 'fa-chevron-right';
                    if (/\[CR[IÍ]TICA\]/i.test(textoVineta) || /alerta|riesgo|atenci[oó]n|atraso/i.test(textoVineta)) {
                        iconFa = 'fa-exclamation-circle';
                    } else if (/variaci[oó]n|evoluci[oó]n|tendencia|al alza|a la baja|estable/i.test(textoVineta)) {
                        iconFa = 'fa-exchange';
                    } else if (/sugef|norma|regulatorio|umbral|ley/i.test(textoVineta)) {
                        iconFa = 'fa-shield';
                    } else if (/corte|fecha|periodo/i.test(textoVineta)) {
                        iconFa = 'fa-calendar';
                    } else if (/asociado|asociación|capital/i.test(textoVineta)) {
                        iconFa = 'fa-users';
                    }

                    // Resaltar cumplimiento normativo con insignia verde
                    vinetaSafe = vinetaSafe.replace(/Cumple el m[ií]nimo regulatorio/gi, '<span class="sac-badge-cumple"><i class="fa fa-check"></i> Cumple SUGEF</span>');

                    // Insignias para Alertas Críticas y Advertencias
                    vinetaSafe = vinetaSafe.replace(/\[CR[IÍ]TICA\]/gi, '<span class="sac-badge-crit"><i class="fa fa-exclamation-triangle"></i> CRÍTICA</span>');
                    vinetaSafe = vinetaSafe.replace(/\[ADVERTENCIA\]/gi, '<span class="sac-badge-adv"><i class="fa fa-info-circle"></i> ADVERTENCIA</span>');

                    // Resaltar comparación de períodos (ej. vs. 08/2025 o vs. mes anterior)
                    vinetaSafe = vinetaSafe.replace(/(vs\.\s+[0-9]{2}\/[0-9]{4})/gi, '<strong>$1</strong>');
                    vinetaSafe = vinetaSafe.replace(/\((interanual|vs\.\s+mes anterior)\)/gi, '<span class="sac-badge-period-comp">($1)</span>');

                    htmlParts.push('<div class="sac-bullet-item"><span class="sac-bullet-icon"><i class="fa ' + iconFa + '"></i></span><div class="sac-bullet-body">' + vinetaSafe + '</div></div>');
                } else {
                    htmlParts.push('<div class="sac-msg-p">' + lineSafe + '</div>');
                }
            }

            return htmlParts.join('');
        }
    })();
</script>
