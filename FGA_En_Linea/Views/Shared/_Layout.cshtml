    /* ==========================================================================
       UNIVERSAL FLOATING TOAST NOTIFICATIONS (FFC Modern UI)
       ========================================================================== */
    .fga-toast-container {
        position: fixed !important;
        bottom: 24px !important;
        right: 24px !important;
        z-index: 999999 !important;
        display: flex !important;
        flex-direction: column !important;
        gap: 10px !important;
        pointer-events: none !important;
        max-width: 440px !important;
        width: calc(100% - 48px) !important;
    }

    .fga-toast-item {
        pointer-events: auto !important;
        display: flex !important;
        align-items: center !important;
        gap: 12px !important;
        padding: 13px 18px !important;
        background: #0f172a !important;
        color: #ffffff !important;
        border-radius: 10px !important;
        box-shadow: 0 10px 25px -3px rgba(0, 0, 0, 0.35), 0 4px 6px -2px rgba(0, 0, 0, 0.1) !important;
        font-size: 13.5px !important;
        font-weight: 500 !important;
        line-height: 1.4 !important;
        border-left: 4px solid #10b981 !important;
        animation: fgaToastSlideIn 0.32s cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
