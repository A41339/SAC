@{
    string rawPageTitle = (ViewBag.Title ?? "").ToString();
    string cleanPageTitle = System.Web.HttpUtility.HtmlDecode(rawPageTitle);
    if (!string.IsNullOrEmpty(cleanPageTitle))
    {
        cleanPageTitle = cleanPageTitle
            .Replace("CategorÃa", "Período")
            .Replace("categorÃa", "período")
            .Replace("MenÃƒÂº", "Menú")
            .Replace("MenÃÂº", "Menú")
            .Replace("MenÃº", "Menú")
            .Replace("ÃƒÂ¡", "á").Replace("ÃƒÂ©", "é").Replace("ÃƒÂ­", "í").Replace("ÃƒÂ³", "ó").Replace("ÃƒÂº", "ú").Replace("ÃƒÂ±", "ñ")
            .Replace("ÃÂ¡", "á").Replace("ÃÂ©", "é").Replace("ÃÂ­", "í").Replace("ÃÂ³", "ó").Replace("ÃÂº", "ú").Replace("ÃÂ±", "ñ")
            .Replace("Ã¡", "á").Replace("Ã©", "é").Replace("Ã­", "í").Replace("Ã³", "ó").Replace("Ãº", "ú").Replace("Ã±", "ñ")
            .Replace("Ã‰", "É").Replace("Ã“", "Ó").Replace("Ãš", "Ú").Replace("Ã‘", "Ñ")
            .Replace("Ã", "Á").Replace("Ã ", "Á");
    }
}
    <title>@(string.IsNullOrWhiteSpace(cleanPageTitle) ? "FFC" : cleanPageTitle + " - FFC")</title>
