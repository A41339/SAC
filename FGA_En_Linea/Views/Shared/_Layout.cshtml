    @Scripts.Render("~/bundles/javascript")
    <script type="text/javascript">
        // ==========================================================================
        // SISTEMA UNIVERSAL DE NOTIFICACIONES TOAST FLOTANTES (FFC Modern UI)
        // ==========================================================================
        (function () {
            var shownMessages = {};

            window.mostrarToast = function (mensaje, tipo, titulo, duracion) {
                if (!mensaje) return;
                tipo = tipo || 'success';
                duracion = duracion || (tipo === 'error' || tipo === 'danger' ? 5000 : 3500);

                var iconClass = 'fa-check-circle';
                if (tipo === 'error' || tipo === 'danger') {
                    tipo = 'error';
                    iconClass = 'fa-times-circle';
                } else if (tipo === 'warning' || tipo === 'advertencia') {
                    tipo = 'warning';
                    iconClass = 'fa-exclamation-triangle';
                } else if (tipo === 'info') {
                    iconClass = 'fa-info-circle';
                } else {
                    tipo = 'success';
                }

                var cleanMsg = mensaje;
                if (window.sanitizeTextAccents) {
                    cleanMsg = window.sanitizeTextAccents(cleanMsg);
                }
                if (typeof cleanMsg === 'string') {
                    cleanMsg = cleanMsg.replace(/^(\s*<br\s*\/?>)+/gi, '').trim();
                }

                // Prevenir mensajes idénticos duplicados en rápida sucesión (<1.5s)
                var dedupeKey = tipo + ':' + cleanMsg;
                if (shownMessages[dedupeKey]) return;
                shownMessages[dedupeKey] = true;
                setTimeout(function () { delete shownMessages[dedupeKey]; }, 1500);

                var $container = $('#fgaToastContainer');
                if ($container.length === 0) {
                    $container = $('<div id="fgaToastContainer" class="fga-toast-container"></div>').appendTo('body');
                }

                var cleanTitle = titulo ? (window.sanitizeTextAccents ? window.sanitizeTextAccents(titulo) : titulo) : '';
                var titleHtml = cleanTitle ? '<div class="toast-title">' + cleanTitle + '</div>' : '';

                var $toast = $(
                    '<div class="fga-toast-item toast-' + tipo + '">' +
                        '<i class="fa ' + iconClass + ' toast-icon"></i>' +
                        '<div class="toast-body">' +
                            titleHtml +
                            '<div class="toast-message">' + cleanMsg + '</div>' +
                        '</div>' +
                        '<button type="button" class="toast-close" title="Cerrar">&times;</button>' +
                    '</div>'
                );

                $container.append($toast);

                var removeTimer = setTimeout(function () {
                    cerrarToast();
                }, duracion);

                function cerrarToast() {
                    clearTimeout(removeTimer);
                    $toast.css('animation', 'fgaToastFadeOut 0.3s forwards');
                    setTimeout(function () {
                        $toast.remove();
                    }, 300);
                }

                $toast.find('.toast-close').on('click', function () {
                    cerrarToast();
                });
            };

            window.mostrarToastExito = function (mensaje, titulo) {
                window.mostrarToast(mensaje, 'success', titulo);
            };

            window.mostrarToastError = function (mensaje, titulo) {
                window.mostrarToast(mensaje, 'error', titulo || 'Atención');
            };

            window.mostrarToastInfo = function (mensaje, titulo) {
                window.mostrarToast(mensaje, 'info', titulo);
            };

            window.mostrarToastAdvertencia = function (mensaje, titulo) {
                window.mostrarToast(mensaje, 'warning', titulo || 'Advertencia');
            };

            // Interceptor de compatibilidad para jquery-stickynotif ($.sticky)
            // Utilizado históricamente por StarkAjaxFormSubmiter y notij.js
            if (window.jQuery) {
                jQuery.sticky = function (msg, opts) {
                    var tipo = 'success';
                    if (opts && opts.stickyClass) {
                        var sc = ('' + opts.stickyClass).toLowerCase();
                        if (sc.indexOf('error') !== -1 || sc.indexOf('danger') !== -1 || sc.indexOf('fail') !== -1) {
                            tipo = 'error';
                        } else if (sc.indexOf('warn') !== -1) {
                            tipo = 'warning';
                        } else if (sc.indexOf('info') !== -1) {
                            tipo = 'info';
                        }
                    }
                    window.mostrarToast(msg, tipo);
                    return { id: Math.floor(Math.random() * 99999), duplicate: 'no', displayed: true, position: 'top-right' };
                };
                if (jQuery.fn) {
                    jQuery.fn.sticky = function (msg, opts) {
                        return jQuery.sticky(msg || $(this).html(), opts);
                    };
                }
            }
        })();
    </script>
