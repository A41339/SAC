<!DOCTYPE html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="description" content="Somos un sistema de protecci&oacute;n que brinda Garant&iacute;a a los ahorrantes y tambi&eacute;n otorga respaldo institucional a las Cooperativas socias.">
    <meta property="og:type" content="website" />
    <meta property="og:title" content="FGA Conf&iacute;a" />
    <meta property="og:description" content="Somos un sistema de protecci&oacute;n que brinda Garant&iacute;a a los ahorrantes y tambi&eacute;n otorga respaldo institucional a las Cooperativas socias." />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>@Html.Raw(ViewBag.Title) - FFC</title>
    <meta content="width=device-width, initial-scale=0.8, maximum-scale=1, user-scalable=no" name="viewport">
    <link rel="icon" href="~/favicon.ico">
    @Styles.Render("~/Content/css")
    <link rel="stylesheet" href="~/Content/theme/bower_components/font-awesome/css/font-awesome.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" />
    <link rel="stylesheet" href="~/Content/dashboard_modern.css?v=@DateTime.Now.Ticks" />
    @Scripts.Render("~/bundles/javascript")
    @Html.Action("HeaderCssJs", "Layout")
    @RenderSection("ScriptsOrCss", required: false)
    <script src="~/signalr/hubs"></script>
    @{ TempData["ThisUrl"] = Request.Url.ToString(); }
    <script src="~/Content/DataTable/new/pdfmake.min.js"></script>
    <script src="~/Content/DataTable/new/vfs_fonts.js"></script>
    <script src="https://code.highcharts.com/highcharts.js"></script>
    <script src="https://code.highcharts.com/modules/exporting.js"></script>
    <script src="https://code.highcharts.com/modules/export-data.js"></script>
    <script src="https://code.highcharts.com/modules/offline-exporting.js"></script>
    <script>
        window.formatGlobalChartTooltip = function (ctx) {
            if (!ctx) return '';
            var p0 = (ctx.points && ctx.points.length > 0) ? ctx.points[0] : (ctx.point || ctx);
            var xAxis = (p0 && p0.series && p0.series.xAxis) ? p0.series.xAxis : null;

            var headerText = '';
            if (ctx.category !== undefined && ctx.category !== null && ('' + ctx.category).trim() !== '') {
                headerText = '' + ctx.category;
            } else if (p0 && p0.category !== undefined && p0.category !== null && ('' + p0.category).trim() !== '') {
                headerText = '' + p0.category;
            } else if (xAxis && xAxis.categories && p0 && p0.x !== undefined && xAxis.categories[p0.x]) {
                headerText = '' + xAxis.categories[p0.x];
            } else if (p0 && p0.key !== undefined && p0.key !== null) {
                var kStr = '' + p0.key;
                if (isNaN(Number(kStr)) || kStr.indexOf('-') !== -1 || kStr.indexOf('/') !== -1) {
                    headerText = kStr;
                }
            } else if (p0 && p0.name) {
                headerText = '' + p0.name;
            }

            // Suppress raw integer index (0, 1, 2...)
            if (headerText && /^\d+$/.test(headerText.trim())) {
                headerText = '';
            }

            function formatTooltipVal(point) {
                var val = point.y;
                if (val === null || typeof val === 'undefined') return '-';

                var sName = (point.series && point.series.name) ? point.series.name.toLowerCase() : '';
                var yAxisOpts = (point.series && point.series.yAxis && point.series.yAxis.options) ? point.series.yAxis.options : {};
                var yTitle = (yAxisOpts.title && yAxisOpts.title.text) ? yAxisOpts.title.text.toLowerCase() : '';
                var yLabels = yAxisOpts.labels || {};
                var sSuffix = (point.series && point.series.tooltipOptions && point.series.tooltipOptions.valueSuffix) || '';

                if (point.percentage !== undefined && point.series && point.series.type === 'column' &&
                    point.series.chart && point.series.chart.options && point.series.chart.options.plotOptions &&
                    point.series.chart.options.plotOptions.column && point.series.chart.options.plotOptions.column.stacking === 'percent') {
                    return Highcharts.numberFormat(point.percentage, 2, '.', ',') + '%';
                }

                var isYAxisPercent = yTitle.indexOf('%') !== -1 ||
                                     yTitle.indexOf('porcent') !== -1 ||
                                     (yLabels.formatter && ('' + yLabels.formatter).indexOf('Percent') !== -1);

                var isPct = sSuffix.indexOf('%') !== -1 ||
                            sName.indexOf('%') !== -1 ||
                            sName.indexOf('tasa') !== -1 ||
                            sName.indexOf('porcent') !== -1 ||
                            sName.indexOf('margen') !== -1 ||
                            sName.indexOf('suficiencia') !== -1 ||
                            sName.indexOf('cobertura') !== -1 ||
                            sName.indexOf('mora') !== -1 ||
                            sName.indexOf('al d') !== -1 ||
                            isYAxisPercent;

                if (isPct) {
                    return Highcharts.numberFormat(val, 2, '.', ',') + '%';
                }

                if (val % 1 !== 0) {
                    return Highcharts.numberFormat(val, 2, '.', ',');
                } else {
                    return Highcharts.numberFormat(val, 0, '.', ',');
                }
            }

            var html = '<div class="fga-chart-tooltip">';
            if (headerText && headerText.trim() !== '') {
                html += '<div class="tt-header">' + headerText + '</div>';
            }
            html += '<table class="tt-table">';

            if (ctx.points && ctx.points.length > 0) {
                for (var i = 0; i < ctx.points.length; i++) {
                    var pt = ctx.points[i];
                    if (pt.series && pt.series.visible === false) continue;
                    var sColor = (pt.color || (pt.series && pt.series.color) || '#0284c7');
                    var sName = (pt.series && pt.series.name) ? pt.series.name : 'Valor';
                    var sVal = formatTooltipVal(pt);

                    html += '<tr>';
                    html += '<td class="tt-bullet" style="color:' + sColor + '">&#9679;</td>';
                    html += '<td class="tt-name">' + sName + ':</td>';
                    html += '<td class="tt-val">' + sVal + '</td>';
                    html += '</tr>';
                }
            } else {
                var singlePt = ctx.point || ctx;
                var sColor = (singlePt.color || (ctx.series && ctx.series.color) || '#0284c7');
                var sName = (ctx.series && ctx.series.name) ? ctx.series.name : (singlePt.name || 'Valor');
                var sVal = formatTooltipVal(singlePt);

                html += '<tr>';
                html += '<td class="tt-bullet" style="color:' + sColor + '">&#9679;</td>';
                html += '<td class="tt-name">' + sName + ':</td>';
                html += '<td class="tt-val">' + sVal + '</td>';
                html += '</tr>';
            }

            html += '</table></div>';
            return html;
        };

        (function() {
            var anim = localStorage.getItem('fga_charts_animation');
            var isAnimEnabled = (anim === null || anim === 'true');
            if (anim === null) {
                try { localStorage.setItem('fga_charts_animation', 'true'); } catch (e) {}
            }
            if (typeof Highcharts !== 'undefined') {
                    .on('mouseenter mouseover', '.highcharts-menu-item', function () {
        if (.find('hr').length > 0) {
            .css({ 'padding': '2px 0', 'margin': '2px 0', 'background': 'transparent', 'cursor': 'default', 'pointer-events': 'none', 'height': '1px', 'line-height': '1px' });
            .find('hr').css({ 'margin': '0', 'border': 'none', 'border-top': '1px solid #e2e8f0', 'height': '1px' });
        }
    });

    $(document).on('mouseover', '.highcharts-menu-item', function () {
        if ($(this).find('hr').length > 0) {
            $(this).css({ 'padding': '2px 0', 'margin': '2px 0', 'background': 'transparent', 'cursor': 'default', 'pointer-events': 'none', 'height': '1px', 'line-height': '1px' });
            $(this).find('hr').css({ 'margin': '0', 'border': 'none', 'border-top': '1px solid #e2e8f0', 'height': '1px' });
        }
    });

    Highcharts.setOptions({
                    chart: {
                        style: {
                            fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif'
                        },
                        animation: isAnimEnabled ? { duration: 1200, easing: 'easeOutCubic' } : false
                    },
                    tooltip: {
                        shared: true,
                        useHTML: true,
                        formatter: function () {
                            return window.formatGlobalChartTooltip ? window.formatGlobalChartTooltip(this) : null;
                        },
                        backgroundColor: '#ffffff',
                        borderColor: '#e2e8f0',
                        borderRadius: 8,
                        borderWidth: 1,
                        shadow: {
                            color: 'rgba(0, 0, 0, 0.08)',
                            offsetX: 0,
                            offsetY: 4,
                            opacity: 0.1,
                            width: 8
                        },
                        style: {
                            color: '#1e293b',
                            fontSize: '12px'
                        }
                    },
                    legend: {
                        itemStyle: {
                            color: '#334155',
                            fontWeight: '600',
                            fontSize: '12px'
                        },
                        itemHoverStyle: {
                            color: '#2F5597'
                        }
                    },
                    colors: ['#1d6fa4', '#2d9f8f', '#5a7fc4', '#d4a843', '#4caf7d', '#b05770', '#6b8cba', '#8d6bbf', '#e07b45', '#7a8fa0'],
                    plotOptions: {
                        series: {
                            animation: isAnimEnabled ? { duration: 1200 } : false,
                            marker: {
                                radius: 4,
                                lineWidth: 0
                            }
                        },
                        spline: {
                            animation: isAnimEnabled ? { duration: 1200 } : false,
                            lineWidth: 3
                        },
                        areaspline: {
                            animation: isAnimEnabled ? { duration: 1200 } : false,
                            fillOpacity: 0.18,
                            lineWidth: 2
                        },
                        line: {
                            animation: isAnimEnabled ? { duration: 1200 } : false,
                            lineWidth: 2.5
                        },
                        column: {
                            animation: isAnimEnabled ? { duration: 1000 } : false,
                            borderRadius: 4,
                            borderWidth: 0
                        },
                        bar: {
                            animation: isAnimEnabled ? { duration: 1000 } : false,
                            borderRadius: 4,
                            borderWidth: 0
                        }
                    }
                });
            }
        })();
    </script>
</head>

<style>
    /* Highcharts Export Button Styling - Blue Button with Download Icon & Text */
    .highcharts-contextbutton,
    .highcharts-button,
    .highcharts-exporting-group {
        display: block !important;
        opacity: 1 !important;
        visibility: visible !important;
        cursor: pointer !important;
    }

    .highcharts-credits {
        display: none !important;
    }

    /* Keep button text and symbol clearly visible */
    .highcharts-button text,
    .highcharts-contextbutton text,
    .highcharts-button tspan,
    .highcharts-contextbutton tspan {
        display: inline-block !important;
        visibility: visible !important;
        opacity: 1 !important;
        fill: #ffffff !important;
        color: #ffffff !important;
        font-size: 12px !important;
        font-weight: 600 !important;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif !important;
    }

    .highcharts-button .highcharts-button-box,
    .highcharts-contextbutton .highcharts-button-box {
        fill: #2F5597 !important;
        stroke: #204880 !important;
        stroke-width: 1px !important;
        rx: 6px !important;
        ry: 6px !important;
    }

    .highcharts-button:hover .highcharts-button-box,
    .highcharts-contextbutton:hover .highcharts-button-box {
        fill: #204880 !important;
        stroke: #172e56 !important;
    }

    .highcharts-button-symbol,
    .highcharts-contextbutton .highcharts-button-symbol {
        opacity: 1 !important;
        visibility: visible !important;
        stroke: #ffffff !important;
        stroke-width: 1.8px !important;
        fill: none !important;
    }
</style>

@{
    var isCollapsed = Session[FGA.Utility.Utilitarios.show_MenuOculto] is null ? "" : "sidebar-collapse";
}

<body id="body" class="hold-transition skin-blue modern-dashboard-body @isCollapsed sidebar-mini">
    <div id="starkloader" style="top: 30%; left: 50%; position: fixed; z-index: 9999; display: none;width:50px;">
        <img src="~/Content/notifire/loading3.gif" />
    </div>
    <div class="wrapper">
        <header class="main-header">
            <div class="header-bg-backdrop">
                <div class="glow-orb header-orb-1"></div>
                <div class="glow-orb header-orb-2"></div>
                <canvas id="headerCanvas" class="header-particle-canvas"></canvas>
            </div>
            <a href="~/Home/Index" class="logo" style="text-decoration: none;">
                <span class="logo-mini" style="font-weight: 800; font-size: 18px; color: #ffffff; letter-spacing: 1px;">FFC</span>
                <div class="logo-lg" style="display: flex; align-items: center; justify-content: flex-start; padding-left: 16px; height: 100%;">
                    <img src="~/Content/images/FFC_Logo_Blanco.png" alt="FFC - Fondo de Fortalecimiento Cooperativo" style="max-height: 42px; width: auto; object-fit: contain; filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.25)); transition: transform 0.25s ease;" />
                </div>
            </a>
            <nav class="navbar navbar-static-top">
                <a href="#" class="sidebar-toggle" data-toggle="push-menu" role="button">
                    <span class="sr-only">Toggle navigation</span>
                </a>
                <div class="navbar-custom-menu">
                    <ul class="nav navbar-nav">
                        <li class="dropdown user user-menu">
                            <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                                @{ var sexo = int.Parse(Env.GetUserInfo("gender")) == 1 ? "~/Content/theme/dist/img/mujer.png" : "~/Content/theme/dist/img/hombre.png"; }
                                <img src="@Url.Content(sexo)" class="user-image" alt="Usuario" />
                                <span class="hidden-xs contenedor">@Env.GetUserInfo("name")</span>
                            </a>
                            <ul class="dropdown-menu">
                                <li class="user-header">
                                    <img src="~/Content/images/@Env.GetUserInfo("logo")" class="img-circle" alt="User Image" />
                                    <p>
                                        @Env.GetUserInfo("name")
                                        <small>Fecha: @DateTime.Now.Date.ToShortDateString() </small>
                                    </p>
                                </li>
                                <li class="user-footer">
                                    <div class="pull-left">
                                        <a href="~/Usuario/ChangePassword/@Env.GetUserInfo("userid")" class="btn btn-default btn-flat">Perfil</a>
                                    </div>
                                    <div class="pull-right">
                                        <a href="~/Account/signout" class="btn btn-default btn-flat">Cerrar sesi&oacute;n</a>
                                    </div>
                                </li>
                            </ul>
                        </li>
                        <li class="control-sidebar-toggle-wrapper">
                            <a href="javascript:void(0);" data-toggle="control-sidebar" class="control-sidebar-toggle-btn needsclick" title="Preferencias del Sistema">
                                <i class="fa fa-gears"></i>
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>
        </header>
        <aside class="main-sidebar modern-sidebar">
            <div class="glow-orb sidebar-orb-1"></div>
            <div class="glow-orb sidebar-orb-2"></div>
            <canvas id="sidebarCanvas" class="sidebar-particle-canvas"></canvas>
            <section class="sidebar" style="display: flex; flex-direction: column; min-height: calc(100vh - 60px);">
                <div>
                    @Env.GetMenuBarPage(null)
                </div>
                <div class="sidebar-logout-wrapper">
                    <a href="~/Account/signout" class="sidebar-logout-btn" draggable="false">
                        <i class="fa fa-sign-out"></i>
                        <span>Cerrar Sesi&oacute;n</span>
                    </a>
                </div>
            </section>
        </aside>
        <div class="content-wrapper">
            @RenderBody()
        </div>
        <div id="chatContainer" class="small-chat-box fadeInRight animated" style="display: none !important;">
            <div id="sidebar-chat">
                <div id="profile">
                    <div class="wrap">
                        <img id="profile-img" src="~/Content/images/@Env.GetUserInfo("logo")" class="online" alt="" />
                        <p>@Env.GetUserInfo("entidad")</p>
                    </div>
                </div>
                <div id="contacts">
                    <ul id="contact_panel"></ul>
                </div>
            </div>
            <div id="discussion" class="content">
                <div class="left">
                    <div class="author-name">
                        FGA
                    </div>
                    <div class="chat-message">
                        Estamos para servirle
                    </div>
                </div>
            </div>
            <div class="form-chat">
                <div class="input-group input-group-sm">
                    <input id="message" name="message" type="text" class="form-control" onkeypress="return onEnterDown(event)"> <span class="input-group-btn">
                        <button id="sendmessage" class="btn btn-primary" type="button">
                            Enviar
                        </button>
                    </span>
                </div>
            </div>
        </div>
        <div id="small-chat" style="display: none !important;">
            <span id="alert_chat" class="badge badge-warning float-right"></span>
            <a id="open_chat" class="open-small-chat">
                <i class="fa fa-comments"></i>
            </a>
        </div>
        <input type="hidden" id="activecontactid" />
        <input type="hidden" id="myid" />
        <input type="hidden" id="myname" />
        <input type="hidden" id="companyname" />

        @Html.Action("Index", "ParameterPartial")
    </div>
</body>

<script type="text/javascript">

        // Open close small chat
        $('.open-small-chat').on('click', function (e) {
            e.preventDefault();
            $(this).children().toggleClass('fa-comments').toggleClass('fa-times');
            $('.small-chat-box').toggleClass('active');
            $('.message').focus();
        });

        // Initialize slimscroll for small chat
        $('.small-chat-box .content').slimScroll({
            height: '400px',
            railOpacity: 0.4
        });

        $(document).on('change', '.config', function () {

            if ($('#ckc_configMenu').is(":checked"))
                $('body').addClass('sidebar-collapse');
            else
                $('body').removeClass('sidebar-collapse');

            $.ajax({
                async: true,
                type: "GET",
                dataType: "json",
                contentType: "application/json",
                url: '@Url.Action("Config", "ParameterPartial")',
                data: {
                    'yAxis': $('#ckc_configYAxis').is(":checked"),
                    'columnDetail': $('#ckc_configColumnDetail').is(":checked"),
                    'lineDetail': $('#ckc_configLineDetail').is(":checked"),
                    'dateDetail': $('#ckc_configDateEach').is(":checked"),
                    'menuDetail': $('#ckc_configMenu').is(":checked")
                }
            });
        });

        function onEnterDown(event) {
	        if (event.which == 13 || event.keyCode == 13)
		         $("#sendmessage").click();
        }

        $("#open_chat").click(function () {
            $('#alert_chat').text('');
        });

        $(function () {
            if (!$.connection || !$.connection.chatHub) {
                return;
            }

            var chat = $.connection.chatHub;

            chat.client.addNewMessageToPage = function (name, to, message, time, idTo, idFrom) {

                var count = '';

                if ($('#activecontactid').val() == idTo) {
                    if (idFrom == $('#myid').val())
                        $('#discussion').append('<div class="right"> <div class="author-name"> ' + htmlEncode(name) + '<br/> <small class="chat-date"> ' + time + ' </small></div><div class="chat-message active"> ' + htmlEncode(message) + '</div></div>');
                    else
                        $('#discussion').append('<div class="left"> <div class="author-name"> ' + htmlEncode(name) + '<br/> <small class="chat-date"> ' + time + ' </small></div><div class="chat-message"> ' + htmlEncode(message) + '</div></div>');
                }
                else {
                    var msjO = $('#lbl_' + idTo).text();
                    if (msjO == '')
                        msjO = 1;
                    else
                        msjO = parseInt(msjO) + 1;

                    $('#lbl_' + idTo).text(msjO);
                }

                if (!$('#chatContainer').hasClass('active')) {
                    count = $('#alert_chat').text();
                    if (count == '')
                        count = 1;
                    else
                        count = parseInt(count) + 1;
                }

                $('#alert_chat').text(count);
                $('#discussion').animate({scrollTop: $('#discussion').get(0).scrollHeight}, 1000);
            };

            chat.client.addContact = function (idUser, name, company, logo) {
                if ($('#companyname').val() != company) {
                    if (company == '@FGA.Utility.Utilitarios.nombreEntidadAdmin'){
                        $('#contact_panel').append('<li  class="contact active"><div class="wrap"> <span class="contact-status online"></span><img src="' + logo + '" alt="" />' +
                            '<div class="meta"> <p class="name">' + company + '</p>  </div></div></li>');
                    }
                    else {
                         $('#contact_panel').append('<li id="' + idUser + '" class="contact"><div class="wrap"> <span class="contact-status online"></span><img src="' + logo + '" alt="" />' +
                            '<div class="meta"> <p class="name">' + company + ' <label id="lbl_' + idUser + '" class="badge badge-warning float-right"></label></p> <p class="preview">' + name + '</p></div></div></li>');
                    }
                }
            };

            chat.client.clearContacts = function () {
                $('#contact_panel').empty();
            };

            $('#activecontactid').val('@FGA.Utility.Utilitarios.entidadAdministradora');
            $('#myid').val('@Env.GetUserInfo("userid")');
            $('#myname').val('@Env.GetUserInfo("name")');
            $('#message').focus();
            $('#companyname').val('@Env.GetUserInfo("entidad")');

            if ($.connection.hub) {
                $.connection.hub.start().done(function () {

                    chat.server.connect($('#myid').val(), $('#myname').val(), $('#activecontactid').val(), $('#companyname').val());

                    $('#sendmessage').click(function () {
                       chat.server.send($('#myid').val(), $('#activecontactid').val(), $('#message').val());
                       $('#message').val('').focus();
                    });

                    $(document).on('click', '.contact', function () {

                        var id = $(this).attr('id');

                        $('.contact').removeClass('active');
                        $(this).addClass('active');
                        $('#activecontactid').val(id);
                        $('#lbl_' + id).text('');
                        $('#discussion').empty();

                        chat.server.getHistory($('#myid').val(), $('#activecontactid').val(), 5);
                    });

                    $("#open_chat").click(function () {
                        if ($('#chatContainer').hasClass('active')) {
                             $('#discussion').empty();
                            chat.server.getHistory($('#myid').val(), $('#activecontactid').val(), 5);
                        }
                    });
                });
            }
        });

        function htmlEncode(value) {
            var encodedValue = $('<div />').text(value).html();
            return encodedValue;
        }

      $(function () {
        $('.tableHighChart').DataTable();
      });


    if (window.Highcharts && Highcharts.SVGRenderer && Highcharts.SVGRenderer.prototype.symbols) {
        var customDownloadSymbol = function (x, y, w, h) {
            return [
                // Tray
                'M', x + 1, y + 8,
                'L', x + 1, y + 12,
                'L', x + 11, y + 12,
                'L', x + 11, y + 8,
                // Arrow shaft
                'M', x + 6, y + 2,
                'L', x + 6, y + 8,
                // Arrow tip
                'M', x + 3, y + 5,
                'L', x + 6, y + 8,
                'L', x + 9, y + 5
            ];
        };
        Highcharts.SVGRenderer.prototype.symbols.download = customDownloadSymbol;
        Highcharts.SVGRenderer.prototype.symbols.menu = customDownloadSymbol;
        Highcharts.SVGRenderer.prototype.symbols.printer = customDownloadSymbol;
        Highcharts.SVGRenderer.prototype.symbols.menuball = customDownloadSymbol;
    }

    Highcharts.setOptions({
        lang: {
            decimalPoint: '.',
            thousandsSep: '',
            viewData: '<i class="fa fa-table" style="color: #4338ca; margin-right: 10px; width: 16px; text-align: center;"></i> Ver tabla',
            downloadPNG: '<i class="fa fa-picture-o" style="color: #0284c7; margin-right: 10px; width: 16px; text-align: center;"></i> Descargar PNG',
            downloadJPEG: '<i class="fa fa-picture-o" style="color: #0284c7; margin-right: 10px; width: 16px; text-align: center;"></i> Descargar JPEG',
