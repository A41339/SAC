    /* FontAwesome icons inside btn-ampliar: inline-block preserves ::before glyph rendering */
    a.btn-ampliar i, a.btn-ampliar i[class*="fa-"],
    .btn-ampliar i, .btn-ampliar i[class*="fa-"],
