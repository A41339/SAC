    <script src="https://code.highcharts.com/modules/export-data.js"></script>
    <script src="https://code.highcharts.com/modules/offline-exporting.js"></script>
    <script>
        window.formatGlobalChartTooltip = function (ctx) {
            if (!ctx) return '';
            var p0 = (ctx.points && ctx.points.length > 0) ? ctx.points[0] : (ctx.point || ctx);
            var xAxis = (p0 && p0.series && p0.series.xAxis) ? p0.series.xAxis : null;

            var headerText = '';
            if (ctx.category !== undefined && ctx.category !== null && ('' + ctx.category).trim() !== '') {
                headerText = '' + ctx.category;
            } else if (p0 && p0.category !== undefined && p0.category !== null && ('' + p0.category).trim() !== '') {
                headerText = '' + p0.category;
            } else if (xAxis && xAxis.categories && p0 && p0.x !== undefined && xAxis.categories[p0.x]) {
                headerText = '' + xAxis.categories[p0.x];
            } else if (p0 && p0.key !== undefined && p0.key !== null) {
                var kStr = '' + p0.key;
                if (isNaN(Number(kStr)) || kStr.indexOf('-') !== -1 || kStr.indexOf('/') !== -1) {
                    headerText = kStr;
                }
            } else if (p0 && p0.name) {
                headerText = '' + p0.name;
            }

            // Suppress raw integer index (0, 1, 2...)
            if (headerText && /^\d+$/.test(headerText.trim())) {
                headerText = '';
            }

            function formatTooltipVal(point) {
                var val = point.y;
                if (val === null || typeof val === 'undefined') return '-';

                var sName = (point.series && point.series.name) ? point.series.name.toLowerCase() : '';
                var yAxisOpts = (point.series && point.series.yAxis && point.series.yAxis.options) ? point.series.yAxis.options : {};
                var yTitle = (yAxisOpts.title && yAxisOpts.title.text) ? yAxisOpts.title.text.toLowerCase() : '';
                var yLabels = yAxisOpts.labels || {};
                var sSuffix = (point.series && point.series.tooltipOptions && point.series.tooltipOptions.valueSuffix) || '';

                if (point.percentage !== undefined && point.series && point.series.type === 'column' &&
                    point.series.chart && point.series.chart.options && point.series.chart.options.plotOptions &&
                    point.series.chart.options.plotOptions.column && point.series.chart.options.plotOptions.column.stacking === 'percent') {
                    return Highcharts.numberFormat(point.percentage, 2, '.', ',') + '%';
                }

                var isYAxisPercent = yTitle.indexOf('%') !== -1 ||
                                     yTitle.indexOf('porcent') !== -1 ||
                                     (yLabels.formatter && ('' + yLabels.formatter).indexOf('Percent') !== -1);

                var isPct = sSuffix.indexOf('%') !== -1 ||
                            sName.indexOf('%') !== -1 ||
                            sName.indexOf('tasa') !== -1 ||
                            sName.indexOf('porcent') !== -1 ||
                            sName.indexOf('margen') !== -1 ||
                            sName.indexOf('suficiencia') !== -1 ||
                            sName.indexOf('cobertura') !== -1 ||
                            sName.indexOf('mora') !== -1 ||
                            sName.indexOf('al d') !== -1 ||
                            isYAxisPercent;

                if (isPct) {
                    return Highcharts.numberFormat(val, 2, '.', ',') + '%';
                }

                if (val % 1 !== 0) {
                    return Highcharts.numberFormat(val, 2, '.', ',');
                } else {
                    return Highcharts.numberFormat(val, 0, '.', ',');
                }
            }

            var html = '<div class="fga-chart-tooltip">';
            if (headerText && headerText.trim() !== '') {
                html += '<div class="tt-header">' + headerText + '</div>';
            }
            html += '<table class="tt-table">';

            if (ctx.points && ctx.points.length > 0) {
                for (var i = 0; i < ctx.points.length; i++) {
                    var pt = ctx.points[i];
                    if (pt.series && pt.series.visible === false) continue;
                    var sColor = (pt.color || (pt.series && pt.series.color) || '#0284c7');
                    var sName = (pt.series && pt.series.name) ? pt.series.name : 'Valor';
                    var sVal = formatTooltipVal(pt);

                    html += '<tr>';
                    html += '<td class="tt-bullet" style="color:' + sColor + '">&#9679;</td>';
                    html += '<td class="tt-name">' + sName + ':</td>';
                    html += '<td class="tt-val">' + sVal + '</td>';
                    html += '</tr>';
                }
            } else {
                var singlePt = ctx.point || ctx;
                var sColor = (singlePt.color || (ctx.series && ctx.series.color) || '#0284c7');
                var sName = (ctx.series && ctx.series.name) ? ctx.series.name : (singlePt.name || 'Valor');
                var sVal = formatTooltipVal(singlePt);

                html += '<tr>';
                html += '<td class="tt-bullet" style="color:' + sColor + '">&#9679;</td>';
                html += '<td class="tt-name">' + sName + ':</td>';
                html += '<td class="tt-val">' + sVal + '</td>';
                html += '</tr>';
            }

            html += '</table></div>';
            return html;
        };

        (function() {
            var anim = localStorage.getItem('fga_charts_animation');
            var isAnimEnabled = (anim === null || anim === 'true');
            if (anim === null) {
                try { localStorage.setItem('fga_charts_animation', 'true'); } catch (e) {}
            }
            if (typeof Highcharts !== 'undefined') {
                    Highcharts.setOptions({
        lang: {
            decimalPoint: '.',
            thousandsSep: '',
            viewData: '<i class="fa fa-table" style="color: #4338ca; margin-right: 10px; width: 16px; text-align: center;"></i> Ver tabla',
            downloadPNG: '<i class="fa fa-picture-o" style="color: #0284c7; margin-right: 10px; width: 16px; text-align: center;"></i> Descargar PNG',
            downloadJPEG: '<i class="fa fa-picture-o" style="color: #0284c7; margin-right: 10px; width: 16px; text-align: center;"></i> Descargar JPEG',
            downloadSVG: '<i class="fa fa-share-alt" style="color: #0284c7; margin-right: 10px; width: 16px; text-align: center;"></i> Descargar SVG',
            downloadCSV: '<i class="fa fa-file-excel-o" style="color: #15803d; margin-right: 10px; width: 16px; text-align: center;"></i> Descargar CSV',
            downloadXLS: '<i class="fa fa-file-excel-o" style="color: #15803d; margin-right: 10px; width: 16px; text-align: center;"></i> Descargar Excel (XLS)',
            downloadPDF: '<i class="fa fa-file-pdf-o" style="color: #dc2626; margin-right: 10px; width: 16px; text-align: center;"></i> Descargar PDF',
            contextButtonTitle: 'Descargar opciones del gr\u00e1fico'
        },
        colors: ['#2F5597', '#ea580c', '#3d6cb9', '#10b981', '#6366f1', '#f59e0b', '#204880', '#ef4444', '#8b5cf6', '#64748b', '#e11d48', '#991b1b'],
        chart: {
            backgroundColor: '#FFF',
            spacingTop: 40
        },
    tooltip: {
        shared: true,
        useHTML: true,
        formatter: function () {
            return window.formatGlobalChartTooltip ? window.formatGlobalChartTooltip(this) : null;
        },
        backgroundColor: '#FFFFFF',
        borderColor: '#e2e8f0',
        borderRadius: 8,
        borderWidth: 1,
        shadow: {
            color: 'rgba(0, 0, 0, 0.08)',
            offsetX: 0,
            offsetY: 4,
            opacity: 0.1,
            width: 8
        },
        style: {
           color: '#1e293b',
           fontSize: '12px'
        }
    },
    navigation: {
        menuStyle: {
            background: '#ffffff',
            border: '1px solid #e2e8f0',
            borderRadius: '10px',
            boxShadow: '0 10px 25px -5px rgba(0, 0, 0, 0.12), 0 8px 10px -6px rgba(0, 0, 0, 0.08)',
            padding: '6px',
            zIndex: 99999
        },
        menuItemStyle: {
            color: '#1e3a8a',
            background: '#ffffff',
            padding: '8px 14px',
            fontWeight: '600',
            fontSize: '13px',
            fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif',
            borderRadius: '6px',
            cursor: 'pointer',
            transition: 'all 0.15s ease'
        },
        menuItemHoverStyle: {
            background: '#eff6ff',
            color: '#1d4ed8'
        }
    },
    exporting: {
        tableCaption: '',
        buttons: {
	        contextButton: {
                text: '<i class="fa fa-download" style="margin-right: 6px;"></i> Descargar <i class="fa fa-angle-down" style="margin-left: 6px;"></i>',
                symbol: null,
                theme: {
                    fill: '#2F5597',
                    stroke: '#204880',
                    'stroke-width': 1,
                    r: 6,
                    padding: 7,
                    style: {
                        color: '#ffffff',
                        fontWeight: '600',
                        fontSize: '12px',
                        fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif',
                        cursor: 'pointer'
                    },
                    states: {
                        hover: {
                            fill: '#204880',
                            style: {
                                color: '#ffffff'
                            }
                        },
                        select: {
                            fill: '#1b3866'
                        }
                    }
                },
                menuItems: [
                    'viewData',
                    'separator',
                    'downloadPNG',
                    'downloadJPEG',
                    'downloadSVG',
                    'separator',
                    'downloadCSV',
                    'downloadXLS',
                    'downloadPDF'
                ]
            }
    	}
     }
    });
    if (document.getElementById('container')) {
        Highcharts.chart('container', {
            exporting: {
                csv: {
                    decimalPoint: '.',
                    itemDelimiter: ';'
                },
            },
            yAxis: {
                labels: {
                    formatter: function () {
                        return Highcharts.numberFormat(this.value, 0, ',', '');
                    }
                }
            }
        });
    }
</script>

<script type="text/javascript">
    $(document).ready(function () {
        var currentPath = window.location.pathname.toLowerCase();
        $('.sidebar-menu li a').each(function () {
            var href = $(this).attr('href');
            if (href && href !== '#' && href !== 'javascript:void(0)') {
                var cleanHref = href.toLowerCase().replace(window.location.origin.toLowerCase(), '');
                if (cleanHref && (currentPath === cleanHref || (cleanHref.length > 3 && currentPath.indexOf(cleanHref) === 0))) {
                    $('.sidebar-menu li').removeClass('active');
                    $(this).closest('li').addClass('active');
                    $(this).closest('.treeview').addClass('active menu-open');
                }
            }
        });

        // Prevencion estricta de arrastre en opciones del menu lateral
        // Evita que el navegador inicie HTML5 drag y bloquee el flujo de eventos del raton
        $(document).on('dragstart', '.main-sidebar, .sidebar-menu, .sidebar-menu a, .sidebar-menu li, .sidebar-logout-btn', function (e) {
            e.preventDefault();
            e.stopPropagation();
            return false;
        });

        $('.main-sidebar a, .sidebar-menu a, .sidebar-menu li').attr('draggable', 'false');

        // Prevenir que soltar enlaces o elementos en la ventana cause navegacion indeseada o congelamiento
        window.addEventListener('dragover', function (e) {
            e.preventDefault();
        }, false);
        window.addEventListener('drop', function (e) {
            e.preventDefault();
        }, false);

        // =========================================================================
        // Control Sidebar (Panel de Preferencias) - Controlador Robusto Garantizado
        // =========================================================================
        function toggleControlSidebar(e) {
            if (e) {
                e.preventDefault();
                e.stopPropagation();
            }
            var $sidebar = $('.control-sidebar');
            var $body = $('body');
            var isOpen = $sidebar.hasClass('control-sidebar-open') || $body.hasClass('control-sidebar-open');

            if (isOpen) {
                closeControlSidebar();
            } else {
                openControlSidebar();
            }
        }

        function openControlSidebar() {
            var $sidebar = $('.control-sidebar');
            var $body = $('body');
            var $backdrop = $('#control-sidebar-backdrop');
            if (!$backdrop.length) {
                $backdrop = $('<div id="control-sidebar-backdrop" class="control-sidebar-backdrop"></div>').appendTo('body');
            }
            $sidebar.addClass('control-sidebar-open');
            $body.addClass('control-sidebar-open');
            $backdrop.stop(true, true).fadeIn(200);
        }

        function closeControlSidebar() {
            $('.control-sidebar').removeClass('control-sidebar-open');
            $('body').removeClass('control-sidebar-open');
            $('#control-sidebar-backdrop').stop(true, true).fadeOut(200);
        }

        // Delegacion autoritativa
        $(document).off('click', '[data-toggle="control-sidebar"]').on('click', '[data-toggle="control-sidebar"]', toggleControlSidebar);
        $(document).off('click', '.pref-close-btn').on('click', '.pref-close-btn', function (e) {
            if (e) {
                e.preventDefault();
                e.stopPropagation();
            }
            closeControlSidebar();
        });
        $(document).off('click', '#control-sidebar-backdrop').on('click', '#control-sidebar-backdrop', function (e) {
            if (e) {
                e.preventDefault();
                e.stopPropagation();
            }
            closeControlSidebar();
        });
        $(document).on('keydown', function (e) {
            if (e.keyCode === 27) {
                closeControlSidebar();
            }
        });
    });
</script>

<script type="text/javascript">
    (function () {
        function initCanvas(canvasId, particleCount) {
            var canvas = document.getElementById(canvasId);
            if (!canvas || !canvas.parentElement) return;
            var ctx = canvas.getContext('2d');
            if (!ctx) return;
            var particles = [];

            function resize() {
                if (!canvas.parentElement) return;
                var rect = canvas.parentElement.getBoundingClientRect();
                canvas.width = rect.width || 300;
                canvas.height = rect.height || 100;
            }
            resize();
            $(window).on('resize', resize);

            for (var i = 0; i < particleCount; i++) {
                particles.push({
                    x: Math.random() * (canvas.width || 300),
                    y: Math.random() * (canvas.height || 300),
                    vx: (Math.random() - 0.5) * 0.4,
                    vy: (Math.random() - 0.5) * 0.4,
                    radius: Math.random() * 1.6 + 0.8,
                    alpha: Math.random() * 0.4 + 0.2
                });
            }

            function draw() {
                if (!canvas.width || !canvas.height) {
                    requestAnimationFrame(draw);
                    return;
                }
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                for (var i = 0; i < particles.length; i++) {
                    var p = particles[i];
                    p.x += p.vx;
                    p.y += p.vy;

                    if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
                    if (p.y < 0 || p.y > canvas.height) p.vy *= -1;

                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                    ctx.fillStyle = 'rgba(134, 210, 221, ' + p.alpha + ')';
                    ctx.fill();

                    for (var j = i + 1; j < particles.length; j++) {
                        var p2 = particles[j];
                        var dx = p.x - p2.x;
                        var dy = p.y - p2.y;
                        var dist = Math.sqrt(dx * dx + dy * dy);
                        if (dist < 85) {
                            ctx.beginPath();
                            ctx.moveTo(p.x, p.y);
                            ctx.lineTo(p2.x, p2.y);
                            ctx.strokeStyle = 'rgba(37, 99, 235, ' + (0.16 * (1 - dist / 85)) + ')';
                            ctx.lineWidth = 0.7;
                            ctx.stroke();
                        }
                    }
                }
                requestAnimationFrame(draw);
            }
            draw();
        }

        $(document).ready(function () {
            initCanvas('headerCanvas', 22);
            initCanvas('sidebarCanvas', 28);
        });
    })();
</script>