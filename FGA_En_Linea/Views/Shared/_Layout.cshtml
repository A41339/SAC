    <script src="~/Content/DataTable/new/pdfmake.min.js"></script>
    <script src="~/Content/DataTable/new/vfs_fonts.js"></script>
    <script src="https://code.highcharts.com/highcharts.js"></script>
    <script src="https://code.highcharts.com/modules/exporting.js"></script>
    <script src="https://code.highcharts.com/modules/export-data.js"></script>
    <script src="https://code.highcharts.com/modules/offline-exporting.js"></script>
    <script>
        // Funcion universal para decodificar entidades HTML y corregir artefactos UTF-8 / tildes
        window.sanitizeTextAccents = function (str) {
            if (!str) return str;
            var res = '' + str;
            if (res.indexOf('&') !== -1) {
                try {
                    res = $('<textarea/>').html(res).text();
                } catch (e) {}
            }
            res = res
                .replace(/CategorÃa/g, 'Per\u00edodo')
                .replace(/categorÃa/g, 'per\u00edodo')
                .replace(/MenÃƒÂº/g, 'Men\u00fa')
                .replace(/MenÃÂº/g, 'Men\u00fa')
                .replace(/MenÃº/g, 'Men\u00fa')
                .replace(/ÃƒÂ¡/g, '\u00e1').replace(/ÃƒÂ©/g, '\u00e9').replace(/ÃƒÂ­/g, '\u00ed')
                .replace(/ÃƒÂ³/g, '\u00f3').replace(/ÃƒÂº/g, '\u00fa').replace(/ÃƒÂ±/g, '\u00f1')
                .replace(/ÃÂ¡/g, '\u00e1').replace(/ÃÂ©/g, '\u00e9').replace(/ÃÂ­/g, '\u00ed')
                .replace(/ÃÂ³/g, '\u00f3').replace(/ÃÂº/g, '\u00fa').replace(/ÃÂ±/g, '\u00f1')
                .replace(/Ã¡/g, '\u00e1').replace(/Ã©/g, '\u00e9').replace(/Ã­/g, '\u00ed')
                .replace(/Ã³/g, '\u00f3').replace(/Ãº/g, '\u00fa').replace(/Ã±/g, '\u00f1')
                .replace(/Ã /g, '\u00c1').replace(/Ã‰/g, '\u00c9').replace(/Ã /g, '\u00cd')
                .replace(/Ã“/g, '\u00d3').replace(/Ãš/g, '\u00da').replace(/Ã‘/g, '\u00d1');
            return res;
        };

        window.fixDomEncoding = function (root) {
            try {
                if (document.title && (document.title.indexOf('Ã') !== -1 || document.title.indexOf('&') !== -1)) {
                    document.title = window.sanitizeTextAccents(document.title);
                }
                var target = root || document.body;
                if (!target) return;
                var walker = document.createTreeWalker(target, NodeFilter.SHOW_TEXT, null, false);
                var node;
                while (node = walker.nextNode()) {
                    if (node.nodeValue && node.nodeValue.indexOf('Ã') !== -1) {
                        node.nodeValue = window.sanitizeTextAccents(node.nodeValue);
                    }
                }
            } catch (e) {}
        };
        $(document).ready(function () { 
            document.title = window.sanitizeTextAccents(document.title);
            window.fixDomEncoding(); 
            if (window.MutationObserver && document.body) {
                var fixTimer = null;
                var observer = new MutationObserver(function () {
                    if (fixTimer) clearTimeout(fixTimer);
                    fixTimer = setTimeout(function () { window.fixDomEncoding(); }, 50);
                });
                observer.observe(document.body, { childList: true, subtree: true });
            }
        });
        $(document).ajaxComplete(function () { window.fixDomEncoding(); });
        $(document).on('draw.dt init.dt page.dt order.dt search.dt', function () { window.fixDomEncoding(); });

        window.formatGlobalChartTooltip = function (ctx) {
            if (!ctx) return '';
            var p0 = (ctx.points && ctx.points.length > 0) ? ctx.points[0] : (ctx.point || ctx);
            var xAxis = (p0 && p0.series && p0.series.xAxis) ? p0.series.xAxis : null;

            var headerText = '';
            if (ctx.category !== undefined && ctx.category !== null && ('' + ctx.category).trim() !== '') {
                headerText = '' + ctx.category;
            } else if (p0 && p0.category !== undefined && p0.category !== null && ('' + p0.category).trim() !== '') {
                headerText = '' + p0.category;
            } else if (xAxis && xAxis.categories && p0 && p0.x !== undefined && xAxis.categories[p0.x]) {
                headerText = '' + xAxis.categories[p0.x];
            } else if (p0 && p0.key !== undefined && p0.key !== null) {
                var kStr = '' + p0.key;
                if (isNaN(Number(kStr)) || kStr.indexOf('-') !== -1 || kStr.indexOf('/') !== -1) {
                    headerText = kStr;
                }
            } else if (p0 && p0.name) {
                headerText = '' + p0.name;
            }

            // Suppress raw integer index (0, 1, 2...)
            if (headerText && /^\d+$/.test(headerText.trim())) {
                headerText = '';
            }
            headerText = window.sanitizeTextAccents(headerText);

            function formatTooltipVal(point) {
                var val = point.y;
                if (val === null || typeof val === 'undefined') return '-';

                var sName = (point.series && point.series.name) ? point.series.name.toLowerCase() : '';
                var yAxisOpts = (point.series && point.series.yAxis && point.series.yAxis.options) ? point.series.yAxis.options : {};
                var yTitle = (yAxisOpts.title && yAxisOpts.title.text) ? yAxisOpts.title.text.toLowerCase() : '';
                var yLabels = yAxisOpts.labels || {};
                var sSuffix = (point.series && point.series.tooltipOptions && point.series.tooltipOptions.valueSuffix) ||
                              (point.series && point.series.userOptions && point.series.userOptions.tooltip && point.series.userOptions.tooltip.valueSuffix) ||
                              (point.series && point.series.options && point.series.options.tooltip && point.series.options.tooltip.valueSuffix) || '';

                // Detección estricta de no-porcentajes (montos monetarios, conteos, etc.)
                var isExplicitNonPercent = sName.indexOf('monto') !== -1 ||
                                           sName.indexOf('saldo') !== -1 ||
                                           sName.indexOf('financiamiento') !== -1 ||
                                           sName.indexOf('cantidad') !== -1 ||
                                           sName.indexOf('personas') !== -1 ||
                                           sName.indexOf('asociados') !== -1 ||
                                           sName.indexOf('ahorrantes') !== -1 ||
                                           (sSuffix.indexOf('M') !== -1) ||
                                           (sSuffix.indexOf('personas') !== -1);

                if (point.percentage !== undefined && point.series && point.series.type === 'column' &&
                    point.series.chart && point.series.chart.options && point.series.chart.options.plotOptions &&
                    point.series.chart.options.plotOptions.column && point.series.chart.options.plotOptions.column.stacking === 'percent' &&
                    !isExplicitNonPercent) {
                    return Highcharts.numberFormat(point.percentage, 2, '.', ',') + '%';
                }

                var isYAxisPercent = yTitle.indexOf('%') !== -1 ||
                                     yTitle.indexOf('porcent') !== -1 ||
                                     (yLabels.formatter && ('' + yLabels.formatter).indexOf('Percent') !== -1);

                var isPct = !isExplicitNonPercent && (
                            sSuffix.indexOf('%') !== -1 ||
                            sName.indexOf('%') !== -1 ||
                            sName.indexOf('variac') !== -1 ||
                            sName.indexOf('tasa') !== -1 ||
                            sName.indexOf('ponderada') !== -1 ||
                            sName.indexOf('porcent') !== -1 ||
                            sName.indexOf('margen') !== -1 ||
                            sName.indexOf('suficiencia') !== -1 ||
                            sName.indexOf('cobertura') !== -1 ||
                            sName.indexOf('mora') !== -1 ||
                            sName.indexOf('al d') !== -1 ||
                            isYAxisPercent);

                if (isPct) {
                    return Highcharts.numberFormat(val, 2, '.', ',') + '%';
                }

                if (sSuffix && sSuffix.trim() !== '') {
                    if (sSuffix.trim() === 'M' || sName.indexOf('monto') !== -1 || sName.indexOf('financiamiento') !== -1) {
                        return '₡' + Highcharts.numberFormat(val, 2, '.', ',') + ' M';
                    }
                    return Highcharts.numberFormat(val, 2, '.', ',') + ' ' + sSuffix.trim();
                }

                if (sName.indexOf('monto') !== -1 || sName.indexOf('financiamiento') !== -1) {
                    return '₡' + Highcharts.numberFormat(val, 2, '.', ',') + ' M';
                }

                if (val % 1 !== 0) {
                    return Highcharts.numberFormat(val, 2, '.', ',');
                } else {
                    return Highcharts.numberFormat(val, 0, '.', ',');
                }
            }

            var html = '<div class="fga-chart-tooltip" style="min-width: 270px; padding: 12px 16px;">';
            if (headerText && headerText.trim() !== '') {
                html += '<div class="tt-header">' + headerText + '</div>';
            }
            html += '<table class="tt-table">';

            if (ctx.points && ctx.points.length > 0) {
                for (var i = 0; i < ctx.points.length; i++) {
                    var pt = ctx.points[i];
                    if (pt.series && pt.series.visible === false) continue;
                    var sColor = (pt.color || (pt.series && pt.series.color) || '#0284c7');
                    var sName = (pt.series && pt.series.name) ? pt.series.name : 'Valor';
                    sName = window.sanitizeTextAccents(sName);
                    var sVal = formatTooltipVal(pt);

                    html += '<tr>';
                    html += '<td class="tt-bullet" style="color:' + sColor + '; padding: 4px 6px 4px 0; vertical-align: middle;">&#9679;</td>';
                    html += '<td class="tt-name" style="padding: 4px 18px 4px 0; vertical-align: middle; white-space: nowrap;">' + sName + ':</td>';
                    html += '<td class="tt-val" style="padding: 4px 0; vertical-align: middle; white-space: nowrap;">' + sVal + '</td>';
                    html += '</tr>';
                }
            } else {
                var singlePt = ctx.point || ctx;
                var sColor = (singlePt.color || (ctx.series && ctx.series.color) || '#0284c7');
                var sName = (ctx.series && ctx.series.name) ? ctx.series.name : (singlePt.name || 'Valor');
                sName = window.sanitizeTextAccents(sName);
                var sVal = formatTooltipVal(singlePt);

                html += '<tr>';
                html += '<td class="tt-bullet" style="color:' + sColor + '; padding: 4px 6px 4px 0; vertical-align: middle;">&#9679;</td>';
                html += '<td class="tt-name" style="padding: 4px 18px 4px 0; vertical-align: middle; white-space: nowrap;">' + sName + ':</td>';
                html += '<td class="tt-val" style="padding: 4px 0; vertical-align: middle; white-space: nowrap;">' + sVal + '</td>';
                html += '</tr>';
            }

            html += '</table></div>';
            return html;
        };

        window.formatMillion = function () {
            if (typeof Highcharts !== 'undefined' && Highcharts.numberFormat) {
                return Highcharts.numberFormat(this.value, 0, '.', ',');
            }
            return this.value;
        };

        window.formatPercent = function () {
            return this.value + " %";
        };

        (function() {
            var anim = localStorage.getItem('fga_charts_animation');
            var isAnimEnabled = (anim === null || anim === 'true');
            if (anim === null) {
                try { localStorage.setItem('fga_charts_animation', 'true'); } catch (e) {}
            }
            if (typeof Highcharts !== 'undefined') {
                Highcharts.setOptions({
                    lang: {
                        thousandsSep: ',',
                        decimalPoint: '.',
                        numericSymbols: null,
                        categoryHeader: 'Per\u00edodo',
                        categoryDatetimeHeader: 'Fecha',
                        viewData: '<i class="fa fa-table" style="color: #4338ca; margin-right: 10px; width: 16px; text-align: center;"></i> Ver datos',
                        hideData: '<i class="fa fa-table" style="color: #4338ca; margin-right: 10px; width: 16px; text-align: center;"></i> Ocultar datos',
                        exportData: {
                            categoryHeader: 'Per\u00edodo',
                            categoryDatetimeHeader: 'Fecha'
                        }
                    },
                    exporting: {
                        tableCaption: 'Detalle de Datos',
                        csv: {
                            categoryHeader: 'Per\u00edodo',
                            categoryDatetimeHeader: 'Fecha'
                        }
                    },
                    chart: {
                        style: {
                            fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif'
                        },
                        animation: isAnimEnabled ? { duration: 1200, easing: 'easeOutCubic' } : false
                    },
                    tooltip: {
                        shared: true,
                        useHTML: true,
                        outside: true,
                        formatter: function () {
                            return window.formatGlobalChartTooltip ? window.formatGlobalChartTooltip(this) : null;
                        },
                        backgroundColor: 'transparent',
                        borderColor: 'transparent',
                        borderRadius: 8,
                        borderWidth: 0,
                        shadow: false,
                        padding: 0,
                        style: {
                            color: '#1e293b',
                            fontSize: '12px'
                        }
                    },
                    legend: {
                        itemStyle: {
                            color: '#334155',
                            fontWeight: '600',
                            fontSize: '12px'
                        },
                        itemHoverStyle: {
                            color: '#2F5597'
                        }
                    },
                    colors: ['#2F5597', '#F4A261', '#52B788', '#6B9FD4', '#A78BFA', '#FCD34D', '#5DADE2', '#F08080', '#81B3A8', '#94A3B8'],
                    plotOptions: {
                        series: {
                            animation: isAnimEnabled ? { duration: 1200 } : false,
                            marker: {
                                radius: 4,
                                lineWidth: 0
                            }
                        },
                        spline: {
                            animation: isAnimEnabled ? { duration: 1200 } : false,
                            lineWidth: 3
                        },
                        areaspline: {
                            animation: isAnimEnabled ? { duration: 1200 } : false,
                            fillOpacity: 0.18,
                            lineWidth: 2
                        },
                        line: {
                            animation: isAnimEnabled ? { duration: 1200 } : false,
                            lineWidth: 2.5
                        },
                        column: {
                            animation: isAnimEnabled ? { duration: 1000 } : false,
                            borderRadius: 4,
                            borderWidth: 0
                        },
                        bar: {
                            animation: isAnimEnabled ? { duration: 1000 } : false,
                            borderRadius: 4,
                            borderWidth: 0
                        }
                    }
                });
                if (Highcharts.defaultOptions && Highcharts.defaultOptions.lang) {
                    Highcharts.defaultOptions.lang.thousandsSep = ',';
                    Highcharts.defaultOptions.lang.decimalPoint = '.';
                }
            }
        })();
    </script>
