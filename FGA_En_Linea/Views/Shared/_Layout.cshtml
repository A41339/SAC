<script type="text/javascript">
    $(document).ready(function () {
        var currentPath = (window.location.pathname || '').toLowerCase().replace(/\/+$/, '');
        var appPath = '@Url.Content("~")'.toLowerCase().replace(/\/+$/, '');
        var relPath = currentPath;
        if (appPath && relPath.indexOf(appPath) === 0) {
            relPath = relPath.substring(appPath.length);
        }
        relPath = relPath.replace(/^\/+/, '');
        var relPathNoIndex = relPath.replace(/\/index$/, '');

        var bestLink = null;
        var bestScore = -1;

        $('.sidebar-menu li a').each(function () {
            var href = $(this).attr('href');
            if (!href || href === '#' || href.indexOf('javascript:') === 0) {
                return;
            }

            var linkPath = (this.pathname || '').toLowerCase().replace(/\/+$/, '');
            var linkRel = linkPath;
            if (appPath && linkRel.indexOf(appPath) === 0) {
                linkRel = linkRel.substring(appPath.length);
            }
            linkRel = linkRel.replace(/^\/+/, '');
            var linkRelNoIndex = linkRel.replace(/\/index$/, '');

            if (!linkRel) return;

            var score = -1;
            if (relPath === linkRel || (relPathNoIndex && relPathNoIndex === linkRelNoIndex)) {
                score = 10000 + linkRel.length;
            } else if (relPath.indexOf(linkRel + '/') === 0) {
                score = 5000 + linkRel.length;
            } else if (linkRel.indexOf('/') === -1 && relPath.indexOf(linkRel + '/') === 0) {
                score = 1000 + linkRel.length;
            }

            if (score > bestScore) {
                bestScore = score;
                bestLink = $(this);
            }
        });

        if (bestLink) {
            $('.sidebar-menu li').removeClass('active');
            $('.sidebar-menu li.treeview').removeClass('menu-open active');
            bestLink.closest('li').addClass('active');
            bestLink.parents('.treeview').addClass('active menu-open');
        }

        // Estilo dinamico y ultra-robusto para separadores y traducciones del menu de exportacion de Highcharts
        function cleanHighchartsSeparators() {
            $('.highcharts-separator, li[role="separator"], .highcharts-menu-item.highcharts-separator, .highcharts-contextmenu hr, .highcharts-menu hr, div[class*="highcharts"] hr, .highcharts-container hr').each(function () {
                var $el = $(this);
                $el.attr('style', 'display:block !important; padding:0 !important; margin:5px 6px !important; height:1px !important; min-height:1px !important; max-height:1px !important; line-height:0 !important; font-size:0 !important; background:#e2e8f0 !important; background-color:#e2e8f0 !important; border:none !important; border-top:1px solid #e2e8f0 !important; cursor:default !important; pointer-events:none !important; width:calc(100% - 12px) !important; box-sizing:border-box !important; clear:both !important; overflow:hidden !important; opacity:0.8 !important;');
                var $p = $el.parent();
                if ($p.is('li') && !$p.hasClass('highcharts-separator')) {
                    $p.attr('style', 'display:block !important; padding:0 !important; margin:3px 0 !important; height:1px !important; min-height:0 !important; max-height:1px !important; line-height:0 !important; background:transparent !important; cursor:default !important; pointer-events:none !important;');
                }
            });

            // Normalizar y traducir dinamicamente cualquier opcion "Hide data table" / "View data table"
            $('.highcharts-menu-item, .highcharts-contextmenu li').each(function () {
                var $t = $(this);
                var raw = $.trim($t.text()).toLowerCase();
                if (raw === 'hide data table' || raw.indexOf('hide data') !== -1) {
                    $t.html('<i class="fa fa-table" style="color: #4338ca; margin-right: 10px; width: 16px; text-align: center;"></i> Ocultar datos');
                } else if (raw === 'view data table' || raw.indexOf('view data') !== -1) {
                    $t.html('<i class="fa fa-table" style="color: #4338ca; margin-right: 10px; width: 16px; text-align: center;"></i> Ver datos');
                }
            });

            formatHighchartsDataTable();
        }

        // Funcion universal para decodificar entidades HTML y corregir artefactos UTF-8 / tildes
        function sanitizeTextAccents(str) {
            if (!str) return str;
            var res = '' + str;
            if (res.indexOf('&') !== -1) {
                try {
                    res = $('<textarea/>').html(res).text();
                } catch (e) {}
            }
            res = res
                .replace(/CategorÃa/g, 'Per\u00edodo')
                .replace(/categorÃa/g, 'per\u00edodo')
                .replace(/Ã¡/g, '\u00e1').replace(/Ã©/g, '\u00e9').replace(/Ã­/g, '\u00ed')
                .replace(/Ã³/g, '\u00f3').replace(/Ãº/g, '\u00fa').replace(/Ã±/g, '\u00f1')
                .replace(/Ã /g, '\u00c1').replace(/Ã‰/g, '\u00c9').replace(/Ã /g, '\u00cd')
                .replace(/Ã“/g, '\u00d3').replace(/Ãš/g, '\u00da').replace(/Ã‘/g, '\u00d1');
            return res;
        }

        // Decorador y formateador de la tabla de datos de Highcharts al estilo de pantallas de mantenimiento
        function formatHighchartsDataTable() {
            $('.highcharts-data-table').each(function () {
                var $dt = $(this);
                var $tbl = $dt.find('table');
                if (!$tbl.length) return;

                // Caption con icono y estilo de cabecera ejecutiva
                var $caption = $tbl.find('caption, .highcharts-table-caption');
                if ($caption.length) {
                    var capText = $.trim($caption.text());
                    if (!capText || capText === 'Chart Title' || capText === 'T\u00edtulo de la gr\u00e1fica') {
                        capText = 'Detalle de Datos';
                    }
                    capText = sanitizeTextAccents(capText);
                    if ($caption.find('i.fa-table').length === 0) {
                        $caption.html('<i class="fa fa-table" style="color: #2F5597; margin-right: 8px;"></i> ' + capText);
                    }
                }

                // Encabezados thead: sustitución de categoría por Periodo y decodificación de tildes/HTML
                $tbl.find('thead th, thead td').each(function (idx) {
                    var $cell = $(this);
                    var $btn = $cell.find('button');
                    var targetEl = $btn.length ? $btn : $cell;
                    var txt = $.trim(targetEl.text());
                    var lower = txt.toLowerCase();

                    if (idx === 0 || lower.indexOf('categor') !== -1) {
                        targetEl.html('<i class="fa fa-calendar" style="color: #2F5597; margin-right: 6px;"></i> Per\u00edodo');
                    } else {
                        var cleaned = sanitizeTextAccents(txt);
                        if (cleaned !== txt) {
                            targetEl.text(cleaned);
                        }
                    }
                });

                // Celdas tbody: asegurar que las etiquetas de periodo y texto no tengan artefactos
                $tbl.find('tbody tr').each(function () {
                    var $firstCell = $(this).find('th:first-child, td:first-child');
                    if ($firstCell.length) {
                        var txt = $firstCell.text();
                        var cleaned = sanitizeTextAccents(txt);
                        if (cleaned !== txt) {
                            $firstCell.text(cleaned);
                        }
                    }
                });
            });
        }

        $(document).on('click mousedown mouseenter', '.highcharts-contextbutton, .highcharts-button, .highcharts-exporting-group, svg g[class*="exporting"]', function () {
            cleanHighchartsSeparators();
            [10, 40, 100, 250].forEach(function (t) { setTimeout(cleanHighchartsSeparators, t); });
        });

        $(document).on('click', '.highcharts-menu-item, .highcharts-contextmenu li, .highcharts-data-table button, .highcharts-data-table th', function () {
            [20, 60, 120, 250, 500, 1000].forEach(function (t) {
                setTimeout(cleanHighchartsSeparators, t);
                setTimeout(formatHighchartsDataTable, t);
            });
        });

        $(document).on('mouseenter mouseover', '.highcharts-menu-item, .highcharts-contextmenu, .highcharts-menu, .highcharts-data-table', function () {
            cleanHighchartsSeparators();
            formatHighchartsDataTable();
        });

        if (window.MutationObserver) {
            var chartMenuObserver = new MutationObserver(function (mutations) {
                var needsFormat = false;
                var needsClean = false;
                for (var i = 0; i < mutations.length; i++) {
                    var mut = mutations[i];
                    if (mut.addedNodes && mut.addedNodes.length > 0) {
                        for (var j = 0; j < mut.addedNodes.length; j++) {
                            var node = mut.addedNodes[j];
                            if (node.nodeType === 1) {
                                var cls = '' + (node.className || '');
                                if (cls.indexOf('highcharts-') !== -1 || $(node).find('[class*="highcharts-"]').length > 0) {
                                    needsClean = true;
                                    if (cls.indexOf('highcharts-data-table') !== -1 || $(node).find('.highcharts-data-table').length > 0) {
                                        needsFormat = true;
                                    }
                                }
                            }
                        }
                    }
                }
                if (needsClean) cleanHighchartsSeparators();
                if (needsFormat) {
                    formatHighchartsDataTable();
                    setTimeout(formatHighchartsDataTable, 50);
                    setTimeout(formatHighchartsDataTable, 150);
                }
            });
            chartMenuObserver.observe(document.body, { childList: true, subtree: true });
        }

        // Reflow global automatico de graficos Highcharts en cualquier modal al abrirse
        $(document).on('shown.bs.modal', '.modal', function () {
            if (typeof Highcharts !== 'undefined' && Highcharts.charts) {
                setTimeout(function () {
                    Highcharts.charts.forEach(function (c) {
                        if (c) {
                            try { c.reflow(); } catch (e) {}
                        }
                    });
                }, 50);
            }
        });

        // Prevencion estricta de arrastre en opciones del menu lateral
        // Evita que el navegador inicie HTML5 drag y bloquee el flujo de eventos del raton
        $(document).on('dragstart', '.main-sidebar, .sidebar-menu, .sidebar-menu a, .sidebar-menu li, .sidebar-logout-btn', function (e) {
            e.preventDefault();
            e.stopPropagation();
            return false;
        });

        $('.main-sidebar a, .sidebar-menu a, .sidebar-menu li').attr('draggable', 'false');

        // Prevenir que soltar enlaces o elementos en la ventana cause navegacion indeseada o congelamiento
        window.addEventListener('dragover', function (e) {
            e.preventDefault();
        }, false);
        window.addEventListener('drop', function (e) {
            e.preventDefault();
        }, false);

        // =========================================================================
        // Control Sidebar (Panel de Preferencias) - Controlador Robusto Garantizado
        // =========================================================================
        function toggleControlSidebar(e) {
            if (e) {
                e.preventDefault();
                e.stopPropagation();
            }
            var $sidebar = $('.control-sidebar');
            var $body = $('body');
            var isOpen = $sidebar.hasClass('control-sidebar-open') || $body.hasClass('control-sidebar-open');

            if (isOpen) {
                closeControlSidebar();
            } else {
                openControlSidebar();
            }
        }

        function openControlSidebar() {
            var $sidebar = $('.control-sidebar');
            var $body = $('body');
            var $backdrop = $('#control-sidebar-backdrop');
            if (!$backdrop.length) {
                $backdrop = $('<div id="control-sidebar-backdrop" class="control-sidebar-backdrop"></div>').appendTo('body');
            }
            $sidebar.addClass('control-sidebar-open');
            $body.addClass('control-sidebar-open');
            $backdrop.stop(true, true).fadeIn(200);
        }

        function closeControlSidebar() {
            $('.control-sidebar').removeClass('control-sidebar-open');
            $('body').removeClass('control-sidebar-open');
            $('#control-sidebar-backdrop').stop(true, true).fadeOut(200);
        }

        // Delegacion autoritativa
        $(document).off('click', '[data-toggle="control-sidebar"]').on('click', '[data-toggle="control-sidebar"]', toggleControlSidebar);
        $(document).off('click', '.pref-close-btn').on('click', '.pref-close-btn', function (e) {
            if (e) {
                e.preventDefault();
                e.stopPropagation();
            }
            closeControlSidebar();
        });
        $(document).off('click', '#control-sidebar-backdrop').on('click', '#control-sidebar-backdrop', function (e) {
            if (e) {
                e.preventDefault();
                e.stopPropagation();
            }
            closeControlSidebar();
        });
        $(document).on('keydown', function (e) {
            if (e.keyCode === 27) {
                closeControlSidebar();
            }
        });
    });
</script>

<script type="text/javascript">
    (function () {
        function initCanvas(canvasId, particleCount) {
            var canvas = document.getElementById(canvasId);
            if (!canvas || !canvas.parentElement) return;
            var ctx = canvas.getContext('2d');
            if (!ctx) return;
            var particles = [];

            function resize() {
                if (!canvas.parentElement) return;
                var rect = canvas.parentElement.getBoundingClientRect();
                canvas.width = rect.width || 300;
                canvas.height = rect.height || 100;
            }
            resize();
            $(window).on('resize', resize);

            for (var i = 0; i < particleCount; i++) {
                particles.push({
                    x: Math.random() * (canvas.width || 300),
                    y: Math.random() * (canvas.height || 300),
                    vx: (Math.random() - 0.5) * 0.4,
                    vy: (Math.random() - 0.5) * 0.4,
                    radius: Math.random() * 1.6 + 0.8,
                    alpha: Math.random() * 0.4 + 0.2
                });
            }

            function draw() {
                if (!canvas.width || !canvas.height) {
                    requestAnimationFrame(draw);
                    return;
                }
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                for (var i = 0; i < particles.length; i++) {
                    var p = particles[i];
                    p.x += p.vx;
                    p.y += p.vy;

                    if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
                    if (p.y < 0 || p.y > canvas.height) p.vy *= -1;

                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                    ctx.fillStyle = 'rgba(134, 210, 221, ' + p.alpha + ')';
                    ctx.fill();

                    for (var j = i + 1; j < particles.length; j++) {
                        var p2 = particles[j];
                        var dx = p.x - p2.x;
                        var dy = p.y - p2.y;
                        var dist = Math.sqrt(dx * dx + dy * dy);
                        if (dist < 85) {
                            ctx.beginPath();
                            ctx.moveTo(p.x, p.y);
                            ctx.lineTo(p2.x, p2.y);
                            ctx.strokeStyle = 'rgba(37, 99, 235, ' + (0.16 * (1 - dist / 85)) + ')';
                            ctx.lineWidth = 0.7;
                            ctx.stroke();
                        }
                    }
                }
                requestAnimationFrame(draw);
            }
            draw();
        }

        $(document).ready(function () {
            initCanvas('headerCanvas', 22);
            initCanvas('sidebarCanvas', 28);

            // ==========================================================================
            // Vinculación interactiva y auto-resolución DINÁMICA del Menú Papá en Breadcrumbs
            // ==========================================================================
            var moduloBaseUrl = '@Url.Action("Index", "Modulo")';

            // 1. Manejo inteligente de clic en el botón/píldora del menú papá:
            // Si el usuario navegó desde la pantalla anterior (referrer interno válido), volver dinámicamente a la opción previa
            $(document).on('click', '.breadcrumb-parent-pill, .breadcrumb-back-btn, .header-back-link', function (e) {
                if (document.referrer && document.referrer.indexOf(window.location.host) !== -1) {
                    var refPath = document.referrer.toLowerCase();
                    var currentPath = window.location.href.toLowerCase();
                    if (refPath !== currentPath && refPath.indexOf('/account/') === -1 && refPath.indexOf('/login') === -1) {
                        e.preventDefault();
                        window.location.href = document.referrer;
                        return false;
                    }
                }
            });

            // 2. Obtener el módulo padre raíz activo desde el menú lateral de la base de datos (dinámico sin URLs en duro)
            var parentModuleUrl = null;
            var parentModuleName = null;
            var parentModuleIcon = null;

            var $activeSidebarLink = $('.sidebar-menu li.active > a').first();
            if ($activeSidebarLink.length > 0) {
                var $parentTree = $activeSidebarLink.parents('li.treeview').first();
                var $parentA = $parentTree.length > 0 ? $parentTree.children('a').first() : $activeSidebarLink;
                if ($parentA.length > 0) {
                    parentModuleUrl = $parentA.attr('href');
                    parentModuleName = $.trim($parentA.find('span').first().text());
                    var $i = $parentA.find('i').first();
                    parentModuleIcon = ($i.length && $i.attr('class')) ? $i.attr('class') : 'fa fa-folder-open-o';
                }
            }

            function normalizar(texto) {
                if (!texto) return '';
                return texto.toLowerCase()
                    .replace(/ã³/g, 'o').replace(/ã¡/g, 'a').replace(/ã©/g, 'e').replace(/ã­/g, 'i').replace(/ãº/g, 'u').replace(/ã±/g, 'n')
                    .replace(/á/g, 'a').replace(/é/g, 'e').replace(/í/g, 'i').replace(/ó/g, 'o').replace(/ú/g, 'u').replace(/ñ/g, 'n').trim();
            }

            function resolverUrlModulo(texto) {
                if (!texto) return parentModuleUrl || moduloBaseUrl;
                var tNorm = normalizar(texto);

                // Buscar coincidencias dinámicas en la estructura del menú lateral cargada desde BD
                var found = null;
                $('.sidebar-menu li a').each(function () {
                    var sText = normalizar($(this).find('span').first().text());
                    if (sText && (sText === tNorm || tNorm.indexOf(sText) !== -1 || sText.indexOf(tNorm) !== -1)) {
                        found = $(this).attr('href');
                        return false;
                    }
                });

                return found || parentModuleUrl || moduloBaseUrl;
            }

            $('.breadcrumb').each(function () {
                var $bc = $(this);
                $bc.addClass('modern-breadcrumb-pill');

                // Asegurar estilo en el enlace a Inicio
                var $homeLink = $bc.find('li:first-child a');
                if ($homeLink.length > 0) {
                    $homeLink.attr('title', 'Ir a la pantalla de Inicio');
                    if ($homeLink.find('i').length === 0) {
                        $homeLink.prepend('<i class="fa fa-dashboard" style="margin-right: 4px;"></i> ');
                    }
                }

                var $items = $bc.find('li');
                var $active = $bc.find('li.active');
                var activeText = $active.length ? normalizar($active.text()) : '';

                // Si solo hay 2 elementos (Inicio > PantallaActual) y conocemos el menú papá, insertar la píldora dinámica del papá
                if ($items.length === 2 && parentModuleName && parentModuleUrl) {
                    var pNorm = normalizar(parentModuleName);
                    if (pNorm !== 'inicio' && pNorm !== activeText && activeText.indexOf(pNorm) === -1) {
                        var parentLiHtml = '<li class="breadcrumb-parent-item">' +
                            '<a href="' + parentModuleUrl + '" class="breadcrumb-parent-pill" title="Volver a la opción anterior: ' + parentModuleName + '">' +
                            '<i class="' + parentModuleIcon + '"></i> ' + parentModuleName + '</a></li>';
                        $(parentLiHtml).insertAfter($items.first());
                    }
                }

                // Revisar los enlaces intermedios
                $bc.find('li:not(:first-child):not(.active)').each(function () {
                    var $li = $(this);
                    var $a = $li.find('a');
                    var rawText = $.trim($a.length ? $a.text() : $li.text());
                    var norm = normalizar(rawText);

                    if (!norm || norm === 'inicio') return;

                    var targetUrl = resolverUrlModulo(rawText);

                    if ($a.length === 0) {
                        $li.html('<a href="' + targetUrl + '" class="breadcrumb-parent-pill" title="Volver al menú de ' + rawText + '">' + rawText + '</a>');
                    } else {
                        $a.attr('href', targetUrl);
                        $a.addClass('breadcrumb-parent-pill');
                        $a.attr('title', 'Volver al menú de ' + rawText);
                    }
                });
            });

            // 3. Auto-inyección del enlace de cabecera "← Volver a [Módulo Padre]" hacia /Modulo/Index/id en todas las páginas hijas
            var $parentPill = $('.breadcrumb .breadcrumb-parent-pill').first();
            var headerBackUrl = null;
            var headerBackName = null;

            if ($parentPill.length > 0) {
                headerBackName = $.trim($parentPill.text());
                headerBackUrl = resolverUrlModulo(headerBackName);
            } else if (parentModuleName) {
                headerBackName = parentModuleName;
                headerBackUrl = resolverUrlModulo(parentModuleName);
            }

            if (headerBackName && headerBackUrl) {
                var normBack = normalizar(headerBackName);
                if (normBack && normBack !== 'inicio') {
                    var $header = $('.content-header').first();
                    if ($header.length > 0 && $header.find('.header-back-link').length === 0 && $header.find('.hub-header').length === 0) {
                        var $titleEl = $header.find('h1, .modern-page-title').first();
                        var backHtml = '<div class="header-back-container" style="margin-bottom: 6px;">' +
                            '<a href="' + headerBackUrl + '" class="breadcrumb-back-btn header-back-link" style="display: inline-flex; align-items: center; gap: 6px; font-size: 13.5px; font-weight: 600; color: #0284c7; text-decoration: none; transition: all 0.2s ease;">' +
                            '<i class="fa fa-arrow-left" style="font-size: 12px;"></i> Volver' +
                            '</a></div>';

                        if ($titleEl.length > 0) {
                            $(backHtml).insertBefore($titleEl);
                        } else {
                            $header.prepend(backHtml);
                        }
                    }
                }
            }

            // 4. Buscador Global de Módulos y Pantallas (Tiempo Real + Ctrl + K)
            (function initGlobalSearch() {
                var $searchInput = $('#globalMenuSearch');
                var $searchResults = $('#globalSearchResults');
                if ($searchInput.length === 0 || $searchResults.length === 0) return;

                var indexedMenus = [];
                var paletteColors = [
                    { f: '#e0f2fe', c: '#0284c7' },
                    { f: '#ffedd5', c: '#ea580c' },
                    { f: '#dcfce7', c: '#16a34a' },
                    { f: '#f3e8ff', c: '#7c3aed' },
                    { f: '#ffe4e6', c: '#e11d48' },
                    { f: '#ccfbf1', c: '#0d9488' },
                    { f: '#e0e7ff', c: '#4338ca' },
                    { f: '#fef3c7', c: '#d97706' },
                    { f: '#dbeafe', c: '#2563eb' },
                    { f: '#fae8ff', c: '#a21caf' }
                ];

                var searchCatalogUrl = '@Url.Action("GetSearchMenuCatalog", "Modulo")';

                function buildMenuIndex() {
                    indexedMenus = [];
                    var colorIdx = 0;
                    var addedUrls = {};

                    $.getJSON(searchCatalogUrl, function (data) {
                        if (data && data.length > 0) {
                            $.each(data, function (idx, item) {
                                if (!item.url || item.url === '#') return;
                                if (addedUrls[item.url]) return;

                                var color = paletteColors[colorIdx % paletteColors.length];
                                colorIdx++;
                                addedUrls[item.url] = true;

                                indexedMenus.push({
                                    title: item.title,
                                    normTitle: normalizar(item.title),
                                    url: item.url,
                                    icon: item.icon || 'fa fa-file-text-o',
                                    parent: item.parent || '',
                                    normParent: normalizar(item.parent || ''),
                                    color: color
                                });
                            });
                        }

                        // Complementar con elementos visibles en la pantalla actual
                        $('.sidebar-menu li a, .hub-card').each(function () {
                            var $a = $(this);
                            var href = $a.attr('href');
                            if (!href || href === '#' || href.indexOf('javascript:') === 0) return;
                            if (addedUrls[href]) return;

                            var title = $.trim($a.find('.hub-card-title, span').first().text());
                            if (!title) return;

                            var $i = $a.find('i').first();
                            var icon = ($i.length && $i.attr('class')) ? $i.attr('class') : 'fa fa-folder-open-o';

                            var parentName = '';
                            var $parentTree = $a.parents('li.treeview').first();
                            if ($parentTree.length > 0) {
                                parentName = $.trim($parentTree.children('a').find('span').first().text());
                            } else if ($a.hasClass('hub-card')) {
                                parentName = $.trim($('.content-header h1').first().text());
                            }

                            var color = paletteColors[colorIdx % paletteColors.length];
                            colorIdx++;
                            addedUrls[href] = true;

                            indexedMenus.push({
                                title: title,
                                normTitle: normalizar(title),
                                url: href,
                                icon: icon,
                                parent: parentName,
                                normParent: normalizar(parentName),
                                color: color
                            });
                        });
                    });
                }

                buildMenuIndex();
                setTimeout(buildMenuIndex, 800);

                // Atajo de teclado (Ctrl + K o /) con captura preventiva en fase capture para interceptar la barra de navegador
                window.addEventListener('keydown', function (e) {
                    var isK = e.keyCode === 75 || e.key === 'k' || e.key === 'K' || e.code === 'KeyK';
                    if ((e.ctrlKey || e.metaKey) && isK) {
                        e.preventDefault();
                        e.stopPropagation();
                        if (typeof e.stopImmediatePropagation === 'function') {
                            e.stopImmediatePropagation();
                        }
                        $searchInput.focus().select();
                    } else if (e.key === '/' && !$(e.target).is('input, textarea, select')) {
                        e.preventDefault();
                        e.stopPropagation();
                        $searchInput.focus().select();
                    }
                }, true);

                // Búsqueda en tiempo real
                $searchInput.on('input focus', function () {
                    var query = $.trim($(this).val());
                    if (query.length === 0) {
                        $searchResults.hide().empty();
                        return;
                    }

                    var qNorm = normalizar(query);
                    var matches = indexedMenus.filter(function (m) {
                        return m.normTitle.indexOf(qNorm) !== -1 || (m.normParent && m.normParent.indexOf(qNorm) !== -1);
                    });

                    renderResults(matches, query);
                });

                function renderResults(matches, query) {
                    $searchResults.empty();
                    if (matches.length === 0) {
                        $searchResults.html(
                            '<div style="padding: 20px 16px; text-align: center; color: #64748b;">' +
                            '<i class="fa fa-search" style="font-size: 22px; color: #cbd5e1; margin-bottom: 6px;"></i>' +
                            '<div style="font-size: 13px; font-weight: 600;">Sin resultados</div>' +
                            '<div style="font-size: 11.5px; color: #94a3b8;">No encontramos pantallas que coincidan con "' + escapeHtml(query) + '"</div>' +
                            '</div>'
                        ).show();
                        return;
                    }

                    var html = '';
                    var maxResults = Math.min(matches.length, 12);
                    for (var i = 0; i < maxResults; i++) {
                        var m = matches[i];
                        var highlightedTitle = highlightMatch(m.title, query);
                        var parentTag = m.parent ? '<div style="font-size: 11px; color: #64748b; font-weight: 500; margin-top: 1px;">Módulo: <span style="color: #0284c7; font-weight: 600;">' + escapeHtml(m.parent) + '</span></div>' : '';

                        html += '<a href="' + m.url + '" class="search-result-item' + (i === 0 ? ' selected' : '') + '">' +
                            '<div style="width: 32px; height: 32px; border-radius: 8px; background: ' + m.color.f + '; color: ' + m.color.c + '; display: flex; align-items: center; justify-content: center; font-size: 14px; flex-shrink: 0;">' +
                            '<i class="' + m.icon + '"></i>' +
                            '</div>' +
                            '<div style="flex: 1; min-width: 0;">' +
                            '<div style="font-size: 13px; font-weight: 600; color: #1e293b; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">' + highlightedTitle + '</div>' +
                            parentTag +
                            '</div>' +
                            '<i class="fa fa-chevron-right" style="font-size: 11px; color: #94a3b8; margin-left: 6px;"></i>' +
                            '</a>';
                    }

                    $searchResults.html(html).show();
                }

                function highlightMatch(text, query) {
                    if (!query) return escapeHtml(text);
                    var idx = normalizar(text).indexOf(normalizar(query));
                    if (idx === -1) return escapeHtml(text);
                    var originalMatch = text.substr(idx, query.length);
                    return escapeHtml(text.substr(0, idx)) + '<span class="match-highlight">' + escapeHtml(originalMatch) + '</span>' + escapeHtml(text.substr(idx + query.length));
                }

                function escapeHtml(str) {
                    if (!str) return '';
                    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
                }

                // Navegación con teclado (Flecha Abajo, Flecha Arriba, Enter, Esc)
                $searchInput.on('keydown', function (e) {
                    var $items = $searchResults.find('.search-result-item');
                    if ($items.length === 0 || !$searchResults.is(':visible')) return;

                    var $selected = $items.filter('.selected');
                    var currentIndex = $items.index($selected);

                    if (e.keyCode === 40) { // Flecha Abajo
                        e.preventDefault();
                        var nextIndex = (currentIndex + 1) % $items.length;
                        $items.removeClass('selected').eq(nextIndex).addClass('selected');
                        scrollToItem($items.eq(nextIndex));
                    } else if (e.keyCode === 38) { // Flecha Arriba
                        e.preventDefault();
                        var prevIndex = (currentIndex - 1 + $items.length) % $items.length;
                        $items.removeClass('selected').eq(prevIndex).addClass('selected');
                        scrollToItem($items.eq(prevIndex));
                    } else if (e.keyCode === 13) { // Enter
                        e.preventDefault();
                        if ($selected.length > 0) {
                            window.location.href = $selected.attr('href');
                        }
                    } else if (e.keyCode === 27) { // Escape
                        $searchResults.hide();
                        $searchInput.blur();
                    }
                });

                function scrollToItem($item) {
                    if ($item.length === 0) return;
                    var dropdownTop = $searchResults.scrollTop();
                    var dropdownHeight = $searchResults.height();
                    var itemTop = $item.position().top;
                    var itemHeight = $item.outerHeight();

                    if (itemTop < 0) {
                        $searchResults.scrollTop(dropdownTop + itemTop);
                    } else if (itemTop + itemHeight > dropdownHeight) {
                        $searchResults.scrollTop(dropdownTop + itemTop + itemHeight - dropdownHeight);
                    }
                }

                $(document).on('click', function (e) {
                    if (!$(e.target).closest('.header-search-wrapper').length) {
                        $searchResults.hide();
                    }
                });
            })();
        });
    })();
</script>