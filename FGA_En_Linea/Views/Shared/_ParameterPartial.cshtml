
<aside class="control-sidebar control-sidebar-dark">
    <ul class="nav nav-tabs nav-justified control-sidebar-tabs">
        <li><a href="#control-sidebar-settings-tab" data-toggle="tab"><i class="fa fa-gears"></i></a></li>
       @* <li><a href="#control-sidebar-task-tab" data-toggle="tab"><i class="fa fa-home"></i></a></li>*@
    </ul>
    <div class="tab-content">
        <div class="tab-pane active" id="control-sidebar-settings-tab">
            @using (Html.BeginForm("Layout", "Config", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmConfig" }))
            {
                <h4 class="control-sidebar-heading">Gráficos</h4>
                <div class="form-group">
                    <label class="control-sidebar-subheading">
                        Mostrar eje Y
                        <input id="@FGA.Utility.Utilitarios.show_YAxis" type="checkbox" class="config pull-right" @(Session[FGA.Utility.Utilitarios.show_YAxis] is null ? string.Empty : "checked=checked") />
                    </label>
                    <p>
                        Permite ocultar el eje y de los gráficos
                    </p>
                </div>
                <div class="form-group">
                    <label class="control-sidebar-subheading">
                        Saltar fechas en eje X
                        <input id="@FGA.Utility.Utilitarios.show_DateEachN" type="checkbox" class="config pull-right" @(Session[FGA.Utility.Utilitarios.show_DateEachN] is null ? string.Empty : "checked=checked") />
                    </label>
                    <p>
                        Permite saltar las fechas en el eje x para que se muestren cada 3 periodos
                    </p>
                </div>
                <div class="form-group">
                    <label class="control-sidebar-subheading">
                        Valores en columnas
                        <input id="@FGA.Utility.Utilitarios.show_ColumnDetail" type="checkbox" class="config pull-right" @(Session[FGA.Utility.Utilitarios.show_ColumnDetail] is null ? string.Empty : "checked=checked") />
                    </label>
                    <p>
                        Indica si se debe mostrar o no los valores en las columnas
                    </p>
                </div>
                <div class="form-group">
                    <label class="control-sidebar-subheading">
                        Valores en líneas
                        <input id="@FGA.Utility.Utilitarios.show_LineDetail" type="checkbox" class="config pull-right" @(Session[FGA.Utility.Utilitarios.show_LineDetail] is null ? string.Empty : "checked=checked") />
                    </label>
                    <p>
                        Indica si se debe mostrar o no los valores en las líneas
                    </p>
                </div>
                <div class="form-group">
                    <label class="control-sidebar-subheading">
                        Menú oculto
                        <input id="@FGA.Utility.Utilitarios.show_MenuOculto" type="checkbox" class="config pull-right" @(Session[FGA.Utility.Utilitarios.show_MenuOculto] is null ? string.Empty : "checked=checked") />
                    </label>
                    <p>
                        Indica si el menú debe aparecer oculto
                    </p>
                </div>
            }
        </div>
        <div class="tab-pane" id="control-sidebar-task-tab">
            <h3 class="control-sidebar-heading">Tareas</h3>
            <ul class="control-sidebar-menu">
                <li>
                    <a href="javascript:void(0)">
                        <h4 class="control-sidebar-subheading">
                            Chat
                            <span class="label label-danger pull-right">70%</span>
                        </h4>

                        <div class="progress progress-xxs">
                            <div class="progress-bar progress-bar-warning" style="width: 70%"></div>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="javascript:void(0)">
                        <h4 class="control-sidebar-subheading">
                            Proyecciones
                            <span class="label label-danger pull-right">0%</span>
                        </h4>

                        <div class="progress progress-xxs">
                            <div class="progress-bar progress-bar-danger" style="width: 0%"></div>
                        </div>
                    </a>
                </li>
            </ul>
        </div>

    </div>
</aside>
<div class="control-sidebar-bg"></div>