
<aside class="control-sidebar control-sidebar-dark">
    <div class="pref-header">
        <div class="pref-header-info">
            <div class="pref-header-icon">
                <i class="fa fa-sliders"></i>
            </div>
            <div>
                <h4 class="pref-header-title">Preferencias</h4>
                <p class="pref-header-subtitle">Visualizaci&oacute;n y entorno anal&iacute;tico</p>
            </div>
        </div>
        <a href="javascript:void(0);" class="pref-close-btn needsclick" title="Cerrar panel">
            <i class="fa fa-times"></i>
        </a>
    </div>

    <div class="pref-body">
        @using (Html.BeginForm("Layout", "Config", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmConfig" }))
        {
            <div class="pref-section-heading">
                <i class="fa fa-bar-chart"></i> Opciones de Gr&aacute;ficos
            </div>

            <div class="pref-item">
                <div class="pref-text">
                    <div class="pref-label">
                        <i class="fa fa-arrows-v"></i> Mostrar eje Y
                    </div>
                    <span class="pref-desc">Permite ocultar o visualizar el eje vertical de los gr&aacute;ficos</span>
                </div>
                <div class="pref-control">
                    <label class="modern-switch" title="Mostrar/ocultar eje Y">
                        <input id="@FGA.Utility.Utilitarios.show_YAxis" type="checkbox" class="config" @(Session[FGA.Utility.Utilitarios.show_YAxis] is null ? string.Empty : "checked=checked") />
                        <span class="modern-switch-slider"></span>
                    </label>
                </div>
            </div>

            <div class="pref-item">
                <div class="pref-text">
                    <div class="pref-label">
                        <i class="fa fa-calendar"></i> Saltar fechas en eje X
                    </div>
                    <span class="pref-desc">Muestra las fechas del eje horizontal cada 3 per&iacute;odos</span>
                </div>
                <div class="pref-control">
                    <label class="modern-switch" title="Saltar fechas cada 3 periodos">
                        <input id="@FGA.Utility.Utilitarios.show_DateEachN" type="checkbox" class="config" @(Session[FGA.Utility.Utilitarios.show_DateEachN] is null ? string.Empty : "checked=checked") />
                        <span class="modern-switch-slider"></span>
                    </label>
                </div>
            </div>

            <div class="pref-item">
                <div class="pref-text">
                    <div class="pref-label">
                        <i class="fa fa-columns"></i> Valores en columnas
                    </div>
                    <span class="pref-desc">Muestra etiquetas de valores num&eacute;ricos sobre las columnas</span>
                </div>
                <div class="pref-control">
                    <label class="modern-switch" title="Mostrar valores en columnas">
                        <input id="@FGA.Utility.Utilitarios.show_ColumnDetail" type="checkbox" class="config" @(Session[FGA.Utility.Utilitarios.show_ColumnDetail] is null ? string.Empty : "checked=checked") />
                        <span class="modern-switch-slider"></span>
                    </label>
                </div>
            </div>

            <div class="pref-item">
                <div class="pref-text">
                    <div class="pref-label">
                        <i class="fa fa-line-chart"></i> Valores en l&iacute;neas
                    </div>
                    <span class="pref-desc">Muestra etiquetas de valores num&eacute;ricos sobre las l&iacute;neas</span>
                </div>
                <div class="pref-control">
                    <label class="modern-switch" title="Mostrar valores en l&iacute;neas">
                        <input id="@FGA.Utility.Utilitarios.show_LineDetail" type="checkbox" class="config" @(Session[FGA.Utility.Utilitarios.show_LineDetail] is null ? string.Empty : "checked=checked") />
                        <span class="modern-switch-slider"></span>
                    </label>
                </div>
            </div>

            <div class="pref-section-heading" style="margin-top: 18px;">
                <i class="fa fa-desktop"></i> Navegaci&oacute;n y Entorno
            </div>

            <div class="pref-item">
                <div class="pref-text">
                    <div class="pref-label">
                        <i class="fa fa-bars"></i> Men&uacute; lateral colapsado
                    </div>
                    <span class="pref-desc">Mantiene el men&uacute; lateral contra&iacute;do para mayor espacio visual</span>
                </div>
                <div class="pref-control">
                    <label class="modern-switch" title="Colapsar men&uacute; lateral">
                        <input id="@FGA.Utility.Utilitarios.show_MenuOculto" type="checkbox" class="config" @(Session[FGA.Utility.Utilitarios.show_MenuOculto] is null ? string.Empty : "checked=checked") />
                        <span class="modern-switch-slider"></span>
                    </label>
                </div>
            </div>
        }

        <div class="pref-footer-note">
            <i class="fa fa-info-circle"></i>
            <span>Los cambios se guardan y aplican autom&aacute;ticamente a su sesi&oacute;n de usuario.</span>
        </div>
    </div>
</aside>
<div class="control-sidebar-bg"></div>

<script type="text/javascript">
    $(document).on('click', '.pref-close-btn', function (e) {
        e.preventDefault();
        $('.control-sidebar').removeClass('control-sidebar-open');
        $('body').removeClass('control-sidebar-open');
    });
</script>