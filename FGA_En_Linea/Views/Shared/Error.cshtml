@model System.Web.Mvc.HandleErrorInfo

@{
    ViewBag.Title = "Error";
}

<section class="content-header">
    <h1>
        <i class="fa fa-exclamation-triangle text-danger"></i> Notificaci&oacute;n de Error
        <small>Se produjo un inconveniente al procesar la solicitud actual.</small>
    </h1>
</section>

<section class="content">
    <div class="alert alert-danger" style="margin-top: 15px; border-radius: 8px;">
        <h4><i class="icon fa fa-ban"></i> Ha ocurrido un error inesperado</h4>
        Ocurri&oacute; un error al procesar la solicitud. Por favor intente nuevamente o contacte al administrador del sistema.
    </div>
</section>
