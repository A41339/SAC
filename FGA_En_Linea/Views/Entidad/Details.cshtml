@model FGA.Models.Entidad

@{
    ViewBag.Title = "Consultar una Entidad";
    if (Ajax.IsThisAjaxRequest())
    {
        Layout = null;
    }
}
<section class="content-header">
    <h1>
        Consultar una Entidad
    </h1>
</section>
<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div class="box box-solid box-info">
                <div class="box-header">
                    <h3 class="box-title">Detalles</h3>
                </div>
                <div class="box-body table-responsive">
                    <div class="widget-sec">
                        <div class="streaming-table">
                            <table class="table table-striped table-bordered">
                                <tr>
                                    <td>Id</td>
                                    <td>@Html.DisplayFor(model => model.Id)</td>
                                </tr>
                                <tr>
                                    <td>Identificaci�n</td>
                                    <td>@Html.DisplayFor(model => model.Identificacion)</td>
                                </tr>
                                <tr>
                                    <td>Nombre</td>
                                    <td>@Html.Raw(Model.Nombre)</td>
                                </tr>
                                <tr>
                                    <td>Notificaciones</td>
                                    <td>@Html.Raw(Model.Contacto)</td>
                                </tr>
                                <tr>
                                    <td>Informes</td>
                                    <td>@Html.Raw(Model.CorreoInforme)</td>
                                </tr>
                                <tr>
                                    <td>Activo</td>
                                    <td>@Html.DisplayFor(model => model.Activo)</td>
                                </tr>
                                <tr>
                                    <td>Permitir Carga</td>
                                    <td>@Html.DisplayFor(model => model.Ind_Cargar)</td>
                                </tr>
                                <tr>
                                    <td>Validar Carga</td>
                                    <td>@Html.DisplayFor(model => model.Ind_Validar)</td>
                                </tr>
                            </table>
                            <div class="box-footer">                                 
                                @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-primary" })
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>