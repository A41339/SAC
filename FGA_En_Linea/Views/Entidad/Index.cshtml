@{
    ViewBag.Title = "Entidades";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content-header">
    <h1>
        <i class="fa fa-university"></i> Entidades Afiliadas
        <small>Administraci&oacute;n, registro y par&aacute;metros de cooperativas asociadas al FFC.</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="#">Administraci&oacute;n</a></li>
        <li class="active">Entidades Afiliadas</li>
    </ol>
</section>

<section class="content">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        <div class="col-xs-12">
            <div class="box box-solid box-info">

                <div class="box-body">
                    <!-- Split button -->
                    <div class="margin">
                        <div class="btn-group">
                            <a href="~/Entidad/Create" class="btn btn-dropbox">Crear una Entidad</a>
                        </div>
                    </div>
                    <!-- flat split buttons -->
                </div><!-- /.box-body -->
            </div>
            <div class="box box-solid box-info">
                <div class="box-body table-responsive">
                    <div class="margin">
                        <div class="streaming-table">
                            <span id="found" class="label label-info"></span>
                            <table id="tbCompany" class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th>Acción</th>
                                        <th> Código  </th>
                                        <th> Identificación  </th>
                                        <th> Nombre  </th>
                                        <th> Estado  </th>
                                        <th> Carga habilitada  </th>
                                        <th> Validar archivos  </th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>

                            <div id="summary">
                                <div>
                                </div>
                            </div>
                            <br />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script type="text/javascript">

        $(document).ready(function () {
            var oTableCompany = "";
            var ControlerNameCompany = "@Url.Content("~/Entidad")";
            // debugger;
            oTableCompany = $("#tbCompany").dataTable({
            "bRetrieve": true,
            "bProcessing": true,
            "dom": 'lBfrtip',
            "sAjaxSource": "@Url.Content("~/Entidad/GetGrid")",
            "buttons": [
                 { extend: 'copyHtml5', exportOptions: { columns: ':visible' } }
                ,{ extend: 'excelHtml5', exportOptions: { columns: ':visible' } }
                ,{ extend: 'pdfHtml5', exportOptions: { columns: ':visible' } }
                ,{ extend: 'print', exportOptions: { columns: ':visible' } }
                ,'colvis'
            ], columnDefs: [{   visible: false }],
            "pageLength": 10,
            "lengthMenu": [[5,10, 25, 50, -1], [5,10, 25, 50, "Todos"]],
                "aoColumns": [

                {
                                 "mRender": function (oObj, type, row) {

                    var buttons = '<div class="text-center"> <div class="btn-group text-left"> <button type="button" class="btn btn-xs btn-default dropdown-toggle" data-toggle="dropdown" style="border-radius:6px; border:1px solid #cbd5e1; font-size:12px; padding:4px 10px; color:#374151;"><i class="fa fa-cog" style="margin-right:4px;"></i> Acción <span class="caret"></span></button>';
                    buttons += '<ul class="dropdown-menu pull-left" role="menu">';
                                     buttons += '<li><a href="' + ControlerNameCompany + "/Edit/" + row[0] + '"><i class="fa fa-edit"></i>Modificar</a></li>';
                                     buttons += '<li><a href="' + ControlerNameCompany + "/Details/" + row[0] + '"><i class="fa fa-edit"></i>Consultar</a></li>';
                                     buttons += '<li><a href="' + ControlerNameCompany + "/Delete/" + row[0] + '"><i class="fa fa-edit"></i>Borrar</a></li>';
                    buttons += '</ul>';
                    buttons += '</div></div>';
                    return buttons;
                }
                    },
                    {},
                    {},
                    {},
                    {
                        "mRender": function (val, type, row) {
                            if (!val) return "";
                            if (type === 'display') {
                                return (val === 'Activo')
                                    ? '<span class="badge" style="background-color:#10b981; color:#fff; font-weight:600; padding:4px 9px; border-radius:4px; font-size:11px;">Activo</span>'
                                    : '<span class="badge" style="background-color:#ef4444; color:#fff; font-weight:600; padding:4px 9px; border-radius:4px; font-size:11px;">Inactivo</span>';
                            }
                            return val;
                        }
                    },
                    {
                        "mRender": function (val, type, row) {
                            if (!val) return "";
                            var text = val.toString().replace(/S[\ufffd\?]/g, 'S\u00ed');
                            if (type === 'display') {
                                return (text === 'S\u00ed' || text === 'Si')
                                    ? '<span class="badge" style="background-color:#0284c7; color:#fff; font-weight:600; padding:4px 9px; border-radius:4px; font-size:11px;">S\u00ed</span>'
                                    : '<span class="badge" style="background-color:#94a3b8; color:#fff; font-weight:600; padding:4px 9px; border-radius:4px; font-size:11px;">No</span>';
                            }
                            return text;
                        }
                    },
                    {
                        "mRender": function (val, type, row) {
                            if (!val) return "";
                            var text = val.toString().replace(/S[\ufffd\?]/g, 'S\u00ed');
                            if (type === 'display') {
                                return (text === 'S\u00ed' || text === 'Si')
                                    ? '<span class="badge" style="background-color:#0284c7; color:#fff; font-weight:600; padding:4px 9px; border-radius:4px; font-size:11px;">S\u00ed</span>'
                                    : '<span class="badge" style="background-color:#94a3b8; color:#fff; font-weight:600; padding:4px 9px; border-radius:4px; font-size:11px;">No</span>';
                            }
                            return text;
                        }
                    }
                ]
        });
     });
</script>

