@{
    ViewBag.Title = "Proyecciones";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section ScriptsOrCss
{
    <link rel="stylesheet" href="~/Content/multiselect/docs/css/prettify.min.css" type="text/css">
    <script type="text/javascript" src="~/Content/multiselect/docs/js/prettify.min.js"></script>
    <link rel="stylesheet" href="~/Content/multiselect/dist/css/bootstrap-multiselect.css" type="text/css">
    <script type="text/javascript" src="~/Content/multiselect/dist/js/bootstrap-multiselect.js"></script>
}

<section class="content-header">
    <h1 class="modern-page-title">
        <i class="fa fa-calculator" style="color: #0284c7;"></i>
        Proyecciones de Liquidez
        <small>C&aacute;lculo y proyecci&oacute;n de saldos hist&oacute;ricos y futuros</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="#">IRL</a></li>
        <li class="active">Proyecciones</li>
    </ol>
</section>

<section class="content">
    @using (Html.BeginForm("BuscarHistorico", "IRL", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmMatriz" }))
    {
        @Html.AntiForgeryToken()
        <div class="row">
            <div class="col-xs-12">
                <div class="modern-filter-card">
                    <div class="modern-filter-toolbar">
                        <div class="filter-item">
                            <label for="IdEntidad"><i class="fa fa-university"></i> Entidad:</label>
                            @Html.DropDownList("Entidades", null, new { @id = "IdEntidad", @class = "form-control modern-select", style = "min-width: 200px;" })
                        </div>
                        <div class="filter-item">
                            <label for="Cuentas"><i class="fa fa-list-alt"></i> Cuenta:</label>
                            @Html.DropDownList("Cuentas", null, new { @id = "Cuentas", @class = "form-control modern-select", style = "min-width: 220px;" })
                        </div>
                        <div class="filter-item">
                            <label for="PeriodoC"><i class="fa fa-calendar"></i> Per&iacute;odo corte:</label>
                            <div class="modern-input-wrapper">
                                <input name="PeriodoC" id="PeriodoC" class="datecontrol form-control modern-date-input" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo2"].ToString()).ToString("MM/yyyy")" style="min-width: 120px;" />
                            </div>
                        </div>
                        <div class="filter-item">
                            <label for="PeriodosHist"><i class="fa fa-history"></i> Per&iacute;odos hist.:</label>
                            <input name="PeriodosHist" id="PeriodosHist" class="form-control" type="number" value="@Session["PeriodosHist"]" style="min-width: 100px; height: 38px;" />
                        </div>
                        <div class="filter-item">
                            <label for="PeriodosProy"><i class="fa fa-line-chart"></i> Per&iacute;odos proy.:</label>
                            <input name="PeriodosProy" id="PeriodosProy" class="form-control" type="number" value="@Session["PeriodosProy"]" style="min-width: 100px; height: 38px;" />
                        </div>
                        <div class="filter-item" style="margin-left: auto;">
                            <button type="submit" name="submit" class="btn-modern-filter">
                                <i class="fa fa-search"></i> Generar
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <section class="content">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="modern-table-card">
                                <div style="display: flex; align-items: center; gap: 10px; padding: 12px 16px; background: #f8fafc; border-bottom: 1px solid #e2e8f0; border-radius: 12px 12px 0 0;">
                                    <img width="36" height="36" src="@Session["Logo"]" style="border-radius: 6px; background: #fff; padding: 2px;" />
                                    <h4 style="margin: 0; font-size: 14px; font-weight: 700; color: #1e293b;">Per&iacute;odos hist&oacute;ricos</h4>
                                </div>
                                <div style="padding: 12px;">
                                    <span id="found" class="label label-info"></span>
                                    <table id="tbHistory" class="table table-striped table-bordered modern-data-table" style="width:100%; height: 350px">
                                        <thead>
                                            <tr>
                                                <th> Per&iacute;odo </th>
                                                <th> Saldo </th>
                                                <th> </th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                    <div id="summary">
                                        <div></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div id="tblProyeccion">
                            @Html.Partial("_VerProyeccion")
                        </div>
                    </div>
                </section>
            </div>
        </div>
    }

    <div class="modal fade" id="graphModal" tabindex="-1" role="dialog" aria-labelledby="deleteLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div id="grafica">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger" data-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal HTML -->
    <div id="modalSuccess" class="modal fade">
        <div class="modal-dialog modal-confirm">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="icon-box">
                        <i class="material-icons">&#xE876;</i>
                    </div>
                    <h4 id="idTitulo" class="modal-title">Proceso exitoso</h4>
                </div>
                <div class="modal-body">
                    <p class="text-center">Acci&oacute;n realizada con &eacute;xito</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-success btn-block" data-dismiss="modal">OK</button>
                </div>
            </div>
        </div>
    </div>

    <div id="modalError" class="modal fade">
        <div class="modal-dialog modal-fail">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="icon-box">
                        <i class="material-icons"></i>
                    </div>
                </div>
                <div class="modal-body">
                    <p id="lbl_mensajeError" class="text-center">Ha ocurrido un error.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-danger btn-block" data-dismiss="modal">OK</button>
                </div>
            </div>
        </div>
    </div>

</section>

<script type="text/javascript">
    
     $("#IdEntidad").change(function () {
         $('#tblProyeccion').html(''); 
     });

     $("#Cuentas").change(function () {
         $('#tblProyeccion').html(''); 
     });
  
    function add(periodo, entidad, cuenta) {
        $.ajax({
            url: '@Url.Action("Add", "IRL")',
            type: 'POST',
            cache: false,
            async: false,
            data: {
                'IdEntidad': entidad,
                'Periodo': periodo,
                'Cuenta': cuenta
            },
            success: function (data) {
                var resultado = data.resultado.exito;
                if (resultado == true) {
                     $('#tbHistory').DataTable().ajax.reload();
                }
            },
            error: function (result) {
                $("#modalError").modal('show');
            }
        });
    }

    function remove(periodo, entidad, cuenta) {
        $.ajax({
            url: '@Url.Action("Remove", "IRL")',
            type: 'POST',
            cache: false,
            async: false,
            data: {
                'IdEntidad': entidad,
                'Periodo': periodo,
                'Cuenta': cuenta
            },
            success: function (data) {
                var resultado = data.resultado.exito;
                if (resultado == true) {
                     $('#tbHistory').DataTable().ajax.reload();
                }
            },
            error: function (result) {
                $("#modalError").modal('show');
            }
        });
    }

    function formatMillion() {
        return this.value;
    }

    function getGraph(tipo) {
        $.ajax({
            url: '@Url.Action("GraficaDetalle", "IRL")',
            type: 'POST',
            cache: false,
            async: false,
            data: {
                'Tipo': tipo
            },
            success: function (result) {
                $('#grafica').html(result);
            }
        });

        $('#graphModal').modal('show');
    }

      function borrarProy(tipo) {

        var cuenta = $("#Cuentas").val();
        var periodo = $("#PeriodoC").val();
        var idEntidad = $("#IdEntidad").val();

        $.ajax({
            url: '@Url.Action("BorrarProyeccion", "IRL")',
            type: 'POST',
            cache: false,
            async: false,
            data: {
                'Tipo': tipo,
                'Cuenta': cuenta,
                'Periodo': periodo,
                'IdEntidad': idEntidad,
            },
            success: function (data) {
                var resultado = data.resultado.exito;
                if (resultado == false) {
                    $("#lbl_mensajeError").html(data.resultado.mensaje);
                    $("#modalError").modal('show');
                }
                else {           
                    actualizarProyeccion();
                    $("#modalSuccess").modal('show');
                }
            },
            error: function (result) {
                $("#modalError").modal('show');
            }
        });
    }

    function guardar(tipo) {

        var periodosHist = $("#PeriodosHist").val();
        var cuenta = $("#Cuentas").val();
        var periodo = $("#PeriodoC").val();
        var idEntidad = $("#IdEntidad").val();
        var periodosProy = $("#PeriodosProy").val();

        $.ajax({
            url: '@Url.Action("GuardarProyeccion", "IRL")',
            type: 'POST',
            cache: false,
            async: false,
            data: {
                'Tipo': tipo,
                'PeriodosHist': periodosHist,
                'Cuenta': cuenta,
                'Periodo': periodo,
                'IdEntidad': idEntidad,
                'PeriodosProy': periodosProy
            },
            success: function (data) {
                var resultado = data.resultado.exito;
                if (resultado == false) {
                    $("#lbl_mensajeError").html(data.resultado.mensaje);
                    $("#modalError").modal('show');
                }
                else {           
                    actualizarProyeccion();
                    $("#modalSuccess").modal('show');
                }
            },
            error: function (result) {
                $("#modalError").modal('show');
            }
        });
    }

    function actualizarProyeccion() {
         $.ajax({
            url: '@Url.Action("_VerProyeccion", "IRL")',
            type: 'POST',
            cache: false,
            async: false,
             success: function (result) {
                $('#tblProyeccion').html(result);
            }
        });
    }

    $(document).ready(function () {

        $('#Cuentas').multiselect({
            enableFiltering: true,
            filterBehavior: 'text',
            buttonWidth: 200,
            numberDisplayed: 1,
            maxHeight: 300
        });

        var ControlerNameRole = "@Url.Content("~/IRL")";

        oTableRole = $("#tbHistory").dataTable({
        "bRetrieve": true,
        "bProcessing": true,
        "bPaginate": false,
        "bFilter": false,
        "bInfo": false,
        "bSort" : false,
        "dom": 'lBfrtip',
        "sAjaxSource": "@Url.Content("~/IRL/GetHistorico")",
        "buttons": [
                { extend: 'copyHtml5', exportOptions: { columns: ':visible' } }
            ,{ extend: 'excelHtml5', exportOptions: { columns: ':visible' } }
            ,{ extend: 'csvHtml5', exportOptions: { columns: ':visible' } }
            ,{ extend: 'print', exportOptions: { columns: ':visible' } }
            ,'colvis'
            ],
            columnDefs: [
                { className: "text-right", targets:  [1] }, {  className: "text-center", targets:  [2] }
            ],
            "aoColumns": [{}, {}, {}]
        });

    });

</script>
