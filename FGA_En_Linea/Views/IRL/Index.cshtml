@{
    ViewBag.Title = "Proyecciones";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section ScriptsOrCss
{
    <link rel="stylesheet" href="~/Content/multiselect/docs/css/prettify.min.css" type="text/css">
    <script type="text/javascript" src="~/Content/multiselect/docs/js/prettify.min.js"></script>
    <link rel="stylesheet" href="~/Content/multiselect/dist/css/bootstrap-multiselect.css" type="text/css">
    <script type="text/javascript" src="~/Content/multiselect/dist/js/bootstrap-multiselect.js"></script>
}

<section class="content-header">
    <h1>
        Proyecciones
    </h1>
</section>

<section class="content">
    @using (Html.BeginForm("BuscarHistorico", "IRL", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmMatriz" }))
    {
        @Html.AntiForgeryToken()
        <div class="row">
            <div class="col-xs-12">
                <div class="streaming-table">
                    <div class="box box-primary">
                        <div class="box-body">
                            <span id="found" class="label label-info"></span>
                            <table class="table table-condensed table-striped table-bordered" style="padding-left: 10px;">
                                <tr>
                                    <td class="mobile">
                                        @Html.Label("Entidad:")
                                    </td>
                                    <td nowrap="nowrap">
                                        @Html.DropDownList("Entidades", null, new { @id = "IdEntidad", @class = "form-control" })
                                    </td>
                                    <td class="mobile">
                                        @Html.Label("Cuenta:")
                                    </td>
                                    <td nowrap="nowrap">
                                        @Html.DropDownList("Cuentas", null, new { @id = "Cuentas", @class = "form-control" })
                                    </td>
                                    <td class="mobile">
                                        @Html.Label("Periodo corte:")
                                    </td>
                                    <td nowrap="nowrap">
                                        <input name="PeriodoC" id="PeriodoC" style="width: 100px" class="datecontrol" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo2"].ToString()).ToString("MM/yyyy")" />
                                    </td>
                                </tr>
                                <tr>
                                    <td class="mobile">
                                        @Html.Label("Periodos históricos:")
                                    </td>
                                    <td nowrap="nowrap">
                                        <input name="PeriodosHist" id="PeriodosHist" class="form-control" type="number" value="@Session["PeriodosHist"]" />
                                    </td>
                                    <td class="mobile">
                                        @Html.Label("Periodos a proyectar:")
                                    </td>
                                    <td nowrap="nowrap">
                                        <input name="PeriodosProy" id="PeriodosProy" class="form-control" type="number" value="@Session["PeriodosProy"]" />
                                    </td>
                                    <td>
                                    </td>
                                    <td>
                                        <label class="btn btn-facebook">
                                            Generar<input type="submit" name="submit" style="display: none;">
                                        </label>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <section class="content">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="box box-primary">
                                <div class="box-body">
                                    <div class="row">
                                        <div class="col-xs-12">
                                            <span id="found" class="label label-info"></span>
                                            <table id="tbHistory" class="table table-striped table-bordered" style="width:100%; height: 350px">
                                                <thead>
                                                    <tr>
                                                        <th colspan="2">
                                                            <img width="50" height="50" src="@Session["Logo"]" />
                                                            <label class="box-title">Periodos históricos</label>
                                                        </th>
                                                    </tr>
                                                    <tr>
                                                        <th> Periodo  </th>
                                                        <th> Saldo </th>
                                                        <th> </th>
                                                    </tr>
                                                </thead>
                                                <tbody></tbody>
                                            </table>
                                            <div id="summary">
                                                <div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div id="tblProyeccion">
                            @Html.Partial("_VerProyeccion")
                        </div>
                    </div>
                </section>
            </div>
        </div>
    }

    <div class="modal fade" id="graphModal" tabindex="-1" role="dialog" aria-labelledby="deleteLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div id="grafica">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger" data-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal HTML -->
    <div id="modalSuccess" class="modal fade">
        <div class="modal-dialog modal-confirm">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="icon-box">
                        <i class="material-icons">&#xE876;</i>
                    </div>
                    <h4 id="idTitulo" class="modal-title">Proceso exitoso</h4>
                </div>
                <div class="modal-body">
                    <p class="text-center">Acción realizada con éxito</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-success btn-block" data-dismiss="modal">OK</button>
                </div>
            </div>
        </div>
    </div>

    <div id="modalError" class="modal fade">
        <div class="modal-dialog modal-fail">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="icon-box">
                        <i class="material-icons"></i>
                    </div>
                </div>
                <div class="modal-body">
                    <p id="lbl_mensajeError" class="text-center">Ha ocurrido un error.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-danger btn-block" data-dismiss="modal">OK</button>
                </div>
            </div>
        </div>
    </div>

</section>

<script type="text/javascript">
    
     $("#IdEntidad").change(function () {
         $('#tblProyeccion').html(''); 
     });

     $("#Cuentas").change(function () {
         $('#tblProyeccion').html(''); 
     });
  
    function add(periodo, entidad, cuenta) {
        $.ajax({
            url: '@Url.Action("Add", "IRL")',
            type: 'POST',
            cache: false,
            async: false,
            data: {
                'IdEntidad': entidad,
                'Periodo': periodo,
                'Cuenta': cuenta
            },
            success: function (data) {
                var resultado = data.resultado.exito;
                if (resultado == true) {
                     $('#tbHistory').DataTable().ajax.reload();
                }
            },
            error: function (result) {
                $("#modalError").modal('show');
            }
        });
    }

    function remove(periodo, entidad, cuenta) {
        $.ajax({
            url: '@Url.Action("Remove", "IRL")',
            type: 'POST',
            cache: false,
            async: false,
            data: {
                'IdEntidad': entidad,
                'Periodo': periodo,
                'Cuenta': cuenta
            },
            success: function (data) {
                var resultado = data.resultado.exito;
                if (resultado == true) {
                     $('#tbHistory').DataTable().ajax.reload();
                }
            },
            error: function (result) {
                $("#modalError").modal('show');
            }
        });
    }

    function formatMillion() {
        return this.value;
    }

    function getGraph(tipo) {
        $.ajax({
            url: '@Url.Action("GraficaDetalle", "IRL")',
            type: 'POST',
            cache: false,
            async: false,
            data: {
                'Tipo': tipo
            },
            success: function (result) {
                $('#grafica').html(result);
            }
        });

        $('#graphModal').modal('show');
    }

      function borrarProy(tipo) {

        var cuenta = $("#Cuentas").val();
        var periodo = $("#PeriodoC").val();
        var idEntidad = $("#IdEntidad").val();

        $.ajax({
            url: '@Url.Action("BorrarProyeccion", "IRL")',
            type: 'POST',
            cache: false,
            async: false,
            data: {
                'Tipo': tipo,
                'Cuenta': cuenta,
                'Periodo': periodo,
                'IdEntidad': idEntidad,
            },
            success: function (data) {
                var resultado = data.resultado.exito;
                if (resultado == false) {
                    $("#lbl_mensajeError").html(data.resultado.mensaje);
                    $("#modalError").modal('show');
                }
                else {           
                    actualizarProyeccion();
                    $("#modalSuccess").modal('show');
                }
            },
            error: function (result) {
                $("#modalError").modal('show');
            }
        });
    }

    function guardar(tipo) {

        var periodosHist = $("#PeriodosHist").val();
        var cuenta = $("#Cuentas").val();
        var periodo = $("#PeriodoC").val();
        var idEntidad = $("#IdEntidad").val();
        var periodosProy = $("#PeriodosProy").val();

        $.ajax({
            url: '@Url.Action("GuardarProyeccion", "IRL")',
            type: 'POST',
            cache: false,
            async: false,
            data: {
                'Tipo': tipo,
                'PeriodosHist': periodosHist,
                'Cuenta': cuenta,
                'Periodo': periodo,
                'IdEntidad': idEntidad,
                'PeriodosProy': periodosProy
            },
            success: function (data) {
                var resultado = data.resultado.exito;
                if (resultado == false) {
                    $("#lbl_mensajeError").html(data.resultado.mensaje);
                    $("#modalError").modal('show');
                }
                else {           
                    actualizarProyeccion();
                    $("#modalSuccess").modal('show');
                }
            },
            error: function (result) {
                $("#modalError").modal('show');
            }
        });
    }

    function actualizarProyeccion() {
         $.ajax({
            url: '@Url.Action("_VerProyeccion", "IRL")',
            type: 'POST',
            cache: false,
            async: false,
             success: function (result) {
                $('#tblProyeccion').html(result);
            }
        });
    }

    $(document).ready(function () {

        $('#Cuentas').multiselect({
            enableFiltering: true,
            filterBehavior: 'text',
            buttonWidth: 200,
            numberDisplayed: 1,
            maxHeight: 300
        });

        var ControlerNameRole = "@Url.Content("~/IRL")";

        oTableRole = $("#tbHistory").dataTable({
        "bRetrieve": true,
        "bProcessing": true,
        "bPaginate": false,
        "bFilter": false,
        "bInfo": false,
        "bSort" : false,
        "dom": 'lBfrtip',
        "sAjaxSource": "@Url.Content("~/IRL/GetHistorico")",
        "buttons": [
                { extend: 'copyHtml5', exportOptions: { columns: ':visible' } }
            ,{ extend: 'excelHtml5', exportOptions: { columns: ':visible' } }
            ,{ extend: 'csvHtml5', exportOptions: { columns: ':visible' } }
            ,{ extend: 'print', exportOptions: { columns: ':visible' } }
            ,'colvis'
            ],
            columnDefs: [
                { className: "text-right", targets:  [1] }, {  className: "text-center", targets:  [2] }
            ],
            "aoColumns": [{}, {}, {}]
        });

    });

</script>
