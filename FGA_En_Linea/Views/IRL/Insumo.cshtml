@{
    ViewBag.Title = "Insumos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<section class="content-header">
    <h1>
        Insumos
    </h1>
</section>

<section class="content">
    @using (Html.BeginForm("Buscar", "IRL", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmInsumo" }))
    {
        @Html.AntiForgeryToken()
        <div class="row">
            <div class="col-xs-12">
                <div class="box box-solid box-info">
                    <div class="box-body table-responsive">
                        <div class="margin">
                            <div class="streaming-table">
                                <span id="found" class="label label-info"></span>
                                <table class="table table-condensed table-striped table-bordered">
                                    <tr>
                                        <td class="mobile">
                                            @Html.Label("Entidad:")
                                        </td>
                                        <td>
                                            @Html.DropDownList("Entidades", null, new { @id = "IdEntidad", style = "width: 200px;" })
                                        </td>
                                        <td class="mobile">
                                            @Html.Label("Inicial:")
                                        </td>
                                        <td nowrap="nowrap">
                                            <input name="PeriodoI" id="PeriodoI" class="datecontrol" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo1"].ToString()).ToString("MM/yyyy")" />
                                        </td>
                                        <td class="mobile">
                                            @Html.Label("Final:")
                                        </td>
                                        <td nowrap="nowrap">
                                            <input name="PeriodoF" id="PeriodoF" class="datecontrol" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo2"].ToString()).ToString("MM/yyyy")" />
                                        </td>
                                        <td>
                                            <label class="btn btn-facebook">
                                                Generar<input type="submit" name="submit" style="display: none;">
                                            </label>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="box box-solid box-info">
            <div class="nav-tabs-custom">
                <ul class="nav nav-tabs">
                    <li class="active"><a href="#tab_3" data-toggle="tab">Gastos e Ingresos</a></li>
                    <li><a href="#tab_4" data-toggle="tab">Entradas - Salidas (210)</a></li>
                    <li><a href="#tab_1" data-toggle="tab">Colocación de cartera</a></li>
                    <li><a href="#tab_2" data-toggle="tab">Cartera nueva</a></li>
                    <li><a href="#tab_5" data-toggle="tab">Cartera mantiene</a></li>
                </ul>
                <div class="tab-content">
                    <div class="tab-pane" id="tab_4">
