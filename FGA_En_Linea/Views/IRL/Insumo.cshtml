                                                    </th>
                                                    <th>
                                                        B2
                                                    </th>
                                                    <th>
                                                        C1
                                                    </th>
                                                    <th>
                                                        C2
                                                    </th>
                                                    <th>
                                                        D
                                                    </th>
                                                    <th>
                                                        E
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                        <div id="summary">
                                            <div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    }
</section>

