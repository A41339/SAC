        <i class="fa fa-database" style="color: #0284c7;"></i>
        Insumos de Liquidez
        <small>Consulta y an&aacute;lisis de insumos para el indicador de riesgo de liquidez</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="@Url.Action("Index", "Modulo", new { modulo = "Cartera" })" class="breadcrumb-parent-pill"><i class="fa fa-line-chart" style="margin-right: 4px;"></i> IRL</a></li>
        <li class="active">Insumos</li>
    </ol>
</section>

