                                        <span id="found" class="label label-info"></span>
                                        <table id="tbRiesgoLiquidez" class="table table-striped table-bordered" style="width:100%; height: 350px">
                                            <thead>
                                                <tr>
                                                    <th colspan="11">
                                                        <img width="50" height="50" src="@Session["Logo"]" />
                                                    </th>
                                                </tr>
                                                <tr>
                                                    <th colspan="1">
                                                    </th>
                                                    <th colspan="2" style="text-align:center">
                                                        Aumenta
                                                    </th>
                                                    <th colspan="3" style="text-align:center">
                                                        Nuevo
