@model DotNet.Highcharts.Highcharts
<div class="modal-header">
    <div style="display: flex; align-items: center; gap: 12px;">
        <div style="width: 42px; height: 42px; min-width: 42px; border-radius: 8px; background: #ffffff; padding: 3px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: 0 2px 6px rgba(0,0,0,0.15); border: 1px solid #e2e8f0;">
            <img class="img-logo-entidad" src="@Session["Logo"]" alt="Logo" style="max-width: 100%; max-height: 100%; width: 100%; height: 100%; object-fit: contain; display: block; margin: auto;" onerror="this.onerror=null;this.src='@Url.Content("~/Content/images/FFC.jpg")';" />
        </div>
        <h3 id="entidad" class="box-title" style="margin: 0; color: #ffffff !important; font-size: 16px; font-weight: 600;"></h3>
    </div>
    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
</div>
<div class="modal-body" style="padding: 24px;">
    <div id="container" style="width: 100%; height: 400px">
        @(Model)
    </div>
</div>

