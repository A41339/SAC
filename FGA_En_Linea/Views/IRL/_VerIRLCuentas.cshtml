@model FGA.Model.Modelo_IRL

<div id="tbl_IRLCuentas">
    <div class="col-md-6">
        <div id="tblIRLCuentas">
            <div class="box box-primary">
                <div class="box-body">
                    <div class="row">
                        <div class="col-xs-12">
                            <span id="found" class="label label-info"></span>
                            <div class="box-header with-border">
                                <img width="50" height="50" src="@Session["Logo"]" />
                                <h4 class="box-title">Indicador de riesgo de liquidez</h4>
                            </div>
                            <table id="tbCuentas" class="table table-striped table-bordered" style="width:100%; height: 350px">
                                <thead>

                                    <tr>
                                        <th class="text-center"> Nombre </th>
                                        <th class="text-center"> Ponderador </th>
                                        <th class="text-center"> Saldo </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var detalle in Model.listaCuentas)
                                    {
                                        <tr>
                                            <td>
                                                @detalle.NOMBRE
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(detalle.PONDERADOR))
                                                {
                                                    <input name="@detalle.CUENTA" id="@detalle.CUENTA" class="text-right" style="width: 100px; border-style: none" value="@detalle.PONDERADOR" />
                                                }
                                            </td>
                                            <td class="text-right">
                                                @FGA.Utility.Utilitarios.ConvertirAString(detalle.TOTAL.Value)
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="3" style="text-align: right">
                                            <a data-toggle="tooltip" data-placement="top" href="javascript:consultarIRL()"><i style="margin:5px" class="btn btn-xs btn-info icon fa fa-refresh"></i></a>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                            <br>
                            <div id="summary">
                                <div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div>
            <div class="nav-tabs-custom">
                <ul class="nav nav-tabs">
                    <li class="active"><a href="#tab_1" data-toggle="tab">IRL</a></li>
                    <li><a href="#tab_2" data-toggle="tab">Brecha</a></li>
                </ul>
                <div class="tab-content">
                    <div class="tab-pane active" id="tab_1">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="box-header with-border">
                                    <img width="50" height="50" src="@Session["Logo"]" />
                                    <h4 class="box-title">Indicador de riesgo de liquidez (IRL)</h4>
                                </div>
                                <div class="box-body">
                                    @(Model.IRLGraph)
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane" id="tab_2">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="box-header with-border">
                                    <img width="50" height="50" src="@Session["Logo"]" />
                                    <h4 class="box-title">Brechas de liquidez</h4>
                                </div>
                                <div class="box-body">
                                    @(Model.BrechaLiquidezGraph)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="row">
        <div class="col-xs-12">
            <div class="box box-solid box-info">
                <div class="box-body table-responsive">
                    <div class="margin">
                        <div class="streaming-table">
                            <span id="found" class="label label-info"></span>
                            <table id="tbIRLR" class="table table-striped table-bordered" style="width:100%">
                                <thead>
                                    <tr>
                                        <th colspan="10">
                                            <div class="box-header with-border">
                                                <img width="50" height="50" src="@Session["Logo"]" />
                                                <h4 class="box-title">&Iacute;ndice de riesgo de liquidez</h4>
                                            </div>
                                        </th>
                                    </tr>
                                    <tr>
                                        <th class="hidden"></th>
                                        <th></th>
                                        <th class="text-center encabezadoIRL">Banda 1</th>
                                        <th class="text-center encabezadoIRL">Banda 2</th>
                                        <th class="text-center encabezadoIRL">Banda 3</th>
                                        <th class="text-center encabezadoIRL">Banda 4</th>
                                        <th class="text-center encabezadoIRL">Banda 5</th>
                                        <th class="text-center encabezadoIRL">Banda 6</th>
                                        <th class="text-center encabezadoIRL">Banda 7</th>
                                        <th class="text-center encabezadoIRL">Banda 8</th>
                                    </tr>
                                    <tr>
                                        <th class="hidden"></th>
                                        <th></th>
                                        <th class="text-center encabezadoIRLPeriodo">@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo2"].ToString()).AddMonths(1).ToString("MMMM")</th>
                                        <th class="text-center encabezadoIRLPeriodo">@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo2"].ToString()).AddMonths(2).ToString("MMMM")</th>
                                        <th class="text-center encabezadoIRLPeriodo">@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo2"].ToString()).AddMonths(3).ToString("MMMM")</th>
                                        <th class="text-center encabezadoIRLPeriodo">@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo2"].ToString()).AddMonths(4).ToString("MMMM")</th>
                                        <th class="text-center encabezadoIRLPeriodo">
                                            @FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo2"].ToString()).AddMonths(5).ToString("MMMM") - @FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo2"].ToString()).AddMonths(7).ToString("MMMM")
                                        </th>
                                        <th class="text-center encabezadoIRLPeriodo">
                                            @FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo2"].ToString()).AddMonths(8).ToString("MMMM") - @FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo2"].ToString()).AddMonths(12).ToString("MMMM")
                                        </th>
                                        <th class=""></th>
                                        <th class=""></th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                            <div id="summary">
                                <div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @if (Env.GetUserInfo("roleid") != FGA.Utility.Utilitarios.roleAdminEntidad && Env.GetUserInfo("roleid") != FGA.Utility.Utilitarios.roleMaestroEntidad)
    {
        <div class="row">
            <div class="col-xs-12">
                <div class="box box-solid box-info">
                    <div class="box-body table-responsive">
                        <div class="margin">
                            <div class="streaming-table">
                                <span id="found" class="label label-info"></span>
                                <table id="tbIRL" class="table table-striped table-bordered" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th colspan="10">
                                                <div class="box-header with-border">
                                                    <img width="50" height="50" src="@Session["Logo"]" />
                                                    <h4 class="box-title">&Iacute;ndice de riesgo de liquidez</h4>
                                                </div>
                                            </th>
                                        </tr>
                                        <tr>
                                            <th class="hidden">Id</th>
                                            <th></th>
                                            <th class="text-center encabezadoIRL">Banda 1</th>
                                            <th class="text-center encabezadoIRL">Banda 2</th>
                                            <th class="text-center encabezadoIRL">Banda 3</th>
                                            <th class="text-center encabezadoIRL">Banda 4</th>
                                            <th class="text-center encabezadoIRL">Banda 5</th>
                                            <th class="text-center encabezadoIRL">Banda 6</th>
                                            <th class="hidden"></th>
                                            <th class="hidden"></th>
                                            <th class="hidden"></th>
                                            <th class="hidden"></th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                                <div id="summary">
                                    <div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<script type="text/javascript">
    function formatMillion() {
        return this.value;
    }

    function formatPercent() {
        return this.value + ' %';
    }

    $(document).ready(function () {
            $("#tbIRL").dataTable({
                "rowCallback": function( nRow, aData, iDisplayIndex, iDisplayIndexFull ) {
                 $(nRow).find('td:eq(0)').addClass('hidden');
                 $(nRow).find('td:eq(8)').addClass('hidden');
                 $(nRow).find('td:eq(9)').addClass('hidden');
                 $(nRow).find('td:eq(10)').addClass('hidden');
                 $(nRow).find('td:eq(11)').addClass('hidden');

                if (parseInt(aData[9]) == 1){
                    $(nRow).find('td').css('border-top', 'solid black 1px');
                    $(nRow).find('td').css('border-bottom', 'solid black 1px');
                }

                if (parseInt(aData[10]) == 1){
                    $(nRow).addClass('irl-row-blue');
                    $(nRow).find('td:not(:eq(1))').attr('style', function(i, s) { return (s || '') + '; background-color: #0B4E91 !important; color: #ffffff !important; font-weight: 700 !important;'; });
                }

                if (parseInt(aData[11]) == 1){
                    $(nRow).addClass('irl-row-orange');
                    $(nRow).find('td:not(:eq(1))').attr('style', function(i, s) { return (s || '') + '; background-color: #ed7c2f !important; color: #ffffff !important; font-weight: 700 !important;'; });
                }

                $(nRow).find('td:eq(1)').attr('style', function(i, s) { return (s || '') + '; color: #1e293b !important; background-color: #ffffff !important; font-weight: 600 !important;'; });

            },
            "bRetrieve": true,
            "bProcessing": true,
            "dom": 'lBfrtip',
            "sAjaxSource": "@Url.Content("~/IRL/GetIndice")",
                "buttons": [
                        { extend: 'copyHtml5', exportOptions: { columns: ':visible' } }
                    ,{ extend: 'excelHtml5', exportOptions: { columns: ':visible' } }
                    ,{ extend: 'csvHtml5', exportOptions: { columns: ':visible' } }
                    ,{ extend: 'print', exportOptions: { columns: ':visible' } }
                    ,'colvis'
                ],
                columnDefs: [
                    {
                        className: 'text-right', targets: [2, 3, 4, 5, 6, 7, 8, 9]
                    },
            ],
            "pageLength": -1,
                "order": [[ 0, "asc" ]],
            "lengthMenu": [[5,15, 25, 50, -1], [5,15, 25, 50, "Todos"]],
                "aoColumns": [
                    {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}
            ]
        });

        oTableRole = $("#tbIRLR").dataTable({
            "rowCallback": function( nRow, aData, iDisplayIndex, iDisplayIndexFull ) {
                $(nRow).find('td:eq(0)').addClass('hidden');
            },
            "bRetrieve": true,
            "bProcessing": true,
            "dom": 'lBfrtip',
            "sAjaxSource": "@Url.Content("~/IRL/GetIndiceResumen")",
                "buttons": [
                        { extend: 'copyHtml5', exportOptions: { columns: ':visible' } }
                    ,{ extend: 'excelHtml5', exportOptions: { columns: ':visible' } }
                    ,{ extend: 'csvHtml5', exportOptions: { columns: ':visible' } }
                    ,{ extend: 'print', exportOptions: { columns: ':visible' } }
                    ,'colvis'
                ],
                columnDefs: [
                    {
                        className: 'text-right', targets: [2, 3, 4, 5, 6, 7, 8, 9]
                    },
            ],
            "pageLength": -1,
                "order": [[ 0, "asc" ]],
            "lengthMenu": [[5,15, 25, 50, -1], [5,15, 25, 50, "Todos"]],
                "aoColumns": [
                    {}, {}, {}, {}, {}, {}, {}, {}, {}, {}
            ]
        });
    });

</script>