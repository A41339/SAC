@{
    ViewBag.Title = "&Iacute;ndice de Riesgo y Liquidez (IRL)";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content-header">
    <h1 class="modern-page-title">
        <i class="fa fa-tint" style="color: #0284c7;"></i>
        &Iacute;ndice de Riesgo y Liquidez (IRL)
        <small>C&aacute;lculo y evaluaci&oacute;n del indicador y brechas de liquidez</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="#">IRL</a></li>
        <li class="active">&Iacute;ndice IRL</li>
    </ol>
</section>

<section class="content">

    @Html.AntiForgeryToken()
    <div class="row">
        <div class="col-xs-12">
            <div class="modern-filter-card">
                <div class="modern-filter-toolbar">
                    <div class="filter-item">
                        <label for="IdEntidad"><i class="fa fa-university"></i> Entidad:</label>
                        @Html.DropDownList("Entidades", null, new { @id = "IdEntidad", @class = "form-control modern-select", style = "min-width: 220px;" })
                    </div>
                    <div class="filter-item">
                        <label for="Periodo"><i class="fa fa-calendar"></i> Per&iacute;odo:</label>
                        <div class="modern-input-wrapper" style="min-width: 140px;">
                            <input name="Periodo" id="Periodo" class="datecontrol form-control modern-date-input" value="@Session["Periodo2"]" style="width: 100%;" />
                        </div>
                    </div>
                    <div class="filter-item" style="margin-left: auto;">
                        <button type="button" class="btn-modern-filter" onclick="javascript:consultarIRL()">
                            <i class="fa fa-refresh"></i> Generar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-12">
            <section class="content">
                <div class="row">
                    <div id="tblIRLCuentas">
                    </div>
                </div>
            </section>
        </div>
    </div>
</section>
<div id="modalError" class="modal fade">
    <div class="modal-dialog modal-fail">
        <div class="modal-content">
            <div class="modal-header">
                <div class="icon-box">
                    <i class="material-icons"></i>
                </div>
            </div>
            <div class="modal-body">
                <div style="margin-left:50px; margin-right: 50px;">
                    <p id="lbl_mensajeError" class="text-center">Ha ocurrido un error.</p>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-danger btn-block" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">    
    function consultarIRL() {
        var entidad = $('#IdEntidad').val();
        var periodo = $('#Periodo').val();

        $.ajax({
            url: '@Url.Action("ValidarIRL", "IRL")',
            type: 'POST',
            cache: false,
            async: false,
            data: {
                'IdEntidad': entidad,
                'Periodo': periodo
            },
            success: function (data) {
                var resultado = data.resultado.exito;
                if (resultado == false) {
                    $("#lbl_mensajeError").html(data.resultado.mensaje);
                    $("#modalError").modal('show');
                }
                else {
                    actualizarIRL();
                }
            },
            error: function (result) {
                $("#modalError").modal('show');
            }
        });
    }

    function actualizarIRL() {

        var entidad = $('#IdEntidad').val();
        var periodo = $('#Periodo').val();
        var efectivo = $('#11100000').val();
        var bccr = $('#11200000').val();
        var ent_finan = $('#11300000').val();
        var ent_exterior = $('#11400000').val();
        var inv_bccr = $('#12201000').val();
        var inv_sp_no_finan = $('#12202000').val();
        var inv_ots_entidades = $('#12203000').val();

         $.ajax({
            url: '@Url.Action("ConsultarIRL", "IRL")',
            type: 'POST',
            cache: false,
            async: false,
            data: {
                'IdEntidad': entidad,
                'Periodo': periodo,
                'Efectivo': efectivo,
                'Bccr': bccr,
                'Ent_finan': ent_finan,
                'Ent_exterior': ent_exterior,
                'Inv_Bccr': inv_bccr,
                'Inv_sp_no_finan': inv_sp_no_finan,
                'Inv_Ots_Entidades': inv_ots_entidades
            },
            success: function (result) {
                $('#tblIRLCuentas').html(result);
            }
       });
    }
</script>