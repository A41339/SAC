@model FGA.Models.Noticia

@{
    ViewBag.Title = "Est&aacute; seguro de eliminar la noticia?";
    if (Ajax.IsThisAjaxRequest())
    {
        Layout = null;
    }
}

@Html.StarkAjaxFormSubmiter("frmNoticia", "tbNoticia", true, "Acci&oacute;n ejecutada con &eacute;xito")

@{
    if (!Ajax.IsThisAjaxRequest())
    {
        <section class="content-header">
    <h1>
        <i class="fa fa-trash"></i> Eliminar Noticia
        <small>Confirmaci&oacute;n de remoci&oacute;n de noticia del portal institucional.</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="#">Administraci&oacute;n</a></li>
        <li class="active">Eliminar Noticia</li>
    </ol>
</section>
    }
}

<section class="content">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        <div class="col-xs-12">

            <div class="box box-solid box-info">
                <div class="box-header">
                    <h3 class="box-title">Detalles</h3>
                </div><!-- /.box-header -->
                <div class="box-body table-responsive">

                    <div class="widget-sec">
                        <div class="streaming-table">
                            <table class="table table-striped table-bordered">
                                <tr>
                                    <td>Id</td>
                                    <td>@Html.DisplayFor(model => model.Id)</td>
                                </tr>
                                <tr>
                                    <td>Fecha</td>
                                    <td>@Html.DisplayFor(model => model.Fecha)</td>
                                </tr>
                                <tr>
                                    <td>Detalle</td>
                                    <td>@Html.Raw(Model.Detalle)</td>
                                </tr>
                                <tr>
                                    <td>Link</td>
                                    <td>@Html.Raw(Model.Link)</td>
                                </tr>
                                <tr>
                                    <td>Mostrar Fecha</td>
                                    <td>@Html.DisplayFor(model => model.Ind_Mostrar_Fecha)</td>
                                </tr>
                            </table>
                            <div class="box-footer">

                                @using (Html.BeginForm("Delete", "Noticia", FormMethod.Post, new { id = "frmNoticia" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.StarkInputButtion("Borrar", "submit", "btn btn-danger", "")
                                    @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-primary" })
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>



