@model FGA.Models.Noticia

@{
    ViewBag.Title = "Editar Noticia";
    if (Ajax.IsThisAjaxRequest())
    {
        Layout = null;
    }
}

@Html.StarkAjaxFormSubmiter("frmNoticia", "tbNoticia", true, "Acci&oacute;n ejecutada con &eacute;xito")

@{
    if (!Ajax.IsThisAjaxRequest())
    {
        <section class="content-header">
    <h1>
        <i class="fa fa-edit"></i> Editar Noticia
        <small>Actualizaci&oacute;n de contenido, fecha y visibilidad del comunicado.</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="@Url.Action("Index", "Modulo", new { modulo = "Noticia/Edit" })" class="breadcrumb-parent-pill"><i class="fa fa-wrench" style="margin-right: 4px;"></i> Mantenimientos</a></li>
        <li class="active">Editar Noticia</li>
    </ol>
</section>
    }
}

@using (Html.BeginForm("Edit", "Noticia", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmNoticia" }))
{
    @Html.AntiForgeryToken()

    <!-- Main content -->
    <section class="content">
        <div class="row">
            <div class="col-xs-12">
                <div class="box box-solid box-info">
                    <div role="form">
                        <div class="box-body">
                            <div class="hidden">
                                @Html.LabelFor(model => model.Id, new { @class = "" })
                                @Html.EditorFor(model => model.Id)
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.Fecha, new { @class = "" })
                                @*@Html.EditorFor(model => model.Fecha, new { @class = "datecontrol" })*@
                                <input name="Fecha" id="Fecha" class="datecontrol" value="@DateTime.Now.ToShortDateString()" />
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.Detalle, new { @class = "" })
                                @Html.EditorFor(model => model.Detalle)
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.Link, new { @class = "" })
                                @Html.EditorFor(model => model.Link)
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.Ind_Mostrar_Fecha, new { @class = "checkbox" })
                                @Html.EditorFor(model => model.Ind_Mostrar_Fecha, new { htmlAttributes = new { @class = "js-switch" } })
                            </div>
                        </div>
                    </div><!-- /.box-body -->
                    <div class="box-footer">
                        @Html.StarkInputButtion("Guardar", "submit", "btn btn-primary", "")
                        @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-primary" })
                    </div>
                </div>
            </div>
        </div>
    </section>
}
