    var urlGetHierarchy = '@Url.Action("GetHierarchy", "Menu")';
    var urlUpdateHierarchy = '@Url.Action("UpdateHierarchy", "Menu")';
    var initialSnapshot = null;
    var jerarquiaCargada = false;
    var todosColapsados = false;

    function cargarJerarquia(forzar) {
        if (!forzar && jerarquiaCargada) return;

        $('#treeLoading').show();
        $('#modulesSortableList').hide().empty();
        $('#unassignedContainer').hide();
        $('#unassignedList').empty();
        $('#lblCambiosContador').hide();
        $('#badgeCambiosHeader').hide();
        $('#btnGuardarJerarquia').prop('disabled', true)
            .removeClass('btn-success')
            .addClass('btn-default')
            .html('<i class="fa fa-check"></i> Sin cambios pendientes');

        window.onbeforeunload = null;

        $.ajax({
            url: urlGetHierarchy,
            type: 'GET',
            success: function (res) {
                $('#treeLoading').hide();
                if (res && res.success) {
                    var modulesList = $('#modulesSortableList');

                    if (res.modules && res.modules.length > 0) {
                        $.each(res.modules, function (idx, rootItem) {
                            var rootNode = renderizarNodo(rootItem, 0);
                            modulesList.append(rootNode);
                        });
                        modulesList.show();
                    }

                    // Elementos huÃ©rfanos reales (ParentId que no existe en BD)
                    if (res.unassigned && res.unassigned.length > 0) {
                        var unassignedUl = $('#unassignedList');
                        $.each(res.unassigned, function (uIdx, uItem) {
                            var uCard = renderizarNodo(uItem, 1);
                            unassignedUl.append(uCard);
                        });
                        $('#unassignedCountBadge').text(res.unassigned.length + ' opciones');
                        $('#unassignedContainer').show();
                    } else {
                        $('#unassignedContainer').hide();
                    }

                    iniciarSortables();

                    // Capturar snapshot inicial EXACTO del estado cargado
                    initialSnapshot = capturarSnapshot();
                    actualizarBadgesYEstado(false);
                    jerarquiaCargada = true;

                    // Si hay filtro activo en el buscador del Ã¡rbol, reaplicarlo
                    var q = $('#treeSearchInput').val();
                    if (q) {
                        filtrarArbol(q);
                    }
                } else {
                    alert(res.message || 'Error al cargar la jerarquÃ­a de menÃºs.');
                }
            },
            error: function (xhr, status, err) {
                $('#treeLoading').hide();
                alert('Error al consultar el servidor: ' + err);
            }
        });
    }

