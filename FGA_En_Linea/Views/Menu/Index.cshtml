                            <div style="display: flex; align-items: center; gap: 10px;">
                                <i class="fa fa-info-circle" style="font-size: 18px; color: #0284c7;"></i>
                                <span>
                                    <strong>Instrucciones:</strong> Arrastre los m&oacute;dulos usando <i class="fa fa-bars text-muted"></i> para cambiar su posici&oacute;n general en el men&uacute; lateral. Arrastre las opciones dentro del mismo m&oacute;dulo para ordenar su posici&oacute;n, o su&eacute;ltelas dentro de otro m&oacute;dulo para transferirlas. Haga clic en <strong>Guardar Cambios</strong> al finalizar.
                                </span>
                            </div>
                        </div>

                        <!-- Contenedor Loading Spinner -->
                        <div id="treeLoading" style="text-align: center; padding: 50px 20px; color: #64748b;">
                            <i class="fa fa-circle-o-notch fa-spin fa-2x" style="color: #0284c7;"></i>
                            <div style="margin-top: 12px; font-size: 14px; font-weight: 500;">Cargando estructura del men&uacute;...</div>
                        </div>

                        <!-- Lista de MÃ³dulos Principales (Sortable) -->
                        <div id="modulesSortableList" style="display: none;">
                            <!-- Generado dinÃ¡micamente -->
                        </div>

                        <!-- Contenedor de Opciones Sin MÃ³dulo Asignado (si existen) -->
                        <div id="unassignedContainer" style="display: none; margin-top: 24px;">
                            <div class="module-card" style="border-style: dashed; border-color: #f59e0b; background: #fffbeb;">
                                <div class="module-header" style="background: #fef3c7; border-bottom: 1px dashed #fde68a;">
                                    <div class="module-header-left">
                                        <h4 class="module-title" style="color: #92400e;">
                                            <i class="fa fa-exclamation-triangle" style="color: #d97706;"></i>
                                            Opciones Sin M&oacute;dulo Asignado (Hu&eacute;rfanas)
                                        </h4>
                                        <span class="module-count-badge" id="unassignedCountBadge" style="background: #fde68a; color: #92400e;">0 opciones</span>
                                    </div>
                                    <div class="module-header-right">
                                        <span style="font-size: 11.5px; color: #b45309;">Arrastre estas opciones hacia un m&oacute;dulo arriba</span>
                                    </div>
                                </div>
                                <ul class="menu-items-sortable" id="unassignedList" data-module-id="" style="background: #fffdf5;">
                                    <!-- Generado dinÃ¡micamente -->
                                </ul>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

<!-- Modal de EdiciÃ³n de OpciÃ³n de MenÃº -->
<div class="modal fade modal-menu-custom" id="modalEditarMenu" tabindex="-1" role="dialog" aria-labelledby="modalMenuLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="color: #ffffff; opacity: 0.8; font-size: 22px;">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title" id="modalMenuLabel">
                    <i class="fa fa-edit" style="color: #38bdf8;"></i>
                    Modificar Opci&oacute;n de Men&uacute;
                </h4>
            </div>
            
            <form id="frmEditarMenu">
                @Html.AntiForgeryToken()
                <input type="hidden" id="menuId" name="Id" />
                
                <div class="modal-body">
                    <div class="row">
                        <!-- Nombre de la opciÃ³n -->
                        <div class="col-md-7 col-xs-12">
                            <div class="form-group" style="margin-bottom: 18px;">
                                <label class="form-label-custom" for="menuText">
                                    Nombre de la Opci&oacute;n <span style="color: #ef4444;">*</span>:
                                </label>
                                <input type="text" id="menuText" name="MenuText" class="form-control-custom" required maxlength="100" />
                                <div class="helper-text">T&iacute;tulo visible en el men&uacute; lateral y en la cabecera de la ficha.</div>
                            </div>
                        </div>

                        <!-- MÃ³dulo Padre -->
                        <div class="col-md-5 col-xs-12">
                            <div class="form-group" style="margin-bottom: 18px;">
                                <label class="form-label-custom" for="menuParentId">
                                    M&oacute;dulo Padre:
                                </label>
                                <select id="menuParentId" name="ParentId" class="form-control-custom">
                                    <option value="">(Ninguno - M&oacute;dulo Principal / Ra&iacute;z)</option>
                                </select>
                                <div class="helper-text">Asigne un padre para volverlo subm&oacute;dulo, o elija &quot;(Ninguno)&quot; para m&oacute;dulo ra&iacute;z.</div>
                            </div>
                        </div>
                    </div>

                    <hr style="border-color: #f1f5f9; margin: 4px 0 18px 0;" />

                    <!-- Ãcono de la OpciÃ³n -->
                    <div class="form-group" style="margin-bottom: 20px;">
                        <label class="form-label-custom">
                            &Iacute;cono de la Ficha (FontAwesome):
                        </label>
                        <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 10px;">
                            <div class="icon-preview-lg" id="modalIconPreview">
                                <i class="fa fa-folder-open-o"></i>
                            </div>
                            <div style="flex: 1;">
                                <input type="text" id="menuIcon" name="MenuIcon" class="form-control-custom" placeholder="Ej: fa fa-file-text-o" />
                                <div class="helper-text" id="defaultIconNotice">
                                    Valor por defecto del sistema: <strong id="lblDefaultIcon" style="color: #0284c7;">fa fa-folder-open-o</strong>.
                                </div>
                            </div>
                            <button type="button" id="btnRestaurarIcono" class="btn btn-default btn-sm" style="border-radius: 8px; border: 1px solid #cbd5e1; white-space: nowrap;" title="Usar Ã­cono por defecto">
                                <i class="fa fa-undo"></i> Usar por defecto
                            </button>
                        </div>

                        <!-- Chips de Ãconos Comunes -->
                        <div style="margin-top: 8px;">
                            <span style="font-size: 11.5px; font-weight: 600; color: #64748b; margin-right: 6px;">Sugeridos:</span>
                            <div style="display: inline-flex; flex-wrap: wrap; gap: 6px; margin-top: 4px;">
                                <span class="icon-chip" onclick="seleccionarIcono('fa fa-file-text-o')"><i class="fa fa-file-text-o"></i> Ficha</span>
                                <span class="icon-chip" onclick="seleccionarIcono('fa fa-line-chart')"><i class="fa fa-line-chart"></i> Gr&aacute;fica</span>
                                <span class="icon-chip" onclick="seleccionarIcono('fa fa-database')"><i class="fa fa-database"></i> Datos</span>
                                <span class="icon-chip" onclick="seleccionarIcono('fa fa-percent')"><i class="fa fa-percent"></i> M&aacute;rgenes</span>
                                <span class="icon-chip" onclick="seleccionarIcono('fa fa-calculator')"><i class="fa fa-calculator"></i> C&aacute;lculo</span>
                                <span class="icon-chip" onclick="seleccionarIcono('fa fa-pie-chart')"><i class="fa fa-pie-chart"></i> Cartera</span>
                                <span class="icon-chip" onclick="seleccionarIcono('fa fa-shield')"><i class="fa fa-shield"></i> Seguridad</span>
                                <span class="icon-chip" onclick="seleccionarIcono('fa fa-users')"><i class="fa fa-users"></i> Usuarios</span>
                                <span class="icon-chip" onclick="seleccionarIcono('fa fa-building-o')"><i class="fa fa-building-o"></i> Entidad</span>
                                <span class="icon-chip" onclick="seleccionarIcono('fa fa-calendar')"><i class="fa fa-calendar"></i> Calendario</span>
                                <span class="icon-chip" onclick="seleccionarIcono('fa fa-sliders')"><i class="fa fa-sliders"></i> Ajustes</span>
                            </div>
                        </div>
                    </div>

                    <!-- DescripciÃ³n de la Ficha (Columna Description) -->
                    <div class="form-group" style="margin-bottom: 10px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                            <label class="form-label-custom" for="menuDescription" style="margin-bottom: 0;">
                                Descripci&oacute;n de la Ficha:
                            </label>
                            <button type="button" id="btnRestaurarDesc" class="btn btn-xs btn-default" style="border-radius: 6px; border: 1px solid #cbd5e1;" title="Borrar para usar texto por defecto">
                                <i class="fa fa-undo"></i> Usar por defecto
                            </button>
                        </div>
                        <textarea id="menuDescription" name="Description" class="form-control-custom" rows="3" maxlength="2000" placeholder="Ingrese el texto explicativo que se mostrarÃ¡ dentro de la tarjeta de la ficha..."></textarea>
                        
                        <div style="background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 8px; padding: 10px 14px; margin-top: 8px;">
                            <div style="font-size: 11.5px; font-weight: 600; color: #475569; margin-bottom: 2px;">
                                <i class="fa fa-info-circle" style="color: #0284c7;"></i> Descripci&oacute;n por defecto del cat&aacute;logo:
                            </div>
                            <div id="lblDefaultDesc" style="font-size: 12.5px; color: #64748b; font-style: italic;">
                                (Cargando...)
                            </div>
                            <div style="font-size: 11px; color: #94a3b8; margin-top: 4px;">
                                Si deja el campo de arriba vac&iacute;o, la ficha mostrar&aacute; autom&aacute;ticamente este texto por defecto.
                            </div>
                        </div>
                    </div>

                    <div id="alertModal" class="alert alert-danger" style="display: none; margin-top: 16px; border-radius: 8px;"></div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal" style="border-radius: 8px; font-weight: 600; padding: 8px 18px;">
                        Cancelar
                    </button>
                    <button type="submit" id="btnGuardarMenu" class="btn btn-primary" style="background: #0284c7; border-color: #0284c7; border-radius: 8px; font-weight: 600; padding: 8px 22px;">
                        <i class="fa fa-save"></i> Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script type="text/javascript">
    var tablaMenus = null;
    var defaultIconActual = "fa fa-folder-open-o";
    var defaultDescActual = "";

    function limpiarClaseIcono(raw) {
        if (!raw) return '';
        var str = String(raw).trim();
        // Si viene etiqueta HTML tipo <i class="..."></i> o <span class="...">
        var match = str.match(/class\s*=\s*["']([^"']+)["']/i);
        if (match && match[1]) {
            str = match[1].trim();
        } else {
            // Remover cualquier etiqueta HTML remanente
            str = str.replace(/<[^>]*>/g, '').trim();
        }
        if (!str) return '';
        if (!str.startsWith('fa ') && !str.startsWith('glyphicon ')) {
            if (str.startsWith('fa-')) {
                str = 'fa ' + str;
            } else {
                str = 'fa fa-' + str;
            }
        }
        return str;
    }

    function actualizarPreviewIcono(claseIcono) {
        var clean = limpiarClaseIcono(claseIcono);
        if (!clean) {
            clean = defaultIconActual;
        }
        $('#modalIconPreview').html('<i class="' + clean + '"></i>');
    }

    function seleccionarIcono(icono) {
        var clean = limpiarClaseIcono(icono);
        $('#menuIcon').val(clean);
        actualizarPreviewIcono(clean);
    }

    $(document).ready(function () {
        var urlGetGrid = '@Url.Action("GetGrid", "Menu")';
        var urlGetMenu = '@Url.Action("Get", "Menu")';
        var urlGetParents = '@Url.Action("GetParents", "Menu")';
        var urlSave = '@Url.Action("Save", "Menu")';

        // Cargar combo de MÃ³dulos Padres para filtro y modal
        $.ajax({
            url: urlGetParents,
            type: 'GET',
            success: function (res) {
                if (res && res.success && res.parents) {
                    var selectFiltro = $('#filtroPadre');
                    var selectModal = $('#menuParentId');
                    
                    $.each(res.parents, function (i, item) {
                        selectFiltro.append($('<option>', { value: item.nombre, text: item.nombre }));
                        selectModal.append($('<option>', { value: item.id, text: item.nombre }));
                    });
                }
            }
        });

        // Inicializar DataTable
        tablaMenus = $("#tbMenus").DataTable({
            "processing": true,
            "filter": true,
            "dom": 'Bfrtip',
            "lengthChange": false,
            "pageLength": 10,
            "ajax": {
                "url": urlGetGrid,
                "type": "POST",
                "datatype": "json"
            },
            "buttons": [
                { extend: 'copyHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'excelHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'pdfHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'print', exportOptions: { columns: ':visible' } },
                'colvis'
            ],
            "columns": [
                { 
                    "data": "id", 
                    "className": "text-center",
                    "render": function (data) {
                        return '<strong style="color: #64748b;">#' + data + '</strong>';
                    }
                },
                { 
                    "data": "parentName",
                    "render": function (data, type, row) {
                        if (type === 'filter' || type === 'sort') {
                            return row.parentId ? (data || '') : 'MÃ³dulo Principal';
                        }
                        if (!row.parentId) {
                            return '<span class="badge-modulo-principal"><i class="fa fa-sitemap"></i> M&oacute;dulo Principal</span>';
                        }
                        return '<span class="item-modulo-hijo"><i class="fa fa-folder-open-o"></i> ' + (data || '') + '</span>';
                    }
                },
                { 
                    "data": "menuText",
                    "render": function (data) {
                        return '<strong style="color: #0f2d4a; font-size: 13.5px;">' + (data || '') + '</strong>';
                    }
                },
                { 
                    "data": "menuIcon",
                    "className": "text-center",
                    "render": function (data, type, row) {
                        var iconClass = limpiarClaseIcono(data) || 'fa fa-folder-open-o';
                        if (type === 'filter' || type === 'sort') {
                            return iconClass;
                        }
                        var cleanLabel = iconClass.replace(/^fa\s+/, '').replace(/^fa-/, '');

                        return '<div style="display: flex; flex-direction: column; align-items: center; gap: 3px;">' +
                               '<div class="icon-preview-box" title="' + iconClass + '"><i class="' + iconClass + '"></i></div>' +
                               '<span style="font-size: 11px; color: #64748b; font-family: monospace;">' + cleanLabel + '</span>' +
                               '</div>';
                    }
                },
                { 
                    "data": "description",
                    "render": function (data, type, row) {
                        var badgeHtml = row.isCustomDesc 
                            ? '<span class="badge-custom" style="margin-bottom: 4px;"><i class="fa fa-star"></i> Personalizada</span>'
                            : '<span class="badge-default" style="margin-bottom: 4px;">Por defecto</span>';

                        var descText = data ? data : '<span style="color: #94a3b8; font-style: italic;">(Sin descripciÃ³n)</span>';

                        return '<div>' + badgeHtml + '<div style="font-size: 12px; line-height: 1.4; color: #334155; margin-top: 2px;">' + descText + '</div></div>';
                    }
                },
                {
                    "data": "id",
                    "className": "text-center",
                    "orderable": false,
                    "render": function (data) {
                        return '<button type="button" class="btn btn-sm btn-primary" onclick="abrirModalEditar(' + data + ')" style="background: #0071AD; border-color: #0071AD; border-radius: 6px; font-weight: 600; padding: 4px 10px;">' +
                               '<i class="fa fa-edit"></i> Modificar' +
                               '</button>';
                    }
                }
            ],
            "language": {
                "processing": "Cargando opciones de menÃº...",
                "search": "Buscar:",
                "info": "Mostrando _START_ a _END_ de _TOTAL_ opciones",
                "infoEmpty": "Mostrando 0 a 0 de 0 opciones",
                "infoFiltered": "(filtrado de _MAX_ totales)",
                "zeroRecords": "No se encontraron opciones coincidentes",
                "paginate": {
                    "first": "Primero",
                    "previous": "Anterior",
                    "next": "Siguiente",
                    "last": "Ãšltimo"
                }
            }
        });

        // Filtrado por MÃ³dulo Padre
        $('#filtroPadre').on('change', function () {
            var val = $(this).val();
            tablaMenus.column(1).search(val ? '^' + val + '$' : '', true, false).draw();
        });

        // Preview en vivo del Ã­cono al escribir en el input
        $('#menuIcon').on('input', function () {
            actualizarPreviewIcono($(this).val());
        });

        // BotÃ³n restaurar Ã­cono por defecto
        $('#btnRestaurarIcono').on('click', function () {
            $('#menuIcon').val('');
            actualizarPreviewIcono('');
        });

        // BotÃ³n restaurar descripciÃ³n por defecto
        $('#btnRestaurarDesc').on('click', function () {
            $('#menuDescription').val('');
        });

        // EnvÃ­o AJAX del formulario de ediciÃ³n
        $('#frmEditarMenu').on('submit', function (e) {
            e.preventDefault();
