    function filtrarArbol(texto) {
        var q = (texto || '').toLowerCase().trim();
        if (!q) {
            $('.module-card').show();
            $('.submodule-card-item').show();
            $('.menu-item-card').show();
            return;
        }

        $('#modulesSortableList > .module-card').each(function () {
            var modCard = $(this);
            var modTitle = modCard.find('.module-title').text().toLowerCase();
            var modMatches = modTitle.indexOf(q) !== -1;
            var anyChildMatches = false;

            modCard.find('.submodule-card-item').each(function () {
                var subCard = $(this);
                var subText = (subCard.data('text') || '').toLowerCase();
                var subMatches = modMatches || (subText.indexOf(q) !== -1);
                var anySubChildMatches = false;

                subCard.find('.menu-item-card').each(function () {
                    var itemCard = $(this);
                    var itemText = (itemCard.data('text') || '').toLowerCase();
                    var itemUrl = (itemCard.data('url') || '').toLowerCase();

                    if (subMatches || itemText.indexOf(q) !== -1 || itemUrl.indexOf(q) !== -1) {
                        itemCard.show();
                        anySubChildMatches = true;
                    } else {
                        itemCard.hide();
                    }
                });

                if (subMatches || anySubChildMatches) {
                    subCard.show();
                    subCard.find('.menu-items-sortable').slideDown(150);
                    subCard.find('.module-collapse-btn').removeClass('collapsed');
                    anyChildMatches = true;
                } else {
                    subCard.hide();
                }
            });

            modCard.find('> .menu-items-sortable > .menu-item-card').each(function () {
                var itemCard = $(this);
                var itemText = (itemCard.data('text') || '').toLowerCase();
                var itemUrl = (itemCard.data('url') || '').toLowerCase();

                if (modMatches || itemText.indexOf(q) !== -1 || itemUrl.indexOf(q) !== -1) {
                    itemCard.show();
                    anyChildMatches = true;
                } else {
                    itemCard.hide();
                }
            });

            if (modMatches || anyChildMatches) {
                modCard.show();
                modCard.find('> .menu-items-sortable').slideDown(150);
                modCard.find('> .module-header .module-collapse-btn').removeClass('collapsed');
            } else {
                modCard.hide();
            }
        });
    }

    // Abrir Modal de EdiciÃ³n
    function abrirModalEditar(id) {
        $('#alertModal').hide().text('');
        var urlGetMenu = '@Url.Action("Get", "Menu")/' + id;
        var urlGetParents = '@Url.Action("GetParents", "Menu")?excludeId=' + id;

        var selectModal = $('#menuParentId');
        selectModal.prop('disabled', true).empty().append($('<option>', { value: '', text: 'Cargando mÃ³dulos padres...' }));

        // 1. Cargar combo de mÃ³dulos padres vÃ¡lidos (excluyendo a sÃ­ mismo y a sus descendientes)
        $.ajax({
            url: urlGetParents,
            type: 'GET',
            success: function (pRes) {
                selectModal.empty();
                selectModal.append($('<option>', { value: '', text: '(Ninguno - MÃ³dulo Principal / RaÃ­z)' }));
                if (pRes && pRes.success && pRes.parents) {
                    $.each(pRes.parents, function (i, item) {
                        selectModal.append($('<option>', { value: item.id, text: item.nombre }));
                    });
                }
                selectModal.prop('disabled', false);

                // 2. Cargar datos de la opciÃ³n a editar
                $.ajax({
                    url: urlGetMenu,
                    type: 'GET',
                    success: function (res) {
                        if (res && res.success && res.menu) {
                            var m = res.menu;
                            $('#menuId').val(m.id);
                            $('#menuText').val(m.menuText);
                            $('#menuParentId').val(m.parentId || '');
                            $('#menuIcon').val(limpiarClaseIcono(m.menuIcon));
                            $('#menuDescription').val(m.description);

                            defaultIconActual = m.defaultIcon || 'fa fa-folder-open-o';
                            defaultDescActual = m.defaultDescription || '';

                            $('#lblDefaultIcon').text(defaultIconActual);
                            $('#lblDefaultDesc').text(defaultDescActual || '(No tiene descripciÃ³n por defecto)');

                            actualizarPreviewIcono(m.menuIcon);

                            $('#modalEditarMenu').modal('show');
                        } else {
                            alert(res.message || 'No fue posible consultar la opciÃ³n de menÃº.');
                        }
                    },
                    error: function () {
                        alert('Error al consultar datos de la opciÃ³n.');
                    }
                });
            },
            error: function () {
                selectModal.prop('disabled', false);
                alert('Error al consultar lista de mÃ³dulos padres.');
            }
        });
    }

    function mostrarToastExito(mensaje) {
        if (window.mostrarToast) {
            window.mostrarToast(mensaje, 'success');
        }
    }
</script>
