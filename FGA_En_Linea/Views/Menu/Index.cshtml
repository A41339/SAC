    function capturarSnapshot() {
        var snap = {
            contenedores: {},
            padres: {}
        };

        // MÃ³dulos raÃ­z
        var rootIds = [];
        $('#modulesSortableList > .module-card').each(function () {
            var id = parseInt($(this).data('id'));
            if (!isNaN(id)) {
                rootIds.push(id);
                snap.padres[id] = null;
            }
        });
        snap.contenedores['root'] = rootIds;

        // Listas hijas (.menu-items-sortable)
        $('.menu-items-sortable').each(function () {
            var parentModId = parseInt($(this).data('module-id'));
            var listIds = [];
            $(this).children('li').each(function () {
                var childId = parseInt($(this).data('id'));
                if (!isNaN(childId)) {
                    listIds.push(childId);
                    snap.padres[childId] = isNaN(parentModId) ? null : parentModId;
                }
            });
            snap.contenedores['mod_' + parentModId] = listIds;
        });

        return snap;
    }

    var itemsModificadosUsuario = {};

    function iniciarSortables() {
        // Reordenar mÃ³dulos principales entre sÃ­
        $('#modulesSortableList').sortable({
            handle: '.module-drag-handle',
            placeholder: 'module-sortable-placeholder',
            cursor: 'move',
            opacity: 0.92,
            tolerance: 'pointer',
            start: function (event, ui) {
                ui.item.data('prev-container', 'root');
                ui.item.data('prev-index', ui.item.index());
            },
            stop: function (event, ui) {
                var currIndex = ui.item.index();
                var prevIndex = ui.item.data('prev-index');
                var id = parseInt(ui.item.data('id'));
                if (!isNaN(id) && currIndex !== prevIndex) {
                    itemsModificadosUsuario[id] = true;
                }
                actualizarBadgesYEstado(true);
            }
        });

        // Reordenar y transferir opciones hijas y submÃ³dulos entre contenedores
        $('.menu-items-sortable').sortable({
            connectWith: '.menu-items-sortable',
            handle: '.item-drag-handle',
            placeholder: 'item-sortable-placeholder',
            cursor: 'move',
            opacity: 0.92,
            tolerance: 'pointer',
            start: function (event, ui) {
                var cont = ui.item.closest('.menu-items-sortable').data('module-id');
                ui.item.data('prev-container', cont);
                ui.item.data('prev-index', ui.item.index());
            },
            receive: function (event, ui) {
                var id = parseInt(ui.item.data('id'));
                if (!isNaN(id)) {
                    itemsModificadosUsuario[id] = true;
                }
                actualizarBadgesYEstado(true);
            },
            stop: function (event, ui) {
                var currCont = ui.item.closest('.menu-items-sortable').data('module-id');
                var prevCont = ui.item.data('prev-container');
                var currIndex = ui.item.index();
                var prevIndex = ui.item.data('prev-index');
                var id = parseInt(ui.item.data('id'));

                if (!isNaN(id)) {
                    if (currCont !== prevCont || currIndex !== prevIndex) {
                        itemsModificadosUsuario[id] = true;
                    }
                }
                actualizarBadgesYEstado(true);
            }
        });
    }

    function actualizarBadgesYEstado(evaluarCambios) {
        // 1. Actualizar nÃºmeros de orden secuenciales en la UI
        // MÃ³dulos raÃ­z
        $('#modulesSortableList > .module-card').each(function (idx) {
            var modId = parseInt($(this).data('id'));
            $('#modOrder_' + modId).text('Orden #' + (idx + 1));
        });

        // Listas hijas
        $('.menu-items-sortable').each(function () {
            var parentModId = parseInt($(this).data('module-id'));
            var children = $(this).children('li');
            $('#modCount_' + parentModId).text(children.length + ' opciones');

            children.each(function (idx) {
                var childId = parseInt($(this).data('id'));
                $('#itemOrder_' + childId).text('#' + (idx + 1));
                $('#modOrder_' + childId).text('#' + (idx + 1));
            });
        });

        // 2. Evaluar cambios respecto a initialSnapshot
        if (!evaluarCambios || !initialSnapshot) {
            itemsModificadosUsuario = {};
            $('#btnGuardarJerarquia').prop('disabled', true)
                .removeClass('btn-success')
                .addClass('btn-default')
                .html('<i class="fa fa-check"></i> Sin cambios pendientes');
            $('#lblCambiosContador').hide();
            $('#badgeCambiosHeader').hide();
            window.onbeforeunload = null;
            return;
        }

        var currentSnap = capturarSnapshot();
        var hayDiferencias = false;

        for (var idStr in currentSnap.padres) {
            var id = parseInt(idStr);
            var currParent = currentSnap.padres[id];
            var origParent = initialSnapshot.padres[id];

            if (currParent !== origParent) {
                hayDiferencias = true;
                break;
            } else {
                var contKey = (currParent === null || isNaN(currParent)) ? 'root' : ('mod_' + currParent);
                var currList = currentSnap.contenedores[contKey] || [];
                var origList = initialSnapshot.contenedores[contKey] || [];

                if (currList.indexOf(id) !== origList.indexOf(id)) {
                    hayDiferencias = true;
                    break;
                }
            }
        }

        var btnGuardar = $('#btnGuardarJerarquia');
        if (hayDiferencias) {
            var cantMovimientos = Object.keys(itemsModificadosUsuario).length;
            if (cantMovimientos === 0) {
                cantMovimientos = 1;
            }

            btnGuardar.prop('disabled', false)
                .removeClass('btn-default')
                .addClass('btn-success')
                .html('<i class="fa fa-save"></i> Guardar Cambios (' + cantMovimientos + ')');

            $('#lblCambiosContador').show();
            $('#cntCambios').text(cantMovimientos);
            $('#badgeCambiosHeader').text(cantMovimientos).show();

            window.onbeforeunload = function () {
                return "Tiene cambios sin guardar en la jerarquÃ­a del menÃº.";
            };
        } else {
            itemsModificadosUsuario = {};
            btnGuardar.prop('disabled', true)
                .removeClass('btn-success')
                .addClass('btn-default')
                .html('<i class="fa fa-check"></i> Sin cambios pendientes');

            $('#lblCambiosContador').hide();
            $('#badgeCambiosHeader').hide();
            window.onbeforeunload = null;
        }
    }

    function hayCambiosPendientes() {
        return !$('#btnGuardarJerarquia').prop('disabled');
    }

    function guardarJerarquia() {
        var listaFinal = [];

        // 1. MÃ³dulos raÃ­z
        $('#modulesSortableList > .module-card').each(function (modIndex) {
            var modId = parseInt($(this).data('id'));
            if (!isNaN(modId)) {
                listaFinal.push({
                    Id: modId,
                    ParentId: null,
                    SortOrder: modIndex + 1
                });
            }
        });

        // 2. Todos los hijos y submÃ³dulos en cualquier .menu-items-sortable
        $('.menu-items-sortable').each(function () {
            var parentModId = parseInt($(this).data('module-id'));
            if (!isNaN(parentModId)) {
                $(this).children('li').each(function (childIndex) {
                    var childId = parseInt($(this).data('id'));
                    if (!isNaN(childId)) {
                        listaFinal.push({
                            Id: childId,
                            ParentId: parentModId,
                            SortOrder: childIndex + 1
                        });
                    }
                });
            }
        });

        if (listaFinal.length === 0) {
            alert('No se encontraron elementos de menÃº para guardar.');
            return;
        }

        var btn = $('#btnGuardarJerarquia');
        btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Guardando...');

        $.ajax({
            url: urlUpdateHierarchy,
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify(listaFinal),
            success: function (res) {
                if (res && res.success) {
                    window.onbeforeunload = null;
                    mostrarToastExito(res.message || 'JerarquÃ­a actualizada exitosamente.');
                    tablaMenus.ajax.reload(null, false);
                    cargarJerarquia(true);
                } else {
                    btn.prop('disabled', false).html('<i class="fa fa-save"></i> Guardar Cambios');
                    alert(res.message || 'OcurriÃ³ un error al guardar la jerarquÃ­a.');
                }
            },
            error: function (xhr, status, err) {
                btn.prop('disabled', false).html('<i class="fa fa-save"></i> Guardar Cambios');
                alert('Error de comunicaciÃ³n con el servidor: ' + err);
            }
        });
    }

