                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>

                    <!-- PESTAÃ‘A 2: ORGANIZADOR VISUAL (DRAG & DROP) -->
                    <div role="tabpanel" class="tab-pane" id="tabOrganizador">
                        <!-- Barra Superior de Acciones -->
                        <div class="tree-actions-bar">
                            <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                                <div style="position: relative; width: 260px;">
                                    <i class="fa fa-search" style="position: absolute; left: 14px; top: 11px; color: #94a3b8; font-size: 13px; pointer-events: none; z-index: 5;"></i>
                                    <input type="text" id="treeSearchInput" class="form-control" placeholder="Buscar en el &aacute;rbol..." style="padding-left: 38px !important; border-radius: 8px; height: 36px; font-size: 13px; border: 1px solid #cbd5e1;" />
                                </div>
                                <button type="button" id="btnToggleCollapseAll" class="btn btn-default" style="border-radius: 8px; font-size: 13px; border: 1px solid #cbd5e1; height: 36px;">
                                    <i class="fa fa-compress"></i> Colapsar Todo
                                </button>
                                <button type="button" id="btnRecargarArbol" class="btn btn-default" style="border-radius: 8px; font-size: 13px; border: 1px solid #cbd5e1; height: 36px;" title="Restablecer cambios no guardados">
                                    <i class="fa fa-refresh"></i> Restablecer
