                            <label for="IdEntidad"><i class="fa fa-university"></i> Entidad:</label>
                            @Html.DropDownList("Entidades", null, new { @id = "IdEntidad", @class = "form-control modern-select", style = "min-width: 220px;" })
                        </div>
                        <div class="filter-item">
                            <label for="Opcion"><i class="fa fa-money"></i> Opci&oacute;n:</label>
                            @Html.DropDownList("Opcion", new List<SelectListItem> {  new SelectListItem { Value = "0", Text = "CONSOLIDADA" },
                                                                                    new SelectListItem { Value = "1", Text = "COLONES" },
                                                                                    new SelectListItem { Value = "2", Text = "DOLARES" },
                                                                                 }, new { @id = "Opcion", @class = "form-control modern-select", style = "min-width: 170px;" })
