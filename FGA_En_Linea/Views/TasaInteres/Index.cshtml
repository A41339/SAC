<script type="text/javascript">

    function getFilterSubtitle() {
        var entText = $("#IdEntidad :selected").text() || '';
        var opcText = $("#Opcion :selected").text() || '';
        var pIni = $("#PeriodoI").val() || '';
        var pFin = $("#PeriodoF").val() || '';
        var subText = entText;
        if (opcText) {
            subText += " • " + opcText;
        }
        if (pIni && pFin) {
            subText += " (" + pIni + " - " + pFin + ")";
        }
        return subText;
    }

