@model FGA.Model.Modelo_Tasas

@{
    ViewBag.Title = "Tasas de Interés";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content-header">
    <h1 class="modern-page-title">
        <i class="fa fa-percent" style="color: #0284c7;"></i>
        Tasas de Inter&eacute;s
        <small>Diferencial de tasas, tasa activa, pasiva y ponderada</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="@Url.Action("Index", "Modulo", new { id = 2000 })" class="breadcrumb-parent-pill" title="Volver a Proyecciones"><i class="fa fa-percent" style="margin-right: 4px;"></i> Proyecciones</a></li>
        <li class="active">Tasas de Inter&eacute;s</li>
    </ol>
</section>

