    // Reflow charts al cambiar pestañas
    $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
        if (typeof Highcharts !== 'undefined' && Highcharts.charts) {
            Highcharts.charts.forEach(function (chart) {
                if (chart && chart.renderTo) {
                    try { chart.reflow(); } catch (err) {}
                }
            });
        }
    });

    // Helper general para renderizar el header de detalle / KPI strip en los modales
    function renderKpiStripForModal(modalId, kpiContainerId, selectElementId) {
        if (typeof Highcharts === 'undefined' || !Highcharts.charts) return;

        var modalCharts = Highcharts.charts.filter(function (c) {
            return c && c.renderTo && $(c.renderTo).closest(modalId).length && c.series && c.series.length > 0;
        });

        if (modalCharts.length === 0) return;
        var chart = modalCharts[0];

        function renderKpi(selectedIdx) {
            var seriesIdx = 0;
            if (typeof selectedIdx === 'number' && selectedIdx >= 0 && selectedIdx < chart.series.length) {
                seriesIdx = selectedIdx;
            } else {
                for (var k = 0; k < chart.series.length; k++) {
                    if (chart.series[k].type === 'spline' || chart.series[k].type === 'line' || chart.series[k].type === 'areaspline') {
                        seriesIdx = k;
                        break;
                    }
                }
            }

            var s = chart.series[seriesIdx];
            if (!s || !s.data || s.data.length === 0) {
                for (var k = 0; k < chart.series.length; k++) {
                    if (chart.series[k] && chart.series[k].data && chart.series[k].data.length > 0) {
                        seriesIdx = k;
                        s = chart.series[k];
                        break;
                    }
                }
            }
            if (!s || !s.data || s.data.length === 0) return;

            var cats = (chart.xAxis && chart.xAxis[0] && chart.xAxis[0].categories) ? chart.xAxis[0].categories : [];
            var rawData = s.data.map(function (pt) {
                if (!pt) return 0;
                if (typeof pt.y === 'number') return pt.y;
                if (Array.isArray(pt) && typeof pt[1] === 'number') return pt[1];
                return parseFloat(pt.y) || 0;
            });

            if (rawData.length === 0) return;

            var p1Label = cats && cats.length > 0 ? cats[0] : 'Inicial';
            var p2Label = cats && cats.length > 0 ? cats[cats.length - 1] : 'Final';
            var v1 = rawData[0];
            var v2 = rawData[rawData.length - 1];
            var diff = v2 - v1;
            var sum = rawData.reduce(function (a, b) { return a + b; }, 0);
            var avg = sum / rawData.length;
            var minVal = Math.min.apply(null, rawData);
            var maxVal = Math.max.apply(null, rawData);

            // En tasas de interés todas las series representan porcentajes
            var isPct = true;
            var suf = ' %';

            var isPos = diff >= 0;
            var badgeBg = isPos ? 'background-color: #dbeafe; color: #1e40af;' : 'background-color: #ffedd5; color: #c2410c;';
            var sign = isPos ? '+' : '';

            var formatNum = function (n) {
                return (typeof n === 'number') ? n.toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : n;
            };

            var diffFormatted = sign + formatNum(diff) + ' p.p.';

            var selectorHtml = '';
            if (chart.series.length > 1) {
                selectorHtml =
                    '<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; flex-wrap: wrap; gap: 8px;">' +
                    '    <div style="font-size: 12.5px; font-weight: 700; color: #1e3a8a; display: flex; align-items: center; gap: 6px;">' +
                    '        <i class="fa fa-sliders" style="color: #2F5597;"></i> Indicadores de la serie:' +
                    '    </div>' +
                    '    <div>' +
                    '        <select id="' + selectElementId + '" class="form-control" style="height: 28px; font-size: 12px; font-weight: 600; padding: 2px 8px; border-radius: 6px; border: 1px solid #cbd5e1; color: #1e3a8a; background: #ffffff; min-width: 240px;">';

                for (var idx = 0; idx < chart.series.length; idx++) {
                    var ser = chart.series[idx];
                    var isSelected = (idx === seriesIdx) ? ' selected' : '';
                    selectorHtml += '<option value="' + idx + '"' + isSelected + '>● ' + (ser.name || ('Serie ' + (idx + 1))) + '</option>';
                }

                selectorHtml +=
                    '        </select>' +
                    '    </div>' +
                    '</div>';
            }

            var stripHtml = selectorHtml +
                '<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 7px 14px;">' +
                '    <div>' +
                '        <span style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 600; display: block; line-height: 1.2;">Período Inicial (' + p1Label + ')</span>' +
                '        <span style="font-size: 14.5px; font-weight: 700; color: #1e3a8a;">' + formatNum(v1) + suf + '</span>' +
                '    </div>' +
                '    <div style="border-left: 1px solid #cbd5e1; padding-left: 14px;">' +
                '        <span style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 600; display: block; line-height: 1.2;">Período Final (' + p2Label + ')</span>' +
                '        <span style="font-size: 14.5px; font-weight: 700; color: #0f172a;">' + formatNum(v2) + suf + '</span>' +
                '    </div>' +
                '    <div style="border-left: 1px solid #cbd5e1; padding-left: 14px;">' +
                '        <span style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 600; display: block; line-height: 1.2;">Variación</span>' +
                '        <span class="badge" style="' + badgeBg + ' font-size: 11.5px; font-weight: 700; padding: 3px 8px; border-radius: 6px;">' +
                '            ' + diffFormatted +
                '        </span>' +
                '    </div>' +
                '    <div style="border-left: 1px solid #cbd5e1; padding-left: 14px;">' +
                '        <span style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 600; display: block; line-height: 1.2;">Promedio</span>' +
                '        <span style="font-size: 14.5px; font-weight: 700; color: #334155;">' + formatNum(avg) + suf + '</span>' +
                '    </div>' +
                '    <div style="border-left: 1px solid #cbd5e1; padding-left: 14px;">' +
                '        <span style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 600; display: block; line-height: 1.2;">Mín / Máx</span>' +
                '        <span style="font-size: 13px; font-weight: 600; color: #475569;">' +
                '            ' + formatNum(minVal) + suf + ' / ' + formatNum(maxVal) + suf +
                '        </span>' +
                '    </div>' +
                '</div>';

            $(kpiContainerId).html(stripHtml);

            $('#' + selectElementId).off('change').on('change', function () {
                var newIdx = parseInt($(this).val(), 10);
                renderKpi(newIdx);
            });
        }

        renderKpi();
    }

    // Modal Diferencial de Tasas
    $('#mDiferencialTasas').on('shown.bs.modal', function () {
