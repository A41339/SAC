@model FGA.Models.TipoInforme

@{
    ViewBag.Title = "Consultar un tipo de informe";
    if (Ajax.IsThisAjaxRequest())
    {
        Layout = null;
    }
}
<section class="content-header">
    <h1>
        <i class="fa fa-info-circle"></i> Consultar Tipo de Informe
        <small>Detalles de configuraci&oacute;n y salida del tipo de informe institucional.</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="@Url.Action("Index", "Modulo", new { modulo = "TipoInforme/Details" })" class="breadcrumb-parent-pill"><i class="fa fa-wrench" style="margin-right: 4px;"></i> Mantenimientos</a></li>
        <li class="active">Consultar Tipo Informe</li>
    </ol>
</section>
<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div class="box box-solid box-info">
                <div class="box-header">
                    <h3 class="box-title">Detalles</h3>
                </div>
                <div class="box-body table-responsive">
                    <div class="widget-sec">
                        <div class="streaming-table">
                            <table class="table table-striped table-bordered">
                                <tr>
                                    <td></td>
                                    <td>@Html.DisplayFor(model => model.Id)</td>
                                </tr>
                                <tr>
                                    <td>Nombre</td>
                                    <td>@Html.DisplayFor(model => model.Nombre)</td>
                                </tr>
                                <tr>
                                    <td>F&oacute;rmula</td>
                                    <td>@Html.Raw(Model.Texto)</td>
                                </tr>
                            </table>
                            <div class="box-footer">
                                @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-primary" })
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>