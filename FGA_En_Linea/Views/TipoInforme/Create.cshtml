@model FGA.Models.TipoInforme
@{
    ViewBag.Title = "Crear";
    if (Ajax.IsThisAjaxRequest())
    {
        Layout = null;
    }
}

@Html.StarkAjaxFormSubmiter("frmTipoInforme", "tbTipoInforme", true, "Acci&oacute;n ejecutada con &eacute;xito")
@{
    if (!Ajax.IsThisAjaxRequest())
    {
        <section class="content-header">
    <h1>
        <i class="fa fa-plus-circle"></i> Creaci&oacute;n de Tipo de Informe
        <small>Definici&oacute;n de nueva plantilla y par&aacute;metros de generaci&oacute;n de informe.</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="@Url.Action("Index", "Modulo", new { modulo = "TipoInforme/Create" })" class="breadcrumb-parent-pill"><i class="fa fa-wrench" style="margin-right: 4px;"></i> Mantenimientos</a></li>
        <li class="active">Crear Tipo Informe</li>
    </ol>
</section>
    }
}

@using (Html.BeginForm("Create", "TipoInforme", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmTipoInforme" }))
{
    @Html.AntiForgeryToken()
    <!-- Main content -->
    <section class="content">
        <!-- Small boxes(Stat box) -->
        <div class="row">
            <div class="col-xs-12">
                <div class="box box-solid box-info">
                    <div role="form">
                        <div class="box-body">
                            <div class="form-group">
                                @Html.LabelFor(model => model.Nombre, new { @class = "" })
                                @Html.EditorFor(model => model.Nombre)
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.Texto, new { @class = "" })
                                @Html.TextAreaFor(model => model.Texto, new { @id = "Texto", @class = "form-control", rows = 8, @style = "min-height: 200px; height: 200px; resize: vertical;" })

                            </div>
                            <div class="box-footer">
                                @Html.StarkInputButtion("Guardar", "submit", "btn btn-primary", "")
                                @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-primary" })
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

@section ScriptsOrCss
{
    <script src="~/Content/theme/plugins/bootstrap-wysihtml5/bootstrap3-wysihtml5.all.min.js"></script>
}

<script type="text/javascript">
    
    $(function () {
        $("#Texto").wysihtml5();
    });

</script>