@model FGA.Models.TipoInforme

@{
    ViewBag.Title = "Editar un tipo de informe";
    if (Ajax.IsThisAjaxRequest())
    {
        Layout = null;
    }
}

@Html.StarkAjaxFormSubmiter("frmTipoInforme", "tbTipoInforme", true, "Acción ejecutada con éxito")

@{
    if (!Ajax.IsThisAjaxRequest())
    {
        <section class="content-header">
            <h1>
                Editar un tipo de informe
            </h1>
        </section>
    }
}

@using (Html.BeginForm("Edit", "TipoInforme", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmTipoInforme" }))
{
    @Html.AntiForgeryToken()

    <!-- Main content -->
    <section class="content">
        <div class="row">
            <div class="col-xs-12">
                <div class="box box-solid box-info">
                    <div role="form">
                        <div class="box-body">
                            <div class="form-group">
                                @Html.HiddenFor(model => model.Id, new { @class = "" })
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.Nombre, new { @class = "" })
                                @Html.EditorFor(model => model.Nombre)
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.Texto, new { @class = "" })
                                @Html.TextAreaFor(model => model.Texto, new { @id = "Texto", @class = "form-control", @style = "height: 200px;" })
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.Estado, new { @class = "checkbox" })
                                @Html.EditorFor(model => model.Estado, new { htmlAttributes = new { @class = "js-switch" } })
                            </div>
                        </div>
                    </div><!-- /.box-body -->
                    <div class="box-footer">
                        @Html.StarkInputButtion("Guardar", "submit", "btn btn-primary", "")
                        @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-primary" })
                    </div>
                </div>
            </div>
        </div>
    </section>

}

@section ScriptsOrCss
{
    <script src="~/Content/theme/plugins/bootstrap-wysihtml5/bootstrap3-wysihtml5.all.min.js"></script>
}

<script type="text/javascript">

    $(function () {
        $("#Texto").wysihtml5();
    });

</script>