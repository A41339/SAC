@model IEnumerable<FGA.Models.BCCR_Indicadores>

@{
    ViewBag.Title = "Indicadores Econ&oacute;micos";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var itemsList = new List<FGA.Models.BCCR_Indicadores>();
    bool isPorcentaje = false;
    decimal? ultimoValor = null;
    string ultimaFecha = "";
    decimal? maxValor = null;
    decimal? minValor = null;

    if (Model != null)
    {
        var desde = DateTime.Now.AddYears(-3);
        itemsList = Model
            .Where(item => item.Fecha.HasValue && item.Monto.HasValue && item.Fecha.Value >= desde)
            .OrderBy(item => item.Fecha.Value)
            .ToList();

        if (itemsList.Any())
        {
            var last = itemsList.Last();
            ultimoValor = last.Monto;
            ultimaFecha = last.Fecha.Value.ToString("MMMM yyyy");
            maxValor = itemsList.Max(x => x.Monto);
            minValor = itemsList.Min(x => x.Monto);
            if (last.TipoIndicador != null && last.TipoIndicador.Ind_Porcentaje == "S")
            {
                isPorcentaje = true;
            }
        }
    }
}

<section class="content-header" style="padding: 24px 20px 14px 20px;">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
        <div>
            <h1 style="margin: 0; font-size: 21px; font-weight: 700; color: #143750; display: flex; align-items: center; gap: 10px;">
                <i class="fa fa-line-chart" style="color: #0284c7;"></i>
                Indicadores Econ&oacute;micos del BCCR
            </h1>
            <p style="margin: 6px 0 0 0; font-size: 13px; color: #64748b;">
                Consulte la serie hist&oacute;rica y evoluci&oacute;n de los principales indicadores macroecon&oacute;micos.
            </p>
        </div>
    </div>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="@Url.Action("Index", "Modulo", new { modulo = "IndEconomico/Index" })" class="breadcrumb-parent-pill"><i class="fa fa-file-text-o" style="margin-right: 4px;"></i> InformaciÃ³n Financiera</a></li>
        <li class="active">Indicadores Econ&oacute;micos</li>
    </ol>
</section>

<section class="content">

    @using (Html.BeginForm("Buscar", "IndEconomico", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmIndEconomico" }))
    {
        @Html.AntiForgeryToken()
        <div class="row">
            <div class="col-xs-12">
                <div class="modern-filter-card" style="margin-bottom: 22px;">
                    <div class="modern-filter-toolbar">
                        <div class="filter-item">
                            <label for="Id"><i class="fa fa-tag"></i> Indicador:</label>
                            @Html.DropDownList("Indicadores", null, new { @id = "Id", @class = "form-control modern-select", style = "min-width: 340px; height: 38px; font-size: 13px;" })
                        </div>
                        <div class="filter-item" style="margin-left: auto;">
                            <button type="submit" name="submit" class="btn-modern-filter" style="height: 38px; padding: 0 24px;">
                                <i class="fa fa-search"></i> Consultar indicador
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (Session["Indicador"] == null)
    {
        <!-- Vista General: Tabla de &Uacute;ltimos Valores Registrados -->
        <div class="row">
            <div class="col-xs-12">
                <div class="modern-table-card" style="border: 1px solid #e2e8f0; border-radius: 12px; background: #ffffff; box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05); overflow: hidden; padding: 20px 22px; margin-bottom: 24px;">
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; flex-wrap: wrap; gap: 10px;">
                        <div>
                            <h4 style="margin: 0; font-size: 15px; font-weight: 700; color: #143750; display: flex; align-items: center; gap: 7px;">
                                <i class="fa fa-list-alt" style="color: #0284c7;"></i>
                                &Uacute;ltimos valores registrados por indicador
                            </h4>
                            <p style="margin: 3px 0 0 0; font-size: 12px; color: #64748b;">
                                Resumen actualizado de todos los indicadores econ&oacute;micos disponibles
                            </p>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table id="tbUltimos" class="table modern-data-table" style="width: 100%;">
                            <thead>
                                <tr>
                                    <th style="padding: 12px 14px; font-size: 12px; font-weight: 700; color: #475569; text-transform: uppercase;">Indicador</th>
                                    <th style="padding: 12px 14px; font-size: 12px; font-weight: 700; color: #475569; text-transform: uppercase; width: 140px; text-align: center;">Fecha</th>
                                    <th style="padding: 12px 14px; font-size: 12px; font-weight: 700; color: #475569; text-transform: uppercase; width: 160px; text-align: right;">Valor</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Vista de Detalle: Gr&aacute;fico Highcharts + Tabla Hist&oacute;rica -->
        <div class="row">
            <!-- Columna Izquierda: Gr&aacute;fico Moderno Highcharts -->
            <div class="col-md-8 col-sm-12" style="margin-bottom: 20px;">
                <div class="modern-table-card" style="border: 1px solid #e2e8f0; border-radius: 12px; background: #ffffff; box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05); overflow: hidden; padding: 22px;">
                    
                    <div style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 16px; flex-wrap: wrap; gap: 12px;">
                        <div>
                            <h4 id="chartTitle" style="margin: 0; font-size: 15px; font-weight: 700; color: #143750; display: flex; align-items: center; gap: 7px;">
                                <i class="fa fa-area-chart" style="color: #0284c7;"></i>
                                Evoluci&oacute;n mensual del indicador
                            </h4>
                            <p id="chartSubtitle" style="margin: 3px 0 0 0; font-size: 12px; color: #64748b;">
                                Serie hist&oacute;rica de los &Uacute;ltimos 3 a&ntilde;os
                            </p>
                        </div>

                        @if (ultimoValor.HasValue)
                        {
                            <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                                <div style="background: #f0f9ff; border: 1px solid #bae6fd; border-radius: 8px; padding: 6px 12px; text-align: right;">
                                    <span style="font-size: 10px; color: #0284c7; font-weight: 700; text-transform: uppercase; display: block;">&Uacute;ltimo registro</span>
                                    <span style="font-size: 15px; font-weight: 700; color: #143750;">
                                        @ultimoValor.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)@(isPorcentaje ? "%" : "")
                                    </span>
                                </div>

                                @if (maxValor.HasValue && minValor.HasValue)
                                {
                                    <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 6px 12px; text-align: right;">
                                        <span style="font-size: 10px; color: #64748b; font-weight: 700; text-transform: uppercase; display: block;">Rango (M&iacute;n / M&aacute;x)</span>
                                        <span style="font-size: 12px; font-weight: 600; color: #334155;">
                                            @minValor.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) - @maxValor.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)@(isPorcentaje ? "%" : "")
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- Contenedor del gr&aacute;fico Highcharts -->
                    <div id="chartContainer" style="width: 100%; height: 380px;"></div>
                </div>
            </div>

            <!-- Columna Derecha: Tabla Hist&oacute;rica de Valores -->
            <div class="col-md-4 col-sm-12" style="margin-bottom: 20px;">
                <div class="modern-table-card" style="border: 1px solid #e2e8f0; border-radius: 12px; background: #ffffff; box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05); overflow: hidden; padding: 22px;">
                    
                    <div style="margin-bottom: 16px;">
                        <h4 style="margin: 0; font-size: 15px; font-weight: 700; color: #143750; display: flex; align-items: center; gap: 7px;">
                            <i class="fa fa-history" style="color: #0284c7;"></i>
                            Hist&oacute;rico de registros
                        </h4>
                        <p style="margin: 3px 0 0 0; font-size: 12px; color: #64748b;">
                            Valores mensuales ordenados cronol&oacute;gicamente
                        </p>
                    </div>

                    <div class="table-responsive">
                        <table id="tbError" class="table modern-data-table" style="width: 100%;">
                            <thead>
                                <tr>
                                    <th style="padding: 10px 12px; font-size: 12px; font-weight: 700; color: #475569; text-transform: uppercase;">Fecha</th>
                                    <th style="padding: 10px 12px; font-size: 12px; font-weight: 700; color: #475569; text-transform: uppercase; text-align: right;">Valor</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
</section>

<script type="text/javascript">

    $(document).ready(function () {

        // Inicializacion de DataTable Hist&oacute;rico (col-md-4)
        if ($("#tbError").length) {
            $("#tbError").dataTable({
                "bRetrieve": true,
                "bProcessing": true,
                "dom": '<"row"<"col-sm-6"l><"col-sm-6"f>>rt<"row"<"col-sm-6"i><"col-sm-6"p>>',
                "bSort": false,
                "sAjaxSource": "@Url.Content("~/IndEconomico/GetGrid")",
                "columnDefs": [
                    { className: 'text-right font-weight-bold', targets: [1] }
                ],
                "pageLength": 12,
                "lengthMenu": [[6, 12, 24, -1], [6, 12, 24, "Todos"]],
                "language": {
                    "sSearch": "Buscar:",
                    "sZeroRecords": "Sin registros",
                    "sInfo": "_START_ a _END_ de _TOTAL_",
                    "sInfoEmpty": "0 registros",
                    "oPaginate": { "sPrevious": "&laquo;", "sNext": "&raquo;" }
                },
                "aoColumns": [ {}, {} ]
            });
        }

        // Inicializacion de DataTable General (&Uacute;ltimos registros)
        if ($("#tbUltimos").length) {
            $("#tbUltimos").dataTable({
                "bRetrieve": true,
                "bProcessing": true,
                "dom": '<"row"<"col-sm-6"l><"col-sm-6"f>>rt<"row"<"col-sm-6"i><"col-sm-6"p>>',
                "bSort": false,
                "sAjaxSource": "@Url.Content("~/IndEconomico/GetUltimos")",
                "columnDefs": [
                    { className: 'text-center', targets: [1] },
                    { className: 'text-right font-weight-bold', targets: [2] }
                ],
                "pageLength": 15,
                "lengthMenu": [[10, 15, 25, 50, -1], [10, 15, 25, 50, "Todos"]],
                "language": {
                    "sSearch": "Buscar:",
                    "sZeroRecords": "No se encontraron indicadores",
                    "sInfo": "Mostrando _START_ a _END_ de _TOTAL_ indicadores",
                    "sInfoEmpty": "Mostrando 0 indicadores",
                    "oPaginate": { "sPrevious": "&laquo;", "sNext": "&raquo;" }
                },
                "aoColumns": [ {}, {}, {} ]
            });
        }

        // Renderizado del Gr&aacute;fico Highcharts
        @if (Session["Indicador"] != null && itemsList.Any())
        {
            <text>
            var nomIndicador = $('#Id :selected').text();
            $('#chartTitle').html('<i class="fa fa-area-chart" style="color: #0284c7;"></i> ' + nomIndicador);

            var categories = [
                @foreach (var item in itemsList)
                {
                    <text>'@item.Fecha.Value.ToString("MM-yy")',</text>
                }
            ];

            var dataSeries = [
                @foreach (var item in itemsList)
                {
                    <text>@item.Monto.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture),</text>
                }
            ];

            Highcharts.chart('chartContainer', {
                chart: {
                    type: 'areaspline',
                    backgroundColor: '#ffffff',
                    spacingTop: 20,
                    spacingBottom: 15,
                    spacingLeft: 10,
                    spacingRight: 15
                },
                title: {
                    text: null
                },
                credits: {
                    enabled: false
                },
                xAxis: {
                    categories: categories,
                    crosshair: {
                        width: 1,
                        color: '#cbd5e1',
                        dashStyle: 'Dash'
                    },
                    labels: {
                        style: {
                            color: '#64748b',
                            fontSize: '11px',
                            fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif'
                        },
                        step: Math.max(1, Math.ceil(categories.length / 12))
                    },
                    lineColor: '#e2e8f0',
                    tickColor: '#e2e8f0'
                },
                yAxis: {
                    title: {
                        text: null
                    },
                    gridLineColor: '#f1f5f9',
                    labels: {
                        style: {
                            color: '#64748b',
                            fontSize: '11px',
                            fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif'
                        },
                        formatter: function () {
                            return Highcharts.numberFormat(this.value, 2, ',', '.') + '@(isPorcentaje ? "%" : "")';
                        }
                    }
                },
                legend: {
                    enabled: false
                },
                tooltip: {
                    shared: true,
                    useHTML: true,
                    headerFormat: '<div style="font-size:11px; color:#64748b; font-weight:600; margin-bottom:4px;">{point.key}</div>',
                    pointFormat: '<div style="display:flex; align-items:center; gap:6px;"><span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#1d6fa4;"></span><span style="color:#1e293b; font-size:12px;">' + nomIndicador + ':</span> <strong style="color:#1d6fa4; font-size:13px;">{point.y:,.2f}@(isPorcentaje ? "%" : "")</strong></div>',
                    backgroundColor: '#ffffff',
                    borderColor: '#e2e8f0',
                    borderRadius: 8,
                    shadow: {
                        color: 'rgba(0,0,0,0.06)',
                        offsetX: 0,
                        offsetY: 4,
                        opacity: 0.1,
                        width: 8
                    }
                },
                plotOptions: {
                    areaspline: {
                        color: '#1d6fa4',
                        fillColor: {
                            linearGradient: { x1: 0, y1: 0, x2: 0, y2: 1 },
                            stops: [
                                [0, 'rgba(29, 111, 164, 0.35)'],
                                [1, 'rgba(29, 111, 164, 0.02)']
                            ]
                        },
                        lineWidth: 2.5,
                        marker: {
                            radius: 3,
                            fillColor: '#ffffff',
                            lineColor: '#1d6fa4',
                            lineWidth: 2,
                            states: {
                                hover: {
                                    radius: 5,
                                    lineWidth: 2
                                }
                            }
                        },
                        animation: {
                            duration: 1000
                        }
                    }
                },
                series: [{
                    name: nomIndicador,
                    data: dataSeries
                }],
                exporting: {
                    enabled: true,
                    buttons: {
                        contextButton: {
                            menuItems: ['downloadPNG', 'downloadPDF', 'downloadCSV', 'separator', 'printChart']
                        }
                    }
                }
            });
            </text>
        }
    });

</script>