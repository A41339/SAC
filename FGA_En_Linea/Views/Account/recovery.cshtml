@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Recuperar</title>
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport" />
    <link rel="stylesheet" href="~/Content/theme/bower_components/bootstrap/dist/css/bootstrap.min.css">
    <link href="https://maxcdn.bootstrapcdn.com/font-awesome/4.3.0/css/font-awesome.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/theme/dist/css/AdminLTE.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/Login.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/theme/plugins/iCheck/square/blue.css" rel="stylesheet" type="text/css" />
</head>
<body class="login-page">
    <div class="background"></div>
    <div class="login-box">

        <div class="login-box-body custom-form">
            <div class="form-group has-feedback btn btn-block btn-flat">
                <img src="~/Content/images/Logo_Login.png" width="150" height="60" />
            </div>
            <br />

            <p class="login-box-msg">Ingrese sus datos para recuperar contraseña</p>
            <form action="" method="post">
                <div class="form-group has-feedback">
                    <input type="text" class="form-control" name="Email" placeholder="Correo electrónico" />
                    <span class="glyphicon glyphicon-envelope form-control-feedback"></span>
                </div>
                <div class="row">
                    <div class="col-xs-7">
                    </div><!-- /.col -->
                    <div class="col-xs-5">
                        <button type="submit" class="btn btn-primary btn-block btn-flat">Recuperar</button>
                    </div><!-- /.col -->
                </div>
            </form>
            <div class="social-auth-links text-center">
                @if (ViewBag.Msg != null)
                {
                    <span style="color: green">  @ViewBag.Msg  </span>
                }
            </div>

            <a href="~/Account/login">Ir a Login</a><br>
        </div>
    </div>
    <script src="~/Content/theme/plugins/jQuery/jQuery-2.1.3.min.js"></script>
    <script src="~/Content/theme/bootstrap/js/bootstrap.min.js" type="text/javascript"></script>
    <script src="~/Content/theme/plugins/iCheck/icheck.min.js" type="text/javascript"></script>
    <script>
        $(function () {
            $('input').iCheck({
                checkboxClass: 'icheckbox_square-blue',
                radioClass: 'iradio_square-blue',
                increaseArea: '20%' // optional
            });
        });
    </script>
</body>
</html>


