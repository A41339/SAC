@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport" />
    <title>Acceso no autorizado - SAC FFC</title>
    <link href="~/Content/theme/bootstrap/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/unauthorized.css" rel="stylesheet" type="text/css" />
</head>
<body class="unauth-body">
    <div class="unauth-card">
        <div class="unauth-icon-circle">
            <i class="fa fa-lock"></i>
        </div>
        <h2 class="unauth-title">Acceso No Autorizado</h2>
        <p class="unauth-text">
            Su rol de usuario actual no dispone de los privilegios necesarios para acceder a esta opci&oacute;n o recurso del sistema.
        </p>
        <div>
            <a href="@Url.Action("Index", "Home")" class="unauth-btn-home">
                <i class="fa fa-arrow-left"></i> Volver al Inicio
            </a>
        </div>
    </div>
</body>
</html>
