@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Ingreso - FFC Sistema Empresarial</title>
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport" />
    <link rel="stylesheet" href="~/Content/theme/bower_components/bootstrap/dist/css/bootstrap.min.css">
    <link href="~/Content/theme/bower_components/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
    <link href="~/Content/theme/dist/css/AdminLTE.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/Login.css?version=2.0" rel="stylesheet" type="text/css" />
    <link href="~/Content/theme/plugins/iCheck/square/blue.css" rel="stylesheet" type="text/css" />
</head>

<body class="login-page">
    <div class="background"></div>
    
    <div class="login-box">
        <div class="login-box-body custom-form">
            <div class="logo-container">
                <img class="logo" src="~/Content/images/Logo_Login2.png" alt="FFC Logo" />
                <div class="login-welcome-title">Bienvenido</div>
            </div>
            
            <p class="login-box-msg">Ingrese sus credenciales para acceder al sistema</p>
            
            <form action="" method="post">
                <div class="form-group has-feedback">
                    <i class="fa fa-user input-icon-left"></i>
                    <input type="text" class="form-control modern-login-input" name="identificacion" id="identificacion" placeholder="Usuario o Identificación" autocomplete="off" />
                </div>
                
                <div class="form-group has-feedback">
                    <i class="fa fa-lock input-icon-left"></i>
                    <input type="password" class="form-control modern-login-input" name="contrasena" id="contrasena" placeholder="Contraseña" />
                </div>
                
                <div class="row" style="margin-top: 15px;">
                    <div class="col-xs-12">
                        <button type="button" id="btn_login" class="btn btn-modern-login btn-block">
                            <i class="fa fa-sign-in"></i> Ingresar al Sistema
                        </button>
                    </div>
                </div>
            </form>
            
            <a href="~/Account/recovery" class="login-recovery-link">
                <i class="fa fa-key"></i> ¿Olvidó su contraseña?
            </a>
        </div>
    </div>

    <!-- Modal OTP -->
    <div class="modal fade" id="OTPModal" role="dialog">
        <div class="modal-dialog modal-sm" style="margin-top: 10%;">
            <div class="modal-content">
                <div class="modal-header text-center">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <label><strong>Verificación de Seguridad (OTP)</strong></label>
                </div>
                <div class="modal-body text-center">
                    <p style="font-size: 12px; color: #64748b; margin-bottom: 15px;">
                        Por favor ingrese el código OTP que fue enviado a su correo electrónico.
                    </p>
                    <input class="form-control modern-login-input text-center" type="password" name="txtOTP" id="txtOTP" placeholder="Código OTP" style="font-size: 18px; letter-spacing: 4px;" />
                </div>
                <div class="modal-footer text-center">
                    <a id="verifyOTP" class="btn btn-success btn-block" style="border-radius: 8px; font-weight: 700;">Validar OTP</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Error -->
    <div id="modalError" class="modal fade">
        <div class="modal-dialog modal-sm" style="margin-top: 10%;">
            <div class="modal-content">
                <div class="modal-header" style="background-color: #dc2626 !important;">
                    <button type="button" class="close" data-dismiss="modal" style="color:white;">&times;</button>
                    <h4 class="modal-title" style="color:white; text-align:center; font-size:15px; font-weight:700;">Error de Autenticación</h4>
                </div>
                <div class="modal-body text-center" style="padding: 20px;">
                    <p id="lbl_mensajeError" style="color: #334155; font-size: 13px; margin: 0;">Ha ocurrido un error</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-danger btn-block" data-dismiss="modal" style="border-radius: 8px; font-weight: 700;">Aceptar</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/Content/theme/plugins/jQuery/jQuery-2.1.3.min.js"></script>
    <script src="~/Content/theme/bower_components/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="~/Content/theme/plugins/iCheck/icheck.min.js" type="text/javascript"></script>
    <script>

        $(document).on("keypress", "input", function (e) {
            if (e.which == 13) {
              var otp = $('#txtOTP').val()
                if (otp == '')
                    doLogin();
                else
                    login();
            }
        });

        $(function () {
            $('input').iCheck({
                checkboxClass: 'icheckbox_square-blue',
                radioClass: 'iradio_square-blue',
                increaseArea: '20%' // optional
            });
        });

        $('#btn_login').click(function () {
            doLogin();
        });

        $('#verifyOTP').click(function () {
            login();
        });

        function doLogin() {
            var identificacion = $('#identificacion').val();
            var contrasena = $('#contrasena').val();

            if (identificacion == '' || contrasena == '') {
                $('#lbl_mensajeError').html('Debe ingresar el usuario y la contraseña.');
                $('#modalError').modal('show');
                return;
            }

            $.ajax({
                url: '@Url.Action("login", "Account")',
                type: "POST",
                data: { "identificacion": identificacion, "contrasena": contrasena },
                success: function (data) {
                    if (data.result == 'true') {
                        location.href = '@Url.Action("Index", "Home")';
                    }
                    else if (data.result == 'OTP') {
                        $('#OTPModal').modal('show');
                    }
                    else {
                        $('#lbl_mensajeError').html(data.result);
                        $('#modalError').modal('show');
                    }
                },
                error: function () {
                    $('#lbl_mensajeError').html('Error de conexión con el servidor.');
                    $('#modalError').modal('show');
                }
            });
        }

        function login() {
            var identificacion = $('#identificacion').val();
            var contrasena = $('#contrasena').val();
            var otp = $('#txtOTP').val();

            $.ajax({
                url: '@Url.Action("loginOTP", "Account")',
                type: "POST",
                data: { "identificacion": identificacion, "contrasena": contrasena, "otp": otp },
                success: function (data) {
                    if (data.result == 'true') {
                        location.href = '@Url.Action("Index", "Home")';
                    }
                    else {
                        $('#lbl_mensajeError').html(data.result);
                        $('#modalError').modal('show');
                    }
                },
                error: function () {
                    $('#lbl_mensajeError').html('Error de conexión al validar OTP.');
                    $('#modalError').modal('show');
                }
            });
        }
    </script>
</body>
</html>
