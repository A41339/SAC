@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Ingreso - FFC Sistema Empresarial</title>
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport" />
    <link rel="stylesheet" href="~/Content/theme/bower_components/bootstrap/dist/css/bootstrap.min.css">
    <link href="~/Content/theme/bower_components/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
    <link href="~/Content/theme/dist/css/AdminLTE.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/Login.css?v=9.0" rel="stylesheet" type="text/css" />
</head>

<body class="login-page">
    <div class="login-wrapper">
        <!-- Columna Izquierda: Brand / Hero Panel con Curvas y Propuesta de Valor FFC -->
        <div class="login-hero">
            <!-- Curved Wave Overlay (2 soft bottom-right curves matching official design) -->
            <div class="hero-wave-bg">
                <svg class="hero-wave-svg" viewBox="0 0 1000 1000" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#004782" />
                            <stop offset="100%" stop-color="#005c9e" />
                        </linearGradient>
                    </defs>
                    <rect width="1000" height="1000" fill="url(#bgGrad)" />
                    <!-- Curve 1: Wide smooth curve in bottom-right corner -->
                    <path d="M 320 1000 C 480 880, 680 720, 1000 620 L 1000 1000 Z" fill="#1b73b5" opacity="0.45" />
                    <!-- Curve 2: Nested soft curve in bottom-right corner -->
                    <path d="M 600 1000 C 720 920, 840 820, 1000 750 L 1000 1000 Z" fill="#2889cb" opacity="0.38" />
                </svg>
            </div>

            <div class="hero-header">
                <div class="hero-brand-logo-group">
                    <img src="~/Content/images/FFC_Logo_Blanco.png?v=1.0" alt="FFC - Fondo de Fortalecimiento Cooperativo" class="ffc-official-logo" />
                </div>
            </div>

            <div class="hero-body">
                <span class="hero-tag">SISTEMA DE AN&Aacute;LISIS COOPERATIVO (SAC)</span>
                <h1 class="hero-title">Informaci&oacute;n financiera para un sector cooperativo m&aacute;s fuerte</h1>
                <p class="hero-subtitle">
                    Impulsamos la solidez y estabilidad financiera de nuestras entidades afiliadas, generando mayor confianza y eficiencia t&eacute;cnica para sus ahorrantes.
                </p>
                <div class="hero-features">
                    <div class="hero-feature-item">
                        <i class="fa fa-bar-chart"></i> An&aacute;lisis y monitoreo
                    </div>
                    <div class="hero-feature-item">
                        <i class="fa fa-shield"></i> Gesti&oacute;n de riesgos
                    </div>
                </div>
            </div>

            <div class="hero-footer">
                &copy; @DateTime.Now.Year Fondo de Fortalecimiento Cooperativo (FFC). Todos los derechos reservados.
            </div>
        </div>

        <!-- Columna Derecha: Formulario de Ingreso -->
        <div class="login-form-section">
            <div class="login-card">
                <div class="form-sac-brand">
                    <div class="sac-logo-row">
                        <span class="sac-brand-name">SAC</span>
                        <div class="sac-brand-bars">
                            <span class="bar bar-1"></span>
                            <span class="bar bar-2"></span>
                            <span class="bar bar-3"></span>
                            <span class="bar bar-4"></span>
                        </div>
                    </div>
                    <span class="sac-brand-desc">Sistema de An&aacute;lisis Cooperativo</span>
                </div>

                <div class="form-header">
                    <h2>Bienvenido</h2>
                    <p>Ingrese sus credenciales para iniciar sesi&oacute;n.</p>
                </div>
                
                <form id="formLogin" action="" method="post" onsubmit="return false;">
                    <div class="form-group-custom">
                        <label for="identificacion" class="form-label-custom">Identificaci&oacute;n</label>
                        <div class="input-container">
                            <i class="fa fa-user input-icon-left"></i>
                            <input type="text" class="form-control modern-login-input" name="identificacion" id="identificacion" placeholder="Ingrese su identificaci&oacute;n" autocomplete="off" />
                        </div>
                    </div>
                    
                    <div class="form-group-custom">
                        <label for="contrasena" class="form-label-custom">Contrase&ntilde;a</label>
                        <div class="input-container">
                            <i class="fa fa-lock input-icon-left"></i>
                            <input type="password" class="form-control modern-login-input" name="contrasena" id="contrasena" placeholder="Ingrese su contrase&ntilde;a" autocomplete="off" />
                            <button type="button" class="btn-toggle-password" id="btnTogglePassword" title="Mostrar/Ocultar contrase&ntilde;a" tabindex="-1">
                                <i class="fa fa-eye" id="eyeIcon"></i>
                            </button>
                        </div>
                    </div>
                    
                    <div class="form-options">
                        <a href="~/Account/recovery" class="login-recovery-link">
                            &iquest;Olvid&oacute; su contrase&ntilde;a?
                        </a>
                    </div>

                    <button type="button" id="btn_login" class="btn btn-modern-login">
                        <span id="btnText"><i class="fa fa-sign-in"></i> Ingresar</span>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Error Estilizado Moderno -->
    <div id="modalError" class="modal fade" role="dialog" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm" style="margin: 12vh auto; max-width: 380px;">
            <div class="modal-content" style="border-radius: 20px; border: none; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.25); background: #ffffff;">
                <div class="modal-body text-center" style="padding: 36px 28px 28px 28px;">
                    <!-- Badge de Icono de Error Estilizado -->
                    <div style="width: 64px; height: 64px; background-color: #fef2f2; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px auto; border: 1px solid #fee2e2;">
                        <i class="fa fa-exclamation-triangle" style="font-size: 28px; color: #ef4444;"></i>
                    </div>
                    
                    <h4 style="font-size: 18px; font-weight: 800; color: #0f172a; margin: 0 0 10px 0;">Atenci&oacute;n</h4>
                    
                    <p id="lbl_mensajeError" style="color: #64748b; font-size: 14px; font-weight: 500; line-height: 1.55; margin: 0 0 24px 0;">
                        Debe ingresar el usuario y la contrase&ntilde;a.
                    </p>

                    <button type="button" class="btn btn-block" data-dismiss="modal" style="height: 44px; border-radius: 12px; font-size: 14px; font-weight: 700; background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); color: #ffffff; border: none; box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25); transition: all 0.2s ease;">
                        Entendido
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/Content/theme/plugins/jQuery/jQuery-2.1.3.min.js"></script>
    <script src="~/Content/theme/bower_components/bootstrap/dist/js/bootstrap.min.js"></script>
    <script>
        $(document).on("keypress", "input", function (e) {
            if (e.which == 13) {
                doLogin();
            }
        });

        // Toggle para Mostrar / Ocultar Contrasena
        $(document).on('click', '#btnTogglePassword', function (e) {
            e.preventDefault();
            var $input = $('#contrasena');
            var $icon = $('#eyeIcon');
            if ($input.attr('type') === 'password') {
                $input.attr('type', 'text');
                $icon.removeClass('fa-eye').addClass('fa-eye-slash');
            } else {
                $input.attr('type', 'password');
                $icon.addClass('fa-eye').removeClass('fa-eye-slash');
            }
        });

        $(document).on('click', '#btn_login', function () {
            doLogin();
        });

        function doLogin() {
            var identificacion = $('#identificacion').val();
            var contrasena = $('#contrasena').val();

            if (identificacion == '' || contrasena == '') {
                $('#lbl_mensajeError').html('Debe ingresar el usuario y la contrase&ntilde;a.');
                $('#modalError').modal('show');
                return;
            }

            var $btn = $('#btn_login');
            var $btnText = $('#btnText');
            $btn.prop('disabled', true);
            $btnText.html('<i class="fa fa-spinner fa-spin"></i> Autenticando...');

            $.ajax({
                url: '@Url.Action("doLogin", "Account")',
                type: 'POST',
                cache: false,
                data: {
                    'identificacion': $.trim(identificacion),
                    'contrasena': $.trim(contrasena)
                },
                success: function (data) {
                    if (data && data.resultado) {
                        var resultado = data.resultado.exito;
                        if (resultado == false) {
                            $("#lbl_mensajeError").html(data.resultado.mensaje);
                            $("#modalError").modal('show');
                            $btn.prop('disabled', false);
                            $btnText.html('<i class="fa fa-sign-in"></i> Ingresar');
                        }
                        else {
                            window.location.href = data.resultado.mensaje;
                        }
                    } else {
                        $("#lbl_mensajeError").html('Respuesta inv&aacute;lida del servidor.');
                        $("#modalError").modal('show');
                        $btn.prop('disabled', false);
                        $btnText.html('<i class="fa fa-sign-in"></i> Ingresar');
                    }
                },
                error: function (result) {
                    $("#lbl_mensajeError").html('Error de comunicaci&oacute;n con el servicio de autenticaci&oacute;n.');
                    $("#modalError").modal('show');
                    $btn.prop('disabled', false);
                    $btnText.html('<i class="fa fa-sign-in"></i> Ingresar');
                }
            });
        }
    </script>
</body>
</html>
