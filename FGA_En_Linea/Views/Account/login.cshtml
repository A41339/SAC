@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Ingreso - FFC Sistema Empresarial</title>
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport" />
    <link rel="stylesheet" href="~/Content/theme/bower_components/bootstrap/dist/css/bootstrap.min.css">
    <link href="~/Content/theme/bower_components/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
    <link href="~/Content/theme/dist/css/AdminLTE.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/Login.css?version=2.0" rel="stylesheet" type="text/css" />
    <link href="~/Content/theme/plugins/iCheck/square/blue.css" rel="stylesheet" type="text/css" />
</head>

<body class="login-page">
    <div class="background"></div>
    
    <div class="login-box">
        <div class="login-box-body custom-form">
            <div class="logo-container">
                <img class="logo" src="~/Content/images/Logo_Login2.png" alt="FFC Logo" />
                <div class="login-welcome-title">Bienvenido</div>
            </div>
            
            <p class="login-box-msg">Ingrese sus datos para iniciar sesi&oacute;n</p>
            
            <form action="" method="post" onsubmit="return false;">
                <div class="form-group has-feedback">
                    <i class="fa fa-user input-icon-left"></i>
                    <input type="text" class="form-control modern-login-input" name="identificacion" id="identificacion" placeholder="Identificaci&oacute;n" autocomplete="off" />
                </div>
                
                <div class="form-group has-feedback">
                    <i class="fa fa-lock input-icon-left"></i>
                    <input type="password" class="form-control modern-login-input" name="contrasena" id="contrasena" placeholder="Contrase&ntilde;a" autocomplete="off" />
                </div>
                
                <div class="row" style="margin-top: 20px;">
                    <div class="col-xs-12">
                        <button type="button" id="btn_login" class="btn btn-modern-login btn-block">
                            <i class="fa fa-sign-in"></i> Ingresar
                        </button>
                    </div>
                </div>
            </form>
            
            <a href="~/Account/recovery" class="login-recovery-link">
                <i class="fa fa-key"></i> &iquest;Olvid&oacute; su contrase&ntilde;a?
            </a>
        </div>
    </div>

    <!-- Modal OTP -->
    <div class="modal fade" id="OTPModal" role="dialog" tabindex="-1">
        <div class="modal-dialog modal-sm" style="margin-top: 10%;">
            <div class="modal-content" style="border-radius: 14px; border: none; overflow: hidden; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);">
                <div class="modal-header text-center" style="background-color: #0b2341; color: white; padding: 18px 20px;">
                    <button type="button" class="close" data-dismiss="modal" style="color: white; opacity: 0.8;">&times;</button>
                    <h4 class="modal-title" style="color: white; font-size: 15px; font-weight: 700; margin: 0;">Verificaci&oacute;n de Seguridad (OTP)</h4>
                </div>
                <div class="modal-body text-center" style="padding: 24px 20px;">
                    <p style="font-size: 13px; color: #64748b; margin-bottom: 16px;">
                        Por favor ingrese el c&oacute;digo OTP que fue enviado a su correo electr&oacute;nico.
                    </p>
                    <input class="form-control modern-login-input text-center" type="password" name="txtOTP" id="txtOTP" placeholder="C&oacute;digo OTP" style="font-size: 18px; letter-spacing: 4px;" />
                </div>
                <div class="modal-footer text-center" style="background-color: #f8fafc; border-top: 1px solid #e2e8f0; padding: 12px 20px;">
                    <button id="verifyOTP" class="btn btn-success btn-block" style="border-radius: 8px; font-weight: 700; background-color: #16a34a; border: none; padding: 10px;">Validar OTP</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Error Estilizado -->
    <div id="modalError" class="modal fade" role="dialog" tabindex="-1">
        <div class="modal-dialog modal-sm" style="margin-top: 12%;">
            <div class="modal-content" style="border-radius: 16px; border: none; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.4);">
                <div class="modal-header text-center" style="background-color: #dc2626; color: white; padding: 20px 20px 15px 20px;">
                    <button type="button" class="close" data-dismiss="modal" style="color: white; opacity: 0.9;">&times;</button>
                    <div style="font-size: 32px; margin-bottom: 5px;"><i class="fa fa-exclamation-circle"></i></div>
                    <h4 class="modal-title" style="color: white; font-size: 16px; font-weight: 700; margin: 0;">Error de Autenticaci&oacute;n</h4>
                </div>
                <div class="modal-body text-center" style="padding: 25px 20px;">
                    <p id="lbl_mensajeError" style="color: #334155; font-size: 13px; font-weight: 600; line-height: 1.5; margin: 0;">
                        Ha ocurrido un error inesperado.
                    </p>
                </div>
                <div class="modal-footer text-center" style="background-color: #f8fafc; border-top: 1px solid #e2e8f0; padding: 12px 20px;">
                    <button class="btn btn-danger btn-block" data-dismiss="modal" style="border-radius: 8px; font-weight: 700; background-color: #dc2626; border: none; padding: 9px;">Aceptar</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/Content/theme/plugins/jQuery/jQuery-2.1.3.min.js"></script>
    <script src="~/Content/theme/bower_components/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="~/Content/theme/plugins/iCheck/icheck.min.js" type="text/javascript"></script>
    <script>
        $(document).on("keypress", "input", function (e) {
            if (e.which == 13) {
                var otp = $('#txtOTP').val();
                if (otp == '')
                    doLogin();
                else
                    login();
            }
        });

        $(function () {
            $('input').iCheck({
                checkboxClass: 'icheckbox_square-blue',
                radioClass: 'iradio_square-blue',
                increaseArea: '20%'
            });
        });

        $(document).on('click', '#btn_login', function () {
            doLogin();
        });

        $(document).on('click', '#verifyOTP', function () {
            login();
        });

        function doLogin() {
            var identificacion = $('#identificacion').val();
            var contrasena = $('#contrasena').val();

            if (identificacion == '' || contrasena == '') {
                $('#lbl_mensajeError').html('Debe ingresar el usuario y la contraseña.');
                $('#modalError').modal('show');
                return;
            }

            $.ajax({
                url: '@Url.Action("doLogin", "Account")',
                type: 'POST',
                cache: false,
                data: {
                    'identificacion': identificacion,
                    'contrasena': contrasena
                },
                success: function (data) {
                    if (data && data.resultado) {
                        var resultado = data.resultado.exito;
                        if (resultado == false) {
                            $("#lbl_mensajeError").html(data.resultado.mensaje);
                            $("#modalError").modal('show');
                        }
                        else {
                            window.location.href = data.resultado.mensaje;
                        }
                    } else {
                        $("#lbl_mensajeError").html('Respuesta inválida del servidor.');
                        $("#modalError").modal('show');
                    }
                },
                error: function (result) {
                    $("#lbl_mensajeError").html('Error de comunicación con el servicio de autenticación.');
                    $("#modalError").modal('show');
                }
            });
        }

        function login() {
            var identificacion = $('#identificacion').val();
            var otp = $('#txtOTP').val();

            $.ajax({
                url: '@Url.Action("Login", "Account")',
                type: 'POST',
                cache: false,
                data: {
                    'identificacion': identificacion,
                    'otp': otp
                },
                success: function (data) {
                    if (data && data.resultado) {
                        var resultado = data.resultado.exito;
                        if (resultado == false) {
                            $("#lbl_mensajeError").html(data.resultado.mensaje);
                            $("#modalError").modal('show');
                        }
                        else {
                            window.location.href = data.resultado.mensaje;
                        }
                    } else {
                        $("#lbl_mensajeError").html('Respuesta inválida al validar OTP.');
                        $("#modalError").modal('show');
                    }
                },
                error: function (result) {
                    $("#lbl_mensajeError").html('Error al validar el código OTP.');
                    $("#modalError").modal('show');
                }
            });
        }
    </script>
</body>
</html>
