@{
    Layout = null;
}
<!DOCTYPE html>
<head>
    <title>Ingreso</title>
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport" />
    <link rel="stylesheet" href="~/Content/theme/bower_components/bootstrap/dist/css/bootstrap.min.css">
    <link href="~/Content/theme/dist/css/AdminLTE.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/Login.css?version=1.0" rel="stylesheet" type="text/css" />
    <link href="~/Content/theme/plugins/iCheck/square/blue.css" rel="stylesheet" type="text/css" />
</head>

<div id="background"></div>
<body class="login-page">
    <div class="background"></div>
    <div class="login-box">
        <div class="login-box-body custom-form">
            <div class="form-group has-feedback btn btn-block btn-flat">
                <img class="logo" src="~/Content/images/Logo_Login2.png" width="150" height="60" />
            </div>
            <br />
            <p class="login-box-msg">Ingrese sus datos para iniciar sesión</p>
            <form action="" method="post">
                <div class="form-group has-feedback">
                    <input type="text" class="form-control" name="identificacion" id="identificacion" placeholder="Identificación" />
                    <span class="glyphicon glyphicon-user form-control-feedback"></span>
                </div>
                <div class="form-group has-feedback">
                    <input type="password" class="form-control" name="contrasena" id="contrasena" placeholder="Contraseña" />
                    <span class="glyphicon glyphicon-lock form-control-feedback"></span>
                </div>
                <div class="row">
                    <div class="col-xs-8">
                    </div><!-- /.col -->
                    <div class="col-xs-4">
                        <a id="btn_login" class="btn btn-primary btn-block btn-flat">Ingresar</a>
                    </div><!-- /.col -->
                </div>
            </form>
            <a href="~/Account/recovery">Olvidé mi contraseña</a><br>
        </div>
    </div>
    <div class="modal fade" id="OTPModal" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header text-center">
                    <a class="btn pull-right" data-dismiss="modal"><span>&times;</span></a>
                    <label><strong>Por favor ingrese el OTP que fue enviado a su correo</strong></label>
                </div>
                <div class="modal-body">
                    <input class="form-control" type="password" name="txtOTP" id="txtOTP" placeholder="OTP" />
                </div>
                <div class="modal-footer">
                    <a id="verifyOTP" class="btn btn-success">Validar OTP</a>
                </div>
            </div>
        </div>
    </div>
    <div id="modalError" class="modal fade">
        <div class="modal-dialog modal-fail">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="icon-box">
                        <i class="material-icons"></i>
                    </div>
                </div>
                <div class="modal-body">
                    <div style="margin-left:50px; margin-right: 50px;">
                        <p id="lbl_mensajeError" class="text-center">Ha ocurrido un error</p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-danger btn-block" data-dismiss="modal">OK</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/Content/theme/plugins/jQuery/jQuery-2.1.3.min.js"></script>
    <script src="~/Content/theme/bower_components/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="~/Content/theme/plugins/iCheck/icheck.min.js" type="text/javascript"></script>
    <script>

        $(document).on("keypress", "input", function (e) {
            if (e.which == 13) {
              var otp = $('#txtOTP').val()
                if (otp == '')
                    doLogin();
                else
                    login();
            }
        });

        $(function () {
            $('input').iCheck({
                checkboxClass: 'icheckbox_square-blue',
                radioClass: 'iradio_square-blue',
                increaseArea: '20%' // optional
            });
        });

        function doLogin() {
             $.ajax({
                url: '@Url.Action("doLogin", "Account")',
                type: 'POST',
                cache: false,
                async: false,
                data: {
                     'identificacion': $('#identificacion').val(),
                     'contrasena': $('#contrasena').val()
                },
                success: function (data) {
                    var resultado = data.resultado.exito;
                    if (resultado == false) {
                        $("#lbl_mensajeError").html(data.resultado.mensaje);
                        $("#modalError").modal('show');
                    }
                    else {
                         window.location.href = data.resultado.mensaje;
                    }
                },
                error: function (result) {
                    $("#modalError").modal('show');
                }
             });
        }

        @*function doLogin() {
             $.ajax({
                url: '@Url.Action("doLogin", "Account")',
                type: 'POST',
                cache: false,
                async: true,
                data: {
                     'identificacion': $('#identificacion').val(),
                     'contrasena': $('#contrasena').val()
                },
                success: function (data) {
                    var resultado = data.resultado.exito;
                    if (resultado == false) {
                        $("#lbl_mensajeError").html(data.resultado.mensaje);
                        $("#modalError").modal('show');
                    }
                    else {
                        $("#OTPModal").modal('show');
                    }
                },
                error: function (result) {
                    $("#modalError").modal('show');
                }
             });
        }*@

         function login() {
             $.ajax({
                url: '@Url.Action("Login", "Account")',
                type: 'POST',
                cache: false,
                async: false,
                data: {
                     'identificacion': $('#identificacion').val(),
                     'otp':  $('#txtOTP').val()
                },
                success: function (data) {
                    var resultado = data.resultado.exito;
                    if (resultado == false) {
                        $("#lbl_mensajeError").html(data.resultado.mensaje);
                        $("#modalError").modal('show');
                    }
                    else {
                         window.location.href = data.resultado.mensaje;
                    }
                },
                error: function (result) {
                    $("#modalError").modal('show');
                }
             });
        }

        $(document).on('click', '#btn_login', function () {
            doLogin();
        });

         $(document).on('click', '#verifyOTP', function () {
            login();
         });

    </script>
</body>


