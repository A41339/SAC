@model FGA.Model.LiquidezIndexViewModel

<!-- Encabezado y Selector de Fecha de Corte -->
<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px; margin-bottom: 20px; padding-bottom: 16px; border-bottom: 1px solid #f1f5f9;">
    <div style="display: flex; align-items: center; gap: 14px;">
        <img class="img-logo-entidad" width="44" height="44" src="@(Session["Logo"] ?? Url.Content("~/Content/images/FFC.jpg"))" onerror="this.onerror=null;this.src='@Url.Content("~/Content/images/FFC.jpg")';" style="border-radius: 8px; background: #ffffff; padding: 3px; border: 1px solid #e2e8f0; object-fit: contain;" />
        <div>
            <h4 style="margin: 0; font-size: 16px; font-weight: 700; color: #143750;">GAP Contractual de Liquidez - <span id="lblEntidadGap">@Model.NombreEntidad</span></h4>
            <p style="margin: 2px 0 0 0; font-size: 12px; color: #64748b;">Brechas temporales entre entradas y salidas contractuales acumuladas en el tiempo</p>
        </div>
    </div>

    <!-- Selector de Fecha de Corte (último mes cargado) y Generar -->
    <div style="display: inline-flex; align-items: center; gap: 8px;">
        <label for="txtFechaCorteGap" style="margin: 0; font-size: 12px; font-weight: 600; color: #475569;">Fecha de corte:</label>
        <input type="text" id="txtFechaCorteGap" class="form-control modern-date-input datecontrol" value="@(Model.PeriodoCorteGap ?? Model.Periodo2)" style="width: 130px; height: 34px; font-size: 12.5px;" />
        <button type="button" id="btnGenerarGap" class="btn-modern-generate" style="height: 34px; padding: 0 16px; font-size: 12.5px;" onclick="cargarGapContractual()">
            <i class="fa fa-refresh"></i> Generar
        </button>
    </div>
</div>

<!-- Gráficos de Brechas Contractuales (Highcharts) -->
<div class="row">
    <div class="col-md-8 col-xs-12">
        <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px; margin-bottom: 16px;">
            <div id="chartGapContractualBarras" style="height: 380px; width: 100%;"></div>
        </div>
    </div>
    <div class="col-md-4 col-xs-12">
        <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px; margin-bottom: 16px;">
            <div id="chartGapAcumuladoLinea" style="height: 380px; width: 100%;"></div>
        </div>
    </div>
</div>

<!-- Tabla Resumen de Brechas por Banda -->
<div class="table-responsive" style="margin-top: 10px;">
    <table id="tblGapResumen" class="table table-bordered table-striped modern-data-table" style="width: 100%;">
        <thead>
            <tr style="background-color: #f1f5f9;">
                <th class="text-left">Banda Temporal</th>
                <th class="text-right">Entradas (MM ¢)</th>
                <th class="text-right">Salidas (MM ¢)</th>
                <th class="text-right">Brecha de Banda (MM ¢)</th>
                <th class="text-right">Brecha Acumulada (MM ¢)</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.GapDatos != null && Model.GapDatos.Bandas != null)
            {
                for (int i = 0; i < Model.GapDatos.Bandas.Count; i++)
                {
                    decimal ent = Model.GapDatos.Entradas.Count > i ? Model.GapDatos.Entradas[i] : 0m;
                    decimal sal = Model.GapDatos.Salidas.Count > i ? Model.GapDatos.Salidas[i] : 0m;
                    decimal bBanda = Model.GapDatos.BrechasBanda.Count > i ? Model.GapDatos.BrechasBanda[i] : (ent - sal);
                    decimal bAcum = Model.GapDatos.BrechasAcumuladas.Count > i ? Model.GapDatos.BrechasAcumuladas[i] : 0m;

                    <tr>
                        <td class="text-left" style="font-weight: 600; color: #1e3a8a;">@Model.GapDatos.Bandas[i]</td>
                        <td class="text-right" style="color: #047857; font-weight: 600; cursor: pointer;" onclick="verDetalleEntradasSalidas('entradas', '@Model.GapDatos.Bandas[i]')">
                            <i class="fa fa-search-plus" style="font-size: 11px; margin-right: 4px; color: #10b981;"></i> @ent.ToString("N2")
                        </td>
                        <td class="text-right" style="color: #c2410c; font-weight: 600; cursor: pointer;" onclick="verDetalleEntradasSalidas('salidas', '@Model.GapDatos.Bandas[i]')">
                            <i class="fa fa-search-plus" style="font-size: 11px; margin-right: 4px; color: #f97316;"></i> @sal.ToString("N2")
                        </td>
                        <td class="text-right" style="font-weight: 700; color: @(bBanda >= 0 ? "#047857" : "#b91c1c");">@bBanda.ToString("N2")</td>
                        <td class="text-right" style="font-weight: 700; color: @(bAcum >= 0 ? "#0284c7" : "#dc2626"); background-color: #f8fafc;">@bAcum.ToString("N2")</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<!-- Modal para Detalle de Entradas / Salidas al hacer clic -->
<div class="modal fade" id="modalDetalleEntradasSalidas" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="border-radius: 8px;">
            <div class="modal-header" style="background-color: #f8fafc; border-bottom: 1px solid #e2e8f0; border-top-left-radius: 8px; border-top-right-radius: 8px;">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title" id="tituloModalEntradasSalidas" style="font-weight: 700; color: #143750;">Detalle</h4>
            </div>
            <div class="modal-body">
                <div id="chartDetalleEntradasSalidas" style="height: 320px; width: 100%;"></div>
            </div>
            <div class="modal-footer" style="border-top: 1px solid #e2e8f0;">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
