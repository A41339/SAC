                    for (var i = 0; i < gapModelData.bandas.length; i++) {
                        htmlTabla += '<td style="text-align: right; font-family: monospace; white-space: nowrap; padding: 8px 10px;">' + fmtMonto(gapModelData.otrasCuentas[i]) + '</td>';
                    }
                    htmlTabla += '</tr><tr style="background: #eff6ff; font-weight: 700; border-top: 2px solid #2b579a;"><td style="color: #1e3a8a; white-space: nowrap;">Total Salidas</td>';
                    for (var i = 0; i < gapModelData.bandas.length; i++) {
                        htmlTabla += '<td style="text-align: right; font-family: monospace; color: #1e3a8a; font-weight: 800; white-space: nowrap; padding: 8px 10px;">' + fmtMonto(gapModelData.salidasTotales[i]) + '</td>';
                    }
                    htmlTabla += '</tr></tbody></table></div>';
                }

                $('#contenedorTablaDetalleModal').html(htmlTabla);

                Highcharts.chart('chartDetalleEntradasSalidas', {
                    chart: { type: 'column' },
                    title: { text: titulo, style: { fontWeight: '700', color: '#143750', fontSize: '15px' } },
                    subtitle: { text: 'Desglose detallado por banda temporal (Millones de ¢)' },
                    xAxis: { categories: gapModelData.bandas },
                    yAxis: {
                        title: { text: 'Monto en Millones (¢)' },
                        stackLabels: {
                            enabled: true,
                            formatter: function() {
                                return '¢' + this.total.toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                            },
                            style: { fontWeight: 'bold', color: '#143750', fontSize: '11px' }
                        }
                    },
                    tooltip: {
                        shared: true,
                        valueDecimals: 2,
                        valuePrefix: '¢',
                        valueSuffix: ' MM'
                    },
                    plotOptions: {
                        column: {
                            stacking: 'normal',
                            borderWidth: 0,
                            borderRadius: 2,
                            dataLabels: { enabled: false }
                        }
                    },
                    series: seriesData,
                    credits: { enabled: false }
                });
            }, 300);
        }

        function setUnidadDisplay(modo) {
            if (modo === 'MM') {
                $('#btnUnidadMM').addClass('active').addClass('btn-primary').removeClass('btn-default');
                $('#btnUnidadUnidades').removeClass('active').removeClass('btn-primary').addClass('btn-default');
                $('.monto-dinamico').each(function() {
                    var valMm = parseFloat($(this).attr('data-monto-mm'));
                    if (!isNaN(valMm)) {
                        var prefix = $(this).attr('data-prefix') || '¢';
                        var suffix = $(this).attr('data-suffix') !== undefined ? $(this).attr('data-suffix') : ' MM';
                        $(this).text(prefix + valMm.toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + suffix);
                    }
                });
                $('.unidad-label').text('Millones de Colones (¢ MM)');
            } else {
                $('#btnUnidadUnidades').addClass('active').addClass('btn-primary').removeClass('btn-default');
                $('#btnUnidadMM').removeClass('active').removeClass('btn-primary').addClass('btn-default');
                $('.monto-dinamico').each(function() {
                    var valMm = parseFloat($(this).attr('data-monto-mm'));
                    if (!isNaN(valMm)) {
                        var valUnidades = valMm * 1000000;
                        var prefix = $(this).attr('data-prefix') || '¢';
                        $(this).text(prefix + valUnidades.toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                    }
                });
                $('.unidad-label').text('Colones Exactos (¢)');
            }
        }

        $(document).ready(function() {
            renderGraficosGap();
            renderGraficoICL();

            $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
                var target = $(e.target).attr('href');
                if (target === '#tab-gap') {
                    renderGraficosGap();
                } else if (target === '#tab-icl') {
                    renderGraficoICL();
                }
            });
        });
    </script>
