                    for (var i = 0; i < gapModelData.bandas.length; i++) {
                        htmlTabla += '<td style="text-align: right; font-family: monospace; white-space: nowrap; padding: 8px 10px;">' + fmtMonto(gapModelData.disponibilidades[i]) + '</td>';
                    }
                    htmlTabla += '</tr><tr><td style="font-weight: 600; color: #334155; white-space: nowrap;"><i class="fa fa-circle" style="color: #475569; font-size: 10px; margin-right: 6px;"></i> Recuperación de Cartera</td>';
                    for (var i = 0; i < gapModelData.bandas.length; i++) {
                        htmlTabla += '<td style="text-align: right; font-family: monospace; white-space: nowrap; padding: 8px 10px;">' + fmtMonto(gapModelData.recaudoCartera[i]) + '</td>';
                    }
                    htmlTabla += '</tr><tr><td style="font-weight: 600; color: #475569; white-space: nowrap;"><i class="fa fa-circle" style="color: #94a3b8; font-size: 10px; margin-right: 6px;"></i> Vencimiento Inversiones</td>';
                    for (var i = 0; i < gapModelData.bandas.length; i++) {
                        htmlTabla += '<td style="text-align: right; font-family: monospace; white-space: nowrap; padding: 8px 10px;">' + fmtMonto(gapModelData.vencimientoInversiones[i]) + '</td>';
                    }
                    htmlTabla += '</tr><tr style="background: #eff6ff; font-weight: 700; border-top: 2px solid #2b579a;"><td style="color: #1e3a8a; white-space: nowrap;">Total Entradas</td>';
                    for (var i = 0; i < gapModelData.bandas.length; i++) {
                        htmlTabla += '<td style="text-align: right; font-family: monospace; color: #1e3a8a; font-weight: 800; white-space: nowrap; padding: 8px 10px;">' + fmtMonto(gapModelData.entradasTotales[i]) + '</td>';
                    }
                    htmlTabla += '</tr></tbody></table></div>';
                } else {
                    seriesData = [
                        { name: "Vencimientos de CDP's", data: gapModelData.cdps, color: '#2b579a' },
                        { name: 'Obligaciones con Entidades', data: gapModelData.obligaciones, color: '#475569' },
                        { name: 'Otras Cuentas por Pagar', data: gapModelData.otrasCuentas, color: '#94a3b8' }
                    ];

                    htmlTabla = '<div class="table-responsive" style="border: 1px solid #cbd5e1; border-radius: 6px; overflow-x: auto;">' +
                        '<table class="table table-bordered table-striped tabla-liquidez-azul" style="width: 100%; font-size: 12px; margin-bottom: 0;">' +
                        '<thead><tr>' +
                        '<th style="text-align: left; background: #2b579a !important; color: #fff !important; padding: 10px 14px; min-width: 190px;">Concepto</th>';
                    for (var i = 0; i < gapModelData.bandas.length; i++) {
                        htmlTabla += '<th style="text-align: right; background: #2b579a !important; color: #fff !important; padding: 10px 10px; min-width: 105px; white-space: nowrap;">' + gapModelData.bandas[i] + '</th>';
                    }
                    htmlTabla += '</tr></thead><tbody>' +
                        '<tr><td style="font-weight: 600; color: #1e3a8a; white-space: nowrap;"><i class="fa fa-circle" style="color: #2b579a; font-size: 10px; margin-right: 6px;"></i> Vencimientos CDP\'s</td>';
                    for (var i = 0; i < gapModelData.bandas.length; i++) {
                        htmlTabla += '<td style="text-align: right; font-family: monospace; white-space: nowrap; padding: 8px 10px;">' + fmtMonto(gapModelData.cdps[i]) + '</td>';
                    }
                    htmlTabla += '</tr><tr><td style="font-weight: 600; color: #334155; white-space: nowrap;"><i class="fa fa-circle" style="color: #475569; font-size: 10px; margin-right: 6px;"></i> Obligaciones con Entidades</td>';
                    for (var i = 0; i < gapModelData.bandas.length; i++) {
                        htmlTabla += '<td style="text-align: right; font-family: monospace; white-space: nowrap; padding: 8px 10px;">' + fmtMonto(gapModelData.obligaciones[i]) + '</td>';
