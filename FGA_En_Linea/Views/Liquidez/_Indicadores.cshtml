@model FGA.Model.LiquidezIndexViewModel

<!-- Header institucional con Logo, Título y Subtítulo idéntico a Indicadores FGA -->
<div style="display: flex; align-items: center; gap: 14px; margin-bottom: 20px; padding-bottom: 16px; border-bottom: 1px solid #f1f5f9;">
    <img id="imgLogoIndicadores" class="img-logo-entidad" width="44" height="44" src="@(Session["Logo"] ?? Url.Content("~/Content/images/FFC.jpg"))" onerror="this.onerror=null;this.src='@Url.Content("~/Content/images/FFC.jpg")';" style="border-radius: 8px; background: #ffffff; padding: 3px; border: 1px solid #e2e8f0; object-fit: contain;" />
    <div>
        <h4 style="margin: 0; font-size: 16px; font-weight: 700; color: #143750;">Indicadores de Liquidez - <span id="lblEntidadIndicadores">@Model.NombreEntidad</span></h4>
        <p style="margin: 2px 0 0 0; font-size: 12px; color: #64748b;">Métricas clave de cobertura inmediata, colocación en cartera, fondeo mayorista y absorción de concentración</p>
    </div>
</div>

<!-- Tabla DataTables con diseño moderno idéntico a Estructura de Fondeo -->
<div class="table-responsive">
    <table id="tblIndicadoresLiquidez" class="table table-striped modern-data-table" style="width: 100%;">
        <thead>
            <tr>
                <th class="text-left" style="text-align: left !important; padding-left: 16px;">Indicador</th>
                <th class="text-left" style="text-align: left !important;">Fórmula</th>
                <th class="text-left" style="text-align: left !important;">Qué mide</th>
                <th id="thPeriodo1" class="text-right" style="text-align: right !important; padding-right: 14px;">@(Model.Periodo1Header ?? Model.Periodo1)</th>
                <th id="thPeriodo2" class="text-right" style="text-align: right !important; padding-right: 14px;">@(Model.Periodo2Header ?? Model.Periodo2)</th>
                <th class="text-center" style="text-align: center !important;">Variación (p.p.)</th>
                <th class="text-center" style="width: 50px; text-align: center !important;"></th>
            </tr>
        </thead>
        <tbody id="tbodyIndicadoresLiquidez">
            @if (Model.Indicadores != null && Model.Indicadores.Count > 0)
            {
                foreach (var ind in Model.Indicadores)
                {
                    <tr class="fila-indicador" data-nombre="@ind.Nombre.ToLower()">
                        <td class="text-left" style="padding: 10px 16px; vertical-align: middle; text-align: left; font-weight: 600; color: #1e3a8a; font-size: 13px;">
                            @ind.Nombre
                        </td>
                        <td class="text-left" style="padding: 10px 12px; vertical-align: middle; text-align: left; font-size: 12px; color: #64748b; font-family: monospace;">
                            @ind.Formula
                        </td>
                        <td class="text-left" style="padding: 10px 12px; vertical-align: middle; text-align: left; font-size: 12.5px; color: #475569;">
                            @ind.QueMide
                        </td>
                        <td class="text-right" style="padding: 10px 14px; vertical-align: middle; text-align: right !important; font-variant-numeric: tabular-nums; font-weight: 600; color: #334155; font-size: 13px;">
                            @ind.ValorP1Formateado
                        </td>
                        <td class="text-right" style="padding: 10px 14px; vertical-align: middle; text-align: right !important; font-variant-numeric: tabular-nums; font-weight: 700; color: #0f172a; font-size: 13px;">
                            @ind.ValorP2Formateado
                        </td>
                        <td class="text-center" style="padding: 10px; vertical-align: middle; text-align: center !important; font-variant-numeric: tabular-nums;">
                            @if (ind.Variacion > 0)
                            {
                                <span class="badge" style="background-color: #dbeafe; color: #1e40af; font-size: 12px; font-weight: 700; padding: 4px 8px; border-radius: 6px; display: inline-block; min-width: 75px; text-align: center;">
                                    @ind.VariacionFormateada
                                </span>
                            }
                            else if (ind.Variacion < 0)
                            {
                                <span class="badge" style="background-color: #ffedd5; color: #c2410c; font-size: 12px; font-weight: 700; padding: 4px 8px; border-radius: 6px; display: inline-block; min-width: 75px; text-align: center;">
                                    @ind.VariacionFormateada
                                </span>
                            }
                            else
                            {
                                <span class="badge" style="background-color: #f1f5f9; color: #475569; font-size: 12px; font-weight: 700; padding: 4px 8px; border-radius: 6px; display: inline-block; min-width: 75px; text-align: center;">
                                    0.00
                                </span>
                            }
                        </td>
                        <td class="text-center" style="padding: 10px; vertical-align: middle; text-align: center !important; width: 50px;">
                            <a style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border:1px solid #6B9FD4;border-radius:6px;color:#2F5597;text-decoration:none;" data-toggle="tooltip" data-placement="top" title="Ver evolución del rango seleccionado" href="javascript:getGraphIndicadorLiquidez(@ind.Orden)">
                                <i class="fa fa-line-chart"></i>
                            </a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<!-- Nota aclaratoria reglamentaria especificada en el requerimiento -->
<div style="margin-top: 18px; padding: 12px 16px; background-color: #f8fafc; border-left: 4px solid #0284c7; border-radius: 6px; font-size: 12.5px; color: #475569; line-height: 1.5;">
    <i class="fa fa-info-circle" style="color: #0284c7; margin-right: 6px; font-size: 14px;"></i>
    <strong>Nota importante:</strong> Los datos mostrados se comparan con los datos de los meses seleccionados, no corresponde a un rango de fechas. En el icono de gráfico se puede ver la evolución del rango seleccionado.
</div>
