        function verDetalleEntradasSalidas(tipo, banda) {
            $('#tituloModalEntradasSalidas').text('Detalle de ' + (tipo === 'entradas' ? 'Entradas' : 'Salidas') + ' - ' + banda);
            $('#modalDetalleEntradasSalidas').modal('show');
            setTimeout(function() {
                Highcharts.chart('chartDetalleEntradasSalidas', {
                    chart: { type: 'bar' },
                    title: { text: tipo === 'entradas' ? 'Composición de Entradas' : 'Composición de Salidas' },
                    xAxis: { categories: tipo === 'entradas' ? ['Cartera (Recaudo)', 'Inversiones (Cupones/Venc.)', 'Comisiones'] : ['CDP Vencimientos', 'Salida Top 20', 'Obligaciones deuda', 'Gastos adm.'] },
                    yAxis: { title: { text: 'Millones de Colones (¢)' } },
                    series: [{ name: 'Monto', data: tipo === 'entradas' ? [135.5, 552.5, 5.8] : [127.5, 162.0, 10.0, 77.1], color: tipo === 'entradas' ? '#10b981' : '#f97316' }],
                    credits: { enabled: false }
                });
            }, 300);
        }

