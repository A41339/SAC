        $(document).ready(function() {
            renderGraficosGap();
            renderGraficoBrechasEstres();

            $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
                var target = $(e.target).attr('href');
                if (target === '#tab-gap') {
