@model FGA.Model.LiquidezIndexViewModel

<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px; margin-bottom: 20px; padding-bottom: 16px; border-bottom: 1px solid #f1f5f9;">
    <div style="display: flex; align-items: center; gap: 14px;">
        <img class="img-logo-entidad" width="44" height="44" src="@(Session["Logo"] ?? Url.Content("~/Content/images/FFC.jpg"))" onerror="this.onerror=null;this.src='@Url.Content("~/Content/images/FFC.jpg")';" style="border-radius: 8px; background: #ffffff; padding: 3px; border: 1px solid #e2e8f0; object-fit: contain;" />
        <div>
            <h4 style="margin: 0; font-size: 16px; font-weight: 700; color: #143750;">Horizonte de Supervivencia - <span id="lblEntidadHorizonte">@Model.NombreEntidad</span></h4>
            <p style="margin: 2px 0 0 0; font-size: 12px; color: #64748b;">Período máximo estimado en que la entidad puede operar sin acceso a nuevas fuentes de liquidez</p>
        </div>
    </div>
</div>

<div class="row" style="margin-bottom: 24px;">
    <!-- Base -->
    <div class="col-md-4 col-sm-6 col-xs-12">
        <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 10px; padding: 20px; text-align: center;">
            <div style="font-size: 12px; font-weight: 800; color: #166534; text-transform: uppercase; margin-bottom: 6px;">Escenario Base</div>
            <div style="font-size: 26px; font-weight: 800; color: #15803d; margin-bottom: 6px;">@Model.Horizonte.HorizonteBase</div>
            <p style="font-size: 12px; color: #166534; margin: 0;">Banda de inflexión estimada: <strong>91 a 180 días</strong></p>
            <div style="margin-top: 10px; font-size: 11px; color: #15803d; background: #dcfce7; padding: 4px 8px; border-radius: 6px; display: inline-block;">
                Buffer remanente: ¢@Model.Horizonte.SaldoFinalBase.ToString("N2") MM
            </div>
        </div>
    </div>

    <!-- Moderado -->
    <div class="col-md-4 col-sm-6 col-xs-12">
        <div style="background: #fffbeb; border: 1px solid #fde68a; border-radius: 10px; padding: 20px; text-align: center;">
            <div style="font-size: 12px; font-weight: 800; color: #92400e; text-transform: uppercase; margin-bottom: 6px;">Escenario Moderado</div>
            <div style="font-size: 26px; font-weight: 800; color: #d97706; margin-bottom: 6px;">@Model.Horizonte.HorizonteModerado</div>
            <p style="font-size: 12px; color: #92400e; margin: 0;">Banda de inflexión estimada: <strong>61 a 90 días</strong></p>
            <div style="margin-top: 10px; font-size: 11px; color: #b45309; background: #fef3c7; padding: 4px 8px; border-radius: 6px; display: inline-block;">
                Buffer remanente: ¢@Model.Horizonte.SaldoFinalModerado.ToString("N2") MM
            </div>
        </div>
    </div>

    <!-- Severo -->
    <div class="col-md-4 col-sm-6 col-xs-12">
        <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 10px; padding: 20px; text-align: center;">
            <div style="font-size: 12px; font-weight: 800; color: #991b1b; text-transform: uppercase; margin-bottom: 6px;">Escenario Severo</div>
            <div style="font-size: 26px; font-weight: 800; color: #dc2626; margin-bottom: 6px;">@Model.Horizonte.HorizonteSevero</div>
            <p style="font-size: 12px; color: #991b1b; margin: 0;">Banda de inflexión estimada: <strong>1 a 30 días</strong></p>
            <div style="margin-top: 10px; font-size: 11px; color: #b91c1c; background: #fee2e2; padding: 4px 8px; border-radius: 6px; display: inline-block;">
                Buffer remanente: ¢@Model.Horizonte.SaldoFinalSevero.ToString("N2") MM
            </div>
        </div>
    </div>
</div>

<div style="padding: 16px; background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px;">
    <h5 style="margin: 0 0 8px 0; font-weight: 700; color: #1e3a8a;"><i class="fa fa-lightbulb-o" style="color: #f59e0b; margin-right: 6px;"></i> Interpretación del Horizonte de Supervivencia</h5>
    <p style="margin: 0; font-size: 12.5px; color: #475569; line-height: 1.6;">
        El horizonte de supervivencia identifica la banda temporal exacta en la cual los activos líquidos y flujos acumulados dejan de ser suficientes para cubrir los vencimientos y corridas estimadas. 
        En el escenario severo, la entidad requiere planes de contingencia inmediata ante la aceleración en la salida de depósitos y caída en el recaudo de cartera.
    </p>
</div>
