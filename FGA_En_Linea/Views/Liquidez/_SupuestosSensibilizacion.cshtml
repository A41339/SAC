<script>
    function parseMonto(val) {
        if (val === null || val === undefined) return 0;
        var s = val.toString().trim();
        if (!s) return 0;

        var lastComma = s.lastIndexOf(',');
        var lastDot = s.lastIndexOf('.');

        if (lastComma > -1 && lastDot > -1) {
            if (lastDot > lastComma) {
                s = s.replace(/,/g, '');
            } else {
                s = s.replace(/\./g, '').replace(',', '.');
            }
        } else if (lastComma > -1) {
            var commaCount = (s.match(/,/g) || []).length;
            if (commaCount > 1) {
                s = s.replace(/,/g, '');
            } else {
                var parts = s.split(',');
                if (parts[1].length <= 2) {
                    s = parts[0] + '.' + parts[1];
                } else {
                    s = s.replace(/,/g, '');
                }
            }
        } else {
            var dotCount = (s.match(/\./g) || []).length;
            if (dotCount > 1) {
                s = s.replace(/\./g, '');
            }
        }

        var n = parseFloat(s);
        return isNaN(n) ? 0 : n;
    }

    function formatMonto(val) {
        var n = parseMonto(val);
        return n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function recopilarSupuestos() {
        return {
            RenovacionCDP_Base: parseMonto($('#txtCDP_Base').val()) / 100,
            RenovacionCDP_Moderado: parseMonto($('#txtCDP_Mod').val()) / 100,
            RenovacionCDP_Severo: parseMonto($('#txtCDP_Sev').val()) / 100,

            SalidaVista_Base: parseMonto($('#txtVaR_Base').val()) / 100,
            SalidaVista_Moderado: parseMonto($('#txtVaR_Mod').val()) / 100,
            SalidaVista_Severo: parseMonto($('#txtVaR_Sev').val()) / 100,

            CrecimientoCartera_Base: parseMonto($('#txtCartera_Base').val()) / 100,
            CrecimientoCartera_Moderado: parseMonto($('#txtCartera_Mod').val()) / 100,
            CrecimientoCartera_Severo: parseMonto($('#txtCartera_Sev').val()) / 100,

            DisminucionRecaudo_Base: parseMonto($('#txtRecaudo_Base').val()) / 100,
            DisminucionRecaudo_Moderado: parseMonto($('#txtRecaudo_Mod').val()) / 100,
            DisminucionRecaudo_Severo: parseMonto($('#txtRecaudo_Sev').val()) / 100,

            Haircut_Base: parseMonto($('#txtHaircut_Base').val()),
            Haircut_Moderado: parseMonto($('#txtHaircut_Mod').val()),
            Haircut_Severo: parseMonto($('#txtHaircut_Sev').val()),

            SalidaTop20_Base: parseMonto($('#txtTop20_Base').val()) / 100,
            SalidaTop20_Moderado: parseMonto($('#txtTop20_Mod').val()) / 100,
            SalidaTop20_Severo: parseMonto($('#txtTop20_Sev').val()) / 100,

            DisponibilidadLineas_Base: parseMonto($('#txtLineas_Base').val()),
            DisponibilidadLineas_Moderado: parseMonto($('#txtLineas_Mod').val()),
            DisponibilidadLineas_Severo: parseMonto($('#txtLineas_Sev').val()),

            PagoObligaciones_Base: parseMonto($('#txtDeuda_Base').val()),
            PagoObligaciones_Moderado: parseMonto($('#txtDeuda_Mod').val()),
            PagoObligaciones_Severo: parseMonto($('#txtDeuda_Sev').val()),

            Cupones_Base: parseMonto($('#txtCupones_Base').val()),
            Cupones_Moderado: parseMonto($('#txtCupones_Mod').val()),
            Cupones_Severo: parseMonto($('#txtCupones_Sev').val()),

            CapitalSocial_Base: parseMonto($('#txtCapital_Base').val()) / 100,
            CapitalSocial_Moderado: parseMonto($('#txtCapital_Mod').val()) / 100,
            CapitalSocial_Severo: parseMonto($('#txtCapital_Sev').val()) / 100,

            OtrosIngresos_Base: parseMonto($('#txtOtrosIng_Base').val()) / 100,
            OtrosIngresos_Moderado: parseMonto($('#txtOtrosIng_Mod').val()) / 100,
            OtrosIngresos_Severo: parseMonto($('#txtOtrosIng_Sev').val()) / 100,

            EgresosFinancieros_Base: parseMonto($('#txtEgFin_Base').val()) / 100,
            EgresosFinancieros_Moderado: parseMonto($('#txtEgFin_Mod').val()) / 100,
            EgresosFinancieros_Severo: parseMonto($('#txtEgFin_Sev').val()) / 100,

            GastosAdministrativos_Base: parseMonto($('#txtAdm_Base').val()) / 100,
            GastosAdministrativos_Moderado: parseMonto($('#txtAdm_Mod').val()) / 100,
            GastosAdministrativos_Severo: parseMonto($('#txtAdm_Sev').val()) / 100
        };
    }

    function recalcularEscenarios(fromPreset) {
        var postData = {
            idEntidad: $('#ddlEntidad').val(),
            periodo2: $('#Periodo2').val(),
            supuestos: recopilarSupuestos()
        };

        $.ajax({
            url: '@Url.Action("SimularEstres", "Liquidez")',
            type: 'POST',
            data: postData,
            success: function(resp) {
                if (resp && resp.success) {
                    // 1. Actualizar Tabla FAL
                    if (resp.razonCobertura) {
                        var rc = resp.razonCobertura;
                        $('#tdFalEfBase').text('¢' + (rc.Disponibilidades110_Base || 0).toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' MM');
                        $('#tdFalEfMod').text('¢' + (rc.Disponibilidades110_Moderado || 0).toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' MM');
                        $('#tdFalEfSev').text('¢' + (rc.Disponibilidades110_Severo || 0).toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' MM');

                        $('#tdFalInvBase').text('¢' + (rc.Inversiones120_Base || 0).toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' MM');
                        $('#tdFalInvMod').text('¢' + (rc.Inversiones120_Moderado || 0).toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' MM');
                        $('#tdFalInvSev').text('¢' + (rc.Inversiones120_Severo || 0).toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' MM');

                        $('#tdFalTotBase').text('¢' + (rc.ActivosLiquidos_Base || 0).toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' MM');
                        $('#tdFalTotMod').text('¢' + (rc.ActivosLiquidos_Moderado || 0).toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' MM');
                        $('#tdFalTotSev').text('¢' + (rc.ActivosLiquidos_Severo || 0).toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' MM');

                        // Actualizar Razón de Cobertura Tarjetas
                        $('#lblRCBase').text((rc.RazonCobertura_Base || 0).toFixed(2) + 'x');
                        $('#lblRCMod').text((rc.RazonCobertura_Moderado || 0).toFixed(2) + 'x');
                        $('#lblRCSevero').text((rc.RazonCobertura_Severo || 0).toFixed(2) + 'x');

                        // Actualizar Badge de Pestaña Razón de Cobertura
                        $('#badgeTabRC').text((rc.RazonCobertura_Base || 0).toFixed(2) + 'x');

                        // Actualizar Fila Resumen Tabla Razón Cobertura
                        $('#cellRCBaseVal').text((rc.RazonCobertura_Base || 0).toFixed(2) + 'x');
                        $('#cellRCModVal').text((rc.RazonCobertura_Moderado || 0).toFixed(2) + 'x');
                        $('#cellRCSeveroVal').text((rc.RazonCobertura_Severo || 0).toFixed(2) + 'x');

                        $('#cellRCBaseEstado').text(rc.RazonCobertura_Base >= 1.0 ? 'Conforme' : 'Déficit').css('color', rc.RazonCobertura_Base >= 1.0 ? '#1e40af' : '#ea580c');
                        $('#cellRCModEstado').text(rc.RazonCobertura_Moderado >= 1.0 ? 'Conforme' : 'Déficit').css('color', rc.RazonCobertura_Moderado >= 1.0 ? '#475569' : '#ea580c');
                        $('#cellRCSeveroEstado').text(rc.RazonCobertura_Severo >= 1.0 ? 'Conforme' : 'Déficit').css('color', rc.RazonCobertura_Severo >= 1.0 ? '#475569' : '#ea580c');

                        var chartRc = $('#chartRazonCoberturaComparativo').highcharts();
                        if (chartRc && chartRc.series && chartRc.series[0]) {
                            chartRc.series[0].setData([
                                { y: rc.RazonCobertura_Base, color: '#2b579a' },
                                { y: rc.RazonCobertura_Moderado, color: '#64748b' },
                                { y: rc.RazonCobertura_Severo, color: '#ea580c' }
                            ], true);
                        }
                    }

                    // 2. Actualizar ICL Estresado
                    if (resp.iclEstresado) {
                        var icl = resp.iclEstresado;
                        $('#badgeTabICLEstres').text(((icl.ICLBase || 0) * 100).toFixed(1) + '%');
                        var chartIcl = $('#chartICLEstresadoComparativo').highcharts();
                        if (chartIcl && chartIcl.series && chartIcl.series[0]) {
                            chartIcl.series[0].setData([
                                { y: icl.ICLBase, color: '#2b579a' },
                                { y: icl.ICLModerado, color: '#64748b' },
                                { y: icl.ICLSevero, color: '#ea580c' }
                            ], true);
                        }
                    }

                    // 3. Actualizar Brechas y FAL
                    if (resp.brechasEstres && window.datosEscenariosBrechas) {
                        var be = resp.brechasEstres;
                        window.datosEscenariosBrechas.base.entradas = be.EntradasBase;
                        window.datosEscenariosBrechas.base.salidas = be.SalidasBase;
                        window.datosEscenariosBrechas.base.gapBanda = be.BrechasBase;
                        window.datosEscenariosBrechas.base.gapAcum = be.AcumuladoBase;
                        window.datosEscenariosBrechas.base.kpi30 = '¢' + (be.BrechasBase && be.BrechasBase.length > 0 ? be.BrechasBase[0] : 0).toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' MM';
                        window.datosEscenariosBrechas.base.kpi90 = '¢' + (be.BrechasBase && be.BrechasBase.length > 2 ? be.BrechasBase[2] : 0).toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' MM';
                        window.datosEscenariosBrechas.base.fal = '¢' + (resp.razonCobertura ? resp.razonCobertura.ActivosLiquidos_Base : 0).toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' MM';

                        window.datosEscenariosBrechas.moderado.entradas = be.EntradasModerado;
                        window.datosEscenariosBrechas.moderado.salidas = be.SalidasModerado;
                        window.datosEscenariosBrechas.moderado.gapBanda = be.BrechasModerado;
                        window.datosEscenariosBrechas.moderado.gapAcum = be.AcumuladoModerado;
                        window.datosEscenariosBrechas.moderado.kpi30 = '¢' + (be.BrechasModerado && be.BrechasModerado.length > 0 ? be.BrechasModerado[0] : 0).toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' MM';
                        window.datosEscenariosBrechas.moderado.kpi90 = '¢' + (be.BrechasModerado && be.BrechasModerado.length > 2 ? be.BrechasModerado[2] : 0).toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' MM';
                        window.datosEscenariosBrechas.moderado.fal = '¢' + (resp.razonCobertura ? resp.razonCobertura.ActivosLiquidos_Moderado : 0).toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' MM';

                        window.datosEscenariosBrechas.severo.entradas = be.EntradasSevero;
                        window.datosEscenariosBrechas.severo.salidas = be.SalidasSevero;
                        window.datosEscenariosBrechas.severo.gapBanda = be.BrechasSevero;
                        window.datosEscenariosBrechas.severo.gapAcum = be.AcumuladoSevero;
                        window.datosEscenariosBrechas.severo.kpi30 = '¢' + (be.BrechasSevero && be.BrechasSevero.length > 0 ? be.BrechasSevero[0] : 0).toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' MM';
                        window.datosEscenariosBrechas.severo.kpi90 = '¢' + (be.BrechasSevero && be.BrechasSevero.length > 2 ? be.BrechasSevero[2] : 0).toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' MM';
                        window.datosEscenariosBrechas.severo.fal = '¢' + (resp.razonCobertura ? resp.razonCobertura.ActivosLiquidos_Severo : 0).toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' MM';

                        if (typeof seleccionarEscenarioBrechas === 'function') {
                            seleccionarEscenarioBrechas('base');
                        }

                        var chartFal = $('#chartBrechasAcumuladoFAL').highcharts();
                        if (chartFal && chartFal.series && chartFal.series.length >= 3) {
                            chartFal.series[0].setData(be.AcumuladoBase, false);
                            chartFal.series[1].setData(be.AcumuladoModerado, false);
                            chartFal.series[2].setData(be.AcumuladoSevero, true);
                        }
                    }

                    // 4. Actualizar Horizonte de Supervivencia y Timelines Visuales
                    if (resp.horizonte) {
                        var hz = resp.horizonte;
                        $('#lblDiasBase').text('> 90 días (' + hz.DiasSupervivenciaBase.toFixed(0) + 'd)');
                        $('#lblDiasMod').text(hz.DiasSupervivenciaModerado.toFixed(0) + ' días');
                        $('#lblDiasSev').text(hz.DiasSupervivenciaSevero.toFixed(0) + ' días');

                        $('#badgeTabHorizonte').text(hz.DiasSupervivenciaBase >= 90 ? '> 90d' : hz.DiasSupervivenciaBase.toFixed(0) + 'd');

                        $('#lblInflexionBase').text(hz.HorizonteBase);
                        $('#lblInflexionMod').text(hz.HorizonteModerado);
                        $('#lblInflexionSev').text(hz.HorizonteSevero);

                        $('#lblBufferBase').text('Buffer: ¢' + (hz.BufferRemanenteBase || 0).toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' MM');
                        $('#lblBufferMod').text('Buffer: ¢' + (hz.BufferRemanenteModerado || 0).toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' MM');

                        // Actualizar barras de tiempo visuales (0 a 90 días)
                        var pctBase = Math.min(100, Math.max(0, (hz.DiasSupervivenciaBase / 90.0) * 100));
                        var pctMod = Math.min(100, Math.max(0, (hz.DiasSupervivenciaModerado / 90.0) * 100));
                        var pctSev = Math.min(100, Math.max(0, (hz.DiasSupervivenciaSevero / 90.0) * 100));
                        $('#progresoBarraBase').css('width', pctBase + '%');
                        $('#progresoBarraMod').css('width', pctMod + '%');
                        $('#progresoBarraSev').css('width', pctSev + '%');

                        var chartHz = $('#chartTrayectoriaSupervivencia').highcharts();
                        if (chartHz && chartHz.series && chartHz.series.length >= 3) {
                            chartHz.series[0].setData(hz.TrayectoriaBase, false);
                            chartHz.series[1].setData(hz.TrayectoriaModerado, false);
                            chartHz.series[2].setData(hz.TrayectoriaSevero, true);
                        }
                    }

                    $('#bannerSimulacionActiva').slideUp(200);
                } else {
                    alert('Error en la simulación: ' + (resp ? resp.message : 'Error desconocido'));
                }
            },
            error: function(err) {
                console.error('Error al procesar la simulación:', err);
            }
        });
    }

    function guardarParametrosEntidad() {
        if (!confirm('¿Desea guardar estos parámetros como los supuestos oficiales para esta entidad?')) return;
        var postData = {
            idEntidad: $('#ddlEntidad').val(),
            supuestos: recopilarSupuestos()
        };

        $.ajax({
            url: '@Url.Action("GuardarParametrosLiquidez", "Liquidez")',
            type: 'POST',
            data: postData,
            success: function(resp) {
                if (resp && resp.success) {
                    alert(resp.message);
                } else {
                    alert('Error al guardar: ' + (resp ? resp.message : 'Error desconocido'));
                }
            },
            error: function() {
                alert('No fue posible contactar el servidor para guardar los parámetros.');
            }
        });
    }

    function restablecerSupuestos() {
        cargarDatosEstres();
    }

