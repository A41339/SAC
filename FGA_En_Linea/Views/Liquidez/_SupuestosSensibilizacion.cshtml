    $(document).ready(function() {
        // Detectar cambios en cualquier parámetro del Escenario Base para activar aviso visual
        $('input.input-base-editable, select[id^="selProyector"]').on('input change', function() {
            $('#bannerSimulacionActiva').slideDown(150);
        });

        // Formateo interactivo de montos y porcentajes con separador de miles y 2 decimales
        $(document).on('focus', '.formato-monto:not([readonly])', function() {
            var n = parseMonto($(this).val());
            if (!isNaN(n)) {
                $(this).val(n);
            }
            $(this).select();
        });

        $(document).on('blur', '.formato-monto:not([readonly])', function() {
            var n = parseMonto($(this).val());
            $(this).val(n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
        });
    });
</script>
