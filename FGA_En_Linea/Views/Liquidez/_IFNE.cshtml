@model FGA.Model.LiquidezIndexViewModel

<div style="display: flex; align-items: center; gap: 14px; margin-bottom: 20px; padding-bottom: 16px; border-bottom: 1px solid #f1f5f9;">
    <img class="img-logo-entidad" width="44" height="44" src="@(Session["Logo"] ?? Url.Content("~/Content/images/FFC.jpg"))" onerror="this.onerror=null;this.src='@Url.Content("~/Content/images/FFC.jpg")';" style="border-radius: 8px; background: #ffffff; padding: 3px; border: 1px solid #e2e8f0; object-fit: contain;" />
    <div>
        <h4 style="margin: 0; font-size: 16px; font-weight: 700; color: #143750;">Indicador de Financiamiento Neto Estable (IFNE) - <span id="lblEntidadIFNE">@Model.NombreEntidad</span></h4>
        <p style="margin: 2px 0 0 0; font-size: 12px; color: #64748b;">Financiamiento Estable Disponible (ASF) frente a Financiamiento Estable Requerido (RSF) a más de un año</p>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div style="background-color: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 8px; padding: 35px 20px; text-align: center; margin-bottom: 20px;">
            <i class="fa fa-hourglass-half" style="font-size: 40px; color: #0284c7; margin-bottom: 14px;"></i>
            <h4 style="font-weight: 700; color: #1e3a8a; margin: 0 0 8px 0;">Módulo Normativo en Configuración</h4>
            <p style="font-size: 13px; color: #64748b; max-width: 650px; margin: 0 auto 16px auto;">
                El cálculo del Indicador de Financiamiento Neto Estable (IFNE) corresponde a la nueva regulación de SUGEF.
                La pestaña se encuentra habilitada estructuralmente a la espera de las especificaciones complementarias del modelo.
            </p>
            <span class="badge" style="background-color: #e0f2fe; color: #0369a1; padding: 6px 14px; font-size: 12px; font-weight: 600; border-radius: 20px;">
                <i class="fa fa-info-circle"></i> Regulación SUGEF en proceso de integración
            </span>
        </div>
    </div>
</div>
