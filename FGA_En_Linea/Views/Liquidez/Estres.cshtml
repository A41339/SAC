        $(document).ready(function() {
            renderGraficoCobertura();
            renderGraficoICLEstresado();
            renderGraficoBrechasEstres();
            renderGraficoSupervivencia();

            $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
                var target = $(e.target).attr('href');
                setTimeout(function () {
                    if (target === '#tab-razon-cobertura') {
                        var c = $('#chartRazonCoberturaComparativo').highcharts();
                        if (c) c.reflow(); else renderGraficoCobertura();
                    } else if (target === '#tab-icl-estresado') {
                        var c = $('#chartICLEstresadoComparativo').highcharts();
                        if (c) c.reflow(); else renderGraficoICLEstresado();
                    } else if (target === '#tab-brechas-estres') {
                        var c1 = $('#chartBrechasBanda').highcharts();
                        var c2 = $('#chartBrechasAcumuladoFAL').highcharts();
                        if (c1) c1.reflow();
                        if (c2) c2.reflow();
                        if (!c1 || !c2) renderGraficoBrechasEstres();
                    } else if (target === '#tab-horizonte') {
                        var c = $('#chartTrayectoriaSupervivencia').highcharts();
                        if (c) c.reflow(); else renderGraficoSupervivencia();
                    }
                }, 60);
            });
        });
