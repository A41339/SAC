<div id="modalSuccess" class="modal fade">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <div class="icon-box">
                    <i class="material-icons"></i>
                </div>
            </div>
            <div class="modal-body">
                <div style="margin-left:50px; margin-right: 50px;">
                    <p id="lbl_mensajeError" class="text-center">La fórmula se guardó con éxito.</p>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-success btn-block" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">

    $(document).ready(function () {
        $("#accordian h3").click(function () {
            $("#accordian ul ul").slideUp();
            if (!$(this).next().is(":visible")) {
                $(this).next().slideDown();
            }
        });
    });

      function guardarFormula() {
        var nombre = $('#Nombre').val();
        var formula = $('#Formula').val();
        var indPorcentaje = $('#IndPorcentaje').is(':checked');

        $.ajax({
            url: '@Url.Action("GuardarFormula", "Indicadores")',
            type: 'POST',
            cache: false,
            async: false,
            data: {
                'Nombre': nombre,
                'Formula': formula,
                'IndPorcentaje': indPorcentaje
            },
            success: function (data) {
                $("#listaIndicadores").html(data);
                $("#modalSuccess").modal('show');
            }
        });
    }

    function help() {
        $("#helpModal").modal('show');
    }

    function catalogo() {
        $("#modalCatalogo").modal('show');
    }

    function refreshGraph() {
         $.ajax({
            url: '@Url.Action("GraficaDetalle", "Indicadores")',
            type: 'POST',
            cache: false,
            async: false,
            data: {
                 'Entidades': $('#IdEntidad').val(),
                 'PeriodoI': $('#PeriodoI').val(),
                 'PeriodoF': $('#PeriodoF').val(),
                 'cmb_indicadores': $('#cmb_indicadores').val(),
                 'cmb_estilo': $('#cmb_estilo').val()
            },
             success: function (result) {
                $('#grafica').html(result);
            }
        });
    }

    $(document).on('click', '#btn_buscar', function () {
        refreshGraph();
    });


      $(document).ready(function () {
            var ControlerNameCompany = "@Url.Content("~/Indicadores")";
            oTableCompany = $("#tbCuentas").dataTable({
            "bRetrieve": true,
             "processing": true, // for show progress bar
                "serverSide": true, // for process server side
                "filter": true, // this is for disable filter (search box)
                "dom": 'lBfrtip',
            "ajax": {
                    "url": "@Url.Content("~/Indicadores/GetCuentas")",
                    "type": "POST",
                    "datatype": "json"
                },
            "buttons": [
                 { extend: 'copyHtml5', exportOptions: { columns: ':visible' } }
                ,{ extend: 'excelHtml5', exportOptions: { columns: ':visible' } }
                ,{ extend: 'pdfHtml5', exportOptions: { columns: ':visible' } }
                ,{ extend: 'print', exportOptions: { columns: ':visible' } }
                ,'colvis'
            ], columnDefs: [{   visible: false }],
            "pageLength": 10,
            "lengthMenu": [[5,10, 25, 50, -1], [5,10, 25, 50, "Todos"]],
                "aoColumns": [
                 {}, {}]
        });
     });

    function formatMillion() {
        return this.value;
    }

    function formatPercent() {
        return this.value + " %";
    }
</script>