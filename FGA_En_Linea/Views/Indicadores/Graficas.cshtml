@*@model IEnumerable<Entities.Entities.Procedures.FGA_Consultar_Tipos_Indicadores_Result>*@
@{
    ViewBag.Title = "Indicadores personalizados";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section ScriptsOrCss
{
    <link rel="stylesheet" href="~/Content/multiselect/docs/css/prettify.min.css" type="text/css">
    <script type="text/javascript" src="~/Content/multiselect/docs/js/prettify.min.js"></script>
    <link rel="stylesheet" href="~/Content/multiselect/dist/css/bootstrap-multiselect.css" type="text/css">
    <script type="text/javascript" src="~/Content/multiselect/dist/js/bootstrap-multiselect.js"></script>
}

<section class="content-header">
    <h1>
        Indicadores personalizados
    </h1>
</section>

<section class="content">

    <div class="row">
        @if (Env.GetUserInfo("roleid") != FGA.Utility.Utilitarios.roleDirectorFGA)
        {
            <div class="col-xs-12">
                <div class="col-md-8">
                    <div class="box box-solid box-info">
                        <div role="form">
                            <div class="box-body">
                                <div class="form-group">
                                    <table style="width:100%">
                                        <tr>
                                            <td>
                                                @Html.Label("Nombre", new { @class = "" })
                                            </td>
                                            <td></td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <input id="Nombre" data-toggle="tooltip" class="form-control" autocomplete="off" name="Nombre" title="En esta opción se nombre el Indicador, por ejemplo: Razón de Endeudamiento" />
                                            </td>
                                            <td>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                @Html.Label("Formula", new { @class = "" })
                                            </td>
                                            <td></td>
                                        </tr>
                                        <tr>
                                            <td class="form-group">
                                                <input id="Formula" data-toggle="tooltip" class="form-control" autocomplete="off" name="Formula" title="Aquí digita la fórmula, por ejemplo: ME30000000/ME10000000" />
                                            </td>
                                            <td>
                                                <a class="text-right" href="javascript:help()" style="margin-left:5px" data-placement="top" title="Ayuda"><i class="btn btn-xs btn-default icon fa fa-question"></i></a>
                                                <a class="text-right" href="javascript:catalogo()" style="margin-left:5px" data-placement="top" title="Ayuda"><i class="btn btn-xs btn-default icon fa fa-dollar"></i></a>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="form-group">
                                                @Html.Label("Porcentaje", new { @class = "checkbox" })
                                                @Html.CheckBox("IndPorcentaje", new { htmlAttributes = new { @class = "js-switch" } })
                                            </td>
                                            <td></td>
                                        </tr>
                                    </table>
                                </div>
                                <div class="box-footer">
                                    <label class="btn btn-facebook" onclick="javascript:guardarFormula()">
                                        Agregar
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div id="accordian">
                        <ul>
                            <li>
                                <h3><i class="fa fa-angle-down"></i> ¿Cómo utilizar cuentas anualizadas, mensuales o acumuladas?</h3>
                                <ul>
                                    <li>
                                        <div class="box box-solid box-info">
                                            <div class="box-body">
                                                Para utilizar una cuenta del catálogo se deberáá anteponer dos letras
                                                <div class="box-body table-responsive">
                                                    <div class="margin">
                                                        <div class="streaming-table">
                                                            <table class="table table-striped table-bordered">
                                                                <tr>
                                                                    <td>AN</td>
                                                                    <td>Anualizado</td>
                                                                    <td>AN100000000</td>
                                                                </tr>
                                                                <tr>
                                                                    <td>ME</td>
                                                                    <td>Mensualizado</td>
                                                                    <td>ME100000000</td>
                                                                </tr>
                                                                <tr>
                                                                    <td>AC</td>
                                                                    <td>Acumulado</td>
                                                                    <td>AC100000000</td>
                                                                </tr>
                                                            </table>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </li>
                                </ul>
                            </li>
                            <li>
                                <h3><i class="fa fa-angle-down"></i> Por días de atraso</h3>
                                <ul>
                                    <li>
                                        <div class="box box-solid box-info">
                                            <div class="box-body">
                                                Para sumar el saldo de operaciónes según sus días de atraso deberáá utilizar los siguientes códigos
                                                <div class="box-body table-responsive">
                                                    <div class="margin">
                                                        <div class="streaming-table">
                                                            <table class="table table-striped table-bordered">
                                                                <tr>
                                                                    <td>V009</td>
                                                                    <td>Al día</td>
                                                                </tr>
                                                                <tr>
                                                                    <td>V010</td>
                                                                    <td>1 - 30 días</td>
                                                                </tr>
                                                                <tr>
                                                                    <td>V011</td>
                                                                    <td>31 - 60 días</td>
                                                                </tr>
                                                                <tr>
                                                                    <td>V012</td>
                                                                    <td>61 - 90 días</td>
                                                                </tr>
                                                                <tr>
                                                                    <td>V013</td>
                                                                    <td>91 - 180 días</td>
                                                                </tr>
                                                                <tr>
                                                                    <td>V014</td>
                                                                    <td>181 - 360 días</td>
                                                                </tr>
                                                                <tr>
                                                                    <td>V016</td>
                                                                    <td>Más de 360 días</td>
                                                                </tr>
                                                                <tr>
                                                                    <td>V015</td>
                                                                    <td>Cobro judicial</td>
                                                                </tr>
                                                            </table>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </li>
                                </ul>
                            </li>
                            <li>
                                <h3><i class="fa fa-angle-down"></i> Por tipo de cartera</h3>
                                <ul>
                                    <li>
                                        <div class="box box-solid box-info">
                                            <div class="box-body">
                                                Para sumar el saldo de operaciónes por tipo de cartera deberáá utilizar los siguientes códigos
                                                <div class="box-body table-responsive">
                                                    <div class="margin">
                                                        <div class="streaming-table">
                                                            <table class="table table-striped table-bordered">
                                                                <tr>
                                                                    <td>V017</td>
                                                                    <td>Cartera consumo</td>
                                                                </tr>
                                                                <tr>
                                                                    <td>V018</td>
                                                                    <td>Cartera vehiculos</td>
                                                                </tr>
                                                                <tr>
                                                                    <td>V019</td>
                                                                    <td>Cartera tarjeta de crédito</td>
                                                                </tr>
                                                                <tr>
                                                                    <td>V020</td>
                                                                    <td>Cartera vivienda residencial</td>
                                                                </tr>
                                                                <tr>
                                                                    <td>V021</td>
                                                                    <td>Cartera micro y pequeña empresa</td>
                                                                </tr>
                                                                <tr>
                                                                    <td>V022</td>
                                                                    <td>Cartera mediana empresa</td>
                                                                </tr>
                                                                <tr>
                                                                    <td>V023</td>
                                                                    <td>Cartera gran empersa</td>
                                                                </tr>
                                                                <tr>
                                                                    <td>V024</td>
                                                                    <td>Cartera gobierno central</td>
                                                                </tr>
                                                                <tr>
                                                                    <td>V025</td>
                                                                    <td>Cartera artículo 167 (Refinanciada)</td>
                                                                </tr>
                                                                <tr>
                                                                    <td>V026</td>
                                                                    <td>Cartera microcredito SBD</td>
                                                                </tr>
                                                                <tr>
                                                                    <td>V027</td>
                                                                    <td>Cartera banca segundo piso SBD</td>
                                                                </tr>
                                                                <tr>
                                                                    <td>V028</td>
                                                                    <td>Cartera banca desarrollo SDB</td>
                                                                </tr>
                                                            </table>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        }
        <div id="tblGraficas">
        </div>
        <div class="col-xs-12">
            <div class="box box-solid box-info">
                <div class="margin">
                    <div class="streaming-table">
                        <span id="found" class="label label-info"></span>
                        <table class="table table-condensed table-striped">
                            <tr>
                                <td class="mobile">
                                    @Html.Label("Entidad:")
                                </td>
                                <td>
                                    @Html.DropDownList("Entidades", null, new { @id = "IdEntidad", style = "width: 200px;" })
                                </td>
                                <td class="mobile">
                                    @Html.Label("Indicador:")
                                </td>
                                <td nowrap="nowrap">
                                    <div id="listaIndicadores">
                                        @Html.Action("ListaIndicadores", "Indicadores")
                                    </div>
                                </td>
                                <td class="mobile">
                                    @Html.Label("Tipo de gráfico:")
                                </td>
                                <td class="mobile" nowrap="nowrap">
                                    <select id="cmb_estilo" name="cmb_estilo" style="width: 200px;">
                                        <option value="0" selected>LINEAS</option>
                                        <option value="1">COLUMNAS</option>
                                    </select>
                                </td>

                            </tr>
                            <tr>
                                <td class="mobile">
                                    @Html.Label("Inicio:")
                                </td>
                                <td nowrap="nowrap" class="form-group">
                                    <input name="PeriodoI" id="PeriodoI" class="datecontrol" style="width: 180px;" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo1"].ToString()).ToString("MM/yyyy")" />
                                </td>
                                <td class="mobile">
                                    @Html.Label("Final:")
                                </td>
                                <td nowrap="nowrap" class="form-group">
                                    <input name="PeriodoF" id="PeriodoF" class="datecontrol" style="width: 180px;" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo2"].ToString()).ToString("MM/yyyy")" />
                                </td>
                                <td>
                                    <label class="btn btn-facebook">
                                        Generar<input type="submit" name="submit" id="btn_buscar" style="display: none;">
                                    </label>
                                </td>
                            </tr>

                        </table>
                    </div>
                </div>
            </div>
            <div id="grafica">
            </div>
        </div>
    </div>
</section>



<div class="modal fade" id="modalCatalogo" tabindex="-1" role="dialog" aria-labelledby="deleteLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <div class="box-header with-border">
                    <img width="50" height="50" src="@Session["Logo"]" />
                    <h3 id="titulo" style="padding-bottom: 10px;" class="box-title">Catálogo de cuentas</h3>
                </div>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <div class="margin">
                        <div class="streaming-table">
                            <table id="tbCuentas" style="width:100%" class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th> Cuenta  </th>
                                        <th> Nombre  </th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                            <div id="summary">
                                <div>
                                </div>
                            </div>
                            <br />
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-dismiss="modal">Inicio</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="helpModal" tabindex="-1" role="dialog" aria-labelledby="deleteLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <div class="box-header with-border">
                    <img width="50" height="50" src="@Session["Logo"]" />
                    <h3 id="titulo" style="padding-bottom: 10px;" class="box-title">Ayuda</h3>
                </div>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <div class="margin">
                        <div class="streaming-table">
                            <table class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th>
                                            Nombre
                                        </th>
                                        <th>
                                            Fórmula correspondiente
                                        </th>
                                    </tr>
                                </thead>
                                <tr>
                                    <td>Total Pasivo / Activo Total</td>
                                    <td>ME20000000 / ME10000000</td>
                                </tr>
                                <tr>
                                    <td>Cartera Consumo / Cartera Bruta</td>
                                    <td>V017 / (V017 + V018 + V019 + V020 + V021 + V022 + V023 + V024 + V025 + V026 + V027 + V028)</td>
                                </tr>
                                <tr>
                                    <td>Estimación para cartera de crédito / cartera vencida</td>
                                    <td>ME13900000 / (V010 + V011 + V012 + V013 + V014 + V015 + V016)</td>
                                </tr>

                                <tr>
                                    <td>Gasto Personal / Gasto Administrativo</td>
                                    <td>AC44100000 / AC44000000</td>
                                </tr>

                                <tr>
                                    <td>Ingresos financieros - Gasto financiero / Gasto Administrativo + Gasto por estimaciones de deterioro de activos</td>
                                    <td>(AN50000000 - AN40000000) / (AN44000000 + AN42000000)</td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-dismiss="modal">Inicio</button>
            </div>
        </div>
    </div>
</div>

