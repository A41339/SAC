@*@model IEnumerable<Entities.Entities.Procedures.FGA_Consultar_Tipos_Indicadores_Result>*@
@{
    ViewBag.Title = "Indicadores personalizados";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section ScriptsOrCss
{
    <link rel="stylesheet" href="~/Content/multiselect/docs/css/prettify.min.css" type="text/css">
    <script type="text/javascript" src="~/Content/multiselect/docs/js/prettify.min.js"></script>
    <link rel="stylesheet" href="~/Content/multiselect/dist/css/bootstrap-multiselect.css" type="text/css">
    <script type="text/javascript" src="~/Content/multiselect/dist/js/bootstrap-multiselect.js"></script>
}

<section class="content-header">
    <h1>
        <i class="fa fa-bar-chart"></i> Indicadores Personalizados
        <small>Generaci&oacute;n din&aacute;mica y consulta gr&aacute;fica de indicadores configurados.</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="#">Informaci&oacute;n Financiera</a></li>
        <li class="active">Gr&aacute;ficas Personalizadas</li>
    </ol>
</section>

<section class="content">
    <div class="row">

        @if (Env.GetUserInfo("roleid") != FGA.Utility.Utilitarios.roleDirectorFGA)
        {
            <div class="col-xs-12">
                <div class="row">

                    <!-- ═══════════════════════════════════════
                         COLUMNA IZQUIERDA: Creador de fórmula
                    ═══════════════════════════════════════ -->
                    <div class="col-md-8">
                        <div class="modern-table-card" style="margin-bottom: 24px;">
                            <div class="modern-table-header" style="padding: 18px 22px; border-bottom: 1px solid #e2e8f0;">
                                <div>
                                    <h3 class="modern-table-title" style="margin: 0;">
                                        <i class="fa fa-plus-circle" style="color: #0284c7; margin-right: 7px;"></i>
                                        Registrar nuevo indicador
                                    </h3>
                                    <p class="modern-table-subtitle" style="margin: 4px 0 0 0;">
                                        Defina nombre, fórmula y tipo de resultado para su indicador personalizado
                                    </p>
                                </div>
                            </div>

                            <div style="padding: 22px 24px;">

                                <!-- Campo: Nombre -->
                                <div class="form-group" style="margin-bottom: 18px;">
                                    <label for="Nombre" style="font-size: 13px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">
                                        <i class="fa fa-tag" style="color: #0284c7; margin-right: 5px;"></i>
                                        Nombre del indicador
                                    </label>
                                    <input id="Nombre"
                                           data-toggle="tooltip"
                                           class="form-control modern-select"
                                           autocomplete="off"
                                           name="Nombre"
                                           placeholder="Ej: Razón de Endeudamiento"
                                           title="En esta opción se nombra el indicador, por ejemplo: Razón de Endeudamiento" />
                                </div>

                                <!-- Campo: Fórmula -->
                                <div class="form-group" style="margin-bottom: 18px;">
                                    <label for="Formula" style="font-size: 13px; font-weight: 600; color: #374151; display: block; margin-bottom: 6px;">
                                        <i class="fa fa-calculator" style="color: #0284c7; margin-right: 5px;"></i>
                                        Fórmula
                                    </label>
                                    <div style="display: flex; gap: 8px; align-items: center;">
                                        <input id="Formula"
                                               data-toggle="tooltip"
                                               class="form-control modern-select"
                                               autocomplete="off"
                                               name="Formula"
                                               placeholder="Ej: ME30000000/ME10000000"
                                               style="flex: 1;"
                                               title="Aquí digita la fórmula, por ejemplo: ME30000000/ME10000000" />
                                        <button type="button"
                                                onclick="javascript:help()"
                                                class="btn-modern-filter"
                                                style="padding: 8px 13px; border-radius: 8px; white-space: nowrap;"
                                                title="Ver ejemplos de fórmulas">
                                            <i class="fa fa-question-circle"></i> Ejemplos
                                        </button>
                                        <button type="button"
                                                onclick="javascript:catalogo()"
                                                class="btn-modern-filter"
                                                style="padding: 8px 13px; border-radius: 8px; background: linear-gradient(135deg,#059669 0%,#0d7377 100%); white-space: nowrap;"
                                                title="Catálogo de cuentas disponibles">
                                            <i class="fa fa-book"></i> Catálogo
                                        </button>
                                    </div>
                                </div>

                                <!-- Campo: Porcentaje -->
                                <div class="form-group" style="margin-bottom: 22px;">
                                    <label style="font-size: 13px; font-weight: 600; color: #374151; display: block; margin-bottom: 8px;">
                                        <i class="fa fa-percent" style="color: #0284c7; margin-right: 5px;"></i>
                                        Mostrar como porcentaje
                                    </label>
                                    <div style="display: flex; align-items: center; gap: 10px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px 16px;">
                                        @Html.CheckBox("IndPorcentaje", new { htmlAttributes = new { @class = "js-switch", id = "IndPorcentaje" } })
                                        <span style="font-size: 13px; color: #64748b;">
                                            Active esta opción si el resultado debe expresarse en porcentaje (%)
                                        </span>
                                    </div>
                                </div>

                                <!-- Botón Agregar -->
                                <div style="display: flex; justify-content: flex-end;">
                                    <button type="button"
                                            class="btn-modern-filter"
                                            onclick="javascript:guardarFormula()"
                                            style="padding: 10px 28px; font-size: 14px; border-radius: 8px;">
                                        <i class="fa fa-save"></i> Guardar indicador
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ═══════════════════════════════════════
                         COLUMNA DERECHA: Panel de ayuda acordeón
                    ═══════════════════════════════════════ -->
                    <div class="col-md-4">
                        <div class="modern-table-card" style="margin-bottom: 24px;">
                            <div style="padding: 16px 20px; border-bottom: 1px solid #e2e8f0;">
                                <h4 style="margin: 0; font-size: 14px; font-weight: 700; color: #143750;">
                                    <i class="fa fa-book" style="color: #0284c7; margin-right: 6px;"></i>
                                    Guía de referencia rápida
                                </h4>
                            </div>

                            <div id="accordian" style="padding: 8px 0;">

                                <!-- Sección 1: Tipos de cuenta -->
                                <div class="graficas-accordion-item">
                                    <div class="graficas-accordion-header" onclick="toggleAccordion(this)">
                                        <span>
                                            <i class="fa fa-table" style="color: #0284c7; margin-right: 7px;"></i>
                                            Cuentas anualizadas, mensuales o acumuladas
                                        </span>
                                        <i class="fa fa-chevron-down graficas-accordion-chevron"></i>
                                    </div>
                                    <div class="graficas-accordion-body" style="display:none;">
                                        <p style="font-size: 12px; color: #64748b; margin-bottom: 10px; line-height: 1.5;">
                                            Para utilizar una cuenta del catálogo, se debe anteponer dos letras que indican el tipo de cálculo:
                                        </p>
                                        <table class="table table-sm" style="font-size: 12px; margin-bottom: 0;">
                                            <thead style="background: #f1f5f9;">
                                                <tr>
                                                    <th style="padding: 6px 10px; font-weight: 700; color: #374151;">Prefijo</th>
                                                    <th style="padding: 6px 10px; font-weight: 700; color: #374151;">Tipo</th>
                                                    <th style="padding: 6px 10px; font-weight: 700; color: #374151;">Ejemplo</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td style="padding: 6px 10px;"><span class="label" style="background:#0284c7; color:#fff; padding: 2px 7px; border-radius:4px;">AN</span></td>
                                                    <td style="padding: 6px 10px; color: #374151;">Anualizado</td>
                                                    <td style="padding: 6px 10px; font-family: monospace; color: #059669;">AN10000000</td>
                                                </tr>
                                                <tr>
                                                    <td style="padding: 6px 10px;"><span class="label" style="background:#7c3aed; color:#fff; padding: 2px 7px; border-radius:4px;">ME</span></td>
                                                    <td style="padding: 6px 10px; color: #374151;">Mensualizado</td>
                                                    <td style="padding: 6px 10px; font-family: monospace; color: #059669;">ME10000000</td>
                                                </tr>
                                                <tr>
                                                    <td style="padding: 6px 10px;"><span class="label" style="background:#d97706; color:#fff; padding: 2px 7px; border-radius:4px;">AC</span></td>
                                                    <td style="padding: 6px 10px; color: #374151;">Acumulado</td>
                                                    <td style="padding: 6px 10px; font-family: monospace; color: #059669;">AC10000000</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                                <!-- Sección 2: Días de atraso -->
                                <div class="graficas-accordion-item">
                                    <div class="graficas-accordion-header" onclick="toggleAccordion(this)">
                                        <span>
                                            <i class="fa fa-clock-o" style="color: #d97706; margin-right: 7px;"></i>
                                            Por días de atraso
                                        </span>
                                        <i class="fa fa-chevron-down graficas-accordion-chevron"></i>
                                    </div>
                                    <div class="graficas-accordion-body" style="display:none;">
                                        <p style="font-size: 12px; color: #64748b; margin-bottom: 10px; line-height: 1.5;">
                                            Para sumar el saldo de operaciones según sus días de atraso, utilice los siguientes códigos:
                                        </p>
                                        <table class="table table-sm" style="font-size: 12px; margin-bottom: 0;">
                                            <thead style="background: #f1f5f9;">
                                                <tr>
                                                    <th style="padding: 6px 10px; font-weight: 700; color: #374151;">Código</th>
                                                    <th style="padding: 6px 10px; font-weight: 700; color: #374151;">Rango</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr><td style="padding:5px 10px; font-family:monospace; color:#d97706;">V009</td><td style="padding:5px 10px; color:#374151;">Al día</td></tr>
                                                <tr><td style="padding:5px 10px; font-family:monospace; color:#d97706;">V010</td><td style="padding:5px 10px; color:#374151;">1 – 30 días</td></tr>
                                                <tr><td style="padding:5px 10px; font-family:monospace; color:#d97706;">V011</td><td style="padding:5px 10px; color:#374151;">31 – 60 días</td></tr>
                                                <tr><td style="padding:5px 10px; font-family:monospace; color:#d97706;">V012</td><td style="padding:5px 10px; color:#374151;">61 – 90 días</td></tr>
                                                <tr><td style="padding:5px 10px; font-family:monospace; color:#d97706;">V013</td><td style="padding:5px 10px; color:#374151;">91 – 180 días</td></tr>
                                                <tr><td style="padding:5px 10px; font-family:monospace; color:#d97706;">V014</td><td style="padding:5px 10px; color:#374151;">181 – 360 días</td></tr>
                                                <tr><td style="padding:5px 10px; font-family:monospace; color:#d97706;">V016</td><td style="padding:5px 10px; color:#374151;">Más de 360 días</td></tr>
                                                <tr><td style="padding:5px 10px; font-family:monospace; color:#d97706;">V015</td><td style="padding:5px 10px; color:#374151;">Cobro judicial</td></tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                                <!-- Sección 3: Tipo de cartera -->
                                <div class="graficas-accordion-item">
                                    <div class="graficas-accordion-header" onclick="toggleAccordion(this)">
                                        <span>
                                            <i class="fa fa-briefcase" style="color: #059669; margin-right: 7px;"></i>
                                            Por tipo de cartera
                                        </span>
                                        <i class="fa fa-chevron-down graficas-accordion-chevron"></i>
                                    </div>
                                    <div class="graficas-accordion-body" style="display:none;">
                                        <p style="font-size: 12px; color: #64748b; margin-bottom: 10px; line-height: 1.5;">
                                            Para sumar el saldo de operaciones por tipo de cartera, utilice los siguientes códigos:
                                        </p>
                                        <table class="table table-sm" style="font-size: 12px; margin-bottom: 0;">
                                            <thead style="background: #f1f5f9;">
                                                <tr>
                                                    <th style="padding: 6px 10px; font-weight: 700; color: #374151;">Código</th>
                                                    <th style="padding: 6px 10px; font-weight: 700; color: #374151;">Cartera</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr><td style="padding:5px 10px; font-family:monospace; color:#059669;">V017</td><td style="padding:5px 10px; color:#374151;">Cartera consumo</td></tr>
                                                <tr><td style="padding:5px 10px; font-family:monospace; color:#059669;">V018</td><td style="padding:5px 10px; color:#374151;">Cartera vehículos</td></tr>
                                                <tr><td style="padding:5px 10px; font-family:monospace; color:#059669;">V019</td><td style="padding:5px 10px; color:#374151;">Cartera tarjeta de crédito</td></tr>
                                                <tr><td style="padding:5px 10px; font-family:monospace; color:#059669;">V020</td><td style="padding:5px 10px; color:#374151;">Cartera vivienda residencial</td></tr>
                                                <tr><td style="padding:5px 10px; font-family:monospace; color:#059669;">V021</td><td style="padding:5px 10px; color:#374151;">Cartera micro y pequeña empresa</td></tr>
                                                <tr><td style="padding:5px 10px; font-family:monospace; color:#059669;">V022</td><td style="padding:5px 10px; color:#374151;">Cartera mediana empresa</td></tr>
                                                <tr><td style="padding:5px 10px; font-family:monospace; color:#059669;">V023</td><td style="padding:5px 10px; color:#374151;">Cartera gran empresa</td></tr>
                                                <tr><td style="padding:5px 10px; font-family:monospace; color:#059669;">V024</td><td style="padding:5px 10px; color:#374151;">Cartera gobierno central</td></tr>
                                                <tr><td style="padding:5px 10px; font-family:monospace; color:#059669;">V025</td><td style="padding:5px 10px; color:#374151;">Cartera artículo 167 (Refinanciada)</td></tr>
                                                <tr><td style="padding:5px 10px; font-family:monospace; color:#059669;">V026</td><td style="padding:5px 10px; color:#374151;">Cartera microcrédito SBD</td></tr>
                                                <tr><td style="padding:5px 10px; font-family:monospace; color:#059669;">V027</td><td style="padding:5px 10px; color:#374151;">Cartera banca segundo piso SBD</td></tr>
                                                <tr><td style="padding:5px 10px; font-family:monospace; color:#059669;">V028</td><td style="padding:5px 10px; color:#374151;">Cartera banca desarrollo SBD</td></tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                </div><!-- /row -->
            </div>
        }

        <!-- Lista de gráficas registradas -->
        <div id="tblGraficas" class="col-xs-12">
        </div>

        <!-- Barra de generación de gráfico -->
        <div class="col-xs-12">
            <div class="modern-filter-card">
                <div class="modern-filter-toolbar">
                    <div class="filter-item">
                        <label for="IdEntidad"><i class="fa fa-university"></i> Entidad:</label>
                        @Html.DropDownList("Entidades", null, new { @id = "IdEntidad", @class = "form-control modern-select", style = "min-width: 180px;" })
                    </div>
                    <div class="filter-item">
                        <label><i class="fa fa-line-chart"></i> Indicador:</label>
                        <div id="listaIndicadores">
                            @Html.Action("ListaIndicadores", "Indicadores")
                        </div>
                    </div>
                    <div class="filter-item">
                        <label for="cmb_estilo"><i class="fa fa-bar-chart"></i> Tipo de gráfico:</label>
                        <select id="cmb_estilo" name="cmb_estilo" class="form-control modern-select" style="min-width: 140px;">
                            <option value="0" selected>LÍNEAS</option>
                            <option value="1">COLUMNAS</option>
                        </select>
                    </div>
                    <div class="filter-item">
                        <label for="PeriodoI"><i class="fa fa-calendar"></i> Inicio:</label>
                        <div class="modern-input-wrapper">
                            <input name="PeriodoI" id="PeriodoI" class="datecontrol form-control modern-date-input" style="min-width: 130px;" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo1"].ToString()).ToString("MM/yyyy")" />
                        </div>
                    </div>
                    <div class="filter-item">
                        <label for="PeriodoF"><i class="fa fa-calendar"></i> Final:</label>
                        <div class="modern-input-wrapper">
                            <input name="PeriodoF" id="PeriodoF" class="datecontrol form-control modern-date-input" style="min-width: 130px;" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo2"].ToString()).ToString("MM/yyyy")" />
                        </div>
                    </div>
                    <div class="filter-item" style="margin-left: auto;">
                        <button type="button" id="btn_buscar" class="btn-modern-filter">
                            <i class="fa fa-search"></i> Generar
                        </button>
                    </div>
                </div>
            </div>
            <div id="grafica">
            </div>
        </div>

    </div>
</section>


<!-- ═══════════════════════════════════════
     MODAL: Catálogo de cuentas
═══════════════════════════════════════ -->
<div class="modal fade" id="modalCatalogo" tabindex="-1" role="dialog" aria-labelledby="modalCatalogoLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="border-radius: 14px; overflow: hidden; border: none; box-shadow: 0 12px 36px rgba(0,0,0,0.2);">
            <div class="modal-header" style="background: linear-gradient(135deg,#143750 0%,#0d7377 100%); padding: 18px 22px; display: flex; align-items: center; gap: 12px;">
                <div style="display: flex; align-items: center; gap: 12px; flex: 1;">
                    @if (Session["Logo"] != null)
                    {
                        <img width="36" height="36" src="@Session["Logo"]" style="border-radius: 6px; background: #fff; padding: 2px; object-fit: contain;" />
                    }
                    <h4 id="modalCatalogoLabel" class="modal-title" style="margin: 0; color: #ffffff; font-size: 16px; font-weight: 700;">
                        <i class="fa fa-book" style="margin-right: 7px;"></i> Catálogo de cuentas
                    </h4>
                </div>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"
                        style="color: #ffffff; opacity: 0.85; font-size: 22px; text-shadow: none; margin: 0; padding: 0;">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" style="padding: 22px 24px;">
                <div class="table-responsive">
                    <table id="tbCuentas" style="width:100%" class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Cuenta</th>
                                <th>Nombre</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                    <div id="summary"><div></div></div>
                </div>
            </div>
            <div class="modal-footer" style="background: #f8fafc; border-top: 1px solid #e2e8f0; padding: 12px 22px; justify-content: flex-end; display: flex;">
                <button type="button" class="btn-modern-filter" data-dismiss="modal" style="padding: 8px 20px; border-radius: 8px;">
                    <i class="fa fa-times"></i> Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════
     MODAL: Ejemplos de fórmulas (Ayuda)
═══════════════════════════════════════ -->
<div class="modal fade" id="helpModal" tabindex="-1" role="dialog" aria-labelledby="helpModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="border-radius: 14px; overflow: hidden; border: none; box-shadow: 0 12px 36px rgba(0,0,0,0.2);">
            <div class="modal-header" style="background: linear-gradient(135deg,#143750 0%,#0d7377 100%); padding: 18px 22px; display: flex; align-items: center; gap: 12px;">
                <div style="display: flex; align-items: center; gap: 12px; flex: 1;">
                    @if (Session["Logo"] != null)
                    {
                        <img width="36" height="36" src="@Session["Logo"]" style="border-radius: 6px; background: #fff; padding: 2px; object-fit: contain;" />
                    }
                    <h4 id="helpModalLabel" class="modal-title" style="margin: 0; color: #ffffff; font-size: 16px; font-weight: 700;">
                        <i class="fa fa-question-circle" style="margin-right: 7px;"></i> Ejemplos de fórmulas
                    </h4>
                </div>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"
                        style="color: #ffffff; opacity: 0.85; font-size: 22px; text-shadow: none; margin: 0; padding: 0;">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" style="padding: 22px 24px;">
                <p style="font-size: 13px; color: #64748b; margin-bottom: 14px;">
                    Los siguientes son ejemplos de indicadores financieros comunes y la fórmula correspondiente que puede copiar directamente:
                </p>
                <table class="table table-striped table-bordered" style="font-size: 13px;">
                    <thead style="background: #f1f5f9;">
                        <tr>
                            <th style="color: #374151; padding: 10px 14px;">Nombre del indicador</th>
                            <th style="color: #374151; padding: 10px 14px;">Fórmula correspondiente</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding: 10px 14px; vertical-align: middle;">Total Pasivo / Activo Total</td>
                            <td style="padding: 10px 14px; font-family: monospace; color: #0284c7;">ME20000000 / ME10000000</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px 14px; vertical-align: middle;">Cartera Consumo / Cartera Bruta</td>
                            <td style="padding: 10px 14px; font-family: monospace; color: #0284c7; font-size: 12px;">V017 / (V017 + V018 + V019 + V020 + V021 + V022 + V023 + V024 + V025 + V026 + V027 + V028)</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px 14px; vertical-align: middle;">Estimación cartera crédito / Cartera vencida</td>
                            <td style="padding: 10px 14px; font-family: monospace; color: #0284c7;">ME13900000 / (V010 + V011 + V012 + V013 + V014 + V015 + V016)</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px 14px; vertical-align: middle;">Gasto Personal / Gasto Administrativo</td>
                            <td style="padding: 10px 14px; font-family: monospace; color: #0284c7;">AC44100000 / AC44000000</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px 14px; vertical-align: middle;">Margen Financiero / (Gasto Administrativo + Estimaciones)</td>
                            <td style="padding: 10px 14px; font-family: monospace; color: #0284c7;">(AN50000000 - AN40000000) / (AN44000000 + AN42000000)</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer" style="background: #f8fafc; border-top: 1px solid #e2e8f0; padding: 12px 22px; justify-content: flex-end; display: flex;">
                <button type="button" class="btn-modern-filter" data-dismiss="modal" style="padding: 8px 20px; border-radius: 8px;">
                    <i class="fa fa-times"></i> Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════
     MODAL: Éxito al guardar
═══════════════════════════════════════ -->
<div id="modalSuccess" class="modal fade">
    <div class="modal-dialog" style="max-width: 400px;">
        <div class="modal-content" style="border-radius: 14px; overflow: hidden; border: none; box-shadow: 0 12px 36px rgba(0,0,0,0.18);">
            <div class="modal-body" style="padding: 36px 32px; text-align: center;">
                <div style="width: 60px; height: 60px; border-radius: 50%; background: #d1fae5; display: flex; align-items: center; justify-content: center; margin: 0 auto 18px;">
                    <i class="fa fa-check" style="color: #059669; font-size: 28px;"></i>
                </div>
                <h4 style="color: #1e293b; font-weight: 700; margin: 0 0 8px 0;">¡Indicador guardado!</h4>
                <p id="lbl_mensajeError" style="color: #64748b; font-size: 14px; margin: 0;">
                    La fórmula se guardó con éxito.
                </p>
            </div>
            <div class="modal-footer" style="background: #f8fafc; border-top: 1px solid #e2e8f0; padding: 14px 22px; display: flex; justify-content: center;">
                <button class="btn-modern-filter" data-dismiss="modal" style="padding: 9px 28px; border-radius: 8px; width: 100%;">
                    <i class="fa fa-check"></i> Aceptar
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    /* Acordeón de ayuda en Indicadores/Graficas */
    .graficas-accordion-item {
        border-bottom: 1px solid #e2e8f0;
    }

    .graficas-accordion-item:last-child {
        border-bottom: none;
    }

    .graficas-accordion-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 13px 20px;
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
        color: #1e293b;
        transition: background 0.2s ease;
        user-select: none;
    }

    .graficas-accordion-header:hover {
        background: #f0f9ff;
    }

    .graficas-accordion-chevron {
        color: #94a3b8;
        font-size: 12px;
        transition: transform 0.25s ease;
    }

    .graficas-accordion-header.open .graficas-accordion-chevron {
        transform: rotate(180deg);
        color: #0284c7;
    }

    .graficas-accordion-body {
        padding: 0 16px 14px 16px;
        background: #f8fafc;
    }

    .graficas-accordion-body table thead tr th {
        border-bottom: 2px solid #e2e8f0;
    }
</style>

<script type="text/javascript">

    /* ---- Acordeón propio (reemplaza el jQuery accordion antiguo) ---- */
    function toggleAccordion(header) {
        var body = header.nextElementSibling;
        var isOpen = header.classList.contains('open');

        /* Colapsar todos */
        document.querySelectorAll('.graficas-accordion-header').forEach(function (h) {
            h.classList.remove('open');
            h.nextElementSibling.style.display = 'none';
        });

        /* Si no estaba abierto, abrir el actual */
        if (!isOpen) {
            header.classList.add('open');
            body.style.display = 'block';
        }
    }

    /* ---- Guardar fórmula ---- */
    function guardarFormula() {
        var nombre = $('#Nombre').val();
        var formula = $('#Formula').val();
        var indPorcentaje = $('#IndPorcentaje').is(':checked');

        $.ajax({
            url: '@Url.Action("GuardarFormula", "Indicadores")',
            type: 'POST',
            cache: false,
            async: false,
            data: {
                'Nombre': nombre,
                'Formula': formula,
                'IndPorcentaje': indPorcentaje
            },
            success: function (data) {
                $("#listaIndicadores").html(data);
                $("#modalSuccess").modal('show');
            }
        });
    }

    function help() {
        $("#helpModal").modal('show');
    }

    function catalogo() {
        $("#modalCatalogo").modal('show');
    }

    function refreshGraph() {
        $.ajax({
            url: '@Url.Action("GraficaDetalle", "Indicadores")',
            type: 'POST',
            cache: false,
            async: false,
            data: {
                'Entidades': $('#IdEntidad').val(),
                'PeriodoI': $('#PeriodoI').val(),
                'PeriodoF': $('#PeriodoF').val(),
                'cmb_indicadores': $('#cmb_indicadores').val(),
                'cmb_estilo': $('#cmb_estilo').val()
            },
            success: function (result) {
                $('#grafica').html(result);
            }
        });
    }

    $(document).on('click', '#btn_buscar', function () {
        refreshGraph();
    });

    $(document).ready(function () {
        var ControlerNameCompany = "@Url.Content("~/Indicadores")";
        oTableCompany = $("#tbCuentas").dataTable({
            "bRetrieve": true,
            "processing": true,
            "serverSide": true,
            "filter": true,
            "dom": 'lBfrtip',
            "ajax": {
                "url": "@Url.Content("~/Indicadores/GetCuentas")",
                "type": "POST",
                "datatype": "json"
            },
            "buttons": [
                { extend: 'copyHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'excelHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'pdfHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'print', exportOptions: { columns: ':visible' } },
                'colvis'
            ],
            columnDefs: [{ visible: false }],
            "pageLength": 10,
            "lengthMenu": [[5, 10, 25, 50, -1], [5, 10, 25, 50, "Todos"]],
            "aoColumns": [{}, {}]
        });
    });

    function formatMillion() {
        return this.value;
    }

    function formatPercent() {
        return this.value + " %";
    }

</script>