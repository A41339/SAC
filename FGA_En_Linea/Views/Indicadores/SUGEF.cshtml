@{
    ViewBag.Title = "CAMEL";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section ScriptsOrCss
{
    <link rel="stylesheet" href="~/Content/multiselect/docs/css/prettify.min.css" type="text/css">
    <script type="text/javascript" src="~/Content/multiselect/docs/js/prettify.min.js"></script>
    <link rel="stylesheet" href="~/Content/multiselect/dist/css/bootstrap-multiselect.css" type="text/css">
    <script type="text/javascript" src="~/Content/multiselect/dist/js/bootstrap-multiselect.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

}

<section class="content-header">
    <h1>
        SUGEF
    </h1>
</section>

<section class="content">
    <div class="box box-solid box-info">
        <div class="box-body">
            @using (Html.BeginForm("BuscarSUGEF", "Indicadores", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmCAMEL" }))
            {
                @Html.AntiForgeryToken()
                <div style="background:#f8fafc; padding:16px 20px; border-radius:8px; margin-bottom:20px; border:1px solid #e2e8f0;">
                    <div style="display:flex; flex-wrap:wrap; gap:16px; align-items:flex-end;">
                        <div style="display:flex; flex-direction:column; gap:4px;">
                            <label style="font-weight:600; font-size:12px; color:#475569; margin:0;">Entidad</label>
                            @Html.DropDownList("Entidades", null, new { @id = "IdEntidad", @class = "form-control input-sm", style = "min-width: 220px; height:34px;" })
                        </div>
                        <div style="display:flex; flex-direction:column; gap:4px;">
                            <label style="font-weight:600; font-size:12px; color:#475569; margin:0;">Periodo</label>
                            <input name="PeriodoI" id="PeriodoI" class="datecontrol form-control input-sm" style="width: 150px; height:34px;" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo1"].ToString()).ToString("MM/yyyy")" />
                        </div>
                        <div style="display:flex; flex-direction:column; gap:4px;">
                            <label style="font-weight:600; font-size:12px; color:#475569; margin:0;">Comparar con</label>
                            <input name="PeriodoF" id="PeriodoF" class="datecontrol form-control input-sm" style="width: 150px; height:34px;" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo2"].ToString()).ToString("MM/yyyy")" />
                        </div>
                        <div style="display:flex; flex-direction:column; gap:4px;">
                            <label style="font-weight:600; font-size:12px; color:#475569; margin:0;">Resumido</label>
                            @Html.DropDownList("TipoReporte", new List<SelectListItem> { new SelectListItem { Value = "S", Text = "Sí" },
                                                                                      new SelectListItem { Value = "N", Text = "No" }
                                                                                    }, new { @id = "TipoReporte", @class = "form-control input-sm", style = "min-width: 100px; height:34px;" })
                        </div>
                        <div>
                            <button type="submit" class="btn btn-primary" style="height:34px; padding:0 20px; font-weight:600; display:inline-flex; align-items:center; gap:6px;">
                                <i class="fa fa-search"></i> Generar
                            </button>
                        </div>
                    </div>
                </div>
            }

            <div class="nav-tabs-custom">
                <ul class="nav nav-tabs">
                    <li class="active"><a href="#tab_1" data-toggle="tab">Normativos</a></li>
                    <li class=""><a href="#tab_2" data-toggle="tab">Suficiencia Patrimonial</a></li>
                </ul>
                <div class="tab-content">
                    <div class="tab-pane active" id="tab_1">
                        <div class="row">
                            <div class="col-xs-12">
                                <div class="box-body table-responsive">
                                    <div class="margin">
                                        <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 12px;">
                                            @if (Session["Logo"] != null)
                                            {
                                                <img width="50" height="50" src="@Session["Logo"]" style="object-fit: contain;" />
                                            }
                                            <h4 style="margin: 0; font-weight: 700; color: #1e293b;">Normativos</h4>
                                        </div>
                                        <div class="streaming-table">
                                            <span id="found" class="label label-info"></span>
                                            <table id="tbCAMEL" class="table table-striped table-bordered" style="width:100%">
                                                <thead>
                                                    <tr>
                                                        <th> Id </th>
                                                        <th> Cuenta </th>
                                                        <th> @FGA.Utility.Utilitarios.toUpperFirstLetter(FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo1"].ToString()).ToString("MMMM yyyy")) </th>
                                                        <th> @FGA.Utility.Utilitarios.toUpperFirstLetter(FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo2"].ToString()).ToString("MMMM yyyy")) </th>
                                                        <th> @FGA.Utility.Utilitarios.toUpperFirstLetter(FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo1"].ToString()).ToString("MMMM yyyy")) (Promedio) </th>
                                                        <th> @FGA.Utility.Utilitarios.toUpperFirstLetter(FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo2"].ToString()).ToString("MMMM yyyy")) (Promedio) </th>
                                                        <th style="width: 50px;"></th>
                                                    </tr>
                                                </thead>
                                                <tbody></tbody>
                                            </table>
                                            <div id="summary">
                                                <div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane" id="tab_2">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="box box-solid box-info" style="margin-bottom: 25px;">
                                    <div class="box-header with-border" style="display: flex; align-items: center; gap: 15px; padding: 12px 15px;">
                                        @if (Session["Logo"] != null)
                                        {
                                            <img width="45" height="45" src="@Session["Logo"]" style="object-fit: contain;" />
                                        }
                                        <h4 class="box-title" style="margin: 0; font-weight: 700; color: #1e293b;">Suficiencia a partir de enero 2025</h4>
                                    </div>
                                    <div class="box-body">
                                        <div id="alerta-diferencia"
                                             style="display: none; background: #fff3cd; color: #856404; padding: 12px 16px; margin-bottom: 15px; border: 1px solid #ffeeba; border-radius: 6px; align-items: center;">
                                            <i class="fas fa-exclamation-triangle fa-2x"
                                               style="margin-right: 15px; color: #f59e0b;"></i>
                                            <span id="mensaje-alerta" style="font-size: 15px; font-weight: 600;"></span>
                                        </div>
                                        <div class="streaming-table">
                                            <span id="found" class="label label-info"></span>
                                            <table id="tbSuficiencia306" class="table table-striped table-bordered" style="width:100%">
                                                <thead>
                                                    <tr>
                                                        <th> Id </th>
                                                        <th> Cuenta </th>
                                                        <th> @FGA.Utility.Utilitarios.toUpperFirstLetter(FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo1"].ToString()).ToString("MMMM yyyy")) </th>
                                                        <th> @FGA.Utility.Utilitarios.toUpperFirstLetter(FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo2"].ToString()).ToString("MMMM yyyy")) </th>
                                                        <th style="width: 50px;"></th>
                                                    </tr>
                                                </thead>
                                                <tbody></tbody>
                                            </table>
                                            <div id="summary">
                                                <div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="box box-solid box-info">
                                    <div class="box-header with-border" style="display: flex; align-items: center; gap: 15px; padding: 12px 15px;">
                                        @if (Session["Logo"] != null)
                                        {
                                            <img width="45" height="45" src="@Session["Logo"]" style="object-fit: contain;" />
                                        }
                                        <h4 class="box-title" style="margin: 0; font-weight: 700; color: #1e293b;">Suficiencia antes de enero 2025</h4>
                                    </div>
                                    <div class="box-body">
                                        <div class="streaming-table">
                                            <span id="found" class="label label-info"></span>
                                            <table id="tbSuficiencia" class="table table-striped table-bordered" style="width:100%">
                                                <thead>
                                                    <tr>
                                                        <th> Id </th>
                                                        <th> Cuenta </th>
                                                        <th> @FGA.Utility.Utilitarios.toUpperFirstLetter(FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo1"].ToString()).ToString("MMMM yyyy")) </th>
                                                        <th> @FGA.Utility.Utilitarios.toUpperFirstLetter(FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo2"].ToString()).ToString("MMMM yyyy")) </th>
                                                        <th style="width: 50px;"></th>
                                                    </tr>
                                                </thead>
                                                <tbody></tbody>
                                            </table>
                                            <div id="summary">
                                                <div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>


                    </div>
                </div>
            </div>
            <div class="modal fade" id="graphModal" tabindex="-1" role="dialog" aria-labelledby="deleteLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div id="grafica">
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-danger" data-dismiss="modal">Cerrar</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script type="text/javascript">

    function getGraph(id, estilo) {

        var tipo = 1;
        if (estilo == 'S')
            tipo = 0;

        $.ajax({
            url: '@Url.Action("GraficaDetalle", "Indicadores")',
            type: 'POST',
            cache: false,
            async: false,
            data: {
                    'Entidades': $('#IdEntidad').val(),
                    'PeriodoI':  $('#PeriodoI').val(),
                    'PeriodoF':  $('#PeriodoF').val(),
                    'cmb_indicadores': id,
                    'cmb_estilo': tipo
            },
                success: function (result) {
                $('#grafica').html(result);
            }
        });

        $('#graphModal').modal('show');
    }

    function formatMillion() {
        return this.value;
    }

    function formatPercent() {
        return this.value + " %";
    }

    $(document).ready(function () {
        $("#tbCAMEL").dataTable({
            "bRetrieve": true,
            "bProcessing": true,
            "dom": 'lBfrtip',
            "sAjaxSource": "@Url.Content("~/Indicadores/GetGridCAMEL")",
            "buttons": [
                { extend: 'copyHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'excelHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'csvHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'print', exportOptions: { columns: ':visible' } },
                'colvis'
            ],
            "columnDefs": [
                { "targets": 0, "visible": false, "searchable": false },
                { "targets": 1, "className": 'text-left font-weight-bold' },
                { "targets": [2, 3, 4, 5], "className": 'text-right', "width": '140px' },
                { "targets": 6, "className": 'text-center', "width": '50px', "orderable": false }
            ],
            "rowCallback": function( nRow, aData, iDisplayIndex, iDisplayIndexFull ) {
                for (var i = 2; i <= 5; i++) {
                    var val = parseFloat(aData[i]) || 0;
                    var cell = $(nRow).find('td:eq(' + (i - 1) + ')');
                    if (val < 0)
                        cell.css('color', '#dc2626').css('font-weight', '600');
                    else
                        cell.css('color', '#1e293b');
                }
            },
            "pageLength": -1,
            "order": [[ 0, "asc" ]],
            "lengthMenu": [[5, 15, 25, 50, -1], [5, 15, 25, 50, "Todos"]],
            "autoWidth": false
        });

        $("#tbSuficiencia").dataTable({
            "bRetrieve": true,
            "bProcessing": true,
            "dom": 'lBfrtip',
            "sAjaxSource": "@Url.Content("~/Indicadores/GetSuficiencia")",
            "buttons": [
                { extend: 'copyHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'excelHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'csvHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'print', exportOptions: { columns: ':visible' } },
                'colvis'
            ],
            "columnDefs": [
                { "targets": 0, "visible": false, "searchable": false },
                { "targets": 1, "className": 'text-left font-weight-bold' },
                { "targets": [2, 3], "className": 'text-right', "width": '160px' },
                { "targets": 4, "className": 'text-center', "width": '50px', "orderable": false }
            ],
            "rowCallback": function( nRow, aData, iDisplayIndex, iDisplayIndexFull ) {
                for (var i = 2; i <= 3; i++) {
                    var val = parseFloat(aData[i]) || 0;
                    var cell = $(nRow).find('td:eq(' + (i - 1) + ')');
                    if (val < 0)
                        cell.css('color', '#dc2626').css('font-weight', '600');
                    else
                        cell.css('color', '#1e293b');
                }
            },
            "pageLength": -1,
            "order": [[ 0, "asc" ]],
            "lengthMenu": [[5, 15, 25, 50, -1], [5, 15, 25, 50, "Todos"]],
            "autoWidth": false
        });

        var valoresFilas = {};

        $("#tbSuficiencia306").dataTable({
            "bRetrieve": true,
            "bProcessing": true,
            "dom": 'lBfrtip',
            "sAjaxSource": "@Url.Content("~/Indicadores/GetSuficiencia306")",
            "buttons": [
                { extend: 'copyHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'excelHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'csvHtml5', exportOptions: { columns: ':visible' } },
                { extend: 'print', exportOptions: { columns: ':visible' } },
                'colvis'
            ],
            "columnDefs": [
                { "targets": 0, "visible": false, "searchable": false },
                { "targets": 1, "className": 'text-left font-weight-bold' },
                { "targets": [2, 3], "className": 'text-right', "width": '160px' },
                { "targets": 4, "className": 'text-center', "width": '50px', "orderable": false }
            ],
            "fnDrawCallback": function (settings) {
                var api = this.api();
                var rowsCount = api.rows({ filter: 'applied' }).data().length;
                var container = $(api.table().container());

                if (rowsCount === 0) {
                    container.hide();
                } else {
                    container.show();
                }
            },
            "rowCallback": function (nRow, aData, iDisplayIndex, iDisplayIndexFull) {
                const idCuenta = parseInt(aData[0]);

                if (idCuenta === 0 || idCuenta === 1) {
                    valoresFilas[idCuenta] = parseFloat(aData[2]);
                }

                if (idCuenta === 0) {
                    $(nRow).hide();
                }

                for (var i = 2; i <= 3; i++) {
                    var val = parseFloat(aData[i]) || 0;
                    var cell = $(nRow).find('td:eq(' + (i - 1) + ')');
                    if (val < 0)
                        cell.css('color', '#dc2626').css('font-weight', '600');
                    else
                        cell.css('color', '#1e293b');
                }
            },
            "initComplete": function () {
                if (
                    valoresFilas[0] !== undefined &&
                    valoresFilas[1] !== undefined &&
                    Math.abs(valoresFilas[0] - valoresFilas[1]) > 0.02
                ) {
                    var periodo = $("#PeriodoI").val() || $("#PeriodoI").text();
                    $("#mensaje-alerta").text("El dato de la cuenta 10000 no coincide con la validación para el mes " + periodo + ".");
                    $("#alerta-diferencia").css('display', 'flex');
                } else {
                    $("#alerta-diferencia").hide();
                }
            },
            "pageLength": -1,
            "order": [[0, "asc"]],
            "lengthMenu": [[5, 15, 25, 50, -1], [5, 15, 25, 50, "Todos"]],
            "autoWidth": false
        });

        // Recalcular anchos al cambiar de tab
        $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
            $.fn.dataTable.tables({ visible: true, api: true }).columns.adjust();
        });
    });
</script>