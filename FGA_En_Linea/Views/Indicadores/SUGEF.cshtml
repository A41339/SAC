@{
    ViewBag.Title = "Indicadores";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section ScriptsOrCss
{
    <link rel="stylesheet" href="~/Content/multiselect/docs/css/prettify.min.css" type="text/css">
    <script type="text/javascript" src="~/Content/multiselect/docs/js/prettify.min.js"></script>
    <link rel="stylesheet" href="~/Content/multiselect/dist/css/bootstrap-multiselect.css" type="text/css">
    <script type="text/javascript" src="~/Content/multiselect/dist/js/bootstrap-multiselect.js"></script>
    <script src="https://cdn.datatables.net/rowgroup/1.2.0/js/dataTables.rowGroup.min.js"></script>
}

<section class="content-header" style="padding: 24px 20px 14px 20px;">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
        <div>
            <h1 style="margin: 0; font-size: 21px; font-weight: 700; color: #143750; display: flex; align-items: center; gap: 10px;">
                <i class="fa fa-line-chart" style="color: #0284c7;"></i>
                Indicadores
            </h1>
            <p style="margin: 6px 0 0 0; font-size: 13px; color: #64748b;">
                Monitoreo de solvencia patrimonial, suficiencia y an&aacute;lisis de indicadores normativos.
            </p>
        </div>
    </div>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="@Url.Action("Index", "Modulo", new { id = 3000 })" class="breadcrumb-parent-pill" title="Volver a Indicadores"><i class="fa fa-line-chart" style="margin-right: 4px;"></i> Indicadores</a></li>
        <li class="active">Indicadores</li>
    </ol>
</section>

<section class="content">

    @using (Html.BeginForm("BuscarSUGEF", "Indicadores", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmCAMEL" }))
    {
        @Html.AntiForgeryToken()
        <div class="row">
            <div class="col-xs-12">
                <div class="modern-filter-card" style="margin-bottom: 22px;">
                    <div class="modern-filter-toolbar">
                        <div class="filter-item">
                            <label for="IdEntidad"><i class="fa fa-building-o"></i> Entidad:</label>
                            @Html.DropDownList("Entidades", null, new { @id = "IdEntidad", @class = "form-control modern-select", style = "min-width: 220px; height: 38px; font-size: 13px;" })
                        </div>
                        <div class="filter-item">
                            <label for="PeriodoI"><i class="fa fa-calendar"></i> Per&iacute;odo:</label>
                            <div class="modern-input-wrapper">
                                <input name="PeriodoI" id="PeriodoI" class="datecontrol form-control modern-date-input" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo1"].ToString()).ToString("MM/yyyy")" style="min-width: 130px; height: 38px;" />
                            </div>
                        </div>
                        <div class="filter-item">
                            <label for="PeriodoF"><i class="fa fa-calendar-o"></i> Comparar con:</label>
                            <div class="modern-input-wrapper">
                                <input name="PeriodoF" id="PeriodoF" class="datecontrol form-control modern-date-input" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo2"].ToString()).ToString("MM/yyyy")" style="min-width: 130px; height: 38px;" />
                            </div>
                        </div>
                        <div class="filter-item">
                            <label for="TipoReporte"><i class="fa fa-list"></i> Resumido:</label>
                            @Html.DropDownList("TipoReporte", new List<SelectListItem> {
                                new SelectListItem { Value = "S", Text = "Sí" },
                                new SelectListItem { Value = "N", Text = "No" }
                            }, new { @id = "TipoReporte", @class = "form-control modern-select", style = "min-width: 100px; height: 38px; font-size: 13px;" })
                        </div>
                        <div class="filter-item" style="margin-left: auto;">
                            <button type="submit" class="btn-modern-filter" style="height: 38px; padding: 0 24px;">
                                <i class="fa fa-search"></i> Generar informe
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-xs-12">
            <div class="modern-table-card" style="border: 1px solid #e2e8f0; border-radius: 12px; background: #ffffff; box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05); overflow: hidden; padding: 22px; margin-bottom: 24px;">
                
                <div class="nav-tabs-custom" style="box-shadow: none; margin-bottom: 0;">
                    <ul class="nav nav-tabs" style="border-bottom: 2px solid #e2e8f0; margin-bottom: 20px;">
                        <li class="active">
                            <a href="#tab_2" data-toggle="tab" style="font-weight: 700; font-size: 13px; color: #143750; border-radius: 8px 8px 0 0; padding: 10px 18px;">
                                <i class="fa fa-shield" style="color: #059669; margin-right: 6px;"></i> Indicador de Suficiencia Patrimonial
                            </a>
                        </li>
                        <li>
                            <a href="#tab_1" data-toggle="tab" style="font-weight: 700; font-size: 13px; color: #143750; border-radius: 8px 8px 0 0; padding: 10px 18px;">
                                <i class="fa fa-line-chart" style="color: #0284c7; margin-right: 6px;"></i> Indicadores Financieros
                            </a>
                        </li>
                    </ul>

                    <div class="tab-content" style="padding: 0;">
                        <!-- TAB 1: INDICADORES FINANCIEROS -->
                        <div class="tab-pane" id="tab_1">
                            <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 20px; padding-bottom: 16px; border-bottom: 1px solid #f1f5f9;">
                                <img class="img-logo-entidad" width="44" height="44" src="@(Session["Logo"] ?? Url.Content("~/Content/images/FFC.jpg"))" onerror="this.onerror=null;this.src='@Url.Content("~/Content/images/FFC.jpg")';" style="border-radius: 8px; background: #ffffff; padding: 3px; border: 1px solid #e2e8f0; object-fit: contain;" />
                                <div>
                                    <h4 style="margin: 0; font-size: 16px; font-weight: 700; color: #143750;">Indicadores Financieros - <span class="lblEntidadHeader">@(Session["NomEntidad"] ?? "")</span></h4>
                                    <p style="margin: 2px 0 0 0; font-size: 12px; color: #64748b;">M&aacute;rgenes, rentabilidad, liquidez y solvencia</p>
                                </div>
                            </div>
                            <div class="table-responsive">
                                <table id="tbFinancieroSugef" class="table table-striped modern-data-table" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th>Tipo</th>
                                            <th class="text-left" style="text-align: left !important; padding-left: 16px;">Indicador</th>
                                            <th class="text-right" style="text-align: right !important; padding-right: 14px;">@FGA.Utility.Utilitarios.toUpperFirstLetter(FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo1"].ToString()).ToString("MMMM yyyy"))</th>
                                            <th class="text-right" style="text-align: right !important; padding-right: 14px;">@FGA.Utility.Utilitarios.toUpperFirstLetter(FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo2"].ToString()).ToString("MMMM yyyy"))</th>
                                            <th class="text-center" style="width: 50px; text-align: center !important;"></th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>

                        <!-- TAB 2: SUFICIENCIA PATRIMONIAL -->
                        <div class="tab-pane active" id="tab_2">
                            
                            <!-- Subcard 1: Suficiencia a partir de enero 2025 -->
                            <div class="modern-table-card" style="border: 1px solid #e2e8f0; border-radius: 10px; background: #ffffff; padding: 18px 20px; margin-bottom: 22px;">
                                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 14px; padding-bottom: 12px; border-bottom: 1px solid #f1f5f9;">
                                    <img class="img-logo-entidad" width="38" height="38" src="@(Session["Logo"] ?? Url.Content("~/Content/images/FFC.jpg"))" onerror="this.onerror=null;this.src='@Url.Content("~/Content/images/FFC.jpg")';" style="border-radius: 8px; background: #ffffff; padding: 2px; border: 1px solid #e2e8f0; object-fit: contain;" />
                                    <div>
                                        <h4 style="margin: 0; font-size: 15px; font-weight: 700; color: #143750;">
                                            <i class="fa fa-calendar-check-o" style="color: #0284c7; margin-right: 6px;"></i>
                                            Suficiencia Patrimonial a partir de enero 2025 &mdash; <span class="lblEntidadHeader">@(Session["NomEntidad"] ?? "")</span>
                                        </h4>
                                        <p style="margin: 2px 0 0 0; font-size: 11.5px; color: #64748b;">Conforme a la nueva normativa SUGEF 3-06</p>
                                    </div>
                                </div>

                                <div id="alerta-diferencia" style="display: none; background: #fff7ed; color: #c2410c; padding: 12px 16px; margin-bottom: 14px; border: 1px solid #fed7aa; border-radius: 8px; align-items: center; gap: 12px;">
                                    <i class="fa fa-exclamation-triangle" style="font-size: 20px; color: #ea580c;"></i>
                                    <span id="mensaje-alerta" style="font-size: 13px; font-weight: 600;"></span>
                                </div>

                                <div class="table-responsive">
                                    <table id="tbSuficiencia306" class="table table-striped modern-data-table" style="width:100%">
                                        <thead>
                                            <tr>
                                                <th>Id</th>
                                                <th class="text-left" style="text-align: left !important; padding-left: 16px;">Cuenta</th>
                                                <th class="text-right" style="text-align: right !important; padding-right: 14px;">@FGA.Utility.Utilitarios.toUpperFirstLetter(FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo1"].ToString()).ToString("MMMM yyyy"))</th>
                                                <th class="text-right" style="text-align: right !important; padding-right: 14px;">@FGA.Utility.Utilitarios.toUpperFirstLetter(FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo2"].ToString()).ToString("MMMM yyyy"))</th>
                                                <th class="text-center" style="width: 50px; text-align: center !important;"></th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Subcard 2: Suficiencia antes de enero 2025 -->
                            <div class="modern-table-card" style="border: 1px solid #e2e8f0; border-radius: 10px; background: #ffffff; padding: 18px 20px; margin-bottom: 10px;">
                                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 14px; padding-bottom: 12px; border-bottom: 1px solid #f1f5f9;">
                                    <img class="img-logo-entidad" width="38" height="38" src="@(Session["Logo"] ?? Url.Content("~/Content/images/FFC.jpg"))" onerror="this.onerror=null;this.src='@Url.Content("~/Content/images/FFC.jpg")';" style="border-radius: 8px; background: #ffffff; padding: 2px; border: 1px solid #e2e8f0; object-fit: contain;" />
                                    <div>
                                        <h4 style="margin: 0; font-size: 15px; font-weight: 700; color: #143750;">
                                            <i class="fa fa-history" style="color: #64748b; margin-right: 6px;"></i>
                                            Suficiencia Patrimonial hist&oacute;rica (anterior a enero 2025) &mdash; <span class="lblEntidadHeader">@(Session["NomEntidad"] ?? "")</span>
                                        </h4>
                                        <p style="margin: 2px 0 0 0; font-size: 11.5px; color: #64748b;">C&aacute;lculos normativos precedentes</p>
                                    </div>
                                </div>

                                <div class="table-responsive">
                                    <table id="tbSuficiencia" class="table table-striped modern-data-table" style="width:100%">
                                        <thead>
                                            <tr>
                                                <th>Id</th>
                                                <th class="text-left" style="text-align: left !important; padding-left: 16px;">Cuenta</th>
                                                <th class="text-right" style="text-align: right !important; padding-right: 14px;">@FGA.Utility.Utilitarios.toUpperFirstLetter(FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo1"].ToString()).ToString("MMMM yyyy"))</th>
                                                <th class="text-right" style="text-align: right !important; padding-right: 14px;">@FGA.Utility.Utilitarios.toUpperFirstLetter(FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo2"].ToString()).ToString("MMMM yyyy"))</th>
                                                <th class="text-center" style="width: 50px; text-align: center !important;"></th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- Nota Informativa al pie de página idéntica a Estructura de Fondeo -->
                <div class="modern-info-card" style="margin-top: 18px; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 10px; padding: 12px 18px; display: flex; align-items: center; gap: 12px;">
                    <div style="width: 28px; height: 28px; border-radius: 50%; background: #2F5597; color: #ffffff; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-weight: 700; font-size: 13px;">
                        <i class="fa fa-info"></i>
                    </div>
                    <div style="font-size: 12.5px; color: #1e3a8a;">
                        <strong>Nota:</strong> Los datos presentados corresponden a los requerimientos de supervisi&oacute;n y suficiencia patrimonial remitidos por la entidad regulada.
                    </div>
                </div>

            </div>
        </div>
    </div>

</section>

<!-- Modal Grafico Detalle -->
<div class="modal fade" id="graphModal" tabindex="-1" role="dialog" aria-labelledby="graphModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-chart-xl" style="max-width: 1300px; width: 95%; margin: 25px auto;">
        <div class="modal-content" style="border-radius: 14px; overflow: hidden; border: none; box-shadow: 0 16px 40px rgba(0,0,0,0.25);">
            <div id="grafica"></div>
            <div class="modal-footer" style="background: #f8fafc; border-top: 1px solid #e2e8f0; padding: 12px 20px; display: flex; justify-content: flex-end;">
                <button type="button" class="btn-modern-filter" data-dismiss="modal" style="padding: 8px 22px; border-radius: 8px; background: #64748b;">
                    <i class="fa fa-times"></i> Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    /* ==============================================================================
       ESTILOS DE TABLAS E INDICADORES SUGEF (BASADOS EN ESTRUCTURA DE FONDEO)
       ============================================================================== */
    #tbFinancieroSugef, #tbSuficiencia306, #tbSuficiencia {
        border-collapse: separate !important;
        border-spacing: 0 !important;
        width: 100% !important;
    }

    #tbFinancieroSugef thead th,
    #tbSuficiencia306 thead th,
    #tbSuficiencia thead th {
        font-size: 13px !important;
        font-weight: 600 !important;
        color: #2F5597 !important;
        border-bottom: 2px solid #88D1E2 !important;
        border-top: none !important;
        padding: 10px 14px !important;
        background-color: #ffffff !important;
        white-space: nowrap !important;
        letter-spacing: 0.2px !important;
    }

    #tbFinancieroSugef tbody td,
    #tbSuficiencia306 tbody td,
    #tbSuficiencia tbody td {
        font-size: 13px !important;
        font-weight: 400 !important;
        color: #334155 !important;
        line-height: 1.4 !important;
        vertical-align: middle !important;
        border-top: 1px solid #f1f5f9 !important;
        border-bottom: none !important;
        padding: 10px 14px !important;
    }

    /* Zebra striping idéntica a Estructura de Fondeo */
    #tbFinancieroSugef.table-striped > tbody > tr:nth-of-type(odd),
    #tbFinancieroSugef tbody tr.odd,
    #tbSuficiencia306.table-striped > tbody > tr:nth-of-type(odd),
    #tbSuficiencia306 tbody tr.odd,
    #tbSuficiencia.table-striped > tbody > tr:nth-of-type(odd),
    #tbSuficiencia tbody tr.odd {
        background-color: #f8fafc !important;
    }

    #tbFinancieroSugef.table-striped > tbody > tr:nth-of-type(even),
    #tbFinancieroSugef tbody tr.even,
    #tbSuficiencia306.table-striped > tbody > tr:nth-of-type(even),
    #tbSuficiencia306 tbody tr.even,
    #tbSuficiencia.table-striped > tbody > tr:nth-of-type(even),
    #tbSuficiencia tbody tr.even {
        background-color: #ffffff !important;
    }

    /* Hover de filas */
    #tbFinancieroSugef tbody tr:hover,
    #tbFinancieroSugef tbody tr.odd:hover,
    #tbFinancieroSugef tbody tr.even:hover,
    #tbSuficiencia306 tbody tr:hover,
    #tbSuficiencia306 tbody tr.odd:hover,
    #tbSuficiencia306 tbody tr.even:hover,
    #tbSuficiencia tbody tr:hover,
    #tbSuficiencia tbody tr.odd:hover,
    #tbSuficiencia tbody tr.even:hover {
        background-color: #eef2f6 !important;
    }

    /* Estilos de botones de gráfico en filas idénticos a Estructura de Fondeo */
    table td a[href*="getGraph"],
    .table td a[href*="getGraph"],
    .modern-data-table td a[href*="getGraph"],
    a.btn-indicador-chart {
        width: 30px !important;
        height: 30px !important;
        min-width: 30px !important;
        max-width: 30px !important;
        padding: 0 !important;
        margin: 0 auto !important;
        border-radius: 6px !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        background: #e0f2fe !important;
        color: #0284c7 !important;
        border: 1px solid #bae6fd !important;
        box-shadow: 0 1px 2px rgba(2, 132, 199, 0.08) !important;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
        text-decoration: none !important;
        cursor: pointer !important;
        vertical-align: middle !important;
    }

    table td a[href*="getGraph"]:hover,
    .table td a[href*="getGraph"]:hover,
    .modern-data-table td a[href*="getGraph"]:hover,
    a.btn-indicador-chart:hover {
        background: #0284c7 !important;
        color: #ffffff !important;
        border-color: #0284c7 !important;
        transform: translateY(-1px) scale(1.06);
        box-shadow: 0 4px 10px rgba(2, 132, 199, 0.3) !important;
    }

    table td a[href*="getGraph"] i,
    table td a[href*="getGraph"] i.fa,
    table td a[href*="getGraph"] i.btn,
    .table td a[href*="getGraph"] i,
    .modern-data-table td a[href*="getGraph"] i,
    a.btn-indicador-chart i {
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        font-family: 'FontAwesome' !important;
        font-style: normal !important;
        font-weight: normal !important;
        font-size: 13px !important;
        line-height: 1 !important;
        color: inherit !important;
        background: transparent !important;
        border: none !important;
        padding: 0 !important;
        margin: 0 !important;
        width: auto !important;
        height: auto !important;
        box-shadow: none !important;
    }

    /* Barra de botones de exportación DataTables moderna */
    .modern-table-card .dt-buttons {
        display: inline-flex !important;
        gap: 6px !important;
        margin-bottom: 14px !important;
        flex-wrap: wrap !important;
    }

    .modern-table-card .dt-buttons .dt-button,
    .modern-table-card a.dt-button,
    .modern-table-card button.dt-button {
        height: 32px !important;
        padding: 0 14px !important;
        font-size: 12px !important;
        font-weight: 600 !important;
        border-radius: 6px !important;
        background: #ffffff !important;
        border: 1px solid #cbd5e1 !important;
        color: #334155 !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 6px !important;
        transition: all 0.2s ease !important;
        box-shadow: 0 1px 2px rgba(0,0,0,0.04) !important;
        margin-right: 4px !important;
        cursor: pointer !important;
    }

    .modern-table-card .dt-buttons .dt-button:hover,
    .modern-table-card a.dt-button:hover,
    .modern-table-card button.dt-button:hover {
        background: #f8fafc !important;
        border-color: #2F5597 !important;
        color: #2F5597 !important;
        transform: translateY(-1px);
        box-shadow: 0 2px 6px rgba(47, 85, 151, 0.15) !important;
    }

    .modern-table-card .dt-buttons .buttons-excel {
        color: #15803d !important;
        border-color: #bbf7d0 !important;
    }
    .modern-table-card .dt-buttons .buttons-excel:hover {
        background: #f0fdf4 !important;
        border-color: #16a34a !important;
        color: #15803d !important;
    }

    /* Buscador y selector de longitud */
    .modern-table-card .dataTables_wrapper .dataTables_filter {
        float: right !important;
        margin-bottom: 14px !important;
    }

    .modern-table-card .dataTables_wrapper .dataTables_filter input {
        height: 32px !important;
        border: 1px solid #cbd5e1 !important;
        border-radius: 6px !important;
        padding: 4px 12px !important;
        font-size: 12.5px !important;
        color: #1e293b !important;
        background: #ffffff !important;
        outline: none !important;
        transition: all 0.2s ease !important;
        width: 220px !important;
    }

    .modern-table-card .dataTables_wrapper .dataTables_filter input:focus {
        border-color: #2F5597 !important;
        box-shadow: 0 0 0 3px rgba(47, 85, 151, 0.15) !important;
    }

    .modern-table-card .dataTables_wrapper .dataTables_length {
        float: left !important;
        margin-right: 16px !important;
        margin-bottom: 14px !important;
    }

    .modern-table-card .dataTables_wrapper .dataTables_length select {
        height: 32px !important;
        border: 1px solid #cbd5e1 !important;
        border-radius: 6px !important;
        padding: 2px 8px !important;
        font-size: 12.5px !important;
        color: #334155 !important;
        background: #ffffff !important;
        outline: none !important;
    }

    /* Paginación DataTables */
    .modern-table-card .dataTables_paginate {
        padding-top: 10px !important;
    }

    .modern-table-card .dataTables_paginate .paginate_button {
        border-radius: 6px !important;
        border: 1px solid #e2e8f0 !important;
        background: #ffffff !important;
        color: #475569 !important;
        margin: 0 2px !important;
        padding: 4px 10px !important;
        font-size: 12px !important;
        font-weight: 500 !important;
        transition: all 0.2s ease !important;
    }

    .modern-table-card .dataTables_paginate .paginate_button:hover {
        background: #f1f5f9 !important;
        border-color: #cbd5e1 !important;
        color: #1e293b !important;
    }

    .modern-table-card .dataTables_paginate .paginate_button.current,
    .modern-table-card .dataTables_paginate .paginate_button.current:hover {
        background: #2F5597 !important;
        border-color: #2F5597 !important;
        color: #ffffff !important;
    }

    .modern-table-card .dataTables_info {
        font-size: 12px !important;
        color: #64748b !important;
        padding-top: 14px !important;
    }

    /* Estilos de pestañas de navegación */
    .nav-tabs > li.active > a,
    .nav-tabs > li.active > a:focus,
    .nav-tabs > li.active > a:hover {
        color: #2F5597 !important;
        border-color: #2F5597 #2F5597 transparent !important;
        border-bottom: 2.5px solid #2F5597 !important;
        background-color: transparent !important;
    }

    #graphModal .modal-body {
        overflow: hidden !important;
    }
    #graphModal .highcharts-container {
        overflow: visible !important;
    }
    #graphModal .highcharts-tooltip,
    #graphModal .highcharts-tooltip * {
        pointer-events: none !important;
    }
</style>

<script type="text/javascript">

    function getGraph(id, estilo) {
        var tipo = 1;
        if (estilo == 'S')
            tipo = 0;

        $.ajax({
            url: '@Url.Action("GraficaDetalle", "Indicadores")',
            type: 'POST',
            cache: false,
            async: true,
            data: {
                'Entidades': $('#IdEntidad').val(),
                'PeriodoI':  $('#PeriodoI').val(),
                'PeriodoF':  $('#PeriodoF').val(),
                'cmb_indicadores': id,
                'cmb_estilo': tipo
            },
            success: function (result) {
                $('#grafica').html(result);
                $('#graphModal').modal('show');
            }
        });
    }

    $('#graphModal').on('shown.bs.modal', function () {
        if (typeof Highcharts !== 'undefined' && Highcharts.charts) {
            Highcharts.charts.forEach(function (c) {
                if (c) {
                    try { c.reflow(); } catch (e) {}
                }
            });
        }
    });

    function formatMillion() {
        return this.value;
    }

    function formatPercent() {
        return this.value + " %";
    }

    $(document).ready(function () {

        // Actualizar dinámicamente nombre de la entidad en encabezados al cambiar combo
        $('#IdEntidad').on('change', function () {
            var txt = $(this).find('option:selected').text();
            $('.lblEntidadHeader').text(txt);
        });

        // Configuración de botones compartida
        var exportButtons = [
             { extend: 'copyHtml5', text: 'Copiar', exportOptions: { columns: ':visible' } }
            ,{ extend: 'excelHtml5', text: 'Excel', exportOptions: { columns: ':visible' } }
            ,{ extend: 'csvHtml5', text: 'CSV', exportOptions: { columns: ':visible' } }
            ,{ extend: 'print', text: 'Imprimir', exportOptions: { columns: ':visible' } }
            ,{ extend: 'colvis', text: 'Columnas' }
        ];

        // Idioma en español compartido
        var languageConfig = {
            "lengthMenu": "Mostrar _MENU_ registros",
            "zeroRecords": "No se encontraron registros",
            "info": "Mostrando _START_ a _END_ de _TOTAL_ registros",
            "infoEmpty": "Mostrando 0 a 0 de 0 registros",
            "infoFiltered": "(filtrado de un total de _MAX_ registros)",
            "search": "Buscar:",
            "searchPlaceholder": "Filtrar indicadores...",
            "paginate": {
                "first": "Primero",
                "last": "Último",
                "next": "Siguiente",
                "previous": "Anterior"
            }
        };

        // TABLA INDICADORES FINANCIEROS (con rowGroup por tipo)
        $("#tbFinancieroSugef").dataTable({
            "bRetrieve": true,
            "bProcessing": true,
            "dom": 'lBfrtip',
            "rowGroup": {
                dataSrc: 0,
                startRender: function (rows, group) {
                    return $('<tr class="group-header-row"/>').append('<td style="font-size:13px !important; font-weight:700 !important; background:linear-gradient(135deg, #143750 0%, #1e4b6e 100%) !important; color:#ffffff !important; padding:9px 16px !important; letter-spacing:0.5px !important; text-transform:uppercase !important;" colspan="4"><i class="fa fa-folder-open" style="margin-right:8px; color:#88D1E2 !important;"></i> <span style="color:#ffffff !important;">' + group + '</span></td>');
                },
                enabled: true
            },
            "sAjaxSource": "@Url.Content("~/Indicadores/GetGridIndicadorF")",
            "buttons": exportButtons,
            "columnDefs": [
                { "targets": 0, "visible": false, "searchable": false },
                { "targets": 1, "className": 'text-left font-weight-bold' },
                { "targets": [2, 3], "className": 'text-right', "width": '160px' },
                { "targets": 4, "className": 'text-center', "width": '50px', "orderable": false }
            ],
            "rowCallback": function( nRow, aData, iDisplayIndex, iDisplayIndexFull ) {
                $('td:eq(0)', nRow).css({ 'font-weight': '500', 'color': '#1e293b' });
                for (var i = 2; i <= 3; i++) {
                    var val = parseFloat(aData[i]) || 0;
                    var cell = $(nRow).find('td:eq(' + (i - 1) + ')');
                    cell.css('font-variant-numeric', 'tabular-nums');
                    if (val < 0) {
                        cell.css({ 'color': '#c2410c', 'font-weight': '600' });
                    } else {
                        cell.css({ 'color': '#1e293b', 'font-weight': '500' });
                    }
                }
            },
            "drawCallback": function (settings) {
                $(this).find('[data-toggle="tooltip"]').tooltip();
            },
            "pageLength": -1,
            "order": [[ 0, "asc" ]],
            "lengthMenu": [[10, 25, 50, -1], [10, 25, 50, "Todos"]],
            "autoWidth": false,
            "language": languageConfig
        });


        // TABLA SUFICIENCIA HISTÓRICA
        $("#tbSuficiencia").dataTable({
            "bRetrieve": true,
            "bProcessing": true,
            "dom": 'lBfrtip',
            "sAjaxSource": "@Url.Content("~/Indicadores/GetSuficiencia")",
            "buttons": exportButtons,
            "columnDefs": [
                { "targets": 0, "visible": false, "searchable": false },
                { "targets": 1, "className": 'text-left font-weight-bold' },
                { "targets": [2, 3], "className": 'text-right', "width": '160px' },
                { "targets": 4, "className": 'text-center', "width": '50px', "orderable": false }
            ],
            "rowCallback": function( nRow, aData, iDisplayIndex, iDisplayIndexFull ) {
                $('td:eq(0)', nRow).css({ 'font-weight': '500', 'color': '#1e293b' });
                for (var i = 2; i <= 3; i++) {
                    var val = parseFloat(aData[i]) || 0;
                    var cell = $(nRow).find('td:eq(' + (i - 1) + ')');
                    cell.css('font-variant-numeric', 'tabular-nums');
                    if (val < 0) {
                        cell.css({ 'color': '#c2410c', 'font-weight': '600' });
                    } else {
                        cell.css({ 'color': '#1e293b', 'font-weight': '500' });
                    }
                }
            },
            "drawCallback": function (settings) {
                $(this).find('[data-toggle="tooltip"]').tooltip();
            },
            "pageLength": -1,
            "order": [[ 0, "asc" ]],
            "lengthMenu": [[10, 25, 50, -1], [10, 25, 50, "Todos"]],
            "autoWidth": false,
            "language": languageConfig
        });

        var valoresFilas = {};

        // TABLA SUFICIENCIA 3-06 (2025)
        $("#tbSuficiencia306").dataTable({
            "bRetrieve": true,
            "bProcessing": true,
            "dom": 'lBfrtip',
            "sAjaxSource": "@Url.Content("~/Indicadores/GetSuficiencia306")",
            "buttons": exportButtons,
            "columnDefs": [
                { "targets": 0, "visible": false, "searchable": false },
                { "targets": 1, "className": 'text-left font-weight-bold' },
                { "targets": [2, 3], "className": 'text-right', "width": '160px' },
                { "targets": 4, "className": 'text-center', "width": '50px', "orderable": false }
            ],
            "rowCallback": function (nRow, aData, iDisplayIndex, iDisplayIndexFull) {
                var cuenta = aData[1].trim();
                var valor1 = parseFloat(aData[2].replace(',', '.')) || 0;
                var valor2 = parseFloat(aData[3].replace(',', '.')) || 0;

                if (cuenta === "Suficiencia Patrimonial") {
                    valoresFilas["Suficiencia"] = { v1: valor1, v2: valor2 };
                } else if (cuenta === "Suficiencia Patrimonial (Calculado)") {
                    valoresFilas["Calculado"] = { v1: valor1, v2: valor2 };
                }

                $('td:eq(0)', nRow).css({ 'font-weight': '500', 'color': '#1e293b' });
                for (var i = 2; i <= 3; i++) {
                    var val = parseFloat(aData[i]) || 0;
                    var cell = $(nRow).find('td:eq(' + (i - 1) + ')');
                    cell.css('font-variant-numeric', 'tabular-nums');
                    if (val < 0) {
                        cell.css({ 'color': '#c2410c', 'font-weight': '600' });
                    } else {
                        cell.css({ 'color': '#1e293b', 'font-weight': '500' });
                    }
                }
            },
            "drawCallback": function (settings) {
                $(this).find('[data-toggle="tooltip"]').tooltip();
                if (valoresFilas["Suficiencia"] && valoresFilas["Calculado"]) {
                    var diff1 = Math.abs(valoresFilas["Suficiencia"].v1 - valoresFilas["Calculado"].v1);
                    var diff2 = Math.abs(valoresFilas["Suficiencia"].v2 - valoresFilas["Calculado"].v2);
                    var tolerancia = 0.0001;

                    if (diff1 > tolerancia || diff2 > tolerancia) {
                        var mensaje = "Atenci\u00f3n: Existe una diferencia entre la Suficiencia Patrimonial reportada y la calculada.";
                        $("#mensaje-alerta").text(mensaje);
                        $("#alerta-diferencia").css("display", "flex");
                    } else {
                        $("#alerta-diferencia").hide();
                    }
                }
            },
            "pageLength": -1,
            "order": [[0, "asc"]],
            "lengthMenu": [[10, 25, 50, -1], [10, 25, 50, "Todos"]],
            "autoWidth": false,
            "language": languageConfig
        });

        $('a[data-toggle="tab"]').on('shown.bs.tab', function () {
            $($.fn.dataTable.tables(true)).DataTable().columns.adjust();
        });

    });
</script>
