@model DotNet.Highcharts.Highcharts

<div class="modal-header" style="background: linear-gradient(135deg, #3d6cb9 0%, #2F5597 100%); padding: 16px 20px; display: flex; align-items: center; justify-content: space-between; border: none;">
    <div style="display: flex; align-items: center; gap: 12px;">
        @if (Session["Logo"] != null)
        {
            <img width="38" height="38" src="@Session["Logo"]" style="border-radius: 8px; background: #ffffff; padding: 2px; box-shadow: 0 2px 6px rgba(0,0,0,0.15); object-fit: contain;" />
        }
        <h4 class="modal-title" style="margin: 0; color: #ffffff !important; font-size: 15px; font-weight: 700;">@ViewBag.Title</h4>
    </div>
    <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="color: #ffffff; opacity: 0.85; font-size: 22px; text-shadow: none; margin: 0; padding: 0;">
        <span aria-hidden="true">&times;</span>
    </button>
</div>
<div class="modal-body" style="padding: 20px 24px; background: #ffffff; overflow-y: auto;">
    <script type="text/javascript">
        if (typeof Highcharts !== 'undefined') {
            Highcharts.setOptions({
                lang: {
                    thousandsSep: ',',
                    decimalPoint: '.'
                }
            });
            if (Highcharts.defaultOptions && Highcharts.defaultOptions.lang) {
                Highcharts.defaultOptions.lang.thousandsSep = ',';
                Highcharts.defaultOptions.lang.decimalPoint = '.';
            }
        }
    </script>
    <div style="width: 100%; min-height: 400px; overflow: visible;">
        @(Model)
    </div>
</div>
