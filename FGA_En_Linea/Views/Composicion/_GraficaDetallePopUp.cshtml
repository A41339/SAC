    window.navegarPeriodoHistograma = function (delta) {
        var maxIdx = 0;
        if (typeof Highcharts !== 'undefined' && Highcharts.charts) {
            for (var i = 0; i < Highcharts.charts.length; i++) {
                var c = Highcharts.charts[i];
                if (c && c._fgaOriginalConfig && c._fgaOriginalConfig.categories && c._fgaOriginalConfig.categories.length > 0) {
                    maxIdx = c._fgaOriginalConfig.categories.length - 1;
                    break;
                }
            }
        }
        var newIdx = (window.histogramaPeriodoIdx || 0) + delta;
        if (newIdx < 0) newIdx = maxIdx;
        if (newIdx > maxIdx) newIdx = 0;
        window.cambiarPeriodoHistograma(newIdx);
