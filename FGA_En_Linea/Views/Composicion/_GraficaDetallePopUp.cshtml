                        <button type="button" onclick="window.setPresetAngulo3D(75, 0, 175)" style="height: 22px; padding: 0 8px; font-size: 10.5px; font-weight: 600; border: none; background: transparent; color: #475569; cursor: pointer; border-radius: 4px;" title="Vista cenital vertical directa sin solapamiento">Cenital</button>
