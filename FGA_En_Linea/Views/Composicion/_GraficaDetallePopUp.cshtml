                        <button type="button" onclick="window.navegarPeriodoHistograma(-1)" class="btn btn-xs btn-default" style="padding: 2px 5px; font-size: 10px; border-radius: 3px;" title="Período anterior"><i class="fa fa-chevron-left"></i></button>
                        <button type="button" onclick="window.navegarPeriodoHistograma(1)" class="btn btn-xs btn-default" style="padding: 2px 5px; font-size: 10px; border-radius: 3px;" title="Período siguiente"><i class="fa fa-chevron-right"></i></button>
