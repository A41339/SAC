<script type="text/javascript">
    function mPopUp() {
        var entText = $("#IdEntidad :selected").text() || '';
        var grafText = $("#Grafico :selected").text() || '';
        if (grafText) {
            $("#pEntidad").text(grafText);
        }
        if (entText) {
            $("#pSubEntidad").text(entText);
        }
        $('#mPopUp').modal('show');
    }

    // Estado inicial: RESPETA LA VERSIÓN ORIGINAL (2D Plano, Columnas)
    window.tipoGraficoActual = 'column';
    window.cartera3DActivo = false;

    window.echartsAutoRotate = false;
    window.echartsModoMora = 'completo'; // 'completo' | 'vencida'
    window.tramosOcultos3D = {};
    window.echarts3DAlpha = 48;
    window.echarts3DBeta = 0;
    window.echarts3DDistance = 170;
    window.coloresPlano2D = ['#2F5597', '#0284c7', '#959595', '#ea580c', '#565656', '#6DB5CB', '#143750', '#f59e0b', '#0071AD', '#B7D8DF'];
    window.paletaInstitucionalFGA = ['#2F5597', '#0284c7', '#959595', '#ea580c', '#565656', '#6DB5CB', '#143750', '#f59e0b', '#0071AD', '#B7D8DF'];

    // Mapeo riguroso de colores institucionales FGA / FFC
    window.obtenerColorInstitucional = function (name, idx, sColor) {
        if (sColor && typeof sColor === 'string' && (sColor.charAt(0) === '#' || sColor.indexOf('rgb') === 0)) {
            return sColor;
        }
        var n = (name || '').toLowerCase();
        if (n.indexOf('al d') > -1 || n.indexOf('vigente') > -1) {
            return '#2F5597'; // Azul Corporativo FFC
        } else if (n.indexOf('1 a 30') > -1 || n.indexOf('1-30') > -1 || n.indexOf('hasta30') > -1) {
            return '#0284c7'; // Azul Claro FFC
        } else if (n.indexOf('31 a 60') > -1 || n.indexOf('31-60') > -1 || n.indexOf('hasta60') > -1) {
            return '#959595'; // Gris Auxiliar FFC
        } else if (n.indexOf('61 a 90') > -1 || n.indexOf('61-90') > -1 || n.indexOf('hasta90') > -1) {
            return '#ea580c'; // Naranja Institucional FFC
        } else if (n.indexOf('90') > -1 || n.indexOf('mayor') > -1 || n.indexOf('vencid') > -1) {
            return '#565656'; // Gris Principal FFC
        } else if (n.indexOf('judicial') > -1) {
            return '#143750'; // Azul Oscuro FFC
        }
        return window.paletaInstitucionalFGA[idx % window.paletaInstitucionalFGA.length];
    };

    window.guardarConfiguracionOriginal = function (chart) {
        if (!chart || chart._fgaOriginalConfig) return;
        try {
            var savedSeries = [];
            if (chart.series && chart.series.length > 0) {
                chart.series.forEach(function (s, idx) {
                    var rawData = [];
                    if (s.options && s.options.data) {
                        rawData = JSON.parse(JSON.stringify(s.options.data));
                    } else if (s.data) {
                        rawData = s.data.map(function (pt) {
                            if (typeof pt === 'number') return pt;
                            if (pt && typeof pt.y === 'number') return pt.y;
                            if (Array.isArray(pt)) return pt[1];
                            return pt;
                        });
                    }
                    var yAxisIdx = 0;
                    if (s.yAxis) {
                        if (typeof s.yAxis.options.index === 'number') yAxisIdx = s.yAxis.options.index;
                        else if (s.yAxis.options.id === 'Concentracion') yAxisIdx = 0;
                        else if (chart.yAxis && chart.yAxis.indexOf(s.yAxis) >= 0) yAxisIdx = chart.yAxis.indexOf(s.yAxis);
                    }
                    var sColor = s.color || window.coloresPlano2D[idx % window.coloresPlano2D.length];
                    savedSeries.push({
                        name: s.name,
                        origType: (s.type === 'line' || s.type === 'spline') ? 'line' : 'column',
                        color: sColor,
                        data: rawData,
                        yAxis: yAxisIdx,
                        stack: (s.options && s.options.stack) ? s.options.stack : null,
                        dashStyle: (s.options && s.options.dashStyle) ? s.options.dashStyle : null,
                        zIndex: (s.options && s.options.zIndex !== undefined) ? s.options.zIndex : idx
                    });
                });
            }

            var savedCats = [];
            if (chart.xAxis && chart.xAxis[0] && chart.xAxis[0].categories) {
                savedCats = chart.xAxis[0].categories.slice();
            }

            chart._fgaOriginalConfig = {
                series: savedSeries,
                categories: savedCats,
                title: (chart.title && chart.title.textStr) ? chart.title.textStr : '',
                subTitle: (chart.subtitle && chart.subtitle.textStr) ? chart.subtitle.textStr : ''
            };
        } catch (err) {
            console.warn('Error al guardar configuración original:', err);
        }
    };

    // Renderizado de la Matriz 3D Multi-período con Apache ECharts GL (WebGL)
    window.renderEChartsMatrix3D = function (domId, chartSource) {
        if (typeof echarts === 'undefined') {
            console.warn('ECharts aún no está disponible, reintentando carga...');
            setTimeout(function () {
                window.renderEChartsMatrix3D(domId, chartSource);
            }, 120);
            return null;
        }

        var dom = document.getElementById(domId);
        if (!dom) return null;

        var chartOrig = chartSource;
        if (!chartOrig || !chartOrig._fgaOriginalConfig) {
            if (typeof Highcharts !== 'undefined' && Highcharts.charts) {
                for (var i = 0; i < Highcharts.charts.length; i++) {
                    var ch = Highcharts.charts[i];
                    if (ch && ch._fgaOriginalConfig && ch._fgaOriginalConfig.categories && ch._fgaOriginalConfig.categories.length > 0) {
                        chartOrig = ch;
                        break;
                    }
                }
            }
        }
        if (!chartOrig || !chartOrig._fgaOriginalConfig) return null;

        var orig = chartOrig._fgaOriginalConfig;
        var cats = (orig.categories || []).slice();
        var colSeries = orig.series.filter(function (s) { return s.origType === 'column'; });
        if (colSeries.length === 0) colSeries = orig.series;

        // Filtrado por modo: Vista Completa vs Enfoque Cartera Vencida (Quita barras 'Al Día')
        var seriesToRender = colSeries;
        if (window.echartsModoMora === 'vencida') {
            var vencidas = colSeries.filter(function (s) {
                var n = (s.name || '').toLowerCase();
                return !(n.indexOf('al d') > -1 || n.indexOf('vigente') > -1);
            });
            if (vencidas.length > 0) {
                seriesToRender = vencidas;
            }
        }

        // Filtrado individual por tramos del Eje Y
        if (window.tramosOcultos3D) {
            var activas = seriesToRender.filter(function (s) {
                return !window.tramosOcultos3D[s.name];
            });
            if (activas.length > 0) {
                seriesToRender = activas;
            }
        }

        // Renderizar chips interactivos para cada tramo del Eje Y
        try {
            var chipsHtml = '';
            colSeries.forEach(function (s, sIdx) {
                var isOculto = !!(window.tramosOcultos3D && window.tramosOcultos3D[s.name]) ||
                               (window.echartsModoMora === 'vencida' && ((s.name || '').toLowerCase().indexOf('al d') > -1 || (s.name || '').toLowerCase().indexOf('vigente') > -1));
                var col = window.obtenerColorInstitucional(s.name, sIdx, s.color);
                var chipStyle = isOculto
                    ? 'height: 22px; padding: 0 7px; font-size: 10.5px; font-weight: 500; border-radius: 4px; border: 1px dashed #cbd5e1; background: #f1f5f9; color: #94a3b8; cursor: pointer; text-decoration: line-through; display: inline-flex; align-items: center; gap: 4px;'
                    : 'height: 22px; padding: 0 7px; font-size: 10.5px; font-weight: 600; border-radius: 4px; border: 1px solid #cbd5e1; background: #ffffff; color: #1e293b; cursor: pointer; display: inline-flex; align-items: center; gap: 4px; box-shadow: 0 1px 2px rgba(0,0,0,0.03);';
                var bulletStyle = 'color: ' + (isOculto ? '#94a3b8' : col) + '; font-size: 11px;';
                var escName = (s.name || '').replace(/'/g, "\\'");
                chipsHtml += '<button type="button" onclick="window.toggleTramo3D(\'' + escName + '\')" style="' + chipStyle + '" title="' + (isOculto ? 'Clic para mostrar barra' : 'Clic para quitar barra del eje Y') + '">';
                chipsHtml += '<span style="' + bulletStyle + '">&#9679;</span> ' + (s.name || 'Tramo');
                chipsHtml += '</button>';
            });
            $('#tramosChipsCartera, #tramosChipsComposicion, #tramosChipsModal').html(chipsHtml);
        } catch (eChips) {}

        // Ordenar tramos de menor a mayor altura promedio (efecto anfiteatro/estadio)
        // para que las barras más pequeñas queden en la fila frontal (Y=0) y las más altas al fondo,
        // garantizando visibilidad total de todas las barras sin oclusiones.
        seriesToRender = seriesToRender.slice().sort(function (a, b) {
            var sumA = (a.data || []).reduce(function (acc, val) {
                var num = (typeof val === 'number') ? val : (val && typeof val.y === 'number' ? val.y : (Array.isArray(val) ? val[1] : 0));
                return acc + (parseFloat(num) || 0);
            }, 0);
            var sumB = (b.data || []).reduce(function (acc, val) {
                var num = (typeof val === 'number') ? val : (val && typeof val.y === 'number' ? val.y : (Array.isArray(val) ? val[1] : 0));
                return acc + (parseFloat(num) || 0);
            }, 0);
            return sumA - sumB;
        });

        var tramoNames = seriesToRender.map(function (s) { return s.name; });

        // Totales periódicos para porcentaje
        var periodTotals = [];
        cats.forEach(function (cat, xIdx) {
            var tot = 0;
            colSeries.forEach(function (s) {
                var v = 0;
                if (s.data && s.data.length > xIdx) {
                    var pt = s.data[xIdx];
                    if (typeof pt === 'number') v = pt;
                    else if (pt && typeof pt.y === 'number') v = pt.y;
                    else if (Array.isArray(pt) && typeof pt[1] === 'number') v = pt[1];
                }
                tot += Math.max(0, v || 0);
            });
            periodTotals[xIdx] = tot;
        });

        // 1. Calcular el valor máximo global entre los tramos a graficar
        var maxVal = 0;
        seriesToRender.forEach(function (s) {
            (s.data || []).forEach(function (pt) {
                var num = (typeof pt === 'number') ? pt : (pt && typeof pt.y === 'number' ? pt.y : (Array.isArray(pt) ? pt[1] : 0));
                var val = Math.max(0, parseFloat(num) || 0);
                if (val > maxVal) maxVal = val;
            });
        });
        if (maxVal <= 0) maxVal = 1;

        // Umbral sutil de altura mínima visible para barras con saldo > 0 sin crear muros que tapen filas traseras
        var minFloor = maxVal * 0.025;

        // 2. Construir datos en formato [xIdx, yIdx, zVal] respetando colores institucionales
        var data3D = [];
        seriesToRender.forEach(function (s, yIdx) {
            var col = window.obtenerColorInstitucional(s.name, yIdx, s.color);
            cats.forEach(function (cat, xIdx) {
                var v = 0;
                if (s.data && s.data.length > xIdx) {
                    var pt = s.data[xIdx];
                    if (typeof pt === 'number') v = pt;
                    else if (pt && typeof pt.y === 'number') v = pt.y;
                    else if (Array.isArray(pt) && typeof pt[1] === 'number') v = pt[1];
                }
                v = Math.max(0, parseFloat(v) || 0);
                var pTot = periodTotals[xIdx] || 0;
                var pct = pTot > 0 ? ((v / pTot) * 100) : 0;

                // Solo graficar tramos con valor real > 0 para eliminar cubos fantasma en el suelo que desvíen el cursor
                if (v > 0) {
                    var zRender = (v < minFloor) ? (minFloor + ((v / minFloor) * (minFloor * 0.35))) : v;
                    data3D.push({
                        name: cat + ' - ' + s.name,
                        value: [xIdx, yIdx, zRender],
                        realVal: v,
                        tramo: s.name,
                        mes: cat,
                        pct: pct,
                        itemStyle: {
                            color: col,
                            opacity: 0.96
                        }
                    });
                }
            });
        });

        var myChart = echarts.getInstanceByDom(dom);
        if (!myChart) {
            myChart = echarts.init(dom);
        }

        var numCats = Math.max(1, cats.length);
        var numTramos = Math.max(1, tramoNames.length);

        // Dimensiones calibradas para barras 3D prominentes y puntero exacto
        var dynamicBoxWidth = Math.max(260, Math.min(340, numCats * 24));
        var dynamicBoxDepth = Math.max(140, Math.min(220, numTramos * 28));
        var dynamicBoxHeight = 58;

        var option = {
            backgroundColor: '#ffffff',
            title: {
                text: (orig.title ? orig.title : 'Distribución de Riesgo de Cartera') + (window.echartsModoMora === 'vencida' ? ' (Enfoque Mora Vencida)' : ''),
                subtext: 'Perspectiva 3D interactiva por período',
                left: 'center',
                top: 8,
                textStyle: {
                    color: '#1b3866',
                    fontSize: 14,
                    fontWeight: 'bold',
                    fontFamily: '-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif'
                },
                subtextStyle: {
                    color: '#64748b',
                    fontSize: 11
                }
            },
            tooltip: {
                show: true,
                confine: true,
                enterable: false,
                padding: 0,
                backgroundColor: 'transparent',
                borderColor: 'transparent',
                borderWidth: 0,
                shadowColor: 'transparent',
                extraCssText: 'pointer-events: none; z-index: 9999; box-shadow: none; border: none; padding: 0; background: transparent;',
                formatter: function (params) {
                    var d = params.data;
                    if (!d) return '';
                    var valReal = (typeof d.realVal !== 'undefined') ? d.realVal : d.value[2];
                    var valFormatted = (typeof Highcharts !== 'undefined' && Highcharts.numberFormat) ? Highcharts.numberFormat(valReal, 2, '.', ',') : valReal.toFixed(2);
                    var pctFormatted = (typeof Highcharts !== 'undefined' && Highcharts.numberFormat) ? Highcharts.numberFormat(d.pct, 2, '.', ',') : d.pct.toFixed(2);
                    var esSoloPorcentaje = (Math.abs(valReal - d.pct) < 0.05 && valReal <= 100);
                    var sColor = (d.itemStyle && d.itemStyle.color) ? d.itemStyle.color : '#0284c7';

                    var html = '<div class="fga-chart-tooltip" style="min-width: 240px; padding: 10px 14px;">';
                    html += '<div class="tt-header">Período: ' + d.mes + '</div>';
                    html += '<table class="tt-table">';
                    if (esSoloPorcentaje) {
                        html += '<tr>';
                        html += '<td class="tt-bullet" style="color:' + sColor + ';">&#9679;</td>';
                        html += '<td class="tt-name">' + d.tramo + ':</td>';
                        html += '<td class="tt-val">' + pctFormatted + '%</td>';
                        html += '</tr>';
                    } else {
                        html += '<tr>';
                        html += '<td class="tt-bullet" style="color:' + sColor + ';">&#9679;</td>';
                        html += '<td class="tt-name">' + d.tramo + ':</td>';
                        html += '<td class="tt-val">' + valFormatted + '</td>';
                        html += '</tr>';
                        html += '<tr>';
                        html += '<td class="tt-bullet" style="color:#0284c7;">&#9679;</td>';
                        html += '<td class="tt-name">Concentración:</td>';
                        html += '<td class="tt-val">' + pctFormatted + '%</td>';
                        html += '</tr>';
                    }
                    html += '</table></div>';
                    return html;
                }
            },
            xAxis3D: {
                type: 'category',
                name: 'Período',
                data: cats,
                nameTextStyle: { color: '#1e3a8a', fontSize: 12, fontWeight: 'bold' },
                axisLabel: {
                    interval: 0,
                    textStyle: { color: '#334155', fontSize: 10.5, fontWeight: '600' }
                },
                axisLine: { lineStyle: { color: '#cbd5e1' } },
                splitLine: { show: true, lineStyle: { color: '#f1f5f9' } }
            },
            yAxis3D: {
                type: 'category',
                name: 'Tramo',
                data: tramoNames,
                nameTextStyle: { color: '#1e3a8a', fontSize: 12, fontWeight: 'bold' },
                axisLabel: {
                    interval: 0,
                    textStyle: { color: '#334155', fontSize: 10.5, fontWeight: '600' }
                },
                axisLine: { lineStyle: { color: '#cbd5e1' } },
                splitLine: { show: true, lineStyle: { color: '#f1f5f9' } }
            },
            zAxis3D: {
                type: 'value',
                name: 'Saldo',
                nameTextStyle: { color: '#1e3a8a', fontSize: 12, fontWeight: 'bold' },
                axisLabel: {
                    textStyle: { color: '#475569', fontSize: 10 }
                },
                axisLine: { lineStyle: { color: '#cbd5e1' } },
                splitLine: { show: true, lineStyle: { color: '#f1f5f9' } }
            },
            grid3D: {
                boxWidth: dynamicBoxWidth,
                boxDepth: dynamicBoxDepth,
                boxHeight: dynamicBoxHeight,
                top: 0,
                bottom: 15,
                axisPointer: {
                    show: false
                },
                viewControl: {
                    alpha: (typeof window.echarts3DAlpha !== 'undefined' ? window.echarts3DAlpha : 48),
                    beta: (typeof window.echarts3DBeta !== 'undefined' ? window.echarts3DBeta : 0),
                    distance: (typeof window.echarts3DDistance !== 'undefined' ? window.echarts3DDistance : 170),
                    minDistance: 70,
                    maxDistance: 450,
                    autoRotate: !!window.echartsAutoRotate,
                    autoRotateSpeed: 10,
                    rotateSensitivity: 1.2,
                    zoomSensitivity: 1.2,
                    panSensitivity: 1.0,
                    damping: 0.8
                },
                light: {
                    main: {
                        intensity: 1.35,
                        shadow: true,
                        shadowQuality: 'high',
                        alpha: 45,
                        beta: -30
                    },
                    ambient: {
                        intensity: 0.70 // Iluminación ambiental limpia y brillante sobre fondo blanco
                    }
                },
                environment: '#ffffff',
                postEffect: {
                    enable: false // Desactivado para garantizar fondo 100% blanco puro sin viñetas oscuras
                }
            },
            series: [{
                type: 'bar3D',
                data: data3D,
                shading: 'realistic',
                realisticMaterial: {
                    roughness: 0.32,
                    metalness: 0.12
                },
                bevelSize: 0,
                bevelSegments: 0,
                emphasis: {
                    label: { show: false },
                    itemStyle: { color: '#f59e0b' }
                }
            }]
        };

        try {
            myChart.setOption(option, true);
            myChart.resize();
        } catch (e) {
            console.warn('Fallo renderizado realista WebGL, intentando modo lambert:', e);
            option.series[0].shading = 'lambert';
            myChart.setOption(option, true);
            myChart.resize();
        }

        setTimeout(function () {
            if (myChart) myChart.resize();
        }, 120);
        setTimeout(function () {
            if (myChart) myChart.resize();
        }, 300);

        return myChart;
    };

    window.toggleTramo3D = function (tramoName) {
        if (!tramoName) return;
        window.tramosOcultos3D = window.tramosOcultos3D || {};
        window.tramosOcultos3D[tramoName] = !window.tramosOcultos3D[tramoName];

        if (window.tipoGraficoActual === 'matrix3d') {
            window.renderEChartsMatrix3D('echartsContainerCartera');
            if ($('#mPopUp').hasClass('in')) {
                window.renderEChartsMatrix3D('echartsContainerModalCartera');
                if (typeof window.actualizarKpiModalComposicion === 'function') {
                    window.actualizarKpiModalComposicion();
                }
            }
        }
    };

    window.cambiarModoMora3D = function (modo) {
        window.echartsModoMora = modo;
        var esCompleto = (modo === 'completo');
        if (esCompleto) {
            window.tramosOcultos3D = {};
        }

        // Actualizar botones en barra principal y modal
        $('#btnModoTodosCartera, #btnModoTodosComposicion, #btnModoTodosModal')
            .removeClass('btn-default btn-primary')
            .addClass(esCompleto ? 'btn-primary' : 'btn-default')
            .css({ 'font-weight': esCompleto ? '700' : '600', 'color': esCompleto ? '#ffffff' : '#475569' });

        $('#btnModoMoraCartera, #btnModoMoraComposicion, #btnModoMoraModal')
            .removeClass('btn-default btn-primary')
            .addClass(esCompleto ? 'btn-default' : 'btn-primary')
            .css({ 'font-weight': esCompleto ? '600' : '700', 'color': esCompleto ? '#c2410c' : '#ffffff' });

        if (window.tipoGraficoActual === 'matrix3d') {
            window.renderEChartsMatrix3D('echartsContainerCartera');
            if ($('#mPopUp').hasClass('in')) {
                window.renderEChartsMatrix3D('echartsContainerModalCartera');
                if (typeof window.actualizarKpiModalComposicion === 'function') {
                    window.actualizarKpiModalComposicion();
                }
            }
        }
    };

    window.toggleAutoRotar3D = function () {
        window.echartsAutoRotate = !window.echartsAutoRotate;
        var isRotating = window.echartsAutoRotate;

        var btnOrbit = $('.btn-orbit-3d');
        if (isRotating) {
            btnOrbit.html('<i class="fa fa-pause"></i> <span>Pausar</span>').removeClass('btn-default').addClass('btn-warning').css('background', '#d97706');
        } else {
            btnOrbit.html('<i class="fa fa-refresh" style="color: #0284c7;"></i> <span>Girar 360°</span>').removeClass('btn-warning').addClass('btn-default').css('background', '#ffffff');
        }

        if (typeof echarts !== 'undefined') {
            var c1 = echarts.getInstanceByDom(document.getElementById('echartsContainerCartera'));
            if (c1) {
                c1.setOption({ grid3D: { viewControl: { autoRotate: isRotating } } });
            }
            var c2 = echarts.getInstanceByDom(document.getElementById('echartsContainerModalCartera'));
            if (c2) {
                c2.setOption({ grid3D: { viewControl: { autoRotate: isRotating } } });
            }
        }
    };

    window.setPresetAngulo3D = function (alpha, beta, distance) {
        window.echarts3DAlpha = alpha;
        window.echarts3DBeta = beta;
        window.echarts3DDistance = distance || 170;
        if (window.echartsAutoRotate) {
            window.toggleAutoRotar3D();
        }

        if (typeof echarts !== 'undefined') {
            var opt = { grid3D: { viewControl: { alpha: alpha, beta: beta, distance: window.echarts3DDistance, autoRotate: false } } };
            var c1 = echarts.getInstanceByDom(document.getElementById('echartsContainerCartera'));
            if (c1) {
                c1.setOption(opt);
            }
            var c2 = echarts.getInstanceByDom(document.getElementById('echartsContainerModalCartera'));
            if (c2) {
                c2.setOption(opt);
            }
        }
    };

    window.aplicarTipoAGrafico = function (chart, tipo, forzar) {
        if (!chart) return;
        tipo = tipo || window.tipoGraficoActual || 'column';
        window.tipoGraficoActual = tipo;

        window.guardarConfiguracionOriginal(chart);
        var orig = chart._fgaOriginalConfig;
        if (!orig || !orig.series || orig.series.length === 0) return;

        var is3D = (tipo === 'matrix3d');
        var isModal = false;
        try {
            if (chart.container && ($(chart.container).closest('#mPopUp').length || $(chart.container).closest('#modalHighchartsContainer').length)) {
                isModal = true;
            } else if (chart.renderTo) {
                var elem = (typeof chart.renderTo === 'string') ? document.getElementById(chart.renderTo.replace(/^#/, '')) : chart.renderTo;
                if (elem && ($(elem).closest('#mPopUp').length || $(elem).closest('#modalHighchartsContainer').length)) {
                    isModal = true;
                }
            }
        } catch (e) {}

        if (is3D) {
            // MODO MATRIZ 3D MULTI-PERÍODO (WEBGL ECHARTS)
            $('#container').hide();
            $('#echartsContainerCartera').show();
            $('#modalHighchartsContainer').hide();
            $('#echartsContainerModalCartera').show();

            $('#histograma3DControllerCartera, #histograma3DControllerComposicion').css('display', 'flex');
            $('#histograma3DControllerModal').css('display', 'flex');

            setTimeout(function () {
                window.renderEChartsMatrix3D('echartsContainerCartera', chart);
                if (isModal || $('#mPopUp').hasClass('in')) {
                    window.renderEChartsMatrix3D('echartsContainerModalCartera', chart);
                }
            }, 80);
            setTimeout(function () {
                if (typeof echarts !== 'undefined') {
                    var c1 = echarts.getInstanceByDom(document.getElementById('echartsContainerCartera'));
                    if (c1) c1.resize();
                    var c2 = echarts.getInstanceByDom(document.getElementById('echartsContainerModalCartera'));
                    if (c2) c2.resize();
                }
            }, 250);

            return;
        }

        // RETORNO A MODO 2D (HIGHCHARTS TRADICIONAL)
        $('#container').show();
        $('#echartsContainerCartera').hide();
        $('#modalHighchartsContainer').show();
        $('#echartsContainerModalCartera').hide();

        $('#histograma3DControllerCartera, #histograma3DControllerComposicion').hide();
        $('#histograma3DControllerModal').hide();

        if (window.echartsAutoRotate) {
            window.toggleAutoRotar3D();
        }

        // Si ya está en este tipo 2D o es la carga inicial de columnas, no destruir y recrear series
        if (!forzar && chart._fgaCurrentTipo === tipo) {
            return;
        }
        if (!forzar && !chart._fgaCurrentTipo && tipo === 'column') {
            chart._fgaCurrentTipo = 'column';
            return;
        }
        chart._fgaCurrentTipo = tipo;

        // Limpiar series de Highcharts para reconstruir
        while (chart.series.length > 0) {
            chart.series[0].remove(false);
        }

        if (tipo === 'spline') {
            // MODO LÍNEAS (TENDENCIA)
            chart.update({
                chart: {
                    type: 'spline',
                    inverted: false,
                    options3d: { enabled: false }
                },
                plotOptions: {
                    series: {
                        stacking: null
                    },
                    spline: {
                        stacking: null,
                        lineWidth: 4.5,
                        marker: {
                            enabled: true,
                            radius: 5.5,
                            symbol: 'circle',
                            lineWidth: 2.2,
                            lineColor: '#ffffff'
                        }
                    }
                },
                xAxis: {
                    categories: orig.categories.slice()
                },
                tooltip: {
                    shared: true,
                    useHTML: true,
                    outside: true,
                    formatter: function () {
                        return window.formatGlobalChartTooltip ? window.formatGlobalChartTooltip(this) : null;
                    },
                    backgroundColor: 'transparent',
                    borderColor: 'transparent',
                    shadow: false,
                    padding: 0
                }
            }, false);

            chart.setTitle(
                orig.title ? { text: orig.title } : { text: '' },
                {
                    useHTML: false,
                    align: 'center',
                    verticalAlign: null,
                    y: null,
                    text: orig.subTitle || ''
                },
                false
            );

            orig.series.forEach(function (s, idx) {
                var isOrigLine = (s.origType === 'line');
                chart.addSeries({
                    name: s.name,
                    type: 'spline',
                    stacking: null,
                    color: s.color,
                    yAxis: s.yAxis,
                    data: JSON.parse(JSON.stringify(s.data)),
                    lineWidth: isOrigLine ? 5.5 : 4,
                    dashStyle: 'Solid',
                    zIndex: isOrigLine ? 15 : (10 - idx),
                    marker: {
                        enabled: true,
                        radius: isOrigLine ? 6.5 : 5.5,
                        symbol: 'circle',
                        lineWidth: 2.2,
                        lineColor: '#ffffff'
                    },
                    shadow: {
                        color: 'rgba(0, 0, 0, 0.22)',
                        offsetX: 1,
                        offsetY: 3,
                        width: 5,
                        opacity: 0.20
                    }
                }, false);
            });

        } else if (tipo === 'area') {
            // MODO ÁREAS APILADAS
            chart.update({
                chart: {
                    type: 'area',
                    inverted: false,
                    options3d: { enabled: false }
                },
                plotOptions: {
                    areaspline: {
                        stacking: 'normal',
                        fillOpacity: 0.38,
                        lineWidth: 2.5,
                        marker: { enabled: true, radius: 4 }
                    }
                },
                xAxis: {
                    categories: orig.categories.slice()
                },
                tooltip: {
                    shared: true,
                    useHTML: true,
                    outside: true,
                    formatter: function () {
                        return window.formatGlobalChartTooltip ? window.formatGlobalChartTooltip(this) : null;
                    },
                    backgroundColor: 'transparent',
                    borderColor: 'transparent',
                    shadow: false,
                    padding: 0
                }
            }, false);

            chart.setTitle(
                orig.title ? { text: orig.title } : { text: '' },
                {
                    useHTML: false,
                    align: 'center',
                    verticalAlign: null,
                    y: null,
                    text: orig.subTitle || ''
                },
                false
            );

            orig.series.forEach(function (s, idx) {
                var isOrigLine = (s.origType === 'line');
                if (isOrigLine) {
                    chart.addSeries({
                        name: s.name,
                        type: 'spline',
                        stacking: null,
                        color: s.color,
                        yAxis: s.yAxis,
                        data: JSON.parse(JSON.stringify(s.data)),
                        lineWidth: 5.5,
                        zIndex: 15,
                        marker: {
                            enabled: true,
                            radius: 6.5,
                            symbol: 'circle',
                            lineWidth: 2.5,
                            lineColor: '#ffffff'
                        }
                    }, false);
                } else {
                    chart.addSeries({
                        name: s.name,
                        type: 'areaspline',
                        stacking: 'normal',
                        color: s.color,
                        fillOpacity: 0.38,
                        lineWidth: 2.5,
                        yAxis: s.yAxis,
                        data: JSON.parse(JSON.stringify(s.data)),
                        zIndex: idx,
                        marker: { enabled: true, radius: 4 }
                    }, false);
                }
            });

        } else {
            // VERSIÓN ORIGINAL: COLUMNAS APILADAS PLANAS + LÍNEA EN 2D
            chart.update({
                chart: {
                    type: 'column',
                    inverted: false,
                    options3d: { enabled: false }
                },
                plotOptions: {
                    column: {
                        stacking: 'normal',
                        depth: 0,
                        borderWidth: 0,
                        pointPadding: 0.02,
                        groupPadding: 0.04,
                        maxPointWidth: 72
                    }
                },
                xAxis: {
                    categories: orig.categories.slice()
                },
                tooltip: {
                    shared: true,
                    useHTML: true,
                    outside: true,
                    formatter: function () {
                        return window.formatGlobalChartTooltip ? window.formatGlobalChartTooltip(this) : null;
                    },
                    backgroundColor: 'transparent',
                    borderColor: 'transparent',
                    shadow: false,
                    padding: 0
                }
            }, false);

            chart.setTitle(
                orig.title ? { text: orig.title } : { text: '' },
                {
                    useHTML: false,
                    align: 'center',
                    verticalAlign: null,
                    y: null,
                    text: orig.subTitle || ''
                },
                false
            );

            orig.series.forEach(function (s, idx) {
                var isOrigLine = (s.origType === 'line');
                if (isOrigLine) {
                    chart.addSeries({
                        name: s.name,
                        type: 'line',
                        color: s.color,
                        yAxis: s.yAxis,
                        data: JSON.parse(JSON.stringify(s.data)),
                        lineWidth: 5,
                        zIndex: 15,
                        linecap: 'round',
                        linejoin: 'round',
                        shadow: { color: 'rgba(0, 0, 0, 0.28)', offsetX: 1, offsetY: 4, width: 6, opacity: 0.25 },
                        marker: { enabled: true, radius: 6, symbol: 'circle', lineWidth: 2.5, lineColor: '#ffffff' }
                    }, false);
                } else {
                    chart.addSeries({
                        name: s.name,
                        type: 'column',
                        stacking: 'normal',
                        color: s.color,
                        yAxis: s.yAxis,
                        data: JSON.parse(JSON.stringify(s.data)),
                        zIndex: idx
                    }, false);
                }
            });
        }

        chart.redraw();

        try {
            var targetContainer = isModal ? document.getElementById('modalHighchartsContainer') : document.getElementById('container');
            var targetH = isModal ? 600 : 440;
            var w = targetContainer ? $(targetContainer).width() : null;
            if (!w || w < 200) {
                if (isModal) {
                    var mBody = $('#mPopUp .modal-body');
                    w = (mBody.length && mBody.width() > 200) ? Math.floor(mBody.width()) - 36 : null;
                } else {
                    var pW = $('#grafica').width() || $(chart.container).closest('.modern-table-card').width();
                    if (pW && pW > 200) w = Math.floor(pW) - 30;
                }
            }
            if (!w || w < 200) {
                if (isModal) {
                    var mDialog = $('#mPopUp .modal-dialog');
                    w = (mDialog.length && mDialog.width() > 200) ? Math.floor(mDialog.width()) - 60 : null;
                }
            }
            if (w && w > 200) {
                chart.setSize(w, targetH, false);
            }
            if (isModal && chart.container) {
                $(chart.container).css({ 'width': '100%', 'height': targetH + 'px' });
            }
            chart.reflow();

            setTimeout(function () {
                try {
                    var cElem = isModal ? document.getElementById('modalHighchartsContainer') : document.getElementById('container');
                    var curW = cElem ? $(cElem).width() : 0;
                    if (isModal && (!curW || curW < 300)) {
                        var mb = $('#mPopUp .modal-body');
                        if (mb.length && mb.width() > 300) curW = Math.floor(mb.width()) - 36;
                    }
                    if (curW && curW > 200) {
                        chart.setSize(curW, targetH, false);
                    }
                    if (isModal && chart.container) {
                        $(chart.container).css({ 'width': '100%', 'height': targetH + 'px' });
                    }
                    chart.reflow();
                } catch (ex) {}
            }, 60);
        } catch (e) {}
    };

    window.cambiarTipoGrafico = function (tipo) {
        window.tipoGraficoActual = tipo;
        window.cartera3DActivo = (tipo === 'matrix3d');

        // Sincronizar selectores
        $('#selTipoGraficoCartera, #selTipoGraficoComposicion, #selTipoGraficoModal').val(tipo);

        // Actualizar botones de 3D
        window.actualizarEstiloBotones3D(window.cartera3DActivo);

        if (typeof Highcharts !== 'undefined' && Highcharts.charts) {
            Highcharts.charts.forEach(function (c) {
                if (c) {
                    window.aplicarTipoAGrafico(c, tipo);
                }
            });
        }

        if (tipo !== 'matrix3d' && $('#mPopUp').hasClass('in')) {
            $('#modalHighchartsContainer').show();
            $('#echartsContainerModalCartera').hide();
            setTimeout(function () {
                if (typeof Highcharts !== 'undefined' && Highcharts.charts) {
                    Highcharts.charts.forEach(function (c) {
                        if (c && c.container && ($(c.container).closest('#mPopUp').length || $(c.container).closest('#modalHighchartsContainer').length)) {
                            var mW = $('#modalHighchartsContainer').width() || ($('#mPopUp .modal-body').width() - 36);
                            if (mW && mW > 200) {
                                c.setSize(mW, 600, false);
                            }
                            $(c.container).css({ 'width': '100%', 'height': '600px' });
                            c.reflow();
                        }
                    });
                }
            }, 100);
        }

        if ($('#mPopUp').hasClass('in') && typeof window.actualizarKpiModalComposicion === 'function') {
            window.actualizarKpiModalComposicion();
        }
    };

    window.actualizarEstiloBotones3D = function (is3D) {
        var btnMain = document.getElementById('btnToggle3DComposicion') || document.getElementById('btnToggle3DCartera');
        var btnModal = document.getElementById('btnToggle3DModal');
        var lblMain = document.getElementById('lblToggle3DComposicion') || document.getElementById('lblToggle3D');
        var lblModal = document.getElementById('lblToggle3DModal');

        var activeStyle = "height: 28px; padding: 0 11px; font-size: 11.5px; font-weight: 600; border-radius: 6px; display: inline-flex; align-items: center; gap: 6px; border: 1px solid #bae6fd; background: #f0f9ff; color: #0369a1; cursor: pointer; transition: all 0.2s ease; box-shadow: 0 1px 2px rgba(0,0,0,0.04);";
        var inactiveStyle = "height: 28px; padding: 0 11px; font-size: 11.5px; font-weight: 600; border-radius: 6px; display: inline-flex; align-items: center; gap: 6px; border: 1px solid #cbd5e1; background: #f1f5f9; color: #475569; cursor: pointer; transition: all 0.2s ease; box-shadow: 0 1px 2px rgba(0,0,0,0.04);";

        var modalActiveStyle = "height: 28px; padding: 0 11px; font-size: 11.5px; font-weight: 600; border-radius: 6px; display: inline-flex; align-items: center; gap: 6px; border: 1px solid rgba(255,255,255,0.4); background: rgba(255,255,255,0.22); color: #ffffff; cursor: pointer; transition: all 0.2s ease;";
        var modalInactiveStyle = "height: 28px; padding: 0 11px; font-size: 11.5px; font-weight: 600; border-radius: 6px; display: inline-flex; align-items: center; gap: 6px; border: 1px solid rgba(255,255,255,0.2); background: rgba(0,0,0,0.15); color: rgba(255,255,255,0.75); cursor: pointer; transition: all 0.2s ease;";

        if (btnMain) {
            btnMain.setAttribute('style', is3D ? activeStyle : inactiveStyle);
            if (lblMain) lblMain.innerText = is3D ? 'Vista 3D: ON' : 'Vista 3D';
        }
        if (btnModal) {
            btnModal.setAttribute('style', is3D ? modalActiveStyle : modalInactiveStyle);
            if (lblModal) lblModal.innerText = is3D ? 'Vista 3D: ON' : 'Vista 3D';
        }
    };

    window.toggle3DCartera = function (btn) {
        window.cartera3DActivo = !window.cartera3DActivo;
        var is3D = window.cartera3DActivo;
        var nuevoTipo = is3D ? 'matrix3d' : 'column';
        window.cambiarTipoGrafico(nuevoTipo);
    };

    window.aplicarEstilo3DCartera = function (chart, activo) {
        if (typeof activo === 'boolean') {
            window.cartera3DActivo = activo;
        }
        window.cambiarTipoGrafico(window.cartera3DActivo ? 'matrix3d' : 'column');
    };

    $('#mPopUp').on('shown.bs.modal', function () {
        if (window.tipoGraficoActual === 'matrix3d') {
            $('#modalHighchartsContainer').hide();
            $('#echartsContainerModalCartera').show();
            setTimeout(function () {
                window.renderEChartsMatrix3D('echartsContainerModalCartera');
                window.actualizarKpiModalComposicion();
            }, 80);
            return;
        }

        if (typeof Highcharts !== 'undefined') {
            if (typeof resizeAllChartsInModal === 'function') {
                resizeAllChartsInModal(this);
            }
            Highcharts.charts.forEach(function (chart) {
                if (!chart) return;
                var elem = (typeof getHighchartsRenderElement === 'function') ? getHighchartsRenderElement(chart) : (chart.renderTo ? (typeof chart.renderTo === 'string' ? document.getElementById(chart.renderTo.replace(/^#/, '')) : chart.renderTo) : null);
                if ((elem && $(elem).closest('#mPopUp').length) || (chart.container && ($(chart.container).closest('#mPopUp').length || $(chart.container).closest('#modalHighchartsContainer').length))) {
                    chart.hasUserSize = true;
                    var mW = $('#modalHighchartsContainer').width() || ($('#mPopUp .modal-body').width() - 36);
                    if (mW && mW > 200) {
                        chart.setSize(mW, 600, false);
                    }
                    if (chart.container) {
                        $(chart.container).css({ 'width': '100%', 'height': '600px' });
                    }
                    window.guardarConfiguracionOriginal(chart);
                    window.aplicarTipoAGrafico(chart, window.tipoGraficoActual);
                    chart.reflow();
                }
            });

            setTimeout(function () {
                window.actualizarKpiModalComposicion();
            }, 180);
        }
    });

    window.actualizarKpiModalComposicion = function () {
        try {
            var chartOrig = null;
            if (typeof Highcharts !== 'undefined' && Highcharts.charts) {
                for (var i = 0; i < Highcharts.charts.length; i++) {
                    var c = Highcharts.charts[i];
                    if (c && c._fgaOriginalConfig && c._fgaOriginalConfig.categories && c._fgaOriginalConfig.categories.length > 0) {
                        chartOrig = c;
                        break;
                    }
                }
            }
            if (!chartOrig || !chartOrig._fgaOriginalConfig) return;
            var orig = chartOrig._fgaOriginalConfig;
            var cats = orig.categories || [];
            var colSeries = orig.series.filter(function (s) { return s.origType === 'column'; });
            if (colSeries.length === 0) colSeries = orig.series;

            var formatNum = function (n) {
                return (typeof n === 'number') ? n.toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : n;
            };

            if (window.tipoGraficoActual === 'matrix3d') {
                var lastIdx = (cats.length > 0) ? (cats.length - 1) : 0;
                var lastMonthName = cats[lastIdx] || 'Corte';

                var totMes = 0;
                var vigVal = 0;
                var vencVal = 0;
                var moraCritVal = 0;

                colSeries.forEach(function (s) {
                    var v = 0;
                    if (s.data && s.data.length > lastIdx) {
                        var pt = s.data[lastIdx];
                        if (typeof pt === 'number') v = pt;
                        else if (pt && typeof pt.y === 'number') v = pt.y;
                        else if (Array.isArray(pt) && typeof pt[1] === 'number') v = pt[1];
                    }
                    v = Math.max(0, parseFloat(v) || 0);
                    totMes += v;

                    var n = (s.name || '').toLowerCase();
                    if (n.indexOf('al d') > -1 || n.indexOf('vigente') > -1) {
                        vigVal += v;
                    } else {
                        vencVal += v;
                        if (n.indexOf('90') > -1 || n.indexOf('mayor') > -1 || n.indexOf('crit') > -1) {
                            moraCritVal += v;
                        }
                    }
                });

                var pctVenc = totMes > 0 ? ((vencVal / totMes) * 100) : 0;
                var pctVig = totMes > 0 ? ((vigVal / totMes) * 100) : 0;
                var pctCrit = totMes > 0 ? ((moraCritVal / totMes) * 100) : 0;

                $('#composicionModalKpiStrip').html(
                    '<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 7px 14px;">' +
                    '    <div>' +
                    '        <span style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 600; display: block; line-height: 1.2;">Último Período</span>' +
                    '        <span style="font-size: 14.5px; font-weight: 700; color: #1e3a8a;">' + lastMonthName + '</span>' +
                    '    </div>' +
                    '    <div style="border-left: 1px solid #cbd5e1; padding-left: 14px;">' +
                    '        <span style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 600; display: block; line-height: 1.2;">Saldo Total Cartera</span>' +
                    '        <span style="font-size: 14.5px; font-weight: 700; color: #0f172a;">' + formatNum(totMes) + '</span>' +
                    '    </div>' +
                    '    <div style="border-left: 1px solid #cbd5e1; padding-left: 14px;">' +
                    '        <span style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 600; display: block; line-height: 1.2;">Vigente / Al Día</span>' +
                    '        <span class="badge" style="background-color: #dbeafe; color: #1e40af; font-size: 11.5px; font-weight: 700; padding: 3px 8px; border-radius: 6px;">' +
                    '            ' + formatNum(pctVig) + '% (' + formatNum(vigVal) + ')' +
                    '        </span>' +
                    '    </div>' +
                    '    <div style="border-left: 1px solid #cbd5e1; padding-left: 14px;">' +
                    '        <span style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 600; display: block; line-height: 1.2;">Cartera Vencida (>0 d)</span>' +
                    '        <span class="badge" style="background-color: #ffedd5; color: #c2410c; font-size: 11.5px; font-weight: 700; padding: 3px 8px; border-radius: 6px;">' +
                    '            ' + formatNum(pctVenc) + '% (' + formatNum(vencVal) + ')' +
                    '        </span>' +
                    '    </div>' +
                    '    <div style="border-left: 1px solid #cbd5e1; padding-left: 14px;">' +
                    '        <span style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 600; display: block; line-height: 1.2;">Mora Crítica (>90 d)</span>' +
                    '        <span class="badge" style="background-color: #fee2e2; color: #991b1b; font-size: 11.5px; font-weight: 700; padding: 3px 8px; border-radius: 6px;">' +
                    '            ' + formatNum(pctCrit) + '% (' + formatNum(moraCritVal) + ')' +
                    '        </span>' +
                    '    </div>' +
                    '</div>'
                );
                return;
            }

            function renderComposicionKpi(selectedIdx) {
                var modalCharts = Highcharts.charts.filter(function (c) {
                    var elem = (typeof getHighchartsRenderElement === 'function') ? getHighchartsRenderElement(c) : (c && typeof c.renderTo === 'string' ? document.getElementById(c.renderTo.replace(/^#/, '')) : (c ? c.renderTo : null));
                    return c && elem && $(elem).closest('#mPopUp').length && c.series && c.series.length > 0;
                });
                var chart = (modalCharts.length > 0) ? modalCharts[0] : chartOrig;
                if (!chart || !chart.series || chart.series.length === 0) return;

                var seriesIdx = 0;
                if (typeof selectedIdx === 'number' && selectedIdx >= 0 && selectedIdx < chart.series.length) {
                    seriesIdx = selectedIdx;
                } else {
                    for (var k = 0; k < chart.series.length; k++) {
                        if (chart.series[k].type === 'spline' || chart.series[k].type === 'line') {
                            seriesIdx = k;
                            break;
                        }
                    }
                }

                var s = chart.series[seriesIdx];
                if (!s || !s.data || s.data.length === 0) return;

                var rawData = s.data.map(function (pt) {
                    if (!pt) return 0;
                    if (typeof pt.y === 'number') return pt.y;
                    if (Array.isArray(pt) && typeof pt[1] === 'number') return pt[1];
                    return parseFloat(pt.y) || 0;
                });

                if (rawData.length === 0) return;

                var p1Label = cats && cats.length > 0 ? cats[0] : 'Inicial';
                var p2Label = cats && cats.length > 0 ? cats[cats.length - 1] : 'Final';
                var v1 = rawData[0];
                var v2 = rawData[rawData.length - 1];
                var diff = v2 - v1;
                var sum = rawData.reduce(function (a, b) { return a + b; }, 0);
                var avg = sum / rawData.length;
                var minVal = Math.min.apply(null, rawData);
                var maxVal = Math.max.apply(null, rawData);

                var sName = s.name || '';
                var yLabelsFormatter = (s.yAxis && s.yAxis.options && s.yAxis.options.labels && s.yAxis.options.labels.formatter) ? s.yAxis.options.labels.formatter.toString() : '';
                var isPct = (sName.indexOf('%') > -1) ||
                            (s.yAxis && s.yAxis.options && s.yAxis.options.title && s.yAxis.options.title.text && (s.yAxis.options.title.text.indexOf('Porcent') > -1 || s.yAxis.options.title.text.indexOf('Concentrac') > -1)) ||
                            (yLabelsFormatter.indexOf('formatPercent') > -1 || yLabelsFormatter.indexOf('%') > -1);
                var suf = isPct ? '%' : '';

                var isPos = diff >= 0;
                var badgeBg = isPos ? 'background-color: #dbeafe; color: #1e40af;' : 'background-color: #ffedd5; color: #c2410c;';
                var sign = isPos ? '+' : '';

                var diffFormatted = sign + formatNum(diff) + (isPct ? ' p.p.' : suf);

                var selectorHtml = '';
                if (chart.series.length > 1) {
                    selectorHtml =
                        '<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; flex-wrap: wrap; gap: 8px;">' +
                        '    <div style="font-size: 12.5px; font-weight: 700; color: #1e3a8a; display: flex; align-items: center; gap: 6px;">' +
                        '        <i class="fa fa-sliders" style="color: #2F5597;"></i> Indicadores de la serie:' +
                        '    </div>' +
                        '    <div>' +
                        '        <select id="composicionModalSeriesSelect" class="form-control" style="height: 28px; font-size: 12px; font-weight: 600; padding: 2px 8px; border-radius: 6px; border: 1px solid #cbd5e1; color: #1e3a8a; background: #ffffff; min-width: 240px;">';

                    for (var idx = 0; idx < chart.series.length; idx++) {
                        var ser = chart.series[idx];
                        var isSelected = (idx === seriesIdx) ? ' selected' : '';
                        selectorHtml += '<option value="' + idx + '"' + isSelected + '>● ' + (ser.name || ('Serie ' + (idx + 1))) + '</option>';
                    }

                    selectorHtml +=
                        '        </select>' +
                        '    </div>' +
                        '</div>';
                }

                var stripHtml = selectorHtml +
                    '<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 7px 14px;">' +
                    '    <div>' +
                    '        <span style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 600; display: block; line-height: 1.2;">Período Inicial (' + p1Label + ')</span>' +
                    '        <span style="font-size: 14.5px; font-weight: 700; color: #1e3a8a;">' + formatNum(v1) + suf + '</span>' +
                    '    </div>' +
                    '    <div style="border-left: 1px solid #cbd5e1; padding-left: 14px;">' +
                    '        <span style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 600; display: block; line-height: 1.2;">Período Final (' + p2Label + ')</span>' +
                    '        <span style="font-size: 14.5px; font-weight: 700; color: #0f172a;">' + formatNum(v2) + suf + '</span>' +
                    '    </div>' +
                    '    <div style="border-left: 1px solid #cbd5e1; padding-left: 14px;">' +
                    '        <span style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 600; display: block; line-height: 1.2;">Variación</span>' +
                    '        <span class="badge" style="' + badgeBg + ' font-size: 11.5px; font-weight: 700; padding: 3px 8px; border-radius: 6px;">' +
                    '            ' + diffFormatted +
                    '        </span>' +
                    '    </div>' +
                    '    <div style="border-left: 1px solid #cbd5e1; padding-left: 14px;">' +
                    '        <span style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 600; display: block; line-height: 1.2;">Promedio</span>' +
                    '        <span style="font-size: 14.5px; font-weight: 700; color: #334155;">' + formatNum(avg) + suf + '</span>' +
                    '    </div>' +
                    '    <div style="border-left: 1px solid #cbd5e1; padding-left: 14px;">' +
                    '        <span style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 600; display: block; line-height: 1.2;">Mín / Máx</span>' +
                    '        <span style="font-size: 13px; font-weight: 600; color: #475569;">' +
                    '            ' + formatNum(minVal) + suf + ' / ' + formatNum(maxVal) + suf +
                    '        </span>' +
                    '    </div>' +
                    '</div>';

                $('#composicionModalKpiStrip').html(stripHtml);

                $('#composicionModalSeriesSelect').off('change').on('change', function () {
                    var newIdx = parseInt($(this).val(), 10);
                    renderComposicionKpi(newIdx);
                });
            }

            renderComposicionKpi();
            if (chartOrig && typeof chartOrig.reflow === 'function') {
                chartOrig.reflow();
            }
        } catch (e) {
            console.error(e);
        }
    };

    function formatMillion() {
        if (typeof Highcharts !== 'undefined' && Highcharts.numberFormat) {
            var decimals = (this.value % 1 !== 0) ? 2 : 0;
            return Highcharts.numberFormat(this.value, decimals, '.', ',');
        }
        return this.value;
    }

    function formatPercent() {
        if (typeof Highcharts !== 'undefined' && Highcharts.numberFormat) {
            var decimals = (this.value % 1 !== 0) ? 2 : 0;
            return Highcharts.numberFormat(this.value, decimals, '.', ',') + ' %';
        }
        return this.value + " %";
    }

    $(function () {
        function asegurarAnchoCompleto() {
            var containerElem = document.getElementById('container');
            var targetWidth = containerElem ? $(containerElem).width() : null;
            if (!targetWidth || targetWidth < 200) {
                var gW = $('#grafica').width() || $('#grafica').closest('.col-xs-12').width() || 1100;
                targetWidth = Math.floor(gW) - 30;
            }
            $('#grafica #container, #grafica div[id$="_container"], #grafica .highcharts-container').css({
                'width': '100%',
                'max-width': '100%',
                'overflow': 'visible'
            });
            if (typeof Highcharts !== 'undefined' && Highcharts.charts) {
                Highcharts.charts.forEach(function (c) {
                    if (!c) return;
                    var elem = (typeof c.renderTo === 'string') ? document.getElementById(c.renderTo.replace(/^#/, '')) : c.renderTo;
                    if (elem && $(elem).closest('#container').length) {
                        try {
                            if (targetWidth && targetWidth > 200) {
                                c.setSize(targetWidth, 420, false);
                            }
                            window.guardarConfiguracionOriginal(c);
                            if (window.tipoGraficoActual && window.tipoGraficoActual !== 'column') {
                                if (typeof window.aplicarTipoAGrafico === 'function') {
                                    window.aplicarTipoAGrafico(c, window.tipoGraficoActual);
                                }
                            }
                            c.reflow();
                        } catch (e) {}
                    }
                });
            }
            $('#selTipoGraficoCartera, #selTipoGraficoComposicion, #selTipoGraficoModal').val(window.tipoGraficoActual || 'column');
            window.actualizarEstiloBotones3D(window.cartera3DActivo);
        }
        setTimeout(asegurarAnchoCompleto, 60);

        $(window).on('resize', function () {
            if (window.tipoGraficoActual === 'matrix3d' && typeof echarts !== 'undefined') {
                var c1 = echarts.getInstanceByDom(document.getElementById('echartsContainerCartera'));
                if (c1) c1.resize();
                var c2 = echarts.getInstanceByDom(document.getElementById('echartsContainerModalCartera'));
                if (c2) c2.resize();
            }
        });
    });
</script>