    // Habilitar rotación 360° arrastrando directamente con el ratón o touch
    window.habilitarRotacion3D = function (chart) {
        if (!chart || chart._fgaRotacion3DEnabled) return;
        chart._fgaRotacion3DEnabled = true;

        var container = chart.container;
        if (!container) return;

        var isDragging = false;
        var downX = 0, downY = 0;
        var origAlpha = 12, origBeta = 18;

        $(container).on('mousedown.fga3d touchstart.fga3d', function (e) {
            if (!chart.options || !chart.options.chart || !chart.options.chart.options3d || !chart.options.chart.options3d.enabled) return;
            isDragging = true;
            if (window.orbitTimer) window.toggleAutoRotar3D();
            var pageX = e.pageX || (e.originalEvent && e.originalEvent.touches && e.originalEvent.touches[0] ? e.originalEvent.touches[0].pageX : 0);
            var pageY = e.pageY || (e.originalEvent && e.originalEvent.touches && e.originalEvent.touches[0] ? e.originalEvent.touches[0].pageY : 0);
            downX = pageX;
            downY = pageY;
            origAlpha = chart.options.chart.options3d.alpha;
            origBeta = chart.options.chart.options3d.beta;
            $(container).css('cursor', 'grabbing');
        });

        $(document).on('mousemove.fga3d touchmove.fga3d', function (e) {
            if (!isDragging) return;
            if (!chart.options || !chart.options.chart || !chart.options.chart.options3d || !chart.options.chart.options3d.enabled) return;
            var pageX = e.pageX || (e.originalEvent && e.originalEvent.touches && e.originalEvent.touches[0] ? e.originalEvent.touches[0].pageX : 0);
            var pageY = e.pageY || (e.originalEvent && e.originalEvent.touches && e.originalEvent.touches[0] ? e.originalEvent.touches[0].pageY : 0);
            var deltaX = pageX - downX;
            var deltaY = pageY - downY;

            var newBeta = origBeta + (deltaX * 0.45);
            var newAlpha = Math.max(2, Math.min(65, origAlpha - (deltaY * 0.35)));

            chart.options.chart.options3d.alpha = newAlpha;
            chart.options.chart.options3d.beta = newBeta;
            chart.redraw(false);
        });

        $(document).on('mouseup.fga3d touchend.fga3d', function () {
            if (isDragging) {
                isDragging = false;
                if (container) $(container).css('cursor', 'default');
            }
        });
    };

    // Auto-rotación continua 360° cinematográfica
    window.toggleAutoRotar3D = function () {
        var btnOrbit = $('.btn-orbit-3d');
        if (window.orbitTimer) {
            clearInterval(window.orbitTimer);
            window.orbitTimer = null;
            btnOrbit.html('<i class="fa fa-refresh" style="color: #0284c7;"></i> <span>Girar 360°</span>').removeClass('btn-warning').addClass('btn-default').css('background', '#ffffff');
        } else {
            btnOrbit.html('<i class="fa fa-pause"></i> <span>Pausar</span>').removeClass('btn-default').addClass('btn-warning').css('background', '#d97706');
            window.orbitTimer = setInterval(function () {
                if (typeof Highcharts !== 'undefined' && Highcharts.charts) {
                    Highcharts.charts.forEach(function (c) {
                        if (c && c.options && c.options.chart && c.options.chart.options3d && c.options.chart.options3d.enabled) {
                            c.options.chart.options3d.beta = (c.options.chart.options3d.beta + 0.9) % 360;
                            c.redraw(false);
                        }
                    });
                }
            }, 35);
        }
    };

    // Ajustar ángulo a presets predefinidos
    window.setPresetAngulo3D = function (alpha, beta) {
        if (window.orbitTimer) window.toggleAutoRotar3D();
        if (typeof Highcharts !== 'undefined' && Highcharts.charts) {
            Highcharts.charts.forEach(function (c) {
                if (c && c.options && c.options.chart && c.options.chart.options3d && c.options.chart.options3d.enabled) {
                    c.options.chart.options3d.alpha = alpha;
                    c.options.chart.options3d.beta = beta;
