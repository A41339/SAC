@model  FGA.Model.Composicion_cartera

@{
    ViewBag.Title = "Composici&oacute;n de cartera";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section ScriptsOrCss
{
    <link rel="stylesheet" href="~/Content/multiselect/docs/css/prettify.min.css" type="text/css">
    <script type="text/javascript" src="~/Content/multiselect/docs/js/prettify.min.js"></script>
    <link rel="stylesheet" href="~/Content/multiselect/dist/css/bootstrap-multiselect.css" type="text/css">
    <script type="text/javascript" src="~/Content/multiselect/dist/js/bootstrap-multiselect.js"></script>
}

<section class="content-header">
    <h1 class="modern-page-title">
        <i class="fa fa-pie-chart" style="color: #0284c7;"></i>
        Composici&oacute;n de la Cartera
        <small>Distribuci&oacute;n, categor&iacute;as de riesgo y tipos de cartera</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="@Url.Action("Index", "Modulo", new { modulo = "Cartera" })" class="breadcrumb-parent-pill" title="Volver al menÃÂº de Cartera"><i class="fa fa-pie-chart" style="margin-right: 4px;"></i> Cartera</a></li>
        <li class="active">Composici&oacute;n</li>
    </ol>
</section>

<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div class="modern-filter-card">
                <div class="modern-filter-toolbar">
                    <div class="filter-item">
                        <label for="IdEntidad"><i class="fa fa-university"></i> Entidad:</label>
                        @Html.DropDownList("Entidades", null, new { @id = "IdEntidad", @class = "form-control modern-select", style = "min-width: 250px;" })
                    </div>
                    <div class="filter-item">
                        <label for="Grafico"><i class="fa fa-bar-chart"></i> Gr&aacute;fico:</label>
                        @Html.DropDownList("Grafico", null, new { @id = "Grafico", @class = "form-control modern-select", style = "min-width: 250px;" })
                    </div>
                    <div class="filter-item">
                        <label for="PeriodoI"><i class="fa fa-calendar"></i> Inicial:</label>
                        <div class="modern-input-wrapper">
                            <input name="PeriodoI" id="PeriodoI" class="datecontrol form-control modern-date-input" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo1"].ToString()).ToString("MM/yyyy")" style="min-width: 130px;" />
                        </div>
                    </div>
                    <div class="filter-item">
                        <label for="PeriodoF"><i class="fa fa-calendar"></i> Final:</label>
                        <div class="modern-input-wrapper">
                            <input name="PeriodoF" id="PeriodoF" class="datecontrol form-control modern-date-input" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo2"].ToString()).ToString("MM/yyyy")" style="min-width: 130px;" />
                        </div>
                    </div>
                    <div id="cmb_categoria" class="filter-item hidden">
                        <label id="lbl_categoria"><i class="fa fa-tags"></i> Categor&iacute;as:</label>
                        <select id="IdCategoria" name="CategoriaRiesgo" multiple="multiple">
                            @foreach (var detalle in Model.listaCategoriaRiesgo)
                            {
                                <option value="@detalle.CategoriaRiesgo">@detalle.CategoriaRiesgo</option>
                            }
                        </select>
                    </div>
                    <div id="cmb_tipoCartera" class="filter-item hidden">
                        <label id="lbl_tipoCartera"><i class="fa fa-folder-open"></i> Tipos de Cartera:</label>
                        <select id="IdTipoCartera" name="TipoCartera" multiple="multiple">
                            @foreach (var detalle in Model.listaTiposCartera)
                            {
                                <option value="@detalle.Nombre">@detalle.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="filter-item" style="margin-left: auto;">
                        <button type="button" id="btn_buscar" class="btn-modern-filter">
                            <i class="fa fa-search"></i> Generar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-xs-12">
            <div id="grafica">
            </div>
        </div>
    </div>

    <!-- Nota Informativa al pie de página -->
    <div class="row">
        <div class="col-xs-12">
            <div class="modern-info-card" style="margin-top: 15px; margin-bottom: 20px; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 10px; padding: 14px 18px; display: flex; align-items: center; gap: 12px;">
                <div style="width: 32px; height: 32px; border-radius: 50%; background: #2563eb; color: #ffffff; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-weight: 700; font-size: 14px;">
                    i
                </div>
                <div style="font-size: 13px; color: #1e3a8a;">
                    <strong>Nota:</strong> Toda la información se presenta en millones de colones y corresponde al período de referencia seleccionado.
                </div>
            </div>
        </div>
    </div>
</section>

<script type="text/javascript">

    function initMultiselects() {
        $('#IdCategoria').multiselect({
            enableFiltering: true,
            filterBehavior: 'text',
            buttonWidth: '220px',
            numberDisplayed: 1,
            maxHeight: 450
        });

        $('#IdTipoCartera').multiselect({
            enableFiltering: true,
            filterBehavior: 'text',
            buttonWidth: '220px',
            numberDisplayed: 1,
            maxHeight: 450
        });
    }

    function toggleCategoryTypes() {
        var val = $("#Grafico").val();
        if (val == 3) {
            $("#cmb_categoria, #lbl_categoria").removeClass("hidden").show();
            $("#cmb_tipoCartera, #lbl_tipoCartera").addClass("hidden").hide();
        }
        else if (val == 7) {
            $("#cmb_tipoCartera, #lbl_tipoCartera").removeClass("hidden").show();
            $("#cmb_categoria, #lbl_categoria").addClass("hidden").hide();
        }
        else {
            $("#cmb_categoria, #lbl_categoria, #cmb_tipoCartera, #lbl_tipoCartera").addClass("hidden").hide();
        }
    }

    $(document).ready(function () {
        initMultiselects();
        toggleCategoryTypes();
        refreshGraph();
    });

    $("#Grafico").change(function () {
        toggleCategoryTypes();
        refreshGraph();
    });

    $("#IdEntidad").change(function () {
        refreshGraph();
    });

    function refreshGraph() {
         $('#grafica').html('<div style="text-align: center; padding: 40px 0; color: #64748b;"><i class="fa fa-spinner fa-spin fa-2x"></i><p style="margin-top: 10px; font-size: 13px;">Cargando gráfico...</p></div>');
         $.ajax({
            url: '@Url.Action("GraficaDetalle", "Composicion")',
            type: 'POST',
            cache: false,
            data: {
                 'Entidades': $('#IdEntidad').val(),
                 'Grafico': $('#Grafico').val(),
                 'PeriodoI': $('#PeriodoI').val(),
                 'PeriodoF': $('#PeriodoF').val(),
                 'CategoriaRiesgo': $('#IdCategoria').val(),
                 'TipoCartera': $('#IdTipoCartera').val()
            },
             success: function (result) {
                 $('#grafica').html(result);
                 $("#entidad").text($("#Grafico :selected").text());
                 $("#pEntidad").text($("#Grafico :selected").text());
            },
            error: function () {
                $('#grafica').html('<div class="alert alert-danger" style="margin: 20px;">Ocurrió un error al cargar el gráfico.</div>');
            }
         });
    }

    $(document).on('click', '#btn_buscar', function () {
        refreshGraph();
    });

    function formatMillion() {
        if ($("#Grafico").length && $("#Grafico :selected").length) {
            $("#entidad").text($("#Grafico :selected").text() + " en millones");
            $("#pEntidad").text($("#Grafico :selected").text() + " en millones");
        }
        if (typeof Highcharts !== 'undefined' && Highcharts.numberFormat) {
            var decimals = (this.value % 1 !== 0) ? 2 : 0;
            return Highcharts.numberFormat(this.value, decimals, '.', ',');
        }
        return this.value;
    }

    function formatPercent() {
        if (typeof Highcharts !== 'undefined' && Highcharts.numberFormat) {
            var decimals = (this.value % 1 !== 0) ? 2 : 0;
            return Highcharts.numberFormat(this.value, decimals, '.', ',') + ' %';
        }
        return this.value + " %";
    }

</script>