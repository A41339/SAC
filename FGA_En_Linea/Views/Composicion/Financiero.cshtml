@model FGA.Model.Graficos_Financieros

@{
    ViewBag.Title = "Composición financiera";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content-header">
    <h1>
        Composición financiera
    </h1>
</section>

<section class="content">
    @using (Html.BeginForm("LoadBuscarFinac", "Composicion", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmGraph" }))
    {
        @Html.AntiForgeryToken()


        <div class="row">
            <div class="col-xs-12">
                <div class="modern-filter-card">
                    <div class="modern-filter-toolbar">
                        <div class="filter-item">
                            <label for="IdEntidad"><i class="fa fa-university"></i> Entidad:</label>
                            @Html.DropDownList("Entidades", null, new { @id = "IdEntidad", @class = "form-control modern-select", style = "min-width: 220px;" })
                        </div>
                        <div class="filter-item">
                            <label for="Periodo1"><i class="fa fa-calendar"></i> Periodo 1:</label>
                            <div class="modern-input-wrapper">
                                <input name="Periodo1" id="Periodo1" class="datecontrol form-control modern-date-input" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo1"].ToString()).ToString("MM/yyyy")" style="min-width: 130px;" />
                            </div>
                        </div>
                        <div class="filter-item">
                            <label for="Periodo2"><i class="fa fa-calendar"></i> Periodo 2:</label>
                            <div class="modern-input-wrapper">
                                <input name="Periodo2" id="Periodo2" class="datecontrol form-control modern-date-input" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo2"].ToString()).ToString("MM/yyyy")" style="min-width: 130px;" />
                            </div>
                        </div>
                        <div class="filter-item">
                            <label for="Periodo3"><i class="fa fa-calendar"></i> Periodo 3:</label>
                            <div class="modern-input-wrapper">
                                <input name="Periodo3" id="Periodo3" class="datecontrol form-control modern-date-input" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo3"].ToString()).ToString("MM/yyyy")" style="min-width: 130px;" />
                            </div>
                        </div>
                        <div class="filter-item" style="display: inline-flex; align-items: center; gap: 8px; margin-top: 22px;">
                            @Html.CheckBox("chkprivate", bool.Parse(Session["Check"].ToString()), new { style = "width: 18px; height: 18px; margin: 0; cursor: pointer;" })
                            <label for="chkprivate" style="margin-bottom: 0; cursor: pointer;">Dos periodos</label>
                        </div>
                        <div class="filter-item" style="margin-left: auto;">
                            <button type="submit" name="submit" class="btn-modern-filter">
                                <i class="fa fa-search"></i> Generar
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

                <div>
                    <div class="nav-tabs-custom">
                        <ul class="nav nav-tabs">
                            <li class="active"><a href="#tab_1" data-toggle="tab">Composición del balance</a></li>
                            <li><a href="#tab_2" data-toggle="tab">Activo</a></li>
                            <li><a href="#tab_3" data-toggle="tab">Pasivo</a></li>
                            <li><a href="#tab_4" data-toggle="tab">Ingresos y gastos</a></li>
                        </ul>
                        <div class="tab-content">
                            <div class="tab-pane active" id="tab_1">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="box box-primary">
                                            <div class="box-body">
                                                <div class="row">
                                                    <div class="col-xs-12">
                                                        <span id="found" class="label label-info"></span>
                                                        <table id="tbBalance" class="table table-striped table-bordered" style="width:100%; height: 350px">
                                                            <thead>
                                                                <tr>
                                                                    <th colspan="4">
                                                                        <img width="50" height="50" src="@Session["Logo"]" />
                                                                        <label class="box-title">Composición del balance en millones</label>
                                                                    </th>
                                                                </tr>
                                                                <tr>
                                                                    <th></th>
                                                                    <th>
                                                                        @FGA.Utility.Utilitarios.toUpperFirstLetter(FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo1"].ToString()).ToString("MMMM yyyy"))
                                                                    </th>
                                                                    <th>
                                                                        @FGA.Utility.Utilitarios.toUpperFirstLetter(FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo2"].ToString()).ToString("MMMM yyyy"))
                                                                    </th>
                                                                    <th id="tercerPeriodo">
                                                                        @FGA.Utility.Utilitarios.toUpperFirstLetter(FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo3"].ToString()).ToString("MMMM yyyy"))
                                                                    </th>
                                                                </tr>
                                                            </thead>
                                                            <tbody></tbody>
                                                        </table>
                                                        <div id="summary">
                                                            <div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="box box-warning">
                                            <div class="box-header with-border">
                                                <img width="50" height="50" src="@Session["Logo"]" />
                                                <h4 class="box-title">Composición del balance</h4>
                                            </div>
                                            <div class="box-body">
                                                @(Model.composicionBalance)
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="tab-pane" id="tab_2">
                                <div class="row">
                                    <div class="col-sm-12">
                                        <div class="col-md-12">
                                            <div class="box box-primary">
                                                <div class="box-header with-border">
                                                    <img width="50" height="50" src="@Session["Logo"]" />
                                                    <h4 class="box-title">Activo</h4>
                                                </div>
                                                <div class="box-body">
                                                    @(Model.composicionActivoPorc)
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="box box-warning">
                                                <div class="box-header with-border">
                                                    <img width="50" height="50" src="@Session["Logo"]" />
                                                    <h4 class="box-title">Composición del activo productivo en millones</h4>
                                                </div>
                                                <div class="box-body">
                                                    @(Model.composicionActivoMonto)
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="tab-pane" id="tab_3">
                                <div class="row">
                                    <div class="col-sm-12">
                                        <div class="col-md-12">
                                            <div class="box box-primary">
                                                <div class="box-header with-border">
                                                    <img width="50" height="50" src="@Session["Logo"]" />
                                                    <h4 class="box-title">Pasivo</h4>
                                                </div>
                                                <div class="box-body">
                                                    @(Model.composicionPasivoPorc)
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="box box-warning">
                                                <div class="box-header with-border">
                                                    <img width="50" height="50" src="@Session["Logo"]" />
                                                    <h4 class="box-title">Composición del pasivo con costo en millones</h4>
                                                </div>
                                                <div class="box-body">
                                                    @(Model.composicionPasivoMonto)
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="tab-pane" id="tab_4">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="box box-primary">
                                            <div class="box-body">
                                                <div class="row">
                                                    <div class="col-xs-12">
                                                        <div class="box-body table-responsive">
                                                            <span id="found" class="label label-info"></span>
                                                            <table id="tbIngreso" class="table table-striped table-bordered" style="width:100%; height: 350px">
                                                                <thead>
                                                                    <tr>
                                                                        <th colspan="5">
                                                                            <img width="50" height="50" src="@Session["Logo"]" />
                                                                            <label class="box-title">Ingresos</label>
                                                                        </th>
                                                                    </tr>
                                                                    <tr>
                                                                        <th class="hidden">
                                                                        </th>
                                                                        <th>
                                                                        </th>
                                                                        <th>
                                                                            Financiero
                                                                        </th>
                                                                        <th>
                                                                            Operativo
                                                                        </th>
                                                                        <th>
                                                                            Recuperación
                                                                        </th>
                                                                        <th>
                                                                            Ingreso Promedio
                                                                        </th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody></tbody>
                                                            </table>
                                                            <div id="summary">
                                                                <div>
                                                                </div>
                                                            </div>

                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="box box-warning">
                                            <div class="box-header with-border">
                                                <img width="50" height="50" src="@Session["Logo"]" />
                                                <h4 class="box-title">Ingreso</h4>
                                            </div>
                                            <div class="box-body">
                                                @(Model.composicionIngreso)
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-12">
                                        <div class="col-md-12">
                                            <div class="box box-primary">
                                                <div class="box-body">
                                                    <div class="row">
                                                        <div class="col-xs-12">
                                                            <div class="box-body table-responsive">
                                                                <span id="found" class="label label-info"></span>
                                                                <table id="tbGasto" class="table table-striped table-bordered" style="width:100%; height: 350px">
                                                                    <thead>
                                                                        <tr>
                                                                            <th colspan="6">
                                                                                <img width="50" height="50" src="@Session["Logo"]" />
                                                                                <label class="box-title">Gastos</label>
                                                                            </th>
                                                                        </tr>
                                                                        <tr>
                                                                            <th class="hidden">
                                                                            </th>
                                                                            <th>
                                                                            </th>
                                                                            <th>
                                                                                Financiero
                                                                            </th>
                                                                            <th>
                                                                                Estimación
                                                                            </th>
                                                                            <th>
                                                                                Operativo
                                                                            </th>
                                                                            <th>
                                                                                Administración
                                                                            </th>
                                                                            <th>
                                                                                Impuesto
                                                                            </th>

                                                                            <th>
                                                                                Gasto Promedio
                                                                            </th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody></tbody>
                                                                </table>
                                                                <div id="summary">
                                                                    <div>
                                                                    </div>
                                                                </div>

                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="box box-warning">
                                                <div class="box-header with-border">
                                                    <img width="50" height="50" src="@Session["Logo"]" />
                                                    <h4 class="box-title">Gasto</h4>
                                                </div>
                                                <div class="box-body">
                                                    @(Model.composicionGasto)
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    }
</section>

<script type="text/javascript">

    $(document).ready(function () {

        var ControlerNameRole = "@Url.Content("~/Composicion")";
        oTableBalance = $("#tbBalance").dataTable({
        "rowCallback": function (nRow, aData, iDisplayIndex, iDisplayIndexFull) {
            if (parseInt(aData[3]) == 0)
            {
                $(nRow).find('td:eq(3)').addClass('hidden');
            }
        },
        "bRetrieve": true,
        "bProcessing": true,
        "bPaginate": false,
        "bFilter": false,
        "bInfo": false,
        "dom": 'lBfrtip',
        "sAjaxSource": "@Url.Content("~/Composicion/GetGridBalance")",
        "buttons": [
                { extend: 'copyHtml5', exportOptions: { columns: ':visible' } }
            ,{ extend: 'excelHtml5', exportOptions: { columns: ':visible' } }
            ,{ extend: 'csvHtml5', exportOptions: { columns: ':visible' } }
            ,{ extend: 'print', exportOptions: { columns: ':visible' } }
            ,'colvis'
            ],
            columnDefs: [
                    {
                        className: 'text-right', targets: [1, 2, 3]
                    },
            ],
            "aoColumns": [
                {},{},{},{}
         ]
        });

        oTableIngreso = $("#tbIngreso").dataTable({
        "rowCallback": function (nRow, aData, iDisplayIndex, iDisplayIndexFull) {
            $(nRow).find('td:eq(0)').addClass('hidden');
        },
        "bRetrieve": true,
        "bProcessing": true,
        "bPaginate": false,
        "bFilter": false,
        "bInfo": false,
        "dom": 'lBfrtip',
        "sAjaxSource": "@Url.Content("~/Composicion/GetGridIngreso")",
        "buttons": [
                { extend: 'copyHtml5', exportOptions: { columns: ':visible' } }
            ,{ extend: 'excelHtml5', exportOptions: { columns: ':visible' } }
            ,{ extend: 'csvHtml5', exportOptions: { columns: ':visible' } }
            ,{ extend: 'print', exportOptions: { columns: ':visible' } }
            ,'colvis'
            ],
            columnDefs: [
                    {
                        className: 'text-right', targets: [2, 3, 4, 5]
                    },
            ],
            "aoColumns": [
                {},{},{},{},{},{}
         ]
        });

        oTableGasto = $("#tbGasto").dataTable({
        "rowCallback": function (nRow, aData, iDisplayIndex, iDisplayIndexFull) {
            $(nRow).find('td:eq(0)').addClass('hidden');
        },
        "bRetrieve": true,
        "bProcessing": true,
        "bPaginate": false,
        "bFilter": false,
        "bInfo": false,
        "dom": 'lBfrtip',
        "sAjaxSource": "@Url.Content("~/Composicion/GetGridGasto")",
        "buttons": [
                { extend: 'copyHtml5', exportOptions: { columns: ':visible' } }
            ,{ extend: 'excelHtml5', exportOptions: { columns: ':visible' } }
            ,{ extend: 'csvHtml5', exportOptions: { columns: ':visible' } }
            ,{ extend: 'print', exportOptions: { columns: ':visible' } }
            ,'colvis'
            ],
            columnDefs: [
                    {
                        className: 'text-right', targets: [2, 3, 4, 5, 6, 7]
                    },
            ],
            "aoColumns": [
                {},{},{},{},{},{},{},{}
         ]
          });

        $("#chkprivate").click(function () {
            if ($(this).is(':checked')) {
                $('#Periodo3').addClass("disabled");
            }
            else {
                $('#Periodo3').removeClass("disabled");
            }
        });

        if ($("#chkprivate").is(':checked')) {
            $('#tercerPeriodo').addClass("hidden");
            $('#Periodo3').addClass("disabled");
        }
        else {
            $('#tercerPeriodo').removeClass("hidden");
            $('#Periodo3').removeClass("disabled");
        }
     });

    function formatMillion() {
        return this.value;
    }

    function formatPercent() {
        return this.value + ' %';
    }
</script>
