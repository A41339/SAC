@{
    ViewBag.Title = "Matrices";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content-header">
    <h1 class="modern-page-title">
        <i class="fa fa-random" style="color: #0284c7;"></i>
        Matriz de Transici&oacute;n y Probabilidad
        <small>C&aacute;lculo y evaluaci&oacute;n de matrices de transici&oacute;n de cartera</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="@Url.Action("Index", "Matriz")">Matrices</a></li>
        <li class="active">Probabilidad</li>
    </ol>
</section>

<section class="content">
    @using (Html.BeginForm("BuscarProbabilidad", "Matriz", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmMatriz" }))
    {
        @Html.AntiForgeryToken()
        <div class="row">
            <div class="col-xs-12">
                <div class="modern-filter-card">
                    <div class="modern-filter-toolbar">
                        <div class="filter-item">
                            <label for="IdEntidad"><i class="fa fa-university"></i> Entidad:</label>
                            @Html.DropDownList("Entidades", null, new { @id = "IdEntidad", @class = "form-control modern-select", style = "min-width: 220px;" })
                        </div>
                        <div class="filter-item">
                            <label for="PeriodoI"><i class="fa fa-calendar"></i> Inicial:</label>
                            <div class="modern-input-wrapper" style="min-width: 140px; width: 140px;">
                                <input name="PeriodoI" id="PeriodoI" class="datecontrol form-control modern-date-input" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo1"].ToString()).ToString("MM/yyyy")" style="width: 100%;" />
                            </div>
                        </div>
                        <div class="filter-item">
                            <label for="PeriodoF"><i class="fa fa-calendar"></i> Final:</label>
                            <div class="modern-input-wrapper" style="min-width: 140px; width: 140px;">
                                <input name="PeriodoF" id="PeriodoF" class="datecontrol form-control modern-date-input" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo2"].ToString()).ToString("MM/yyyy")" style="width: 100%;" />
                            </div>
                        </div>
                        <div class="filter-item" style="margin-left: auto;">
                            <button type="submit" name="submit" class="btn-modern-filter">
                                <i class="fa fa-search"></i> Generar
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-xs-12">
                <div class="modern-table-card">
                    <div style="display: flex; align-items: center; gap: 10px; padding: 12px 16px; background: #f8fafc; border-bottom: 1px solid #e2e8f0; border-radius: 12px 12px 0 0;">
                        <img width="36" height="36" src="@Session["Logo"]" style="border-radius: 6px; background: #fff; padding: 2px;" />
                        <h4 style="margin: 0; font-size: 14px; font-weight: 700; color: #1e293b;">Matriz de transici&oacute;n y probabilidad</h4>
                    </div>
                    <div style="padding: 12px;">
                        <span id="found" class="label label-info"></span>
                        <table id="tbError" class="table table-striped table-bordered modern-data-table" style="width:100%; height: 350px">
                            <thead>
                                <tr>
                                                    <th class="hidden">
                                                    </th>
                                                    <th>
                                                        Inicio
                                                    </th>
                                                    <th>
                                                        Fin
                                                    </th>
                                                    <th>
                                                        Probabilidad
                                                    </th>
                                                    <th>
                                                        Saldo
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                        <div id="summary">
                                            <div></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
</section>

<script type="text/javascript">

     $(document).ready(function () {
            var oTableRole = "";
            var ControlerNameRole = "@Url.Content("~/Matriz")";
            oTableRole = $("#tbError").dataTable({
                  "rowCallback": function( nRow, aData, iDisplayIndex, iDisplayIndexFull ) {
                    $(nRow).find('td:eq(0)').addClass('hidden');
             },
            "bRetrieve": true,
            "bProcessing": true,
            "bPaginate": false,
            "bFilter": false,
            "bInfo": false,
            "dom": 'lBfrtip',
            "sAjaxSource": "@Url.Content("~/Matriz/GetGridProbabilidad")",
            "buttons": [
                 { extend: 'copyHtml5', exportOptions: { columns: ':visible' } }
                ,{ extend: 'excelHtml5', exportOptions: { columns: ':visible' } }
                ,{ extend: 'csvHtml5', exportOptions: { columns: ':visible' } }
                ,{ extend: 'print', exportOptions: { columns: ':visible' } }
                ,'colvis'
                ],
                columnDefs: [
                     {
                         className: 'text-right', targets: [3, 4]
                     },
                ],
                "aoColumns": [
                    {},{},{},{},{}
        ]
        });
     });

</script>