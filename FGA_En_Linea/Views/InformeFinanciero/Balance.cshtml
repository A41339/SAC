@model FGA.Model.Graficos_Financieros

@{
    ViewBag.Title = "Balance General";
}

<section class="content">
    <section class="content-header">
        <h1>
            Balance General
        </h1>
    </section>

    @using (Html.BeginForm("LoadBalance", "InformeFinanciero", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmInforme" }))
    {
        <div class="box box-solid box-info">
            <div class="box-body table-responsive">
                <div class="margin">
                    <div class="streaming-table">
                        <span id="found" class="label label-info"></span>
                        <table class="table table-condensed table-striped table-bordered">
                            <tr>
                                <td class="mobile">
                                    @Html.Label("Entidad:")
                                </td>
                                <td>
                                    @Html.DropDownList("Entidades", null, new { @id = "IdEntidad", style = "width: 200px;" })
                                </td>
                                <td class="mobile">
                                    @Html.Label("Primer Periodo:")
                                </td>
                                <td nowrap="nowrap">
                                    <input name="Periodo1" id="Periodo1" class="datecontrol" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo1"].ToString()).ToString("MM/yyyy")" />
                                </td>
                                <td>
                                </td>
                            </tr>
                            <tr>
                                <td class="mobile">
                                    @Html.Label("Segundo Periodo:")
                                </td>
                                <td nowrap="nowrap">
                                    <input name="Periodo2" id="Periodo2" class="datecontrol" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo2"].ToString()).ToString("MM/yyyy")" />
                                </td>
                                <td class="mobile">
                                    @Html.Label("Tercer Periodo:")
                                </td>
                                <td>
                                    <input name="Periodo3" id="Periodo3" class="datecontrol" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo3"].ToString()).ToString("MM/yyyy")" />
                                </td>
                                <td>
                                    <label>
                                        <button id="btn_generar" type="submit" class="btn btn-primary">Generar</button>
                                    </label>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (Session["TipoReporte"] != null)
    {
        <div class="nav-tabs-custom">
            <ul class="nav nav-tabs">
                <li class="active"><a href="#tab_1" data-toggle="tab">Balance General</a></li>
                <li><a href="#tab_2" data-toggle="tab">Análisis</a></li>
                <li><a href="#tab_3" data-toggle="tab">Composición</a></li>
            </ul>
            <div class="tab-content">
                <div class="tab-pane active" id="tab_1">
                    <div class="box-body table-responsive">
                        <div class="margin">
                            <iframe src="~/Reportes/ReportView.aspx" width="1500" height="1500" style="border:none"></iframe>
                        </div>
                    </div>
                </div>
                <div class="tab-pane" id="tab_2">
                    <div class="box-body table-responsive">
                        <div class="margin">
                            <iframe src="~/Reportes/ReportView2.aspx" width="1500" height="1500" style="border:none"></iframe>
                        </div>
                    </div>
                </div>
                <div class="tab-pane" id="tab_3">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="box box-primary">
                                <div class="box-body">
                                    <div class="row">
                                        <div class="col-xs-12">
                                            <span id="found" class="label label-info"></span>
                                            <table id="tbBalance" class="table table-striped table-bordered" style="width:100%; height: 350px">
                                                <thead>
                                                    <tr>
                                                        <th colspan="4">
                                                            <img width="50" height="50" src="@Session["Logo"]" />
                                                            <label class="box-title">Composición del balance en millones</label>
                                                        </th>
                                                    </tr>
                                                    <tr>
                                                        <th></th>
                                                        <th>
                                                            @FGA.Utility.Utilitarios.toUpperFirstLetter(FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo1"].ToString()).ToString("MMMM yyyy"))
                                                        </th>
                                                        <th>
                                                            @FGA.Utility.Utilitarios.toUpperFirstLetter(FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo2"].ToString()).ToString("MMMM yyyy"))
                                                        </th>
                                                        <th id="tercerPeriodo">
                                                            @FGA.Utility.Utilitarios.toUpperFirstLetter(FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo3"].ToString()).ToString("MMMM yyyy"))
                                                        </th>
                                                    </tr>
                                                </thead>
                                                <tbody></tbody>
                                            </table>
                                            <div id="summary">
                                                <div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="box box-warning">
                                <div class="box-header with-border">
                                    <img width="50" height="50" src="@Session["Logo"]" />
                                    <h4 class="box-title">Composición del balance</h4>
                                </div>
                                <div class="box-body">
                                    @(Model.composicionBalance)
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="col-md-12">
                                    <div class="box box-primary">
                                        <div class="box-header with-border">
                                            <img width="50" height="50" src="@Session["Logo"]" />
                                            <h4 class="box-title">Activo</h4>
                                        </div>
                                        <div class="box-body">
                                            @(Model.composicionActivoPorc)
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="box box-warning">
                                        <div class="box-header with-border">
                                            <img width="50" height="50" src="@Session["Logo"]" />
                                            <h4 class="box-title">Composición del activo productivo en millones</h4>
                                        </div>
                                        <div class="box-body">
                                            @(Model.composicionActivoMonto)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="col-md-12">
                                    <div class="box box-primary">
                                        <div class="box-header with-border">
                                            <img width="50" height="50" src="@Session["Logo"]" />
                                            <h4 class="box-title">Pasivo</h4>
                                        </div>
                                        <div class="box-body">
                                            @(Model.composicionPasivoPorc)
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="box box-warning">
                                        <div class="box-header with-border">
                                            <img width="50" height="50" src="@Session["Logo"]" />
                                            <h4 class="box-title">Composición del pasivo con costo en millones</h4>
                                        </div>
                                        <div class="box-body">
                                            @(Model.composicionPasivoMonto)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</section>

<script type="text/javascript">

    $(document).ready(function () {
        oTableBalance = $("#tbBalance").dataTable({
            "rowCallback": function (nRow, aData, iDisplayIndex, iDisplayIndexFull) {
                if (parseInt(aData[3]) == 0) {
                    $(nRow).find('td:eq(3)').addClass('hidden');
                }
            },
            "bRetrieve": true,
            "bProcessing": true,
            "bPaginate": false,
            "bFilter": false,
            "bInfo": false,
            "dom": 'lBfrtip',
            "sAjaxSource": "@Url.Content("~/Composicion/GetGridBalance")",
            "buttons": [
                { extend: 'copyHtml5', exportOptions: { columns: ':visible' } }
                , { extend: 'excelHtml5', exportOptions: { columns: ':visible' } }
                , { extend: 'csvHtml5', exportOptions: { columns: ':visible' } }
                , { extend: 'print', exportOptions: { columns: ':visible' } }
                , 'colvis'
            ],
            columnDefs: [
                {
                    className: 'text-right', targets: [1, 2, 3]
                },
            ],
            "aoColumns": [
                {}, {}, {}, {}
            ]
        });
    });

    function formatMillion() {
        return this.value;
    }

    function formatPercent() {
        return this.value + ' %';
    }

</script>
