@{
    ViewBag.Title = "Estados Financieros Consolidados";
}

<section class="content-header" style="padding: 24px 20px 14px 20px;">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
        <div>
            <h1 style="margin: 0; font-size: 21px; font-weight: 700; color: #143750; display: flex; align-items: center; gap: 10px;">
                <i class="fa fa-cubes" style="color: #0284c7;"></i>
                Estados Financieros Consolidados
            </h1>
            <p style="margin: 6px 0 0 0; font-size: 13px; color: #64748b;">
                Consolidaci&oacute;n financiera integral de entidades cooperativas.
            </p>
        </div>
    </div>
</section>

<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div class="modern-filter-card" style="margin-bottom: 22px;">
                <div class="modern-filter-toolbar">
                    <div class="filter-item">
                        <label for="IdEntidad"><i class="fa fa-university"></i> Entidad:</label>
                        @Html.DropDownList("Entidades", null, new { @id = "IdEntidad", @class = "form-control modern-select", style = "min-width: 220px; height: 38px; font-size: 13px;" })
                    </div>
                    <div class="filter-item">
                        <label for="Periodo1"><i class="fa fa-calendar"></i> Primer Per&iacute;odo:</label>
                        <div class="modern-input-wrapper">
                            <input name="Periodo1" id="Periodo1" class="datecontrol form-control modern-date-input" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo1"].ToString()).ToString("MM/yyyy")" style="min-width: 130px; height: 38px;" />
                        </div>
                    </div>
                    <div class="filter-item">
                        <label for="Periodo2"><i class="fa fa-calendar"></i> Segundo Per&iacute;odo:</label>
                        <div class="modern-input-wrapper">
                            <input name="Periodo2" id="Periodo2" class="datecontrol form-control modern-date-input" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo2"].ToString()).ToString("MM/yyyy")" style="min-width: 130px; height: 38px;" />
                        </div>
                    </div>
                    <div class="filter-item">
                        <label for="Periodo3"><i class="fa fa-calendar-o"></i> Tercer Per&iacute;odo:</label>
                        <div class="modern-input-wrapper">
                            <input name="Periodo3" id="Periodo3" class="datecontrol form-control modern-date-input" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo3"].ToString()).ToString("MM/yyyy")" style="min-width: 130px; height: 38px;" />
                        </div>
                    </div>
                    <div class="filter-item" style="margin-left: auto;">
                        <button type="button" id="btn_buscar" class="btn-modern-filter" style="height: 38px; padding: 0 24px;">
                            <i class="fa fa-search"></i> Generar informe
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="detail"></div>
</section>

<script type="text/javascript">

    function refreshPage() {
        $.ajax({
            url: '@Url.Action("LoadConsolidado", "InformeFinanciero")',
                type: 'POST',
                cache: false,
                async: false,
                data: {
                'Entidades': $('#IdEntidad').val(),
                'Periodo1': $('#Periodo1').val(),
                'Periodo2': $('#Periodo2').val(),
                'Periodo3': $('#Periodo3').val()
            },
            success: function (result) {
                $('#detail').html(result);
            }
        });
    }

      $(document).on('click', '#btn_buscar', function () {
         refreshPage();
      });

</script>