@{
    ViewBag.Title = "Balanza de Comprobaci&oacute;n";
}

<section class="content-header" style="padding: 24px 20px 14px 20px;">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
        <div>
            <h1 style="margin: 0; font-size: 21px; font-weight: 700; color: #143750; display: flex; align-items: center; gap: 10px;">
                <i class="fa fa-book" style="color: #0284c7;"></i>
                Balanza de Comprobaci&oacute;n
            </h1>
            <p style="margin: 6px 0 0 0; font-size: 13px; color: #64748b;">
                Generaci&oacute;n y consulta de balanza de comprobaci&oacute;n financiera comparativa por entidad y per&iacute;odo.
            </p>
        </div>
    </div>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="@Url.Action("Index", "Modulo", new { id = 1500 })" class="breadcrumb-parent-pill" title="Volver al menú de Información Financiera"><i class="fa fa-file-text-o" style="margin-right: 4px;"></i> Informaci&oacute;n Financiera</a></li>
        <li class="active">Balanza de Comprobaci&oacute;n</li>
    </ol>
</section>

<section class="content">
    @using (Html.BeginForm("LoadReportAsync", "InformeFinanciero", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmInforme" }))
    {
        @Html.AntiForgeryToken()

        <div class="row">
            <div class="col-xs-12">
                <div class="modern-filter-card" style="margin-bottom: 22px;">
                    <div class="modern-filter-toolbar">
                        <div class="filter-item">
                            <label for="IdEntidad"><i class="fa fa-university"></i> Entidad:</label>
                            @Html.DropDownList("Entidades", null, new { @id = "IdEntidad", @class = "form-control modern-select", style = "min-width: 220px; height: 38px; font-size: 13px;" })
                        </div>
                        <div class="filter-item">
                            <label for="Mensual"><i class="fa fa-calendar-check-o"></i> Mensual:</label>
                            @Html.DropDownList("Mensual", new List<SelectListItem> {
                                new SelectListItem { Value = "0", Text = "NO" },
                                new SelectListItem { Value = "1", Text = "S&Iacute;" }
                            }, new { @id = "Mensual", @class = "form-control modern-select", style = "min-width: 100px; height: 38px; font-size: 13px;" })
                        </div>
                        <div class="filter-item">
                            <label for="Periodo1"><i class="fa fa-calendar"></i> Primer Per&iacute;odo:</label>
                            <div class="modern-input-wrapper">
                                <input name="Periodo1" id="Periodo1" class="datecontrol form-control modern-date-input" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo1"].ToString()).ToString("MM/yyyy")" style="min-width: 130px; height: 38px;" />
                            </div>
                        </div>
                        <div class="filter-item">
                            <label for="Periodo2"><i class="fa fa-calendar-o"></i> Segundo Per&iacute;odo:</label>
                            <div class="modern-input-wrapper">
                                <input name="Periodo2" id="Periodo2" class="datecontrol form-control modern-date-input" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo2"].ToString()).ToString("MM/yyyy")" style="min-width: 130px; height: 38px;" />
                            </div>
                        </div>
                        <div class="filter-item" style="margin-left: auto;">
                            <button type="submit" id="btn_buscar" class="btn-modern-filter" style="height: 38px; padding: 0 24px;">
                                <i class="fa fa-search"></i> Generar informe
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</section>