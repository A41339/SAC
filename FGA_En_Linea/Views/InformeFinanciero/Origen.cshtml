@{
    ViewBag.Title = "Origen y aplicación";
}

<section class="content">
    <section class="content-header">
        <h1>
            Origen y aplicación
        </h1>
    </section>

    <div class="box box-solid box-info">
        <div class="box-body table-responsive">
            <div class="margin">
                <div class="streaming-table">
                    <span id="found" class="label label-info"></span>
                    <table class="table table-condensed table-striped table-bordered">
                        <tr>
                            <td class="mobile">
                                @Html.Label("Entidad:")
                            </td>
                            <td>
                                @Html.DropDownList("Entidades", null, new { @id = "IdEntidad", style = "width: 200px;" })
                            </td>
                            <td class="mobile">
                                @Html.Label("Periodo Inicial:")
                            </td>
                            <td nowrap="nowrap">
                                <input name="Periodo1" id="Periodo1" class="datecontrol" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo1"].ToString()).ToString("MM/yyyy")" />
                            </td>
                            <td class="mobile">
                                @Html.Label("Periodo Final:")
                            </td>
                            <td nowrap="nowrap">
                                <input name="Periodo2" id="Periodo2" class="datecontrol" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo2"].ToString()).ToString("MM/yyyy")" />
                            </td>
                            <td>
                                <label>
                                    <button type="submit" id="btn_buscar" class="btn btn-primary">Generar</button>
                                </label>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div id="detail">

    </div>
    @*@if (Session["TipoReporte"] != null)
        {
            <div class="box box-solid box-info">
                <div class="box-body table-responsive">
                    <div class="margin">
                        <iframe src="~/Reportes/ReportView.aspx" width="1500" height="1500" style="border:none"></iframe>
                    </div>
                </div>
            </div>
        }*@
</section>

<script type="text/javascript">

    function refreshPage() {
        $.ajax({
            url: '@Url.Action("LoadOrigen", "InformeFinanciero")',
                type: 'POST',
                cache: false,
                async: false,
                data: {
                'Entidades': $('#IdEntidad').val(),
                'Periodo1': $('#Periodo1').val(),
                'Periodo2': $('#Periodo2').val()
            },
            success: function (result) {
                $('#detail').html(result);
            }
        });
    }

      $(document).on('click', '#btn_buscar', function () {
         refreshPage();
      });

</script>
