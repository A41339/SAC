@model FGA.Model.Modelo_Simulacion

@{
    ViewBag.Title = "M\u00f3dulo de simulaci\u00f3n";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content-header">
    <h1 class="modern-page-title">
        <i class="fa fa-calculator" style="color: #0284c7;"></i>
        M&oacute;dulo de Simulaci&oacute;n: ISP - IMCA
        <small>Simulaci&oacute;n y proyecci&oacute;n de adecuaci&oacute;n patrimonial y suficiencia de capital</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="#">Simulaci&oacute;n</a></li>
        <li class="active">ISP - IMCA</li>
    </ol>
</section>

@using (Html.BeginForm("LoadReportAsync", "SimulacionCapital", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmInforme" }))
{
    <section class="content">
        <div id="divSimulacion">
            @Html.Partial("_Simulacion", Model)
        </div>
    </section>
}

<div class="modal fade" id="defModal" tabindex="-1" role="dialog" aria-labelledby="defModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" style="border-radius: 12px; overflow: hidden; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.2);">
            <div class="modal-header" style="background: linear-gradient(135deg, #143750 0%, #29687a 100%); color: #ffffff; padding: 16px 20px;">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true" style="color: #ffffff; opacity: 0.8; text-shadow: none;">&times;</button>
                <h4 id="titulo" class="modal-title" style="font-weight: 700; font-size: 16px; margin: 0; color: #ffffff;"></h4>
            </div>
            <div class="modal-body" style="padding: 20px 24px;">
                <p class="text-justify" style="font-size: 14px; line-height: 1.6; color: #334155; margin: 0;" id="definicion"></p>
            </div>
            <div class="modal-footer" style="background: #f8fafc; border-top: 1px solid #e2e8f0; padding: 12px 20px;">
                <button type="button" class="btn btn-default" data-dismiss="modal" style="border-radius: 6px; padding: 6px 18px;">Cerrar</button>
            </div>
        </div>
    </div>
</div>

