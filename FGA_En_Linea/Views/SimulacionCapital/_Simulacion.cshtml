                                            <input name="porc_Excedente" id="porc_Excedente" class="text-right" style="width: 70px; border-style: none" value="@Model.Porc_Excedentes%" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            Reservas voluntarias
                                        </td>
                                        <td class="text-right">
                                            <input name="porc_Voluntarias" id="porc_Voluntarias" class="text-right" style="width: 70px; border-style: none" value="@Model.Porc_Voluntarias%" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            Aportes por incrementos de capital
                                        </td>
                                        <td class="text-right">
                                            <input name="porc_Aportes" id="porc_Aportes" class="text-right" style="width: 70px; border-style: none" value="@Model.Porc_Aportes%" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            Donaciones y otras contribuciones no capitalizables
                                        </td>
                                        <td class="text-right">
                                            <input name="porc_Donaciones" id="porc_Donaciones" class="text-right" style="width: 70px; border-style: none" value="@Model.Porc_Donaciones%" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            Ajuste por revaluación de participaciones en otras empresas
                                        </td>
                                        <td class="text-right">
                                            <input name="porc_Revaluacion" id="porc_Revaluacion" class="text-right" style="width: 70px; border-style: none" value="@Model.Porc_Revaluacion%" />
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-md-3 text-center">
                    <div class="box">
                        <div class="box-header">
                            <h3>
                                <b style="padding-right:10px;">Suficiencia Objetivo</b>
                            </h3>
                        </div>
                        <div class="text-center">
                            <input id="suficienciaObjetivo" style="border-width: 0px; font-size: 30px; background-color: #ffe5c4; margin-bottom: 10px;" class="text-center" value="@Model.Porc_SuficienciaObjetivo%" />
                            <br />
                            <table id="tbResultados" class="table table-striped table-bordered" style="padding: 15px;">
                                <tbody>
                                    <tr>
                                        <td align="left">
                                            Capital base
                                        </td>
                                        <td class="text-right">
                                            <input name="SCapitalBase" readonly id="SCapitalBase" class="text-right" style="width: 170px; border-style: none" value="@Model.SCapitalBase.Value.ToString("N2")" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td align="left">
                                            IMCA
                                        </td>
                                        <td class="text-right">
                                            <input name="SIMCA" id="SIMCA" class="text-right" style="width: 170px; border-style: none" value="@Model.SImca.Value.ToString("N2")" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td align="left">
                                            % IMCA/Capital
                                        </td>
                                        <td class="text-right">
                                            <input name="SIMCA_Capital" readonly id="SIMCA_Capital" class="text-right" style="width: 170px; border-style: none" value="@Model.SImcaCapital.Value.ToString("N2")%" />
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <br />
                            <div class="box-footer">
                                <input type="button" name="btn_simular" id="btn_simulacion" value="Simular" onclick="generarSimulacion()" class="btn btn-info" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">

    function help(titulo, detalle) {
        $('#titulo').html(titulo);
        $('#definicion').html(detalle);
        $('#defModal').modal('show');
    }

    $("#ddlEscenario").change(function () {
        if ($("#ddlEscenario").val() == 4) {
            $('#IMCA').val('0');
        }
        else {
            $('#IMCA').val('@(Model.Imca.Value.ToString("N2"))');
        }
    });

    function generarSimulacion() {
        $.ajax({
           url: '@Url.Action("ViewSimulacion", "SimulacionCapital")',
           type: 'POST',
           cache: false,
           async: true,
           data: {
               'pIdEntidad': $('#IdEntidad').val(),
               'pPeriodo': $('#PeriodoI').val(),
               'pTipoEscenario': $('#ddlEscenario').val(),
               'pPorc_Cartera': $('#porc_Cartera').val().replace('%', ''),
               'pPorc_Inver': $('#porc_Inver').val().replace('%', ''),
               'pPorc_Activos': $('#porc_Activos').val().replace('%', ''),
               'pPorc_Disponibilidades': $('#porc_Disponibilidades').val().replace('%', ''),
               'pPorc_Inmuebles': $('#porc_Inmuebles').val().replace('%', ''),
               'pPorc_Posicion': $('#porc_Posicion').val().replace('%', ''),
               'pPorc_Incremento': $('#porc_Incremento').val().replace('%', ''),
               'pPorc_Uoba': $('#porc_UOBA').val().replace('%', ''),
               'pPorc_Capital': $('#porc_Capital').val().replace('%', ''),
               'pPorc_Retiro': $('#porc_Retiro').val().replace('%', ''),
               'pImca': $('#IMCA').val().replace(/\./g, ''),
               'pPorc_Legal': $('#porc_Legal').val().replace('%', ''),
               'pPorc_Excedente': $('#porc_Excedente').val().replace('%', ''),
               'pPorc_Voluntarias': $('#porc_Voluntarias').val().replace('%', ''),
               'pPorc_Aportes': $('#porc_Aportes').val().replace('%', ''),
               'pPorc_Donaciones': $('#porc_Donaciones').val().replace('%', ''),
               'pPorc_Revaluacion': $('#porc_Revaluacion').val().replace('%', ''),
               'pSuficienciaObjetivo': $('#suficienciaObjetivo').val().replace('%', '')

            },
            success: function (result) {
                $('#divSimulacion').html(result);
            },
        });
    }

    $('.datecontrol').MonthPicker({
        Button: '<img src="https://www.ffc.co.cr/FFC/Content/images/calendar.png" />',
    });

</script>
