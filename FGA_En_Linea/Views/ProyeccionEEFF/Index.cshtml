        <div class="modal-content">
            <div class="modal-header">
                <div class="icon-box">
                    <i class="material-icons"></i>
                </div>
            </div>
            <div class="modal-body">
                <div style="margin-left:50px; margin-right: 50px;">
                    <p id="lbl_mensajeExito" class="text-center">@Model.mensaje</p>
