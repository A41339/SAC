@model FGA.Model.Modelo_PEEFF

@{
    ViewBag.Title = "M&oacute;dulo de proyecciones";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content-header">
    <h1>
        M&oacute;dulo de proyecciones
    </h1>
</section>

<section class="content">
    @using (Html.BeginForm("Buscar", "ProyeccionEEFF", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmMatriz" }))
    {
        @Html.AntiForgeryToken()
        <div class="row">
            <div class="col-xs-12">
                <div class="box box-solid box-info">
                    <div class="box-body" style="padding: 12px 18px;">
                        <div class="streaming-table modern-filter-card" style="padding: 12px 15px;">
                            <span id="found" class="label label-info"></span>
                            <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 15px;">
                                <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 18px; flex: 1;">
                                    <div style="display: inline-flex; align-items: center; gap: 8px;">
                                        <label style="margin-bottom: 0; font-weight: 600; color: #475569;">Entidad:</label>
                                        @Html.DropDownList("Entidades", null, new { @id = "IdEntidad", @class = "form-control", style = "width: auto; min-width: 180px;" })
                                    </div>
                                    <div style="display: inline-flex; align-items: center; gap: 8px;">
                                        <label style="margin-bottom: 0; font-weight: 600; color: #475569;">Fecha de corte:</label>
                                        <div style="display: inline-flex; align-items: center; gap: 6px;">
                                            <input name="PeriodoI" id="PeriodoI" class="datecontrol form-control" style="width: 140px;"
                                                   value="@FGA.Utility.Utilitarios.toUpperFirstLetter(FGA.Utility.Utilitarios.ConvertirAFecha(Session["PeriodoI"].ToString()).Date.ToString("MMMM yyyy"))" />
                                            <a class="text-right" data-toggle="tooltip" data-placement="top" title="Ayuda"
                                               href="javascript:help('Fecha de corte', 'Fecha de base a partir de la que se genera los períodos proyectados, se podrán usar cortes del período vigente y el último cierre fiscal cargado, meses anteriores a ese no se podrán usar como base.' )"><i class="btn btn-xs btn-default icon fa fa-question"></i></a>
                                        </div>
                                    </div>
                                    <div style="display: inline-flex; align-items: center; gap: 8px;">
                                        <label style="margin-bottom: 0; font-weight: 600; color: #475569;">Periodos por proyectar:</label>
                                        <div style="display: inline-flex; align-items: center; gap: 6px;">
                                            <select id="ddlPlazo" name="ddlPlazo" class="form-control" style="width: auto; min-width: 200px;">
                                                <option value="1" @(Model.ddlPlazo == "1" ? " selected" : "")>12 meses</option>
                                                <option value="2" @(Model.ddlPlazo == "2" ? " selected" : "")>3 &ntilde;os (Primer &ntilde;o mensual)</option>
                                            </select>
                                            <a class="text-left" data-toggle="tooltip" data-placement="top" title="Ayuda"
                                               href="javascript:help('Periodos por proyectar', 'La opción de 12 meses solo mostrará una proyección mensual de un año, la opción de 3 años mostrará el primer año en forma mensual. El segundo y tercero en forma anualizada')"><i class="btn btn-xs btn-default icon fa fa-question"></i></a>
                                        </div>
                                    </div>
                                </div>
                                <div style="margin-left: auto;">
                                    <label class="btn btn-facebook" style="margin-bottom: 0;">
                                        Incluir supuestos<input type="submit" id="btn_supuestos" value="Consultar" name="command" style="display: none;">
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        if (Model.Supuestos == true)
        {
            <div id="menuTab" class="nav-tabs-custom">
                <ul class="nav nav-tabs">
                    <li id="tab1" class="@(Model.proyeccion ? "" : "active")"><a href="#tab1C" data-toggle="tab">Supuestos de proyección</a></li>
                    <li id="tab3" @(@Session["TipoReporte"] is null ? "class=hidden" : "class=''")><a href="#tab3C" data-toggle="tab">Balance proyectado</a></li>
                    <li id="tab2" @(@Session["TipoReporte3"] is null ? "class=hidden" : "class=''")><a href="#tab2C" data-toggle="tab">Análisis balance proyectado</a></li>
                    <li id="tab5" @(@Session["TipoReporte2"] is null ? "class=hidden" : "class=''")><a href="#tab5C" data-toggle="tab">Estado resultados proyectado</a></li>
                    <li id="tab4" @(@Session["TipoReporte4"] is null ? "class=hidden" : "class=''")><a href="#tab4C" data-toggle="tab">Análisis estado resultados proyectado</a></li>
                    <li id="tab6" @(@Session["TipoReporte2"] is null ? "class=hidden" : "class=''")><a href="#tab6C" data-toggle="tab">Mora</a></li>
                    <li id="tab7" @(@Session["TipoReporte"] is null ? "class=hidden" : "class=''")><a href="#tab7C" data-toggle="tab">Indicadores</a></li>
                </ul>
                <div class="tab-content">
                    <div class="tab-pane" id="tab1C">
                        <div class="box-body table-responsive">
                            <div class="col-md-6">
                                <div class="box box-primary">
                                    <div class="box-body">
                                        <span id="found" class="label label-info"></span>
                                        <div class="box-header with-border">
                                            <img width="50" height="50" src="@Session["Logo"]" />
                                            <h4 class="box-title">Supuestos de proyección</h4>
                                        </div>
                                        <table id="tbSupuestos" class="table table-striped table-bordered">
                                            <thead>
                                                <tr>
                                                    <th class="text-left">Tasa de la intermediación</th>
                                                    <th class="text-center">
                                                        <div class="row">
                                                            <div class="col-xs-5">
                                                                <select id="ddlTasa" name="ddlTasa" style="width:150px">
                                                                    <option value="1" @(Model.ddlTasa == "1" ? " selected" : "")>Referencia</option>
                                                                    <option value="2" @(Model.ddlTasa == "2" ? " selected" : "")>Manual</option>
                                                                </select>
                                                            </div>
                                                            <div class="col-xs-1">
                                                                <a class="text-right" data-toggle="tooltip" data-placement="top" title="Ayuda"
                                                                   href="javascript:help('Tasa de la intermediación', 'Las tasas mostradas  en referencia son sugeridas de acuerdo con la información con la que cuenta FFC, en la opción manual el usuario puede modificarlas.')"><i class="btn btn-xs btn-default icon fa fa-question"></i></a>
                                                            </div>
                                                        </div>
                                                    </th>
                                                    <th id="ayudaT" class="hidden">
                                                        Referencia
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td>
                                                        Tasa cartera nueva colocación
                                                    </td>
                                                    <td class="text-right">
                                                        <input name="tasaNuevaColocacion" readonly id="tasaNuevaColocacion" class="text-right" style="width: 70px; border-style: none" value="@(Model.TasaNuevaColocacion)%" />
                                                    </td>
                                                    <td id="ayudaT1" class="hidden">
                                                        @Model.PTasaNuevaColocacion%
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>
                                                        Tasa de crédito cartera vigente
                                                    </td>
                                                    <td class="text-right">
                                                        <input name="tasaCarteraVigente" readonly id="tasaCarteraVigente" class="text-right" style="width: 70px; border-style: none" value="@(Model.TasaCarteraVigente)%" />
                                                    </td>
                                                    <td id="ayudaT2" class="hidden">
                                                        @Model.PTasaCarteraVigente%
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>
                                                        Tasa por cartera vencida
                                                    </td>
                                                    <td class="text-right">
                                                        <input name="tasaCarteraVencida" readonly id="tasaCarteraVencida" class="text-right" style="width: 70px; border-style: none" value="@(Model.TasaCarteraVencida)%" />
                                                    </td>
                                                    <td id="ayudaT3" class="hidden">
                                                        @Model.PTasaCarteraVencida%
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>
                                                        Tasa de inversiones
                                                    </td>
                                                    <td class="text-right">
                                                        <input name="tasaInversiones" readonly id="tasaInversiones" class="text-right" style="width: 70px; border-style: none" value="@(Model.TasaInversiones)%" />
                                                    </td>
                                                    <td id="ayudaT4" class="hidden">
                                                        @Model.PTasaInversiones%
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>
                                                        Tasa captaciones
                                                    </td>
                                                    <td class="text-right">
                                                        <input name="tasaCaptaciones" readonly id="tasaCaptaciones" class="text-right" style="width: 70px; border-style: none" value="@(Model.TasaCaptaciones)%" />
                                                    </td>
                                                    <td id="ayudaT5" class="hidden">
                                                        @Model.PTasaCaptaciones%
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>
                                                        Tasa obligaciones con entidades
                                                    </td>
                                                    <td class="text-right">
                                                        <input name="tasaObligaciones" readonly id="tasaObligaciones" class="text-right" style="width: 70px; border-style: none" value="@(Model.TasaObligaciones)%" />
                                                    </td>
                                                    <td id="ayudaT6" class="hidden">
                                                        @Model.PTasaObligaciones%
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="box box-primary">
                                    <div class="box-body">
                                        <div class="row">
                                            <div class="col-xs-12">
                                                <span id="found" class="label label-info"></span>
                                                <div class="box-header with-border">
                                                    <img width="50" height="50" src="@Session["Logo"]" />
                                                    <h4 class="box-title">Crecimiento sugerido</h4>
                                                </div>
                                                <table id="tbCrecimiento" class="table table-striped table-bordered" style="width:100%; height: 350px">
                                                    <thead>
                                                        <tr>
                                                            <th class="text-left">Tipo de crecimiento</th>
                                                            <th class="text-center">
                                                                <div class="row">
                                                                    <div class="col-xs-5">
                                                                        <select id="ddlCrecimiento" name="ddlCrecimiento" style="width:150px">
                                                                            <option value="1" @(Model.ddlCrecimiento == "1" ? " selected" : "")>Referencia</option>
                                                                            <option value="2" @(Model.ddlCrecimiento == "2" ? " selected" : "")>Manual</option>
                                                                        </select>
                                                                    </div>
                                                                    <div class="col-xs-1">
                                                                        <a class="text-right" data-toggle="tooltip" data-placement="top" title="Ayuda"
                                                                           href="javascript:help('Tipo de crecimiento', 'El usuario puede escoger entre sugerido o manual, el crecimiento sugerido le indica datos en cada línea calculados por FFC, la opción manual permite incluir la tasa anual en cada línea determinada por la entidad.')"><i class="btn btn-xs btn-default icon fa fa-question"></i></a>
                                                                    </div>
                                                                </div>
                                                            </th>
                                                            <th id="ayudaC" class="hidden">
                                                                Referencia
                                                            </th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr>
                                                            <td>
                                                                Crecimiento de la cartera anual
                                                            </td>
                                                            <td class="text-right">
                                                                <input name="CarteraAnual" readonly id="CarteraAnual" class="text-right" style="width: 70px; border-style: none" value="@Model.CarteraAnual%" />
                                                            </td>
                                                            <td id="ayudaC1" class="hidden">
                                                                @Model.PCarteraAnual%
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td>
                                                                Crecimiento de captaciones anual
                                                            </td>
                                                            <td class="text-right">
                                                                <input name="Captaciones" readonly id="Captaciones" class="text-right" style="width: 70px; border-style: none" value="@Model.Captaciones%" />
                                                            </td>
                                                            <td id="ayudaC2" class="hidden">
                                                                @Model.PCaptaciones%
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td>
                                                                Crecimiento de capital anual
                                                            </td>
                                                            <td class="text-right">
                                                                <input name="Capital" readonly id="Capital" class="text-right" style="width: 70px; border-style: none" value="@Model.Capital%" />
                                                            </td>
                                                            <td id="ayudaC3" class="hidden">
                                                                @Model.PCapital%
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td>
                                                                Crecimiento del gasto administrativo anual
                                                            </td>
                                                            <td class="text-right">
                                                                <input name="GastoAdmin" readonly id="GastoAdmin" class="text-right" style="width: 70px; border-style: none" value="@Model.GastoAdmin%" />
                                                            </td>
                                                            <td id="ayudaC4" class="hidden">
                                                                @Model.PGastoAdmin%
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td>
                                                                Crecimiento anual del gasto por estimaciones
                                                            </td>
                                                            <td class="text-right">
                                                                <input name="GastoEstimac" readonly id="GastoEstimac" class="text-right" style="width: 70px; border-style: none" value="@Model.GastoEstimac%" />
                                                            </td>
                                                            <td id="ayudaC5" class="hidden">
                                                                @Model.PGastoEstimac%
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td>
                                                                Reservas voluntarias anuales
                                                            </td>
                                                            <td class="text-right">
                                                                <input name="ReservaVoluntaria" id="ReservaVoluntaria" class="text-right" style="width: 70px; border-style: none" value="@Model.ReservaVoluntaria" />
                                                            </td>
                                                            <td>
                                                                <a class="text-right" data-toggle="tooltip" data-placement="top" title="Ayuda"
                                                                   href="javascript:help('Reserva Voluntaria', 'Se refiere al monto adicional que la entidad puede estimar en reservas de forma anual. Incluir el dato en millones')"><i class="btn btn-xs btn-default icon fa fa-question"></i></a>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td>
                                                                Ingreso por recuperación de incobrables
                                                            </td>
                                                            <td class="text-right">
                                                                <input name="RecuperacionIncobrable" id="RecuperacionIncobrable" class="text-right" style="width: 70px; border-style: none" value="@Model.RecuperacionIncobrable" />
                                                            </td>
                                                            <td>
                                                                <a class="text-right" data-toggle="tooltip" data-placement="top" title="Ayuda"
                                                                   href="javascript:help('Ingreso por recuperación de incobrables', 'Se refiere al monto adicional que la entidad puede proyectar como ingresos adicionales en la recuperación de incobrables o estimaciones de forma anual. Incluir el dato en millones')"><i class="btn btn-xs btn-default icon fa fa-question"></i></a>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="box box-primary">
                                    <div class="box-body">
                                        <div class="row">
                                            <div class="col-xs-12">
                                                <div class="box-header with-border">
                                                    <h5 style="color: #0B4E91" class="text-justify">Estimado usuario: Los supuestos mostrados son calculados de acuerdo con la metodología de FFC y se muestran como sugerencia, sin embargo, pueden ser cambiados en forma manual al dar click en la opción. Los seleccionados serán los utilizados en las proyecciones</h5>
                                                    <br />
                                                    <div class="text-center">
                                                        <table>
                                                            <tr>
                                                                @if (Model.Generar || Model.proyeccion)
                                                                {
                                                                    <td>
                                                                        <label class="btn btn-info">
                                                                            Generar<input type="submit" id="btn_generar" value="Generar" name="command" style="display: none;">
                                                                        </label>
                                                                    </td>
                                                                }
                                                                <td style="padding-right:10px"></td>
                                                                <td>
                                                                    <label class="btn btn-success">
                                                                        Guardar<input type="submit" value="Guardar" id="btn_guardar" name="command" style="display: none;">
                                                                    </label>
                                                                </td>
                                                                <td style="padding-right:10px"></td>
                                                                <td>
                                                                    <label class="btn btn-danger">
                                                                        Borrar<input id="BorrarConfirm" value="BorrarConfirm" style="display: none;">
                                                                    </label>
                                                                    <input type="submit" id="Borrar" value="Borrar" name="command" style="display: none;">
                                                                </td>
                                                            </tr>
                                                        </table>
                                                        <br />
                                                    </div>
                                                    <br />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane" id="tab2C">
                        <div class="box-body table-responsive">
                            <div class="margin">
                                @if (Session["TipoReporte3"] != null)
                                {
                                    <iframe src="~/Reportes/ReportView3.aspx" width="100%" height="900" style="border:none; width: 100%; max-width: 100%;"></iframe>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane" id="tab3C">
                        <div class="box-body table-responsive">
                            <div class="margin">
                                @if (Session["TipoReporte"] != null)
                                {
                                    <iframe src="~/Reportes/ReportView.aspx" width="100%" height="900" style="border:none; width: 100%; max-width: 100%;"></iframe>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane" id="tab4C">
                        <div class="box-body table-responsive">
                            <div class="margin">
                                @if (Session["TipoReporte4"] != null)
                                {
                                    <iframe src="~/Reportes/ReportView4.aspx" width="100%" height="900" style="border:none; width: 100%; max-width: 100%;"></iframe>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane" id="tab5C">
                        <div class="box-body table-responsive">
                            <div class="margin">
                                @if (Session["TipoReporte2"] != null)
                                {
                                    <iframe src="~/Reportes/ReportView2.aspx" width="100%" height="900" style="border:none; width: 100%; max-width: 100%;"></iframe>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane" id="tab6C">
                        <div class="box-body table-responsive">
                            <div class="margin">
                                <div class="box box-solid box-info">
                                    <div class="row">
                                        <div class="margin">
                                            <br />
                                            <div class="col-md-12">
                                                <table id="tbRangos" class="table table-striped table-bordered" style="width:100%; height: 350px">
                                                    <thead>
                                                        <tr>
                                                            <th colspan="7">
                                                                <img width="50" height="50" src="@Session["Logo"]" />
                                                            </th>
                                                        </tr>
                                                        <tr>
                                                            <th>Periodo</th>
                                                            <th>1</th>
                                                            <th>2</th>
                                                            <th>3</th>
                                                            <th>4</th>
                                                            <th>5</th>
                                                            <th>7</th>
                                                            <th>8</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody></tbody>
                                                </table>
                                                <div id="summary">
                                                    <div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-12">
                                                <div class="box box-info">
                                                    <div class="box-header with-border">
                                                        <img width="50" height="50" src="@Session["Logo"]" />
                                                        <h4 class="box-title">Mora Agrupada</h4>
                                                    </div>
                                                    <div class="box-body">
                                                        @(Model.gMora)
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-12">
                                                <table id="tbMora" class="table table-striped table-bordered" style="width:100%; height: 350px">
                                                    <thead>
                                                        <tr>
                                                            <th colspan="8">
                                                                <img width="50" height="50" src="@Session["Logo"]" />
                                                                <h4 class="box-title">Proyección de Mora</h4>
                                                            </th>
                                                        </tr>
                                                        <tr>
                                                            <th>Periodo</th>
                                                            <th>1</th>
                                                            <th>2</th>
                                                            <th>3</th>
                                                            <th>4</th>
                                                            <th>5</th>
                                                            <th>7</th>
                                                            <th>8</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody></tbody>
                                                </table>
                                                <div id="summary">
                                                    <div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <br />
                                                <table id="tbMora" class="table table-striped table-bordered" style="width:100%; height: 350px">
                                                    <thead>
                                                        <tr>
                                                            <th colspan="8">
                                                                <img width="50" height="50" src="@Session["Logo"]" />
                                                                <h4 class="box-title">Porcentajes utilizados</h4>
                                                            </th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr>
                                                            <td>Igual o menor a 30 días</td>
                                                            <td>0%</td>
                                                        </tr>
                                                        <tr>
                                                            <td>Igual o menor a 60 días</td>
                                                            <td>7.5%</td>
                                                        </tr>
                                                        <tr>
                                                            <td>Igual o menor a 90 días</td>
                                                            <td>25%</td>
                                                        </tr>
                                                        <tr>
                                                            <td>Igual o menor a 180 días</td>
                                                            <td>50%</td>
                                                        </tr>
                                                        <tr>
                                                            <td>Más de 180 días</td>
                                                            <td>75%</td>
                                                        </tr>
                                                        <tr>
                                                            <td>Cobro Judicial</td>
                                                            <td>100%</td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                            <div class="col-md-9">
                                                <table id="tbIndicadores" class="table table-striped table-bordered" style="width:100%; height: 350px">
                                                    <thead>
                                                        <tr>
                                                            <th colspan="8">
                                                                <img width="50" height="50" src="@Session["Logo"]" />
                                                                <h4 class="box-title">Indicadores</h4>
                                                            </th>
                                                        </tr>
                                                        <tr>
                                                            <th>Periodo</th>
                                                            <th>Estimación Sobre Cartera de Crédito / Cartera Mayor a 90 Días y CJ</th>
                                                            <th>Mora / Cartera Total</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody></tbody>
                                                </table>
                                                <div id="summary">
                                                    <div>
                                                    </div>
                                                </div>
                                            </div>
                                            <br />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane" id="tab7C">
                        <div class="box-body table-responsive">
                            <div class="margin">
                                <div class="box box-solid box-info">
