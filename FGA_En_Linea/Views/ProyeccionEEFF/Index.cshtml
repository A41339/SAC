<div class="modal fade" id="defModal" tabindex="-1" role="dialog" aria-labelledby="deleteLabel" aria-hidden="true">
    <div class="modal-dialog ">
        <div class="modal-content">

            <div class="modal-header">
                <div class="box-header with-border">
                    <h3 id="titulo" style="padding-bottom: 10px;" class="box-title"></h3>
                </div>
            </div>
            <div class="modal-body">
                <p class="text-justify" style="font-size: 14px" id="definicion">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">

    var option =  @Session["Plazo"].ToString()

    function help(titulo, detalle) {
        $('#titulo').html(titulo);
        $('#definicion').html(detalle);
        $('#defModal').modal('show');
    }

    $("#ddlPlazo").change(function () {
        if ('@(Model.proyeccion.ToString().ToLower())' == 'true')
            $('#btn_generar').trigger('click');
    });

    function refreshCrecimiento() {


        if ($("#ddlCrecimiento").val() == '1') {

            $("#CarteraAnual").val('@(Model.PCarteraAnual.ToString("N2") + '%')');
            $("#Captaciones").val('@(Model.PCaptaciones.ToString("N2") + '%')');
            $("#Capital").val('@(Model.PCapital.ToString("N2") + '%')');
            $("#GastoAdmin").val('@(Model.PGastoAdmin.ToString("N2") + '%')');
            $("#GastoEstimac").val('@(Model.PGastoEstimac.ToString("N2") + '%')');
            $("#ReservaVoluntaria").val('@(Model.PReservaVoluntaria.ToString("N2"))');
            $("#RecuperacionIncobrable").val('@(Model.PRecuperacionIncobrable.ToString("N2"))');

            $("#CarteraAnual").prop('readonly', true);
            $("#Captaciones").prop('readonly', true);
            $("#Capital").prop('readonly', true);
            $("#GastoAdmin").prop('readonly', true);
            $("#GastoEstimac").prop('readonly', true);

            $("#ayudaC").addClass('hidden');
            $("#ayudaC1").addClass('hidden');
            $("#ayudaC2").addClass('hidden');
            $("#ayudaC3").addClass('hidden');
            $("#ayudaC4").addClass('hidden');
            $("#ayudaC5").addClass('hidden');
        }
        else {

            $("#CarteraAnual").val('@(Model.CarteraAnual.ToString("N2") + '%')');
            $("#Captaciones").val('@(Model.Captaciones.ToString("N2") + '%')');
            $("#Capital").val('@(Model.Capital.ToString("N2") + '%')');
            $("#GastoAdmin").val('@(Model.GastoAdmin.ToString("N2") + '%')');
            $("#GastoEstimac").val('@(Model.GastoEstimac.ToString("N2") + '%')');
            $("#ReservaVoluntaria").val('@(Model.ReservaVoluntaria.ToString("N2"))');
            $("#RecuperacionIncobrable").val('@(Model.RecuperacionIncobrable.ToString("N2"))');

            $("#ayudaC").removeClass('hidden');
            $("#ayudaC1").removeClass('hidden');
            $("#ayudaC2").removeClass('hidden');
            $("#ayudaC3").removeClass('hidden');
            $("#ayudaC4").removeClass('hidden');
            $("#ayudaC5").removeClass('hidden');

            $("#CarteraAnual").removeAttr('readonly');
            $("#Captaciones").removeAttr('readonly');
            $("#Capital").removeAttr('readonly');
            $("#GastoAdmin").removeAttr('readonly');
            $("#GastoEstimac").removeAttr('readonly');
        }
    }

    function refreshTasa() {

         if ($("#ddlTasa").val() == '1') {

            $('#tasaNuevaColocacion').val('@(Model.PTasaNuevaColocacion.ToString("N2") + '%')');
            $("#tasaCarteraVigente").val('@(Model.PTasaCarteraVigente.ToString("N2") + '%')');
            $("#tasaCarteraVencida").val('@(Model.PTasaCarteraVencida.ToString("N2") + '%')');
            $("#tasaInversiones").val('@(Model.PTasaInversiones.ToString("N2") + '%')');
            $("#tasaCaptaciones").val('@(Model.PTasaCaptaciones.ToString("N2") + '%')');
            $("#tasaObligaciones").val('@(Model.PTasaObligaciones.ToString("N2") + '%')');

            $("#tasaNuevaColocacion").prop('readonly', true);
            $("#tasaCarteraVigente").prop('readonly', true);
            $("#tasaCarteraVencida").prop('readonly', true);
            $("#tasaInversiones").prop('readonly', true);
            $("#tasaCaptaciones").prop('readonly', true);
            $("#tasaObligaciones").prop('readonly', true);

            $("#ayudaT").addClass('hidden');
            $("#ayudaT1").addClass('hidden');
            $("#ayudaT2").addClass('hidden');
            $("#ayudaT3").addClass('hidden');
            $("#ayudaT4").addClass('hidden');
            $("#ayudaT5").addClass('hidden');
            $("#ayudaT6").addClass('hidden');
        }
         else {

            $('#tasaNuevaColocacion').val('@(Model.TasaNuevaColocacion.ToString("N2") + '%')');
            $("#tasaCarteraVigente").val('@(Model.TasaCarteraVigente.ToString("N2") + '%')');
            $("#tasaCarteraVencida").val('@(Model.TasaCarteraVencida.ToString("N2") + '%')');
            $("#tasaInversiones").val('@(Model.TasaInversiones.ToString("N2") + '%')');
            $("#tasaCaptaciones").val('@(Model.TasaCaptaciones.ToString("N2") + '%')');
            $("#tasaObligaciones").val('@(Model.TasaObligaciones.ToString("N2") + '%')');

            $("#tasaNuevaColocacion").removeAttr('readonly');
            $("#tasaCarteraVigente").removeAttr('readonly');
            $("#tasaCarteraVencida").removeAttr('readonly');
            $("#tasaInversiones").removeAttr('readonly');
            $("#tasaCaptaciones").removeAttr('readonly');
            $("#tasaObligaciones").removeAttr('readonly');

            $("#ayudaT").removeClass('hidden');
            $("#ayudaT1").removeClass('hidden');
            $("#ayudaT2").removeClass('hidden');
            $("#ayudaT3").removeClass('hidden');
            $("#ayudaT4").removeClass('hidden');
            $("#ayudaT5").removeClass('hidden');
            $("#ayudaT6").removeClass('hidden');
        }
    }

    $("#ddlTasa").change(function () {
        refreshTasa();
    })

    $("#ddlCrecimiento").change(function () {
        refreshCrecimiento();
    })

    @{
        if (Model.AlertaProyeccion == 0)
        {
            <text>
                $('#modalError').modal('show');
            </text>
        }
    }

    $("#BorrarConfirm").button().click(function () {
        if (!confirm("Desea borrar los últimos supuestos guardados")) {
            return false;
        }
        $("#Borrar").click();
    })

    var ControlerNameRole = "@Url.Content("~/ProyeccionEEFF")";

    var table = $("#tbIndicadores").dataTable({
        "bRetrieve": true,
        "ordering": false,
        "bProcessing": true,
        "bPaginate": false,
        "bFilter": false,
        "bInfo": false,
        "dom": 'lBfrtip',
        "sAjaxSource": "@Url.Content("~/ProyeccionEEFF/GetIndicadores")",
        "buttons": [
                { extend: 'copyHtml5', exportOptions: { columns: ':visible' } }
            ,{ extend: 'excelHtml5', exportOptions: { columns: ':visible' } }
            ,{ extend: 'csvHtml5', exportOptions: { columns: ':visible' } }
            ,{ extend: 'print', exportOptions: { columns: ':visible' } }
            ,'colvis'
            ],
            "aoColumns": [
                {}, {}, {}
        ]
    });

    $("#tbRangos").dataTable({
        "bRetrieve": true,
        "ordering": false,
        "bProcessing": true,
        "bPaginate": false,
        "bFilter": false,
        "bInfo": false,
        "dom": 'lBfrtip',
        "sAjaxSource": "@Url.Content("~/ProyeccionEEFF/GetGrid")",
        columnDefs: [
            {
            className: 'text-right', targets: [0, 1, 2, 3, 4, 5, 6, 7],
            },
        ],
        "buttons": [
                { extend: 'copyHtml5', exportOptions: { columns: ':visible' } }
            ,{ extend: 'excelHtml5', exportOptions: { columns: ':visible' } }
            ,{ extend: 'csvHtml5', exportOptions: { columns: ':visible' } }
            ,{ extend: 'print', exportOptions: { columns: ':visible' } }
            ,'colvis'
            ],
            "aoColumns": [
                {}, {}, {}, {}, {}, {}, {}, {}
        ]
    });

    $("#tbMora").dataTable({
        "bRetrieve": true,
        "ordering": false,
        "bProcessing": true,
        "bPaginate": false,
        "bFilter": false,
        "bInfo": false,
        "dom": 'lBfrtip',
        "sAjaxSource": "@Url.Content("~/ProyeccionEEFF/GetGridMora")",
        columnDefs: [
            {
                className: 'text-right', targets: [0, 1, 2, 3, 4, 5, 6, 7],
            },
        ],
        "buttons": [
            { extend: 'copyHtml5', exportOptions: { columns: ':visible' } }
        ,{ extend: 'excelHtml5', exportOptions: { columns: ':visible' } }
        ,{ extend: 'csvHtml5', exportOptions: { columns: ':visible' } }
        ,{ extend: 'print', exportOptions: { columns: ':visible' } }
        ,'colvis'
        ],
        "aoColumns": [
            {}, {}, {}, {}, {}, {}, {}, {}
        ],
    });

    $("#tbGridIndicadores").dataTable({
        "bRetrieve": true,
        "ordering": false,
        "bProcessing": true,
        "bPaginate": false,
        "bFilter": false,
        "bInfo": false,
        "dom": 'lBfrtip',
        "sAjaxSource": "@Url.Content("~/ProyeccionEEFF/GetGridIndicadores")",
        columnDefs: [
            {
                className: 'text-right', targets: [1, 2, 3, 4],
                visible: option == 1 ? false : true, targets: [3, 4]
            },
        ],
        "buttons": [
            { extend: 'copyHtml5', exportOptions: { columns: ':visible' } }
            ,{ extend: 'excelHtml5', exportOptions: { columns: ':visible' } }
            ,{ extend: 'csvHtml5', exportOptions: { columns: ':visible' } }
            ,{ extend: 'print', exportOptions: { columns: ':visible' } }
        ,'colvis'
        ],
        "aoColumns": [
            {}, {}, {}, {}, {}
        ],
    });

    $(document).ready(function () {
        var activeId;
        $("li").click(function () {
            activeId = this.id;
            localStorage.setItem('activeTab', activeId);
        });

        activeId = localStorage.getItem('activeTab');
        if ('@(Model.proyeccion.ToString().ToLower())' == 'true' && '@Model.AlertaProyeccion.ToString()' != '0') {
            if (activeId) {
                if (activeId == 'tab1')
                    activeId = 'tab3'

                $('#' + activeId).addClass("active");
                $('#' + activeId + 'C').addClass("active");
            }
            else {
                $('#tab3').addClass("active");
                $('#tab3C').addClass("active");
            }
        }
        else {
            $('#tab1').addClass("active");
            $('#tab1C').addClass("active");
        }
    });

    function formatMillion() {
        return this.value;
    }

    function formatPercent() {
        return this.value + ' %';
    }

    refreshTasa();
    refreshCrecimiento();
</script>