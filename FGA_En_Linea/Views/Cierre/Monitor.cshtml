@model IEnumerable<Entities.Entities.Procedures.FGA_Consultar_Monitor_Result>

@{
    ViewBag.Title = "Estatus de Cierre";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content-header">
    <h1 class="modern-page-title">
        <i class="fa fa-clock-o" style="color: #0284c7;"></i>
        Estatus de Cierre
        <small>Monitoreo continuo de carga de archivos por entidad</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="#">Carga de Datos</a></li>
        <li class="active">Estatus</li>
    </ol>
</section>

<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div id="files">
                @Html.Partial("Status", Model)
            </div>
        </div>
    </div>
</section>

<script type="text/javascript">
    function loadPartialView() {
        $.ajax({
            url: '@Url.Action("GetPartial", "Cierre")',
            type: 'POST',
            cache: false,
            async: true,
            success: function (result) {
                $('#files').html(result);
            }
        });
    }

    function refreshPartial() {
        setTimeout(function () {
            loadPartialView();
            refreshPartial();
        }, 10000);
    }

    refreshPartial();

</script>
