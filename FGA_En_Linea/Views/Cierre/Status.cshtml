@model IEnumerable<Entities.Entities.Procedures.FGA_Consultar_Monitor_Result>

<div id="dialog"></div>
<div class="modern-table-card">
    <table id="tbRole" class="table modern-data-table" style="width: 100%;">
        <thead>
            <tr>
                <th style="width: 25%; text-align: center;">Entidad</th>
                <th class="mobile" style="width: 16%; text-align: center;">&Uacute;lt. Per&iacute;odo Cargado</th>
                <th style="width: 16%; text-align: center;">Per&iacute;odo Pendiente</th>
                <th style="width: 21%; text-align: center;">Detalle</th>
                <th class="mobile" style="width: 10%; text-align: center;">Pendientes</th>
                @if (Session["IsFGA"].ToString() == "1")
                {
                    <th style="width: 12%; text-align: center;">Ejecutar</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (var item in Model)
                {
                    var ultCierreStr = item.ULT_CIERRE.ToString("ddMMyyy");
                    bool isSinCierre = ultCierreStr == FGA.Utility.Utilitarios.sinCierre;
                    string ultFechaText = isSinCierre ? "No aplica" : FGA.Utility.Utilitarios.toUpperFirstLetter(item.ULT_CIERRE.ToString("MMMM-yy"));
                    string ultFechaBadgeClass = isSinCierre ? "badge-periodo-none" : "badge-periodo-recent";

                    var actCierreStr = item.PERIODO_ACTUAL.ToString("ddMMyyy");
                    bool isActSinCierre = actCierreStr == FGA.Utility.Utilitarios.sinCierre;
                    string actFechaText = isActSinCierre ? "No aplica" : FGA.Utility.Utilitarios.toUpperFirstLetter(item.PERIODO_ACTUAL.ToString("MMMM-yy"));
                    string actFechaBadgeClass = isActSinCierre ? "badge-periodo-none" : "badge-periodo-older";

                    <tr>
                        <td style="text-align: left; padding-left: 24px;">
                            @Html.HiddenFor(modelItem => item.IDENTIDAD)
                            <div class="entity-cell-group">
                                <div class="entity-logo-box">
                                    <img src="@Url.Content("~/Content/images/" + item.NOMBRE + ".jpg")" alt="@item.NOMBRE" />
                                </div>
                                <span class="entity-name-text">@item.NOMBRE</span>
                            </div>
                        </td>
                        <td class="mobile" style="text-align: center;">
                            <span class="badge-periodo @ultFechaBadgeClass">
                                <i class="fa @(isSinCierre ? "fa-minus-circle" : "fa-calendar-check-o")"></i> @ultFechaText
                            </span>
                        </td>
                        <td style="text-align: center;">
                            <span class="badge-periodo @actFechaBadgeClass">
                                <i class="fa @(isActSinCierre ? "fa-minus-circle" : "fa-clock-o")"></i> @actFechaText
                            </span>
                        </td>
                        <td style="text-align: center; color: #475569; font-weight: 500;">
                            @item.ARCHIVOS
                        </td>
                        <td style="text-align: center;" class="mobile">
                            @Html.ActionLink("Ver", "VerPendientes", "Cierre", new { id = item.IDENTIDAD }, new { @class = "new-value-link btn btn-info btn-xs", style = "border-radius: 12px; padding: 3px 12px; font-weight: 600;" })
                        </td>
                        @if (Session["IsFGA"].ToString() == "1")
                        {
                            <td style="text-align: center;">
                                @Html.ActionLink("Ejecutar Cierre", "Cierre", new { id = item.IDENTIDAD, periodo = item.PERIODO_ACTUAL }, new { @class = "btn btn-primary btn-xs", style = "border-radius: 12px; padding: 3px 12px; font-weight: 600;" })
                            </td>
                        }
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (!string.IsNullOrEmpty(ViewBag.Mensaje))
{
    if (((string)ViewBag.Mensaje).Contains("Proceso exitoso"))
    {
        <div class="callout callout-success">
            <p>@ViewBag.Mensaje</p>
        </div>
    }
    else
    {
        <div class="callout callout-danger">
            <p>@ViewBag.Mensaje</p>
        </div>
    }
}

<script type="text/javascript">
    $(function () {
        $('.new-value-link').click(function () {
            var href = this.href;
            $('#dialog').dialog({
                modal: true,
                open: function (event, ui) {
                    $(this).load(href, function (result) {
                        $('#new-value-form').submit(function () {
                            $.ajax({
                                url: this.action,
                                type: this.method,
                                data: $(this).serialize(),
                                success: function (json) {
                                    $('#dialog').dialog('close');
                                    $('#NewValue').val(json.newValue);
                                }
                            });
                            return false;
                        });
                    });
                }
            });
            return false;
        });
    });
</script>