@model IEnumerable<Entities.Entities.Procedures.FGA_Consultar_Monitor_Result>

<div id="dialog"></div>
<style>
    #tbRole th,
    #tbRole td {
        vertical-align: middle !important;
    }
    #tbRole td:nth-child(n+2),
    #tbRole th:nth-child(n+2) {
        text-align: center !important;
    }
</style>
<div class="modern-table-card">
    <table id="tbRole" class="table table-striped table-bordered modern-data-table" style="width: 100%;">
        <thead>
            <tr>
                @if (Session["IsFGA"] != null && Session["IsFGA"].ToString() == "1")
                {
                    <th style="width: 24%; text-align: left; padding-left: 28px; vertical-align: middle;">Entidad</th>
                    <th class="mobile" style="width: 17%; text-align: center; vertical-align: middle;">&Uacute;lt. Per&iacute;odo Cargado</th>
                    <th style="width: 17%; text-align: center; vertical-align: middle;">Per&iacute;odo Pendiente</th>
                    <th style="width: 14%; text-align: center; vertical-align: middle;">Detalle</th>
                    <th class="mobile" style="width: 13%; text-align: center; vertical-align: middle;">Pendientes</th>
                    <th style="width: 15%; text-align: center; vertical-align: middle;">Ejecutar</th>
                }
                else
                {
                    <th style="width: 28%; text-align: left; padding-left: 28px; vertical-align: middle;">Entidad</th>
                    <th class="mobile" style="width: 20%; text-align: center; vertical-align: middle;">&Uacute;lt. Per&iacute;odo Cargado</th>
                    <th style="width: 20%; text-align: center; vertical-align: middle;">Per&iacute;odo Pendiente</th>
                    <th style="width: 16%; text-align: center; vertical-align: middle;">Detalle</th>
                    <th class="mobile" style="width: 16%; text-align: center; vertical-align: middle;">Pendientes</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (var item in Model)
                {
                    var ultCierreStr = item.ULT_CIERRE.ToString("ddMMyyy");
                    bool isSinCierre = ultCierreStr == FGA.Utility.Utilitarios.sinCierre;
                    string ultFechaText = isSinCierre ? "No aplica" : FGA.Utility.Utilitarios.toUpperFirstLetter(item.ULT_CIERRE.ToString("MMMM-yy"));
                    string ultFechaBadgeClass = isSinCierre ? "badge-periodo-none" : "badge-periodo-recent";

                    var actCierreStr = item.PERIODO_ACTUAL.ToString("ddMMyyy");
                    bool isActSinCierre = actCierreStr == FGA.Utility.Utilitarios.sinCierre;
                    string actFechaText = isActSinCierre ? "No aplica" : FGA.Utility.Utilitarios.toUpperFirstLetter(item.PERIODO_ACTUAL.ToString("MMMM-yy"));
                    string actFechaBadgeClass = isActSinCierre ? "badge-periodo-none" : "badge-periodo-older";

                    <tr>
                        <td style="text-align: left; padding-left: 28px; vertical-align: middle;">
                            @Html.HiddenFor(modelItem => item.IDENTIDAD)
                            <div class="entity-cell-group">
                                <div class="entity-logo-box">
                                    <img src="@Url.Content("~/Content/images/" + item.NOMBRE + ".jpg")" alt="@item.NOMBRE" />
                                </div>
                                <span class="entity-name-text">@item.NOMBRE</span>
                            </div>
                        </td>
                        <td class="mobile" style="text-align: center !important; vertical-align: middle !important;">
                            <div style="display: flex; justify-content: center; align-items: center; width: 100%;">
                                <span class="badge-periodo @ultFechaBadgeClass">
                                    <i class="fa @(isSinCierre ? "fa-minus-circle" : "fa-calendar-check-o")"></i> @ultFechaText
                                </span>
                            </div>
                        </td>
                        <td style="text-align: center !important; vertical-align: middle !important;">
                            <div style="display: flex; justify-content: center; align-items: center; width: 100%;">
                                <span class="badge-periodo @actFechaBadgeClass">
                                    <i class="fa @(isActSinCierre ? "fa-minus-circle" : "fa-clock-o")"></i> @actFechaText
                                </span>
                            </div>
                        </td>
                        <td style="text-align: center !important; vertical-align: middle !important;">
                            <div style="display: flex; justify-content: center; align-items: center; width: 100%;">
                                <span class="badge-detalle-archivos">
                                    @item.ARCHIVOS
                                </span>
                            </div>
                        </td>
                        <td class="mobile" style="text-align: center !important; vertical-align: middle !important;">
                            <div style="display: flex; justify-content: center; align-items: center; width: 100%;">
                                @Html.ActionLink("Ver", "VerPendientes", "Cierre", new { id = item.IDENTIDAD }, new { @class = "new-value-link btn btn-info btn-xs", style = "border-radius: 12px; padding: 4px 16px; font-weight: 600; display: inline-flex; align-items: center; justify-content: center;" })
                            </div>
                        </td>
                        @if (Session["IsFGA"] != null && Session["IsFGA"].ToString() == "1")
                        {
                            <td style="text-align: center !important; vertical-align: middle !important;">
                                <div style="display: flex; justify-content: center; align-items: center; width: 100%;">
                                    @Html.ActionLink("Ejecutar Cierre", "Cierre", new { id = item.IDENTIDAD, periodo = item.PERIODO_ACTUAL }, new { @class = "btn btn-primary btn-xs", style = "border-radius: 12px; padding: 4px 16px; font-weight: 600; display: inline-flex; align-items: center; justify-content: center;" })
                                </div>
                            </td>
                        }
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (!string.IsNullOrEmpty(ViewBag.Mensaje))
{
    if (((string)ViewBag.Mensaje).Contains("Proceso exitoso"))
    {
        <div class="callout callout-success">
            <p>@ViewBag.Mensaje</p>
        </div>
    }
    else
    {
        <div class="callout callout-danger">
            <p>@ViewBag.Mensaje</p>
        </div>
    }
}

<script type="text/javascript">
    $(function () {
        $(document).off('click', '.new-value-link').on('click', '.new-value-link', function () {
            var href = this.href;
            var $dlg = $('#dialog');
            if (!$dlg.length) {
                $dlg = $('<div id="dialog"></div>').appendTo('body');
            }
            $dlg.dialog({
                title: 'Archivos Pendientes',
                modal: true,
                width: 560,
                maxHeight: 520,
                position: { my: "center top", at: "center top+70", of: window },
                open: function (event, ui) {
                    $dlg.html('<div style="text-align:center; padding: 30px;"><i class="fa fa-spinner fa-spin fa-2x" style="color: #0284c7;"></i><p style="margin-top: 10px; color: #64748b; font-weight: 500;">Cargando archivos pendientes...</p></div>');
                    $dlg.dialog("option", "position", { my: "center top", at: "center top+70", of: window });
                    $dlg.load(href, function (result) {
                        $dlg.dialog("option", "position", { my: "center top", at: "center top+70", of: window });
                        $('#new-value-form').submit(function () {
                            $.ajax({
                                url: this.action,
                                type: this.method,
                                data: $(this).serialize(),
                                success: function (json) {
                                    $dlg.dialog('close');
                                    $('#NewValue').val(json.newValue);
                                }
                            });
                            return false;
                        });
                    });
                },
                close: function () {
                    $(this).dialog('destroy').remove();
                }
            });
            return false;
        });
    });
</script>