@model IEnumerable<Entities.Entities.Procedures.FGA_Consultar_Monitor_Result>

@{
    ViewBag.Title = "Perfiles de Supervisi&oacute;n";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content-header">
    <h1 class="modern-page-title">
        <i class="fa fa-sliders" style="color: #0284c7;"></i>
        Perfiles de Supervisi&oacute;n
        <small>Consulta y selecci&oacute;n de entidad por perfil de supervisi&oacute;n</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="@Url.Action("Index", "Modulo", new { modulo = "Cierre/Perfiles" })" class="breadcrumb-parent-pill"><i class="fa fa-wrench" style="margin-right: 4px;"></i> Mantenimientos</a></li>
        <li class="active">Perfiles</li>
    </ol>
</section>

<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div id="files">
                @Html.Partial("StatusPerfiles", Model)
            </div>
        </div>
    </div>
</section>

<script type="text/javascript">
    function loadPartialView() {
        $.ajax({
            url: '@Url.Action("GetPerfiles", "Cierre")',
            type: 'POST',
            cache: false,
            async: true,
            success: function (result) {
                $('#files').html(result);
            }
        });
    }

    loadPartialView();

</script>
