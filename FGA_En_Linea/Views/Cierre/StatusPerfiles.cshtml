@model IEnumerable<Entities.Entities.Procedures.FGA_Consultar_Monitor_Result>

<div id="dialog"></div>

@using (Html.BeginForm("CargarEntidad", "Cierre", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmPerfil" }))
{
    @Html.AntiForgeryToken()
    <div class="modern-table-card">
        <table id="tbRole" class="table table-striped table-bordered modern-data-table" style="width: 100%;">
            <thead>
                <tr>
                    <th style="width: 40%; text-align: center;">Entidad</th>
                    <th style="width: 35%; text-align: center;">Perfil de Supervisi&oacute;n</th>
                    <th class="mobile" style="width: 25%; text-align: center;">&Uacute;lt. Per&iacute;odo Cargado</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    foreach (var item in Model)
                    {
                        var perfilText = item.PERFIL ?? "";
                        string perfilBadgeClass = "badge-nosupervisada";
                        string perfilIcon = "fa-info-circle";

                        if (perfilText.IndexOf("Riesgos", StringComparison.OrdinalIgnoreCase) >= 0) {
                            perfilBadgeClass = "badge-sbr";
                            perfilIcon = "fa-shield";
                        } else if (perfilText.IndexOf("Prudencial", StringComparison.OrdinalIgnoreCase) >= 0) {
                            perfilBadgeClass = "badge-prudencial";
                            perfilIcon = "fa-building-o";
                        }

                        var ultCierreStr = item.ULT_CIERRE.ToString("ddMMyyy");
                        bool isSinCierre = ultCierreStr == FGA.Utility.Utilitarios.sinCierre;
                        string fechaText = isSinCierre ? "No aplica" : FGA.Utility.Utilitarios.toUpperFirstLetter(item.ULT_CIERRE.ToString("MMMM-yy"));
                        string fechaBadgeClass = isSinCierre ? "badge-periodo-none" : "badge-periodo-recent";
                        string fechaIcon = isSinCierre ? "fa-minus-circle" : "fa-calendar-check-o";

                        <tr>
                            <td style="text-align: left; padding-left: 36px;">
                                @Html.HiddenFor(modelItem => item.IDENTIDAD)
                                <div class="entity-cell-group" onclick="javascript:CargarEntidad(@(item.IDENTIDAD))" style="cursor: pointer;">
                                    <div class="entity-logo-box">
                                        <img src="@Url.Content("~/Content/images/" + item.NOMBRE + ".jpg")" alt="@item.NOMBRE" />
                                    </div>
                                    <span class="entity-name-text">@item.NOMBRE</span>
                                </div>
                            </td>
                            <td style="text-align: center;">
                                <span class="badge-perfil @perfilBadgeClass">
                                    <i class="fa @perfilIcon"></i> @perfilText
                                </span>
                            </td>
                            <td class="mobile" style="text-align: center;">
                                <span class="badge-periodo @fechaBadgeClass">
                                    <i class="fa @fechaIcon"></i> @fechaText
                                </span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <input id="IdEntidad" name="IdEntidad" type="hidden" value="" />
}

<script type="text/javascript">
    $(function () {
        $(document).off('click', '.new-value-link').on('click', '.new-value-link', function () {
            var href = this.href;
            var $dlg = $('#dialog');
            if (!$dlg.length) {
                $dlg = $('<div id="dialog"></div>').appendTo('body');
            }
            $dlg.dialog({
                title: 'Archivos Pendientes',
                modal: true,
                width: 560,
                maxHeight: 520,
                position: { my: "center top", at: "center top+70", of: window },
                open: function (event, ui) {
                    $dlg.html('<div style="text-align:center; padding: 30px;"><i class="fa fa-spinner fa-spin fa-2x" style="color: #0284c7;"></i><p style="margin-top: 10px; color: #64748b; font-weight: 500;">Cargando archivos pendientes...</p></div>');
                    $dlg.dialog("option", "position", { my: "center top", at: "center top+70", of: window });
                    $dlg.load(href, function (result) {
                        $dlg.dialog("option", "position", { my: "center top", at: "center top+70", of: window });
                        $('#new-value-form').submit(function () {
                            $.ajax({
                                url: this.action,
                                type: this.method,
                                data: $(this).serialize(),
                                success: function (json) {
                                    $dlg.dialog('close');
                                    $('#NewValue').val(json.newValue);
                                }
                            });
                            return false;
                        });
                    });
                },
                close: function () {
                    $(this).dialog('destroy').remove();
                }
            });
            return false;
        });
    });

    function CargarEntidad(idEntidad) {
        $('#IdEntidad').val(idEntidad);
        $("#frmPerfil").submit();
    }

</script>
