@model DotNet.Highcharts.Highcharts

@{
    ViewBag.Title = "Composición de cartera";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section ScriptsOrCss
{
    <script src="https://github.highcharts.com/hc5-fixes/highcharts.js"></script>
    <script src="https://code.highcharts.com/modules/series-label.js"></script>
       <script src="https://code.highcharts.com/modules/exporting.js"></script>
    <script src="https://highcharts.github.io/export-csv/export-csv.js"></script>
    <script src="https://github.highcharts.com/hc5-fixes/highcharts-3d.js"></script>
}

<section class="content-header">
    <h1>
        <i class="fa fa-pie-chart"></i> Composici&oacute;n de la Cartera
        <small>Distribuci&oacute;n gr&aacute;fica y segmentaci&oacute;n de carteras de cr&eacute;dito por categor&iacute;a.</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="#">Informaci&oacute;n Financiera</a></li>
        <li class="active">Composici&oacute;n de Cartera</li>
    </ol>
</section>

<section class="content">
    @using (Html.BeginForm("LoadBuscar", "Graph", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmInforme" }))
    {
        @Html.AntiForgeryToken()
        <div class="row">
            <div class="col-xs-12">
                <div class="modern-filter-card">
                    <div class="modern-filter-toolbar">
                        <div class="filter-item">
                            <label for="IdEntidad"><i class="fa fa-university"></i> Entidad:</label>
                            @Html.DropDownList("Entidades", null, new { @id = "IdEntidad", @class = "form-control modern-select", style = "min-width: 250px;" })
                        </div>
                        <div class="filter-item">
                            <label for="Grafico"><i class="fa fa-bar-chart"></i> Gr&aacute;fico:</label>
                            @Html.DropDownList("Grafico", null, new { @id = "Grafico", @class = "form-control modern-select", style = "min-width: 250px;" })
                        </div>
                        <div class="filter-item">
                            <label for="PeriodoI"><i class="fa fa-calendar"></i> Inicial:</label>
                            <div class="modern-input-wrapper">
                                <input name="PeriodoI" id="PeriodoI" class="datecontrol form-control modern-date-input" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo1"].ToString()).ToString("MM/yyyy")" style="min-width: 130px;" />
                            </div>
                        </div>
                        <div class="filter-item">
                            <label for="PeriodoF"><i class="fa fa-calendar"></i> Final:</label>
                            <div class="modern-input-wrapper">
                                <input name="PeriodoF" id="PeriodoF" class="datecontrol form-control modern-date-input" value="@FGA.Utility.Utilitarios.ConvertirAFecha(Session["Periodo2"].ToString()).ToString("MM/yyyy")" style="min-width: 130px;" />
                            </div>
                        </div>
                        <div id="cmb_categoria" class="filter-item hidden">
                            <label id="lbl_categoria"><i class="fa fa-tags"></i> Categor&iacute;as:</label>
                            @Html.DropDownList("CategoriaRiesgo", null, new { @id = "IdCategoria", style = "width: 200px;", @class = "form-control select2", @multiple = "multiple", @placeholder = "Seleccione las opciones" })
                        </div>
                        <div id="cmb_tipoCartera" class="filter-item hidden">
                            <label id="lbl_tipoCartera"><i class="fa fa-folder-open"></i> Tipos de Cartera:</label>
                            @Html.DropDownList("TipoCartera", null, new { @id = "IdTipoCartera", style = "width: 200px;", @class = "form-control select2", @multiple = "multiple", @placeholder = "Seleccione las opciones" })
                        </div>
                        <div class="filter-item" style="margin-left: auto;">
                            <button type="submit" name="submit" class="btn-modern-filter">
                                <i class="fa fa-search"></i> Generar
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    <div class="row">
        <div class="col-md-12">
            <div class="box box-warning direct-chat direct-chat-primary">
                <div class="box-header with-border">
                    <img width="50" height="50" src="@Session["Logo"]" />
                    <h3 id="entidad" style="padding-bottom: 10px;" class="box-title"></h3>
                </div>
                <div class="row">
                    <div class="col-xs-12">
                        <div class="box box-solid">
                            <div class="box-body table-responsive">
                                <div id="container" style="width: 100%; height: 400px">
                                    @(Model)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script type="text/javascript">

    $("#entidad").text($("#Grafico :selected").text());

    $("#Grafico").change(function () {
        if ($("#Grafico").val() == 3) {
            $("#cmb_categoria").removeClass("hidden");
            $("#lbl_categoria").removeClass("hidden");
            $("#lbl_tipoCartera").addClass("hidden");
            $("#cmb_tipoCartera").addClass("hidden");
            $(".select2").select2();
        }
        else if ($("#Grafico").val() == 7) {
            $("#cmb_tipoCartera").removeClass("hidden");
            $("#lbl_tipoCartera").removeClass("hidden");
            $("#lbl_categoria").addClass("hidden");
            $("#cmb_categoria").addClass("hidden");
            $(".select2").select2();
        }
        else {
            $("#lbl_categoria").addClass("hidden");
            $("#cmb_categoria").addClass("hidden");
            $("#lbl_tipoCartera").addClass("hidden");
            $("#cmb_tipoCartera").addClass("hidden");
        }
    });

    if ($("#Grafico").val() == 3) {
        $("#cmb_categoria").removeClass("hidden");
        $("#lbl_categoria").removeClass("hidden");
        $(".select2").select2();
    }
    else if ($("#Grafico").val() == 7) {
        $("#cmb_tipoCartera").removeClass("hidden");
        $("#lbl_tipoCartera").removeClass("hidden");
        $(".select2").select2();
    }


    function formatMillion() {
        $("#entidad").text($("#Grafico :selected").text() + " en Millones");
        return this.value;
    }

    function formatPercent() {
        return this.value + " %";
    }
</script>

