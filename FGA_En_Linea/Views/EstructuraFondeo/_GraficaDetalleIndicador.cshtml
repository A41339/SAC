@model FGA.Model.IndicadorHistoricoViewModel

<div class="modal-header" style="background: linear-gradient(135deg, #1b3866 0%, #2F5597 100%); padding: 10px 18px; display: flex; align-items: center; justify-content: space-between; border: none;">
    <div style="display: flex; align-items: center; gap: 10px;">
        @if (Session["Logo"] != null)
        {
            <img width="30" height="30" src="@Session["Logo"]" style="border-radius: 6px; background: #ffffff; padding: 2px; box-shadow: 0 2px 6px rgba(0,0,0,0.15); object-fit: contain;" />
        }
        <div>
            <h4 class="modal-title" style="margin: 0; color: #ffffff !important; font-size: 15px; font-weight: 700;">@Model.Nombre</h4>
            <span style="font-size: 11.5px; color: #cbd5e1; display: block; margin-top: 1px;">
                @if (!string.IsNullOrEmpty(Model.Formula))
                {
                    <span>F&oacute;rmula: <strong>@Model.Formula</strong> &bull; </span>
                }
                <span>Periodo: @Model.PeriodoI - @Model.PeriodoF</span>
            </span>
        </div>
    </div>
    <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="color: #ffffff; opacity: 0.85; font-size: 22px; text-shadow: none; margin: 0; padding: 0;">
        <span aria-hidden="true">&times;</span>
    </button>
</div>

<div class="modal-body" style="padding: 10px 18px 4px 18px; background: #ffffff;">
    <!-- Strip resumen con métricas clave del indicador -->
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; margin-bottom: 10px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 7px 14px;">
        <div>
            <span style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 600; display: block; line-height: 1.2;">Periodo Inicial (@Model.PeriodoI)</span>
            <span style="font-size: 14.5px; font-weight: 700; color: #1e3a8a;">@(Model.EsPorcentaje ? Model.PrimerValor.ToString("N2") + "%" : Model.PrimerValor.ToString("N2"))</span>
        </div>
        <div style="border-left: 1px solid #cbd5e1; padding-left: 14px;">
            <span style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 600; display: block; line-height: 1.2;">Periodo Final (@Model.PeriodoF)</span>
            <span style="font-size: 14.5px; font-weight: 700; color: #0f172a;">@(Model.EsPorcentaje ? Model.UltimoValor.ToString("N2") + "%" : Model.UltimoValor.ToString("N2"))</span>
        </div>
        <div style="border-left: 1px solid #cbd5e1; padding-left: 14px;">
            <span style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 600; display: block; line-height: 1.2;">Variación</span>
            <span class="badge" style="@(Model.VariacionPeriodo >= 0 ? "background-color: #dcfce7; color: #15803d;" : "background-color: #fee2e2; color: #b91c1c;") font-size: 11.5px; font-weight: 700; padding: 3px 8px; border-radius: 6px;">
                @(Model.VariacionPeriodo >= 0 ? "+" : "")@(Model.EsPorcentaje ? Model.VariacionPeriodo.ToString("N2") + "%" : Model.VariacionPeriodo.ToString("N2"))
            </span>
        </div>
        <div style="border-left: 1px solid #cbd5e1; padding-left: 14px;">
            <span style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 600; display: block; line-height: 1.2;">Promedio</span>
            <span style="font-size: 14.5px; font-weight: 700; color: #334155;">@(Model.EsPorcentaje ? Model.Promedio.ToString("N2") + "%" : Model.Promedio.ToString("N2"))</span>
        </div>
        <div style="border-left: 1px solid #cbd5e1; padding-left: 14px;">
            <span style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 600; display: block; line-height: 1.2;">Mín / Máx</span>
            <span style="font-size: 13px; font-weight: 600; color: #475569;">
                @(Model.EsPorcentaje ? Model.Minimo.ToString("N2") + "%" : Model.Minimo.ToString("N2")) / @(Model.EsPorcentaje ? Model.Maximo.ToString("N2") + "%" : Model.Maximo.ToString("N2"))
            </span>
        </div>
    </div>

    <!-- Contenedor del gráfico Highcharts -->
    <div id="indicadorChartModal_@Model.Orden" style="width: 100%; height: 420px; min-height: 380px;"></div>

    <script type="text/javascript">
        (function() {
            var categorias = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Categorias));
            var valores = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Valores));
            var esPorcentaje = @(Model.EsPorcentaje ? "true" : "false");
            var sufijo = esPorcentaje ? ' %' : '';

            Highcharts.chart('indicadorChartModal_@Model.Orden', {
                chart: {
                    type: 'areaspline',
                    backgroundColor: '#ffffff',
                    spacingTop: 60,
                    spacingRight: 15,
                    spacingBottom: 20
                },
                title: {
                    text: 'Comportamiento del Indicador en el Periodo',
                    style: { fontSize: '15px', fontWeight: '700', color: '#1e3a8a' }
                },
                subtitle: {
                    text: '@Model.Nombre',
                    style: { fontSize: '12px', color: '#64748b' }
                },
                credits: { enabled: false },
                exporting: {
                    enabled: true,
                    buttons: {
                        contextButton: {
                            align: 'right',
                            verticalAlign: 'top',
                            y: -48,
                            x: -8,
                            text: 'Descargar ▾',
                            theme: {
                                fill: '#ffffff',
                                stroke: '#cbd5e1',
                                'stroke-width': 1,
                                r: 6,
                                padding: 6,
                                height: 16,
                                style: { color: '#475569', fontWeight: '600', fontSize: '12px', fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif', cursor: 'pointer' },
                                states: {
                                    hover: { fill: '#eff6ff', stroke: '#93c5fd', style: { color: '#1e3a8a' } },
                                    select: { fill: '#e0f2fe' }
                                }
                            }
                        }
                    }
                },
                xAxis: {
                    categories: categorias,
                    labels: { style: { fontSize: '12.5px', fontWeight: '600', color: '#1e293b' } },
                    lineColor: '#cbd5e1',
                    tickColor: '#cbd5e1'
                },
                yAxis: {
                    maxPadding: 0.18,
                    title: {
                        text: esPorcentaje ? 'Porcentaje (%)' : 'Valor',
                        style: { color: '#1e3a8a', fontSize: '13px', fontWeight: '700' }
                    },
                    labels: {
                        formatter: function() { return this.value + sufijo; },
                        style: { color: '#334155', fontSize: '12px', fontWeight: '600' }
                    },
                    gridLineWidth: 0
                },
                tooltip: {
                    shared: true,
                    useHTML: true,
                    headerFormat: '<span style="font-size:12.5px; font-weight:700; color:#1e3a8a;">{point.key}</span><br/>',
                    pointFormat: '<span style="color:#2F5597; font-weight:700;">\u25CF @Model.Nombre: </span><b>{point.y:,.2f}' + sufijo + '</b><br/>'
                },
                plotOptions: {
                    areaspline: {
                        fillColor: {
                            linearGradient: { x1: 0, y1: 0, x2: 0, y2: 1 },
                            stops: [
                                [0, 'rgba(47, 85, 151, 0.28)'],
                                [1, 'rgba(47, 85, 151, 0.01)']
                            ]
                        },
                        marker: {
                            radius: 4,
                            fillColor: '#2F5597',
                            lineWidth: 2,
                            lineColor: '#ffffff'
                        },
                        lineWidth: 2.5,
                        states: {
                            hover: { lineWidth: 3 }
                        },
                        threshold: null
                    }
                },
                series: [{
                    name: '@Model.Nombre',
                    data: valores,
                    color: '#2F5597',
                    dataLabels: {
                        enabled: valores.length <= 15,
                        format: '{y:,.2f}' + sufijo,
                        style: { fontSize: '12px', color: '#1e3a8a', fontWeight: '700' }
                    }
                }]
            });
        })();
    </script>
</div>

<div class="modal-footer" style="background: #f8fafc; border-top: 1px solid #e2e8f0; padding: 12px 22px; display: flex; justify-content: flex-end;">
    <button type="button" class="btn-modern-filter" data-dismiss="modal" style="padding: 8px 22px; border-radius: 8px; background: #64748b; color: #ffffff; border: none; font-weight: 600;">
        <i class="fa fa-times"></i> Cerrar
    </button>
</div>
