@model FGA.Model.EstructuraFondeoIndexViewModel

<div class="row" style="margin-top: 15px;">
    <div class="col-xs-12">
        <div class="modern-table-card" style="border: 1px solid #e2e8f0; border-radius: 12px; background: #ffffff; box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05); overflow: hidden; padding: 22px; margin-bottom: 24px;">
            
            <!-- Header institucional con Logo, Título y Subtítulo idéntico a Indicadores FGA -->
            <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 20px; padding-bottom: 16px; border-bottom: 1px solid #f1f5f9;">
                @if (Session["Logo"] != null)
                {
                    <img width="44" height="44" src="@Session["Logo"]" style="border-radius: 8px; background: #ffffff; padding: 3px; border: 1px solid #e2e8f0; object-fit: contain;" />
                }
                <div>
                    <h4 style="margin: 0; font-size: 16px; font-weight: 700; color: #143750;">Indicadores de Estructura de Fondeo</h4>
                    <p style="margin: 2px 0 0 0; font-size: 12px; color: #64748b;">Comportamiento comparativo de fuentes de pasivo con costo, captaciones y concentración</p>
                </div>
            </div>

            <!-- Tabla DataTables con botones de exportación HTML5, búsqueda y paginación -->
            <div class="table-responsive">
                <table id="tblIndicadores" class="table table-striped modern-data-table" style="width: 100%;">
                    <thead>
                        <tr>
                            <th class="text-left" style="text-align: left !important; padding-left: 16px;">Cuenta</th>
                            <th id="thPeriodo1" class="text-right" style="text-align: right !important; padding-right: 14px;">@(Model.Periodo1Header ?? Model.Periodo1)</th>
                            <th id="thPeriodo2" class="text-right" style="text-align: right !important; padding-right: 14px;">@(Model.Periodo2Header ?? Model.Periodo2)</th>
                            <th class="text-center" style="text-align: center !important;">Variación</th>
                            <th class="text-center" style="width: 50px; text-align: center !important;"></th>
                        </tr>
                    </thead>
                    <tbody id="tbodyIndicadores">
                        @if (Model.Indicadores != null && Model.Indicadores.Count > 0)
                        {
                            foreach (var ind in Model.Indicadores)
                            {
                                <tr class="fila-indicador" data-nombre="@ind.Nombre.ToLower()">
                                    <td class="text-left" style="padding: 10px 16px; vertical-align: middle; text-align: left; font-weight: 400; color: #334155; font-size: 13px;">
                                        @ind.Nombre
                                        @if (!string.IsNullOrEmpty(ind.Formula))
                                        {
                                            <span style="display: block; font-size: 11px; font-weight: 400; color: #64748b; margin-top: 2px;">
                                                <i class="fa fa-calculator" style="margin-right: 3px; color: #94a3b8;"></i> @ind.Formula
                                            </span>
                                        }
                                    </td>
                                    <td class="text-right" style="padding: 10px 14px; vertical-align: middle; text-align: right !important; font-variant-numeric: tabular-nums; font-weight: 400; color: #334155; font-size: 13px;">
                                        @ind.ValorP1Formateado
                                    </td>
                                    <td class="text-right" style="padding: 10px 14px; vertical-align: middle; text-align: right !important; font-variant-numeric: tabular-nums; font-weight: 400; color: #334155; font-size: 13px;">
                                        @ind.ValorP2Formateado
                                    </td>
                                    <td class="text-center" style="padding: 10px; vertical-align: middle; text-align: center !important; font-variant-numeric: tabular-nums;">
                                        @if (ind.Variacion > 0)
                                        {
                                            <span class="badge" style="background-color: #dcfce7; color: #15803d; font-size: 11px; font-weight: 600; padding: 4px 8px; border-radius: 6px; display: inline-block; min-width: 75px; text-align: center;">
                                                @ind.VariacionFormateada
                                            </span>
                                        }
                                        else if (ind.Variacion < 0)
                                        {
                                            <span class="badge" style="background-color: #fee2e2; color: #b91c1c; font-size: 11px; font-weight: 600; padding: 4px 8px; border-radius: 6px; display: inline-block; min-width: 75px; text-align: center;">
                                                @ind.VariacionFormateada
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge" style="background-color: #f1f5f9; color: #475569; font-size: 11px; font-weight: 600; padding: 4px 8px; border-radius: 6px; display: inline-block; min-width: 75px; text-align: center;">
                                                0.00
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center" style="padding: 10px; vertical-align: middle; text-align: center !important; width: 50px;">
                                        <a data-toggle="tooltip" data-placement="top" title="Diagramar comportamiento" href="javascript:getGraphIndicador(@ind.Orden)">
                                            <i class="btn btn-xs btn-info icon fa fa-line-chart"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>
