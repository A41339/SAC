@model FGA.Model.EstructuraFondeoIndexViewModel

<div class="row" style="margin-top: 15px;">
    <!-- Tabla Principal de Indicadores -->
    <div class="col-xs-12">
        <div class="modern-table-card" style="background: #ffffff; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); border: 1px solid #e2e8f0; overflow: hidden; margin-bottom: 22px;">
            <!-- Header de la tarjeta -->
            <div style="padding: 18px 24px; border-bottom: 1px solid #edf2f7; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; background: #fafbfc;">
                <div>
                    <h3 style="margin: 0; font-size: 17px; font-weight: 700; color: #1e3a8a; display: flex; align-items: center; gap: 8px;">
                        <i class="fa fa-th-large" style="color: #2F5597; font-size: 16px;"></i>
                        Indicadores de Estructura de Fondeo
                    </h3>
                    <p style="margin: 4px 0 0 0; font-size: 12px; color: #64748b;">
                        Comportamiento comparativo de fuentes de pasivo con costo, captaciones y concentración
                    </p>
                </div>

                <div style="display: flex; align-items: center; gap: 8px;">
                    <label for="txtBuscarIndicador" style="margin: 0; font-size: 13px; font-weight: 600; color: #64748b;">Buscar:</label>
                    <div style="position: relative;">
                        <i class="fa fa-search" style="position: absolute; left: 11px; top: 11px; color: #94a3b8; font-size: 12px;"></i>
                        <input type="text" id="txtBuscarIndicador" class="form-control" placeholder="Buscar indicador..." style="padding-left: 32px; height: 34px; font-size: 12px; border-radius: 6px; border: 1px solid #cbd5e1; min-width: 220px;" />
                    </div>
                </div>
            </div>

            <!-- Tabla -->
            <div class="table-responsive" style="margin: 0;">
                <table class="table table-hover" id="tblIndicadores" style="margin-bottom: 0; width: 100%; table-layout: fixed;">
                    <thead>
                        <tr style="background: #f1f5f9; color: #334155; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px;">
                            <th class="col-th-cuenta" style="padding: 14px 20px; font-weight: 700; border-bottom: 2px solid #cbd5e1; width: 44%; text-align: left;">Cuenta / Indicador</th>
                            <th id="thPeriodo1" class="col-th-p1" style="padding: 14px 10px; font-weight: 700; text-align: center; border-bottom: 2px solid #cbd5e1; width: 17%;">@(Model.Periodo1Header ?? Model.Periodo1)</th>
                            <th id="thPeriodo2" class="col-th-p2" style="padding: 14px 10px; font-weight: 700; text-align: center; border-bottom: 2px solid #cbd5e1; width: 17%;">@(Model.Periodo2Header ?? Model.Periodo2)</th>
                            <th class="col-th-var" style="padding: 14px 10px; font-weight: 700; text-align: center; border-bottom: 2px solid #cbd5e1; width: 13%;">Variación</th>
                            <th class="col-th-graf" style="padding: 14px 10px; font-weight: 700; text-align: center; border-bottom: 2px solid #cbd5e1; width: 9%;">Gráfico</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyIndicadores" style="font-size: 13px; color: #1e293b;">
                        @if (Model.Indicadores != null && Model.Indicadores.Count > 0)
                        {
                            foreach (var ind in Model.Indicadores)
                            {
                                <tr class="fila-indicador" data-nombre="@ind.Nombre.ToLower()">
                                    <td class="col-td-cuenta" style="padding: 12px 20px; vertical-align: middle; text-align: left; font-weight: 600; color: #1e3a8a;">
                                        @ind.Nombre
                                        @if (!string.IsNullOrEmpty(ind.Formula))
                                        {
                                            <span style="display: block; font-size: 11px; font-weight: 400; color: #64748b; margin-top: 2px;">
                                                <i class="fa fa-calculator" style="margin-right: 3px; color: #94a3b8;"></i> @ind.Formula
                                            </span>
                                        }
                                    </td>
                                    <td class="col-val-p1" style="padding: 12px 10px; vertical-align: middle; text-align: center; font-variant-numeric: tabular-nums; font-weight: 600; color: #334155;">
                                        @ind.ValorP1Formateado
                                    </td>
                                    <td class="col-val-p2" style="padding: 12px 10px; vertical-align: middle; text-align: center; font-variant-numeric: tabular-nums; font-weight: 700; color: #0f172a;">
                                        @ind.ValorP2Formateado
                                    </td>
                                    <td class="col-val-var" style="padding: 12px 10px; vertical-align: middle; text-align: center; font-variant-numeric: tabular-nums;">
                                        @if (ind.Variacion > 0)
                                        {
                                            <span class="badge" style="background-color: #dcfce7; color: #15803d; font-size: 11px; font-weight: 600; padding: 4px 8px; border-radius: 6px; display: inline-block; min-width: 75px; text-align: center;">
                                                @ind.VariacionFormateada
                                            </span>
                                        }
                                        else if (ind.Variacion < 0)
                                        {
                                            <span class="badge" style="background-color: #fee2e2; color: #b91c1c; font-size: 11px; font-weight: 600; padding: 4px 8px; border-radius: 6px; display: inline-block; min-width: 75px; text-align: center;">
                                                @ind.VariacionFormateada
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge" style="background-color: #f1f5f9; color: #475569; font-size: 11px; font-weight: 600; padding: 4px 8px; border-radius: 6px; display: inline-block; min-width: 75px; text-align: center;">
                                                0.00
                                            </span>
                                        }
                                    </td>
                                    <td class="col-td-graf" style="padding: 12px 10px; vertical-align: middle; text-align: center;">
                                        <button type="button" class="btn btn-xs btn-grafico-asociado" data-grafico="@ind.TipoGraficoAsociado" title="Ver gráfico correspondiente" style="background: #e0f2fe; color: #0284c7; border: 1px solid #bae6fd; border-radius: 6px; padding: 5px 9px;">
                                            <i class="fa fa-bar-chart" style="font-size: 12px;"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" style="text-align: center; padding: 24px; color: #64748b;">
                                    No se encontraron indicadores para el rango seleccionado.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
