@model FGA.Models.CatalogoCuenta

@{
    ViewBag.Title = "Consultar una cuenta";
    if (Ajax.IsThisAjaxRequest())
    {
        Layout = null;
    }
}
<section class="content-header">
    <h1>
        <i class="fa fa-info-circle"></i> Consultar Cuenta
        <small>Detalle completo y jerarqu&iacute;a de la cuenta contable.</small>
    </h1>
</section>
<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div class="box box-solid box-info">
                <div class="box-header">
                    <h3 class="box-title">Detalles</h3>
                </div>
                <div class="box-body table-responsive">
                    <div class="widget-sec">
                        <div class="streaming-table">
                            <table class="table table-striped table-bordered">
                                <tr>
                                    <td>Cuenta</td>
                                    <td>@Html.DisplayFor(model => model.Cuenta)</td>
                                </tr>
                                <tr>
                                    <td>Nombre</td>
                                    <td>@Html.DisplayFor(model => model.Nombre)</td>
                                </tr>
                                <tr>
                                    <td>Proyectar</td>
                                    <td>@Html.DisplayFor(model => model.Ind_Proyectar)</td>
                                </tr>
                            </table>
                            <div class="box-footer">                                 
                                @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-primary" })
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>