@{
    ViewBag.Title = "Par&aacute;metros";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content-header">
    <h1 class="modern-page-title">
        <i class="fa fa-cogs" style="color: #0284c7;"></i>
        Par&aacute;metros del Sistema
        <small>Configuraci&oacute;n y variables globales de la aplicaci&oacute;n</small>
    </h1>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")"><i class="fa fa-dashboard"></i> Inicio</a></li>
        <li><a href="@Url.Action("Index", "Modulo", new { id = 9000 })" class="breadcrumb-parent-pill" title="Volver al menú de Mantenimientos"><i class="fa fa-wrench" style="margin-right: 4px;"></i> Mantenimientos</a></li>
        <li class="active">Par&aacute;metros</li>
    </ol>
</section>

<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div class="modern-table-card">
                <span id="found" class="label label-info"></span>
                <table id="tbParametros" class="table table-striped table-bordered modern-data-table" style="width: 100%;">
                    <thead>
                        <tr>
                            <th style="width: 12%; text-align: center;">Acci&oacute;n</th>
                            <th style="width: 40%;">Descripci&oacute;n</th>
                            <th style="width: 25%;">Llave</th>
                            <th style="width: 23%;">Valor</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
                <div id="summary">
                    <div></div>
                </div>
            </div>
        </div>
    </div>
</section>

<script type="text/javascript">
        $(document).ready(function () {
            var ControlerNameCompany = "@Url.Content("~/Parametros")";
            $("#tbParametros").dataTable({
            "bRetrieve": true,
             "processing": true, // for show progress bar
                "filter": true, // this is for disable filter (search box)
                "dom": 'lBfrtip',
            "ajax": {
                    "url": "@Url.Content("~/Parametros/GetGrid")",
                    "type": "POST",
                    "datatype": "json"
                },
            "buttons": [
                 { extend: 'copyHtml5', exportOptions: { columns: ':visible' } }
                ,{ extend: 'excelHtml5', exportOptions: { columns: ':visible' } }
                ,{ extend: 'pdfHtml5', exportOptions: { columns: ':visible' } }
                ,{ extend: 'print', exportOptions: { columns: ':visible' } }
                ,'colvis'
            ], 
            "pageLength": 5,
            "lengthMenu": [[5,10, 25, 50, -1], [5,10, 25, 50, "Todos"]],
                "aoColumns": [

                {
                                 "mRender": function (oObj, type, row) {

                    var buttons = '<div class="text-center"> <div class="btn-group text-left"> <button type="button" class="btn btn-xs btn-default dropdown-toggle" data-toggle="dropdown" style="border-radius:6px; border:1px solid #cbd5e1; font-size:12px; padding:4px 10px; color:#374151;"><i class="fa fa-cog" style="margin-right:4px;"></i> Acci&oacute;n <span class="caret"></span></button>';
                    buttons += '<ul class="dropdown-menu pull-left" role="menu">';
                                     buttons += '<li><a href="' + ControlerNameCompany + "/Edit/" + row[0] + '"><i class="fa fa-edit"></i>Modificar</a></li>';
                    buttons += '</ul>';
                    buttons += '</div></div>';
                    return buttons;
                }
                    }, {}, {}, {}]
        });
     });
</script>